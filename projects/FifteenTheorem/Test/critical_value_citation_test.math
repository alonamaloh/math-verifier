-- Test/critical_value_citation_test.math
--
-- A citation may supply only its premises: the data parameters come from the
-- goal, including the ones a premise argument's own citation needs.  The
-- fixture is the critical-value list, so this exercise lives beside the
-- fifteen theorem rather than in the library's feature suite; the premise-only
-- citation without nesting is locked by `Test.natural_spelling_test`.

module Test.critical_value_citation_test

import Algebra.critical_value_minimality

theorem Test.nested_citation_takes_its_data_from_the_goal
        : ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 6)
            → Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 1, 3, 7), (u : ℤ)) :=
  by Matrix.represents_critical_values_except(
      one := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 0, w := 0, value := done)),
      two := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 0, w := 0, value := done)),
      three := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 1, w := 0, value := done)),
      five := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 1, w := 0, value := done)),
      six := Or.introduceLeft(done),
      seven := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 0, w := 1, value := done)),
      ten := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 3, y := 1, z := 0, w := 0, value := done)),
      fourteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 0, z := 1, w := 1, value := done)),
      fifteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 1, z := 1, w := 1, value := done)))
