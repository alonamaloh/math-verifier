    1 * 1 + 2 * (1 * 1) + 5 * (0 * 0) + 2 * 1 * 1 * 19 + 2 * 1 * 0 * 19 + 9 * (19 * 19) = (3290 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 3290, vector := ⟨1, 1, 0, 19⟩,
