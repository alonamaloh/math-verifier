module ErrorTest.ordered_field_wrong_goal_shape

import Logic.basics
import Equality.basics
import Real.basics
import Real.order
import Real.order_field

-- An equality goal is `ring`'s job; the decline must send the reader there.
theorem equality_is_not_an_order_goal (a c : ℝ) (aBelow : a ≤ c)
        : a + c = c + a := ordered_field
