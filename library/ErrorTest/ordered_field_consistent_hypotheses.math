module ErrorTest.ordered_field_consistent_hypotheses

import Logic.basics
import Equality.basics
import Real.basics
import Real.order
import Real.order_field

-- A `False` goal needs the hypotheses to be inconsistent. When they are
-- not, the message must say so — and show the values that satisfy them,
-- rather than reporting a failure to prove some goal.
theorem one_bound_is_not_a_contradiction (a b : ℝ) (aBelow : a ≤ b)
        : False := ordered_field
