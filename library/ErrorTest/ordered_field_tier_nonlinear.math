-- The `ordered_field` tier runs unprompted at the end of the auto-prover's
-- battery, so a linear consequence of the order hypotheses closes with a
-- bare claim. A NONLINEAR one must still be declined — `x·x` and `y·y` are
-- unrelated atoms, no combination of the hypotheses reaches the goal, and
-- the message must say so rather than claiming the tactic was not tried.

module ErrorTest.ordered_field_tier_nonlinear

import Logic.basics
import Equality.basics
import Real.interface
import Real.order

theorem ErrorTest.squares_are_not_linear (x y : ℝ) (ordered : x ≤ y)
        : x * x ≤ y * y := done
