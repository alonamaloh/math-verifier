module ErrorTest.ordered_field_not_linear

import Logic.basics
import Equality.basics
import Real.basics
import Real.order
import Real.order_field

-- Squares are independent variables of the linear model, so this is out
-- of the ordered-field fragment. The message must say so, and produce
-- the valuation at which the hypothesis holds and the goal fails.
theorem squares_are_not_linear (x y : ℝ) (xLeqY : x ≤ y) : x * x ≤ y * y :=
  ordered_field
