-- The same check on a NAMED source: `from fact` says which existential to
-- destructure, so there is nothing to search for — but the condition the
-- text states must still be the one `fact` binds.

module ErrorTest.choose_such_that_misstated_condition

import axioms
import Logic.basics
import Logic.exists

theorem ErrorTest.chooseConditionMisstated (A : Type(0))
        (P : A → Proposition) (Q : A → Proposition)
        (fact : ∃ (a : A). P(a))
        : True := {
  choose witnessValue such that Q(witnessValue) from fact;
  done by True.trivial
}
