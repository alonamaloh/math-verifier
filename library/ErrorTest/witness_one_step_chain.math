-- `witness E with P` takes a term, a `{ … }` block, or a relation chain
-- of TWO or more steps. A ONE-step chain leaves its `= … by …` to the
-- enclosing statement, which quietly turns the whole `witness` into a
-- claim; the error must name that cause rather than blaming the goal.
module ErrorTest.witness_one_step_chain

import Integer.algebra

theorem ErrorTest.witness_with_one_step_chain
        (a target : ℤ) (targetIsSquare : target = a * a)
        : ∃ (x : ℤ). x * x = target := {
  witness a with
    a * a
       = target by Equality.symmetry(targetIsSquare)
}
