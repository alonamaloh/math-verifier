-- A calc step citing a lemma whose arguments the step cannot determine (the
-- lemma reads its `x, y, z` off a coordinate-tuple spelling; this step's
-- vector is abstract). The step proof is then the lemma UNAPPLIED, and the
-- message must say so — printing the ∀-statement beside the step's relation
-- as "a different relation" sends the reader hunting for a mathematical
-- difference between two things that are not comparable.
module ErrorTest.calc_citation_not_instantiated

import Algebra.diagonal_forms

theorem ErrorTest.t (v : RingVector(Integer.commutative_ring_bundle, 3))
        : Matrix.quadraticForm(Matrix.squarePlusDoublePlusScaledSquareForm(5), v)
          = 0 :=
  Matrix.quadraticForm(Matrix.squarePlusDoublePlusScaledSquareForm(5), v)
     = 0 + 0 by Matrix.squarePlusDoublePlusScaledSquareForm_coordinateTuple_value
     = 0 by ring
