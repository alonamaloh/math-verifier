-- `choose … such that P` is CHECKED, in every form. Here the only
-- existential in scope is about `A` while the stated condition is a
-- predicate on `B`: before the check, the witness was silently bound at
-- `A` and the stated condition thrown away, so the proof text claimed a
-- condition the kernel never saw. It must refuse instead, and name the
-- candidate it looked at.

module ErrorTest.choose_such_that_unrelated_condition

import axioms
import Logic.basics
import Logic.exists

theorem ErrorTest.chooseConditionUnrelated (A B : Type(0))
        (P : A → Proposition) (Q : B → Proposition)
        (only : ∃ (a : A). P(a))
        : True := {
  choose witnessValue such that Q(witnessValue);
  done by True.trivial
}
