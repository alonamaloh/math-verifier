-- Graph/pathgraph.math
--
-- A graph that IS a path. Layer 5 of PLAN_JORDAN_SCHOENFLIES.md.
--
-- An ear is a path presented as a graph, so that it can be unioned with
-- the graph it is attached to. `Graph.IsPathGraph(pathGraph, source,
-- target)` says the graph's own edge list walks from one end to the other
-- and its vertex list is exactly what that walk visits. The edge list's
-- ORDER is part of the claim, which is what lets every later argument
-- split the path without first having to sort it.
--
-- What the ear argument asks of a path graph is always the same: whatever
-- vertex is deleted, every remaining vertex still reaches one of the two
-- ends. That is `reaches_an_end`, and the work behind it is the interior
-- case, where the deletion cuts the path in two.

module Graph.pathgraph

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import Set.basics
import Lists.list
import Lists.append
import Lists.distinct
import Graph.basics
import Graph.walk
import Graph.path
import Graph.reverse
import Graph.connected
import Graph.vertex_deletion

convention V : Type(0)
convention E : Type(0)
convention ends : E → Pair(V, V)

definition Graph.IsPathGraph (pathGraph : Graph(V, E, ends)) (source target : V)
        : Proposition :=
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
  ∧ (∀ (vertex : V). vertex ∈ Graph.vertices(pathGraph)
       → vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph)))
  ∧ (∀ (vertex : V). vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
       → vertex ∈ Graph.vertices(pathGraph))

theorem Graph.IsPathGraph.path (pathGraph : Graph(V, E, ends)) (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        : Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target) :=
  done

theorem Graph.IsPathGraph.visits (pathGraph : Graph(V, E, ends)) (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target)) (vertex : V)
        (isVertex : vertex ∈ Graph.vertices(pathGraph))
        : vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph)) := {
  ∀ (candidate : V). candidate ∈ Graph.vertices(pathGraph)
      → candidate ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      as verticesAreVisited;
  done by verticesAreVisited
}

theorem Graph.IsPathGraph.is_vertex (pathGraph : Graph(V, E, ends)) (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target)) (vertex : V)
        (visited : vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph)))
        : vertex ∈ Graph.vertices(pathGraph) := {
  ∀ (candidate : V).
      candidate ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      → candidate ∈ Graph.vertices(pathGraph) as visitedAreVertices;
  done by visitedAreVertices
}

theorem Graph.IsPathGraph.source_is_vertex (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        : source ∈ Graph.vertices(pathGraph) := {
  source ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph));
  done by Graph.IsPathGraph.is_vertex
}

theorem Graph.IsPathGraph.target_is_vertex (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        : target ∈ Graph.vertices(pathGraph) := {
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  Graph.IsWalk(pathGraph, source, Graph.edges(pathGraph), target) by Graph.IsPath.walk;
  target ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      by Graph.IsWalk.target_is_visited;
  done by Graph.IsPathGraph.is_vertex
}

-- ----------------------------------------------------------------------
-- Reaching one end without passing through the other.

theorem Graph.IsPathGraph.reaches_far_end (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        (vertex : V)
        (isVertex : vertex ∈ Graph.vertices(pathGraph))
        (distinctFromSource : vertex ≠ source)
        : Graph.Reaches(Graph.deleteVertex(pathGraph, source), vertex, target) := {
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      by Graph.IsPathGraph.visits;
  done by Graph.IsPath.reaches_target_avoiding_source
}

theorem Graph.IsPathGraph.reaches_near_end (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        (vertex : V)
        (isVertex : vertex ∈ Graph.vertices(pathGraph))
        (distinctFromTarget : vertex ≠ target)
        : Graph.Reaches(Graph.deleteVertex(pathGraph, target), vertex, source) := {
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      by Graph.IsPathGraph.visits;
  done by Graph.IsPath.reaches_source_avoiding_target
}

-- ----------------------------------------------------------------------
-- Connectedness.

theorem Graph.IsPathGraph.IsConnected (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        : Graph.IsConnected(pathGraph) := {
  source ∈ Graph.vertices(pathGraph) by Graph.IsPathGraph.source_is_vertex;
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  ∀ (vertex : V). vertex ∈ Graph.vertices(pathGraph)
      → Graph.Reaches(pathGraph, source, vertex)
      by { take vertex : V;
           suppose vertex ∈ Graph.vertices(pathGraph);
           vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
               by Graph.IsPathGraph.visits;
           choose prefixEdges, suffixEdges such that
               Graph.edges(pathGraph) = List.append(prefixEdges, suffixEdges)
               ∧ Graph.IsPath(pathGraph, source, prefixEdges, vertex)
               ∧ Graph.IsPath(pathGraph, vertex, suffixEdges, target)
               ∧ (vertex = source
                    ∨ ¬(source ∈ Graph.walkVertices(pathGraph, vertex, suffixEdges)))
               from Graph.IsPath.split;
           Graph.IsPath(pathGraph, source, prefixEdges, vertex);
           Graph.IsWalk(pathGraph, source, prefixEdges, vertex) by Graph.IsPath.walk;
           witness prefixEdges };
  done by Graph.IsConnected.from_hub(hub := source)
}

-- ----------------------------------------------------------------------
-- Cutting the path at an interior vertex.
--
-- Every other vertex of the path lies on one of the two halves, which is
-- what an argument that deletes an interior vertex needs: each remaining
-- vertex is on a piece that still reaches one of the two ends.

theorem Graph.IsPathGraph.halves (pathGraph : Graph(V, E, ends)) (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        (cut : V)
        (cutIsVertex : cut ∈ Graph.vertices(pathGraph))
        : ∃ (prefixEdges : List(E)). ∃ (suffixEdges : List(E)).
            Graph.IsPath(pathGraph, source, prefixEdges, cut)
            ∧ Graph.IsPath(pathGraph, cut, suffixEdges, target)
            ∧ ∀ (vertex : V). vertex ∈ Graph.vertices(pathGraph)
                → vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges)
                  ∨ vertex ∈ Graph.walkVertices(pathGraph, cut, suffixEdges) := {
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  cut ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
      by Graph.IsPathGraph.visits;
  choose prefixEdges, suffixEdges such that
      Graph.edges(pathGraph) = List.append(prefixEdges, suffixEdges)
      ∧ Graph.IsPath(pathGraph, source, prefixEdges, cut)
      ∧ Graph.IsPath(pathGraph, cut, suffixEdges, target)
      ∧ (cut = source
           ∨ ¬(source ∈ Graph.walkVertices(pathGraph, cut, suffixEdges)))
      from Graph.IsPath.split;
  Graph.edges(pathGraph) = List.append(prefixEdges, suffixEdges) as edgesSplit;
  Graph.IsPath(pathGraph, source, prefixEdges, cut);
  Graph.IsPath(pathGraph, cut, suffixEdges, target);
  ∀ (vertex : V). vertex ∈ Graph.vertices(pathGraph)
      → vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges)
        ∨ vertex ∈ Graph.walkVertices(pathGraph, cut, suffixEdges)
      by { take vertex : V;
           suppose vertex ∈ Graph.vertices(pathGraph);
           vertex ∈ Graph.walkVertices(pathGraph, source, Graph.edges(pathGraph))
               by Graph.IsPathGraph.visits;
           done by cases {
             case vertex = source: {
                 vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges);
                 done
               }
             case vertex ∈ Graph.coveredVertices(pathGraph, Graph.edges(pathGraph)): {
                 vertex ∈ Graph.coveredVertices(pathGraph,
                     List.append(prefixEdges, suffixEdges))
                     by substituting edgesSplit;
                 vertex ∈ Graph.coveredVertices(pathGraph, prefixEdges)
                     ∨ vertex ∈ Graph.coveredVertices(pathGraph, suffixEdges)
                     by Graph.coveredVertices.append_invert;
                 done by cases {
                   case vertex ∈ Graph.coveredVertices(pathGraph, prefixEdges): {
                       vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges);
                       done
                     }
                   case vertex ∈ Graph.coveredVertices(pathGraph, suffixEdges): {
                       vertex ∈ Graph.walkVertices(pathGraph, cut, suffixEdges);
                       done
                     }
                 }
               }
           } };
  witness prefixEdges with witness suffixEdges
}

-- Whatever vertex is deleted, every remaining vertex of the path still
-- reaches one of the two ends. Four situations, and the interior one is
-- the only one with content: the deleted vertex cuts the path in two, and
-- each remaining vertex sits on a piece that still runs to an end.
theorem Graph.IsPathGraph.reaches_an_end (pathGraph : Graph(V, E, ends))
        (source target : V)
        (isPathGraph : Graph.IsPathGraph(pathGraph, source, target))
        (cut vertex : V)
        (isVertex : vertex ∈ Graph.vertices(pathGraph))
        (distinctFromCut : vertex ≠ cut)
        (wellFormed : Graph.IsWellFormed(pathGraph))
        : Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, source)
          ∨ Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, target) := {
  Graph.IsPath(pathGraph, source, Graph.edges(pathGraph), target)
      by Graph.IsPathGraph.path;
  done by cases {
    case cut = source: {
        vertex ≠ source by substituting (cut = source);
        Graph.Reaches(Graph.deleteVertex(pathGraph, source), vertex, target)
            by Graph.IsPathGraph.reaches_far_end;
        Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, target)
            by substituting (cut = source);
        done
      }
    case cut = target: {
        vertex ≠ target by substituting (cut = target);
        Graph.Reaches(Graph.deleteVertex(pathGraph, target), vertex, source)
            by Graph.IsPathGraph.reaches_near_end;
        Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, source)
            by substituting (cut = target);
        done
      }
    otherwise: {
        done by cases {
          case cut ∈ Graph.vertices(pathGraph): {
              choose prefixEdges, suffixEdges such that
                  Graph.IsPath(pathGraph, source, prefixEdges, cut)
                  ∧ Graph.IsPath(pathGraph, cut, suffixEdges, target)
                  ∧ ∀ (candidate : V). candidate ∈ Graph.vertices(pathGraph)
                      → candidate ∈ Graph.walkVertices(pathGraph, source, prefixEdges)
                        ∨ candidate ∈ Graph.walkVertices(pathGraph, cut, suffixEdges)
                  from Graph.IsPathGraph.halves;
              Graph.IsPath(pathGraph, source, prefixEdges, cut);
              Graph.IsPath(pathGraph, cut, suffixEdges, target);
              ∀ (candidate : V). candidate ∈ Graph.vertices(pathGraph)
                  → candidate ∈ Graph.walkVertices(pathGraph, source, prefixEdges)
                    ∨ candidate ∈ Graph.walkVertices(pathGraph, cut, suffixEdges)
                  as onSomeHalf;
              vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges)
                  ∨ vertex ∈ Graph.walkVertices(pathGraph, cut, suffixEdges)
                  by onSomeHalf;
              done by cases {
                case vertex ∈ Graph.walkVertices(pathGraph, source, prefixEdges): {
                    Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, source)
                        by Graph.IsPath.reaches_source_avoiding_target;
                    done
                  }
                case vertex ∈ Graph.walkVertices(pathGraph, cut, suffixEdges): {
                    Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, target)
                        by Graph.IsPath.reaches_target_avoiding_source;
                    done
                  }
              }
            }
          otherwise: {
              -- The cut is not a vertex of the path at all, so the path is
              -- untouched and still runs from the vertex to its source.
              ¬(cut ∈ Graph.vertices(pathGraph));
              Graph.IsConnected(pathGraph) by Graph.IsPathGraph.IsConnected;
              Graph.IsConnected(Graph.deleteVertex(pathGraph, cut))
                  by Graph.IsConnected.after_outside_deletion;
              source ∈ Graph.vertices(pathGraph) by Graph.IsPathGraph.source_is_vertex;
              source ≠ cut
                  by { suppose source = cut;
                       cut ∈ Graph.vertices(pathGraph) by substituting (source = cut);
                       done };
              source ∈ Graph.vertices(Graph.deleteVertex(pathGraph, cut))
                  by Graph.deleteVertex.keeps_vertex;
              vertex ∈ Graph.vertices(Graph.deleteVertex(pathGraph, cut))
                  by Graph.deleteVertex.keeps_vertex;
              Graph.Reaches(Graph.deleteVertex(pathGraph, cut), vertex, source)
                  by Graph.IsConnected.reaches;
              done
            }
        }
      }
  }
}

-- ----------------------------------------------------------------------
-- Building the path graph.
--
-- Every `Graph.IsPathGraph` above is a hypothesis; this is where one is
-- made. An ear is a path of the big graph presented as a graph of its
-- own, so that it can be unioned back in.

definition Graph.pathGraphOf (graph : Graph(V, E, ends)) (source : V)
        (edgeList : List(E)) : Graph(V, E, ends) :=
  Graph.make(Graph.walkVertexList(graph, source, edgeList), edgeList)

theorem Graph.pathGraphOf.IsPathGraph (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : Graph.IsPathGraph(Graph.pathGraphOf(graph, source, edgeList),
                            source, target) := {
  edgeList ⊆ Graph.edges(Graph.pathGraphOf(graph, source, edgeList))
      by List.Includes.reflexive;
  Graph.IsPath(Graph.pathGraphOf(graph, source, edgeList), source, edgeList, target)
      by Graph.IsPath.transfer;

  ∀ (vertex : V).
      vertex ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList))
      → vertex ∈ Graph.walkVertices(Graph.pathGraphOf(graph, source, edgeList),
                                    source, edgeList)
      by { take vertex : V;
           suppose vertex ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList));
           vertex ∈ Graph.walkVertexList(graph, source, edgeList);
           done by Graph.walkVertexList.visits };

  Graph.IsWalk(graph, source, edgeList, target) by Graph.IsPath.walk;
  ∀ (vertex : V).
      vertex ∈ Graph.walkVertices(Graph.pathGraphOf(graph, source, edgeList),
                                  source, edgeList)
      → vertex ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList))
      by { take vertex : V;
           suppose vertex ∈ Graph.walkVertices(
               Graph.pathGraphOf(graph, source, edgeList), source, edgeList);
           vertex ∈ Graph.walkVertices(graph, source, edgeList);
           done by Graph.walkVertexList.complete };
  done
}

theorem Graph.pathGraphOf.IsWellFormed (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : Graph.IsWellFormed(Graph.pathGraphOf(graph, source, edgeList)) := {
  List.Distinct(V, Graph.walkVertexList(graph, source, edgeList))
      by Graph.IsPath.vertexList_distinct;
  List.Distinct(E, edgeList) by Graph.IsPath.distinct_edges;
  Graph.IsWalk(graph, source, edgeList, target) by Graph.IsPath.walk;
  ∀ (edge : E). ∀ (u v : V).
      edge ∈ Graph.edges(Graph.pathGraphOf(graph, source, edgeList))
      → Graph.Joins(Graph.pathGraphOf(graph, source, edgeList), edge, u, v)
      → u ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList)) ∧ u ≠ v
      by { take edge : E;
           take u : V;
           take v : V;
           suppose edge ∈ Graph.edges(Graph.pathGraphOf(graph, source, edgeList));
           suppose Graph.Joins(Graph.pathGraphOf(graph, source, edgeList), edge, u, v);
           edge ∈ edgeList;
           Graph.Joins(graph, edge, u, v);
           edge ∈ Graph.edges(graph) by Graph.IsWalk.edge_is_edge;
           u ≠ v by Graph.IsWellFormed.no_loop;
           Graph.Incident(graph, edge, u) by Graph.Joins.incident_source;
           u ∈ Graph.coveredVertices(graph, edgeList)
               by Graph.coveredVertices.of_edge;
           u ∈ Graph.walkVertices(graph, source, edgeList);
           u ∈ Graph.walkVertexList(graph, source, edgeList)
               by Graph.walkVertexList.complete;
           u ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList));
           done };
  done
}

-- And it sits inside the graph it was cut from.
theorem Graph.pathGraphOf.IsSubgraph (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (sourceIsVertex : source ∈ Graph.vertices(graph))
        : Graph.IsSubgraph(Graph.pathGraphOf(graph, source, edgeList), graph) := {
  Graph.IsWalk(graph, source, edgeList, target) by Graph.IsPath.walk;
  ∀ (vertex : V).
      vertex ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList))
      → vertex ∈ Graph.vertices(graph)
      by { take vertex : V;
           suppose vertex ∈ Graph.vertices(Graph.pathGraphOf(graph, source, edgeList));
           vertex ∈ Graph.walkVertexList(graph, source, edgeList);
           vertex ∈ Graph.walkVertices(graph, source, edgeList)
               by Graph.walkVertexList.visits;
           done by Graph.IsWalk.visits_vertices };
  ∀ (edge : E). edge ∈ Graph.edges(Graph.pathGraphOf(graph, source, edgeList))
      → edge ∈ Graph.edges(graph)
      by { take edge : E;
           suppose edge ∈ Graph.edges(Graph.pathGraphOf(graph, source, edgeList));
           edge ∈ edgeList;
           done by Graph.IsWalk.edge_is_edge };
  done
}
