-- Graph/tree.math
--
-- Trees. Layer 5 of PLAN_JORDAN_SCHOENFLIES.md.
--
-- A tree is a connected graph in which no edge lies on a cycle. What the
-- blueprint asks of trees is always about their leaves, and every such
-- question starts the same way: take a longest path. Neither of its ends
-- can carry a second edge — an edge back onto the path would close a
-- cycle, and an edge off it would make a longer path — so both ends are
-- leaves.

module Graph.tree

import Logic.basics
import Logic.exists
import Logic.excluded_middle
import Logic.product
import Equality.basics
import Natural.basics
import Natural.order
import Natural.add_order
import Natural.subtraction
import Natural.monus
import Lists.list
import Lists.length
import Lists.filter
import Lists.remove
import Graph.basics
import Graph.walk
import Graph.path
import Graph.connected
import Graph.deletion
import Graph.vertex_deletion
import Graph.cycle
import Graph.degree

convention V : Type(0)
convention E : Type(0)
convention ends : E → Pair(V, V)

-- ----------------------------------------------------------------------
-- Acyclicity, trees, and leaves.

definition Graph.IsAcyclic (graph : Graph(V, E, ends)) : Proposition :=
  ∀ (edge : E). edge ∈ Graph.edges(graph) → ¬Graph.LiesOnCycle(graph, edge)

definition Graph.IsTree (graph : Graph(V, E, ends)) : Proposition :=
  Graph.IsConnected(graph) ∧ Graph.IsAcyclic(graph)

definition Graph.IsLeaf (graph : Graph(V, E, ends)) (vertex : V) : Proposition :=
  vertex ∈ Graph.vertices(graph) ∧ Graph.degree(graph, vertex) = 1

-- ----------------------------------------------------------------------
-- The end of a longest path carries no edge but the path's own.

-- In an acyclic graph, every edge at the source of a longest path is one
-- of the path's edges. The two ways out are both closed: an edge onto a
-- vertex the path visits closes a cycle, and an edge to a vertex it does
-- not visit extends the path.
theorem Graph.IsAcyclic.longest_path_source_edge (graph : Graph(V, E, ends))
        (acyclic : Graph.IsAcyclic(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (longest : ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
            Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
            → length(otherEdges) ≤ length(edgeList))
        (edge : E)
        (isEdge : edge ∈ Graph.edges(graph))
        (incident : Graph.Incident(graph, edge, source))
        : edge ∈ edgeList := {
  suppose ¬(edge ∈ edgeList) for contradiction;
  choose far such that Graph.Joins(graph, edge, source, far);
  done by cases {
    case far ∈ Graph.walkVertices(graph, source, edgeList): {
        Graph.LiesOnCycle(graph, edge) by Graph.IsPath.chord_on_cycle;
        ¬Graph.LiesOnCycle(graph, edge);
        done
      }
    otherwise: {
        Graph.Joins(graph, edge, far, source) by Graph.Joins.symmetric;
        Graph.IsPath(graph, far, List.prepend(E, edge, edgeList), target)
            by Graph.IsPath.extend;
        1 + length(edgeList)
           = length(List.prepend(E, edge, edgeList))
           ≤ length(edgeList) by longest;
        done
      }
  }
}

-- A path leaves its source once and for all: two of its edges incident to
-- the source are the same edge. The step that departs is the only
-- candidate — a later edge at the source would put the source among the
-- vertices the rest of the path visits, which is what a path forbids.
theorem Graph.IsPath.one_edge_at_source (graph : Graph(V, E, ends))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : ∀ (first second : E). first ∈ edgeList → second ∈ edgeList
            → Graph.Incident(graph, first, source)
            → Graph.Incident(graph, second, source)
            → first = second :=
  by induction on path {
    case Graph.IsPathOver.arrived(endpoint): {
        take first : E;
        take second : E;
        suppose first ∈ List.empty(E);
        ¬(first ∈ List.empty(E)) by List.no_member_empty;
        done
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, stepEdge, rest, isEdge, joins,
        restPath, fresh): {
        take first : E;
        take second : E;
        suppose first ∈ List.prepend(E, stepEdge, rest);
        suppose second ∈ List.prepend(E, stepEdge, rest);
        suppose Graph.Incident(graph, first, stepSource);
        suppose Graph.Incident(graph, second, stepSource);
        ∀ (candidate : E). candidate ∈ List.prepend(E, stepEdge, rest)
            → Graph.Incident(graph, candidate, stepSource)
            → candidate = stepEdge
            by { take candidate : E;
                 suppose candidate ∈ List.prepend(E, stepEdge, rest);
                 suppose Graph.Incident(graph, candidate, stepSource);
                 candidate = stepEdge ∨ candidate ∈ rest
                     by List.member_prepend_invert;
                 done by cases {
                   case candidate = stepEdge: done
                   case candidate ∈ rest: {
                       stepSource ∈ Graph.coveredVertices(graph, rest)
                           by Graph.coveredVertices.of_edge;
                       stepSource ∈ Graph.walkVertices(graph, waypoint, rest);
                       done
                     }
                 } };
        first = stepEdge;
        second = stepEdge;
        done
      }
  }

-- ----------------------------------------------------------------------
-- Both ends of a longest path are leaves.

-- A non-isolated end of a longest path in an acyclic graph has degree
-- one: every edge there is one of the path's, and the path leaves the
-- vertex only once, so they are all the same edge.
theorem Graph.IsAcyclic.longest_path_source_is_leaf (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (acyclic : Graph.IsAcyclic(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (longest : ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
            Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
            → length(otherEdges) ≤ length(edgeList))
        (notIsolated : 1 ≤ Graph.degree(graph, source))
        : Graph.degree(graph, source) = 1 := {
  choose someEdge such that someEdge ∈ Graph.incidentEdges(graph, source)
      from List.member_of_positive_length;
  someEdge ∈ Graph.edges(graph) by Graph.incidentEdges_is_edge;
  Graph.Incident(graph, someEdge, source) by Graph.incidentEdges_incident;
  someEdge ∈ edgeList by Graph.IsAcyclic.longest_path_source_edge;

  ∀ (candidate : E). candidate ∈ Graph.incidentEdges(graph, source)
      → candidate ∈ List.prepend(E, someEdge, List.empty(E))
      by { take candidate : E;
           suppose candidate ∈ Graph.incidentEdges(graph, source);
           candidate ∈ Graph.edges(graph) by Graph.incidentEdges_is_edge;
           Graph.Incident(graph, candidate, source) by Graph.incidentEdges_incident;
           candidate ∈ edgeList by Graph.IsAcyclic.longest_path_source_edge;
           candidate = someEdge by Graph.IsPath.one_edge_at_source;
           done };
  List.Distinct(E, Graph.edges(graph));
  List.Distinct(E, Graph.incidentEdges(graph, source)) by List.filter_distinct;
  Graph.degree(graph, source)
     = length(Graph.incidentEdges(graph, source))
     ≤ length(List.prepend(E, someEdge, List.empty(E)))
         by List.length_le_of_distinct_inclusion
     = 1 + length(List.empty(E))
     = 1 + 0                      by List.length_empty
     = 1;
  done by Natural.le_antisymmetric
}

-- ----------------------------------------------------------------------
-- A tree on two or more vertices has a leaf.

-- Connectedness gives a path between two distinct vertices, so a longest
-- path is not the empty one, and its source is an end of an edge.
theorem Graph.IsTree.has_leaf (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (isTree : Graph.IsTree(graph))
        (atLeastTwo : 2 ≤ Graph.order(graph))
        : ∃ (vertex : V). Graph.IsLeaf(graph, vertex) := {
  Graph.IsConnected(graph);
  Graph.IsAcyclic(graph);
  List.Distinct(V, Graph.vertices(graph)) by Graph.IsWellFormed.vertices_distinct;

  -- Two distinct vertices, the second taken from what the first leaves.
  ∃ (vertex : V). vertex ∈ Graph.vertices(graph);
  choose firstVertex such that firstVertex ∈ Graph.vertices(graph);
  choose secondVertex such that
      secondVertex ∈ Graph.vertices(graph) ∧ secondVertex ≠ firstVertex
      from Graph.other_vertex;
  secondVertex ∈ Graph.vertices(graph);
  secondVertex ≠ firstVertex;

  -- So some path between them takes at least one edge.
  Graph.Reaches(graph, firstVertex, secondVertex) by Graph.IsConnected.reaches;
  choose someEdges such that Graph.IsPath(graph, firstVertex, someEdges, secondVertex)
      from Graph.Reaches.path;
  ¬(someEdges = List.empty(E))
      by { suppose someEdges = List.empty(E);
           Graph.IsWalk(graph, firstVertex, someEdges, secondVertex)
               by Graph.IsPath.walk;
           firstVertex = secondVertex by Graph.IsWalk.empty_endpoints;
           secondVertex = firstVertex;
           done };
  1 ≤ length(someEdges) by List.length_positive_of_nonempty;

  -- A longest path is at least that long, so it too departs along an edge.
  choose longestSource, longestTarget, longestEdges such that
      Graph.IsPath(graph, longestSource, longestEdges, longestTarget)
      ∧ ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
          Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
          → length(otherEdges) ≤ length(longestEdges)
      from Graph.longest_path(someVertex := firstVertex);
  Graph.IsPath(graph, longestSource, longestEdges, longestTarget);
  ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
      Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
      → length(otherEdges) ≤ length(longestEdges) as nothingLonger;
  1 ≤ length(someEdges) ≤ length(longestEdges) by nothingLonger;
  ∃ (edge : E). edge ∈ longestEdges ∧ edge ∈ Graph.edges(graph)
      ∧ Graph.Incident(graph, edge, longestSource)
      by Graph.IsPath.first_edge;
  choose departure such that departure ∈ longestEdges
      ∧ departure ∈ Graph.edges(graph)
      ∧ Graph.Incident(graph, departure, longestSource);
  departure ∈ Graph.edges(graph);
  Graph.Incident(graph, departure, longestSource);
  departure ∈ Graph.incidentEdges(graph, longestSource)
      by Graph.incidentEdges_member;
  1 ≤ Graph.degree(graph, longestSource) by List.length_positive_of_member;
  Graph.degree(graph, longestSource) = 1
      by Graph.IsAcyclic.longest_path_source_is_leaf;
  choose farEnd such that Graph.Joins(graph, departure, longestSource, farEnd);
  longestSource ∈ Graph.vertices(graph) by Graph.IsWellFormed.end_is_vertex;
  witness longestSource
}

-- ----------------------------------------------------------------------
-- A path steers clear of a leaf.

-- To pass through a vertex of degree one a path would have to arrive and
-- leave along that vertex's single edge, and a path takes no edge twice.
-- So a path whose two ends are elsewhere never visits it at all.
theorem Graph.IsLeaf.path_avoids (graph : Graph(V, E, ends)) (leaf : V)
        (degreeOne : Graph.degree(graph, leaf) = 1)
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (sourceIsNotLeaf : source ≠ leaf)
        (targetIsNotLeaf : target ≠ leaf)
        : ¬(leaf ∈ Graph.walkVertices(graph, source, edgeList)) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): {
        suppose leaf ∈ Graph.walkVertices(graph, endpoint, List.empty(E));
        leaf = endpoint ∨ leaf ∈ Graph.coveredVertices(graph, List.empty(E));
        done by cases {
          case leaf = endpoint: {
              endpoint = leaf;
              done
            }
          case leaf ∈ Graph.coveredVertices(graph, List.empty(E)): {
              ¬(leaf ∈ Graph.coveredVertices(graph, List.empty(E)))
                  by Graph.coveredVertices.no_edges;
              done
            }
        }
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath,
        fresh): {
        suppose leaf ∈ Graph.walkVertices(graph, stepSource,
                                          List.prepend(E, edge, rest));
        leaf = stepSource ∨ leaf ∈ Graph.walkVertices(graph, waypoint, rest)
            by Graph.walkVertices.after_step;
        done by cases {
          case leaf = stepSource: {
              stepSource = leaf;
              done
            }
          case leaf ∈ Graph.walkVertices(graph, waypoint, rest): {
              done by cases {
                case waypoint = leaf: {
                    -- The step arrives at the leaf, so the rest has to
                    -- leave it — along the leaf's one edge, which the
                    -- step has already used.
                    ¬(rest = List.empty(E))
                        by { suppose rest = List.empty(E);
                             Graph.IsWalk(graph, waypoint, rest, stepTarget)
                                 by Graph.IsPath.walk;
                             waypoint = stepTarget
                                 by Graph.IsWalk.empty_endpoints;
                             stepTarget = leaf by substituting (waypoint = leaf);
                             done };
                    1 ≤ length(rest) by List.length_positive_of_nonempty;
                    ∃ (next : E). next ∈ rest ∧ next ∈ Graph.edges(graph)
                        ∧ Graph.Incident(graph, next, waypoint)
                        by Graph.IsPath.first_edge;
                    choose departure such that departure ∈ rest
                        ∧ departure ∈ Graph.edges(graph)
                        ∧ Graph.Incident(graph, departure, waypoint);
                    departure ∈ rest;
                    departure ∈ Graph.edges(graph);
                    Graph.Incident(graph, departure, waypoint);
                    Graph.Incident(graph, departure, leaf)
                        by substituting (waypoint = leaf);
                    departure ∈ Graph.incidentEdges(graph, leaf)
                        by Graph.incidentEdges_member;
                    Graph.Incident(graph, edge, waypoint)
                        by Graph.Joins.incident_target;
                    Graph.Incident(graph, edge, leaf)
                        by substituting (waypoint = leaf);
                    edge ∈ Graph.incidentEdges(graph, leaf)
                        by Graph.incidentEdges_member;
                    length(Graph.incidentEdges(graph, leaf)) = 1;
                    edge = departure by List.members_equal_of_length_one;

                    -- But the step's own edge is not in the rest.
                    Graph.Incident(graph, edge, stepSource)
                        by Graph.Joins.incident_source;
                    ¬(edge ∈ rest)
                        by { suppose edge ∈ rest;
                             stepSource ∈ Graph.coveredVertices(graph, rest)
                                 by Graph.coveredVertices.of_edge;
                             stepSource ∈ Graph.walkVertices(graph, waypoint, rest);
                             done };
                    edge ∈ rest by substituting (edge = departure);
                    done
                  }
                otherwise: {
                    ¬(leaf ∈ Graph.walkVertices(graph, waypoint, rest)) by IH;
                    done
                  }
              }
            }
        }
      }
  }

-- ----------------------------------------------------------------------
-- Deleting a leaf leaves a tree.

-- Acyclicity passes to any subgraph: a cycle downstairs is a cycle
-- upstairs, over the same edge and the same detour.
theorem Graph.IsAcyclic.in_subgraph (part whole : Graph(V, E, ends))
        (isSubgraph : Graph.IsSubgraph(part, whole))
        (acyclic : Graph.IsAcyclic(whole))
        : Graph.IsAcyclic(part) := {
  ∀ (candidate : E). candidate ∈ Graph.edges(part) → candidate ∈ Graph.edges(whole)
      as partEdges;
  take edge : E;
  suppose edge ∈ Graph.edges(part);
  suppose Graph.LiesOnCycle(part, edge);
  choose cycleSource, cycleTarget, detour such that
      Graph.IsCycleThrough(part, edge, cycleSource, cycleTarget, detour);
  Graph.Joins(part, edge, cycleSource, cycleTarget);
  Graph.IsPath(part, cycleSource, detour, cycleTarget);
  ¬(edge ∈ detour);
  edge ∈ Graph.edges(whole) by partEdges;
  Graph.Joins(whole, edge, cycleSource, cycleTarget);
  Graph.IsPath(whole, cycleSource, detour, cycleTarget) by Graph.IsPath.in_supergraph;
  Graph.LiesOnCycle(whole, edge)
      by witness cycleSource with witness cycleTarget with witness detour;
  ¬Graph.LiesOnCycle(whole, edge) by acyclic;
  done
}

-- A tree minus a leaf is a tree. Acyclicity is inherited; connectedness
-- survives because every path between two surviving vertices already
-- steered clear of the leaf.
theorem Graph.IsTree.delete_leaf (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (isTree : Graph.IsTree(graph))
        (leaf : V) (isLeaf : Graph.IsLeaf(graph, leaf))
        (atLeastTwo : 2 ≤ Graph.order(graph))
        : Graph.IsTree(Graph.deleteVertex(graph, leaf)) := {
  Graph.IsConnected(graph);
  Graph.IsAcyclic(graph);
  leaf ∈ Graph.vertices(graph);
  Graph.degree(graph, leaf) = 1;
  Graph.IsSubgraph(Graph.deleteVertex(graph, leaf), graph)
      by Graph.deleteVertex.IsSubgraph;
  Graph.IsAcyclic(Graph.deleteVertex(graph, leaf)) by Graph.IsAcyclic.in_subgraph;

  -- Something survives the deletion.
  choose survivor such that
      survivor ∈ Graph.vertices(graph) ∧ survivor ≠ leaf from Graph.other_vertex;
  survivor ∈ Graph.vertices(graph);
  survivor ≠ leaf;
  survivor ∈ Graph.vertices(Graph.deleteVertex(graph, leaf))
      by Graph.deleteVertex.keeps_vertex;
  ∃ (vertex : V). vertex ∈ Graph.vertices(Graph.deleteVertex(graph, leaf))
      by witness survivor;

  -- And every two survivors still reach each other.
  ∀ (u w : V). u ∈ Graph.vertices(Graph.deleteVertex(graph, leaf))
      → w ∈ Graph.vertices(Graph.deleteVertex(graph, leaf))
      → Graph.Reaches(Graph.deleteVertex(graph, leaf), u, w)
      by { take u : V;
           take w : V;
           suppose u ∈ Graph.vertices(Graph.deleteVertex(graph, leaf));
           suppose w ∈ Graph.vertices(Graph.deleteVertex(graph, leaf));
           u ≠ leaf by Graph.deleteVertex.drops;
           w ≠ leaf by Graph.deleteVertex.drops;
           u ∈ Graph.vertices(graph) by Graph.deleteVertex.is_vertex;
           w ∈ Graph.vertices(graph) by Graph.deleteVertex.is_vertex;
           Graph.Reaches(graph, u, w) by Graph.IsConnected.reaches;
           choose route such that Graph.IsPath(graph, u, route, w)
               from Graph.Reaches.path;
           ¬(leaf ∈ Graph.walkVertices(graph, u, route))
               by Graph.IsLeaf.path_avoids;
           Graph.IsWalk(graph, u, route, w) by Graph.IsPath.walk;
           Graph.IsWalk(Graph.deleteVertex(graph, leaf), u, route, w)
               by Graph.IsWalk.avoiding_vertex;
           witness route };
  done
}

-- ----------------------------------------------------------------------
-- A tree has one edge fewer than it has vertices.

-- Bounded, so the induction has a number to walk down: peel a leaf and
-- recurse on what is left, which is a tree with one vertex and one edge
-- fewer.
theorem Graph.IsTree.edge_count_below (bound : ℕ)
        : ∀ (graph : Graph(V, E, ends)). Graph.order(graph) ≤ bound
            → Graph.IsWellFormed(graph) → Graph.IsTree(graph)
            → 1 + Graph.size(graph) = Graph.order(graph) :=
  by induction on bound with IH {
    case bound = 0: {
        take graph : Graph(V, E, ends);
        suppose Graph.order(graph) ≤ 0;
        suppose Graph.IsWellFormed(graph);
        suppose Graph.IsTree(graph);
        Graph.IsConnected(graph);
        ∃ (vertex : V). vertex ∈ Graph.vertices(graph);
        choose inhabitant such that inhabitant ∈ Graph.vertices(graph);
        1 ≤ length(Graph.vertices(graph)) by List.length_positive_of_member;
        (1 : ℕ) + 0
           = 1
           ≤ Graph.order(graph)
           ≤ 0;
        done by Natural.not_one_plus_le_zero
      }
    case bound = 1 + smaller: {
        take graph : Graph(V, E, ends);
        suppose Graph.order(graph) ≤ 1 + smaller as orderBound;
        suppose Graph.IsWellFormed(graph);
        suppose Graph.IsTree(graph);
        Graph.IsConnected(graph);
        List.Distinct(V, Graph.vertices(graph))
            by Graph.IsWellFormed.vertices_distinct;
        done by cases {
          case 2 ≤ Graph.order(graph): {
              ∃ (vertex : V). Graph.IsLeaf(graph, vertex) by Graph.IsTree.has_leaf;
              choose leaf such that Graph.IsLeaf(graph, leaf);
              leaf ∈ Graph.vertices(graph);
              Graph.degree(graph, leaf) = 1;
              Graph.IsTree(Graph.deleteVertex(graph, leaf))
                  by Graph.IsTree.delete_leaf;
              Graph.IsWellFormed(Graph.deleteVertex(graph, leaf))
                  by Graph.deleteVertex.IsWellFormed;

              -- One vertex and one edge fewer.
              1 + Graph.order(Graph.deleteVertex(graph, leaf))
                 = 1 + length(Graph.vertices(graph) ∖ leaf)
                 = length(Graph.vertices(graph))     by List.length_remove_member
                 = Graph.order(graph)                as orderDrops;
              Graph.degree(graph, leaf)
                  + Graph.size(Graph.deleteVertex(graph, leaf))
                  = Graph.size(graph) by Graph.deleteVertex.size;
              1 + Graph.size(Graph.deleteVertex(graph, leaf))
                 = Graph.degree(graph, leaf)
                     + Graph.size(Graph.deleteVertex(graph, leaf))
                 = Graph.size(graph)                 as sizeDrops;

              -- What is left is small enough to recurse on.
              1 + Graph.order(Graph.deleteVertex(graph, leaf))
                 = Graph.order(graph)
                 ≤ 1 + smaller;
              Graph.order(Graph.deleteVertex(graph, leaf)) ≤ smaller
                  by Natural.add_left_le_cancel;
              1 + Graph.size(Graph.deleteVertex(graph, leaf))
                  = Graph.order(Graph.deleteVertex(graph, leaf)) by IH;
              1 + Graph.size(graph)
                 = 1 + (1 + Graph.size(Graph.deleteVertex(graph, leaf)))
                     by substituting sizeDrops
                 = 1 + Graph.order(Graph.deleteVertex(graph, leaf))
                 = Graph.order(graph)                by orderDrops
            }
          otherwise: {
              -- A single vertex, and no edge: an edge would need two.
              ∃ (vertex : V). vertex ∈ Graph.vertices(graph);
              choose inhabitant such that inhabitant ∈ Graph.vertices(graph);
              1 ≤ length(Graph.vertices(graph)) by List.length_positive_of_member;
              ¬(1 ≤ Graph.size(graph))
                  by { suppose 1 ≤ Graph.size(graph);
                       choose someEdge such that someEdge ∈ Graph.edges(graph)
                           from List.member_of_positive_length(
                                    list := Graph.edges(graph));
                       ∃ (x y : V). Graph.Joins(graph, someEdge, x, y)
                           by Graph.edge_has_ends;
                       choose endOne, endTwo such that
                           Graph.Joins(graph, someEdge, endOne, endTwo);
                       endOne ∈ Graph.vertices(graph)
                           by Graph.IsWellFormed.end_is_vertex;
                       endTwo ∈ Graph.vertices(graph)
                           by Graph.IsWellFormed.other_end_is_vertex;
                       endOne ≠ endTwo by Graph.IsWellFormed.no_loop;
                       endTwo ≠ endOne by Equality.not_equal_symmetric;
                       endTwo ∈ Graph.vertices(graph) ∖ endOne
                           by List.remove_member_complete;
                       1 ≤ length(Graph.vertices(graph) ∖ endOne)
                           by List.length_positive_of_member;
                       (2 : ℕ)
                          = 1 + 1
                          ≤ 1 + length(Graph.vertices(graph) ∖ endOne)
                          = length(Graph.vertices(graph))
                              by List.length_remove_member
                          = Graph.order(graph);
                       done };
              Graph.size(graph) < 1 by Natural.lt_of_not_le;
              Graph.size(graph) ≤ 0 by Natural.le_of_lt_one_plus;
              Graph.size(graph) = 0 as noEdges;
              Graph.order(graph) < 2 by Natural.lt_of_not_le;
              Graph.order(graph) ≤ 1 by Natural.le_of_lt_one_plus;
              Graph.order(graph) = 1 by Natural.le_antisymmetric;
              1 + Graph.size(graph)
                 = 1 + 0                             by substituting noEdges
                 = 1
                 = Graph.order(graph)
            }
        }
      }
  }

-- A tree has one edge fewer than it has vertices.
theorem Graph.IsTree.edge_count (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (isTree : Graph.IsTree(graph))
        : 1 + Graph.size(graph) = Graph.order(graph) := {
  Graph.order(graph) ≤ Graph.order(graph);
  done by Graph.IsTree.edge_count_below(bound := Graph.order(graph))
}

-- ----------------------------------------------------------------------
-- A tree with three leaves has a vertex of degree three.

-- In a connected graph on two or more vertices nothing is isolated.
theorem Graph.IsConnected.degree_positive (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (connected : Graph.IsConnected(graph))
        (atLeastTwo : 2 ≤ Graph.order(graph))
        (vertex : V) (isVertex : vertex ∈ Graph.vertices(graph))
        : 1 ≤ Graph.degree(graph, vertex) := {
  choose other such that other ∈ Graph.vertices(graph) ∧ other ≠ vertex
      from Graph.other_vertex;
  other ∈ Graph.vertices(graph);
  other ≠ vertex;
  Graph.Reaches(graph, vertex, other) by Graph.IsConnected.reaches;
  choose route such that Graph.IsPath(graph, vertex, route, other)
      from Graph.Reaches.path;
  ¬(route = List.empty(E))
      by { suppose route = List.empty(E);
           Graph.IsWalk(graph, vertex, route, other) by Graph.IsPath.walk;
           vertex = other by Graph.IsWalk.empty_endpoints;
           other = vertex;
           done };
  1 ≤ length(route) by List.length_positive_of_nonempty;
  ∃ (edge : E). edge ∈ route ∧ edge ∈ Graph.edges(graph)
      ∧ Graph.Incident(graph, edge, vertex) by Graph.IsPath.first_edge;
  choose departure such that departure ∈ route ∧ departure ∈ Graph.edges(graph)
      ∧ Graph.Incident(graph, departure, vertex);
  departure ∈ Graph.edges(graph);
  Graph.Incident(graph, departure, vertex);
  departure ∈ Graph.incidentEdges(graph, vertex) by Graph.incidentEdges_member;
  done by List.length_positive_of_member
}

-- The leaves of a graph, and the vertices that are not leaves.
definition Graph.leaves (graph : Graph(V, E, ends)) : List(V) :=
  List.filter((vertex : V) ↦ Graph.IsLeaf(graph, vertex), Graph.vertices(graph))

definition Graph.innerVertices (graph : Graph(V, E, ends)) : List(V) :=
  List.filter((vertex : V) ↦ ¬Graph.IsLeaf(graph, vertex), Graph.vertices(graph))

-- Three leaves, and every other vertex on at least two edges: the degrees
-- add up to twice the edges, which is two per vertex less two, so between
-- them the inner vertices carry exactly one degree above two apiece.
-- Whichever one carries it has degree three.
theorem Graph.IsTree.three_leaves (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (isTree : Graph.IsTree(graph))
        (atLeastTwo : 2 ≤ Graph.order(graph))
        (threeLeaves : length(Graph.leaves(graph)) = 3)
        : ∃ (vertex : V). vertex ∈ Graph.vertices(graph)
            ∧ Graph.degree(graph, vertex) = 3 := {
  -- What the inner vertices carry ABOVE two, and how many of them there are.
  -- The whole count below is about these two numbers.
  let excess : ℕ :=
    List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex) ∸ 2,
                 Graph.innerVertices(graph));
  let innerCount : ℕ := length(Graph.innerVertices(graph));
  Graph.IsConnected(graph);

  -- Each leaf contributes one to the degree sum.
  ∀ (vertex : V). vertex ∈ Graph.leaves(graph) → Graph.degree(graph, vertex) = 1
      by { take vertex : V;
           suppose vertex ∈ Graph.leaves(graph);
           Graph.IsLeaf(graph, vertex) by List.filter_member_property;
           done };
  List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.leaves(graph))
     = List.sumOver((vertex : V) ↦ 1, Graph.leaves(graph))
         by List.sumOver_congruence
     = 1 * length(Graph.leaves(graph))          by List.sumOver_constant
     = 1 * 3
     = 3                                        as leafDegreeSum;

  -- Each inner vertex is on at least two edges, so contributes two plus
  -- whatever it carries above that.
  ∀ (vertex : V). vertex ∈ Graph.innerVertices(graph)
      → Graph.degree(graph, vertex) = 2 + (Graph.degree(graph, vertex) ∸ 2)
      by { take vertex : V;
           suppose vertex ∈ Graph.innerVertices(graph);
           vertex ∈ Graph.vertices(graph) by List.filter_member_subset;
           ¬Graph.IsLeaf(graph, vertex) by List.filter_member_property;
           1 ≤ Graph.degree(graph, vertex) by Graph.IsConnected.degree_positive;
           ¬(Graph.degree(graph, vertex) = 1)
               by { suppose Graph.degree(graph, vertex) = 1;
                    Graph.IsLeaf(graph, vertex);
                    done };
           1 + 1 ≤ Graph.degree(graph, vertex);
           (2 : ℕ)
              = 1 + 1
              ≤ Graph.degree(graph, vertex);
           done by Natural.add_monus_of_le } as everyInnerVertexCarries;
  List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex),
               Graph.innerVertices(graph))
     = List.sumOver((vertex : V) ↦ 2 + (Graph.degree(graph, vertex) ∸ 2),
                    Graph.innerVertices(graph))
         by List.sumOver_congruence
     = List.sumOver((vertex : V) ↦ 2, Graph.innerVertices(graph)) + excess
         by List.sumOver_add
     = 2 * innerCount + excess by List.sumOver_constant     as innerDegreeSum;

  -- Leaves and inner vertices between them are the whole graph.
  List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.leaves(graph))
    + List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex),
                   Graph.innerVertices(graph))
    = List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex),
                   Graph.vertices(graph))
    by List.sumOver_filter_complement;
  List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.vertices(graph))
     = 2 * Graph.size(graph) by Graph.degree_sum;
  length(Graph.leaves(graph)) + innerCount
    = length(Graph.vertices(graph)) by List.filter_length_complement;

  -- Counting: the inner vertices carry exactly one degree between them.
  1 + Graph.size(graph) = Graph.order(graph) by Graph.IsTree.edge_count;
  (3 : ℕ) + innerCount
     = length(Graph.leaves(graph)) + innerCount
     = length(Graph.vertices(graph))
     = Graph.order(graph);
  1 + Graph.size(graph) = Graph.order(graph) = 3 + innerCount = 1 + (2 + innerCount);
  Graph.size(graph) = 2 + innerCount by Natural.add_cancel_left as sizeFromInner;
  (3 : ℕ) + excess + 2 * innerCount
     = 3 + (2 * innerCount + excess)
     = List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.leaves(graph))
         + (2 * innerCount + excess) by substituting leafDegreeSum
     = List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.leaves(graph))
         + List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex),
                        Graph.innerVertices(graph))
         by substituting innerDegreeSum
     = List.sumOver((vertex : V) ↦ Graph.degree(graph, vertex), Graph.vertices(graph))
     = 2 * Graph.size(graph)
     = 2 * (2 + innerCount) by substituting sizeFromInner
     = 4 + 2 * innerCount;
  (3 : ℕ) + excess = 4 by Natural.add_cancel_right;
  (3 : ℕ) + excess = 4 = 3 + 1;
  excess = 1 by Natural.add_cancel_left;

  -- And whichever inner vertex carries it has degree three.
  ∃ (vertex : V). vertex ∈ Graph.innerVertices(graph)
      ∧ Graph.degree(graph, vertex) ∸ 2 = 1 by List.sumOver_one_member;
  choose branchVertex such that branchVertex ∈ Graph.innerVertices(graph)
      ∧ Graph.degree(graph, branchVertex) ∸ 2 = 1;
  branchVertex ∈ Graph.innerVertices(graph);
  Graph.degree(graph, branchVertex) ∸ 2 = 1 as carriesOne;
  branchVertex ∈ Graph.vertices(graph) by List.filter_member_subset;
  Graph.degree(graph, branchVertex)
     = 2 + (Graph.degree(graph, branchVertex) ∸ 2) by everyInnerVertexCarries
     = 2 + 1                                       by substituting carriesOne
     = 3;
  witness branchVertex
}
