-- Graph/path.math
--
-- Paths: walks that never come back to a vertex they have visited.
-- Layer 5 of PLAN_JORDAN_SCHOENFLIES.md.
--
-- The condition is carried step by step — the vertex a step departs from
-- is not among those the rest of the path visits — rather than imposed
-- afterwards on a list of vertices. So a path is a walk with one clause
-- added at each step, and both relations are read by induction the same
-- way.
--
-- The theorem the layer is built for is at the bottom: a walk from one
-- vertex to another contains a path between them, using only the walk's
-- own edges. Every later connectivity argument reaches for a path and
-- gets it from a walk that was easy to build.

module Graph.path

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import Set.basics
import Lists.list
import Lists.length
import Lists.remove
import Lists.distinct
import Natural.least_number
import Graph.basics
import Graph.walk

convention V : Type(0)
convention E : Type(0)
convention ends : E → Pair(V, V)

inductive Graph.IsPathOver (V : Type(0)) (E : Type(0)) (ends : E → Pair(V, V))
        (graph : Graph(V, E, ends))
        : V → List(E) → V → Proposition where
  | Graph.IsPathOver.arrived
      : (vertex : V)
        → Graph.IsPathOver(V, E, ends, graph, vertex, List.empty(E), vertex)
  | Graph.IsPathOver.step
      : (source : V) → (waypoint : V) → (target : V) → (edge : E) → (rest : List(E))
        → edge ∈ Graph.edges(graph)
        → Graph.Joins(graph, edge, source, waypoint)
        → Graph.IsPathOver(V, E, ends, graph, waypoint, rest, target)
        → ¬(source ∈ Graph.walkVertices(graph, waypoint, rest))
        → Graph.IsPathOver(V, E, ends, graph, source, List.prepend(E, edge, rest), target)

definition Graph.IsPath (graph : Graph(V, E, ends)) (source : V) (edgeList : List(E))
        (target : V) : Proposition :=
  Graph.IsPathOver(V, E, ends, graph, source, edgeList, target)

theorem Graph.IsPath.empty (graph : Graph(V, E, ends)) (vertex : V)
        : Graph.IsPath(graph, vertex, List.empty(E), vertex) :=
  Graph.IsPathOver.arrived(V, E, ends, graph, vertex)

theorem Graph.IsPath.extend (graph : Graph(V, E, ends))
        (source waypoint target : V) (edge : E) (rest : List(E))
        (isEdge : edge ∈ Graph.edges(graph))
        (joins : Graph.Joins(graph, edge, source, waypoint))
        (restPath : Graph.IsPath(graph, waypoint, rest, target))
        (fresh : ¬(source ∈ Graph.walkVertices(graph, waypoint, rest)))
        : Graph.IsPath(graph, source, List.prepend(E, edge, rest), target) :=
  Graph.IsPathOver.step(V, E, ends, graph, source, waypoint, target, edge, rest,
                        isEdge, joins, restPath, fresh)

theorem Graph.IsPath.walk (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : Graph.IsWalk(graph, source, edgeList, target) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): done by Graph.IsWalk.empty
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath, fresh): {
        Graph.IsWalk(graph, waypoint, rest, stepTarget) by IH;
        done by Graph.IsWalk.extend
      }
  }

-- A path in a subgraph is a path in the graph. Its freshness clause reads
-- only which vertices the remaining edges touch, and that is a question
-- for the ambient, so — as for a walk — only edge membership travels.
theorem Graph.IsPath.in_supergraph (part whole : Graph(V, E, ends))
        (isSubgraph : Graph.IsSubgraph(part, whole))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(part, source, edgeList, target))
        : Graph.IsPath(whole, source, edgeList, target) := {
  ∀ (e : E). e ∈ Graph.edges(part) → e ∈ Graph.edges(whole) as partEdges;
  done by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): done by Graph.IsPath.empty
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath, fresh): {
        Graph.IsPath(whole, waypoint, rest, stepTarget) by IH;
        edge ∈ Graph.edges(whole) by partEdges;
        Graph.Joins(whole, edge, stepSource, waypoint);
        ¬(stepSource ∈ Graph.walkVertices(whole, waypoint, rest));
        done by Graph.IsPath.extend
      }
  }
}

theorem Graph.IsPath.edge_is_edge (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : ∀ (edge : E). edge ∈ edgeList → edge ∈ Graph.edges(graph) := {
  Graph.IsWalk(graph, source, edgeList, target) by Graph.IsPath.walk;
  done by Graph.IsWalk.edge_is_edge
}

-- ----------------------------------------------------------------------
-- Cutting a path at a vertex it visits.
--
-- A path that passes through a vertex has a piece of itself running from
-- that vertex to its target. This is the step that keeps the walk-to-path
-- construction below from having to lengthen anything: when the next
-- vertex is already on the path built so far, the path is cut there
-- instead of extended.

theorem Graph.IsPath.from_visited (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (vertex : V)
        (visited : vertex ∈ Graph.walkVertices(graph, source, edgeList))
        : ∃ (tailEdges : List(E)). Graph.IsPath(graph, vertex, tailEdges, target)
            ∧ ∀ (edge : E). edge ∈ tailEdges → edge ∈ edgeList :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): {
        done by cases {
          case vertex = endpoint: {
              Graph.IsPath(graph, endpoint, List.empty(E), endpoint) by Graph.IsPath.empty;
              Graph.IsPath(graph, vertex, List.empty(E), endpoint)
                  by substituting (vertex = endpoint);
              ∀ (edge : E). edge ∈ List.empty(E) → edge ∈ List.empty(E)
                  by { take edge : E; suppose edge ∈ List.empty(E); done };
              witness List.empty(E)
            }
          case vertex ∈ Graph.coveredVertices(graph, List.empty(E)): {
              ¬(vertex ∈ Graph.coveredVertices(graph, List.empty(E)))
                  by Graph.coveredVertices.no_edges;
              done
            }
        }
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath, fresh): {
        vertex = stepSource ∨ vertex ∈ Graph.walkVertices(graph, waypoint, rest)
            by Graph.walkVertices.after_step;
        done by cases {
          case vertex = stepSource: {
              Graph.IsPath(graph, stepSource, List.prepend(E, edge, rest), stepTarget)
                  by Graph.IsPath.extend;
              Graph.IsPath(graph, vertex, List.prepend(E, edge, rest), stepTarget)
                  by substituting (vertex = stepSource);
              ∀ (e : E). e ∈ List.prepend(E, edge, rest) → e ∈ List.prepend(E, edge, rest)
                  by { take e : E; suppose e ∈ List.prepend(E, edge, rest); done };
              witness List.prepend(E, edge, rest)
            }
          case vertex ∈ Graph.walkVertices(graph, waypoint, rest): {
              choose tailEdges such that
                  Graph.IsPath(graph, vertex, tailEdges, stepTarget)
                  ∧ ∀ (e : E). e ∈ tailEdges → e ∈ rest
                  from IH;
              Graph.IsPath(graph, vertex, tailEdges, stepTarget);
              ∀ (e : E). e ∈ tailEdges → e ∈ rest as tailInRest;
              ∀ (e : E). e ∈ tailEdges → e ∈ List.prepend(E, edge, rest)
                  by { take e : E;
                       suppose e ∈ tailEdges;
                       e ∈ rest by tailInRest;
                       done };
              witness tailEdges
            }
        }
      }
  }

-- ----------------------------------------------------------------------
-- Every walk contains a path.

theorem Graph.IsWalk.contains_path (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : ∃ (pathEdges : List(E)). Graph.IsPath(graph, source, pathEdges, target)
            ∧ ∀ (edge : E). edge ∈ pathEdges → edge ∈ edgeList :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(endpoint): {
        Graph.IsPath(graph, endpoint, List.empty(E), endpoint) by Graph.IsPath.empty;
        ∀ (edge : E). edge ∈ List.empty(E) → edge ∈ List.empty(E)
            by { take edge : E; suppose edge ∈ List.empty(E); done };
        witness List.empty(E)
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        choose pathEdges such that
            Graph.IsPath(graph, waypoint, pathEdges, stepTarget)
            ∧ ∀ (e : E). e ∈ pathEdges → e ∈ rest
            from IH;
        Graph.IsPath(graph, waypoint, pathEdges, stepTarget);
        ∀ (e : E). e ∈ pathEdges → e ∈ rest as pathInRest;
        ∀ (e : E). e ∈ pathEdges → e ∈ List.prepend(E, edge, rest)
            by { take e : E;
                 suppose e ∈ pathEdges;
                 e ∈ rest by pathInRest;
                 done } as pathInWalk;
        done by cases {
          case stepSource ∈ Graph.walkVertices(graph, waypoint, pathEdges): {
              choose tailEdges such that
                  Graph.IsPath(graph, stepSource, tailEdges, stepTarget)
                  ∧ ∀ (e : E). e ∈ tailEdges → e ∈ pathEdges
                  from Graph.IsPath.from_visited;
              Graph.IsPath(graph, stepSource, tailEdges, stepTarget);
              ∀ (e : E). e ∈ tailEdges → e ∈ pathEdges as tailInPath;
              ∀ (e : E). e ∈ tailEdges → e ∈ List.prepend(E, edge, rest)
                  by { take e : E;
                       suppose e ∈ tailEdges;
                       e ∈ pathEdges by tailInPath;
                       done by pathInWalk };
              witness tailEdges
            }
          otherwise: {
              ¬(stepSource ∈ Graph.walkVertices(graph, waypoint, pathEdges));
              Graph.IsPath(graph, stepSource, List.prepend(E, edge, pathEdges), stepTarget)
                  by Graph.IsPath.extend;
              ∀ (e : E). e ∈ List.prepend(E, edge, pathEdges)
                  → e ∈ List.prepend(E, edge, rest)
                  by { take e : E;
                       suppose e ∈ List.prepend(E, edge, pathEdges);
                       e = edge ∨ e ∈ pathEdges by List.member_prepend_invert;
                       done by cases {
                         case e = edge: {
                             e ∈ List.prepend(E, edge, rest) by substituting (e = edge);
                             done
                           }
                         case e ∈ pathEdges: done by pathInWalk
                       } };
              witness List.prepend(E, edge, pathEdges)
            }
        }
      }
  }

-- ----------------------------------------------------------------------
-- Splitting a path at a vertex it visits.
--
-- The suffix alone is `Graph.IsPath.from_visited`; what an ear argument
-- needs is both halves, and the prefix is the awkward one — the relation
-- is built at the source end, so the prefix is what the induction has to
-- carry forward rather than read off. It carries: the recursive call
-- splits the rest, and the step's edge goes in front of the prefix, whose
-- freshness is inherited because a prefix of the rest visits no more than
-- the rest does.

theorem Graph.IsPath.split (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (vertex : V)
        (visited : vertex ∈ Graph.walkVertices(graph, source, edgeList))
        : ∃ (prefixEdges : List(E)). ∃ (suffixEdges : List(E)).
            edgeList = List.append(prefixEdges, suffixEdges)
            ∧ Graph.IsPath(graph, source, prefixEdges, vertex)
            ∧ Graph.IsPath(graph, vertex, suffixEdges, target)
            ∧ (vertex = source
                 ∨ ¬(source ∈ Graph.walkVertices(graph, vertex, suffixEdges))) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): {
        done by cases {
          case vertex = endpoint: {
              Graph.IsPath(graph, endpoint, List.empty(E), endpoint) by Graph.IsPath.empty;
              Graph.IsPath(graph, endpoint, List.empty(E), vertex)
                  by substituting (vertex = endpoint);
              Graph.IsPath(graph, vertex, List.empty(E), endpoint)
                  by substituting (vertex = endpoint);
              List.empty(E) = List.append(List.empty(E), List.empty(E));
              vertex = endpoint
                  ∨ ¬(endpoint ∈ Graph.walkVertices(graph, vertex, List.empty(E)));
              witness List.empty(E) with witness List.empty(E) with done
            }
          case vertex ∈ Graph.coveredVertices(graph, List.empty(E)): {
              ¬(vertex ∈ Graph.coveredVertices(graph, List.empty(E)))
                  by Graph.coveredVertices.no_edges;
              done
            }
        }
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath, fresh): {
        vertex = stepSource ∨ vertex ∈ Graph.walkVertices(graph, waypoint, rest)
            by Graph.walkVertices.after_step;
        done by cases {
          case vertex = stepSource: {
              Graph.IsPath(graph, stepSource, List.empty(E), stepSource)
                  by Graph.IsPath.empty;
              Graph.IsPath(graph, stepSource, List.empty(E), vertex)
                  by substituting (vertex = stepSource);
              Graph.IsPath(graph, stepSource, List.prepend(E, edge, rest), stepTarget)
                  by Graph.IsPath.extend;
              Graph.IsPath(graph, vertex, List.prepend(E, edge, rest), stepTarget)
                  by substituting (vertex = stepSource);
              List.prepend(E, edge, rest)
                 = List.append(List.empty(E), List.prepend(E, edge, rest));
              vertex = stepSource
                  ∨ ¬(stepSource ∈ Graph.walkVertices(graph, vertex,
                          List.prepend(E, edge, rest)));
              witness List.empty(E) with witness List.prepend(E, edge, rest)
            }
          case vertex ∈ Graph.walkVertices(graph, waypoint, rest): {
              choose earlyEdges, lateEdges such that
                  rest = List.append(earlyEdges, lateEdges)
                  ∧ Graph.IsPath(graph, waypoint, earlyEdges, vertex)
                  ∧ Graph.IsPath(graph, vertex, lateEdges, stepTarget)
                  ∧ (vertex = waypoint
                       ∨ ¬(waypoint ∈ Graph.walkVertices(graph, vertex, lateEdges)))
                  from IH;
              rest = List.append(earlyEdges, lateEdges) as restSplits;
              Graph.IsPath(graph, waypoint, earlyEdges, vertex);
              Graph.IsPath(graph, vertex, lateEdges, stepTarget);
              -- The step's departure vertex is still fresh: the early
              -- edges are among the rest, so they visit no more than it.
              ∀ (candidate : E). candidate ∈ earlyEdges → candidate ∈ rest
                  by { take candidate : E;
                       suppose candidate ∈ earlyEdges;
                       candidate ∈ List.append(earlyEdges, lateEdges)
                           by List.member_append_left;
                       done by substituting restSplits };
              ¬(stepSource ∈ Graph.walkVertices(graph, waypoint, earlyEdges))
                  by { suppose stepSource ∈ Graph.walkVertices(graph, waypoint, earlyEdges);
                       stepSource ∈ Graph.walkVertices(graph, waypoint, rest)
                           by Graph.walkVertices.monotone;
                       done };
              Graph.IsPath(graph, stepSource, List.prepend(E, edge, earlyEdges), vertex)
                  by Graph.IsPath.extend;
              List.prepend(E, edge, rest)
                 = List.prepend(E, edge, List.append(earlyEdges, lateEdges))
                       by substituting restSplits
                 = List.append(List.prepend(E, edge, earlyEdges), lateEdges);
              -- The late edges are among the rest, which the step's
              -- departure vertex already avoided.
              ∀ (candidate : E). candidate ∈ lateEdges → candidate ∈ rest
                  by { take candidate : E;
                       suppose candidate ∈ lateEdges;
                       candidate ∈ List.append(earlyEdges, lateEdges)
                           by List.member_append_right;
                       done by substituting restSplits };
              ¬(stepSource ∈ Graph.walkVertices(graph, vertex, lateEdges))
                  by { suppose stepSource ∈ Graph.walkVertices(graph, vertex, lateEdges);
                       done by cases {
                         case stepSource = vertex: {
                             stepSource ∈ Graph.walkVertices(graph, waypoint, rest)
                                 by substituting (stepSource = vertex);
                             done
                           }
                         case stepSource ∈ Graph.coveredVertices(graph, lateEdges): {
                             stepSource ∈ Graph.coveredVertices(graph, rest)
                                 by Graph.coveredVertices.monotone;
                             stepSource ∈ Graph.walkVertices(graph, waypoint, rest);
                             done
                           }
                       } };
              witness List.prepend(E, edge, earlyEdges) with witness lateEdges
            }
        }
      }
  }

-- A path takes no edge twice: an edge it took again would put the vertex
-- it departed from back among the ones the rest of the path visits.
theorem Graph.IsPath.distinct_edges (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : List.Distinct(E, edgeList) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): done by List.Distinct.empty
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath, fresh): {
        List.Distinct(E, rest) by IH;
        Graph.Incident(graph, edge, stepSource) by Graph.Joins.incident_source;
        ¬(edge ∈ rest)
            by { suppose edge ∈ rest;
                 stepSource ∈ Graph.coveredVertices(graph, rest)
                     by Graph.coveredVertices.of_edge;
                 stepSource ∈ Graph.walkVertices(graph, waypoint, rest);
                 done };
        done by List.Distinct.prepend
      }
  }

-- Hence a path is no longer than the graph it runs in: its edges are
-- distinct edges of the graph, and a list without repetitions cannot
-- outrun a list holding all of its elements.
theorem Graph.IsPath.length_le_size (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : length(edgeList) ≤ Graph.size(graph) := {
  List.Distinct(E, edgeList) by Graph.IsPath.distinct_edges;
  ∀ (edge : E). edge ∈ edgeList → edge ∈ Graph.edges(graph)
      by Graph.IsPath.edge_is_edge;
  length(edgeList) ≤ length(Graph.edges(graph))
      by List.length_le_of_distinct_inclusion;
  done
}

-- ----------------------------------------------------------------------
-- A longest path.

-- `graph` runs a path of exactly this many edges.
definition Graph.HasPathOfLength (graph : Graph(V, E, ends)) (edgeCount : ℕ)
        : Proposition :=
  ∃ (source target : V). ∃ (edgeList : List(E)).
      Graph.IsPath(graph, source, edgeList, target) ∧ length(edgeList) = edgeCount

-- Every graph over an inhabited vertex type runs a path no shorter than
-- any other. There is one to beat — the empty path at any vertex — and
-- none can beat the edge count, so among the lengths that occur there is
-- a greatest.
theorem Graph.longest_path (graph : Graph(V, E, ends)) (someVertex : V)
        : ∃ (source target : V). ∃ (edgeList : List(E)).
            Graph.IsPath(graph, source, edgeList, target)
            ∧ ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
                Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
                → length(otherEdges) ≤ length(edgeList) := {
  Graph.IsPath(graph, someVertex, List.empty(E), someVertex);
  Graph.HasPathOfLength(graph, 0)
      by { witness someVertex with witness someVertex with witness List.empty(E) };
  ∀ (k : ℕ). Graph.HasPathOfLength(graph, k) → k ≤ Graph.size(graph)
      by { take k : ℕ;
           suppose Graph.HasPathOfLength(graph, k);
           choose pathSource, pathTarget, pathEdges such that
               Graph.IsPath(graph, pathSource, pathEdges, pathTarget)
               ∧ length(pathEdges) = k;
           length(pathEdges) ≤ Graph.size(graph) by Graph.IsPath.length_le_size;
           done };
  choose longest such that Graph.HasPathOfLength(graph, longest)
      ∧ ∀ (k : ℕ). Graph.HasPathOfLength(graph, k) → k ≤ longest
      from Natural.greatest_witness(n := 0);
  Graph.HasPathOfLength(graph, longest) as longestOccurs;
  ∀ (k : ℕ). Graph.HasPathOfLength(graph, k) → k ≤ longest;
  choose source, target, edgeList such that
      Graph.IsPath(graph, source, edgeList, target) ∧ length(edgeList) = longest
      from longestOccurs;
  Graph.IsPath(graph, source, edgeList, target);
  length(edgeList) = longest;
  ∀ (otherSource otherTarget : V). ∀ (otherEdges : List(E)).
      Graph.IsPath(graph, otherSource, otherEdges, otherTarget)
      → length(otherEdges) ≤ length(edgeList)
      by { take otherSource : V;
           take otherTarget : V;
           take otherEdges : List(E);
           suppose Graph.IsPath(graph, otherSource, otherEdges, otherTarget);
           Graph.HasPathOfLength(graph, length(otherEdges))
               by { witness otherSource with witness otherTarget
                        with witness otherEdges };
           length(otherEdges) ≤ longest;
           done };
  witness source with witness target with witness edgeList
}

-- A path that goes anywhere at all departs along one of its own edges.
theorem Graph.IsPath.first_edge (graph : Graph(V, E, ends))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (nonempty : 1 ≤ length(edgeList))
        : ∃ (edge : E). edge ∈ edgeList ∧ edge ∈ Graph.edges(graph)
            ∧ Graph.Incident(graph, edge, source) :=
  by induction on path {
    case Graph.IsPathOver.arrived(endpoint): {
        (1 : ℕ) ≤ length(List.empty(E))
           = 0;
        done
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath,
        fresh): {
        edge ∈ List.prepend(E, edge, rest);
        Graph.Incident(graph, edge, stepSource) by witness waypoint;
        witness edge
      }
  }

-- A path moves to any graph holding its edges — the walk transfers, and
-- the freshness condition reads only the ends, which are the ambient's.
theorem Graph.IsPath.transfer (graph other : Graph(V, E, ends))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        (edgesSurvive : ∀ (candidate : E). candidate ∈ edgeList
            → candidate ∈ Graph.edges(other))
        : Graph.IsPath(other, source, edgeList, target) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): done by Graph.IsPath.empty
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath,
        fresh): {
        ∀ (candidate : E). candidate ∈ rest → candidate ∈ Graph.edges(other)
            by { take candidate : E;
                 suppose candidate ∈ rest;
                 candidate ∈ List.prepend(E, edge, rest);
                 done by edgesSurvive };
        Graph.IsPath(other, waypoint, rest, stepTarget) by IH;
        edge ∈ List.prepend(E, edge, rest);
        edge ∈ Graph.edges(other) by edgesSurvive;
        Graph.Joins(other, edge, stepSource, waypoint);
        ¬(stepSource ∈ Graph.walkVertices(other, waypoint, rest));
        done by Graph.IsPath.extend
      }
  }

-- A path never returns to a vertex it has left, so the vertices it
-- visits, listed in order, repeat nothing.
theorem Graph.IsPath.vertexList_distinct (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (source target : V) (edgeList : List(E))
        (path : Graph.IsPath(graph, source, edgeList, target))
        : List.Distinct(V, Graph.walkVertexList(graph, source, edgeList)) :=
  by induction on path with IH {
    case Graph.IsPathOver.arrived(endpoint): {
        ¬(endpoint ∈ List.empty(V)) by List.no_member_empty;
        List.Distinct(V, List.empty(V)) by List.Distinct.empty;
        List.Distinct(V, List.prepend(V, endpoint, List.empty(V)))
            by List.Distinct.prepend;
        done
      }
    case Graph.IsPathOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restPath,
        fresh): {
        List.Distinct(V, Graph.walkVertexList(graph, waypoint, rest)) by IH;
        ¬(stepSource = waypoint) by Graph.IsWellFormed.no_loop;
        Graph.otherEnd(graph, edge, stepSource) = waypoint
            by Graph.otherEnd.of_joins as arrivesAtWaypoint;
        ¬(stepSource ∈ Graph.walkVertexList(graph, waypoint, rest))
            by { suppose stepSource ∈ Graph.walkVertexList(graph, waypoint, rest);
                 stepSource ∈ Graph.walkVertices(graph, waypoint, rest)
                     by Graph.walkVertexList.visits;
                 done };
        List.Distinct(V, List.prepend(V, stepSource,
            Graph.walkVertexList(graph, waypoint, rest)))
            by List.Distinct.prepend;
        List.Distinct(V, List.prepend(V, stepSource,
            Graph.walkVertexList(graph,
                Graph.otherEnd(graph, edge, stepSource), rest)))
            by substituting arrivesAtWaypoint;
        done
      }
  }

-- One edge between two distinct vertices is a path.
theorem Graph.IsPath.single (graph : Graph(V, E, ends)) (edge : E) (u v : V)
        (isEdge : edge ∈ Graph.edges(graph))
        (joins : Graph.Joins(graph, edge, u, v))
        (distinct : ¬(u = v))
        : Graph.IsPath(graph, u, List.prepend(E, edge, List.empty(E)), v) := {
  Graph.IsPath(graph, v, List.empty(E), v) by Graph.IsPath.empty;
  ¬(u ∈ Graph.walkVertices(graph, v, List.empty(E)))
      by { suppose u ∈ Graph.walkVertices(graph, v, List.empty(E));
           done by cases {
             case u = v: done
             case u ∈ Graph.coveredVertices(graph, List.empty(E)): {
                 ¬(u ∈ Graph.coveredVertices(graph, List.empty(E)))
                     by Graph.coveredVertices.no_edges;
                 done
               }
           } };
  done by Graph.IsPath.extend
}
