-- Graph/walk.math
--
-- Walks. Layer 5 of PLAN_JORDAN_SCHOENFLIES.md.
--
-- A walk from `source` to `target` is a list of edges, each one taken
-- from the vertex the previous one arrived at. It names its EDGES and
-- not its vertices: with parallel edges around, the vertices would not
-- determine the walk, while the edges always determine the vertices —
-- an edge with two distinct ends leaves no choice about where taking it
-- arrives (`Graph.Joins.unique`).
--
-- Read the relation as it is built: `Graph.IsWalk(graph, source,
-- edgeList, target)` extends at the SOURCE end, because that is the end
-- a list is extended at. Walking the other way — concatenating and
-- reversing — is proved here, and after that no argument has to care.
--
-- The vertices a walk visits are a `Set(V)`, not a list: nothing counts
-- them, and every consumer asks whether a particular vertex is on the
-- walk.

module Graph.walk

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import Set.basics
import Lists.list
import Lists.append
import Lists.length
import Graph.basics

convention V : Type(0)
convention E : Type(0)
convention ends : E → Pair(V, V)

inductive Graph.IsWalkOver (V : Type(0)) (E : Type(0)) (ends : E → Pair(V, V))
        (graph : Graph(V, E, ends))
        : V → List(E) → V → Proposition where
  | Graph.IsWalkOver.arrived
      : (vertex : V)
        → Graph.IsWalkOver(V, E, ends, graph, vertex, List.empty(E), vertex)
  | Graph.IsWalkOver.step
      : (source : V) → (waypoint : V) → (target : V) → (edge : E) → (rest : List(E))
        → edge ∈ Graph.edges(graph)
        → Graph.Joins(graph, edge, source, waypoint)
        → Graph.IsWalkOver(V, E, ends, graph, waypoint, rest, target)
        → Graph.IsWalkOver(V, E, ends, graph, source, List.prepend(E, edge, rest), target)

-- The reader every statement uses: it recovers the ambient from the
-- graph, which the inductive itself cannot do — its parameters are
-- explicit, and `ends` occurs in none of the indices. Transparent, so
-- induction on a walk, the constructors, and every lemma below speak the
-- same relation.
definition Graph.IsWalk (graph : Graph(V, E, ends)) (source : V) (edgeList : List(E))
        (target : V) : Proposition :=
  Graph.IsWalkOver(V, E, ends, graph, source, edgeList, target)

-- The two constructors, restated through the reader.
theorem Graph.IsWalk.empty (graph : Graph(V, E, ends)) (vertex : V)
        : Graph.IsWalk(graph, vertex, List.empty(E), vertex) :=
  Graph.IsWalkOver.arrived(V, E, ends, graph, vertex)

theorem Graph.IsWalk.extend (graph : Graph(V, E, ends))
        (source waypoint target : V) (edge : E) (rest : List(E))
        (isEdge : edge ∈ Graph.edges(graph))
        (joins : Graph.Joins(graph, edge, source, waypoint))
        (restWalk : Graph.IsWalk(graph, waypoint, rest, target))
        : Graph.IsWalk(graph, source, List.prepend(E, edge, rest), target) :=
  Graph.IsWalkOver.step(V, E, ends, graph, source, waypoint, target, edge, rest,
                        isEdge, joins, restWalk)

-- The vertices an edge list touches, and the vertices a walk visits: the
-- source, plus the ends of every edge taken. A walk with no edges visits
-- only its source, which is also its target.
definition Graph.coveredVertices (graph : Graph(V, E, ends)) (edgeList : List(E)) : Set(V) :=
  (vertex : V) ↦ ∃ (edge : E). edge ∈ edgeList ∧ Graph.Incident(graph, edge, vertex)

definition Graph.walkVertices (graph : Graph(V, E, ends)) (source : V) (edgeList : List(E))
        : Set(V) :=
  (vertex : V) ↦ vertex = source ∨ vertex ∈ Graph.coveredVertices(graph, edgeList)

theorem Graph.coveredVertices.no_edges (graph : Graph(V, E, ends)) (vertex : V)
        : vertex ∉ Graph.coveredVertices(graph, List.empty(E)) := {
  suppose vertex ∈ Graph.coveredVertices(graph, List.empty(E));
  choose usedEdge such that usedEdge ∈ List.empty(E) ∧ Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ List.empty(E);
  usedEdge ∉ List.empty(E) by List.no_member_empty;
  done
}

theorem Graph.coveredVertices.of_edge (graph : Graph(V, E, ends)) (edge : E)
        (edgeList : List(E)) (vertex : V)
        (isMember : edge ∈ edgeList)
        (incident : Graph.Incident(graph, edge, vertex))
        : vertex ∈ Graph.coveredVertices(graph, edgeList) :=
  witness edge

theorem Graph.coveredVertices.invert (graph : Graph(V, E, ends)) (edge : E)
        (rest : List(E)) (vertex : V)
        (covered : vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest)))
        : Graph.Incident(graph, edge, vertex)
          ∨ vertex ∈ Graph.coveredVertices(graph, rest) := {
  choose usedEdge such that
      usedEdge ∈ List.prepend(E, edge, rest) ∧ Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ List.prepend(E, edge, rest);
  Graph.Incident(graph, usedEdge, vertex);
  usedEdge = edge ∨ usedEdge ∈ rest by List.member_prepend_invert;
  done by cases {
    case usedEdge = edge: {
        Graph.Incident(graph, edge, vertex) by substituting (usedEdge = edge);
        done
      }
    case usedEdge ∈ rest: {
        vertex ∈ Graph.coveredVertices(graph, rest) by Graph.coveredVertices.of_edge;
        done
      }
  }
}

-- A vertex covered by a concatenation is covered by one of the halves.
theorem Graph.coveredVertices.append_invert (graph : Graph(V, E, ends))
        (firstEdges secondEdges : List(E)) (vertex : V)
        (covered : vertex ∈ Graph.coveredVertices(graph,
                       List.append(firstEdges, secondEdges)))
        : vertex ∈ Graph.coveredVertices(graph, firstEdges)
          ∨ vertex ∈ Graph.coveredVertices(graph, secondEdges) := {
  choose usedEdge such that
      usedEdge ∈ List.append(firstEdges, secondEdges)
      ∧ Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ List.append(firstEdges, secondEdges);
  Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ firstEdges ∨ usedEdge ∈ secondEdges by List.member_append_invert;
  done by cases {
    case usedEdge ∈ firstEdges: {
        vertex ∈ Graph.coveredVertices(graph, firstEdges)
            by Graph.coveredVertices.of_edge;
        done
      }
    case usedEdge ∈ secondEdges: {
        vertex ∈ Graph.coveredVertices(graph, secondEdges)
            by Graph.coveredVertices.of_edge;
        done
      }
  }
}

-- A longer edge list covers everything a shorter one does.
theorem Graph.coveredVertices.monotone (graph : Graph(V, E, ends))
        (fewer more : List(E)) (vertex : V)
        (inclusion : fewer ⊆ more)
        (covered : vertex ∈ Graph.coveredVertices(graph, fewer))
        : vertex ∈ Graph.coveredVertices(graph, more) := {
  choose usedEdge such that usedEdge ∈ fewer ∧ Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ fewer;
  Graph.Incident(graph, usedEdge, vertex);
  usedEdge ∈ more by inclusion;
  done by Graph.coveredVertices.of_edge
}

-- The two ways to move the visited set across a first step: a vertex the
-- walk visits is its source or is visited by what remains, and everything
-- the remainder visits the whole walk visits too.
theorem Graph.walkVertices.after_step (graph : Graph(V, E, ends))
        (source waypoint vertex : V) (edge : E) (rest : List(E))
        (joins : Graph.Joins(graph, edge, source, waypoint))
        (visited : vertex ∈ Graph.walkVertices(graph, source, List.prepend(E, edge, rest)))
        : vertex = source ∨ vertex ∈ Graph.walkVertices(graph, waypoint, rest) :=
  done by cases {
    case vertex = source: done
    case vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest)): {
        Graph.Incident(graph, edge, vertex) ∨ vertex ∈ Graph.coveredVertices(graph, rest)
            by Graph.coveredVertices.invert;
        done by cases {
          case Graph.Incident(graph, edge, vertex): {
              vertex = source ∨ vertex = waypoint by Graph.Incident.is_end;
              done by cases {
                case vertex = source: done
                case vertex = waypoint: {
                    vertex ∈ Graph.walkVertices(graph, waypoint, rest);
                    done
                  }
              }
            }
          case vertex ∈ Graph.coveredVertices(graph, rest): {
              vertex ∈ Graph.walkVertices(graph, waypoint, rest);
              done
            }
        }
      }
  }

theorem Graph.walkVertices.before_step (graph : Graph(V, E, ends))
        (source waypoint vertex : V) (edge : E) (rest : List(E))
        (joins : Graph.Joins(graph, edge, source, waypoint))
        (visited : vertex ∈ Graph.walkVertices(graph, waypoint, rest))
        : vertex ∈ Graph.walkVertices(graph, source, List.prepend(E, edge, rest)) :=
  done by cases {
    case vertex = waypoint: {
        Graph.Incident(graph, edge, waypoint) by Graph.Joins.incident_target;
        Graph.Incident(graph, edge, vertex) by substituting (vertex = waypoint);
        edge ∈ List.prepend(E, edge, rest);
        vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
            by Graph.coveredVertices.of_edge;
        done
      }
    case vertex ∈ Graph.coveredVertices(graph, rest): {
        rest ⊆ List.prepend(E, edge, rest) by List.Includes.prepend;
        vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
            by Graph.coveredVertices.monotone;
        done
      }
  }

-- A walk along fewer edges visits fewer vertices.
theorem Graph.walkVertices.monotone (graph : Graph(V, E, ends)) (source vertex : V)
        (fewer more : List(E))
        (inclusion : fewer ⊆ more)
        (visited : vertex ∈ Graph.walkVertices(graph, source, fewer))
        : vertex ∈ Graph.walkVertices(graph, source, more) :=
  done by cases {
    case vertex = source: done
    case vertex ∈ Graph.coveredVertices(graph, fewer): {
        vertex ∈ Graph.coveredVertices(graph, more) by Graph.coveredVertices.monotone;
        done
      }
  }

theorem Graph.walkVertices.source (graph : Graph(V, E, ends)) (source : V)
        (edgeList : List(E))
        : source ∈ Graph.walkVertices(graph, source, edgeList) :=
  done

theorem Graph.walkVertices.of_covered (graph : Graph(V, E, ends)) (source vertex : V)
        (edgeList : List(E))
        (covered : vertex ∈ Graph.coveredVertices(graph, edgeList))
        : vertex ∈ Graph.walkVertices(graph, source, edgeList) :=
  done

-- ----------------------------------------------------------------------
-- Building walks.

theorem Graph.IsWalk.single (graph : Graph(V, E, ends)) (edge : E) (source target : V)
        (isEdge : edge ∈ Graph.edges(graph))
        (joins : Graph.Joins(graph, edge, source, target))
        : Graph.IsWalk(graph, source, List.prepend(E, edge, List.empty(E)), target) := {
  Graph.IsWalk(graph, target, List.empty(E), target) by Graph.IsWalk.empty;
  done by Graph.IsWalk.extend
}

theorem Graph.IsWalk.append (graph : Graph(V, E, ends)) (source middle target : V)
        (firstEdges secondEdges : List(E))
        (firstWalk : Graph.IsWalk(graph, source, firstEdges, middle))
        (secondWalk : Graph.IsWalk(graph, middle, secondEdges, target))
        : Graph.IsWalk(graph, source, List.append(firstEdges, secondEdges), target) :=
  by induction on firstWalk with IH {
    case Graph.IsWalkOver.arrived(vertex): {
        List.append(List.empty(E), secondEdges) = secondEdges;
        done
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        Graph.IsWalk(graph, waypoint, List.append(rest, secondEdges), target) by IH;
        List.append(List.prepend(E, edge, rest), secondEdges)
            = List.prepend(E, edge, List.append(rest, secondEdges));
        done by Graph.IsWalk.extend
      }
  }

-- A walk can be run backwards. The reversed edge list is not named: no
-- consumer wants it, and building it would want a list reversal the
-- library does not have.
theorem Graph.IsWalk.reverse (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : ∃ (reversed : List(E)). Graph.IsWalk(graph, target, reversed, source) :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(vertex): {
        Graph.IsWalk(graph, vertex, List.empty(E), vertex) by Graph.IsWalk.empty;
        witness List.empty(E)
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        choose reversedRest such that Graph.IsWalk(graph, stepTarget, reversedRest, waypoint)
            from IH;
        Graph.Joins(graph, edge, waypoint, stepSource) by Graph.Joins.symmetric;
        Graph.IsWalk(graph, waypoint, List.prepend(E, edge, List.empty(E)), stepSource)
            by Graph.IsWalk.single;
        Graph.IsWalk(graph, stepTarget,
                     List.append(reversedRest, List.prepend(E, edge, List.empty(E))),
                     stepSource)
            by Graph.IsWalk.append;
        witness List.append(reversedRest, List.prepend(E, edge, List.empty(E)))
      }
  }

-- ----------------------------------------------------------------------
-- What a walk lies in.

theorem Graph.IsWalk.edge_is_edge (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : edgeList ⊆ Graph.edges(graph) :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(vertex): {
        take edge : E;
        suppose edge ∈ List.empty(E);
        done
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, takenEdge, rest, isEdge, joins, restWalk): {
        rest ⊆ Graph.edges(graph) by IH as restEdges;
        take edge : E;
        suppose edge ∈ List.prepend(E, takenEdge, rest);
        edge = takenEdge ∨ edge ∈ rest by List.member_prepend_invert;
        done by cases {
          case edge = takenEdge: done
          case edge ∈ rest: done by restEdges
        }
      }
  }

-- A walk in a subgraph is a walk in the graph. Which graph an edge joins
-- its ends in is not a question — `Graph.Joins` reads the ambient — so
-- only edge membership has to travel.
theorem Graph.IsWalk.in_supergraph (part whole : Graph(V, E, ends))
        (isSubgraph : Graph.IsSubgraph(part, whole))
        (source target : V) (edgeList : List(E))
        (walk : Graph.IsWalk(part, source, edgeList, target))
        : Graph.IsWalk(whole, source, edgeList, target) := {
  Graph.edges(part) ⊆ Graph.edges(whole) as partEdges;
  done by induction on walk with IH {
    case Graph.IsWalkOver.arrived(vertex): done by Graph.IsWalk.empty
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        Graph.IsWalk(whole, waypoint, rest, stepTarget) by IH;
        edge ∈ Graph.edges(whole) by partEdges;
        Graph.Joins(whole, edge, stepSource, waypoint);
        done by Graph.IsWalk.extend
      }
  }
}

-- A walk transfers to any graph that has the edges it takes. Weaker than
-- an inclusion of graphs, and often all that is available: the two graphs
-- may differ elsewhere entirely.
theorem Graph.IsWalk.transfer (graph other : Graph(V, E, ends))
        (source target : V) (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        (edgesSurvive : ∀ (candidate : E). candidate ∈ edgeList
            → candidate ∈ Graph.edges(other))
        : Graph.IsWalk(other, source, edgeList, target) :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(endpoint): done by Graph.IsWalk.empty
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        List.prepend(E, edge, rest) ⊆ Graph.edges(other) as takenEdgesSurvive;
        rest ⊆ List.prepend(E, edge, rest) by List.Includes.prepend;
        rest ⊆ Graph.edges(other) by List.Includes.transitive;
        Graph.IsWalk(other, waypoint, rest, stepTarget) by IH;
        edge ∈ List.prepend(E, edge, rest);
        edge ∈ Graph.edges(other) by takenEdgesSurvive;
        Graph.Joins(other, edge, stepSource, waypoint);
        done by Graph.IsWalk.extend
      }
  }

theorem Graph.IsWalk.target_is_visited (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : target ∈ Graph.walkVertices(graph, source, edgeList) :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(vertex): done
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        stepTarget ∈ Graph.walkVertices(graph, waypoint, rest) by IH;
        done by cases {
          case stepTarget = waypoint: {
              Graph.Joins(graph, edge, stepSource, stepTarget)
                  by substituting (stepTarget = waypoint);
              Graph.Incident(graph, edge, stepTarget)
                  by Graph.Joins.incident_target;
              edge ∈ List.prepend(E, edge, rest);
              stepTarget ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
                  by Graph.coveredVertices.of_edge;
              done
            }
          case stepTarget ∈ Graph.coveredVertices(graph, rest): {
              choose usedEdge such that
                  usedEdge ∈ rest ∧ Graph.Incident(graph, usedEdge, stepTarget);
              usedEdge ∈ List.prepend(E, edge, rest);
              Graph.Incident(graph, usedEdge, stepTarget);
              stepTarget ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
                  by { witness usedEdge };
              done
            }
        }
      }
  }

-- Every vertex a walk visits is a vertex of the graph, as soon as its
-- source is one: the ends of the edges it takes are vertices because the
-- graph is well formed.
theorem Graph.IsWalk.visits_vertices (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        (sourceIsVertex : source ∈ Graph.vertices(graph))
        : ∀ (vertex : V). vertex ∈ Graph.walkVertices(graph, source, edgeList)
            → vertex ∈ Graph.vertices(graph) := {
  edgeList ⊆ Graph.edges(graph) by Graph.IsWalk.edge_is_edge as walkEdges;
  take vertex : V;
  suppose vertex ∈ Graph.walkVertices(graph, source, edgeList);
  done by cases {
    case vertex = source: done
    case vertex ∈ Graph.coveredVertices(graph, edgeList): {
        choose usedEdge such that usedEdge ∈ edgeList ∧ Graph.Incident(graph, usedEdge, vertex);
        usedEdge ∈ edgeList;
        Graph.Incident(graph, usedEdge, vertex);
        usedEdge ∈ Graph.edges(graph) by walkEdges;
        choose farEnd such that Graph.Joins(graph, usedEdge, vertex, farEnd);
        vertex ∈ Graph.vertices(graph) by Graph.IsWellFormed.end_is_vertex;
        done
      }
  }
}

-- A walk that takes no edge has not gone anywhere.
theorem Graph.IsWalk.empty_endpoints (graph : Graph(V, E, ends)) (source target : V)
        (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : edgeList = List.empty(E) → source = target :=
  by induction on walk {
    case Graph.IsWalkOver.arrived(endpoint): {
        suppose List.empty(E) = List.empty(E);
        done
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        suppose List.prepend(E, edge, rest) = List.empty(E);
        done
      }
  }

-- ----------------------------------------------------------------------
-- The vertices a walk visits, in order.
--
-- `Graph.walkVertices` is a `Set(V)` because nothing counts the vertices
-- a walk visits — but BUILDING a graph out of a walk needs them as a
-- list. The recursion runs along the edge list, carrying the vertex it
-- has reached, so the moving parameter sits in the return type.

definition Graph.walkVertexListFrom (graph : Graph(V, E, ends))
        : List(E) → V → List(V)
  | List.empty               => (source : V) ↦ List.prepend(V, source, List.empty(V))
  | List.prepend(edge, rest) =>
      (source : V) ↦ List.prepend(V, source,
          Graph.walkVertexListFrom(graph, rest, Graph.otherEnd(graph, edge, source)))

-- Read in the mathematician's order: from this vertex, along these edges.
definition Graph.walkVertexList (graph : Graph(V, E, ends)) (source : V)
        (edgeList : List(E)) : List(V) :=
  Graph.walkVertexListFrom(graph, edgeList, source)

theorem Graph.walkVertexList.empty (graph : Graph(V, E, ends)) (source : V)
        : Graph.walkVertexList(graph, source, List.empty(E))
          = List.prepend(V, source, List.empty(V)) :=
  done

theorem Graph.walkVertexList.step (graph : Graph(V, E, ends)) (source : V)
        (edge : E) (rest : List(E))
        : Graph.walkVertexList(graph, source, List.prepend(E, edge, rest))
          = List.prepend(V, source,
                Graph.walkVertexList(graph, Graph.otherEnd(graph, edge, source), rest)) :=
  done

-- A walk visits one vertex more than it takes edges.
theorem Graph.walkVertexList.length (graph : Graph(V, E, ends)) (edgeList : List(E))
        : ∀ (source : V).
            length(Graph.walkVertexList(graph, source, edgeList))
            = 1 + length(edgeList) :=
  by induction on edgeList with IH {
    case edgeList = List.empty: {
        take source : V;
        length(Graph.walkVertexList(graph, source, List.empty(E)))
           = length(List.prepend(V, source, List.empty(V)))
           = 1 + length(List.empty(V))
           = 1 + 0
           = 1 + length(List.empty(E))
      }
    case edgeList = List.prepend(edge, rest) for some edge, rest: {
        take source : V;
        length(Graph.walkVertexList(graph, Graph.otherEnd(graph, edge, source), rest))
           = 1 + length(rest) by IH;
        length(Graph.walkVertexList(graph, source, List.prepend(E, edge, rest)))
           = length(List.prepend(V, source,
                 Graph.walkVertexList(graph, Graph.otherEnd(graph, edge, source), rest)))
           = 1 + length(Graph.walkVertexList(graph,
                     Graph.otherEnd(graph, edge, source), rest))
           = 1 + (1 + length(rest))
           = 1 + length(List.prepend(E, edge, rest))
      }
  }

-- The list and the set agree, one direction each. Listed vertices are
-- visited: the source is, and each later one is an end of an edge taken.
theorem Graph.walkVertexList.visits (graph : Graph(V, E, ends)) (edgeList : List(E))
        : ∀ (source vertex : V).
            vertex ∈ Graph.walkVertexList(graph, source, edgeList)
            → vertex ∈ Graph.walkVertices(graph, source, edgeList) :=
  by induction on edgeList with IH {
    case edgeList = List.empty: {
        take source : V;
        take vertex : V;
        suppose vertex ∈ Graph.walkVertexList(graph, source, List.empty(E));
        vertex ∈ List.prepend(V, source, List.empty(V));
        vertex = source ∨ vertex ∈ List.empty(V) by List.member_prepend_invert;
        done by cases {
          case vertex = source: done
          case vertex ∈ List.empty(V): {
              vertex ∉ List.empty(V) by List.no_member_empty;
              done
            }
        }
      }
    case edgeList = List.prepend(edge, rest) for some edge, rest: {
        take source : V;
        take vertex : V;
        suppose vertex ∈ Graph.walkVertexList(graph, source,
                                              List.prepend(E, edge, rest));
        vertex ∈ List.prepend(V, source,
            Graph.walkVertexList(graph, Graph.otherEnd(graph, edge, source), rest));
        vertex = source
            ∨ vertex ∈ Graph.walkVertexList(graph,
                           Graph.otherEnd(graph, edge, source), rest)
            by List.member_prepend_invert;
        done by cases {
          case vertex = source: done
          case vertex ∈ Graph.walkVertexList(graph,
                            Graph.otherEnd(graph, edge, source), rest): {
              vertex ∈ Graph.walkVertices(graph,
                            Graph.otherEnd(graph, edge, source), rest) by IH;
              done by cases {
                case vertex = Graph.otherEnd(graph, edge, source) as isFarEnd: {
                    Graph.Incident(graph, edge, Graph.otherEnd(graph, edge, source))
                        by Graph.otherEnd.incident;
                    Graph.Incident(graph, edge, vertex) by substituting isFarEnd;
                    edge ∈ List.prepend(E, edge, rest);
                    vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
                        by Graph.coveredVertices.of_edge;
                    done
                  }
                case vertex ∈ Graph.coveredVertices(graph, rest): {
                    ∀ (candidate : E). candidate ∈ rest
                        → candidate ∈ List.prepend(E, edge, rest)
                        by { take candidate : E;
                             suppose candidate ∈ rest;
                             done };
                    vertex ∈ Graph.coveredVertices(graph, List.prepend(E, edge, rest))
                        by Graph.coveredVertices.monotone;
                    done
                  }
              }
            }
        }
      }
  }

-- And conversely, for a walk of a graph with no loops: every vertex the
-- walk visits is listed, because each step really does arrive at the
-- other end of the edge it takes.
theorem Graph.walkVertexList.complete (graph : Graph(V, E, ends))
        (wellFormed : Graph.IsWellFormed(graph))
        (source target : V) (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        : ∀ (vertex : V). vertex ∈ Graph.walkVertices(graph, source, edgeList)
            → vertex ∈ Graph.walkVertexList(graph, source, edgeList) :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(endpoint): {
        take vertex : V;
        suppose vertex ∈ Graph.walkVertices(graph, endpoint, List.empty(E));
        done by cases {
          case vertex = endpoint as isEndpoint: {
              vertex ∈ List.prepend(V, endpoint, List.empty(V))
                  by substituting isEndpoint;
              done
            }
          case vertex ∈ Graph.coveredVertices(graph, List.empty(E)): {
              vertex ∉ Graph.coveredVertices(graph, List.empty(E))
                  by Graph.coveredVertices.no_edges;
              done
            }
        }
      }
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        take vertex : V;
        suppose vertex ∈ Graph.walkVertices(graph, stepSource,
                                            List.prepend(E, edge, rest));
        stepSource ≠ waypoint by Graph.IsWellFormed.no_loop;
        Graph.otherEnd(graph, edge, stepSource) = waypoint
            by Graph.otherEnd.of_joins as arrivesAtWaypoint;
        vertex = stepSource ∨ vertex ∈ Graph.walkVertices(graph, waypoint, rest)
            by Graph.walkVertices.after_step;
        done by cases {
          case vertex = stepSource as isSource: {
              vertex ∈ List.prepend(V, stepSource,
                  Graph.walkVertexList(graph,
                      Graph.otherEnd(graph, edge, stepSource), rest))
                  by substituting isSource;
              done
            }
          case vertex ∈ Graph.walkVertices(graph, waypoint, rest): {
              vertex ∈ Graph.walkVertexList(graph, waypoint, rest) by IH;
              vertex ∈ Graph.walkVertexList(graph,
                  Graph.otherEnd(graph, edge, stepSource), rest)
                  by substituting arrivesAtWaypoint;
              vertex ∈ List.prepend(V, stepSource,
                  Graph.walkVertexList(graph,
                      Graph.otherEnd(graph, edge, stepSource), rest));
              done
            }
        }
      }
  }

-- A walk that starts inside a region and ends outside it crosses the
-- boundary: one of its edges joins an inside vertex to an outside one.
-- The region is a LIST because that is how a set of vertices arrives —
-- `Graph.vertices(part)` — and a `Set(V)` version would make every call
-- site wrap it in a lambda. (Both spell; this is a readability choice.)
theorem Graph.IsWalk.crossing (graph : Graph(V, E, ends)) (region : List(V))
        (source target : V) (edgeList : List(E))
        (walk : Graph.IsWalk(graph, source, edgeList, target))
        (sourceInside : source ∈ region)
        (targetOutside : target ∉ region)
        : ∃ (edge : E). ∃ (u w : V). edge ∈ edgeList
            ∧ Graph.Joins(graph, edge, u, w) ∧ u ∈ region ∧ w ∉ region :=
  by induction on walk with IH {
    case Graph.IsWalkOver.arrived(endpoint): done
    case Graph.IsWalkOver.step(
        stepSource, waypoint, stepTarget, edge, rest, isEdge, joins, restWalk): {
        done by cases {
          case waypoint ∈ region: {
              ∃ (crosser : E). ∃ (u w : V). crosser ∈ rest
                  ∧ Graph.Joins(graph, crosser, u, w) ∧ u ∈ region ∧ w ∉ region
                  by IH;
              choose crosser, insideEnd, outsideEnd such that
                  crosser ∈ rest ∧ Graph.Joins(graph, crosser, insideEnd, outsideEnd)
                  ∧ insideEnd ∈ region ∧ outsideEnd ∉ region;
              crosser ∈ rest;
              Graph.Joins(graph, crosser, insideEnd, outsideEnd);
              insideEnd ∈ region;
              outsideEnd ∉ region;
              crosser ∈ List.prepend(E, edge, rest);
              witness crosser with witness insideEnd with witness outsideEnd
            }
          otherwise: {
              edge ∈ List.prepend(E, edge, rest);
              witness edge with witness stepSource with witness waypoint
            }
        }
      }
  }
