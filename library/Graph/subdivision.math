-- Graph/subdivision.math
--
-- Replacing an edge by a path. Layer 5 of PLAN_JORDAN_SCHOENFLIES.md, the
-- first half of the blueprint's `lem:subdivision-ear-preserve`.
--
-- Subdividing an edge once is the case where the replacement path has two
-- edges and one new vertex; nothing in the argument cares how long the
-- path is, so it is stated for a path.
--
-- Deleting a vertex from the result leaves the graph side connected, and
-- the walks that used the old edge are rerouted — either along the
-- replacement path (when the deleted vertex is not on it) or along the
-- rest of the old graph (when it is), and neither is needed at all when
-- the deleted vertex is an end of the old edge, since a walk avoiding
-- that vertex could not have taken the edge anyway. That three-way choice
-- is `Graph.Reaches.across_edge_replacement`'s `routed` premise.

module Graph.subdivision

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import Natural.basics
import Natural.order
import Lists.list
import Lists.length
import Graph.basics
import Graph.walk
import Graph.path
import Graph.connected
import Graph.deletion
import Graph.cycle
import Graph.vertex_deletion
import Graph.twoconnected
import Graph.union
import Graph.reroute
import Graph.reverse
import Graph.pathgraph

convention V : Type(0)
convention E : Type(0)
convention ends : E → Pair(V, V)

theorem Graph.IsTwoConnected.replace_edge_by_path
        (graph pathGraph : Graph(V, E, ends))
        (graphWellFormed : Graph.IsWellFormed(graph))
        (pathWellFormed : Graph.IsWellFormed(pathGraph))
        (twoConnected : Graph.IsTwoConnected(graph))
        (edge : E) (u v : V)
        (isEdge : edge ∈ Graph.edges(graph))
        (joins : Graph.Joins(graph, edge, u, v))
        (isPath : Graph.IsPathGraph(pathGraph, u, v))
        (interiorIsNew : ∀ (candidate : V). candidate ∈ Graph.vertices(pathGraph)
            → candidate ≠ u → candidate ≠ v
            → ¬(candidate ∈ Graph.vertices(graph)))
        : Graph.IsTwoConnected(
              Graph.union(Graph.deleteEdge(graph, edge), pathGraph)) := {
  -- The graph with the edge replaced by the path: `trimmed` is the graph
  -- without the edge, `subdivided` is what the theorem is about.
  let trimmed : Graph(V, E, ends) := Graph.deleteEdge(graph, edge);
  let subdivided : Graph(V, E, ends) := Graph.union(trimmed, pathGraph);
  u ∈ Graph.vertices(graph) by Graph.IsWellFormed.end_is_vertex;
  v ∈ Graph.vertices(graph) by Graph.IsWellFormed.other_end_is_vertex;
  u ≠ v by Graph.IsWellFormed.no_loop;
  u ∈ Graph.vertices(pathGraph) by Graph.IsPathGraph.source_is_vertex;
  v ∈ Graph.vertices(pathGraph) by Graph.IsPathGraph.target_is_vertex;
  Graph.IsConnected(graph) by Graph.IsTwoConnected.connected;
  Graph.IsConnected(pathGraph) by Graph.IsPathGraph.IsConnected;
  Graph.IsWellFormed(trimmed) by Graph.deleteEdge.IsWellFormed;
  Graph.IsWellFormed(subdivided)
      by Graph.union.IsWellFormed;
  Graph.IsSubgraph(trimmed,
                   subdivided)
      by Graph.union.IsSubgraph_left;
  Graph.IsSubgraph(pathGraph, subdivided)
      by Graph.union.IsSubgraph_right;

  -- An old edge other than the replaced one is still there.
  ∀ (candidate : E). candidate ∈ Graph.edges(graph) → candidate ≠ edge
      → candidate ∈ Graph.edges(subdivided)
      by { take candidate : E;
           suppose candidate ∈ Graph.edges(graph);
           suppose candidate ≠ edge;
           candidate ∈ Graph.edges(trimmed)
               by Graph.deleteEdge.keeps;
           done by Graph.union.edge_left }
      as oldEdgesSurvive;

  -- An edge of the old graph meets only old vertices.
  ∀ (candidate : E). ∀ (outsider : V). candidate ∈ Graph.edges(graph)
      → ¬(outsider ∈ Graph.vertices(graph)) → ¬Graph.Incident(graph, candidate, outsider)
      by { take candidate : E;
           take outsider : V;
           suppose candidate ∈ Graph.edges(graph);
           suppose ¬(outsider ∈ Graph.vertices(graph));
           suppose Graph.Incident(graph, candidate, outsider);
           choose otherEnd such that Graph.Joins(graph, candidate, outsider, otherEnd);
           outsider ∈ Graph.vertices(graph) by Graph.IsWellFormed.end_is_vertex;
           done }
      as oldEdgesMeetOldVertices;

  -- The replacement route, and the old graph's own route around the edge.
  Graph.IsWalk(pathGraph, u, Graph.edges(pathGraph), v)
      by { Graph.IsPath(pathGraph, u, Graph.edges(pathGraph), v)
               by Graph.IsPathGraph.path;
           done by Graph.IsPath.walk };
  Graph.Reaches(pathGraph, u, v) by { witness Graph.edges(pathGraph) };
  Graph.Reaches(subdivided, u, v)
      by Graph.Reaches.in_supergraph(part := pathGraph);
  Graph.Reaches(trimmed, u, v)
      by Graph.IsTwoConnected.no_bridge;

  -- Connectedness of the whole, through `u`.
  ∀ (target : V).
      target ∈ Graph.vertices(subdivided)
      → Graph.Reaches(subdivided, u, target)
      by { take target : V;
           suppose target ∈ Graph.vertices(
               subdivided);
           target ∈ Graph.vertices(trimmed)
               ∨ target ∈ Graph.vertices(pathGraph)
               by Graph.union.vertex_invert;
           done by cases {
             case target ∈ Graph.vertices(trimmed): {
                 target ∈ Graph.vertices(graph);
                 Graph.Reaches(graph, u, target) by Graph.IsConnected.reaches;
                 done by Graph.Reaches.reroute(bigger := subdivided)
               }
             case target ∈ Graph.vertices(pathGraph): {
                 Graph.Reaches(pathGraph, u, target) by Graph.IsConnected.reaches;
                 done by Graph.Reaches.in_supergraph(part := pathGraph)
               }
           } };
  u ∈ Graph.vertices(subdivided)
      by Graph.union.vertex_left;
  Graph.IsConnected(subdivided)
      by Graph.IsConnected.from_hub(hub := u);

  3 ≤ Graph.order(graph);
  Graph.order(trimmed)
      ≤ Graph.order(subdivided)
      by Graph.union.order_left;
  3 ≤ Graph.order(subdivided);

  ∀ (deleted : V).
      deleted ∈ Graph.vertices(subdivided)
      → Graph.IsConnected(Graph.deleteVertex(
            subdivided, deleted))
      by { take deleted : V;
           suppose deleted ∈ Graph.vertices(subdivided);
           let pruned : Graph(V, E, ends) := Graph.deleteVertex(subdivided, deleted);

           -- One end of the replaced edge survives; it is the hub.
           ∃ (hub : V). (hub = u ∨ hub = v) ∧ hub ≠ deleted
               by cases {
                 case u = deleted: {
                     v ≠ deleted by substituting (u = deleted);
                     v = u ∨ v = v;
                     witness v
                   }
                 otherwise: { u ≠ deleted; u = u ∨ u = v; witness u }
               };
           choose hub such that (hub = u ∨ hub = v) ∧ hub ≠ deleted;
           hub = u ∨ hub = v;
           hub ≠ deleted;
           hub ∈ Graph.vertices(graph)
               by cases {
                 case hub = u: { u ∈ Graph.vertices(graph); done by substituting (hub = u) }
                 case hub = v: { v ∈ Graph.vertices(graph); done by substituting (hub = v) }
               };

           Graph.IsConnected(Graph.deleteVertex(graph, deleted))
               by cases {
                 case deleted ∈ Graph.vertices(graph):
                     done by Graph.IsTwoConnected.survives_deletion
                 otherwise: {
                     ¬(deleted ∈ Graph.vertices(graph));
                     done by Graph.IsConnected.after_outside_deletion                   }
               };
           Graph.IsSubgraph(Graph.deleteVertex(pathGraph, deleted),
                            Graph.deleteVertex(
                                subdivided,
                                deleted))
               by Graph.deleteVertex.monotone(part := pathGraph);

           -- The surviving old edges are edges of the deleted union.
           ∀ (candidate : E).
               candidate ∈ Graph.edges(Graph.deleteVertex(graph, deleted))
               → candidate ≠ edge
               → candidate ∈ Graph.edges(Graph.deleteVertex(
                     subdivided, deleted))
               by { take candidate : E;
                    suppose candidate ∈ Graph.edges(Graph.deleteVertex(graph, deleted));
                    suppose candidate ≠ edge;
                    candidate ∈ Graph.edges(graph) by Graph.deleteVertex.is_edge;
                    ¬Graph.Incident(graph, candidate, deleted)
                        by Graph.deleteVertex.edge_avoids;
                    candidate ∈ Graph.edges(
                        subdivided)
                        by oldEdgesSurvive;
                    ¬Graph.Incident(
                        subdivided,
                        candidate, deleted);
                    done by Graph.deleteVertex.keeps_edge };

           -- The replaced edge's ends are still joined, unless the deleted
           -- vertex is one of them.
           Graph.Reaches(Graph.deleteVertex(
                   subdivided, deleted), u, v)
               ∨ Graph.Incident(graph, edge, deleted)
               by cases {
                 case deleted = u: {
                     Graph.Incident(graph, edge, u) by Graph.Joins.incident_source;
                     Graph.Incident(graph, edge, deleted)
                         by substituting (deleted = u);
                     done
                   }
                 case deleted = v: {
                     Graph.Incident(graph, edge, v) by Graph.Joins.incident_target;
                     Graph.Incident(graph, edge, deleted)
                         by substituting (deleted = v);
                     done
                   }
                 otherwise: {
                     deleted ≠ u
                         by { suppose deleted = u;
                              deleted = u ∨ deleted = v;
                              done };
                     deleted ≠ v
                         by { suppose deleted = v;
                              deleted = u ∨ deleted = v;
                              done };
                     done by cases {
                       case deleted ∈ Graph.vertices(graph): {
                           -- The path is untouched, and it joins the ends.
                           ¬(deleted ∈ Graph.vertices(pathGraph))
                               by { suppose deleted ∈ Graph.vertices(pathGraph);
                                    ¬(deleted ∈ Graph.vertices(graph)) by interiorIsNew;
                                    done };
                           Graph.IsConnected(Graph.deleteVertex(pathGraph, deleted))
                               by Graph.IsConnected.after_outside_deletion(
                                     graph := pathGraph);
                           u ≠ deleted
                               by { suppose u = deleted;
                                    deleted = u by substituting (u = deleted);
                                    done };
                           v ≠ deleted
                               by { suppose v = deleted;
                                    deleted = v by substituting (v = deleted);
                                    done };
                           u ∈ Graph.vertices(Graph.deleteVertex(pathGraph, deleted))
                               by Graph.deleteVertex.keeps_vertex(graph := pathGraph);
                           v ∈ Graph.vertices(Graph.deleteVertex(pathGraph, deleted))
                               by Graph.deleteVertex.keeps_vertex(graph := pathGraph);
                           Graph.Reaches(Graph.deleteVertex(pathGraph, deleted), u, v)
                               by Graph.IsConnected.reaches;
                           Graph.Reaches(Graph.deleteVertex(
                                   subdivided,
                                   deleted), u, v)
                               by Graph.Reaches.in_supergraph(
                                     part := Graph.deleteVertex(pathGraph, deleted));
                           done
                         }
                       otherwise: {
                           -- The deleted vertex is not in the old graph, so the
                           -- old graph's own route around the edge survives.
                           ¬(deleted ∈ Graph.vertices(graph));
                           choose aroundEdge such that Graph.IsWalk(trimmed, u, aroundEdge, v);
                           aroundEdge ⊆ Graph.edges(pruned)
                               by { take candidate : E;
                                    suppose candidate ∈ aroundEdge;
                                    candidate ∈ Graph.edges(trimmed) by Graph.IsWalk.edge_is_edge;
                                    candidate ∈ Graph.edges(graph) by Graph.deleteEdge.is_edge;
                                    ¬Graph.Incident(graph, candidate, deleted) by oldEdgesMeetOldVertices;
                                    candidate ∈ Graph.edges(subdivided) by Graph.union.edge_left;
                                    ¬Graph.Incident(subdivided, candidate, deleted);
                                    done by Graph.deleteVertex.keeps_edge };
                           Graph.IsWalk(Graph.deleteVertex(
                                   subdivided,
                                   deleted), u, aroundEdge, v)
                               by Graph.IsWalk.transfer;
                           Graph.Reaches(Graph.deleteVertex(
                                   subdivided,
                                   deleted), u, v)
                               by { witness aroundEdge };
                           done
                         }
                     }
                   }
               };

           -- Every surviving old vertex reaches the hub.
           ∀ (endpoint : V). endpoint ∈ Graph.vertices(graph) → endpoint ≠ deleted
               → Graph.Reaches(Graph.deleteVertex(
                     subdivided, deleted),
                     endpoint, hub)
               by { take endpoint : V;
                    suppose endpoint ∈ Graph.vertices(graph);
                    suppose endpoint ≠ deleted;
                    endpoint ∈ Graph.vertices(Graph.deleteVertex(graph, deleted))
                        by Graph.deleteVertex.keeps_vertex(graph := graph);
                    hub ∈ Graph.vertices(Graph.deleteVertex(graph, deleted))
                        by Graph.deleteVertex.keeps_vertex(graph := graph);
                    Graph.Reaches(Graph.deleteVertex(graph, deleted), endpoint, hub)
                        by Graph.IsConnected.reaches;
                    done by Graph.Reaches.across_edge_replacement(
                                graph := graph, edge := edge, u := u, v := v,
                                bigger := Graph.deleteVertex(
                                    subdivided,
                                    deleted)) }
               as oldSideReachesHub;

           hub ∈ Graph.vertices(subdivided)
               by { hub ∈ Graph.vertices(trimmed);
                    done by Graph.union.vertex_left };
           hub ∈ Graph.vertices(Graph.deleteVertex(
                   subdivided, deleted))
               by Graph.deleteVertex.keeps_vertex;

           ∀ (target : V).
               target ∈ Graph.vertices(Graph.deleteVertex(
                   subdivided, deleted))
               → Graph.Reaches(Graph.deleteVertex(
                     subdivided, deleted),
                     hub, target)
               by { take target : V;
                    suppose target ∈ Graph.vertices(Graph.deleteVertex(
                        subdivided, deleted));
                    target ≠ deleted by Graph.deleteVertex.drops;
                    target ∈ Graph.vertices(
                        subdivided)
                        by Graph.deleteVertex.is_vertex;
                    target ∈ Graph.vertices(trimmed)
                        ∨ target ∈ Graph.vertices(pathGraph)
                        by Graph.union.vertex_invert;
                    Graph.Reaches(Graph.deleteVertex(
                            subdivided,
                            deleted), target, hub)
                        by cases {
                          case target ∈ Graph.vertices(trimmed): {
                              target ∈ Graph.vertices(graph);
                              done by oldSideReachesHub
                            }
                          case target ∈ Graph.vertices(pathGraph): {
                              Graph.Reaches(Graph.deleteVertex(pathGraph, deleted),
                                            target, u)
                                  ∨ Graph.Reaches(Graph.deleteVertex(pathGraph, deleted),
                                                  target, v)
                                  by Graph.IsPathGraph.reaches_an_end(cut := deleted);
                              done by cases {
                                case Graph.Reaches(Graph.deleteVertex(pathGraph, deleted),
                                         target, u): {
                                    u ≠ deleted
                                        by { suppose u = deleted;
                                             Graph.Reaches(
                                                 Graph.deleteVertex(pathGraph, deleted),
                                                 target, deleted)
                                                 by substituting (u = deleted);
                                             ¬Graph.Reaches(
                                                 Graph.deleteVertex(pathGraph, deleted),
                                                 target, deleted)
                                                 by Graph.Reaches.not_to_deleted;
                                             done };
                                    Graph.Reaches(pruned, target, u)
                                        by Graph.Reaches.in_supergraph(
                                               part := Graph.deleteVertex(pathGraph, deleted));
                                    Graph.Reaches(pruned, u, hub)
                                        by oldSideReachesHub;
                                    done by Graph.Reaches.transitive(middle := u)
                                  }
                                case Graph.Reaches(Graph.deleteVertex(pathGraph, deleted),
                                         target, v): {
                                    v ≠ deleted
                                        by { suppose v = deleted;
                                             Graph.Reaches(
                                                 Graph.deleteVertex(pathGraph, deleted),
                                                 target, deleted)
                                                 by substituting (v = deleted);
                                             ¬Graph.Reaches(
                                                 Graph.deleteVertex(pathGraph, deleted),
                                                 target, deleted)
                                                 by Graph.Reaches.not_to_deleted;
                                             done };
                                    Graph.Reaches(pruned, target, v)
                                        by Graph.Reaches.in_supergraph(
                                               part := Graph.deleteVertex(pathGraph, deleted));
                                    Graph.Reaches(pruned, v, hub)
                                        by oldSideReachesHub;
                                    done by Graph.Reaches.transitive(middle := v)
                                  }
                              }
                            }
                        };
                    done by Graph.Reaches.symmetric };
           done by Graph.IsConnected.from_hub };
  done
}
