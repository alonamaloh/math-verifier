-- Real/maximum.math
--
-- The maximum of two reals in closed form: max(a, b) = (a + b + |a − b|) / 2.
-- The mirror of Real.minimum, and for the same reason: ℝ has no decidable
-- order, so the definite description is unavailable and the absolute value
-- of the gap does the selecting. When a ≥ b the |·| is a − b and the formula
-- collapses to a; otherwise to b.
--
-- Unlike minimum, the least-upper-bound direction is stated here
-- (`Real.maximum_LessOrEqual`): the sup metric on the plane needs to bound
-- max(|x|, |y|) from above, which is exactly that direction.

module Real.maximum

import Logic.basics
import Equality.basics
import Real.basics
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value_order
import Real.order_multiplication

-- max(a, b): the larger of the two, read off the absolute value of the gap.
definition Real.maximum (a b : ℝ) : ℝ :=
  (a + b + abs(a - b)) / 2

overload max := Real.maximum

-- a ≤ max(a, b): equivalently a − b ≤ |a − b|.
automatic theorem Real.left_LessOrEqual_maximum (a b : ℝ) : a ≤ max(a, b) := {
  (2 : ℝ) > 0;
  a - b ≤ abs(a - b);
  (2 : ℝ) * a
     = a + b + (a - b)
     ≤ a + b + abs(a - b)
     = 2 * max(a, b);
  done by Real.LessOrEqual.multiply_cancel_left_positive
}

-- b ≤ max(a, b): symmetric — b − a ≤ |a − b|.
automatic theorem Real.right_LessOrEqual_maximum (a b : ℝ) : b ≤ max(a, b) := {
  (2 : ℝ) > 0;
  b - a
     = -(a - b)
     ≤ abs(a - b);
  (2 : ℝ) * b
     = a + b + (b - a)
     ≤ a + b + abs(a - b)
     = 2 * max(a, b);
  done by Real.LessOrEqual.multiply_cancel_left_positive
}

-- The least upper bound: anything above both is above the maximum. This is
-- the direction that makes max usable as a bound rather than merely a value.
automatic theorem Real.maximum_LessOrEqual (a b c : ℝ)
        (aBelow : a ≤ c) (bBelow : b ≤ c)
        : max(a, b) ≤ c := {
  (2 : ℝ) > 0;
  a - b ≤ (c - a) + (c - b) by ordered_field;
  -((c - a) + (c - b)) ≤ a - b by ordered_field;
  abs(a - b) ≤ (c - a) + (c - b)
      by Real.absolute_value_LessOrEqual_of_bounds;
  (2 : ℝ) * max(a, b)
     = a + b + abs(a - b)
     ≤ a + b + ((c - a) + (c - b))
     = 2 * c;
  done by Real.LessOrEqual.multiply_cancel_left_positive
}

-- max(a, a) = a: the gap is zero, so the formula collapses.
theorem Real.maximum_self (a : ℝ) : max(a, a) = a := {
  a - a = 0 as gapVanishes;
  (0 : ℝ) ≤ 0;
  abs((0 : ℝ)) = 0 by Real.absolute_value_when_nonneg;
  abs(a - a) = 0 by substituting gapVanishes;
  max(a, a)
     = (a + a + abs(a - a)) / 2
     = (a + a + 0) / 2
     = a by field;
  done
}

-- Scaling by a nonnegative factor passes through the maximum. The closed
-- form makes it one field identity, since the factor comes out of the
-- absolute value of the gap.
theorem Real.maximum_scale (factor a b : ℝ) (factorNonneg : factor ≥ 0)
        : max(factor * a, factor * b) = factor * max(a, b) := {
  abs(factor) = factor by Real.absolute_value_when_nonneg as absoluteFactor;
  abs(factor * a - factor * b)
     = abs(factor * (a - b))
     = abs(factor) * abs(a - b) by Real.absolute_value_multiplicative
     = factor * abs(a - b) by absoluteFactor as scaledGap;
  max(factor * a, factor * b)
     = (factor * a + factor * b + abs(factor * a - factor * b)) / 2
     = (factor * a + factor * b + factor * abs(a - b)) / 2 by scaledGap
     = factor * ((a + b + abs(a - b)) / 2) by field
     = factor * max(a, b);
  done
}

-- The maximum of two nonnegatives is nonnegative — immediate from the left
-- bound, but stated because the sup metric leans on it constantly.
automatic theorem Real.maximum_nonneg (a b : ℝ) (aNonneg : 0 ≤ a)
        : 0 ≤ max(a, b) :=
  0 ≤ a by aNonneg
    ≤ max(a, b) by Real.left_LessOrEqual_maximum


-- The strict companion. Both bounds strict makes the gap strictly smaller
-- than the two slacks combined, which is where the strictness comes from.
automatic theorem Real.maximum_LessThan (a b c : ℝ)
        (aBelow : a < c) (bBelow : b < c)
        : max(a, b) < c := {
  (2 : ℝ) > 0;
  a - b < (c - a) + (c - b) by ordered_field;
  -((c - a) + (c - b)) < a - b by ordered_field;
  abs(a - b) < (c - a) + (c - b)
      by Real.absolute_value_LessThan_of_bounds;
  (2 : ℝ) * max(a, b)
     = a + b + abs(a - b)
     < a + b + ((c - a) + (c - b))
     = 2 * c;
  done by Real.LessThan.multiply_cancel_left_positive
}
