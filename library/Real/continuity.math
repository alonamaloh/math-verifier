-- Real/continuity.math
--
-- ε–δ continuity of functions on the reals, in the familiar form: ε and δ
-- are real numbers. (Real division, Real.minimum and the Real ε/2 split
-- carry the tolerance arithmetic that the rational version used to.)
--
-- This file: the definition, continuity on a closed interval, and the
-- algebra of continuous functions (constants, identity, negation; sums,
-- composition and products).

module Real.continuity

import Logic.basics
import Logic.exists
import Logic.quotient
import Equality.basics
import Set.basics
import Set.algebra
import Real.basics
import Real.addition
import Real.negation
import Real.ring
import Real.algebra
import Real.order
import Real.linearity
import Real.absolute_value
import Real.absolute_value_order
import Real.multiplication
import Real.instances
import Real.order_multiplication
import Real.apartness
import Real.reciprocal
import Real.field
import Real.order_field
import Real.division
import Real.minimum
import Metric.space
import Metric.continuity
import Metric.real

-- ----------------------------------------------------------------------
-- f is continuous at x: for every positive tolerance ε there is a positive
-- δ such that f moves points δ-close to x to points ε-close to f(x).
--
-- Not a second notion: this IS the generic metric-space continuity of
-- `Metric/continuity.math`, read on the line, where the distance is
-- `abs` of the difference. There is no carrier to restrict to, so the
-- carrier is the whole line.
definition Real.ContinuousAt (f : ℝ → ℝ) (x : ℝ) : Proposition :=
  MetricSpace.ContinuousAt(f, Set.universe(ℝ), x)

-- f is continuous on the closed interval [a, b]: continuous at every
-- point of the interval.
definition Real.ContinuousOn
        (f : ℝ → ℝ) (a b : ℝ) : Proposition :=
  ∀ (x : ℝ). a ≤ x → x ≤ b → Real.ContinuousAt(f, x)

-- ----------------------------------------------------------------------
-- The ε–δ characterisation — the boundary between the generic notion and
-- the arithmetic a real-analysis text writes. On the line the distance IS
-- `abs` of the difference and the carrier imposes nothing, so the two
-- statements say the same thing; only the order of the subtraction and
-- the vacuous membership stand between them. Every proof below states ε
-- and δ and crosses here once; nothing on the line speaks `distance`.

theorem Real.ContinuousAt.of_epsilon_delta {f : ℝ → ℝ} {x : ℝ}
        (nearby : ∀ (ε : ℝ). ε > 0 →
            ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(f(y) - f(x)) < ε)
        : Real.ContinuousAt(f, x) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that
      nearness > 0
        ∧ ∀ (y : ℝ). abs(y - x) < nearness → abs(f(y) - f(x)) < tolerance
      as closeNearby from nearby;
  nearness > 0;
  ∀ (y : ℝ). y ∈ Set.universe(ℝ) → abs(y - x) < nearness → abs(f(y) - f(x)) < tolerance
      by { take y : ℝ;
           suppose y ∈ Set.universe(ℝ);
           suppose abs(y - x) < nearness;
           done by closeNearby };
  witness nearness
}

-- The elimination side takes the tolerance directly, so a proof that
-- needs a δ writes `choose δ such that … from Real.ContinuousAt.tolerance`
-- and both premises — the continuity and `ε > 0` — come from context.
theorem Real.ContinuousAt.tolerance (f : ℝ → ℝ) (x : ℝ)
        (continuous : Real.ContinuousAt(f, x))
        (ε : ℝ) (εPositive : ε > 0)
        : ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(f(y) - f(x)) < ε := {
  choose nearness such that
      nearness > 0 ∧ ∀ (y : ℝ). y ∈ Set.universe(ℝ) →
        abs(y - x) < nearness → abs(f(y) - f(x)) < ε
      as closeNearby from continuous;
  nearness > 0;
  ∀ (y : ℝ). abs(y - x) < nearness → abs(f(y) - f(x)) < ε
      by { take y : ℝ;
           suppose abs(y - x) < nearness;
           y ∈ Set.universe(ℝ);
           done by closeNearby };
  witness nearness
}

-- ----------------------------------------------------------------------
-- Constant functions are continuous: any δ works (ε itself is at hand),
-- since the image never moves at all.
theorem Real.ContinuousAt.constant (c x : ℝ)
        : Real.ContinuousAt((y : ℝ) ↦ c, x) := {
  suffices ∀ (ε : ℝ). ε > 0 →
      ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(c - c) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  witness ε with {
      ∀ (y : ℝ). abs(y - x) < ε → abs(c - c) < ε
          by (y : ℝ) (_ : abs(y - x) < ε) ↦
            abs(c - c)
               = abs(Real.zero)        by (c - c = 0)
               = 0
               < ε;
      done
    }
}

-- The identity is continuous: δ = ε verbatim.
theorem Real.ContinuousAt.identity (x : ℝ)
        : Real.ContinuousAt((y : ℝ) ↦ y, x) := {
  suffices ∀ (ε : ℝ). ε > 0 →
      ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(y - x) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  witness ε with {
    ∀ (y : ℝ). abs(y - x) < ε → abs(y - x) < ε
        by (y : ℝ) (yClose : abs(y - x) < ε) ↦ yClose;
    done
  }
}

-- Sums of continuous functions are continuous: the usual ε/2 argument,
-- with δ = min(δf, δg) so both summands' bounds apply at once.
theorem Real.ContinuousAt.add (f g : ℝ → ℝ) (x : ℝ)
        (fContinuous : Real.ContinuousAt(f, x))
        (gContinuous : Real.ContinuousAt(g, x))
        : Real.ContinuousAt((y : ℝ) ↦ f(y) + g(y), x) := {
  suffices ∀ (ε : ℝ). ε > 0 → ∃ (δ : ℝ). δ > 0 ∧
      ∀ (y : ℝ). abs(y - x) < δ → abs((f(y) + g(y)) - (f(x) + g(x))) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  {
    ε / 2 > 0;
    choose fδ such that fδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < fδ → abs(f(y) - f(x)) < ε / 2
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < fδ
            → abs(f(y) - f(x)) < ε / 2 as fClose;
    choose gδ such that gδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < gδ → abs(g(y) - g(x)) < ε / 2
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < gδ
            → abs(g(y) - g(x)) < ε / 2 as gClose;
    witness min(fδ, gδ) with {
      ∀ (y : ℝ). abs(y - x) < min(fδ, gδ)
              → abs((f(y) + g(y)) - (f(x) + g(x))) < ε
          by (y : ℝ)
             (yClose : abs(y - x) < min(fδ, gδ)) ↦ {
               min(fδ, gδ) ≤ fδ;
               min(fδ, gδ) ≤ gδ;
               abs(y - x) < min(fδ, gδ) ≤ fδ as yCloseF;
               abs(y - x) < min(fδ, gδ) ≤ gδ as yCloseG;
               abs(f(y) - f(x)) < ε / 2 by fClose(y, yCloseF);
               abs(g(y) - g(x)) < ε / 2 by gClose(y, yCloseG);
               abs((f(y) + g(y)) - (f(x) + g(x)))
                  = abs((f(y) - f(x)) + (g(y) - g(x)))
                        by substituting
                            (ring : (f(y) + g(y)) - (f(x) + g(x))
                                = (f(y) - f(x)) + (g(y) - g(x)))
                  ≤ abs(f(y) - f(x)) + abs(g(y) - g(x))
                  < ε / 2 + ε / 2
                  = ε
          };
      done
    }
  }
}

-- Negation preserves continuity: |−f(y) − (−f(x))| = |f(y) − f(x)|,
-- so f's own δ serves unchanged.
theorem Real.ContinuousAt.negate (f : ℝ → ℝ) (x : ℝ)
        (fContinuous : Real.ContinuousAt(f, x))
        : Real.ContinuousAt((y : ℝ) ↦ -f(y), x) := {
  suffices ∀ (ε : ℝ). ε > 0 →
      ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(-f(y) - -f(x)) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  {
    choose δ such that δ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(f(y) - f(x)) < ε
        from Real.ContinuousAt.tolerance;
    witness δ with {
      ∀ (y : ℝ). abs(y - x) < δ → abs(-f(y) - -f(x)) < ε
          by (y : ℝ) (yClose : abs(y - x) < δ) ↦
            abs(-f(y) - -f(x))
               = abs(-(f(y) - f(x)))
                     by substituting (ring : -f(y) - -f(x) = -(f(y) - f(x)))
               = abs(f(y) - f(x))
               < ε;
      done
    }
  }
}

-- Composition: g's δ for the tolerance f demands at g(x). No minimum
-- needed — the tolerances chain instead of combining.
theorem Real.ContinuousAt.composition (f g : ℝ → ℝ) (x : ℝ)
        (gContinuous : Real.ContinuousAt(g, x))
        (fContinuous : Real.ContinuousAt(f, g(x)))
        : Real.ContinuousAt((y : ℝ) ↦ f(g(y)), x) := {
  suffices ∀ (ε : ℝ). ε > 0 →
      ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(f(g(y)) - f(g(x))) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  {
    choose fδ such that fδ > 0
            ∧ ∀ (z : ℝ). abs(z - g(x)) < fδ → abs(f(z) - f(g(x))) < ε
        from Real.ContinuousAt.tolerance;
    fδ > 0;
    ∀ (z : ℝ). abs(z - g(x)) < fδ
            → abs(f(z) - f(g(x))) < ε as fClose;
    choose gδ such that gδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < gδ → abs(g(y) - g(x)) < fδ
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < gδ
            → abs(g(y) - g(x)) < fδ as gClose;
    witness gδ with {
      ∀ (y : ℝ). abs(y - x) < gδ
              → abs(f(g(y)) - f(g(x))) < ε
          by (y : ℝ) (yClose : abs(y - x) < gδ) ↦
            fClose(g(y), gClose(y, yClose));
      done
    }
  }
}

-- Differences: f − g = f + (−g), and subtraction on Real is
-- definitionally addition of the negation.
theorem Real.ContinuousAt.subtract (f g : ℝ → ℝ) (x : ℝ)
        (fContinuous : Real.ContinuousAt(f, x))
        (gContinuous : Real.ContinuousAt(g, x))
        : Real.ContinuousAt((y : ℝ) ↦ f(y) - g(y), x) := {
  Real.ContinuousAt((y : ℝ) ↦ -g(y), x)
      by Real.ContinuousAt.negate as negateGContinuous;
  done by Real.ContinuousAt.add(f, (y : ℝ) ↦ -g(y), x, fContinuous, negateGContinuous)
}

-- Products of continuous functions are continuous. The error splits as
--   |f(y)g(y) − f(x)g(x)| ≤ |f(y)|·|g(y) − g(x)| + |g(x)|·|f(y) − f(x)|,
-- |f(y)| stays under the roof |f(x)| + 2 near x (its distance to f(x) is
-- eventually below 1), |g(x)| sits under |g(x)| + 2, and each factor gets
-- the tolerance ε/2 scaled down by the opposite roof.
theorem Real.ContinuousAt.multiply (f g : ℝ → ℝ) (x : ℝ)
        (fContinuous : Real.ContinuousAt(f, x))
        (gContinuous : Real.ContinuousAt(g, x))
        : Real.ContinuousAt((y : ℝ) ↦ f(y) * g(y), x) := {
  suffices ∀ (ε : ℝ). ε > 0 →
      ∃ (δ : ℝ). δ > 0 ∧ ∀ (y : ℝ). abs(y - x) < δ → abs(f(y) * g(y) - f(x) * g(x)) < ε
      by Real.ContinuousAt.of_epsilon_delta;
  take ε : ℝ;
  suppose ε > 0 as εPositive;
  {
    let fRoof : ℝ := abs(f(x)) + 1;
    let gRoof : ℝ := abs(g(x)) + 1;
    -- The roofs bound their factors.
    abs(g(x)) ≤ abs(g(x)) + 1;
    -- Each factor's tolerance: ε/2, scaled down by the opposite roof.
    let gTolerance : ℝ := ε / 2 / fRoof;
    let fTolerance : ℝ := ε / 2 / gRoof;
    gTolerance > 0;
    fTolerance > 0;
    -- The three δs: stay within 1 of f(x), and within each scaled
    -- tolerance for the matching factor.
    (1 : ℝ) > 0;
    choose nearδ such that nearδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < nearδ → abs(f(y) - f(x)) < 1
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < nearδ
            → abs(f(y) - f(x)) < 1 as fNear;
    choose gδ such that gδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < gδ → abs(g(y) - g(x)) < gTolerance
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < gδ
            → abs(g(y) - g(x)) < gTolerance as gClose;
    choose fδ such that fδ > 0
            ∧ ∀ (y : ℝ). abs(y - x) < fδ → abs(f(y) - f(x)) < fTolerance
        from Real.ContinuousAt.tolerance;
    ∀ (y : ℝ). abs(y - x) < fδ
            → abs(f(y) - f(x)) < fTolerance as fClose;
    witness min(nearδ, min(gδ, fδ)) with {
      ∀ (y : ℝ). abs(y - x) < min(nearδ, min(gδ, fδ))
              → abs(f(y) * g(y) - f(x) * g(x)) < ε
          by (y : ℝ)
             (yClose : abs(y - x) < min(nearδ, min(gδ, fδ))) ↦ {
           -- The single δ serves all three continuity facts.
           min(nearδ, min(gδ, fδ)) ≤ nearδ;
           min(nearδ, min(gδ, fδ)) ≤ min(gδ, fδ);
           min(gδ, fδ) ≤ gδ;
           min(gδ, fδ) ≤ fδ;
           min(nearδ, min(gδ, fδ)) ≤ gδ;
           min(nearδ, min(gδ, fδ)) ≤ fδ;
           abs(y - x) < min(nearδ, min(gδ, fδ)) ≤ nearδ as yNear;
           abs(y - x) < min(nearδ, min(gδ, fδ)) ≤ gδ as yCloseG;
           abs(y - x) < min(nearδ, min(gδ, fδ)) ≤ fδ as yCloseF;
           -- |f(y)| sits under its roof.
           abs(f(y) - f(x)) < 1 by fNear(y, yNear);
           abs(f(y))
              = abs(f(x) + (f(y) - f(x)))            by (f(y) = f(x) + (f(y) - f(x)))
              ≤ abs(f(x)) + abs(f(y) - f(x))
              ≤ abs(f(x)) + 1;
           -- The two error terms, each strictly below its tolerance.
           abs(g(y) - g(x)) < gTolerance by gClose(y, yCloseG);
           abs(f(y) - f(x)) < fTolerance by fClose(y, yCloseF);
           abs(f(y)) * abs(g(y) - g(x))
              ≤ fRoof * abs(g(y) - g(x))
              = abs(g(y) - g(x)) * fRoof
              < gTolerance * fRoof
              = fRoof * gTolerance;
           abs(g(x)) * abs(f(y) - f(x))
              ≤ gRoof * abs(f(y) - f(x))
              = abs(f(y) - f(x)) * gRoof
              < fTolerance * gRoof
              = gRoof * fTolerance;
           -- Each roof times its scaled tolerance is exactly ε/2.
           fRoof * gTolerance = ε / 2 as fRoofCollapse;
           gRoof * fTolerance = ε / 2 as gRoofCollapse;
           -- Assemble.
           abs(f(y) * g(y) - f(x) * g(x))
              = abs(f(y) * (g(y) - g(x)) + g(x) * (f(y) - f(x)))
                    by (f(y) * g(y) - f(x) * g(x)
                        = f(y) * (g(y) - g(x)) + g(x) * (f(y) - f(x)))
              ≤ abs(f(y) * (g(y) - g(x))) + abs(g(x) * (f(y) - f(x)))
              = abs(f(y)) * abs(g(y) - g(x)) + abs(g(x) * (f(y) - f(x)))
              = abs(f(y)) * abs(g(y) - g(x)) + abs(g(x)) * abs(f(y) - f(x))
              < fRoof * gTolerance + gRoof * fTolerance
              = ε / 2 + gRoof * fTolerance
                    by fRoofCollapse
              = ε / 2 + ε / 2
                    by gRoofCollapse
              = ε
          };
      done
    }
  }
}
