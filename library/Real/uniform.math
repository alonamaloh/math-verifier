-- Real/uniform.math
--
-- Uniform continuity on the line. There is no ε–δ argument here: a real
-- function is continuous in the sense of `Metric/continuity.math`, the
-- unit interval is compact in the sense of `Metric/compactness.math`, so
-- Heine–Cantor is the generic theorem read at ℝ. All this file does is
-- state the conclusion in the arithmetic a real-analysis text writes.

module Real.uniform

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.absolute_value
import Real.continuity
import Metric.space
import Metric.continuity
import Metric.uniform
import Metric.interval
import Metric.real

-- A function continuous at every point of [0, 1] is uniformly continuous
-- there: one δ serves the whole interval.
theorem Real.uniformly_continuous_on_unitInterval (f : ℝ → ℝ)
        (continuous : ∀ (x : ℝ). x ∈ Real.unitInterval → Real.ContinuousAt(f, x))
        : ∀ (ε : ℝ). ε > 0 → ∃ (δ : ℝ). δ > 0 ∧
            ∀ (x : ℝ). x ∈ Real.unitInterval →
              ∀ (y : ℝ). y ∈ Real.unitInterval →
                abs(y - x) < δ → abs(f(y) - f(x)) < ε := {
  Real.unitInterval ⊆ Set.universe(ℝ) by Set.subset_universe;
  MetricSpace.ContinuousOn(f, Real.unitInterval)
      by { take x : ℝ;
           suppose x ∈ Real.unitInterval;
           Real.ContinuousAt(f, x);
           done by MetricSpace.ContinuousWithinAt.restrict };
  MetricSpace.IsCompact(Real.unitInterval) by Real.unitInterval_IsCompact;
  done by MetricSpace.uniformly_continuous_on_compact
}
