-- Natural/least_number.math
--
-- The least-number principle (well-ordering of ℕ): any predicate that
-- holds somewhere holds at a least point. The argument is strong
-- induction on the witness: at `n`, either some smaller point already
-- satisfies the predicate — recurse there — or none does, and then `n`
-- itself is the minimum.
--
-- This is the well-ordering primitive behind "a nonempty ideal has an
-- element of minimal Euclidean norm", i.e. the Euclidean ⇒ PID step.

module Natural.least_number

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Natural.basics
import Natural.classical_decidable
import Natural.peano
import Natural.order
import Natural.division
import Natural.strong_recursion
import Natural.add_order

-- A minimal witness: a point where the predicate holds with nothing
-- below it doing so.
theorem Natural.least_witness_minimal (predicate : ℕ → Proposition)
        : ∀ (n : ℕ). predicate(n)
          → ∃ (minimum : ℕ).
              predicate(minimum)
              ∧ (∀ (k : ℕ). k < minimum → ¬predicate(k)) := {
  take n : ℕ;
  by strong induction on n with subject, inductionHypothesis {
    suppose predicate(subject) as predicateAtSubject;
    done by cases {
      case ∃ (smaller : ℕ). smaller < subject ∧ predicate(smaller) as someSmaller: {
          choose smaller such that smaller < subject ∧ predicate(smaller)
              from someSmaller;
          smaller < subject as smallerBelowSubject;
          predicate(smaller) as predicateAtSmaller;
          inductionHypothesis(smaller, smallerBelowSubject, predicateAtSmaller)
        }
      otherwise as noneSmaller: {
          ∀ (k : ℕ). k < subject → ¬predicate(k)
              by (k : ℕ) (kLessSubject : k < subject)
                     (predicateAtK : predicate(k)) ↦ {
                   ∃ (smaller : ℕ). smaller < subject ∧ predicate(smaller)
                       by { witness k with And.introduction(kLessSubject, predicateAtK) }
                       as existsSmaller;
                   noneSmaller(existsSmaller)
                 } as subjectIsMinimal;
          witness subject with And.introduction(predicateAtSubject, subjectIsMinimal)
        }
    }
  }
}

-- The least-number principle proper: a least point in the `≤` sense.
-- Anything strictly below the minimal witness would contradict
-- minimality, so by trichotomy the minimum is ≤ every other witness.
theorem Natural.least_witness (predicate : ℕ → Proposition)
        (n : ℕ) (witnessAtN : predicate(n))
        : ∃ (minimum : ℕ).
            predicate(minimum) ∧ (∀ (k : ℕ). predicate(k) → minimum ≤ k) := {
  ∃ (minimum : ℕ).
      predicate(minimum) ∧ (∀ (k : ℕ). k < minimum → ¬predicate(k))
      by Natural.least_witness_minimal as minimalWitness;
  choose minimum such that
      predicate(minimum) ∧ (∀ (k : ℕ). k < minimum → ¬predicate(k))
      from minimalWitness;
  predicate(minimum) as predicateAtMinimum;
  ∀ (k : ℕ). k < minimum → ¬predicate(k);
  ∀ (k : ℕ). predicate(k) → minimum ≤ k
      by (k : ℕ) (predicateAtK : predicate(k)) ↦ {
           k < minimum ∨ k = minimum ∨ minimum < k
               by Natural.lt_trichotomy;
           done by cases {
             case k < minimum as kLessMinimum: {
                 ¬predicate(k);
                 done
               }
             case k = minimum ∨ minimum < k:
                 done by cases {
                   case k = minimum: done
                   case minimum < k: done
                 }
           }
         } as minimumIsLeast;
  witness minimum with And.introduction(predicateAtMinimum, minimumIsLeast)
}

-- ----------------------------------------------------------------------
-- The greatest witness, dual to the least: a predicate that holds
-- somewhere and never above a bound holds at a greatest point. Induction
-- walks the bound down — either the predicate reaches the bound, and that
-- is the maximum, or it never does and the bound below it serves.
theorem Natural.greatest_witness (predicate : ℕ → Proposition)
        (n bound : ℕ) (witnessAtN : predicate(n))
        (isBound : ∀ (k : ℕ). predicate(k) → k ≤ bound)
        : ∃ (maximum : ℕ).
            predicate(maximum) ∧ (∀ (k : ℕ). predicate(k) → k ≤ maximum) :=
  by induction on bound with IH {
    case bound = 0: {
        n ≤ 0;
        n = 0;
        predicate(0);
        witness 0
      }
    case bound = 1 + predecessor: {
        done by cases {
          case predicate(1 + predecessor): witness (1 + predecessor)
          otherwise as missesTheBound: {
              ∀ (k : ℕ). predicate(k) → k ≤ predecessor
                  by { take k : ℕ;
                       suppose predicate(k);
                       k ≤ 1 + predecessor;
                       ¬(k = 1 + predecessor)
                           by { suppose k = 1 + predecessor;
                                predicate(1 + predecessor);
                                done };
                       done by Natural.le_of_le_one_plus_of_ne };
              done by IH
            }
        }
      }
  }
