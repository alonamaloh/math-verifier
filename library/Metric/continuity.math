-- Metric/continuity.math
--
-- Continuity between metric spaces, relative to a carrier set in the
-- domain. The source and target spaces are separate bundles, so ONE
-- definition covers every combination a curve argument needs: ℝ → ℝ,
-- ℝ → the plane, the plane → the plane, the plane → ℝ.
--
-- A map is continuous on a carrier when the usual ε-δ condition holds
-- with both quantifiers restricted to it. Nothing is asked of the map
-- off the carrier.

module Metric.continuity

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Metric.space
import Metric.topology
import Metric.near

definition MetricSpace.ContinuousAt {source target : MetricSpace}
        (f : source → target)
        (carrier : Set(source))
        (x : source) : Proposition :=
  ∀ (tolerance : ℝ). tolerance > 0 →
    ∃ (nearness : ℝ). nearness > 0 ∧
      ∀ (y : source). y ∈ carrier →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < tolerance

definition MetricSpace.ContinuousOn {source target : MetricSpace}
        (f : source → target)
        (carrier : Set(source))
        : Proposition :=
  ∀ (x : source). x ∈ carrier →
    MetricSpace.ContinuousAt(f, carrier, x)

-- Continuity only sees the values on the carrier, so a map that agrees
-- with a continuous one there is continuous there. This is what lets a
-- glued map be pasted: on each piece it agrees with that piece's map.
theorem MetricSpace.ContinuousOn.of_agreeing (source target : MetricSpace)
        (f g : source → target)
        (carrier : Set(source))
        (agree : ∀ (x : source). x ∈ carrier → f(x) = g(x))
        (gContinuous : MetricSpace.ContinuousOn(g, carrier))
        : MetricSpace.ContinuousOn(f, carrier) := {
  take x : source;
  suppose x ∈ carrier as xInCarrier;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  choose nearness such that
      nearness > 0 ∧
        ∀ (y : source). y ∈ carrier →
          distance(x, y) < nearness →
            distance(g(x), g(y)) < tolerance
      from gContinuous;
  nearness > 0;
  ∀ (y : source). y ∈ carrier →
      distance(x, y) < nearness →
        distance(g(x), g(y)) < tolerance as valuesClose;
  f(x) = g(x) by agree as valueAtCentre;
  witness nearness with {
    nearness > 0;
    ∀ (y : source). y ∈ carrier →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < tolerance
        by (y : source) (yInCarrier : y ∈ carrier)
           (near : distance(x, y) < nearness) ↦ {
          f(y) = g(y) by agree as valueAtPoint;
          distance(g(x), g(y)) < tolerance by valuesClose;
          distance(f(x), f(y))
             = distance(g(x), f(y)) by substituting valueAtCentre
             = distance(g(x), g(y)) by substituting valueAtPoint
             < tolerance;
          done
        };
    done
  }
}

-- Continuity composes. The outer map's tolerance chooses the nearness the
-- inner map must meet, and the inner map's nearness answers for the
-- composite — provided the inner map lands where the outer one is
-- continuous.
theorem MetricSpace.ContinuousOn.compose (source middle target : MetricSpace)
        (inner : source → middle)
        (outer : middle → target)
        (carrier : Set(source))
        (region : Set(middle))
        (innerContinuous : MetricSpace.ContinuousOn(inner, carrier))
        (lands : ∀ (x : source). x ∈ carrier → inner(x) ∈ region)
        (outerContinuous : MetricSpace.ContinuousOn(outer, region))
        : MetricSpace.ContinuousOn(
              (x : source) ↦ outer(inner(x)), carrier) := {
  take x : source;
  suppose x ∈ carrier as xInCarrier;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  inner(x) ∈ region by lands;
  choose middleNearness such that
      middleNearness > 0 ∧
        ∀ (y : middle). y ∈ region →
          distance(inner(x), y) < middleNearness →
            distance(outer(inner(x)), outer(y)) < tolerance
      from outerContinuous;
  middleNearness > 0;
  ∀ (y : middle). y ∈ region →
      distance(inner(x), y) < middleNearness →
        distance(outer(inner(x)), outer(y)) < tolerance
      as outerAnswers;
  choose nearness such that
      nearness > 0 ∧
        ∀ (y : source). y ∈ carrier →
          distance(x, y) < nearness →
            distance(inner(x), inner(y)) < middleNearness
      from innerContinuous;
  nearness > 0;
  ∀ (y : source). y ∈ carrier →
      distance(x, y) < nearness →
        distance(inner(x), inner(y)) < middleNearness
      as innerAnswers;
  witness nearness with {
    nearness > 0;
    ∀ (y : source). y ∈ carrier →
        distance(x, y) < nearness →
          distance(outer(inner(x)), outer(inner(y))) < tolerance
        by (y : source) (yInCarrier : y ∈ carrier)
           (near : distance(x, y) < nearness) ↦ {
          distance(inner(x), inner(y)) < middleNearness by innerAnswers;
          inner(y) ∈ region by lands;
          done by outerAnswers
        };
    done
  }
}

-- Restricting the carrier only weakens the condition — pointwise. The
-- same nearness serves, because there are fewer points left to test.
theorem MetricSpace.ContinuousAt.restrict (source target : MetricSpace)
        (f : source → target)
        (smaller larger : Set(source))
        (smallerInLarger : smaller ⊆ larger)
        (x : source)
        (continuousAtInLarger : MetricSpace.ContinuousAt(f, larger, x))
        : MetricSpace.ContinuousAt(f, smaller, x) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that nearness > 0 ∧
      ∀ (y : source). y ∈ larger →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < tolerance
      as largerBall from continuousAtInLarger;
  nearness > 0;
  ∀ (y : source). y ∈ smaller →
      distance(x, y) < nearness →
        distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose y ∈ smaller;
           suppose distance(x, y) < nearness;
           y ∈ larger by smallerInLarger;
           done by largerBall };
  witness nearness
}

-- Restricting the carrier only weakens the condition.
theorem MetricSpace.ContinuousOn.restrict (source target : MetricSpace)
        (f : source → target)
        (smaller larger : Set(source))
        (smallerInLarger : smaller ⊆ larger)
        (continuousOnLarger : MetricSpace.ContinuousOn(f, larger))
        : MetricSpace.ContinuousOn(f, smaller) := {
  take x : source;
  suppose x ∈ smaller as xInSmaller;
  x ∈ larger by smallerInLarger;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  choose nearness such that nearness > 0 ∧
      ∀ (y : source). y ∈ larger →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < tolerance
      from continuousOnLarger;
  nearness > 0;
  ∀ (y : source). y ∈ larger →
      distance(x, y) < nearness →
        distance(f(x), f(y)) < tolerance as largerBall;
  witness nearness with {
    nearness > 0;
    ∀ (y : source). y ∈ smaller →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < tolerance
        by (y : source) (yInSmaller : y ∈ smaller)
           (yClose : distance(x, y) < nearness) ↦ {
             y ∈ larger by smallerInLarger;
             done by largerBall
           };
    done
  }
}

-- ----------------------------------------------------------------------
-- ----------------------------------------------------------------------
-- Continuity, read through the filter. This is the point of the notion:
-- "f is continuous at x" is "for every tolerance, f(y) is within it for y
-- near x" — the ε-δ statement with the δ, and its bookkeeping, inside
-- `Near`.

theorem MetricSpace.ContinuousAt.of_near {source target : MetricSpace}
        (f : source → target) (x : source)
        (nearby : ∀ (tolerance : ℝ). tolerance > 0 →
            MetricSpace.Near(x,
                (y : source) ↦ distance(f(x), f(y)) < tolerance))
        : MetricSpace.ContinuousAt(f, Set.universe(source), x) :=
  unfold MetricSpace.Near in {
  take tolerance : ℝ;
  suppose tolerance > 0;
  MetricSpace.Near(x,
      (y : source) ↦ distance(f(x), f(y)) < tolerance)
      by nearby;
  choose radius such that radius > 0 ∧
      ∀ (y : source). distance(x, y) < radius →
        distance(f(x), f(y)) < tolerance;
  radius > 0;
  ∀ (y : source). y ∈ Set.universe(source) →
      distance(x, y) < radius →
        distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose y ∈ Set.universe(source);
           suppose distance(x, y) < radius;
           done };
  witness radius
}

theorem MetricSpace.ContinuousAt.near {source target : MetricSpace}
        (f : source → target) (x : source)
        (continuous : MetricSpace.ContinuousAt(f, Set.universe(source), x))
        (tolerance : ℝ) (tolerancePositive : tolerance > 0)
        : MetricSpace.Near(x,
              (y : source) ↦ distance(f(x), f(y)) < tolerance) :=
  unfold MetricSpace.Near in {
  choose radius such that radius > 0 ∧
      ∀ (y : source). y ∈ Set.universe(source) →
        distance(x, y) < radius →
          distance(f(x), f(y)) < tolerance
      from continuous;
  radius > 0;
  ∀ (y : source). distance(x, y) < radius →
      distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose distance(x, y) < radius;
           y ∈ Set.universe(source);
           done };
  witness radius
}

-- The same crossing for continuity RELATIVE TO A CARRIER: the filter's
-- predicate carries the membership antecedent, so the two spellings
-- differ only in the order of the two antecedents — exactly as for
-- `OpenIn.near`. What they buy is that combining two continuity facts at
-- one point becomes `Near.and`, one radius taken by the filter, instead
-- of a minimum carried by hand.

theorem MetricSpace.ContinuousAt.near_on {source target : MetricSpace}
        (f : source → target) (carrier : Set(source)) (x : source)
        (continuous : MetricSpace.ContinuousAt(f, carrier, x))
        (tolerance : ℝ) (tolerancePositive : tolerance > 0)
        : MetricSpace.Near(x,
              (y : source) ↦ y ∈ carrier →
                  distance(f(x), f(y)) < tolerance) :=
  unfold MetricSpace.Near in {
  choose radius such that radius > 0 ∧
      ∀ (y : source). y ∈ carrier →
        distance(x, y) < radius →
          distance(f(x), f(y)) < tolerance
      from continuous;
  radius > 0;
  ∀ (y : source). distance(x, y) < radius →
      (y ∈ carrier → distance(f(x), f(y)) < tolerance)
      by { take y : source;
           suppose distance(x, y) < radius;
           suppose y ∈ carrier;
           done };
  witness radius
}

theorem MetricSpace.ContinuousAt.of_near_on {source target : MetricSpace}
        (f : source → target) (carrier : Set(source)) (x : source)
        (nearby : ∀ (tolerance : ℝ). tolerance > 0 →
            MetricSpace.Near(x,
                (y : source) ↦ y ∈ carrier →
                    distance(f(x), f(y)) < tolerance))
        : MetricSpace.ContinuousAt(f, carrier, x) :=
  unfold MetricSpace.Near in {
  take tolerance : ℝ;
  suppose tolerance > 0;
  MetricSpace.Near(x,
      (y : source) ↦ y ∈ carrier → distance(f(x), f(y)) < tolerance)
      by nearby;
  choose radius such that radius > 0 ∧
      ∀ (y : source). distance(x, y) < radius →
        (y ∈ carrier → distance(f(x), f(y)) < tolerance);
  radius > 0;
  ∀ (y : source). y ∈ carrier →
      distance(x, y) < radius →
        distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose y ∈ carrier;
           suppose distance(x, y) < radius;
           done };
  witness radius
}

-- ----------------------------------------------------------------------
-- Pushforward: the filter transported along a continuous map. This is the
-- `Near` analogue of `Eventually.shift`, and it is what a COMPOSITION
-- needs — there the two hypotheses sit at different centres (`f` near
-- `g(x)`, `g` near `x`), which the scope, folding facts at one centre,
-- cannot combine on its own.
theorem MetricSpace.Near.under {source target : MetricSpace}
        (g : source → target) (x : source)
        (gContinuous : MetricSpace.ContinuousAt(g, Set.universe(source), x))
        (P : target → Proposition)
        (nearP : MetricSpace.Near(g(x), P))
        : MetricSpace.Near(x, (y : source) ↦ P(g(y))) :=
  unfold MetricSpace.Near in {
    choose radius such that radius > 0 ∧
        ∀ (z : target). distance(g(x), z) < radius → P(z)
        from nearP;
    radius > 0;
    choose nearness such that nearness > 0 ∧
        ∀ (y : source). y ∈ Set.universe(source) →
          distance(x, y) < nearness →
            distance(g(x), g(y)) < radius
        from gContinuous;
    nearness > 0;
    ∀ (y : source). distance(x, y) < nearness → P(g(y))
        by { take y : source;
             suppose distance(x, y) < nearness;
             y ∈ Set.universe(source);
             distance(g(x), g(y)) < radius;
             done };
    witness nearness
  }

-- ----------------------------------------------------------------------
-- The pasting lemma, through the filter.
--
-- Each piece supplies, near every point of the union, the bound for the
-- points of the union that lie in that piece — by one of two routes. If
-- the point is IN the piece, continuity on that piece supplies it. If the
-- point is NOT in the piece, the piece being closed in the union supplies
-- a ball within which no point of the union is in the piece at all, so
-- the requirement is vacuous. Both routes give the same near-fact, which
-- is what lets the main proof avoid a four-way split.

theorem MetricSpace.pasteRadius (source target : MetricSpace)
        (f : source → target)
        (piece union : Set(source))
        (pieceClosed : MetricSpace.ClosedIn(piece, union))
        (pieceContinuous : MetricSpace.ContinuousOn(f, piece))
        (x : source) (xInUnion : x ∈ union)
        (tolerance : ℝ) (tolerancePositive : tolerance > 0)
        : MetricSpace.Near(x,
              (y : source) ↦ y ∈ union → y ∈ piece →
                  distance(f(x), f(y)) < tolerance) :=
  done by cases {
    case x ∈ piece: {
        MetricSpace.ContinuousAt(f, piece, x) by pieceContinuous;
        MetricSpace.Near(x,
            (y : source) ↦ y ∈ piece →
                distance(f(x), f(y)) < tolerance)
            by MetricSpace.ContinuousAt.near_on;
        for y sufficiently near x: {
          suppose y ∈ union;
          suppose y ∈ piece;
          done
        }
      }
    otherwise as xOutsidePiece: {
        x ∈ union ∖ piece;
        MetricSpace.Near(x,
            (y : source) ↦ y ∈ union → y ∈ union ∖ piece)
            by MetricSpace.OpenIn.near(subset := union ∖ piece);
        for y sufficiently near x: {
          suppose y ∈ union;
          suppose y ∈ piece;
          y ∈ union ∖ piece;
          ¬(y ∈ piece);
          done
        }
      }
  }

-- A map continuous on each of two relatively closed pieces is continuous
-- on their union. This is what glues the interior and exterior extensions
-- of the main theorem along the curve they share.
theorem MetricSpace.ContinuousOn.paste (source target : MetricSpace)
        (f : source → target)
        (first second : Set(source))
        (firstClosed : MetricSpace.ClosedIn(first, first ∪ second))
        (secondClosed : MetricSpace.ClosedIn(second, first ∪ second))
        (firstContinuous : MetricSpace.ContinuousOn(f, first))
        (secondContinuous : MetricSpace.ContinuousOn(f, second))
        : MetricSpace.ContinuousOn(f, first ∪ second) := {
  take x : source;
  suppose x ∈ first ∪ second as xInUnion;
  ∀ (tolerance : ℝ). tolerance > 0 →
      MetricSpace.Near(x, (y : source) ↦ y ∈ first ∪ second →
          distance(f(x), f(y)) < tolerance)
      by { take tolerance : ℝ;
           suppose tolerance > 0;
           MetricSpace.Near(x,
               (y : source) ↦ y ∈ first ∪ second → y ∈ first →
                   distance(f(x), f(y)) < tolerance)
               by MetricSpace.pasteRadius(piece := first);
           MetricSpace.Near(x,
               (y : source) ↦ y ∈ first ∪ second → y ∈ second →
                   distance(f(x), f(y)) < tolerance)
               by MetricSpace.pasteRadius(piece := second);
           for y sufficiently near x: {
             suppose y ∈ first ∪ second;
             done by cases {
               case y ∈ first: done
               case y ∈ second: done
             }
           } };
  done by MetricSpace.ContinuousAt.of_near_on
}

