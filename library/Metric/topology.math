-- Metric/topology.math
--
-- The relative topology of a metric space. Developed once, over an
-- abstract `m : MetricSpace`, and read at every carrier that supplies an
-- instance.
--
-- Everything is stated RELATIVE to a carrier set from the start, and the
-- absolute notions are the `carrier = universe` case. That is a
-- deliberate choice: connectedness gets applied to arcs and curves as
-- subspaces, and the model-curve parametrization needs
-- compact→Hausdorff on a subspace, so retrofitting relativisation would
-- cost more than paying for it once here.
--
-- `MetricSpace.OpenIn(subset, carrier)` does not require
-- `subset ⊆ carrier` — the ε-ball condition is meaningful without it,
-- and demanding it would add a proof obligation at every use. Consumers
-- that need the inclusion carry it separately.

module Metric.topology

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Metric.space
import Metric.near

-- ----------------------------------------------------------------------
-- Open sets, relative to a carrier.

definition MetricSpace.OpenIn {m : MetricSpace}
        (subset carrier : Set(m)) : Proposition :=
  ∀ (x : m). x ∈ subset →
    ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset

definition MetricSpace.IsOpen {m : MetricSpace}
        (subset : Set(m)) : Proposition :=
  MetricSpace.OpenIn(subset, Set.universe(m))

definition MetricSpace.ClosedIn {m : MetricSpace}
        (subset carrier : Set(m)) : Proposition :=
  MetricSpace.OpenIn(Set.difference(carrier, subset), carrier)

-- ----------------------------------------------------------------------
-- The lattice laws. Each is the ε-ball argument a textbook gives.

-- `OpenIn` through the SPATIAL FILTER: a set is relatively open when, at
-- each of its points, belonging to it holds NEAR that point (for the
-- points of the carrier). The two spellings differ only in the order of
-- the two antecedents, so these cross between them; what they buy is that
-- combining two open sets becomes `Near.and` — one radius, taken by the
-- filter — instead of a minimum carried by hand.

theorem MetricSpace.OpenIn.near {m : MetricSpace}
        (subset carrier : Set(m))
        (isOpen : MetricSpace.OpenIn(subset, carrier))
        (x : m) (inSubset : x ∈ subset)
        : MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ subset) :=
  unfold MetricSpace.Near in {
    choose radius such that radius > 0 ∧
        ∀ (y : m). y ∈ carrier → distance(x, y) < radius → y ∈ subset
        from isOpen;
    radius > 0;
    ∀ (y : m). distance(x, y) < radius → (y ∈ carrier → y ∈ subset)
        by { take y : m;
             suppose distance(x, y) < radius;
             suppose y ∈ carrier;
             done };
    witness radius
  }

theorem MetricSpace.OpenIn.of_near {m : MetricSpace}
        (subset carrier : Set(m))
        (nearby : ∀ (x : m). x ∈ subset →
            MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ subset))
        : MetricSpace.OpenIn(subset, carrier) := {
  take x : m;
  suppose x ∈ subset;
  MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ subset) by nearby;
  unfold MetricSpace.Near in {
    choose radius such that radius > 0 ∧
        ∀ (y : m). distance(x, y) < radius → (y ∈ carrier → y ∈ subset);
    radius > 0;
    ∀ (y : m). y ∈ carrier → distance(x, y) < radius → y ∈ subset
        by { take y : m;
             suppose y ∈ carrier;
             suppose distance(x, y) < radius;
             done };
    witness radius
  }
}

theorem MetricSpace.OpenIn.universe (m : MetricSpace)
        (carrier : Set(m))
        : MetricSpace.OpenIn(Set.universe(m), carrier) := {
  take x : m;
  suppose x ∈ Set.universe(m);
  witness (1 : ℝ) with {
    (1 : ℝ) > 0;
    ∀ (y : m). y ∈ carrier →
        distance(x, y) < 1 → y ∈ Set.universe(m)
        by (y : m) (yInCarrier : y ∈ carrier)
           (yClose : distance(x, y) < 1) ↦
             Set.member_universe(y);
    done
  }
}

theorem MetricSpace.OpenIn.empty (m : MetricSpace)
        (carrier : Set(m))
        : MetricSpace.OpenIn(Set.empty(m), carrier) := {
  take x : m;
  suppose x ∈ Set.empty(m) as inEmpty;
  False by Set.not_member_empty;
  done
}

-- A finite intersection of relatively open sets is relatively open. The
-- filter takes the smaller of the two radii; no radius is named here.
theorem MetricSpace.OpenIn.intersection (m : MetricSpace)
        (left right carrier : Set(m))
        (leftOpen : MetricSpace.OpenIn(left, carrier))
        (rightOpen : MetricSpace.OpenIn(right, carrier))
        : MetricSpace.OpenIn(left ∩ right, carrier) := {
  ∀ (x : m). x ∈ left ∩ right →
      MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ left ∩ right)
      by { take x : m;
           suppose x ∈ left ∩ right;
           x ∈ left;
           x ∈ right;
           MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ left)
               by MetricSpace.OpenIn.near;
           MetricSpace.Near(x, (y : m) ↦ y ∈ carrier → y ∈ right)
               by MetricSpace.OpenIn.near;
           for y sufficiently near x: {
             suppose y ∈ carrier;
             y ∈ left;
             y ∈ right;
             done
           } };
  done by MetricSpace.OpenIn.of_near
}

-- A union of two relatively open sets is relatively open: whichever side
-- the point came from supplies the radius.
theorem MetricSpace.OpenIn.union (m : MetricSpace)
        (left right carrier : Set(m))
        (leftOpen : MetricSpace.OpenIn(left, carrier))
        (rightOpen : MetricSpace.OpenIn(right, carrier))
        : MetricSpace.OpenIn(left ∪ right, carrier) := {
  take x : m;
  suppose x ∈ left ∪ right as inEither;
  done by cases {
    case x ∈ left: {
        choose radius such that
            radius > 0 ∧
              ∀ (y : m). y ∈ carrier →
                distance(x, y) < radius → y ∈ left
            from leftOpen;
        radius > 0;
        ∀ (y : m). y ∈ carrier →
            distance(x, y) < radius → y ∈ left as leftBall;
        witness radius with {
          radius > 0;
          ∀ (y : m). y ∈ carrier →
              distance(x, y) < radius → y ∈ left ∪ right
              by (y : m) (yInCarrier : y ∈ carrier)
                 (yClose : distance(x, y) < radius) ↦ {
                   y ∈ left by leftBall;
                   done by Set.subset_union_left
                 };
          done
        }
      }
    case x ∈ right: {
        choose radius such that
            radius > 0 ∧
              ∀ (y : m). y ∈ carrier →
                distance(x, y) < radius → y ∈ right
            from rightOpen;
        radius > 0;
        ∀ (y : m). y ∈ carrier →
            distance(x, y) < radius → y ∈ right as rightBall;
        witness radius with {
          radius > 0;
          ∀ (y : m). y ∈ carrier →
              distance(x, y) < radius → y ∈ left ∪ right
              by (y : m) (yInCarrier : y ∈ carrier)
                 (yClose : distance(x, y) < radius) ↦ {
                   y ∈ right by rightBall;
                   done by Set.subset_union_right
                 };
          done
        }
      }
  }
}

-- ----------------------------------------------------------------------
-- Balls are open, which is what makes the definition worth having.

theorem MetricSpace.Ball_IsOpen (m : MetricSpace)
        (center : m) (radius : ℝ)
        : MetricSpace.IsOpen(MetricSpace.Ball(center, radius)) := {
  take x : m;
  suppose x ∈ MetricSpace.Ball(center, radius) as xInside;
  distance(center, x) < radius;
  radius - distance(center, x) > 0;
  witness radius - distance(center, x) with {
    radius - distance(center, x) > 0;
    ∀ (y : m). y ∈ Set.universe(m) →
        distance(x, y) < radius - distance(center, x) →
          y ∈ MetricSpace.Ball(center, radius)
        by (y : m)
           (yAnywhere : y ∈ Set.universe(m))
           (yClose : distance(x, y)
               < radius - distance(center, x)) ↦ {
             distance(center, y)
                ≤ distance(center, x) + distance(x, y)
                      by MetricSpace.distance_triangle
                < distance(center, x)
                      + (radius - distance(center, x))
                = radius;
             done
           };
    done
  }
}

-- ----------------------------------------------------------------------
-- The textbook characterization: relatively open means "cut out of the
-- carrier by an open set". The ε-ball form above is what the proofs
-- manipulate; this is what a reader expects to see.

-- Witness for the forward direction: the union of every ball the ε-ball
-- condition supplies. A comprehension, so no indexed unions are needed.
-- The conjunction is kept flat so that a proof builds it leg by leg.
definition MetricSpace.BallWitness {m : MetricSpace}
        (subset carrier : Set(m))
        (x : m) (radius : ℝ) (y : m)
        : Proposition :=
  x ∈ subset
  ∧ radius > 0
  ∧ (∀ (z : m). z ∈ carrier →
        distance(x, z) < radius → z ∈ subset)
  ∧ distance(x, y) < radius

-- The four legs, as citations. `BallWitness` is a definition, so a proof
-- that reaches into a folded witness pays a δ-unfolding at every
-- projection; these pay it once each, and the use sites then say which
-- leg they are using.
theorem MetricSpace.BallWitness.centre_inside (m : MetricSpace)
        (subset carrier : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, carrier, x, radius, y))
        : x ∈ subset :=
  unfold MetricSpace.BallWitness in { x ∈ subset; done }

theorem MetricSpace.BallWitness.radius_positive (m : MetricSpace)
        (subset carrier : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, carrier, x, radius, y))
        : radius > 0 :=
  unfold MetricSpace.BallWitness in { radius > 0; done }

theorem MetricSpace.BallWitness.ball_inside (m : MetricSpace)
        (subset carrier : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, carrier, x, radius, y))
        : ∀ (z : m). z ∈ carrier →
              distance(x, z) < radius → z ∈ subset :=
  unfold MetricSpace.BallWitness in {
    ∀ (z : m). z ∈ carrier →
        distance(x, z) < radius → z ∈ subset;
    done
  }

theorem MetricSpace.BallWitness.reaches (m : MetricSpace)
        (subset carrier : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, carrier, x, radius, y))
        : distance(x, y) < radius :=
  unfold MetricSpace.BallWitness in { distance(x, y) < radius; done }

definition MetricSpace.openHull {m : MetricSpace}
        (subset carrier : Set(m))
        : Set(m) :=
  (y : m) ↦
    ∃ (x : m). ∃ (radius : ℝ).
      MetricSpace.BallWitness(subset, carrier, x, radius, y)

theorem MetricSpace.openHull_IsOpen (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.IsOpen(MetricSpace.openHull(subset, carrier)) := {
  take y : m;
  suppose y ∈ MetricSpace.openHull(subset, carrier) as inHull;
  choose x, radius such that
      MetricSpace.BallWitness(subset, carrier, x, radius, y) from inHull;
  x ∈ subset by MetricSpace.BallWitness.centre_inside;
  radius > 0 by MetricSpace.BallWitness.radius_positive;
  ∀ (z : m). z ∈ carrier →
      distance(x, z) < radius → z ∈ subset
      by MetricSpace.BallWitness.ball_inside;
  distance(x, y) < radius by MetricSpace.BallWitness.reaches;
  radius - distance(x, y) > 0;
  witness radius - distance(x, y) with {
    radius - distance(x, y) > 0;
    ∀ (w : m). w ∈ Set.universe(m) →
        distance(y, w) < radius - distance(x, y) →
          w ∈ MetricSpace.openHull(subset, carrier)
        by (w : m)
           (wAnywhere : w ∈ Set.universe(m))
           (wNear : distance(y, w)
               < radius - distance(x, y)) ↦ {
             distance(x, w)
                ≤ distance(x, y) + distance(y, w)
                      by MetricSpace.distance_triangle
                < distance(x, y)
                      + (radius - distance(x, y))
                = radius;
             MetricSpace.BallWitness(subset, carrier, x, radius, w) as witnessHolds;
             witness x with witness radius with witnessHolds
           };
    done
  }
}

-- Forward: a relatively open subset is cut out by its own open hull.
theorem MetricSpace.subset_openHull_intersection (m : MetricSpace)
        (subset carrier : Set(m))
        (subsetInCarrier : subset ⊆ carrier)
        (openInCarrier : MetricSpace.OpenIn(subset, carrier))
        : subset ⊆ MetricSpace.openHull(subset, carrier) ∩ carrier := {
  take y : m;
  suppose y ∈ subset;
  y ∈ carrier by subsetInCarrier;
  choose radius such that
      radius > 0 ∧
        ∀ (z : m). z ∈ carrier →
          distance(y, z) < radius → z ∈ subset
      from openInCarrier;
  radius > 0;
  ∀ (z : m). z ∈ carrier →
      distance(y, z) < radius → z ∈ subset;
  distance(y, y)
     = 0 by MetricSpace.distance_self
     < radius;
  MetricSpace.BallWitness(subset, carrier, y, radius, y) as witnessHolds;
  y ∈ MetricSpace.openHull(subset, carrier)
      by { witness y with witness radius with witnessHolds };
  done
}

-- Backward: whatever the hull cuts out of the carrier was already in the
-- subset — that is precisely what each ball property says.
theorem MetricSpace.openHull_intersection_subset (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.openHull(subset, carrier) ∩ carrier ⊆ subset := {
  take y : m;
  suppose y ∈ MetricSpace.openHull(subset, carrier) ∩ carrier as inBoth;
  y ∈ MetricSpace.openHull(subset, carrier) as inHull;
  y ∈ carrier;
  choose x, radius such that
      MetricSpace.BallWitness(subset, carrier, x, radius, y) from inHull;
  ∀ (z : m). z ∈ carrier →
      distance(x, z) < radius → z ∈ subset
      by MetricSpace.BallWitness.ball_inside as ballProperty;
  distance(x, y) < radius by MetricSpace.BallWitness.reaches;
  done by ballProperty
}

theorem MetricSpace.OpenIn_cut_by_open (m : MetricSpace)
        (subset carrier : Set(m))
        (subsetInCarrier : subset ⊆ carrier)
        (openInCarrier : MetricSpace.OpenIn(subset, carrier))
        : subset = MetricSpace.openHull(subset, carrier) ∩ carrier := {
  subset ⊆ MetricSpace.openHull(subset, carrier) ∩ carrier
      by MetricSpace.subset_openHull_intersection;
  MetricSpace.openHull(subset, carrier) ∩ carrier ⊆ subset
      by MetricSpace.openHull_intersection_subset;
  done by Set.equal_of_same_members
}

-- The converse, and the direction consumers use to BUILD relatively open
-- sets: anything cut out of the carrier by an open set is open in it.
theorem MetricSpace.OpenIn_of_cut (m : MetricSpace)
        (subset carrier ambient : Set(m))
        (ambientOpen : MetricSpace.IsOpen(ambient))
        (cut : subset = ambient ∩ carrier)
        : MetricSpace.OpenIn(subset, carrier) := {
  take x : m;
  suppose x ∈ subset as xInSubset;
  x ∈ ambient ∩ carrier by substituting cut;
  x ∈ ambient;
  choose radius such that
      radius > 0 ∧
        ∀ (y : m). y ∈ Set.universe(m) →
          distance(x, y) < radius → y ∈ ambient
      from ambientOpen;
  radius > 0;
  ∀ (y : m). y ∈ Set.universe(m) →
      distance(x, y) < radius → y ∈ ambient as ambientBall;
  witness radius with {
    radius > 0;
    ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset
        by (y : m) (yInCarrier : y ∈ carrier)
           (yClose : distance(x, y) < radius) ↦ {
             y ∈ Set.universe(m);
             y ∈ ambient by ambientBall;
             y ∈ ambient ∩ carrier;
             done by substituting cut
           };
    done
  }
}

-- ----------------------------------------------------------------------
-- Interior, closure, boundary — all relative to the carrier.
--
-- The interior collects the points that have a ball to themselves; the
-- closure collects the points of the carrier that every ball reaches; the
-- boundary is what the closure has and the interior does not.

definition MetricSpace.InteriorIn {m : MetricSpace}
        (subset carrier : Set(m))
        : Set(m) :=
  (x : m) ↦ x ∈ subset ∧
    ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset

definition MetricSpace.ClosureIn {m : MetricSpace}
        (subset carrier : Set(m))
        : Set(m) :=
  (x : m) ↦ x ∈ carrier ∧
    ∀ (radius : ℝ). radius > 0 →
      ∃ (y : m). y ∈ subset ∧
        distance(x, y) < radius

definition MetricSpace.BoundaryIn {m : MetricSpace}
        (subset carrier : Set(m))
        : Set(m) :=
  MetricSpace.ClosureIn(subset, carrier) ∖ MetricSpace.InteriorIn(subset, carrier)

-- ----------------------------------------------------------------------
-- Interior.

theorem MetricSpace.InteriorIn_subset (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.InteriorIn(subset, carrier) ⊆ subset := {
  take x : m;
  suppose x ∈ MetricSpace.InteriorIn(subset, carrier) as inInterior;
  x ∈ subset;
  done
}

-- The interior is relatively open: shrink the radius by the distance
-- already travelled, exactly as for a ball.
theorem MetricSpace.InteriorIn_OpenIn (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.OpenIn(MetricSpace.InteriorIn(subset, carrier), carrier) := {
  take x : m;
  suppose x ∈ MetricSpace.InteriorIn(subset, carrier) as inInterior;
  x ∈ subset;
  ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset as hasBall;
  choose radius such that radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset
      from hasBall;
  radius > 0;
  ∀ (y : m). y ∈ carrier →
      distance(x, y) < radius → y ∈ subset as ballProperty;
  witness radius with {
    radius > 0;
    ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius →
          y ∈ MetricSpace.InteriorIn(subset, carrier)
        by (y : m) (yInCarrier : y ∈ carrier)
           (yClose : distance(x, y) < radius) ↦ {
             y ∈ subset by ballProperty;
             radius - distance(x, y) > 0;
             ∃ (smaller : ℝ). smaller > 0 ∧
                 ∀ (z : m). z ∈ carrier →
                   distance(y, z) < smaller → z ∈ subset
                 by { witness radius - distance(x, y) with {
                        radius - distance(x, y) > 0;
                        ∀ (z : m). z ∈ carrier →
                            distance(y, z)
                                < radius - distance(x, y)
                              → z ∈ subset
                            by (z : m) (zInCarrier : z ∈ carrier)
                               (zClose : distance(y, z)
                                   < radius - distance(x, y)) ↦ {
                                 distance(x, z)
                                    ≤ distance(x, y)
                                          + distance(y, z)
                                          by MetricSpace.distance_triangle
                                    < distance(x, y)
                                          + (radius - distance(x, y))
                                    = radius;
                                 done by ballProperty
                               };
                        done
                      } };
             done
           };
    done
  }
}

-- A relatively open subset is its own interior.
theorem MetricSpace.subset_InteriorIn_of_OpenIn (m : MetricSpace)
        (subset carrier : Set(m))
        (openInCarrier : MetricSpace.OpenIn(subset, carrier))
        : subset ⊆ MetricSpace.InteriorIn(subset, carrier) := {
  take x : m;
  suppose x ∈ subset as xInSubset;
  ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ subset
      by openInCarrier;
  done
}

-- ----------------------------------------------------------------------
-- Closure.

theorem MetricSpace.ClosureIn_subset_carrier (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.ClosureIn(subset, carrier) ⊆ carrier := {
  take x : m;
  suppose x ∈ MetricSpace.ClosureIn(subset, carrier) as inClosure;
  x ∈ carrier;
  done
}

-- A subset of the carrier lies in its own closure: the point itself is
-- the witness at every radius, since it is at distance zero from itself.
theorem MetricSpace.subset_ClosureIn (m : MetricSpace)
        (subset carrier : Set(m))
        (subsetInCarrier : subset ⊆ carrier)
        : subset ⊆ MetricSpace.ClosureIn(subset, carrier) := {
  take x : m;
  suppose x ∈ subset as xInSubset;
  x ∈ carrier by subsetInCarrier;
  ∀ (radius : ℝ). radius > 0 →
      ∃ (y : m). y ∈ subset ∧
        distance(x, y) < radius
      by (radius : ℝ) (radiusPositive : radius > 0) ↦ {
        distance(x, x)
           = 0 by MetricSpace.distance_self
           < radius;
        witness x with {
          x ∈ subset;
          distance(x, x) < radius;
          done
        }
      };
  done
}

-- ----------------------------------------------------------------------
-- Boundary.

theorem MetricSpace.BoundaryIn_subset_ClosureIn (m : MetricSpace)
        (subset carrier : Set(m))
        : MetricSpace.BoundaryIn(subset, carrier)
              ⊆ MetricSpace.ClosureIn(subset, carrier) := {
  take x : m;
  suppose x ∈ MetricSpace.BoundaryIn(subset, carrier) as onBoundary;
  x ∈ MetricSpace.ClosureIn(subset, carrier);
  done
}

-- For a relatively open subset the boundary is what the closure adds:
-- `∂U = closure(U) ∖ U`, because such a `U` is already its own interior.
theorem MetricSpace.BoundaryIn_of_OpenIn (m : MetricSpace)
        (subset carrier : Set(m))
        (openInCarrier : MetricSpace.OpenIn(subset, carrier))
        (x : m)
        (onBoundary : x ∈ MetricSpace.BoundaryIn(subset, carrier))
        : x ∈ MetricSpace.ClosureIn(subset, carrier) ∖ subset := {
  x ∈ MetricSpace.ClosureIn(subset, carrier);
  ¬(x ∈ MetricSpace.InteriorIn(subset, carrier));
  ¬(x ∈ subset)
      by (xInSubset : x ∈ subset) ↦ {
        x ∈ MetricSpace.InteriorIn(subset, carrier)
            by MetricSpace.subset_InteriorIn_of_OpenIn;
        done
      };
  done
}
