-- Metric/topology.math
--
-- The relative topology of a metric space. Developed once, over an
-- abstract `m : MetricSpace`, and read at every carrier that supplies an
-- instance.
--
-- Everything is stated RELATIVE to a region from the start, and the
-- absolute notions are the `region = universe` case. That is a
-- deliberate choice: connectedness gets applied to arcs and curves as
-- subspaces, and the model-curve parametrization needs
-- compact→Hausdorff on a subspace, so retrofitting relativisation would
-- cost more than paying for it once here.
--
-- `MetricSpace.OpenIn(subset, region)` does not require
-- `subset ⊆ region` — demanding it would add a proof obligation at every
-- use. Consumers that need the inclusion carry it separately. What every
-- relative notion below DOES insist on is that it speak about the TRACE
-- `subset ∩ region` and nothing else: a point outside the region is
-- neither tested for openness, nor in a relative interior, nor available
-- as a witness for a relative closure. Otherwise `ClosureIn({1, 1/2,
-- 1/3, …}, {0})` would contain `0` while the trace it is the closure of
-- is empty.

module Metric.topology

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Metric.space
import Metric.near

-- ----------------------------------------------------------------------
-- Open sets, relative to a region.

definition MetricSpace.OpenIn {m : MetricSpace}
        (subset region : Set(m)) : Proposition :=
  ∀ (x : m). x ∈ subset → x ∈ region →
    ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ region →
        distance(x, y) < radius → y ∈ subset

definition MetricSpace.IsOpen {m : MetricSpace}
        (subset : Set(m)) : Proposition :=
  MetricSpace.OpenIn(subset, Set.universe(m))

definition MetricSpace.ClosedIn {m : MetricSpace}
        (subset region : Set(m)) : Proposition :=
  MetricSpace.OpenIn(Set.difference(region, subset), region)

-- Openness in the whole space, read without the membership in the
-- universe that the relative form asks for and the absolute one gets for
-- free: an open set holds a whole ball around each of its points.
theorem MetricSpace.IsOpen.ball_inside {m : MetricSpace}
        (subset : Set(m)) (isOpen : MetricSpace.IsOpen(subset))
        (x : m) (inSubset : x ∈ subset)
        : ∃ (radius : ℝ). radius > 0 ∧
            ∀ (y : m). distance(x, y) < radius → y ∈ subset := {
  x ∈ Set.universe(m);
  choose radius such that
      radius > 0 ∧
        ∀ (y : m). y ∈ Set.universe(m) →
          distance(x, y) < radius → y ∈ subset
      from isOpen;
  radius > 0;
  ∀ (y : m). y ∈ Set.universe(m) →
      distance(x, y) < radius → y ∈ subset as ballInside;
  ∀ (y : m). distance(x, y) < radius → y ∈ subset
      by { take y : m;
           suppose distance(x, y) < radius;
           y ∈ Set.universe(m);
           done by ballInside };
  witness radius
}

theorem MetricSpace.IsOpen.near {m : MetricSpace}
        (subset : Set(m)) (isOpen : MetricSpace.IsOpen(subset))
        (x : m) (inSubset : x ∈ subset)
        : MetricSpace.Near(x, (y : m) ↦ y ∈ subset) :=
  unfold MetricSpace.Near in {
    ∃ (radius : ℝ). radius > 0 ∧
        ∀ (y : m). distance(x, y) < radius → y ∈ subset
        by MetricSpace.IsOpen.ball_inside;
    done
  }

theorem MetricSpace.IsOpen.of_ball_inside {m : MetricSpace}
        (subset : Set(m))
        (holdsBall : ∀ (x : m). x ∈ subset →
            ∃ (radius : ℝ). radius > 0 ∧
              ∀ (y : m). distance(x, y) < radius → y ∈ subset)
        : MetricSpace.IsOpen(subset) := {
  take x : m;
  suppose x ∈ subset;
  suppose x ∈ Set.universe(m);
  choose radius such that
      radius > 0 ∧ ∀ (y : m). distance(x, y) < radius → y ∈ subset
      from holdsBall;
  radius > 0;
  ∀ (y : m). distance(x, y) < radius → y ∈ subset as ballInside;
  ∀ (y : m). y ∈ Set.universe(m) →
      distance(x, y) < radius → y ∈ subset
      by { take y : m;
           suppose y ∈ Set.universe(m);
           suppose distance(x, y) < radius;
           done by ballInside };
  witness radius
}

-- ----------------------------------------------------------------------
-- The empty set, the whole space, and binary unions and intersections.
-- Each is the ε-ball argument a textbook gives. (Arbitrary unions wait
-- until something needs them; calling these the lattice laws before then
-- would claim more structure than is here.)

-- `OpenIn` through the RELATIVE SPATIAL FILTER: a set is relatively open
-- when, at each of its points, belonging to it holds near that point
-- WITHIN THE REGION. That is the same sentence the ε-ball definition
-- says, with the radius inside the filter — so combining two open sets
-- becomes one `for y sufficiently near x within region` and no minimum is
-- carried by hand.

theorem MetricSpace.OpenIn.near {m : MetricSpace}
        (subset region : Set(m))
        (isOpen : MetricSpace.OpenIn(subset, region))
        (x : m) (inSubset : x ∈ subset) (inRegion : x ∈ region)
        : MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset) := {
  ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ region → distance(x, y) < radius → y ∈ subset
      by isOpen;
  done by MetricSpace.NearWithin.of_ball
}

theorem MetricSpace.OpenIn.of_near {m : MetricSpace}
        (subset region : Set(m))
        (nearby : ∀ (x : m). x ∈ subset → x ∈ region →
            MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset))
        : MetricSpace.OpenIn(subset, region) := {
  take x : m;
  suppose x ∈ subset;
  suppose x ∈ region;
  MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset) by nearby;
  done by MetricSpace.NearWithin.ball
}

theorem MetricSpace.OpenIn.universe (m : MetricSpace)
        (region : Set(m))
        : MetricSpace.OpenIn(Set.universe(m), region) := {
  take x : m;
  suppose x ∈ Set.universe(m);
  suppose x ∈ region;
  witness (1 : ℝ) with {
    (1 : ℝ) > 0;
    ∀ (y : m). y ∈ region →
        distance(x, y) < 1 → y ∈ Set.universe(m)
        by (y : m) (yInRegion : y ∈ region)
           (yClose : distance(x, y) < 1) ↦
             Set.member_universe(y);
    done
  }
}

theorem MetricSpace.OpenIn.empty (m : MetricSpace)
        (region : Set(m))
        : MetricSpace.OpenIn(Set.empty(m), region) := {
  take x : m;
  suppose x ∈ Set.empty(m) as inEmpty;
  False by Set.not_member_empty;
  done
}

-- A binary intersection of relatively open sets is relatively open. The
-- filter takes the smaller of the two radii; no radius is named here.
theorem MetricSpace.OpenIn.intersection (m : MetricSpace)
        (left right region : Set(m))
        (leftOpen : MetricSpace.OpenIn(left, region))
        (rightOpen : MetricSpace.OpenIn(right, region))
        : MetricSpace.OpenIn(left ∩ right, region) := {
  ∀ (x : m). x ∈ left ∩ right → x ∈ region →
      MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ left ∩ right)
      by { take x : m;
           suppose x ∈ left ∩ right;
           suppose x ∈ region;
           x ∈ left;
           x ∈ right;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ left)
               by MetricSpace.OpenIn.near;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ right)
               by MetricSpace.OpenIn.near;
           for y sufficiently near x within region: {
             y ∈ left;
             y ∈ right;
             done
           } };
  done by MetricSpace.OpenIn.of_near
}

-- A union of two relatively open sets is relatively open: whichever side
-- the point came from holds nearby, and that side is inside the union.
theorem MetricSpace.OpenIn.union (m : MetricSpace)
        (left right region : Set(m))
        (leftOpen : MetricSpace.OpenIn(left, region))
        (rightOpen : MetricSpace.OpenIn(right, region))
        : MetricSpace.OpenIn(left ∪ right, region) := {
  ∀ (x : m). x ∈ left ∪ right → x ∈ region →
      MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ left ∪ right)
      by { take x : m;
           suppose x ∈ left ∪ right;
           suppose x ∈ region;
           done by cases {
             case x ∈ left: {
                 MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ left)
                     by MetricSpace.OpenIn.near;
                 for y sufficiently near x within region: {
                   y ∈ left;
                   done
                 }
               }
             case x ∈ right: {
                 MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ right)
                     by MetricSpace.OpenIn.near;
                 for y sufficiently near x within region: {
                   y ∈ right;
                   done
                 }
               }
           } };
  done by MetricSpace.OpenIn.of_near
}

-- ----------------------------------------------------------------------
-- Balls are open, which is what makes the definition worth having.

theorem MetricSpace.Ball_IsOpen (m : MetricSpace)
        (center : m) (radius : ℝ)
        : MetricSpace.IsOpen(MetricSpace.Ball(center, radius)) := {
  ∀ (x : m). x ∈ MetricSpace.Ball(center, radius) →
      ∃ (reach : ℝ). reach > 0 ∧
        ∀ (y : m). distance(x, y) < reach
          → y ∈ MetricSpace.Ball(center, radius)
      by { take x : m;
           suppose x ∈ MetricSpace.Ball(center, radius);
           distance(center, x) < radius;
           MetricSpace.Near(x,
               (y : m) ↦ y ∈ MetricSpace.Ball(center, radius))
               by MetricSpace.Near.inside_Ball;
           done by unfold MetricSpace.Near in { done } };
  done by MetricSpace.IsOpen.of_ball_inside
}

-- ----------------------------------------------------------------------
-- The textbook characterization: relatively open means "cut out of the
-- region by an open set". The pair at the end of this section —
-- `MetricSpace.OpenIn.cut_by_open` and `.of_cut_by_open` — is the whole
-- reader-facing statement, and the only thing a consumer should need.
--
-- Everything between here and there is the WITNESS MACHINERY that proves
-- the forward direction, kept only because the kernel needs a set to
-- point at. Do not state a theorem about `openHull` or `BallWitness`
-- outside this file.

-- Witness for the forward direction: the union of every ball the ε-ball
-- condition supplies. A comprehension, so no indexed unions are needed.
-- The conjunction is kept flat so that a proof builds it leg by leg.
definition MetricSpace.BallWitness {m : MetricSpace}
        (subset region : Set(m))
        (x : m) (radius : ℝ) (y : m)
        : Proposition :=
  x ∈ subset
  ∧ radius > 0
  ∧ (∀ (z : m). z ∈ region →
        distance(x, z) < radius → z ∈ subset)
  ∧ distance(x, y) < radius

-- The four legs, as citations. `BallWitness` is a definition, so a proof
-- that reaches into a folded witness pays a δ-unfolding at every
-- projection; these pay it once each, and the use sites then say which
-- leg they are using.
theorem MetricSpace.BallWitness.center_inside (m : MetricSpace)
        (subset region : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, region, x, radius, y))
        : x ∈ subset :=
  unfold MetricSpace.BallWitness in { x ∈ subset; done }

theorem MetricSpace.BallWitness.radius_positive (m : MetricSpace)
        (subset region : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, region, x, radius, y))
        : radius > 0 :=
  unfold MetricSpace.BallWitness in { radius > 0; done }

theorem MetricSpace.BallWitness.ball_inside (m : MetricSpace)
        (subset region : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, region, x, radius, y))
        : ∀ (z : m). z ∈ region →
              distance(x, z) < radius → z ∈ subset :=
  unfold MetricSpace.BallWitness in {
    ∀ (z : m). z ∈ region →
        distance(x, z) < radius → z ∈ subset;
    done
  }

theorem MetricSpace.BallWitness.reaches (m : MetricSpace)
        (subset region : Set(m))
        (x : m) (radius : ℝ) (y : m)
        (holds : MetricSpace.BallWitness(subset, region, x, radius, y))
        : distance(x, y) < radius :=
  unfold MetricSpace.BallWitness in { distance(x, y) < radius; done }

definition MetricSpace.openHull {m : MetricSpace}
        (subset region : Set(m))
        : Set(m) :=
  (y : m) ↦
    ∃ (x : m). ∃ (radius : ℝ).
      MetricSpace.BallWitness(subset, region, x, radius, y)

theorem MetricSpace.openHull_IsOpen (m : MetricSpace)
        (subset region : Set(m))
        : MetricSpace.IsOpen(MetricSpace.openHull(subset, region)) := {
  ∀ (y : m). y ∈ MetricSpace.openHull(subset, region) →
      ∃ (reach : ℝ). reach > 0 ∧
        ∀ (w : m). distance(y, w) < reach
          → w ∈ MetricSpace.openHull(subset, region)
      by { take y : m;
           suppose y ∈ MetricSpace.openHull(subset, region) as inHull;
           choose x, radius such that
               MetricSpace.BallWitness(subset, region, x, radius, y) from inHull;
           x ∈ subset by MetricSpace.BallWitness.center_inside;
           radius > 0 by MetricSpace.BallWitness.radius_positive;
           ∀ (z : m). z ∈ region →
               distance(x, z) < radius → z ∈ subset
               by MetricSpace.BallWitness.ball_inside;
           distance(x, y) < radius by MetricSpace.BallWitness.reaches;
           -- Every point of the ball `y` sits in carries the same witness.
           MetricSpace.Near(y, (w : m) ↦ w ∈ MetricSpace.Ball(x, radius))
               by MetricSpace.Near.inside_Ball;
           MetricSpace.Near(y,
               (w : m) ↦ w ∈ MetricSpace.openHull(subset, region))
               by { for w sufficiently near y: {
                      distance(x, w) < radius;
                      MetricSpace.BallWitness(subset, region, x, radius, w)
                          as witnessHolds;
                      witness x with witness radius with witnessHolds
                    } };
           done by unfold MetricSpace.Near in { done } };
  done by MetricSpace.IsOpen.of_ball_inside
}

-- The hull cuts the region along exactly the trace of the subset: every
-- point of the trace is the center of one of its balls, and every ball is
-- inside the subset wherever it meets the region.
theorem MetricSpace.openHull_cuts_the_trace (m : MetricSpace)
        (subset region : Set(m))
        (openInRegion : MetricSpace.OpenIn(subset, region))
        : subset ∩ region = MetricSpace.openHull(subset, region) ∩ region := {
  subset ∩ region ⊆ MetricSpace.openHull(subset, region) ∩ region
      by (y : m) (inTrace : y ∈ subset ∩ region) ↦ {
        y ∈ subset;
        y ∈ region;
        choose radius such that
            radius > 0 ∧
              ∀ (z : m). z ∈ region →
                distance(y, z) < radius → z ∈ subset
            from openInRegion;
        radius > 0;
        ∀ (z : m). z ∈ region →
            distance(y, z) < radius → z ∈ subset;
        distance(y, y)
           = 0 by MetricSpace.distance_self
           < radius;
        MetricSpace.BallWitness(subset, region, y, radius, y) as witnessHolds;
        y ∈ MetricSpace.openHull(subset, region)
            by { witness y with witness radius with witnessHolds };
        done
      };
  MetricSpace.openHull(subset, region) ∩ region ⊆ subset ∩ region
      by (y : m)
         (inBoth : y ∈ MetricSpace.openHull(subset, region) ∩ region) ↦ {
        y ∈ MetricSpace.openHull(subset, region) as inHull;
        y ∈ region;
        choose x, radius such that
            MetricSpace.BallWitness(subset, region, x, radius, y) from inHull;
        ∀ (z : m). z ∈ region →
            distance(x, z) < radius → z ∈ subset
            by MetricSpace.BallWitness.ball_inside as ballProperty;
        distance(x, y) < radius by MetricSpace.BallWitness.reaches;
        y ∈ subset by ballProperty;
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The characterization itself, in both directions. `S` is open in `C`
-- exactly when some open `U` cuts `C` along `S`.

theorem MetricSpace.OpenIn.cut_by_open (m : MetricSpace)
        (subset region : Set(m))
        (openInRegion : MetricSpace.OpenIn(subset, region))
        : ∃ (cuttingSet : Set(m)). MetricSpace.IsOpen(cuttingSet)
            ∧ subset ∩ region = cuttingSet ∩ region := {
  MetricSpace.IsOpen(MetricSpace.openHull(subset, region))
      by MetricSpace.openHull_IsOpen;
  subset ∩ region = MetricSpace.openHull(subset, region) ∩ region
      by MetricSpace.openHull_cuts_the_trace;
  witness MetricSpace.openHull(subset, region)
}

-- With the inclusion in hand the trace is the subset itself, which is how
-- a text states it.
theorem MetricSpace.OpenIn.cut_out_of_region (m : MetricSpace)
        (subset region : Set(m))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : MetricSpace.OpenIn(subset, region))
        : ∃ (cuttingSet : Set(m)). MetricSpace.IsOpen(cuttingSet)
            ∧ subset = cuttingSet ∩ region := {
  subset ∩ region = subset by Set.intersection_of_subset;
  ∃ (cuttingSet : Set(m)). MetricSpace.IsOpen(cuttingSet)
      ∧ subset ∩ region = cuttingSet ∩ region
      by MetricSpace.OpenIn.cut_by_open;
  choose cuttingSet such that MetricSpace.IsOpen(cuttingSet)
      ∧ subset ∩ region = cuttingSet ∩ region;
  MetricSpace.IsOpen(cuttingSet);
  subset = cuttingSet ∩ region by substituting (subset ∩ region = subset);
  witness cuttingSet
}

-- The converse, and the direction consumers use to BUILD relatively open
-- sets: anything cut out of the region by an open set is open in it.
theorem MetricSpace.OpenIn_of_cut (m : MetricSpace)
        (subset region cuttingSet : Set(m))
        (cuttingSetOpen : MetricSpace.IsOpen(cuttingSet))
        (cut : subset ∩ region = cuttingSet ∩ region)
        : MetricSpace.OpenIn(subset, region) := {
  ∀ (x : m). x ∈ subset → x ∈ region →
      MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset)
      by { take x : m;
           suppose x ∈ subset;
           suppose x ∈ region;
           x ∈ subset ∩ region;
           x ∈ cuttingSet ∩ region by substituting cut;
           x ∈ cuttingSet;
           MetricSpace.Near(x, (y : m) ↦ y ∈ cuttingSet)
               by MetricSpace.IsOpen.near;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ cuttingSet)
               by MetricSpace.NearWithin.of_everywhere;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ region)
               by MetricSpace.NearWithin.in_region;
           for y sufficiently near x within region: {
             y ∈ cuttingSet;
             y ∈ region;
             y ∈ cuttingSet ∩ region;
             y ∈ subset ∩ region by substituting cut;
             done
           } };
  done by MetricSpace.OpenIn.of_near
}

theorem MetricSpace.OpenIn.of_cut_by_open (m : MetricSpace)
        (subset region : Set(m))
        (cutOut : ∃ (cuttingSet : Set(m)). MetricSpace.IsOpen(cuttingSet)
            ∧ subset ∩ region = cuttingSet ∩ region)
        : MetricSpace.OpenIn(subset, region) := {
  choose cuttingSet such that MetricSpace.IsOpen(cuttingSet)
      ∧ subset ∩ region = cuttingSet ∩ region from cutOut;
  MetricSpace.IsOpen(cuttingSet);
  subset ∩ region = cuttingSet ∩ region;
  done by MetricSpace.OpenIn_of_cut
}

-- ----------------------------------------------------------------------
-- Interior, closure, boundary — all relative to the region.
--
-- The interior collects the points that have a ball to themselves; the
-- closure collects the points of the region that every ball reaches; the
-- boundary is what the closure has and the interior does not.

definition MetricSpace.InteriorIn {m : MetricSpace}
        (subset region : Set(m))
        : Set(m) :=
  (x : m) ↦ x ∈ region ∧ x ∈ subset ∧
    ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ region →
        distance(x, y) < radius → y ∈ subset

definition MetricSpace.ClosureIn {m : MetricSpace}
        (subset region : Set(m))
        : Set(m) :=
  (x : m) ↦ x ∈ region ∧
    ∀ (radius : ℝ). radius > 0 →
      ∃ (y : m). y ∈ region ∧ y ∈ subset ∧
        distance(x, y) < radius

definition MetricSpace.BoundaryIn {m : MetricSpace}
        (subset region : Set(m))
        : Set(m) :=
  MetricSpace.ClosureIn(subset, region) ∖ MetricSpace.InteriorIn(subset, region)

-- ----------------------------------------------------------------------
-- Interior.

theorem MetricSpace.InteriorIn_subset (m : MetricSpace)
        (subset region : Set(m))
        : MetricSpace.InteriorIn(subset, region) ⊆ subset := {
  take x : m;
  suppose x ∈ MetricSpace.InteriorIn(subset, region) as inInterior;
  x ∈ subset;
  done
}

-- The interior, in the filter's words: a point of the interior is a point
-- of the region at which membership of the subset holds near it, within
-- the region. Every proof below argues through this pair.

theorem MetricSpace.InteriorIn.near (m : MetricSpace)
        (subset region : Set(m)) (x : m)
        (inInterior : x ∈ MetricSpace.InteriorIn(subset, region))
        : MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset) := {
  ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ region → distance(x, y) < radius → y ∈ subset;
  done by MetricSpace.NearWithin.of_ball
}

theorem MetricSpace.InteriorIn.of_near (m : MetricSpace)
        (subset region : Set(m)) (x : m) (inRegion : x ∈ region)
        (nearby : MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset))
        : x ∈ MetricSpace.InteriorIn(subset, region) := {
  x ∈ subset by MetricSpace.NearWithin.at_center;
  ∃ (radius : ℝ). radius > 0 ∧
      ∀ (y : m). y ∈ region → distance(x, y) < radius → y ∈ subset
      by MetricSpace.NearWithin.ball;
  done
}

-- The interior is relatively open: what holds near a point within the
-- region holds near every point near it, which is exactly what being in
-- the interior asks of those points.
theorem MetricSpace.InteriorIn_OpenIn (m : MetricSpace)
        (subset region : Set(m))
        : MetricSpace.OpenIn(MetricSpace.InteriorIn(subset, region), region) := {
  ∀ (x : m). x ∈ MetricSpace.InteriorIn(subset, region) → x ∈ region →
      MetricSpace.NearWithin(x, region,
          (y : m) ↦ y ∈ MetricSpace.InteriorIn(subset, region))
      by { take x : m;
           suppose x ∈ MetricSpace.InteriorIn(subset, region);
           suppose x ∈ region;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset)
               by MetricSpace.InteriorIn.near;
           MetricSpace.NearWithin(x, region, (y : m) ↦
               MetricSpace.NearWithin(y, region, (z : m) ↦ z ∈ subset))
               by MetricSpace.NearWithin.nearby;
           MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ region)
               by MetricSpace.NearWithin.in_region;
           for y sufficiently near x within region: {
             MetricSpace.NearWithin(y, region, (z : m) ↦ z ∈ subset);
             y ∈ region;
             done by MetricSpace.InteriorIn.of_near
           } };
  done by MetricSpace.OpenIn.of_near
}

-- A relatively open subset of the region is its own interior.
theorem MetricSpace.subset_InteriorIn_of_OpenIn (m : MetricSpace)
        (subset region : Set(m))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : MetricSpace.OpenIn(subset, region))
        : subset ⊆ MetricSpace.InteriorIn(subset, region) := {
  take x : m;
  suppose x ∈ subset as xInSubset;
  x ∈ region by subsetInRegion;
  MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ subset)
      by MetricSpace.OpenIn.near;
  done by MetricSpace.InteriorIn.of_near
}

-- ----------------------------------------------------------------------
-- Closure.

theorem MetricSpace.ClosureIn_subset_region (m : MetricSpace)
        (subset region : Set(m))
        : MetricSpace.ClosureIn(subset, region) ⊆ region := {
  take x : m;
  suppose x ∈ MetricSpace.ClosureIn(subset, region) as inClosure;
  x ∈ region;
  done
}

-- A subset of the region lies in its own closure: the point itself is
-- the witness at every radius, since it is at distance zero from itself.
theorem MetricSpace.subset_ClosureIn (m : MetricSpace)
        (subset region : Set(m))
        (subsetInRegion : subset ⊆ region)
        : subset ⊆ MetricSpace.ClosureIn(subset, region) := {
  take x : m;
  suppose x ∈ subset as xInSubset;
  x ∈ region by subsetInRegion;
  ∀ (radius : ℝ). radius > 0 →
      ∃ (y : m). y ∈ region ∧ y ∈ subset ∧
        distance(x, y) < radius
      by (radius : ℝ) (radiusPositive : radius > 0) ↦ {
        distance(x, x)
           = 0 by MetricSpace.distance_self
           < radius;
        witness x with {
          x ∈ region;
          x ∈ subset;
          distance(x, x) < radius;
          done
        }
      };
  done
}

-- ----------------------------------------------------------------------
-- Boundary.

theorem MetricSpace.BoundaryIn_subset_ClosureIn (m : MetricSpace)
        (subset region : Set(m))
        : MetricSpace.BoundaryIn(subset, region)
              ⊆ MetricSpace.ClosureIn(subset, region) := {
  take x : m;
  suppose x ∈ MetricSpace.BoundaryIn(subset, region) as onBoundary;
  x ∈ MetricSpace.ClosureIn(subset, region);
  done
}

-- For a relatively open subset the boundary is what the closure adds:
-- `∂U = closure(U) ∖ U`, because such a `U` is exactly its own interior.
theorem MetricSpace.BoundaryIn_eq_ClosureIn_difference (m : MetricSpace)
        (subset region : Set(m))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : MetricSpace.OpenIn(subset, region))
        : MetricSpace.BoundaryIn(subset, region)
              = MetricSpace.ClosureIn(subset, region) ∖ subset := {
  subset ⊆ MetricSpace.InteriorIn(subset, region)
      by MetricSpace.subset_InteriorIn_of_OpenIn;
  MetricSpace.InteriorIn(subset, region) ⊆ subset
      by MetricSpace.InteriorIn_subset;
  MetricSpace.BoundaryIn(subset, region)
      ⊆ MetricSpace.ClosureIn(subset, region) ∖ subset
      by (x : m)
         (onBoundary : x ∈ MetricSpace.BoundaryIn(subset, region)) ↦ {
        x ∈ MetricSpace.ClosureIn(subset, region);
        ¬(x ∈ MetricSpace.InteriorIn(subset, region));
        ¬(x ∈ subset)
            by (xInSubset : x ∈ subset) ↦ {
              x ∈ MetricSpace.InteriorIn(subset, region);
              done
            };
        done
      };
  MetricSpace.ClosureIn(subset, region) ∖ subset
      ⊆ MetricSpace.BoundaryIn(subset, region)
      by (x : m)
         (inClosureOnly : x ∈ MetricSpace.ClosureIn(subset, region) ∖ subset) ↦ {
        x ∈ MetricSpace.ClosureIn(subset, region);
        ¬(x ∈ subset);
        ¬(x ∈ MetricSpace.InteriorIn(subset, region))
            by (inInterior : x ∈ MetricSpace.InteriorIn(subset, region)) ↦ {
              x ∈ subset;
              done
            };
        done
      };
  done by Set.equal_of_same_members
}
