-- Metric/real.math
--
-- The real line as a metric space, `distance(x, y) = |x - y|`. Registering
-- it as the canonical `MetricSpace` for ℝ is what lets `OpenIn`,
-- `ContinuousOn` and the rest be read at a bare `Set(ℝ)` — in particular
-- at the unit interval, the natural domain of a parametrised curve.

module Metric.real

import Logic.basics
import Equality.basics
import Real.interface
import Real.order
import Real.order_field
import Real.absolute_value
import Real.absolute_value_order
import Natural.basics
import Natural.order
import Natural.eventually
import Real.convergence
import Real.continuity
import Set.basics
import Set.algebra
import Metric.space
import Metric.sequence
import Metric.topology
import Metric.continuity

definition Real.distance (x y : ℝ) : ℝ := abs(x - y)

theorem Real.is_metric : IsMetric(ℝ, Real.distance) := {
  ∀ (x : ℝ). Real.distance(x, x) = 0
      by { take x : ℝ;
           Real.distance(x, x)
              = abs(x - x)
              = abs((0 : ℝ))
              = 0;
           done };
  ∀ (x y : ℝ). Real.distance(x, y) = 0 → x = y
      by { take x : ℝ;
           take y : ℝ;
           suppose Real.distance(x, y) = 0 as vanishes;
           abs(x - y) = 0;
           x - y = 0 by { suppose ¬(x - y = 0) for contradiction;
                          abs(x - y) > 0 by Real.absolute_value_positive;
                          done } as differenceVanishes;
           x = (x - y) + y
             = 0 + y by substituting differenceVanishes
             = y;
           done };
  ∀ (x y : ℝ). Real.distance(x, y) = Real.distance(y, x)
      by { take x : ℝ;
           take y : ℝ;
           Real.distance(x, y)
              = abs(x - y)
              = abs(y - x) by Real.absolute_value_subtract_swap
              = Real.distance(y, x);
           done };
  ∀ (x y z : ℝ). Real.distance(x, z) ≤ Real.distance(x, y) + Real.distance(y, z)
      by { take x : ℝ;
           take y : ℝ;
           take z : ℝ;
           Real.distance(x, z)
              = abs(x - z)
              = abs((x - y) + (y - z))
              ≤ abs(x - y) + abs(y - z) by Real.triangle_inequality
              = Real.distance(x, y) + Real.distance(y, z);
           done };
  done
}

definition Real.metricSpace : MetricSpace :=
  MetricSpace.make(ℝ, Real.distance, Real.is_metric)

instance Real.metricSpace

-- The distance projection at ℝ IS the absolute value of the difference.
-- Consumers state the arithmetic form and this bridges it.
theorem Real.metric_distance (x y : ℝ)
        : MetricSpace.distance(x, y) = abs(x - y) :=
  reflexivity(ℝ, abs(x - y))

-- ----------------------------------------------------------------------
-- Convergence on the line, read either way. `Real.SequenceConverges`
-- measures the gap as `|s(k) - limit|` and the metric one as
-- `distance(limit, s(k))`; the two are the same number, and these carry
-- a fact from one spelling to the other.

theorem Real.metric_SequenceConverges (s : ℕ → ℝ) (limit : ℝ)
        (converges : Real.SequenceConverges(s, limit))
        : MetricSpace.SequenceConverges(s, limit) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose threshold such that
      ∀ (k : ℕ). threshold ≤ k → abs(s(k) - limit) < tolerance
      as closeBeyond from converges;
  witness threshold with
      (k : ℕ) (beyond : threshold ≤ k) ↦ {
        abs(s(k) - limit) < tolerance by closeBeyond;
        MetricSpace.distance(limit, s(k))
           = abs(limit - s(k))
           = abs(s(k) - limit) by Real.absolute_value_subtract_swap
           < tolerance;
        done
      }
}

theorem Real.SequenceConverges.of_metric (s : ℕ → ℝ) (limit : ℝ)
        (converges : MetricSpace.SequenceConverges(s, limit))
        : Real.SequenceConverges(s, limit) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose threshold such that
      ∀ (k : ℕ). threshold ≤ k → MetricSpace.distance(limit, s(k)) < tolerance
      as closeBeyond from converges;
  witness threshold with
      (k : ℕ) (beyond : threshold ≤ k) ↦ {
        MetricSpace.distance(limit, s(k)) < tolerance by closeBeyond;
        abs(s(k) - limit)
           = abs(limit - s(k)) by Real.absolute_value_subtract_swap
           = MetricSpace.distance(limit, s(k))
           < tolerance;
        done
      }
}

-- ----------------------------------------------------------------------
-- Continuity on the line, read either way. `Real.ContinuousAt` is the
-- unrestricted ε-δ statement — no carrier — so its metric reading is the
-- generic notion taken over the whole line. As with the distance itself
-- the two say the same thing about the same numbers; only the order of
-- the subtraction differs.

theorem Real.metric_ContinuousAt (f : ℝ → ℝ) (x : ℝ)
        (continuous : Real.ContinuousAt(f, x))
        : MetricSpace.ContinuousAt(f, Set.universe(ℝ), x) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that
      nearness > 0 ∧ ∀ (y : ℝ). abs(y - x) < nearness → abs(f(y) - f(x)) < tolerance
      as closeNearby from continuous;
  nearness > 0;
  ∀ (y : ℝ). y ∈ Set.universe(ℝ) → MetricSpace.distance(x, y) < nearness
        → MetricSpace.distance(f(x), f(y)) < tolerance
      by { take y : ℝ;
           suppose y ∈ Set.universe(ℝ);
           suppose MetricSpace.distance(x, y) < nearness;
           abs(y - x)
              = abs(x - y)
              = MetricSpace.distance(x, y)
              < nearness;
           abs(f(y) - f(x)) < tolerance by closeNearby;
           MetricSpace.distance(f(x), f(y))
              = abs(f(x) - f(y))
              = abs(f(y) - f(x))
              < tolerance;
           done };
  witness nearness
}

theorem Real.ContinuousAt.of_metric (f : ℝ → ℝ) (x : ℝ)
        (continuous : MetricSpace.ContinuousAt(f, Set.universe(ℝ), x))
        : Real.ContinuousAt(f, x) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that
      nearness > 0 ∧ ∀ (y : ℝ). y ∈ Set.universe(ℝ) →
        MetricSpace.distance(x, y) < nearness →
          MetricSpace.distance(f(x), f(y)) < tolerance
      as closeNearby from continuous;
  nearness > 0;
  ∀ (y : ℝ). abs(y - x) < nearness → abs(f(y) - f(x)) < tolerance
      by { take y : ℝ;
           suppose abs(y - x) < nearness;
           y ∈ Set.universe(ℝ);
           MetricSpace.distance(x, y)
              = abs(x - y)
              = abs(y - x)
              < nearness;
           MetricSpace.distance(f(x), f(y)) < tolerance by closeNearby;
           abs(f(y) - f(x))
              = abs(f(x) - f(y))
              = MetricSpace.distance(f(x), f(y))
              < tolerance;
           done };
  witness nearness
}

-- Continuity at every point of a region — the ambient, carrier-free
-- notion the analysis layer states its hypotheses in — is the generic
-- notion relative to that region. Only the points of the region are left
-- to test, so the same nearness serves.
theorem Real.metric_ContinuousOn (f : ℝ → ℝ) (region : Set(ℝ))
        (continuous : ∀ (x : ℝ). x ∈ region → Real.ContinuousAt(f, x))
        : MetricSpace.ContinuousOn(f, region) := {
  take x : ℝ;
  suppose x ∈ region;
  Real.ContinuousAt(f, x);
  MetricSpace.ContinuousAt(f, Set.universe(ℝ), x) by Real.metric_ContinuousAt;
  region ⊆ Set.universe(ℝ) by Set.subset_universe;
  done by MetricSpace.ContinuousAt.restrict
}

-- The analysis layer states continuity on an interval by its endpoints
-- (`Real.ContinuousOn(f, a, b)`), not by a set. Any region inside those
-- endpoints therefore carries the generic notion — this is the form
-- `Real/intermediate_value.math` and `Real/derivative.math` can be read
-- through without restating their hypotheses.
theorem Real.metric_ContinuousOn_interval
        (f : ℝ → ℝ) (a b : ℝ) (region : Set(ℝ))
        (inside : ∀ (x : ℝ). x ∈ region → a ≤ x ∧ x ≤ b)
        (continuous : Real.ContinuousOn(f, a, b))
        : MetricSpace.ContinuousOn(f, region) := {
  ∀ (x : ℝ). x ∈ region → Real.ContinuousAt(f, x)
      by { take x : ℝ;
           suppose x ∈ region;
           done by continuous };
  done by Real.metric_ContinuousOn
}
