-- Metric/near.math
--
-- "Near x": the property holds on some ball around x. This is the spatial
-- twin of `Natural.Eventually` — the same four moves (a property that
-- always holds holds near x; two near-facts hold together near x; a
-- near-fact weakens pointwise; what holds near x holds somewhere), with
-- the minimum of two radii playing the part the maximum of two thresholds
-- plays for sequences.
--
-- UNPUNCTURED: `y = x` is included. That is what `ContinuousAt` and
-- `HasDerivativeAt` want, and it makes the filter proper with no side
-- condition — `x` itself is in every ball, so `holds_somewhere` needs
-- nothing. The punctured filter (`0 < distance(x, y) < radius`), which a
-- limit OF A FUNCTION at a point needs, is a separate notion rather than a
-- variant of this one: it is proper only at a non-isolated point, and
-- every theorem below would acquire that hypothesis.

module Metric.near

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.minimum
import Metric.space
import Metric.topology
import Metric.continuity

-- P holds throughout some ball around x.
-- OPAQUE: consumers use the four lemmas below, never the ∃-body. That is
-- also what keeps the `for y sufficiently near x: { … }` scope working —
-- a transparent definition gets δ-reduced away by ∀-peeling before the
-- scope can recognise its own goal.
opaque definition MetricSpace.Near {m : MetricSpace} (x : m)
        (P : m → Proposition) : Proposition :=
  ∃ (radius : ℝ). radius > 0 ∧
    ∀ (y : m). MetricSpace.distance(x, y) < radius → P(y)

-- A property that always holds, holds near x (any radius will do).
theorem MetricSpace.Near.of_always {m : MetricSpace} (x : m)
        (P : m → Proposition) (always : ∀ (y : m). P(y))
        : MetricSpace.Near(x, P) :=
  unfold MetricSpace.Near in {
  (1 : ℝ) > 0;
  ∀ (y : m). MetricSpace.distance(x, y) < 1 → P(y)
      by { take y : m;
           suppose MetricSpace.distance(x, y) < 1;
           done by always };
  witness (1 : ℝ)
}

-- ∧-closure: two near-facts hold together on the smaller of the two
-- balls. This is the lemma that makes the δ₁/δ₂/min bookkeeping of every
-- ε-δ argument invisible, exactly as `Eventually.and` does with max.
theorem MetricSpace.Near.and {m : MetricSpace} (x : m)
        (P Q : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (nearQ : MetricSpace.Near(x, Q))
        : MetricSpace.Near(x, (y : m) ↦ P(y) ∧ Q(y)) :=
  unfold MetricSpace.Near in {
  choose radiusP such that
      radiusP > 0 ∧ ∀ (y : m). MetricSpace.distance(x, y) < radiusP → P(y)
      from nearP;
  choose radiusQ such that
      radiusQ > 0 ∧ ∀ (y : m). MetricSpace.distance(x, y) < radiusQ → Q(y)
      from nearQ;
  radiusP > 0;
  radiusQ > 0;
  min(radiusP, radiusQ) > 0 by Real.minimum_positive;
  ∀ (y : m). MetricSpace.distance(x, y) < min(radiusP, radiusQ)
        → P(y) ∧ Q(y)
      by { take y : m;
           suppose MetricSpace.distance(x, y) < min(radiusP, radiusQ);
           min(radiusP, radiusQ) ≤ radiusP;
           min(radiusP, radiusQ) ≤ radiusQ;
           MetricSpace.distance(x, y) < min(radiusP, radiusQ) ≤ radiusP;
           MetricSpace.distance(x, y) < min(radiusP, radiusQ) ≤ radiusQ;
           P(y);
           Q(y);
           done };
  witness min(radiusP, radiusQ)
}

-- Monotone: a near-fact weakens pointwise.
theorem MetricSpace.Near.monotone {m : MetricSpace} (x : m)
        (P Q : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (pointwise : ∀ (y : m). P(y) → Q(y))
        : MetricSpace.Near(x, Q) :=
  unfold MetricSpace.Near in {
  choose radius such that
      radius > 0 ∧ ∀ (y : m). MetricSpace.distance(x, y) < radius → P(y)
      from nearP;
  radius > 0;
  ∀ (y : m). MetricSpace.distance(x, y) < radius → Q(y)
      by { take y : m;
           suppose MetricSpace.distance(x, y) < radius;
           P(y);
           done by pointwise };
  witness radius
}

-- The filter is proper: what holds near x holds AT x. Unpunctured, so
-- this needs no non-isolated-point hypothesis — the centre is in every
-- ball because `distance(x, x) = 0`.
theorem MetricSpace.Near.at_centre {m : MetricSpace} (x : m)
        (P : m → Proposition) (nearP : MetricSpace.Near(x, P))
        : P(x) :=
  unfold MetricSpace.Near in {
  choose radius such that
      radius > 0 ∧ ∀ (y : m). MetricSpace.distance(x, y) < radius → P(y)
      from nearP;
  radius > 0;
  MetricSpace.distance(x, x) = 0 by MetricSpace.distance_self;
  MetricSpace.distance(x, x)
     = 0
     < radius;
  done
}

theorem MetricSpace.Near.holds_somewhere {m : MetricSpace} (x : m)
        (P : m → Proposition) (nearP : MetricSpace.Near(x, P))
        : ∃ (y : m). P(y) :=
  unfold MetricSpace.Near in {
  P(x) by MetricSpace.Near.at_centre;
  witness x
}

-- Hence nothing is false throughout a ball — the shape an ε-δ argument by
-- contradiction ends on, mirroring `Eventually.not_eventually_false`.
theorem MetricSpace.Near.not_false_nearby {m : MetricSpace} (x : m)
        (nearFalse : MetricSpace.Near(x, (y : m) ↦ False))
        : False :=
  unfold MetricSpace.Near in { done by MetricSpace.Near.at_centre }

-- ----------------------------------------------------------------------
-- Continuity, read through the filter. This is the point of the notion:
-- "f is continuous at x" is "for every tolerance, f(y) is within it for y
-- near x" — the ε-δ statement with the δ, and its bookkeeping, inside
-- `Near`.

theorem MetricSpace.ContinuousAt.of_near {source target : MetricSpace}
        (f : source → target) (x : source)
        (nearby : ∀ (tolerance : ℝ). tolerance > 0 →
            MetricSpace.Near(x,
                (y : source) ↦ MetricSpace.distance(f(x), f(y)) < tolerance))
        : MetricSpace.ContinuousAt(f, Set.universe(source), x) :=
  unfold MetricSpace.Near in {
  take tolerance : ℝ;
  suppose tolerance > 0;
  MetricSpace.Near(x,
      (y : source) ↦ MetricSpace.distance(f(x), f(y)) < tolerance)
      by nearby;
  choose radius such that radius > 0 ∧
      ∀ (y : source). MetricSpace.distance(x, y) < radius →
        MetricSpace.distance(f(x), f(y)) < tolerance;
  radius > 0;
  ∀ (y : source). y ∈ Set.universe(source) →
      MetricSpace.distance(x, y) < radius →
        MetricSpace.distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose y ∈ Set.universe(source);
           suppose MetricSpace.distance(x, y) < radius;
           done };
  witness radius
}

theorem MetricSpace.ContinuousAt.near {source target : MetricSpace}
        (f : source → target) (x : source)
        (continuous : MetricSpace.ContinuousAt(f, Set.universe(source), x))
        (tolerance : ℝ) (tolerancePositive : tolerance > 0)
        : MetricSpace.Near(x,
              (y : source) ↦ MetricSpace.distance(f(x), f(y)) < tolerance) :=
  unfold MetricSpace.Near in {
  choose radius such that radius > 0 ∧
      ∀ (y : source). y ∈ Set.universe(source) →
        MetricSpace.distance(x, y) < radius →
          MetricSpace.distance(f(x), f(y)) < tolerance
      from continuous;
  radius > 0;
  ∀ (y : source). MetricSpace.distance(x, y) < radius →
      MetricSpace.distance(f(x), f(y)) < tolerance
      by { take y : source;
           suppose MetricSpace.distance(x, y) < radius;
           y ∈ Set.universe(source);
           done };
  witness radius
}
