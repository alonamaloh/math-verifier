-- Metric/near.math
--
-- "Near x": the property holds on some ball around x. This is the spatial
-- twin of `Natural.Eventually` — the same four moves (a property that
-- always holds holds near x; two near-facts hold together near x; a
-- near-fact weakens pointwise; what holds near x holds somewhere), with
-- the minimum of two radii playing the part the maximum of two thresholds
-- plays for sequences.
--
-- UNPUNCTURED: `y = x` is included. That is what `ContinuousAt` and
-- `HasDerivativeAt` want, and it makes the filter proper with no side
-- condition — `x` itself is in every ball, so `holds_somewhere` needs
-- nothing. The punctured filter (`0 < distance(x, y) < radius`), which a
-- limit OF A FUNCTION at a point needs, is a separate notion rather than a
-- variant of this one: it is proper only at a non-isolated point, and
-- every theorem below would acquire that hypothesis.

module Metric.near

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.minimum
import Metric.space

-- P holds throughout some ball around x.
-- OPAQUE: consumers use the four lemmas below, never the ∃-body. That is
-- also what keeps the `for y sufficiently near x: { … }` scope working —
-- a transparent definition gets δ-reduced away by ∀-peeling before the
-- scope can recognise its own goal.
opaque definition MetricSpace.Near {m : MetricSpace} (x : m)
        (P : m → Proposition) : Proposition :=
  ∃ (radius : ℝ). radius > 0 ∧
    ∀ (y : m). distance(x, y) < radius → P(y)

-- A property that always holds, holds near x (any radius will do).
theorem MetricSpace.Near.of_always {m : MetricSpace} (x : m)
        (P : m → Proposition) (always : ∀ (y : m). P(y))
        : MetricSpace.Near(x, P) :=
  unfold MetricSpace.Near in {
  (1 : ℝ) > 0;
  ∀ (y : m). distance(x, y) < 1 → P(y)
      by { take y : m;
           suppose distance(x, y) < 1;
           done by always };
  witness (1 : ℝ)
}

-- ∧-closure: two near-facts hold together on the smaller of the two
-- balls. This is the lemma that makes the δ₁/δ₂/min bookkeeping of every
-- ε-δ argument invisible, exactly as `Eventually.and` does with max.
theorem MetricSpace.Near.and {m : MetricSpace} (x : m)
        (P Q : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (nearQ : MetricSpace.Near(x, Q))
        : MetricSpace.Near(x, (y : m) ↦ P(y) ∧ Q(y)) :=
  unfold MetricSpace.Near in {
  choose radiusP such that
      radiusP > 0 ∧ ∀ (y : m). distance(x, y) < radiusP → P(y)
      from nearP;
  choose radiusQ such that
      radiusQ > 0 ∧ ∀ (y : m). distance(x, y) < radiusQ → Q(y)
      from nearQ;
  radiusP > 0;
  radiusQ > 0;
  min(radiusP, radiusQ) > 0 by Real.minimum_positive;
  ∀ (y : m). distance(x, y) < min(radiusP, radiusQ)
        → P(y) ∧ Q(y)
      by { take y : m;
           suppose distance(x, y) < min(radiusP, radiusQ);
           min(radiusP, radiusQ) ≤ radiusP;
           min(radiusP, radiusQ) ≤ radiusQ;
           distance(x, y) < min(radiusP, radiusQ) ≤ radiusP;
           distance(x, y) < min(radiusP, radiusQ) ≤ radiusQ;
           P(y);
           Q(y);
           done };
  witness min(radiusP, radiusQ)
}

-- Monotone: a near-fact weakens pointwise.
theorem MetricSpace.Near.monotone {m : MetricSpace} (x : m)
        (P Q : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (pointwise : ∀ (y : m). P(y) → Q(y))
        : MetricSpace.Near(x, Q) :=
  unfold MetricSpace.Near in {
  choose radius such that
      radius > 0 ∧ ∀ (y : m). distance(x, y) < radius → P(y)
      from nearP;
  radius > 0;
  ∀ (y : m). distance(x, y) < radius → Q(y)
      by { take y : m;
           suppose distance(x, y) < radius;
           P(y);
           done by pointwise };
  witness radius
}

-- The filter is proper: what holds near x holds AT x. Unpunctured, so
-- this needs no non-isolated-point hypothesis — the centre is in every
-- ball because `distance(x, x) = 0`.
theorem MetricSpace.Near.at_centre {m : MetricSpace} (x : m)
        (P : m → Proposition) (nearP : MetricSpace.Near(x, P))
        : P(x) :=
  unfold MetricSpace.Near in {
  choose radius such that
      radius > 0 ∧ ∀ (y : m). distance(x, y) < radius → P(y)
      from nearP;
  radius > 0;
  distance(x, x) = 0 by MetricSpace.distance_self;
  distance(x, x)
     = 0
     < radius;
  done
}

theorem MetricSpace.Near.holds_somewhere {m : MetricSpace} (x : m)
        (P : m → Proposition) (nearP : MetricSpace.Near(x, P))
        : ∃ (y : m). P(y) :=
  unfold MetricSpace.Near in {
  P(x) by MetricSpace.Near.at_centre;
  witness x
}

-- Hence nothing is false throughout a ball — the shape an ε-δ argument by
-- contradiction ends on, mirroring `Eventually.not_eventually_false`.
theorem MetricSpace.Near.not_false_nearby {m : MetricSpace} (x : m)
        (nearFalse : MetricSpace.Near(x, (y : m) ↦ False))
        : False :=
  unfold MetricSpace.Near in { done by MetricSpace.Near.at_centre }

-- ----------------------------------------------------------------------
-- "Near x within a region": the property holds at every point OF THE
-- REGION on some ball around x. This is the filter every RELATIVE notion
-- is stated over — relative openness, continuity within a region — and it
-- is what keeps `y ∈ region → …` out of the propositions a proof reads.
--
-- It is a filter in its own right: `of_always`, `and` and `monotone` are
-- what `for y sufficiently near x within region: { … }` runs on, exactly
-- as the three below run the unrelativised scope. `Near` is the
-- `region = universe` case, and the two cross by the pair of boundary
-- lemmas after the trio.
--
-- OPAQUE for the same reason `Near` is: the scope has to recognise its own
-- goal, and a transparent definition is δ-reduced away before it can.
opaque definition MetricSpace.NearWithin {m : MetricSpace} (x : m)
        (region : Set(m)) (P : m → Proposition) : Proposition :=
  MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y))

theorem MetricSpace.NearWithin.of_always {m : MetricSpace} (x : m)
        (region : Set(m)) (P : m → Proposition)
        (always : ∀ (y : m). P(y))
        : MetricSpace.NearWithin(x, region, P) :=
  unfold MetricSpace.NearWithin in {
    for y sufficiently near x: {
      suppose y ∈ region;
      done by always
    }
  }

theorem MetricSpace.NearWithin.and {m : MetricSpace} (x : m)
        (region : Set(m)) (P Q : m → Proposition)
        (nearP : MetricSpace.NearWithin(x, region, P))
        (nearQ : MetricSpace.NearWithin(x, region, Q))
        : MetricSpace.NearWithin(x, region, (y : m) ↦ P(y) ∧ Q(y)) :=
  unfold MetricSpace.NearWithin in {
    MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y));
    MetricSpace.Near(x, (y : m) ↦ y ∈ region → Q(y));
    for y sufficiently near x: {
      suppose y ∈ region;
      P(y);
      Q(y);
      done
    }
  }

theorem MetricSpace.NearWithin.monotone {m : MetricSpace} (x : m)
        (region : Set(m)) (P Q : m → Proposition)
        (nearP : MetricSpace.NearWithin(x, region, P))
        (pointwise : ∀ (y : m). P(y) → Q(y))
        : MetricSpace.NearWithin(x, region, Q) :=
  unfold MetricSpace.NearWithin in {
    MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y));
    for y sufficiently near x: {
      suppose y ∈ region;
      P(y);
      done by pointwise
    }
  }

-- Within a region, a point IS in the region. Trivial as a proposition,
-- and the one fact `for y sufficiently near x within region: { … }` does
-- not otherwise hand its body — state it when the argument splits on
-- where in the region `y` lies.
theorem MetricSpace.NearWithin.in_region {m : MetricSpace} (x : m)
        (region : Set(m))
        : MetricSpace.NearWithin(x, region, (y : m) ↦ y ∈ region) :=
  unfold MetricSpace.NearWithin in {
    ∀ (y : m). distance(x, y) < 1 → (y ∈ region → y ∈ region)
        by { take y : m;
             suppose distance(x, y) < 1;
             suppose y ∈ region;
             done };
    unfold MetricSpace.Near in { witness (1 : ℝ) }
  }

-- Crossing between the two spellings. Everything relative is stated with
-- `NearWithin`; the ε-δ definitions unfold to the implication form, and
-- these two are the only place that difference is visible.

theorem MetricSpace.NearWithin.near {m : MetricSpace} (x : m)
        (region : Set(m)) (P : m → Proposition)
        (nearby : MetricSpace.NearWithin(x, region, P))
        : MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y)) :=
  unfold MetricSpace.NearWithin in { done }

theorem MetricSpace.NearWithin.of_near {m : MetricSpace} (x : m)
        (region : Set(m)) (P : m → Proposition)
        (nearby : MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y)))
        : MetricSpace.NearWithin(x, region, P) :=
  unfold MetricSpace.NearWithin in { done }

-- The relative filter is proper AT a point of the region.
theorem MetricSpace.NearWithin.at_centre {m : MetricSpace} (x : m)
        (region : Set(m)) (inRegion : x ∈ region) (P : m → Proposition)
        (nearP : MetricSpace.NearWithin(x, region, P))
        : P(x) := {
  MetricSpace.Near(x, (y : m) ↦ y ∈ region → P(y))
      by MetricSpace.NearWithin.near;
  x ∈ region → P(x) by MetricSpace.Near.at_centre;
  done
}

-- ----------------------------------------------------------------------
-- The ball is itself a neighbourhood: "y is within `radius` of x" holds
-- near x. This is what lets a proof put a bound on `distance(x, y)` into
-- the same filter as its other facts, instead of carrying that δ by hand.
theorem MetricSpace.Near.within {m : MetricSpace} (x : m) (radius : ℝ)
        (radiusPositive : radius > 0)
        : MetricSpace.Near(x,
              (y : m) ↦ distance(x, y) < radius) :=
  unfold MetricSpace.Near in {
    ∀ (y : m). distance(x, y) < radius
        → distance(x, y) < radius
        by { take y : m;
             suppose distance(x, y) < radius;
             done };
    witness radius
  }
