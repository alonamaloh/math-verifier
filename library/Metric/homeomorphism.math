-- Metric/homeomorphism.math
--
-- A continuous injection on a compactum is a homeomorphism onto its
-- image.
--
-- "The inverse is continuous" is stated **without naming the inverse**:
-- `MetricSpace.HasContinuousInverseOn(f, carrier)` says that points whose
-- images are close are themselves close, which is what every consumer
-- uses and what the sequence argument proves. Naming the inverse would
-- mean choosing a preimage for every point of the image — a use of choice
-- the statement does not need, and an extra function at every call site.
--
-- The proof is the textbook one. If some tolerance had no nearness, then
-- at every scale there is a point of the carrier whose image is that close
-- to `f(x)` and which is itself `tolerance` away from `x`. Compactness
-- thins those points to a convergent sequence; continuity carries the
-- images to the image of the limit, while the construction carries the
-- same images to `f(x)`. Limits are unique, so the limit and `x` have the
-- same image — and injectivity makes them the same point, which the
-- distances forbid.

module Metric.homeomorphism

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value
import Real.convergence
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness

-- ----------------------------------------------------------------------
-- Injectivity and homeomorphism, both relative to a carrier.

definition MetricSpace.InjectiveOn {source target : MetricSpace}
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        : Proposition :=
  ∀ (x : MetricSpace.carrier(source)). x ∈ carrier →
    ∀ (y : MetricSpace.carrier(source)). y ∈ carrier → f(x) = f(y) → x = y

definition MetricSpace.HasContinuousInverseOn {source target : MetricSpace}
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        : Proposition :=
  ∀ (x : MetricSpace.carrier(source)). x ∈ carrier →
    ∀ (tolerance : ℝ). tolerance > 0 →
      ∃ (nearness : ℝ). nearness > 0 ∧
        ∀ (y : MetricSpace.carrier(source)). y ∈ carrier →
          MetricSpace.distance(f(x), f(y)) < nearness →
            MetricSpace.distance(x, y) < tolerance

definition MetricSpace.IsHomeomorphismOn {source target : MetricSpace}
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        : Proposition :=
  MetricSpace.ContinuousOn(f, carrier) ∧ MetricSpace.InjectiveOn(f, carrier)
    ∧ MetricSpace.HasContinuousInverseOn(f, carrier)

-- ----------------------------------------------------------------------
-- "No nearness works at `x`, so at every scale some point of the carrier
-- has an image that close and is itself far." The quantifier gymnastics,
-- quarantined so that the theorem below reads.

theorem MetricSpace.far_point_with_close_image_at_every_scale
        (source target : MetricSpace)
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        (x : MetricSpace.carrier(source)) (tolerance : ℝ)
        (noNearness : ¬(∃ (nearness : ℝ). nearness > 0 ∧
            ∀ (y : MetricSpace.carrier(source)). y ∈ carrier →
              MetricSpace.distance(f(x), f(y)) < nearness →
                MetricSpace.distance(x, y) < tolerance))
        (n : ℕ)
        : ∃ (y : MetricSpace.carrier(source)). y ∈ carrier
            ∧ (MetricSpace.distance(f(x), f(y)) < Real.harmonic_term(n)
                   ∧ ¬(MetricSpace.distance(x, y) < tolerance)) := {
  Real.harmonic_term(n) > 0 by Real.divide_positive;
  suppose ¬(∃ (y : MetricSpace.carrier(source)). y ∈ carrier
      ∧ (MetricSpace.distance(f(x), f(y)) < Real.harmonic_term(n)
             ∧ ¬(MetricSpace.distance(x, y) < tolerance)))
      as noFarPoint for contradiction {
    ∀ (y : MetricSpace.carrier(source)). y ∈ carrier →
        MetricSpace.distance(f(x), f(y)) < Real.harmonic_term(n) →
          MetricSpace.distance(x, y) < tolerance
        by (y : MetricSpace.carrier(source)) (inCarrier : y ∈ carrier)
           (imageClose : MetricSpace.distance(f(x), f(y))
                             < Real.harmonic_term(n)) ↦ {
          suppose ¬(MetricSpace.distance(x, y) < tolerance)
              as pointFar for contradiction {
            ∃ (z : MetricSpace.carrier(source)). z ∈ carrier
                ∧ (MetricSpace.distance(f(x), f(z)) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(x, z) < tolerance))
                by { witness y };
            done
          };
          done
        };
    ∃ (nearness : ℝ). nearness > 0 ∧
        ∀ (y : MetricSpace.carrier(source)). y ∈ carrier →
          MetricSpace.distance(f(x), f(y)) < nearness →
            MetricSpace.distance(x, y) < tolerance
        by { witness Real.harmonic_term(n) };
    done
  };
  done
}

-- ----------------------------------------------------------------------
-- The inverse of a continuous injection on a compactum is continuous.

theorem MetricSpace.inverse_continuous_on_compact (source target : MetricSpace)
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        (compact : MetricSpace.IsCompact(carrier))
        (continuous : MetricSpace.ContinuousOn(f, carrier))
        (injective : MetricSpace.InjectiveOn(f, carrier))
        : MetricSpace.HasContinuousInverseOn(f, carrier) := {
  take x : MetricSpace.carrier(source);
  suppose x ∈ carrier as xInCarrier;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  suppose ¬(∃ (nearness : ℝ). nearness > 0 ∧
      ∀ (y : MetricSpace.carrier(source)). y ∈ carrier →
        MetricSpace.distance(f(x), f(y)) < nearness →
          MetricSpace.distance(x, y) < tolerance)
      as noNearness for contradiction {

    -- The bad points, one per scale.
    ∀ (n : ℕ). ∃ (y : MetricSpace.carrier(source)). y ∈ carrier
        ∧ (MetricSpace.distance(f(x), f(y)) < Real.harmonic_term(n)
               ∧ ¬(MetricSpace.distance(x, y) < tolerance))
        by (n : ℕ) ↦ MetricSpace.far_point_with_close_image_at_every_scale(
            source, target, f, carrier, x, tolerance, noNearness, n)
        as badPoints;
    choose s such that
        ∀ (n : ℕ). s(n) ∈ carrier
          ∧ (MetricSpace.distance(f(x), f(s(n))) < Real.harmonic_term(n)
                 ∧ ¬(MetricSpace.distance(x, s(n)) < tolerance))
        as chosen
        from Logic.countable_choice(
            MetricSpace.carrier(source),
            (n : ℕ) (y : MetricSpace.carrier(source)) ↦ y ∈ carrier
                ∧ (MetricSpace.distance(f(x), f(y)) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(x, y) < tolerance)),
            badPoints);
    ∀ (k : ℕ). s(k) ∈ carrier
        by { take k : ℕ; done by chosen }
        as inside;

    -- Thin them to a convergent sequence.
    choose index : ℕ → ℕ, limit : MetricSpace.carrier(source) such that
        limit ∈ carrier ∧ MetricSpace.SubsequenceConverges(s, index, limit)
        from compact;
    Natural.IsStrictlyIncreasing(index);
    limit ∈ carrier as limitInCarrier;
    MetricSpace.SequenceConverges((k : ℕ) ↦ s(index(k)), limit) as converges;

    -- The images have two limits: continuity gives one, the construction
    -- gives the other.
    MetricSpace.SequenceConverges((k : ℕ) ↦ f(s(index(k))), f(limit))
        by MetricSpace.ContinuousAt.along_sequence(
            continuous := continuous(limit, limitInCarrier),
            s := (k : ℕ) ↦ s(index(k)),
            inside := (k : ℕ) ↦ inside(index(k)));
    MetricSpace.SequenceConverges((k : ℕ) ↦ f(s(index(k))), f(x))
        by (scale : ℝ) (scalePositive : scale > 0) ↦ {
          choose step such that Real.harmonic_term(step) < scale
              from Real.exists_harmonic_term_below;
          witness step with
              (k : ℕ) (beyond : step ≤ k) ↦ {
                s(index(k)) ∈ carrier
                    ∧ (MetricSpace.distance(f(x), f(s(index(k))))
                           < Real.harmonic_term(index(k))
                           ∧ ¬(MetricSpace.distance(x, s(index(k))) < tolerance))
                    by chosen;
                MetricSpace.distance(f(x), f(s(index(k))))
                    < Real.harmonic_term(index(k));
                k ≤ index(k) by Natural.IsStrictlyIncreasing.LessOrEqual;
                Real.harmonic_term(index(k)) ≤ Real.harmonic_term(k)
                    by Real.harmonic_term_antitone;
                Real.harmonic_term(k) ≤ Real.harmonic_term(step)
                    by Real.harmonic_term_antitone;
                MetricSpace.distance(f(x), f(s(index(k))))
                    < Real.harmonic_term(step);
                done
              }
        };
    f(limit) = f(x)
        by MetricSpace.SequenceConverges.unique(
            s := (k : ℕ) ↦ f(s(index(k))));
    limit = x
        by injective
        as limitIsX;

    -- So the bad points converge to `x`, though every one of them was
    -- chosen `tolerance` away from it.
    choose threshold such that
        ∀ (k : ℕ). threshold ≤ k →
            MetricSpace.distance(limit, s(index(k))) < tolerance
        as closeBeyond from converges;
    MetricSpace.distance(limit, s(index(threshold))) < tolerance
        by closeBeyond;
    MetricSpace.distance(x, s(index(threshold))) < tolerance
        by substituting limitIsX;
    s(index(threshold)) ∈ carrier
        ∧ (MetricSpace.distance(f(x), f(s(index(threshold))))
               < Real.harmonic_term(index(threshold))
               ∧ ¬(MetricSpace.distance(x, s(index(threshold))) < tolerance))
        by chosen;
    ¬(MetricSpace.distance(x, s(index(threshold))) < tolerance);
    done
  };
  done
}

theorem MetricSpace.IsHomeomorphismOn.of_continuous_injective_on_compact
        (source target : MetricSpace)
        (f : MetricSpace.carrier(source) → MetricSpace.carrier(target))
        (carrier : Set(MetricSpace.carrier(source)))
        (compact : MetricSpace.IsCompact(carrier))
        (continuous : MetricSpace.ContinuousOn(f, carrier))
        (injective : MetricSpace.InjectiveOn(f, carrier))
        : MetricSpace.IsHomeomorphismOn(f, carrier) := {
  MetricSpace.HasContinuousInverseOn(f, carrier)
      by MetricSpace.inverse_continuous_on_compact;
  done
}
