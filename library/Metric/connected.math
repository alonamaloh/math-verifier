-- Metric/connected.math
--
-- Connectedness in a metric space, relative throughout.
--
-- The definition is the clopen one: a set is connected when its only
-- nonempty relatively-clopen subset is itself. That is the "recognizing a
-- component" criterion taken as primitive rather than derived, because it
-- is the form every consumer uses — one shows a candidate piece is open,
-- that its complement is open, that it is not empty, and concludes it is
-- everything.
--
-- Stating it as `piece = region` rather than as the absence of a
-- separation also spares every consumer the negation: a connectedness
-- argument becomes three positive obligations and a conclusion, with no
-- reductio in sight.

module Metric.connected

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Metric.space
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness

-- ----------------------------------------------------------------------
-- Connectedness.

definition MetricSpace.IsConnected {m : MetricSpace}
        (region : Set(m)) : Proposition :=
  ∀ (piece : Set(m)).
    piece ⊆ region →
    MetricSpace.OpenIn(piece, region) →
    MetricSpace.OpenIn(region ∖ piece, region) →
    Set.IsNonempty(m, piece) →
    piece = region

-- A nonempty open-and-closed piece is everything. This is the definition
-- read back through `ClosedIn`, which is how a topology argument states
-- the obligation it has just discharged.
theorem MetricSpace.IsConnected.clopen_is_everything (m : MetricSpace)
        (region piece : Set(m))
        (connected : MetricSpace.IsConnected(region))
        (inside : piece ⊆ region)
        (open : MetricSpace.OpenIn(piece, region))
        (closed : MetricSpace.ClosedIn(piece, region))
        (nonempty : Set.IsNonempty(m, piece))
        : piece = region :=
  connected(piece, inside, open, closed, nonempty)

-- ----------------------------------------------------------------------
-- Preimages.
--
-- The relative topology transports backwards along a continuous map:
-- what is open in the image is open in the domain. This is the one
-- topological fact the image theorem below needs, and it is the ε–δ
-- argument spelled out — the radius comes from the image's openness,
-- the nearness from continuity at the point.

definition MetricSpace.preimageIn {source target : MetricSpace}
        (f : source → target)
        (region : Set(target))
        (carrier : Set(source))
        : Set(source) :=
  (x : source) ↦ x ∈ carrier ∧ f(x) ∈ region

theorem MetricSpace.OpenIn.preimage (source target : MetricSpace)
        (f : source → target)
        (carrier : Set(source))
        (region : Set(target))
        (continuous : MetricSpace.ContinuousOn(f, carrier))
        (targetOpen : MetricSpace.OpenIn(region, MetricSpace.imageSet(f, carrier)))
        : MetricSpace.OpenIn(MetricSpace.preimageIn(f, region, carrier), carrier) := {
  take x : source;
  suppose x ∈ MetricSpace.preimageIn(f, region, carrier) as inPreimage;
  x ∈ carrier as inCarrier;
  f(x) ∈ region as valueInRegion;
  choose radius such that
      radius > 0 ∧
      ∀ (w : target). w ∈ MetricSpace.imageSet(f, carrier) →
        distance(f(x), w) < radius → w ∈ region
      from targetOpen(f(x), valueInRegion);
  radius > 0 as radiusPositive;
  ∀ (w : target). w ∈ MetricSpace.imageSet(f, carrier) →
      distance(f(x), w) < radius → w ∈ region
      as nearbyValuesHit;
  choose nearness such that
      nearness > 0 ∧
      ∀ (y : source). y ∈ carrier →
        distance(x, y) < nearness →
          distance(f(x), f(y)) < radius
      from continuous(x, inCarrier, radius, radiusPositive);
  nearness > 0;
  ∀ (y : source). y ∈ carrier →
      distance(x, y) < nearness →
        distance(f(x), f(y)) < radius
      as nearbyPointsMoveLittle;
  witness nearness with {
    nearness > 0;
    ∀ (y : source). y ∈ carrier →
        distance(x, y) < nearness →
          y ∈ MetricSpace.preimageIn(f, region, carrier)
        by (y : source) (inCarrierY : y ∈ carrier)
           (near : distance(x, y) < nearness) ↦ {
          distance(f(x), f(y)) < radius
              by nearbyPointsMoveLittle;
          f(y) ∈ MetricSpace.imageSet(f, carrier) by { witness y };
          f(y) ∈ region by nearbyValuesHit;
          y ∈ MetricSpace.preimageIn(f, region, carrier);
          done
        };
    done
  }
}

theorem MetricSpace.preimageIn_subset (source target : MetricSpace)
        (f : source → target)
        (region : Set(target))
        (carrier : Set(source))
        : MetricSpace.preimageIn(f, region, carrier) ⊆ carrier := {
  take x : source;
  suppose x ∈ MetricSpace.preimageIn(f, region, carrier) as inPreimage;
  x ∈ carrier;
  done
}

-- The complement of a preimage is the preimage of the complement — the
-- bookkeeping that turns "clopen in the image" into "clopen in the
-- domain".
theorem MetricSpace.preimageIn_complement (source target : MetricSpace)
        (f : source → target)
        (carrier : Set(source))
        (region : Set(target))
        : carrier ∖ MetricSpace.preimageIn(f, region, carrier)
              = MetricSpace.preimageIn(
                    f, MetricSpace.imageSet(f, carrier) ∖ region, carrier) := {
  carrier ∖ MetricSpace.preimageIn(f, region, carrier)
      ⊆ MetricSpace.preimageIn(
            f, MetricSpace.imageSet(f, carrier) ∖ region, carrier)
      by (x : source)
         (outside : x ∈ carrier ∖ MetricSpace.preimageIn(f, region, carrier)) ↦ {
        x ∈ carrier;
        ¬(x ∈ MetricSpace.preimageIn(f, region, carrier));
        f(x) ∈ MetricSpace.imageSet(f, carrier) by { witness x };
        suppose f(x) ∈ region for contradiction {
          x ∈ MetricSpace.preimageIn(f, region, carrier);
          done
        };
        f(x) ∈ MetricSpace.imageSet(f, carrier) ∖ region;
        done
      };
  MetricSpace.preimageIn(f, MetricSpace.imageSet(f, carrier) ∖ region, carrier)
      ⊆ carrier ∖ MetricSpace.preimageIn(f, region, carrier)
      by (x : source)
         (inside : x ∈ MetricSpace.preimageIn(
              f, MetricSpace.imageSet(f, carrier) ∖ region, carrier)) ↦ {
        x ∈ carrier;
        f(x) ∈ MetricSpace.imageSet(f, carrier) ∖ region;
        ¬(f(x) ∈ region);
        suppose x ∈ MetricSpace.preimageIn(f, region, carrier) for contradiction {
          f(x) ∈ region;
          done
        };
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The continuous image of a connected set is connected.
--
-- Pull the clopen piece back: it is clopen in the domain by the two
-- lemmas above, and nonempty because the piece has a point and the point
-- has a preimage. Connectedness of the domain makes the pullback
-- everything, and pushing that forward makes the piece everything.

theorem MetricSpace.IsConnected.image (source target : MetricSpace)
        (f : source → target)
        (carrier : Set(source))
        (connected : MetricSpace.IsConnected(carrier))
        (continuous : MetricSpace.ContinuousOn(f, carrier))
        : MetricSpace.IsConnected(MetricSpace.imageSet(f, carrier)) := {
  take piece : Set(target);
  suppose piece ⊆ MetricSpace.imageSet(f, carrier) as pieceInImage;
  suppose MetricSpace.OpenIn(piece, MetricSpace.imageSet(f, carrier)) as pieceOpen;
  suppose MetricSpace.OpenIn(
      MetricSpace.imageSet(f, carrier) ∖ piece, MetricSpace.imageSet(f, carrier))
      as restOpen;
  suppose Set.IsNonempty(target, piece) as pieceNonempty;

  MetricSpace.preimageIn(f, piece, carrier) ⊆ carrier
      by MetricSpace.preimageIn_subset;
  MetricSpace.OpenIn(MetricSpace.preimageIn(f, piece, carrier), carrier)
      by MetricSpace.OpenIn.preimage;
  carrier ∖ MetricSpace.preimageIn(f, piece, carrier)
      = MetricSpace.preimageIn(
            f, MetricSpace.imageSet(f, carrier) ∖ piece, carrier)
      by MetricSpace.preimageIn_complement;
  MetricSpace.OpenIn(
      MetricSpace.preimageIn(f, MetricSpace.imageSet(f, carrier) ∖ piece, carrier),
      carrier)
      by MetricSpace.OpenIn.preimage;
  MetricSpace.OpenIn(carrier ∖ MetricSpace.preimageIn(f, piece, carrier), carrier);

  -- The piece has a point, and that point is a value.
  choose value such that value ∈ piece from pieceNonempty;
  value ∈ MetricSpace.imageSet(f, carrier) by pieceInImage;
  choose origin such that origin ∈ carrier ∧ f(origin) = value
      from { value ∈ MetricSpace.imageSet(f, carrier) };
  origin ∈ carrier;
  f(origin) = value;
  f(origin) ∈ piece;
  origin ∈ MetricSpace.preimageIn(f, piece, carrier);
  Set.IsNonempty(
      source, MetricSpace.preimageIn(f, piece, carrier))
      by { witness origin };

  MetricSpace.preimageIn(f, piece, carrier) = carrier by connected;

  -- Pushing that forward: every value is the value at a point of the
  -- pullback, hence lands in the piece.
  MetricSpace.imageSet(f, carrier) ⊆ piece
      by (y : target)
         (inImage : y ∈ MetricSpace.imageSet(f, carrier)) ↦ {
        choose x such that x ∈ carrier ∧ f(x) = y from inImage;
        x ∈ carrier;
        f(x) = y;
        carrier = MetricSpace.preimageIn(f, piece, carrier);
        x ∈ MetricSpace.preimageIn(f, piece, carrier);
        f(x) ∈ piece;
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- Restriction.
--
-- Relative openness survives shrinking the carrier: what is open in a set
-- is open in any subset of it, once cut down to that subset. The radius
-- is unchanged — only fewer points have to be checked.

theorem MetricSpace.OpenIn.restrict (m : MetricSpace)
        (piece carrier smaller : Set(m))
        (openInCarrier : MetricSpace.OpenIn(piece, carrier))
        (inside : smaller ⊆ carrier)
        : MetricSpace.OpenIn(piece ∩ smaller, smaller) := {
  take x : m;
  suppose x ∈ piece ∩ smaller as inBoth;
  x ∈ piece;
  choose radius such that
      radius > 0 ∧
      ∀ (y : m). y ∈ carrier →
        distance(x, y) < radius → y ∈ piece
      from openInCarrier(x, { x ∈ piece });
  radius > 0;
  ∀ (y : m). y ∈ carrier →
      distance(x, y) < radius → y ∈ piece as nearbyInPiece;
  witness radius with {
    radius > 0;
    ∀ (y : m). y ∈ smaller →
        distance(x, y) < radius → y ∈ piece ∩ smaller
        by (y : m) (inSmaller : y ∈ smaller)
           (near : distance(x, y) < radius) ↦ {
          y ∈ carrier by inside;
          y ∈ piece by nearbyInPiece;
          done
        };
    done
  }
}

-- Cutting a piece out of a subset is the same as cutting the ambient
-- complement down to it. The bookkeeping the union argument runs on.
theorem MetricSpace.difference_intersection (m : MetricSpace)
        (larger smaller piece : Set(m))
        (inside : smaller ⊆ larger)
        : smaller ∖ (piece ∩ smaller) = (larger ∖ piece) ∩ smaller := {
  smaller ∖ (piece ∩ smaller) ⊆ (larger ∖ piece) ∩ smaller
      by (x : m)
         (outside : x ∈ smaller ∖ (piece ∩ smaller)) ↦ {
        x ∈ smaller;
        ¬(x ∈ piece ∩ smaller);
        x ∈ larger by inside;
        ¬(x ∈ piece)
            by (inPiece : x ∈ piece) ↦ {
              x ∈ piece ∩ smaller;
              done
            };
        x ∈ larger ∖ piece;
        done
      };
  (larger ∖ piece) ∩ smaller ⊆ smaller ∖ (piece ∩ smaller)
      by (x : m)
         (inCut : x ∈ (larger ∖ piece) ∩ smaller) ↦ {
        x ∈ larger ∖ piece;
        x ∈ smaller;
        ¬(x ∈ piece);
        ¬(x ∈ piece ∩ smaller)
            by (inBoth : x ∈ piece ∩ smaller) ↦ {
              x ∈ piece;
              done
            };
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- A connected piece swallows a whole connected set it meets.
--
-- Extracted because the union argument needs it twice, once per side,
-- and because it is the step a reader wants named: a relatively clopen
-- piece of the whole, if it meets a connected part at all, contains it.

theorem MetricSpace.IsConnected.swallows (m : MetricSpace)
        (whole part piece : Set(m))
        (partConnected : MetricSpace.IsConnected(part))
        (partInside : part ⊆ whole)
        (pieceOpen : MetricSpace.OpenIn(piece, whole))
        (restOpen : MetricSpace.OpenIn(whole ∖ piece, whole))
        (meets : Set.IsNonempty(m, piece ∩ part))
        : part ⊆ piece := {
  MetricSpace.OpenIn(piece ∩ part, part)
      by MetricSpace.OpenIn.restrict(carrier := whole);
  part ∖ (piece ∩ part) = (whole ∖ piece) ∩ part
      by MetricSpace.difference_intersection;
  MetricSpace.OpenIn((whole ∖ piece) ∩ part, part)
      by MetricSpace.OpenIn.restrict(carrier := whole);
  MetricSpace.OpenIn(part ∖ (piece ∩ part), part);
  piece ∩ part ⊆ part by Set.intersection_subset_right;
  piece ∩ part = part by partConnected;
  part = piece ∩ part;
  take x : m;
  suppose x ∈ part;
  x ∈ piece ∩ part;
  done
}

-- ----------------------------------------------------------------------
-- Two connected sets that share a point make a connected union.
--
-- A relatively clopen piece of the union is nonempty, so it meets one of
-- the two sides; that side is swallowed whole, which drags in the shared
-- point, which puts the other side's meeting in evidence too.

theorem MetricSpace.IsConnected.union (m : MetricSpace)
        (left right : Set(m))
        (leftConnected : MetricSpace.IsConnected(left))
        (rightConnected : MetricSpace.IsConnected(right))
        (shared : m)
        (sharedInLeft : shared ∈ left) (sharedInRight : shared ∈ right)
        : MetricSpace.IsConnected(left ∪ right) := {
  take piece : Set(m);
  suppose piece ⊆ left ∪ right as pieceInside;
  suppose MetricSpace.OpenIn(piece, left ∪ right) as pieceOpen;
  suppose MetricSpace.OpenIn((left ∪ right) ∖ piece, left ∪ right) as restOpen;
  suppose Set.IsNonempty(m, piece) as pieceNonempty;
  left ⊆ left ∪ right by Set.subset_union_left;
  right ⊆ left ∪ right by Set.subset_union_right;

  -- Whichever side the piece meets, the shared point ends up inside it.
  choose start such that start ∈ piece from pieceNonempty;
  start ∈ left ∪ right by pieceInside;
  shared ∈ piece by cases {
    case start ∈ left as startInLeft: {
        Set.IsNonempty(m, piece ∩ left)
            by { witness start };
        left ⊆ piece
            by MetricSpace.IsConnected.swallows(whole := left ∪ right)
            as leftSwallowed;
        done by leftSwallowed
      }
    case start ∈ right as startInRight: {
        Set.IsNonempty(m, piece ∩ right)
            by { witness start };
        right ⊆ piece
            by MetricSpace.IsConnected.swallows(whole := left ∪ right)
            as rightSwallowed;
        done by rightSwallowed
      }
  };

  -- With the shared point inside, both sides are swallowed.
  Set.IsNonempty(m, piece ∩ left)
      by { witness shared };
  Set.IsNonempty(m, piece ∩ right)
      by { witness shared };
  left ⊆ piece
      by MetricSpace.IsConnected.swallows(whole := left ∪ right) as leftInPiece;
  right ⊆ piece
      by MetricSpace.IsConnected.swallows(whole := left ∪ right) as rightInPiece;
  left ∪ right ⊆ piece
      by (x : m) (inUnion : x ∈ left ∪ right) ↦ {
        done by cases {
          case x ∈ left as inLeft: leftInPiece(x, inLeft)
          case x ∈ right as inRight: rightInPiece(x, inRight)
        }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- A connected set caught between two disjoint open sets lies in one of
-- them.
--
-- The side it meets is relatively clopen in it: relatively open because
-- an open set cuts it out, relatively closed because the other side is
-- all that remains, and nonempty by hypothesis. So it is everything.

theorem MetricSpace.IsConnected.lands_in_side (m : MetricSpace)
        (part left right : Set(m))
        (partConnected : MetricSpace.IsConnected(part))
        (leftOpen : MetricSpace.IsOpen(left)) (rightOpen : MetricSpace.IsOpen(right))
        (apart : ∀ (x : m). x ∈ left → ¬(x ∈ right))
        (covered : part ⊆ left ∪ right)
        (meetsLeft : Set.IsNonempty(m, left ∩ part))
        : part ⊆ left := {
  part ⊆ Set.universe(m) by Set.subset_universe;
  MetricSpace.OpenIn(left ∩ part, part)
      by MetricSpace.OpenIn.restrict(carrier := Set.universe(m));
  MetricSpace.OpenIn(right ∩ part, part)
      by MetricSpace.OpenIn.restrict(carrier := Set.universe(m));

  -- What the left side leaves of `part` is exactly what the right side
  -- catches, so the leftover is relatively open too.
  part ∖ (left ∩ part) ⊆ right ∩ part
      by (x : m) (missedLeft : x ∈ part ∖ (left ∩ part)) ↦ {
        x ∈ part;
        ¬(x ∈ left ∩ part);
        ¬(x ∈ left)
            by (xInLeft : x ∈ left) ↦ {
              x ∈ left ∩ part;
              done
            };
        x ∈ left ∪ right by covered;
        x ∈ left ∨ x ∈ right;
        x ∈ right;
        done
      };
  right ∩ part ⊆ part ∖ (left ∩ part)
      by (x : m) (inRightPart : x ∈ right ∩ part) ↦ {
        x ∈ right;
        x ∈ part;
        ¬(x ∈ left ∩ part)
            by (inLeftPart : x ∈ left ∩ part) ↦ {
              x ∈ left;
              ¬(x ∈ right) by apart;
              done
            };
        done
      };
  part ∖ (left ∩ part) = right ∩ part
      by Set.equal_of_same_members as leftoverIsRight;
  MetricSpace.OpenIn(part ∖ (left ∩ part), part) by substituting leftoverIsRight;

  left ∩ part ⊆ part by Set.intersection_subset_right;
  left ∩ part = part by partConnected;
  part = left ∩ part;
  take x : m;
  suppose x ∈ part;
  x ∈ left ∩ part;
  done
}

-- The same fact stated as the alternative it is usually quoted as. The
-- side a nonempty connected set meets is decided by any one of its
-- points.
theorem MetricSpace.IsConnected.lands_in_one_side (m : MetricSpace)
        (part left right : Set(m))
        (partConnected : MetricSpace.IsConnected(part))
        (leftOpen : MetricSpace.IsOpen(left)) (rightOpen : MetricSpace.IsOpen(right))
        (apart : ∀ (x : m). x ∈ left → ¬(x ∈ right))
        (covered : part ⊆ left ∪ right)
        (nonempty : Set.IsNonempty(m, part))
        : part ⊆ left ∨ part ⊆ right := {
  choose start such that start ∈ part from nonempty;
  start ∈ left ∪ right by covered;
  done by cases {
    case start ∈ left as startInLeft: {
        Set.IsNonempty(m, left ∩ part)
            by { witness start };
        part ⊆ left
            by MetricSpace.IsConnected.lands_in_side(right := right);
        done
      }
    case start ∈ right as startInRight: {
        ∀ (x : m). x ∈ right → ¬(x ∈ left)
            by (x : m) (xInRight : x ∈ right)
               (xInLeft : x ∈ left) ↦ {
              ¬(x ∈ right) by apart;
              done
            };
        part ⊆ right ∪ left
            by (x : m) (xInPart : x ∈ part) ↦ {
              x ∈ left ∪ right by covered;
              x ∈ left ∨ x ∈ right;
              x ∈ right ∨ x ∈ left by Or.swap;
              done
            };
        Set.IsNonempty(m, right ∩ part)
            by { witness start };
        part ⊆ right
            by MetricSpace.IsConnected.lands_in_side(right := left);
        done
      }
  }
}

-- ----------------------------------------------------------------------
-- Adjoining limit points keeps a set connected.
--
-- A relatively clopen piece of the wider set is nonempty, and its
-- openness gives it a radius around one of its points; that radius
-- reaches the core, because the point is a limit of the core. So the
-- piece meets the core and swallows it. Then no point of the wider set
-- can be outside the piece: the leftover is relatively open too, so it
-- would come with a radius of its own, and that radius also reaches the
-- core — which is already inside the piece.

theorem MetricSpace.IsConnected.adjoin_limits (m : MetricSpace)
        (core wide : Set(m))
        (coreConnected : MetricSpace.IsConnected(core))
        (coreInside : core ⊆ wide)
        (wideInClosure : wide ⊆ MetricSpace.ClosureIn(core, wide))
        : MetricSpace.IsConnected(wide) := {
  take piece : Set(m);
  suppose piece ⊆ wide as pieceInside;
  suppose MetricSpace.OpenIn(piece, wide) as pieceOpen;
  suppose MetricSpace.OpenIn(wide ∖ piece, wide) as restOpen;
  suppose Set.IsNonempty(m, piece) as pieceNonempty;

  -- The piece reaches the core, so it holds all of it.
  choose start such that start ∈ piece from pieceNonempty;
  start ∈ wide by pieceInside;
  choose radius such that
      radius > 0 ∧
        ∀ (y : m). y ∈ wide →
          distance(start, y) < radius → y ∈ piece
      from pieceOpen;
  radius > 0;
  ∀ (y : m). y ∈ wide →
      distance(start, y) < radius → y ∈ piece as nearbyInPiece;
  start ∈ MetricSpace.ClosureIn(core, wide) by wideInClosure;
  ∀ (scale : ℝ). scale > 0 →
      ∃ (y : m). y ∈ core ∧
        distance(start, y) < scale
      as coreIsNear;
  choose near : m such that
      near ∈ core ∧ distance(start, near) < radius
      from coreIsNear;
  near ∈ core;
  distance(start, near) < radius;
  near ∈ wide by coreInside;
  near ∈ piece by nearbyInPiece;
  Set.IsNonempty(m, piece ∩ core)
      by { witness near };
  core ⊆ piece by MetricSpace.IsConnected.swallows as coreInPiece;

  -- And nothing of the wider set is left outside it.
  wide ⊆ piece
      by (x : m) (xInWide : x ∈ wide) ↦ {
        suppose ¬(x ∈ piece) as xOutside for contradiction {
          x ∈ wide ∖ piece;
          choose reach such that
              reach > 0 ∧
                ∀ (y : m). y ∈ wide →
                  distance(x, y) < reach → y ∈ wide ∖ piece
              from restOpen(x, { x ∈ wide ∖ piece });
          reach > 0;
          ∀ (y : m). y ∈ wide →
              distance(x, y) < reach → y ∈ wide ∖ piece
              as nearbyOutside;
          x ∈ MetricSpace.ClosureIn(core, wide) by wideInClosure;
          ∀ (scale : ℝ). scale > 0 →
              ∃ (y : m). y ∈ core ∧
                distance(x, y) < scale
              as coreIsNearX;
          choose witnessPoint : m such that
              witnessPoint ∈ core ∧ distance(x, witnessPoint) < reach
              from coreIsNearX;
          witnessPoint ∈ core;
          distance(x, witnessPoint) < reach;
          witnessPoint ∈ wide by coreInside;
          witnessPoint ∈ wide ∖ piece
              by nearbyOutside;
          ¬(witnessPoint ∈ piece);
          witnessPoint ∈ piece by coreInPiece;
          done
        };
        done
      };
  done by Set.equal_of_same_members
}
