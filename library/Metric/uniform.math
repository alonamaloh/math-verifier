-- Metric/uniform.math
--
-- Uniform continuity, and the theorem that continuity on a compactum is
-- uniform.
--
-- The proof is the closing-pairs shape again. If no nearness worked, then
-- at every scale some pair of points would be within `1/(1+n)` and yet
-- have values `tolerance` apart — two choices, in sequence, for the two
-- points. Thinning twice makes both converge, and to the SAME limit,
-- since they were built to close on each other. But continuity at that
-- limit puts both values within `tolerance/2` of the value there, hence
-- within `tolerance` of each other.

module Metric.uniform

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.maximum
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value
import Real.absolute_value_order
import Real.convergence
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness
import Metric.separation

definition MetricSpace.UniformlyContinuousOn {source target : MetricSpace}
        (f : source → target)
        (carrier : Set(source)) : Proposition :=
  ∀ (tolerance : ℝ). tolerance > 0 →
    ∃ (nearness : ℝ). nearness > 0 ∧
      ∀ (x : source). x ∈ carrier →
        ∀ (y : source). y ∈ carrier →
          MetricSpace.distance(x, y) < nearness →
            MetricSpace.distance(f(x), f(y)) < tolerance

-- "No nearness works, so at every scale some pair is close with values
-- that are not." The quantifier gymnastics, quarantined so that the
-- theorem below reads.
theorem MetricSpace.bad_pair_at_every_scale (source target : MetricSpace)
        (f : source → target)
        (region : Set(source)) (tolerance : ℝ)
        (noNearness : ¬(∃ (nearness : ℝ). nearness > 0 ∧
            ∀ (x : source). x ∈ region →
              ∀ (y : source). y ∈ region →
                MetricSpace.distance(x, y) < nearness
                  → MetricSpace.distance(f(x), f(y)) < tolerance))
        (n : ℕ)
        : ∃ (p : source). p ∈ region ∧
            ∃ (q : source). q ∈ region
                ∧ (MetricSpace.distance(p, q) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(f(p), f(q)) < tolerance)) := {
  Real.harmonic_term(n) > 0 by Real.divide_positive;
  suppose ¬(∃ (p : source). p ∈ region ∧
      ∃ (q : source). q ∈ region
          ∧ (MetricSpace.distance(p, q) < Real.harmonic_term(n)
                 ∧ ¬(MetricSpace.distance(f(p), f(q)) < tolerance)))
      as noBadPair for contradiction {
    ∀ (x : source). x ∈ region →
      ∀ (y : source). y ∈ region →
        MetricSpace.distance(x, y) < Real.harmonic_term(n)
          → MetricSpace.distance(f(x), f(y)) < tolerance
        by (x : source) (inX : x ∈ region)
           (y : source) (inY : y ∈ region)
           (near : MetricSpace.distance(x, y) < Real.harmonic_term(n)) ↦ {
          suppose ¬(MetricSpace.distance(f(x), f(y)) < tolerance)
              as valuesApart for contradiction {
            ∃ (q : source). q ∈ region
                ∧ (MetricSpace.distance(x, q) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(f(x), f(q)) < tolerance))
                by { witness y };
            ∃ (p : source). p ∈ region ∧
                ∃ (q : source). q ∈ region
                    ∧ (MetricSpace.distance(p, q) < Real.harmonic_term(n)
                           ∧ ¬(MetricSpace.distance(f(p), f(q)) < tolerance))
                by { witness x };
            done
          };
          done
        };
    ∃ (nearness : ℝ). nearness > 0 ∧
        ∀ (x : source). x ∈ region →
          ∀ (y : source). y ∈ region →
            MetricSpace.distance(x, y) < nearness
              → MetricSpace.distance(f(x), f(y)) < tolerance
        by { witness Real.harmonic_term(n) };
    done
  };
  done
}

theorem MetricSpace.uniformly_continuous_on_compact (source target : MetricSpace)
        (f : source → target)
        (region : Set(source))
        (compact : MetricSpace.IsCompact(region))
        (continuous : MetricSpace.ContinuousOn(f, region))
        : MetricSpace.UniformlyContinuousOn(f, region) := {
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  suppose ¬(∃ (nearness : ℝ). nearness > 0 ∧
      ∀ (x : source). x ∈ region →
        ∀ (y : source). y ∈ region →
          MetricSpace.distance(x, y) < nearness
            → MetricSpace.distance(f(x), f(y)) < tolerance)
      as noNearness for contradiction {

    -- At every scale, a pair that is close but whose values are not.
    ∀ (n : ℕ). ∃ (p : source). p ∈ region ∧
        ∃ (q : source). q ∈ region
            ∧ (MetricSpace.distance(p, q) < Real.harmonic_term(n)
                   ∧ ¬(MetricSpace.distance(f(p), f(q)) < tolerance))
        by (n : ℕ) ↦ MetricSpace.bad_pair_at_every_scale(
             source, target, f, region, tolerance, noNearness, n)
        as badPairs;

    choose p such that
        ∀ (n : ℕ). p(n) ∈ region ∧
            ∃ (q : source). q ∈ region
                ∧ (MetricSpace.distance(p(n), q) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(f(p(n)), f(q)) < tolerance))
        as chosenP
        from Logic.countable_choice(
            source,
            (n : ℕ) (x : source) ↦ x ∈ region ∧
                ∃ (q : source). q ∈ region
                    ∧ (MetricSpace.distance(x, q) < Real.harmonic_term(n)
                           ∧ ¬(MetricSpace.distance(f(x), f(q)) < tolerance)),
            badPairs);
    ∀ (k : ℕ). p(k) ∈ region by { take k : ℕ; done by chosenP };
    ∀ (n : ℕ). ∃ (z : source). z ∈ region
        ∧ (MetricSpace.distance(p(n), z) < Real.harmonic_term(n)
               ∧ ¬(MetricSpace.distance(f(p(n)), f(z)) < tolerance))
        by { take n : ℕ; done by chosenP }
        as partners;
    choose q such that
        ∀ (n : ℕ). q(n) ∈ region
            ∧ (MetricSpace.distance(p(n), q(n)) < Real.harmonic_term(n)
                   ∧ ¬(MetricSpace.distance(f(p(n)), f(q(n))) < tolerance))
        as chosenQ
        from Logic.countable_choice(
            source,
            (n : ℕ) (z : source) ↦ z ∈ region
                ∧ (MetricSpace.distance(p(n), z) < Real.harmonic_term(n)
                       ∧ ¬(MetricSpace.distance(f(p(n)), f(z)) < tolerance)),
            partners);
    ∀ (k : ℕ). q(k) ∈ region by { take k : ℕ; done by chosenQ };

    -- The pairs close on each other, so one thinning carries both to the
    -- same limit.
    ∀ (n : ℕ). MetricSpace.distance(p(n), q(n)) < Real.harmonic_term(n)
        by {
          take n : ℕ;
          q(n) ∈ region
              ∧ (MetricSpace.distance(p(n), q(n)) < Real.harmonic_term(n)
                     ∧ ¬(MetricSpace.distance(f(p(n)), f(q(n))) < tolerance))
              by chosenQ;
          done
        };
    choose index : ℕ → ℕ, limit : source such that
        (limit ∈ region ∧ limit ∈ region)
        ∧ (MetricSpace.SequenceConverges((k : ℕ) ↦ p(index(k)), limit)
               ∧ MetricSpace.SequenceConverges((k : ℕ) ↦ q(index(k)), limit))
        from MetricSpace.closing_pairs_share_a_limit;
    limit ∈ region;
    MetricSpace.SequenceConverges((k : ℕ) ↦ p(index(k)), limit) as toLimitP;
    MetricSpace.SequenceConverges((k : ℕ) ↦ q(index(k)), limit) as toLimitQ;

    -- Continuity at the common limit puts both values within half the
    -- tolerance of the value there — so within the tolerance of each
    -- other, which the pairs were built to contradict.
    (2 : ℝ) ≠ 0;
    tolerance / 2 > 0 by Real.divide_positive;
    choose nearness such that
        nearness > 0 ∧
        ∀ (y : source). y ∈ region →
          MetricSpace.distance(limit, y) < nearness
            → MetricSpace.distance(f(limit), f(y)) < tolerance / 2
        from continuous;
    nearness > 0 as nearnessPositive;
    ∀ (y : source). y ∈ region →
        MetricSpace.distance(limit, y) < nearness
          → MetricSpace.distance(f(limit), f(y)) < tolerance / 2
        as valuesClose;
    choose thresholdP such that
        ∀ (k : ℕ). thresholdP ≤ k →
            MetricSpace.distance(limit, p(index(k))) < nearness
        as nearP from toLimitP(nearness, nearnessPositive);
    choose thresholdQ such that
        ∀ (k : ℕ). thresholdQ ≤ k →
            MetricSpace.distance(limit, q(index(k))) < nearness
        as nearQ from toLimitQ(nearness, nearnessPositive);
    let far : ℕ := Natural.maximum(thresholdP, thresholdQ);
    thresholdP ≤ far;
    thresholdQ ≤ far;
    let deep : ℕ := index(far);
    MetricSpace.distance(limit, p(deep)) < nearness by nearP;
    MetricSpace.distance(limit, q(deep)) < nearness by nearQ;
    MetricSpace.distance(f(limit), f(p(deep))) < tolerance / 2 by valuesClose;
    MetricSpace.distance(f(limit), f(q(deep))) < tolerance / 2 by valuesClose;
    MetricSpace.distance(f(p(deep)), f(limit))
        = MetricSpace.distance(f(limit), f(p(deep)))
        by MetricSpace.distance_symmetric;
    tolerance / 2 + tolerance / 2 = tolerance by Real.divide_two_doubled;
    MetricSpace.distance(f(p(deep)), f(q(deep)))
       ≤ MetricSpace.distance(f(p(deep)), f(limit))
             + MetricSpace.distance(f(limit), f(q(deep)))
             by MetricSpace.distance_triangle
       < tolerance / 2 + tolerance / 2 by ordered_field
       = tolerance;
    q(deep) ∈ region
        ∧ (MetricSpace.distance(p(deep), q(deep)) < Real.harmonic_term(deep)
               ∧ ¬(MetricSpace.distance(f(p(deep)), f(q(deep))) < tolerance))
        by chosenQ;
    ¬(MetricSpace.distance(f(p(deep)), f(q(deep))) < tolerance);
    done
  };
  done
}
