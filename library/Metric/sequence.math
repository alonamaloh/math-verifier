-- Metric/sequence.math
--
-- Sequences in a metric space: convergence, boundedness, and thinning.
-- Nothing here is about any particular space — a limit is a point every
-- tail eventually stays within ε of, and that is the same sentence on
-- the line, in the plane, and on an arc.

module Metric.sequence

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Natural.basics
import Natural.order
import Natural.eventually
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.convergence
import Metric.space

definition MetricSpace.SequenceConverges {m : MetricSpace}
        (s : ℕ → m) (limit : m)
        : Proposition :=
  ∀ (tolerance : ℝ). tolerance > 0 →
    eventually (k). distance(limit, s(k)) < tolerance

-- Bounded: the distances between its own points do not exceed some
-- bound. Said this way it asks for no centre, hence for no point at all,
-- so the empty set is bounded — and no theorem about boundedness has to
-- take a point of the space as an argument in order to measure from it.
definition MetricSpace.IsBounded {m : MetricSpace}
        (region : Set(m)) : Proposition :=
  ∃ (bound : ℝ). ∀ (x : m). x ∈ region →
    ∀ (y : m). y ∈ region → distance(x, y) ≤ bound

-- Bounded ABOUT A CENTRE is the working form, and the two cross freely:
-- twice a radius bounds the distances inside it, and a point of the
-- region measures them from itself.

theorem MetricSpace.IsBounded.of_centre (m : MetricSpace)
        (region : Set(m)) (centre : m) (bound : ℝ)
        (inBall : ∀ (x : m). x ∈ region → distance(centre, x) ≤ bound)
        : MetricSpace.IsBounded(region) := {
  ∀ (x : m). x ∈ region → ∀ (y : m). y ∈ region →
      distance(x, y) ≤ bound + bound
      by { take x : m;
           suppose x ∈ region;
           take y : m;
           suppose y ∈ region;
           distance(centre, x) ≤ bound by inBall;
           distance(centre, y) ≤ bound by inBall;
           distance(x, y)
              ≤ distance(x, centre) + distance(centre, y)
                    by MetricSpace.distance_triangle
              = distance(centre, x) + distance(centre, y)
                    by substituting MetricSpace.distance_symmetric(m, x, centre)
              ≤ bound + bound;
           done };
  witness bound + bound
}

theorem MetricSpace.IsBounded.about (m : MetricSpace)
        (region : Set(m)) (centre : m) (inRegion : centre ∈ region)
        (bounded : MetricSpace.IsBounded(region))
        : ∃ (bound : ℝ). ∀ (x : m). x ∈ region →
            distance(centre, x) ≤ bound := {
  choose bound such that
      ∀ (x : m). x ∈ region → ∀ (y : m). y ∈ region → distance(x, y) ≤ bound
      from bounded;
  ∀ (x : m). x ∈ region → distance(centre, x) ≤ bound
      by { take x : m;
           suppose x ∈ region;
           done };
  witness bound
}

definition MetricSpace.SequenceIsBounded {m : MetricSpace}
        (s : ℕ → m) : Proposition :=
  ∃ (centre : m). ∃ (bound : ℝ).
    ∀ (k : ℕ). distance(centre, s(k)) ≤ bound

-- ----------------------------------------------------------------------
-- Limits are unique: two limits are closer than every tolerance, so at
-- distance zero, so the same point. This is where separation earns its
-- place among the axioms.

theorem MetricSpace.SequenceConverges.unique (m : MetricSpace)
        (s : ℕ → m) (limit other : m)
        (toLimit : MetricSpace.SequenceConverges(s, limit))
        (toOther : MetricSpace.SequenceConverges(s, other))
        : limit = other := {
  distance(limit, other) = 0 by {
    suppose ¬(distance(limit, other) = 0) for contradiction;
    distance(limit, other) ≥ 0 by MetricSpace.distance_nonneg;
    distance(limit, other) > 0;
    distance(limit, other) / 2 > 0;
    eventually (k). distance(limit, s(k)) < distance(limit, other) / 2
        by toLimit;
    eventually (k). distance(other, s(k)) < distance(limit, other) / 2
        by toOther;
    -- Both tails hold at once past some index, and there the triangle
    -- inequality makes the gap smaller than itself.
    eventually (k). False
        by for k sufficiently large: {
             distance(s(k), other) = distance(other, s(k))
                 by MetricSpace.distance_symmetric;
             distance(limit, other)
                ≤ distance(limit, s(k)) + distance(s(k), other)
                      by MetricSpace.distance_triangle
                = distance(limit, s(k)) + distance(other, s(k))
                < distance(limit, other) / 2 + distance(limit, other) / 2
                = distance(limit, other);
             done
           };
    done by Natural.Eventually.not_eventually_false
  };
  done by MetricSpace.equal_of_distance_zero
}

-- Convergence sees only the values, so a sequence that agrees with a
-- convergent one at every index converges to the same limit. This is what
-- a proof reaches for instead of rewriting one sequence into the other by
-- function extensionality.
theorem MetricSpace.SequenceConverges.of_pointwise_equal (m : MetricSpace)
        (s t : ℕ → m) (limit : m)
        (agree : ∀ (k : ℕ). s(k) = t(k))
        (converges : MetricSpace.SequenceConverges(s, limit))
        : MetricSpace.SequenceConverges(t, limit) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  eventually (k). distance(limit, s(k)) < tolerance by converges;
  for k sufficiently large: {
    s(k) = t(k) by agree;
    distance(limit, t(k))
       = distance(limit, s(k))
       < tolerance;
    done
  }
}

-- ----------------------------------------------------------------------
-- Thinning, as a named relation.

definition MetricSpace.SubsequenceConverges {m : MetricSpace}
        (s : ℕ → m) (index : ℕ → ℕ)
        (limit : m)
        : Proposition :=
  Natural.IsStrictlyIncreasing(index)
  ∧ MetricSpace.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)

theorem MetricSpace.SubsequenceConverges.increasing (m : MetricSpace)
        (s : ℕ → m) (index : ℕ → ℕ)
        (limit : m)
        (thins : MetricSpace.SubsequenceConverges(s, index, limit))
        : Natural.IsStrictlyIncreasing(index) :=
  unfold MetricSpace.SubsequenceConverges in {
    Natural.IsStrictlyIncreasing(index);
    done
  }

theorem MetricSpace.SubsequenceConverges.converges (m : MetricSpace)
        (s : ℕ → m) (index : ℕ → ℕ)
        (limit : m)
        (thins : MetricSpace.SubsequenceConverges(s, index, limit))
        : MetricSpace.SequenceConverges((k : ℕ) ↦ s(index(k)), limit) :=
  unfold MetricSpace.SubsequenceConverges in {
    MetricSpace.SequenceConverges((k : ℕ) ↦ s(index(k)), limit);
    done
  }

-- Thinning preserves a limit: an index map never falls behind its own
-- index, so the subsequence reaches every threshold the sequence does.
theorem MetricSpace.SequenceConverges.subsequence (m : MetricSpace)
        (s : ℕ → m) (limit : m)
        (index : ℕ → ℕ)
        (converges : MetricSpace.SequenceConverges(s, limit))
        (increasing : Natural.IsStrictlyIncreasing(index))
        : MetricSpace.SequenceConverges((k : ℕ) ↦ s(index(k)), limit) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  eventually (n). distance(limit, s(n)) < tolerance by converges;
  done by Natural.Eventually.thinned
}
