-- Universal/star_power.math
--
-- The star powers `t^{*ℓ}` of the centrality proof, and the index type that
-- makes them cheap.
--
-- Indexed by `NaturalsBelow(k^ℓ)`, a star power's block decomposition would be
-- Euclidean division: every `p` below `k^(ℓ+1)` is uniquely `(j-1)k^ℓ + q`.
-- Indexed instead by `StarIndex(k, ℓ) = NaturalsBelow(ℓ) → NaturalsBelow(k)` —
-- there are `k^ℓ` of those too — the block of an index is its value at the
-- first coordinate and its position is the rest, so the decomposition is
-- `NaturalsBelow.first` / `NaturalsBelow.shiftUp` and nothing is divided. This
-- is Definition 2.8 of the blueprint, in the form Remark 2.9 argues for.
--
-- Nothing here needs the count `k^ℓ`. Absorption takes its witness over an
-- arbitrary variable type (`Universal.Witnesses`), and a numeric arity is
-- recovered once, at the end, by `Universal.Absorbs.of_renaming`.

module Universal.star_power

import axioms
import Logic.basics
import Logic.functions
import Equality.basics
import Natural.basics
import Natural.order
import Natural.classical_decidable
import Set.basics
import Set.finite
import Set.finite_successor
import Universal.signature
import Universal.term

-- ── The index type ────────────────────────────────────────────────────

-- The variables of a star power at depth `depth`: a block choice for each of
-- the `depth` levels of nesting.
definition Universal.StarIndex (arity depth : ℕ) : Type(0) :=
  NaturalsBelow(depth) → NaturalsBelow(arity)

-- Depth zero has exactly one index — the empty function — so `t^{*0}` is a
-- single variable, as the blueprint's `x_∅`.
definition Universal.emptyStarIndex (arity : ℕ) : Universal.StarIndex(arity, 0) :=
  (index : NaturalsBelow(0)) ↦
    False.eliminate(NaturalsBelow(arity), NaturalsBelow.zero_is_empty(index))

-- The block inclusion `ρ^ℓ_j`: prepend the block number `block` to an index one
-- level shallower. Reading the definition backwards, the block of an index is
-- what it does at the first coordinate.
-- The index is a parameter rather than the body's lambda binder, so that a
-- fully applied `starPrepend(…, index)` has the conditional at its head, which
-- is what the characterising equations below need. They cite the *dependent*
-- conditional lemmas: the else branch consumes the branch hypothesis — that is
-- how it knows the index can be dropped — so `Logic.if_negative`, whose
-- branches are constants, does not apply. Partially applied, `starPrepend` is
-- the block inclusion itself, of type `StarIndex(arity, 1 + depth)`.
definition Universal.starPrepend (arity depth : ℕ)
        (block : NaturalsBelow(arity))
        (position : Universal.StarIndex(arity, depth))
        (index : NaturalsBelow(1 + depth))
        : NaturalsBelow(arity) :=
  if NaturalsBelow.value(index) = 0
  then block
  else { ¬(NaturalsBelow.value(index) = 0) as nonzero;
         position(NaturalsBelow.dropFirst(index, nonzero)) }

-- The characterising equations, on the two shapes an index can have.
theorem Universal.starPrepend_first {arity depth : ℕ}
        (block : NaturalsBelow(arity))
        (position : Universal.StarIndex(arity, depth))
        : Universal.starPrepend(arity, depth, block, position, NaturalsBelow.first) = block := {
  NaturalsBelow.value((NaturalsBelow.first : NaturalsBelow(1 + depth))) = 0
      by NaturalsBelow.first_value;
  done by Logic.if_positive_dependent
}

theorem Universal.starPrepend_shift {arity depth : ℕ}
        (block : NaturalsBelow(arity))
        (position : Universal.StarIndex(arity, depth))
        (lower : NaturalsBelow(depth))
        : Universal.starPrepend(arity, depth, block, position, NaturalsBelow.shiftUp(lower))
          = position(lower) := {
  ¬(NaturalsBelow.value(NaturalsBelow.shiftUp(lower)) = 0)
      by NaturalsBelow.shiftUp_nonzero as nonzero;
  NaturalsBelow.dropFirst(NaturalsBelow.shiftUp(lower), nonzero) = lower
      by NaturalsBelow.dropFirst_shiftUp as dropsBack;
  Universal.starPrepend(arity, depth, block, position, NaturalsBelow.shiftUp(lower))
     = position(NaturalsBelow.dropFirst(NaturalsBelow.shiftUp(lower), nonzero))
           by Logic.if_negative_dependent
     = position(lower)
           by substituting dropsBack;
  done
}

-- ── Reading an index back apart ───────────────────────────────────────

definition Universal.starHead (arity depth : ℕ)
        (index : Universal.StarIndex(arity, 1 + depth)) : NaturalsBelow(arity) :=
  index(NaturalsBelow.first)

definition Universal.starTail (arity depth : ℕ)
        (index : Universal.StarIndex(arity, 1 + depth))
        : Universal.StarIndex(arity, depth) :=
  (lower : NaturalsBelow(depth)) ↦ index(NaturalsBelow.shiftUp(lower))

theorem Universal.starHead_prepend {arity depth : ℕ}
        (block : NaturalsBelow(arity))
        (position : Universal.StarIndex(arity, depth))
        : Universal.starHead(arity, depth, Universal.starPrepend(arity, depth, block, position)) = block :=
  done by Universal.starPrepend_first

theorem Universal.starTail_prepend {arity depth : ℕ}
        (block : NaturalsBelow(arity))
        (position : Universal.StarIndex(arity, depth))
        : Universal.starTail(arity, depth, Universal.starPrepend(arity, depth, block, position)) = position := {
  ∀ (lower : NaturalsBelow(depth)).
      Universal.starPrepend(arity, depth, block, position, NaturalsBelow.shiftUp(lower))
        = position(lower)
      by Universal.starPrepend_shift;
  done by Function.extensionality
}

-- Prepending the head back onto the tail recovers the index: every index at
-- depth `1 + depth` sits in exactly one block, at exactly one position.
theorem Universal.starPrepend_head_tail {arity depth : ℕ}
        (index : Universal.StarIndex(arity, 1 + depth))
        : Universal.starPrepend(arity, depth, Universal.starHead(arity, depth, index),
                                Universal.starTail(arity, depth, index)) = index := {
  ∀ (subject : NaturalsBelow(1 + depth)).
      Universal.starPrepend(arity, depth, Universal.starHead(arity, depth, index),
                            Universal.starTail(arity, depth, index), subject)
        = index(subject)
      by { take subject : NaturalsBelow(1 + depth);
           subject = NaturalsBelow.first
             ∨ ∃ (lower : NaturalsBelow(depth)). subject = NaturalsBelow.shiftUp(lower)
             by NaturalsBelow.first_or_shift;
           done by cases {
             case subject = NaturalsBelow.first as isFirst: {
                 Universal.starPrepend(arity, depth, Universal.starHead(arity, depth, index),
                                       Universal.starTail(arity, depth, index),
                                       NaturalsBelow.first)
                    = Universal.starHead(arity, depth, index)
                          by Universal.starPrepend_first
                    = index(NaturalsBelow.first);
                 done by substituting isFirst
               }
             case ∃ (lower : NaturalsBelow(depth)). subject = NaturalsBelow.shiftUp(lower)
                    as isShift: {
                 choose lower such that subject = NaturalsBelow.shiftUp(lower)
                     from isShift;
                 Universal.starPrepend(arity, depth, Universal.starHead(arity, depth, index),
                                       Universal.starTail(arity, depth, index),
                                       NaturalsBelow.shiftUp(lower))
                    = Universal.starTail(arity, depth, index, lower)
                          by Universal.starPrepend_shift
                    = index(NaturalsBelow.shiftUp(lower));
                 done by substituting (subject = NaturalsBelow.shiftUp(lower))
               }
           } };
  done by Function.extensionality
}

-- Distinct blocks give distinct indices — the block inclusions have disjoint
-- images, which is what the centrality induction needs to know that only one
-- block carries the free variable.
theorem Universal.starPrepend_injective {arity depth : ℕ}
        (block otherBlock : NaturalsBelow(arity))
        (position otherPosition : Universal.StarIndex(arity, depth))
        (agree : Universal.starPrepend(arity, depth, block, position)
                 = Universal.starPrepend(arity, depth, otherBlock, otherPosition))
        : block = otherBlock ∧ position = otherPosition := {
  block
     = Universal.starHead(arity, depth, Universal.starPrepend(arity, depth, block, position))
           by Universal.starHead_prepend
     = Universal.starHead(arity, depth, Universal.starPrepend(arity, depth, otherBlock, otherPosition))
           by substituting agree
     = otherBlock
           by Universal.starHead_prepend;
  position
     = Universal.starTail(arity, depth, Universal.starPrepend(arity, depth, block, position))
           by Universal.starTail_prepend
     = Universal.starTail(arity, depth, Universal.starPrepend(arity, depth, otherBlock, otherPosition))
           by substituting agree
     = otherPosition
           by Universal.starTail_prepend;
  done
}


-- ── One level of a star power ─────────────────────────────────────────
--
-- The blueprint writes `t^{*ℓ}` as a recursion on `ℓ`, and a recursive
-- *definition* is what one would reach for. It is not available: the result
-- type mentions `depth`, so the recursion is dependent, and the `1 + rest` arm
-- would have to produce a `StarIndex(arity, successor(rest))` from a
-- `StarIndex(arity, 1 + rest)`. `Natural.add` is opaque, so those two are not
-- definitionally equal and no amount of arranging the arithmetic makes them so.
--
-- What is published instead is the base term and one level of the recursion, as
-- ordinary non-recursive definitions. The iteration then happens inside a proof
-- — `by induction on depth`, whose equation-shaped arms *rewrite* the goal to
-- the `1 + rest` form rather than needing it to reduce — which is where the
-- centrality argument wants it anyway, since it carries an invariant up the
-- levels rather than just a term.

-- `t^{*0}`: the single variable of the one-point index type.
definition Universal.starBase (signature : Universal.Signature) (arity : ℕ)
        : Universal.Term(signature, Universal.StarIndex(arity, 0)) :=
  Universal.Term.variable(signature, Universal.StarIndex(arity, 0),
    Universal.emptyStarIndex(arity))

theorem Universal.starBase_evaluate (signature : Universal.Signature)
        (arity : ℕ) (a : Universal.Algebra(signature))
        (valuation : Universal.StarIndex(arity, 0)
                     → Universal.Algebra.carrier(a))
        : Universal.Term.evaluate(a, valuation,
            Universal.starBase(signature, arity))
          = valuation(Universal.emptyStarIndex(arity)) :=
  done

-- One level: substitute a copy of `inner`, reindexed into block `j`, for the
-- variable `x_j` of `subject`. Taking `inner` to be the previous level's star
-- power gives the blueprint's `t^{*(ℓ+1)} = t[t^{*ℓ}[ρ_1], …, t^{*ℓ}[ρ_k]]`.
definition Universal.starStep (signature : Universal.Signature) (arity rest : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (inner : Universal.Term(signature, Universal.StarIndex(arity, rest)))
        : Universal.Term(signature, Universal.StarIndex(arity, 1 + rest)) :=
  Universal.Term.substitute(
    (block : NaturalsBelow(arity)) ↦
      Universal.Term.rename(
        (position : Universal.StarIndex(arity, rest)) ↦
          Universal.starPrepend(arity, rest, block, position),
        inner),
    subject)

-- The evaluation law, which is the whole content of the construction: one level
-- evaluates `subject` at the `arity` values obtained by evaluating `inner` on
-- each block.
theorem Universal.starStep_evaluate (signature : Universal.Signature)
        (arity rest : ℕ)
        (a : Universal.Algebra(signature))
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (inner : Universal.Term(signature, Universal.StarIndex(arity, rest)))
        (valuation : Universal.StarIndex(arity, 1 + rest)
                     → Universal.Algebra.carrier(a))
        : Universal.Term.evaluate(a, valuation,
            Universal.starStep(signature, arity, rest, subject, inner))
          = Universal.Term.evaluate(a,
              (block : NaturalsBelow(arity)) ↦
                Universal.Term.evaluate(a,
                  (position : Universal.StarIndex(arity, rest)) ↦
                    valuation(Universal.starPrepend(arity, rest, block, position)),
                  inner),
              subject) := {
  ∀ (block : NaturalsBelow(arity)).
      Universal.Term.evaluate(a, valuation,
          Universal.Term.rename(
            (position : Universal.StarIndex(arity, rest)) ↦
              Universal.starPrepend(arity, rest, block, position),
            inner))
        = Universal.Term.evaluate(a,
            (position : Universal.StarIndex(arity, rest)) ↦
              valuation(Universal.starPrepend(arity, rest, block, position)),
            inner)
      by Universal.Term.evaluate_rename;
  ((block : NaturalsBelow(arity)) ↦
      Universal.Term.evaluate(a, valuation,
        Universal.Term.rename(
          (position : Universal.StarIndex(arity, rest)) ↦
            Universal.starPrepend(arity, rest, block, position),
          inner)))
    = ((block : NaturalsBelow(arity)) ↦
        Universal.Term.evaluate(a,
          (position : Universal.StarIndex(arity, rest)) ↦
            valuation(Universal.starPrepend(arity, rest, block, position)),
          inner))
    by Function.extensionality as blockwise;
  Universal.Term.evaluate(a, valuation,
      Universal.starStep(signature, arity, rest, subject, inner))
     = Universal.Term.evaluate(a,
         (block : NaturalsBelow(arity)) ↦
           Universal.Term.evaluate(a, valuation,
             Universal.Term.rename(
               (position : Universal.StarIndex(arity, rest)) ↦
                 Universal.starPrepend(arity, rest, block, position),
               inner)),
         subject)
           by Universal.Term.evaluate_substitute
     = Universal.Term.evaluate(a,
         (block : NaturalsBelow(arity)) ↦
           Universal.Term.evaluate(a,
             (position : Universal.StarIndex(arity, rest)) ↦
               valuation(Universal.starPrepend(arity, rest, block, position)),
             inner),
         subject)
           by substituting blockwise;
  done
}
