-- Universal/essential.math
--
-- Essential relations: the obstruction to absorption.
--
-- A relation over an index type is `parts`-essential when it reaches outside
-- `parts` at every single coordinate — for each coordinate there is a member
-- lying in `parts` everywhere *else* — and yet no member lies in `parts`
-- everywhere. Blueprint Definition 3.1.
--
-- The two clauses are stated over an arbitrary index type rather than over
-- `NaturalsBelow(m)`, matching Definition 1.8's decision for products: the
-- relational description of absorption forms a power indexed by a set of
-- tuples, and an initial-segment-only notion would force a transport there.
-- Where a *choice* of one witness per coordinate is needed the index does come
-- back to `NaturalsBelow(m)`, since finite choice is what the library supplies.
--
-- The headline of this file is `Universal.no_essential_of_witnesses`, blueprint
-- Proposition 3.6: a term witnessing absorption forbids an essential relation
-- on the same index. The proof is the one move that makes Part II work —
-- evaluate the witnessing term *in the power*, at the tuple of witnesses.

module Universal.essential

import axioms
import Logic.basics
import Logic.exists
import Logic.functions
import Equality.basics
import Natural.basics
import Natural.order
import Set.basics
import Set.algebra
import Set.finite
import Set.finite_successor
import Set.finite_choice
import Universal.signature
import Universal.term
import Universal.product
import Universal.relation
import Universal.absorption

convention signature : Universal.Signature

-- ── The definition ────────────────────────────────────────────────────

-- Free at every coordinate, but nowhere entirely inside.
definition Universal.IsEssential
        (a : Universal.Algebra(signature)) (index : Type(0))
        (parts : index → Set(a))
        (relation : Set(a ^ index))
        : Proposition := (∀ (free : index). ∃ (tuple : a ^ index). tuple ∈ relation
       ∧ ∀ (other : index). other ≠ free → tuple(other) ∈ parts(other)) ∧ ¬(∃ (tuple : a ^ index). tuple ∈ relation
        ∧ ∀ (coordinate : index). tuple(coordinate) ∈ parts(coordinate))

-- ── Essentiality forces the parts nonempty ────────────────────────────

-- Blueprint Lemma 3.4. The witness freed at *some other* coordinate lies in
-- `parts` at this one. Stated with the other coordinate supplied rather than as
-- a cardinality hypothesis on the index: "at least two coordinates" is exactly
-- "there is one different from this one", and that is what the proof uses.
theorem Universal.IsEssential.parts_nonempty
        (a : Universal.Algebra(signature)) (index : Type(0))
        (parts : index → Set(a))
        (relation : Set(a ^ index))
        (essential : Universal.IsEssential(a, index, parts, relation))
        (coordinate other : index) (distinct : other ≠ coordinate)
        : Set.IsNonempty(a, parts(coordinate)) := {
  ∀ (free : index). ∃ (tuple : a ^ index). tuple ∈ relation ∧ ∀ (place : index). place ≠ free → tuple(place) ∈ parts(place)
      as freeAtEach;
  choose tuple such that tuple ∈ relation ∧ ∀ (place : index). place ≠ other → tuple(place) ∈ parts(place)
      from freeAtEach(other);
  ∀ (place : index). place ≠ other → tuple(place) ∈ parts(place);
  coordinate ≠ other;
  tuple(coordinate) ∈ parts(coordinate);
  witness tuple(coordinate)
}

-- ── Absorption forbids essential relations ────────────────────────────

-- Blueprint Proposition 3.6. Apply the witnessing term in the power to the
-- tuple of witnesses: preservation puts the result in the relation, and at each
-- coordinate its arguments are exactly what `Universal.Witnesses` asks for —
-- one entry free, all the others in `subset` — so the result lies in `subset`
-- at every coordinate too. That contradicts the second clause.
--
-- The index is `NaturalsBelow(arity)` because the proof chooses one witness per
-- coordinate; `NaturalsBelow.choice` is the choice principle available.
theorem Universal.no_essential_of_witnesses
        (a : Universal.Algebra(signature)) (arity : ℕ)
        (subset : Set(a))
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (witnesses : Universal.Witnesses(a, subset, Universal.universe(a), subject))
        (relation : Set(a ^ NaturalsBelow(arity)))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(arity), relation))
        (essential : Universal.IsEssential(a, NaturalsBelow(arity), ((slot : NaturalsBelow(arity)) ↦ subset), relation))
        : False := {
  ∀ (free : NaturalsBelow(arity)). ∃ (tuple : a ^ NaturalsBelow(arity)). tuple ∈ relation
        ∧ ∀ (other : NaturalsBelow(arity)). other ≠ free → tuple(other) ∈ subset
      as freeAtEach;
  choose chosen such that ∀ (free : NaturalsBelow(arity)). chosen(free) ∈ relation ∧ ∀ (other : NaturalsBelow(arity)).
            other ≠ free → chosen(free)(other) ∈ subset
      from NaturalsBelow.choice(a ^ NaturalsBelow(arity), arity, ((free : NaturalsBelow(arity)) ↦
          (candidate : a ^ NaturalsBelow(arity)) ↦ candidate ∈ relation ∧ ∀ (other : NaturalsBelow(arity)).
                other ≠ free → candidate(other) ∈ subset), freeAtEach);
  -- The value of the witnessing term at the tuple of witnesses, computed in the
  -- power. Preservation keeps it in the relation.
  ∀ (free : NaturalsBelow(arity)). chosen(free) ∈ relation
      by { take free : NaturalsBelow(arity);
           chosen(free) ∈ relation ∧ ∀ (other : NaturalsBelow(arity)). other ≠ free → chosen(free)(other) ∈ subset;
           done };
  Universal.Term.evaluate(a ^ NaturalsBelow(arity), chosen, subject) ∈ relation by Universal.Term.evaluate_mem;
  -- And at every coordinate its arguments meet the witnessing condition, with
  -- the free entry sitting in that very coordinate.
  ∀ (coordinate : NaturalsBelow(arity)). Universal.Term.evaluate(a ^ NaturalsBelow(arity), chosen, subject)(coordinate) ∈ subset
      by { take coordinate : NaturalsBelow(arity);
           ((slot : NaturalsBelow(arity)) ↦ chosen(slot)(coordinate))(coordinate)
               ∈ Universal.universe(a);
           ∀ (slot : NaturalsBelow(arity)). slot ≠ coordinate → ((place : NaturalsBelow(arity)) ↦ chosen(place)(coordinate))(slot)
                 ∈ subset
               by { take slot : NaturalsBelow(arity);
                    suppose slot ≠ coordinate as slotDiffers;
                    chosen(slot) ∈ relation ∧ ∀ (other : NaturalsBelow(arity)). other ≠ slot → chosen(slot)(other) ∈ subset;
                    ∀ (other : NaturalsBelow(arity)). other ≠ slot → chosen(slot)(other) ∈ subset;
                    coordinate ≠ slot
                        by { suppose coordinate = slot as sameSlot;
                             slot = coordinate;
                             done };
                    chosen(slot)(coordinate) ∈ subset;
                    done };
           Universal.Term.evaluate(a, ((slot : NaturalsBelow(arity)) ↦ chosen(slot)(coordinate)), subject) ∈ subset by witnesses;
           Universal.Term.evaluate(a ^ NaturalsBelow(arity), chosen, subject)(coordinate)
              = Universal.Term.evaluate(a, ((slot : NaturalsBelow(arity)) ↦ chosen(slot)(coordinate)), subject)
              by Universal.Term.evaluate_power as coordinatewise;
           done by substituting coordinatewise };
  -- Which is a member of the relation lying inside the box: the second clause
  -- of essentiality says there is none.
  ∃ (tuple : a ^ NaturalsBelow(arity)). tuple ∈ relation ∧ ∀ (coordinate : NaturalsBelow(arity)). tuple(coordinate) ∈ subset
      by { witness Universal.Term.evaluate(a ^ NaturalsBelow(arity), chosen, subject) };
  done
}

-- ── Passing to a smaller index ────────────────────────────────────────

-- The tuples whose first coordinate lies in `subset`. The blueprint intersects
-- with the box `A × ⋯ × A × S_m`; since every other factor is the whole carrier,
-- naming the one constrained coordinate is the same condition and shorter.
definition Universal.firstCoordinateIn
        (a : Universal.Algebra(signature)) (bound : ℕ)
        (subset : Set(a))
        : Set(a ^ NaturalsBelow(1 + bound)) :=
  (tuple : a ^ NaturalsBelow(1 + bound)) ↦ tuple(NaturalsBelow.first) ∈ subset

theorem Universal.IsSubuniverse.firstCoordinateIn
        (a : Universal.Algebra(signature)) (bound : ℕ)
        (subset : Set(a))
        (closed : Universal.IsSubuniverse(a, subset))
        : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound),
            Universal.firstCoordinateIn(a, bound, subset)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → a ^ NaturalsBelow(1 + bound);
  suppose ∀ (slot : NaturalsBelow(arity)). arguments(slot) ∈ Universal.firstCoordinateIn(a, bound, subset) as allInside;
  ∀ (slot : NaturalsBelow(arity)). arguments(slot)(NaturalsBelow.first) ∈ subset by allInside;
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ arguments(slot)(NaturalsBelow.first)))
      ∈ subset;
  done
}

-- Delete the first coordinate: keep the members whose first coordinate is
-- inside, then forget it. Blueprint Proposition 3.5 deletes the last
-- coordinate; which one goes is immaterial, and the first is the one
-- `NaturalsBelow.shiftUp` makes cheap.
definition Universal.deleteFirst
        (a : Universal.Algebra(signature)) (bound : ℕ)
        (subset : Set(a))
        (relation : Set(a ^ NaturalsBelow(1 + bound)))
        : Set(a ^ NaturalsBelow(bound)) := Universal.project(a, NaturalsBelow(1 + bound), NaturalsBelow(bound),
    NaturalsBelow.shiftUp, relation ∩ Universal.firstCoordinateIn(a, bound, subset))

theorem Universal.IsSubuniverse.deleteFirst
        (a : Universal.Algebra(signature)) (bound : ℕ)
        (subset : Set(a))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (relation : Set(a ^ NaturalsBelow(1 + bound)))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound), relation))
        : Universal.IsSubuniverse(a ^ NaturalsBelow(bound),
            Universal.deleteFirst(a, bound, subset, relation)) := {
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound), Universal.firstCoordinateIn(a, bound, subset))
      by Universal.IsSubuniverse.firstCoordinateIn;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound), relation ∩ Universal.firstCoordinateIn(a, bound, subset))
      by Universal.IsSubuniverse.intersection;
  done by Universal.IsSubuniverse.project
}

-- Blueprint Proposition 3.5: deleting a coordinate keeps essentiality.
--
-- (E1) The original witness freed at `shiftUp(free)` already lies inside at the
-- first coordinate — `shiftUp` never lands there — so it survives the
-- intersection, and its restriction is free exactly at `free`, because `shiftUp`
-- is injective. (E2) A restriction lying inside everywhere lifts to a member
-- lying inside everywhere: at the first coordinate by the intersection, and at
-- every other coordinate because every index is `first` or a shift.
theorem Universal.IsEssential.deleteFirst
        (a : Universal.Algebra(signature)) (bound : ℕ)
        (parts : NaturalsBelow(1 + bound) → Set(a))
        (relation : Set(a ^ NaturalsBelow(1 + bound)))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + bound), parts, relation))
        : Universal.IsEssential(a, NaturalsBelow(bound), ((slot : NaturalsBelow(bound)) ↦ parts(NaturalsBelow.shiftUp(slot))),
            Universal.deleteFirst(a, bound, parts(NaturalsBelow.first),
              relation)) := {
  ∀ (free : NaturalsBelow(1 + bound)). ∃ (tuple : a ^ NaturalsBelow(1 + bound)). tuple ∈ relation
        ∧ ∀ (other : NaturalsBelow(1 + bound)). other ≠ free → tuple(other) ∈ parts(other)
      as freeAtEach;
  -- (E1)
  ∀ (free : NaturalsBelow(bound)). ∃ (small : a ^ NaturalsBelow(bound)).
        small ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation) ∧ ∀ (other : NaturalsBelow(bound)).
            other ≠ free → small(other) ∈ parts(NaturalsBelow.shiftUp(other))
      by { take free : NaturalsBelow(bound);
           choose tuple such that tuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + bound)). other ≠ NaturalsBelow.shiftUp(free)
                   → tuple(other) ∈ parts(other)
               from freeAtEach(NaturalsBelow.shiftUp(free));
           tuple ∈ relation;
           ∀ (other : NaturalsBelow(1 + bound)). other ≠ NaturalsBelow.shiftUp(free) → tuple(other) ∈ parts(other)
               as insideElsewhere;
           -- The first coordinate is not the freed one, so it is already inside.
           ¬((NaturalsBelow.first : NaturalsBelow(1 + bound))
               = NaturalsBelow.shiftUp(free))
               by { suppose (NaturalsBelow.first : NaturalsBelow(1 + bound))
                        = NaturalsBelow.shiftUp(free) as firstIsShift;
                    NaturalsBelow.value(NaturalsBelow.shiftUp(free)) ≠ 0 by NaturalsBelow.shiftUp_nonzero;
                    NaturalsBelow.value(NaturalsBelow.shiftUp(free))
                       = NaturalsBelow.value((NaturalsBelow.first : NaturalsBelow(1 + bound)))
                             by substituting firstIsShift
                       = 0 by NaturalsBelow.first_value;
                    done };
           tuple(NaturalsBelow.first) ∈ parts(NaturalsBelow.first) by insideElsewhere;
           tuple ∈ Universal.firstCoordinateIn(a, bound, parts(NaturalsBelow.first));
           tuple ∈ relation
             ∩ Universal.firstCoordinateIn(a, bound, parts(NaturalsBelow.first));
           Universal.restrict(a, NaturalsBelow(1 + bound), NaturalsBelow(bound), NaturalsBelow.shiftUp, tuple)
             ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation)
               by { witness tuple };
           ∀ (other : NaturalsBelow(bound)). other ≠ free → Universal.restrict(a, NaturalsBelow(1 + bound),
                   NaturalsBelow(bound), NaturalsBelow.shiftUp, tuple)(other)
                 ∈ parts(NaturalsBelow.shiftUp(other))
               by { take other : NaturalsBelow(bound);
                    suppose other ≠ free as otherDiffers;
                    NaturalsBelow.shiftUp(other) ≠ NaturalsBelow.shiftUp(free)
                        by { suppose NaturalsBelow.shiftUp(other)
                                 = NaturalsBelow.shiftUp(free) as shiftsAgree;
                             other = free by NaturalsBelow.shiftUp_injective;
                             done };
                    tuple(NaturalsBelow.shiftUp(other))
                        ∈ parts(NaturalsBelow.shiftUp(other))
                        by insideElsewhere;
                    done };
           witness Universal.restrict(a, NaturalsBelow(1 + bound), NaturalsBelow(bound), NaturalsBelow.shiftUp, tuple) };
  -- (E2)
  ¬(∃ (small : a ^ NaturalsBelow(bound)). small ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation)
      ∧ ∀ (coordinate : NaturalsBelow(bound)). small(coordinate) ∈ parts(NaturalsBelow.shiftUp(coordinate)))
      by { suppose ∃ (small : a ^ NaturalsBelow(bound)). small ∈ Universal.deleteFirst(a, bound,
                       parts(NaturalsBelow.first), relation) ∧ ∀ (coordinate : NaturalsBelow(bound)). small(coordinate)
                           ∈ parts(NaturalsBelow.shiftUp(coordinate))
                   as someSmallInside;
           choose small such that small ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation)
               ∧ ∀ (coordinate : NaturalsBelow(bound)). small(coordinate) ∈ parts(NaturalsBelow.shiftUp(coordinate))
               from someSmallInside;
           ∀ (coordinate : NaturalsBelow(bound)). small(coordinate) ∈ parts(NaturalsBelow.shiftUp(coordinate))
               as smallInside;
           small ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation);
           choose big such that big ∈ relation
                 ∩ Universal.firstCoordinateIn(a, bound, parts(NaturalsBelow.first)) ∧ Universal.restrict(a, NaturalsBelow(1 + bound),
                   NaturalsBelow(bound), NaturalsBelow.shiftUp, big) = small
               from (small ∈ Universal.deleteFirst(a, bound, parts(NaturalsBelow.first), relation));
           big ∈ relation
             ∩ Universal.firstCoordinateIn(a, bound, parts(NaturalsBelow.first));
           big ∈ relation;
           big ∈ Universal.firstCoordinateIn(a, bound, parts(NaturalsBelow.first));
           big(NaturalsBelow.first) ∈ parts(NaturalsBelow.first);
           Universal.restrict(a, NaturalsBelow(1 + bound), NaturalsBelow(bound), NaturalsBelow.shiftUp, big) = small as restrictsToSmall;
           -- Every coordinate is the first or a shift, and `big` is inside at both.
           ∀ (coordinate : NaturalsBelow(1 + bound)). big(coordinate) ∈ parts(coordinate)
               by { take coordinate : NaturalsBelow(1 + bound);
                    coordinate = NaturalsBelow.first ∨ ∃ (lower : NaturalsBelow(bound)). coordinate = NaturalsBelow.shiftUp(lower)
                      by NaturalsBelow.first_or_shift;
                    done by cases {
                      case coordinate = NaturalsBelow.first as isFirst:
                          done by substituting isFirst
                      case ∃ (lower : NaturalsBelow(bound)).
                             coordinate = NaturalsBelow.shiftUp(lower) as isShift: {
                          choose lower such that coordinate = NaturalsBelow.shiftUp(lower) from isShift;
                          small(lower) ∈ parts(NaturalsBelow.shiftUp(lower)) by smallInside;
                          big(NaturalsBelow.shiftUp(lower))
                             = Universal.restrict(a, NaturalsBelow(1 + bound), NaturalsBelow(bound), NaturalsBelow.shiftUp, big)(lower)
                             = small(lower) by substituting restrictsToSmall;
                          big(NaturalsBelow.shiftUp(lower))
                              ∈ parts(NaturalsBelow.shiftUp(lower));
                          done by substituting (coordinate
                            = NaturalsBelow.shiftUp(lower))
                        }
                    } };
           ∃ (tuple : a ^ NaturalsBelow(1 + bound)). tuple ∈ relation ∧ ∀ (coordinate : NaturalsBelow(1 + bound)).
                   tuple(coordinate) ∈ parts(coordinate)
               by { witness big };
           done };
  done
}

-- ── Bounded arity ─────────────────────────────────────────────────────
--
-- Wrapping the whole statement in a predicate on ℕ is what makes the descent
-- ordinary. `NaturalsBelow(gap + lower)` is a type built from arithmetic, and
-- `Natural.add` is opaque, so no arm of an induction on `gap` will ever *reduce*
-- it to the shape the next step wants — a transport would be needed at every
-- level. With the arity as a plain argument to a proposition, the same
-- arithmetic is propositional and `by substituting` does it.

definition Universal.HasEssential
        (a : Universal.Algebra(signature))
        (subset : Set(a)) (arity : ℕ) : Proposition := ∃ (relation : Set(a ^ NaturalsBelow(arity))).
    Universal.IsSubuniverse(a ^ NaturalsBelow(arity), relation) ∧ Universal.IsEssential(a, NaturalsBelow(arity),
        ((slot : NaturalsBelow(arity)) ↦ subset), relation)

-- One coordinate down.
theorem Universal.HasEssential.one_less
        (a : Universal.Algebra(signature))
        (subset : Set(a))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (bound : ℕ)
        (has : Universal.HasEssential(a, subset, 1 + bound))
        : Universal.HasEssential(a, subset, bound) := {
  choose relation such that Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound), relation)
      ∧ Universal.IsEssential(a, NaturalsBelow(1 + bound), ((slot : NaturalsBelow(1 + bound)) ↦ subset), relation)
      from has;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + bound), relation);
  Universal.IsEssential(a, NaturalsBelow(1 + bound), ((slot : NaturalsBelow(1 + bound)) ↦ subset), relation);
  Universal.IsSubuniverse(a ^ NaturalsBelow(bound), Universal.deleteFirst(a, bound, subset, relation))
      by Universal.IsSubuniverse.deleteFirst;
  Universal.IsEssential(a, NaturalsBelow(bound), ((slot : NaturalsBelow(bound)) ↦ subset),
      Universal.deleteFirst(a, bound, subset, relation))
      by Universal.IsEssential.deleteFirst;
  witness Universal.deleteFirst(a, bound, subset, relation)
}

-- Any number of coordinates down. Blueprint Proposition 3.5's final sentence.
theorem Universal.HasEssential.descend
        (a : Universal.Algebra(signature))
        (subset : Set(a))
        (subsetClosed : Universal.IsSubuniverse(a, subset)) (gap : ℕ)
        : ∀ (lower : ℕ). Universal.HasEssential(a, subset, gap + lower) → Universal.HasEssential(a, subset, lower) :=
  by induction on gap with IH {
    case gap = 0: {
        take lower : ℕ;
        suppose Universal.HasEssential(a, subset, 0 + lower);
        (0 : ℕ) + lower = lower as noGap;
        done by substituting noGap
      }
    case gap = 1 + rest for some (rest : ℕ): {
        take lower : ℕ;
        suppose Universal.HasEssential(a, subset, (1 + rest) + lower);
        (1 + rest) + lower = 1 + (rest + lower) as regrouped;
        Universal.HasEssential(a, subset, 1 + (rest + lower)) by substituting regrouped;
        Universal.HasEssential(a, subset, rest + lower) by Universal.HasEssential.one_less;
        done by IH
      }
  }

-- Blueprint Corollary 3.7: a witness of arity `arity` bounds every essential
-- arity strictly below it. An essential relation of arity at least `arity`
-- would descend to one of arity exactly `arity`, which Proposition 3.6 forbids.
theorem Universal.HasEssential.bounded_of_witnesses
        (a : Universal.Algebra(signature))
        (subset : Set(a))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (witnesses : Universal.Witnesses(a, subset, Universal.universe(a), subject))
        (candidate : ℕ)
        (has : Universal.HasEssential(a, subset, candidate))
        : candidate < arity := {
  ¬Universal.HasEssential(a, subset, arity)
      by { suppose Universal.HasEssential(a, subset, arity) as hasAtArity;
           choose relation such that Universal.IsSubuniverse(a ^ NaturalsBelow(arity), relation)
               ∧ Universal.IsEssential(a, NaturalsBelow(arity), ((slot : NaturalsBelow(arity)) ↦ subset), relation)
               from hasAtArity;
           Universal.IsSubuniverse(a ^ NaturalsBelow(arity), relation);
           Universal.IsEssential(a, NaturalsBelow(arity), ((slot : NaturalsBelow(arity)) ↦ subset), relation);
           done by Universal.no_essential_of_witnesses };
  ¬(arity ≤ candidate)
      by { suppose arity ≤ candidate as reachesArity;
           choose gap such that candidate = arity + gap
               from Natural.subtraction_witness(arity, candidate, reachesArity);
           candidate = gap + arity as splitOff;
           Universal.HasEssential(a, subset, gap + arity) by substituting splitOff;
           Universal.HasEssential(a, subset, arity) by Universal.HasEssential.descend;
           done };
  done by Natural.lt_of_not_le
}

-- ── From "inside on the critical tuples" to witnessing ────────────────
--
-- The last step of the relational description of absorption (blueprint
-- Theorem 3.10). Its construction produces a term that lands in `subset` on
-- every tuple with exactly one coordinate outside — the *critical* tuples,
-- which are the `X` of that proof. That is already enough to witness:
-- a tuple constrained as `Universal.Witnesses` asks is either critical, and
-- handled by hypothesis, or lies wholly inside, and handled by preservation.

theorem Universal.Witnesses.of_inside_on_critical
        (a : Universal.Algebra(signature))
        (subset : Set(a))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (insideOnCritical :
            ∀ (valuation : NaturalsBelow(arity) → a). (∃ (free : NaturalsBelow(arity)). valuation(free) ∉ subset
                 ∧ ∀ (other : NaturalsBelow(arity)). other ≠ free → valuation(other) ∈ subset)
              → Universal.Term.evaluate(a, valuation, subject) ∈ subset)
        : Universal.Witnesses(a, subset,
            Universal.universe(a), subject) := {
  take free : NaturalsBelow(arity);
  take valuation : NaturalsBelow(arity) → a;
  suppose valuation(free) ∈ Universal.universe(a);
  suppose ∀ (other : NaturalsBelow(arity)). other ≠ free → valuation(other) ∈ subset as othersInside;
  done by cases {
    case valuation(free) ∈ subset as freeInside: {
        -- Wholly inside: preservation.
        ∀ (slot : NaturalsBelow(arity)). valuation(slot) ∈ subset
            by { take slot : NaturalsBelow(arity);
                 done by cases {
                   case slot = free as isFree: done by substituting isFree
                   otherwise: done by othersInside
                 } };
        done by Universal.Term.evaluate_mem
      }
    otherwise as freeOutside: {
        -- Critical, with the one outside coordinate at `free`.
        ∃ (slot : NaturalsBelow(arity)). valuation(slot) ∉ subset ∧ ∀ (other : NaturalsBelow(arity)).
                other ≠ slot → valuation(other) ∈ subset
            by { witness free };
        done by insideOnCritical
      }
  }
}

-- ── Reindexing along a bijection ──────────────────────────────────────

-- Blueprint Lemma 1.19(e) at the level of essentiality: a bijection of index
-- types carries an essential relation to an essential relation, the relation
-- moving by `Universal.project` along it. This is what lets a construction
-- build its relation over whatever index type is natural — a disjoint union of
-- two halves, say — and only afterwards present it on an initial segment.
theorem Universal.IsEssential.reindex
        (a : Universal.Algebra(signature)) (index sub : Type(0))
        (forward : sub → index) (backward : index → sub)
        (afterBackward : ∀ (coordinate : index). forward(backward(coordinate)) = coordinate)
        (afterForward : ∀ (slot : sub). backward(forward(slot)) = slot)
        (parts : index → Set(a))
        (relation : Set(a ^ index))
        (essential : Universal.IsEssential(a, index, parts, relation))
        : Universal.IsEssential(a, sub, ((slot : sub) ↦ parts(forward(slot))),
            Universal.project(a, index, sub, forward, relation)) := {
  ∀ (free : index). ∃ (tuple : a ^ index). tuple ∈ relation ∧ ∀ (other : index). other ≠ free → tuple(other) ∈ parts(other)
      as freeAtEach;
  -- (E1). The witness freed at `forward(free)`, restricted.
  ∀ (free : sub). ∃ (small : a ^ sub). small ∈ Universal.project(a, index, sub, forward, relation) ∧ ∀ (other : sub).
            other ≠ free → small(other) ∈ parts(forward(other))
      by { take free : sub;
           choose tuple such that tuple ∈ relation ∧ ∀ (other : index). other ≠ forward(free) → tuple(other) ∈ parts(other)
               from freeAtEach(forward(free));
           tuple ∈ relation;
           ∀ (other : index). other ≠ forward(free) → tuple(other) ∈ parts(other)
               as insideElsewhere;
           Universal.restrict(a, index, sub, forward, tuple)
             ∈ Universal.project(a, index, sub, forward, relation)
               by { witness tuple };
           ∀ (other : sub). other ≠ free → Universal.restrict(a, index, sub, forward, tuple)(other)
                 ∈ parts(forward(other))
               by { take other : sub;
                    suppose other ≠ free as otherDiffers;
                    -- `forward` is injective: `backward` undoes it.
                    forward(other) ≠ forward(free)
                        by { suppose forward(other) = forward(free)
                                 as imagesAgree;
                             other
                                = backward(forward(other)) by afterForward
                                = backward(forward(free))
                                    by substituting imagesAgree
                                = free by afterForward;
                             done };
                    tuple(forward(other)) ∈ parts(forward(other)) by insideElsewhere;
                    done };
           witness Universal.restrict(a, index, sub, forward, tuple) };
  -- (E2). A lift is inside at every index, because every index is the image of
  -- its own preimage.
  ¬(∃ (small : a ^ sub). small ∈ Universal.project(a, index, sub, forward, relation) ∧ ∀ (slot : sub). small(slot) ∈ parts(forward(slot)))
      by { suppose ∃ (small : a ^ sub). small ∈ Universal.project(a, index, sub, forward, relation)
                     ∧ ∀ (slot : sub). small(slot) ∈ parts(forward(slot))
                   as someSmallInside;
           choose small such that small ∈ Universal.project(a, index, sub, forward, relation)
               ∧ ∀ (slot : sub). small(slot) ∈ parts(forward(slot))
               from someSmallInside;
           ∀ (slot : sub). small(slot) ∈ parts(forward(slot)) as smallInside;
           small ∈ Universal.project(a, index, sub, forward, relation);
           choose big such that big ∈ relation ∧ Universal.restrict(a, index, sub, forward, big) = small
               from (small ∈ Universal.project(a, index, sub, forward, relation));
           big ∈ relation;
           Universal.restrict(a, index, sub, forward, big) = small;
           ∀ (coordinate : index). big(coordinate) ∈ parts(coordinate)
               by { take coordinate : index;
                    small(backward(coordinate))
                        ∈ parts(forward(backward(coordinate))) by smallInside;
                    big(forward(backward(coordinate)))
                       = Universal.restrict(a, index, sub, forward, big)(backward(coordinate))
                       = small(backward(coordinate));
                    big(forward(backward(coordinate)))
                        ∈ parts(forward(backward(coordinate)));
                    forward(backward(coordinate)) = coordinate by afterBackward;
                    done };
           ∃ (tuple : a ^ index). tuple ∈ relation ∧ ∀ (coordinate : index). tuple(coordinate) ∈ parts(coordinate)
               by { witness big };
           done };
  done
}
