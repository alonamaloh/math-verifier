-- Universal/generated.math
--
-- The subuniverse generated by a set: the least subuniverse containing it.
--
-- Because a set is a predicate, "least subuniverse containing `base`" is
-- directly definable — membership is quantification over the subuniverses that
-- contain `base` — so no closure construction is needed, and the three
-- characterising facts follow immediately.
--
-- The empty subuniverse needs the signature to have no constants: with a
-- nullary symbol, `Universal.Algebra.interpret(0, symbol, …)` is an element
-- every subuniverse must contain. The blueprint takes the same convention.

module Universal.generated

import Logic.basics
import Equality.basics
import Natural.basics
import Set.basics
import Set.algebra
import Set.subtype
import Set.finite
import Universal.signature

convention signature : Universal.Signature

-- Every operation symbol has positive arity. Phrased as a bound on the arity of
-- an arbitrary symbol rather than as emptiness of `signature(0)`, so that it
-- applies to the symbol in hand without transporting its type along `arity = 0`.
definition Universal.Signature.HasNoConstants (signature : Universal.Signature)
        : Proposition := ∀ (arity : ℕ). ∀ (symbol : signature(arity)). 1 ≤ arity

-- Without constants the empty set is a subuniverse: every operation has an
-- argument to supply, and there is nothing to supply it from.
theorem Universal.IsSubuniverse.empty
        (a : Universal.Algebra(signature))
        (noConstants : Universal.Signature.HasNoConstants(signature))
        : Universal.IsSubuniverse(a, Set.empty(Universal.carrier(a))) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → Universal.carrier(a);
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Set.empty(Universal.carrier(a)) as allInside;
  1 ≤ arity by noConstants;
  0 < arity as positive;
  arguments(NaturalsBelow.make(0, positive))
      ∈ Set.empty(Universal.carrier(a)) by allInside;
  done
}

-- The least subuniverse containing `base`.
definition Universal.generated
        (a : Universal.Algebra(signature))
        (base : Set(Universal.carrier(a)))
        : Set(Universal.carrier(a)) :=
  (subject : Universal.carrier(a)) ↦ ∀ (subset : Set(Universal.carrier(a))).
      Universal.IsSubuniverse(a, subset) → base ⊆ subset → subject ∈ subset

theorem Universal.generated.contains_base
        (a : Universal.Algebra(signature))
        (base : Set(Universal.carrier(a)))
        : base ⊆ Universal.generated(a, base) := {
  take subject : Universal.carrier(a);
  suppose subject ∈ base;
  take subset : Set(Universal.carrier(a));
  suppose Universal.IsSubuniverse(a, subset);
  suppose base ⊆ subset;
  done
}

theorem Universal.generated.least
        (a : Universal.Algebra(signature))
        (base : Set(Universal.carrier(a)))
        (subset : Set(Universal.carrier(a)))
        (closed : Universal.IsSubuniverse(a, subset))
        (baseInside : base ⊆ subset)
        : Universal.generated(a, base) ⊆ subset := {
  take subject : Universal.carrier(a);
  suppose subject ∈ Universal.generated(a, base);
  done
}

theorem Universal.generated.is_subuniverse
        (a : Universal.Algebra(signature))
        (base : Set(Universal.carrier(a)))
        : Universal.IsSubuniverse(a, Universal.generated(a, base)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → Universal.carrier(a);
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Universal.generated(a, base) as allGenerated;
  take subset : Set(Universal.carrier(a));
  suppose Universal.IsSubuniverse(a, subset);
  suppose base ⊆ subset;
  ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ subset by allGenerated;
  done
}

-- Generation is monotone, and adds nothing to a set already closed.
theorem Universal.generated.monotone
        (a : Universal.Algebra(signature))
        (smaller larger : Set(Universal.carrier(a)))
        (inside : smaller ⊆ larger)
        : Universal.generated(a, smaller) ⊆ Universal.generated(a, larger) := {
  Universal.IsSubuniverse(a, Universal.generated(a, larger));
  larger ⊆ Universal.generated(a, larger);
  smaller ⊆ Universal.generated(a, larger) by Set.subset.transitive;
  done
}

-- Nothing is generated by nothing, when the signature has no constants.
theorem Universal.generated.empty
        (a : Universal.Algebra(signature))
        (noConstants : Universal.Signature.HasNoConstants(signature))
        : Universal.generated(a, Set.empty(Universal.carrier(a)))
          = Set.empty(Universal.carrier(a)) := {
  Universal.IsSubuniverse(a, Set.empty(Universal.carrier(a)));
  Set.empty(Universal.carrier(a)) ⊆ Set.empty(Universal.carrier(a)) by Set.subset.reflexive;
  Universal.generated(a, Set.empty(Universal.carrier(a)))
      ⊆ Set.empty(Universal.carrier(a));
  Set.empty(Universal.carrier(a))
      ⊆ Universal.generated(a, Set.empty(Universal.carrier(a)));
  done by Set.equal_of_same_members
}
