-- Universal/doubling.math
--
-- The Zhuk–Kozik essential doubling trick (blueprint Lemma 7.1), central
-- absorption is ternary (Corollary 8.1), and the main theorem.
--
-- **Specialized to the case its only consumer needs.** The blueprint states
-- Lemma 7.1 over a mixed product `A₀ × ⋯ × A_{n+1}` with designated subuniverses
-- `C, B₁, …, B_n, C'`; Corollary 8.1 applies it with every factor the same
-- algebra and every designated subuniverse the same `C`. Writing it in that
-- form keeps every relation a subset of a *power*, so the dependent product is
-- not needed, and the statement is exactly `Universal.HasEssential`. The Lean
-- formalization made the same specialization.
--
-- **The distinguished coordinate is the first, not the last.** The blueprint
-- puts `C'` at index `n+1`; which end it sits at is immaterial, and the first
-- is the one `NaturalsBelow.first` / `.shiftUp` / `.first_or_shift` make cheap.
--
-- **The doubled index is a disjoint union.** The blueprint writes the doubled
-- relation over `A₀ × ⋯ × A_n × A_n × ⋯ × A₀`, with the second half reversed.
-- Essentiality does not depend on the order of the coordinates, so the two
-- halves are kept as `DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))`
-- and no reversal is needed; `Universal.IsEssential.reindex` then moves the
-- result onto `NaturalsBelow(size + size)` along `NaturalsBelow.sum_out_of`.

module Universal.doubling

import axioms
import Logic.basics
import Logic.exists
import Logic.functions
import Logic.product
import Logic.sum
import Equality.basics
import Natural.basics
import Natural.order
import Natural.add_order
import Natural.least_number
import Set.basics
import Set.algebra
import Set.finite
import Set.finite_choice
import Set.finite_successor
import Set.finite_cons
import Set.finite_sum
import Set.subset_indexing
import Set.enumeration
import Universal.signature
import Universal.term
import Universal.generated
import Universal.product
import Universal.relation
import Universal.absorption
import Universal.essential
import Universal.center
import Universal.central
import Universal.relational

convention signature : Universal.Signature

-- ── The set `B'` ──────────────────────────────────────────────────────

-- Blueprint `β(P)`: the first coordinates of the tuples of `relation` whose
-- every *other* coordinate lies in `subset`.
definition Universal.betaSet
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a))) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        : Set(Universal.carrier(a)) :=
  (candidate : Universal.carrier(a)) ↦ ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
      tuple ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset)
      ∧ tuple(NaturalsBelow.first) = candidate

-- It is a subuniverse: apply the operation to a tuple of witnesses.
theorem Universal.IsSubuniverse.betaSet
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset)) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation))
        : Universal.IsSubuniverse(a,
            Universal.betaSet(a, subset, size, relation)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → Universal.carrier(a);
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Universal.betaSet(a, subset, size, relation)
      as allInBeta;
  choose lifted such that ∀ (index : NaturalsBelow(arity)). lifted(index) ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)).
      ¬(slot = NaturalsBelow.first) → lifted(index)(slot) ∈ subset) ∧ lifted(index)(NaturalsBelow.first) = arguments(index)
      from NaturalsBelow.choice(Universal.carrier(a ^ NaturalsBelow(1 + size)), arity, ((index : NaturalsBelow(arity)) ↦
          (candidate : Universal.carrier(a ^ NaturalsBelow(1 + size))) ↦ candidate ∈ relation
            ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → candidate(slot) ∈ subset)
            ∧ candidate(NaturalsBelow.first) = arguments(index)), allInBeta);
  ∀ (index : NaturalsBelow(arity)). lifted(index) ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)).
           ¬(slot = NaturalsBelow.first) → lifted(index)(slot) ∈ subset) ∧ lifted(index)(NaturalsBelow.first) = arguments(index)
      as liftedSpec;
  ∀ (index : NaturalsBelow(arity)). lifted(index) ∈ relation
      by { take index : NaturalsBelow(arity);
           lifted(index) ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → lifted(index)(slot) ∈ subset)
             ∧ lifted(index)(NaturalsBelow.first) = arguments(index)
             by liftedSpec;
           done };
  Universal.Algebra.interpret(arity, symbol, lifted) ∈ relation by closed;
  -- Every other coordinate of the value is inside, coordinatewise.
  ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → Universal.Algebra.interpret(arity, symbol, lifted)(slot) ∈ subset
      by { take slot : NaturalsBelow(1 + size);
           suppose ¬(slot = NaturalsBelow.first) as notFirst;
           ∀ (index : NaturalsBelow(arity)). lifted(index)(slot) ∈ subset
               by { take index : NaturalsBelow(arity);
                    lifted(index) ∈ relation ∧ (∀ (place : NaturalsBelow(1 + size)). ¬(place = NaturalsBelow.first)
                           → lifted(index)(place) ∈ subset) ∧ lifted(index)(NaturalsBelow.first) = arguments(index)
                      by liftedSpec;
                    ∀ (place : NaturalsBelow(1 + size)). ¬(place = NaturalsBelow.first) → lifted(index)(place) ∈ subset;
                    done };
           Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦ lifted(index)(slot)))
               ∈ subset;
           done };
  -- And its first coordinate is the value of the operation on the arguments.
  ∀ (index : NaturalsBelow(arity)). lifted(index)(NaturalsBelow.first) = arguments(index)
      by { take index : NaturalsBelow(arity);
           lifted(index) ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → lifted(index)(slot) ∈ subset)
             ∧ lifted(index)(NaturalsBelow.first) = arguments(index)
             by liftedSpec;
           done };
  ((index : NaturalsBelow(arity)) ↦ lifted(index)(NaturalsBelow.first))
    = arguments by Function.extensionality;
  Universal.Algebra.interpret(arity, symbol, lifted)(NaturalsBelow.first)
     = Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦ lifted(index)(NaturalsBelow.first)))
     = Universal.Algebra.interpret(arity, symbol, arguments);
  done by { witness Universal.Algebra.interpret(arity, symbol, lifted) }
}

-- Essentiality at the first coordinate makes it nonempty.
theorem Universal.betaSet_nonempty
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a))) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation))
        : Set.IsNonempty(Universal.carrier(a),
            Universal.betaSet(a, subset, size, relation)) := {
  ∀ (free : NaturalsBelow(1 + size)). ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
        tuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → tuple(other) ∈ subset
      as freeAtEach;
  choose tuple such that tuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = NaturalsBelow.first) → tuple(other) ∈ subset
      from freeAtEach(NaturalsBelow.first);
  tuple ∈ relation;
  ∀ (other : NaturalsBelow(1 + size)). ¬(other = NaturalsBelow.first) → tuple(other) ∈ subset;
  tuple(NaturalsBelow.first) = tuple(NaturalsBelow.first);
  tuple(NaturalsBelow.first) ∈ Universal.betaSet(a, subset, size, relation)
      by { witness tuple };
  witness tuple(NaturalsBelow.first)
}

-- And essentiality's second clause keeps it away from `subset`.
theorem Universal.betaSet_outside
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a))) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation))
        (candidate : Universal.carrier(a))
        (inBeta : candidate ∈ Universal.betaSet(a, subset, size, relation))
        : ¬(candidate ∈ subset) := {
  suppose candidate ∈ subset as isInside;
  choose tuple such that tuple ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset)
      ∧ tuple(NaturalsBelow.first) = candidate
      from inBeta;
  tuple ∈ relation;
  ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset as insideElsewhere;
  tuple(NaturalsBelow.first) = candidate as headIsCandidate;
  ∀ (slot : NaturalsBelow(1 + size)). tuple(slot) ∈ subset
      by { take slot : NaturalsBelow(1 + size);
           done by cases {
             case slot = NaturalsBelow.first as isFirst: {
                 tuple(NaturalsBelow.first) ∈ subset by substituting headIsCandidate;
                 done by substituting isFirst
               }
             otherwise: done by insideElsewhere
           } };
  ∃ (candidateTuple : Universal.carrier(a ^ NaturalsBelow(1 + size))). candidateTuple ∈ relation
      ∧ ∀ (slot : NaturalsBelow(1 + size)). candidateTuple(slot) ∈ subset
      by { witness tuple };
  done
}

-- Shrinking the relation shrinks `β`.
theorem Universal.betaSet_monotone
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a))) (size : ℕ)
        (smaller larger : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (inclusion : smaller ⊆ larger)
        : Universal.betaSet(a, subset, size, smaller)
          ⊆ Universal.betaSet(a, subset, size, larger) := {
  take candidate : Universal.carrier(a);
  suppose candidate ∈ Universal.betaSet(a, subset, size, smaller) as inSmaller;
  choose tuple such that tuple ∈ smaller ∧ (∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset)
      ∧ tuple(NaturalsBelow.first) = candidate
      from inSmaller;
  tuple ∈ smaller;
  tuple ∈ larger;
  ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset;
  tuple(NaturalsBelow.first) = candidate;
  done by { witness tuple }
}

-- The generators of blueprint Step 1's `R''`: one witness per coordinate other
-- than the first, together with the tuple realising the anchor. Naming the set
-- rather than writing it as a bare lambda is what lets `∈` dispatch on it.
definition Universal.doublingGenerators
        (a : Universal.Algebra(signature)) (size : ℕ)
        (witnesses : NaturalsBelow(1 + size) → Universal.carrier(a ^ NaturalsBelow(1 + size)))
        (anchorTuple : Universal.carrier(a ^ NaturalsBelow(1 + size)))
        : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))) :=
  (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))) ↦ (∃ (slot : NaturalsBelow(1 + size)).
       ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)) ∨ tuple = anchorTuple

-- ── Step 1: the generation property (‡) ───────────────────────────────
--
-- Every element of `B'` is generated by `subset` together with any *other*
-- element of `B'`. Blueprint Remark 7.2 insists this be proved as a standalone
-- universally quantified statement, before the element `b` of Step 2 is fixed:
-- Step 3 instantiates it twice, the second time at an element the first
-- instantiation produced. There is no circularity, and stating it here is what
-- makes that visible.

theorem Universal.betaSet_subset_generated
        (a : Universal.Algebra(signature))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (enumeration : List(Universal.carrier(a)))
        (isEnumeration : Set.IsEnumeration(Universal.carrier(a), enumeration))
        (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation))
        (minimal : ∀ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
            Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
            → Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
            → Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
              ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)))
        (anchor : Universal.carrier(a))
        (anchorInBeta : anchor
            ∈ Universal.betaSet(a, subset, size, relation))
        : Universal.betaSet(a, subset, size, relation)
          ⊆ Universal.generated(a,
              subset ∪ Set.singleton(Universal.carrier(a), anchor)) := {
  ∀ (free : NaturalsBelow(1 + size)). ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
        tuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → tuple(other) ∈ subset
      as freeAtEach;
  choose witnesses such that ∀ (free : NaturalsBelow(1 + size)). witnesses(free) ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)).
            ¬(other = free) → witnesses(free)(other) ∈ subset
      as witnessesSpec
      from NaturalsBelow.choice(Universal.carrier(a ^ NaturalsBelow(1 + size)), 1 + size, ((free : NaturalsBelow(1 + size)) ↦
          (candidate : Universal.carrier(a ^ NaturalsBelow(1 + size))) ↦ candidate ∈ relation
            ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → candidate(other) ∈ subset), freeAtEach);
  choose anchorTuple such that anchorTuple ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)).
           ¬(slot = NaturalsBelow.first) → anchorTuple(slot) ∈ subset) ∧ anchorTuple(NaturalsBelow.first) = anchor
      from anchorInBeta;
  anchorTuple ∈ relation;
  ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → anchorTuple(slot) ∈ subset
      as anchorInsideElsewhere;
  anchorTuple(NaturalsBelow.first) = anchor as anchorHead;
  ∀ (free : NaturalsBelow(1 + size)). witnesses(free) ∈ relation
      by { take free : NaturalsBelow(1 + size);
           witnesses(free) ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → witnesses(free)(other) ∈ subset
             by witnessesSpec;
           done };
  -- The generators all lie in `relation`, so the subuniverse they generate does.
  Universal.doublingGenerators(a, size, witnesses, anchorTuple) ⊆ relation
      by { take tuple : Universal.carrier(a ^ NaturalsBelow(1 + size));
           suppose tuple
               ∈ Universal.doublingGenerators(a, size, witnesses, anchorTuple) as isGenerator;
           (∃ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)) ∨ tuple = anchorTuple;
           done by cases {
             case ∃ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)
                  as isWitness: {
                 choose slot such that ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)
                     from isWitness;
                 tuple = witnesses(slot) as isThatWitness;
                 witnesses(slot) ∈ relation;
                 done by substituting isThatWitness
               }
             case tuple = anchorTuple as isAnchor: done by substituting isAnchor
           } };
  Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple))
      ⊆ relation by Universal.generated.least as smallerRelation;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple)))
      by Universal.generated.is_subuniverse;
  Universal.doublingGenerators(a, size, witnesses, anchorTuple)
      ⊆ Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple))
      by Universal.generated.contains_base;
  -- It is still essential: every coordinate has its witness among the
  -- generators, and nothing lies wholly inside because it sits inside
  -- `relation`.
  Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset),
      Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple)))
      by { ∀ (free : NaturalsBelow(1 + size)). ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
                 tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
                     Universal.doublingGenerators(a, size, witnesses, anchorTuple)) ∧ ∀ (other : NaturalsBelow(1 + size)).
                     ¬(other = free) → tuple(other) ∈ subset
               by { take free : NaturalsBelow(1 + size);
                    done by cases {
                      case free = NaturalsBelow.first as isFirst: {
                          anchorTuple
                              ∈ Universal.doublingGenerators(a, size, witnesses, anchorTuple)
                              by { anchorTuple = anchorTuple;
                                   done };
                          anchorTuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
                              Universal.doublingGenerators(a, size, witnesses, anchorTuple));
                          ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → anchorTuple(other) ∈ subset
                              by { take other : NaturalsBelow(1 + size);
                                   suppose ¬(other = free) as otherDiffers;
                                   ¬(other = NaturalsBelow.first) by substituting isFirst;
                                   done by anchorInsideElsewhere };
                          witness anchorTuple
                        }
                      otherwise as isNotFirst: {
                          witnesses(free)
                              ∈ Universal.doublingGenerators(a, size, witnesses, anchorTuple)
                              by { ∃ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) ∧ witnesses(free) = witnesses(slot)
                                       by { witnesses(free) = witnesses(free);
                                            witness free };
                                   done };
                          witnesses(free) ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
                              Universal.doublingGenerators(a, size, witnesses, anchorTuple));
                          witnesses(free) ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free)
                                → witnesses(free)(other) ∈ subset
                            by witnessesSpec;
                          ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → witnesses(free)(other) ∈ subset;
                          witness witnesses(free)
                        }
                    } };
           ¬(∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))). tuple ∈ Universal.generated(
                   a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple))
               ∧ ∀ (slot : NaturalsBelow(1 + size)). tuple(slot) ∈ subset)
               by { suppose ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
                              tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
                                  Universal.doublingGenerators(a, size, witnesses, anchorTuple)) ∧ ∀ (slot : NaturalsBelow(1 + size)).
                                  tuple(slot) ∈ subset
                            as someInside;
                    choose tuple such that tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
                            Universal.doublingGenerators(a, size, witnesses, anchorTuple)) ∧ ∀ (slot : NaturalsBelow(1 + size)).
                            tuple(slot) ∈ subset
                        from someInside;
                    tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple));
                    tuple ∈ relation by smallerRelation;
                    ∀ (slot : NaturalsBelow(1 + size)). tuple(slot) ∈ subset;
                    ∃ (candidate : Universal.carrier(a ^ NaturalsBelow(1 + size))). candidate ∈ relation
                        ∧ ∀ (slot : NaturalsBelow(1 + size)). candidate(slot) ∈ subset
                        by { witness tuple };
                    done };
           done };
  -- Minimality plus the inclusion forces the two `β`s to coincide.
  Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple)))
    ⊆ Universal.betaSet(a, subset, size, relation)
      by Universal.betaSet_monotone;
  Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
    ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
            Universal.doublingGenerators(a, size, witnesses, anchorTuple))))
      by minimal;
  Set.size(enumeration, Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple))))
    ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
      by Set.size_le_of_subset;
  Set.size(enumeration, Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple))))
    = Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
      by Natural.le_antisymmetric;
  Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple)))
    = Universal.betaSet(a, subset, size, relation)
      by Set.equal_of_size_eq;
  -- Every generator's first coordinate lies in `subset ∪ {anchor}`, so every
  -- member of the generated relation has its first coordinate in the
  -- subuniverse that set generates.
  Universal.IsSubuniverse(a, Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), anchor)))
      by Universal.generated.is_subuniverse;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size),
      Universal.coordinateIn(a, NaturalsBelow(1 + size), NaturalsBelow.first, Universal.generated(a,
          subset ∪ Set.singleton(Universal.carrier(a), anchor))))
      by Universal.IsSubuniverse.coordinateIn;
  subset ∪ Set.singleton(Universal.carrier(a), anchor)
    ⊆ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), anchor))
      by Universal.generated.contains_base;
  Universal.doublingGenerators(a, size, witnesses, anchorTuple)
    ⊆ Universal.coordinateIn(a, NaturalsBelow(1 + size), NaturalsBelow.first, Universal.generated(a,
          subset ∪ Set.singleton(Universal.carrier(a), anchor)))
      by { take tuple : Universal.carrier(a ^ NaturalsBelow(1 + size));
           suppose tuple
               ∈ Universal.doublingGenerators(a, size, witnesses, anchorTuple) as isGenerator;
           (∃ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)) ∨ tuple = anchorTuple;
           tuple(NaturalsBelow.first)
               ∈ subset ∪ Set.singleton(Universal.carrier(a), anchor)
               by cases {
                 case ∃ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)
                      as isWitness: {
                     choose slot such that ¬(slot = NaturalsBelow.first) ∧ tuple = witnesses(slot)
                         from isWitness;
                     ¬(slot = NaturalsBelow.first);
                     tuple = witnesses(slot) as isThatWitness;
                     ¬((NaturalsBelow.first : NaturalsBelow(1 + size)) = slot)
                         by { suppose (NaturalsBelow.first
                                  : NaturalsBelow(1 + size)) = slot as flipped;
                              slot = NaturalsBelow.first;
                              done };
                     witnesses(slot) ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = slot) → witnesses(slot)(other) ∈ subset
                       by witnessesSpec;
                     ∀ (other : NaturalsBelow(1 + size)). ¬(other = slot) → witnesses(slot)(other) ∈ subset;
                     witnesses(slot)(NaturalsBelow.first) ∈ subset;
                     tuple(NaturalsBelow.first) ∈ subset by substituting isThatWitness;
                     done
                   }
                 case tuple = anchorTuple as isAnchor: {
                     anchorTuple(NaturalsBelow.first) = anchor by anchorHead;
                     anchorTuple(NaturalsBelow.first)
                         ∈ Set.singleton(Universal.carrier(a), anchor);
                     tuple(NaturalsBelow.first)
                         ∈ Set.singleton(Universal.carrier(a), anchor)
                         by substituting isAnchor;
                     done
                   }
               };
           tuple(NaturalsBelow.first)
               ∈ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), anchor));
           done };
  Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple))
    ⊆ Universal.coordinateIn(a, NaturalsBelow(1 + size), NaturalsBelow.first, Universal.generated(a,
          subset ∪ Set.singleton(Universal.carrier(a), anchor)))
      by Universal.generated.least as headsGenerated;
  -- Which is the claim, read through the equality of the two `β`s.
  take candidate : Universal.carrier(a);
  suppose candidate ∈ Universal.betaSet(a, subset, size, relation)
      as inBeta;
  candidate ∈ Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
        Universal.doublingGenerators(a, size, witnesses, anchorTuple)));
  choose tuple such that tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size),
          Universal.doublingGenerators(a, size, witnesses, anchorTuple)) ∧ (∀ (slot : NaturalsBelow(1 + size)).
           ¬(slot = NaturalsBelow.first) → tuple(slot) ∈ subset) ∧ tuple(NaturalsBelow.first) = candidate
      from (candidate ∈ Universal.betaSet(a, subset, size, Universal.generated(a ^ NaturalsBelow(1 + size),
          Universal.doublingGenerators(a, size, witnesses, anchorTuple))));
  tuple ∈ Universal.generated(a ^ NaturalsBelow(1 + size), Universal.doublingGenerators(a, size, witnesses, anchorTuple));
  tuple(NaturalsBelow.first) = candidate as headIsCandidate;
  tuple ∈ Universal.coordinateIn(a, NaturalsBelow(1 + size), NaturalsBelow.first, Universal.generated(a,
        subset ∪ Set.singleton(Universal.carrier(a), anchor)))
      by headsGenerated;
  tuple(NaturalsBelow.first)
      ∈ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), anchor));
  done by substituting headIsCandidate
}

-- ── Step 3: the linking relation misses `B' × B'` ─────────────────────
--
-- Blueprint Remark 7.2: this is the only argument in the development that
-- doubles back on itself. (‡) is instantiated twice — at `left`, and then at
-- the `third` that the first instantiation produced. There is no circularity:
-- (‡) is universally quantified and was established before `base` was fixed.

-- The elements having a link-neighbour in `target`.
definition Universal.linkedInto
        (a : Universal.Algebra(signature))
        (link : Set(Universal.carrier(a × a)))
        (target : Set(Universal.carrier(a)))
        : Set(Universal.carrier(a)) :=
  (candidate : Universal.carrier(a)) ↦ ∃ (partner : Universal.carrier(a)).
      Universal.pair(a, a, candidate, partner) ∈ link ∧ partner ∈ target

theorem Universal.IsSubuniverse.linkedInto
        (a : Universal.Algebra(signature))
        (link : Set(Universal.carrier(a × a)))
        (linkClosed : Universal.IsSubuniverse(a × a, link))
        (target : Set(Universal.carrier(a)))
        (targetClosed : Universal.IsSubuniverse(a, target))
        : Universal.IsSubuniverse(a, Universal.linkedInto(a, link, target)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → Universal.carrier(a);
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Universal.linkedInto(a, link, target) as allLinked;
  choose partners such that ∀ (index : NaturalsBelow(arity)). Universal.pair(a, a, arguments(index), partners(index)) ∈ link
        ∧ partners(index) ∈ target
      as partnersSpec
      from NaturalsBelow.choice(Universal.carrier(a), arity, ((index : NaturalsBelow(arity)) ↦
          (candidate : Universal.carrier(a)) ↦ Universal.pair(a, a, arguments(index), candidate) ∈ link ∧ candidate ∈ target), allLinked);
  ∀ (index : NaturalsBelow(arity)). Universal.pair(a, a, arguments(index), partners(index)) ∈ link
      by { take index : NaturalsBelow(arity);
           Universal.pair(a, a, arguments(index), partners(index)) ∈ link ∧ partners(index) ∈ target by partnersSpec;
           done };
  ∀ (index : NaturalsBelow(arity)). partners(index) ∈ target
      by { take index : NaturalsBelow(arity);
           Universal.pair(a, a, arguments(index), partners(index)) ∈ link ∧ partners(index) ∈ target by partnersSpec;
           done };
  Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦
        Universal.pair(a, a, arguments(index), partners(index)))) ∈ link
      by linkClosed;
  Universal.Algebra.interpret(arity, symbol, partners) ∈ target by targetClosed;
  Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦ Universal.pair(a, a, arguments(index), partners(index))))
     = Universal.pair(a, a, Universal.Algebra.interpret(arity, symbol, arguments), Universal.Algebra.interpret(arity, symbol, partners))
     by Universal.pair_interpret as actsCoordinatewise;
  Universal.pair(a, a, Universal.Algebra.interpret(arity, symbol, arguments), Universal.Algebra.interpret(arity, symbol, partners)) ∈ link
      by substituting actsCoordinatewise;
  done by { witness Universal.Algebra.interpret(arity, symbol, partners) }
}

theorem Universal.linking_disjoint
        (a : Universal.Algebra(signature))
        (idempotent : Universal.Algebra.IsIdempotent(a))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (enumeration : List(Universal.carrier(a)))
        (isEnumeration : Set.IsEnumeration(Universal.carrier(a), enumeration))
        (central : ∀ (element : Universal.carrier(a)). ¬(element ∈ subset) → ¬(Universal.pair(a, a, element, element)
                ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, element))))
        (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation))
        (minimal : ∀ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
            Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
            → Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
            → Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
              ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)))
        (base : Universal.carrier(a))
        (baseInBeta : base ∈ Universal.betaSet(a, subset, size, relation))
        (left right : Universal.carrier(a))
        (leftInBeta : left ∈ Universal.betaSet(a, subset, size, relation))
        (rightInBeta : right ∈ Universal.betaSet(a, subset, size, relation))
        : ¬(Universal.pair(a, a, left, right)
            ∈ Universal.generated(a × a,
                Universal.centralPairs(a, subset, base))) := {
  suppose Universal.pair(a, a, left, right)
      ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base)) as leftLinkedToRight;
  Universal.IsSubuniverse(a × a, Universal.generated(a × a, Universal.centralPairs(a, subset, base))) by Universal.generated.is_subuniverse;
  Universal.centralPairs(a, subset, base)
    ⊆ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
      by Universal.generated.contains_base as pairsAreLinked;
  Universal.IsSubuniverse(a, Universal.betaSet(a, subset, size, relation)) by Universal.IsSubuniverse.betaSet;
  -- The two generating blocks, read as links.
  ∀ (candidate : Universal.carrier(a)). candidate ∈ subset → Universal.pair(a, a, candidate, base)
        ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
      by { take candidate : Universal.carrier(a);
           suppose candidate ∈ subset;
           Universal.pair(a, a, candidate, base)
               ∈ Universal.centralPairs(a, subset, base)
               by Universal.centralPairs.to_element;
           done by pairsAreLinked } as blockToBase;
  ∀ (candidate : Universal.carrier(a)). candidate ∈ subset → Universal.pair(a, a, base, candidate)
        ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
      by { take candidate : Universal.carrier(a);
           suppose candidate ∈ subset;
           Universal.pair(a, a, base, candidate)
               ∈ Universal.centralPairs(a, subset, base)
               by Universal.centralPairs.from_element;
           done by pairsAreLinked } as blockFromBase;
  -- `P`: the elements with a link-neighbour in `B'`. It holds `subset` and
  -- `left`, hence everything they generate — which by (‡) includes `base`.
  Universal.IsSubuniverse(a, Universal.linkedInto(a, Universal.generated(a × a,
          Universal.centralPairs(a, subset, base)), Universal.betaSet(a, subset, size, relation)))
      by Universal.IsSubuniverse.linkedInto;
  subset ∪ Set.singleton(Universal.carrier(a), left)
    ⊆ Universal.linkedInto(a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)),
        Universal.betaSet(a, subset, size, relation))
      by { take candidate : Universal.carrier(a);
           suppose candidate
               ∈ subset ∪ Set.singleton(Universal.carrier(a), left)
               as inSpan;
           done by cases {
             case candidate ∈ subset as inSubset: {
                 Universal.pair(a, a, candidate, base)
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
                     by blockToBase;
                 done by { witness base }
               }
             case candidate
                    ∈ Set.singleton(Universal.carrier(a), left)
                  as isLeft: {
                 candidate = left;
                 Universal.pair(a, a, candidate, right)
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base));
                 done by { witness right }
               }
           } };
  Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), left))
    ⊆ Universal.linkedInto(a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)),
        Universal.betaSet(a, subset, size, relation))
      by Universal.generated.least as spanOfLeftLinked;
  Universal.betaSet(a, subset, size, relation)
    ⊆ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), left))
      by Universal.betaSet_subset_generated;
  base ∈ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), left));
  base ∈ Universal.linkedInto(a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)),
      Universal.betaSet(a, subset, size, relation)) by spanOfLeftLinked;
  choose third such that Universal.pair(a, a, base, third)
        ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base)) ∧ third ∈ Universal.betaSet(a, subset, size, relation)
      from (base ∈ Universal.linkedInto(a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)),
        Universal.betaSet(a, subset, size, relation)));
  Universal.pair(a, a, base, third)
      ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base));
  third ∈ Universal.betaSet(a, subset, size, relation);
  -- `Q`: the link-neighbours of `base`. It holds `subset` and `third`, hence
  -- everything they generate — which by (‡) again includes `base`.
  Universal.IsSubuniverse(a, Universal.neighborhood(a, a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)), base))
      by Universal.IsSubuniverse.neighborhood;
  subset ∪ Set.singleton(Universal.carrier(a), third)
    ⊆ Universal.neighborhood(a, a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)), base)
      by { take candidate : Universal.carrier(a);
           suppose candidate
               ∈ subset ∪ Set.singleton(Universal.carrier(a), third)
               as inSpan;
           done by cases {
             case candidate ∈ subset as inSubset:
                 done by blockFromBase
             case candidate
                    ∈ Set.singleton(Universal.carrier(a), third)
                  as isThird: {
                 candidate = third;
                 done
               }
           } };
  Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), third))
    ⊆ Universal.neighborhood(a, a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)), base)
      by Universal.generated.least as spanOfThirdLinked;
  Universal.betaSet(a, subset, size, relation)
    ⊆ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), third))
      by Universal.betaSet_subset_generated;
  base ∈ Universal.generated(a, subset ∪ Set.singleton(Universal.carrier(a), third));
  base ∈ Universal.neighborhood(a, a, Universal.generated(a × a, Universal.centralPairs(a, subset, base)), base) by spanOfThirdLinked;
  Universal.pair(a, a, base, base)
      ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base));
  -- But `base` lies outside `subset`, so central absorption forbids exactly
  -- that.
  ¬(base ∈ subset) by Universal.betaSet_outside;
  ¬(Universal.pair(a, a, base, base)
    ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))) by central;
  done
}

-- ── Step 4: the doubled relation ──────────────────────────────────────
--
-- Two copies of the index set, side by side. The blueprint reverses the second
-- half; essentiality does not depend on the order of the coordinates, so we do
-- not. The relation is built exactly as the blueprint builds it — an
-- intersection of cylinders, then a projection away from the two linked
-- coordinates — so its closure is `Universal.IsSubuniverse.project` and
-- `.cylinder` and `.intersection`, with nothing to check by hand.

definition Universal.leftHalf (size : ℕ) (index : NaturalsBelow(1 + size))
        : DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)) := Sum.left(index)

definition Universal.rightHalf (size : ℕ) (index : NaturalsBelow(1 + size))
        : DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)) := Sum.right(index)

-- Drop the two head coordinates: the shorter doubled index sits inside the
-- longer one by shifting each half up by one.
definition Universal.doubledShift (size : ℕ)
        : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)) → DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size))
  | Sum.left(index) => Sum.left(NaturalsBelow.shiftUp(index))
  | Sum.right(index) => Sum.right(NaturalsBelow.shiftUp(index))

-- A tuple over the doubled index, assembled from its two halves.
definition Universal.sumTuple
        (a : Universal.Algebra(signature)) (size : ℕ)
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        : DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)) → Universal.carrier(a)
  | Sum.left(index) => leftPart(index)
  | Sum.right(index) => rightPart(index)

-- The tuples whose two head coordinates are linked.
definition Universal.linkedHeads
        (a : Universal.Algebra(signature)) (size : ℕ)
        (link : Set(Universal.carrier(a × a)))
        : Set(Universal.carrier(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)))) :=
  (tuple : Universal.carrier(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)))) ↦
    Universal.pair(a, a, tuple(Universal.leftHalf(size, NaturalsBelow.first)), tuple(Universal.rightHalf(size, NaturalsBelow.first))) ∈ link

theorem Universal.IsSubuniverse.linkedHeads
        (a : Universal.Algebra(signature)) (size : ℕ)
        (link : Set(Universal.carrier(a × a)))
        (linkClosed : Universal.IsSubuniverse(a × a, link))
        : Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            Universal.linkedHeads(a, size, link)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → Universal.carrier(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)));
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Universal.linkedHeads(a, size, link) as allLinked;
  ∀ (index : NaturalsBelow(arity)). Universal.pair(a, a, arguments(index)(Universal.leftHalf(size, NaturalsBelow.first)),
        arguments(index)(Universal.rightHalf(size, NaturalsBelow.first)))
        ∈ link by allLinked;
  Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦ Universal.pair(a, a,
          arguments(index)(Universal.leftHalf(size, NaturalsBelow.first)),
          arguments(index)(Universal.rightHalf(size, NaturalsBelow.first)))))
      ∈ link by linkClosed;
  Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦ Universal.pair(a, a,
          arguments(index)(Universal.leftHalf(size, NaturalsBelow.first)),
          arguments(index)(Universal.rightHalf(size, NaturalsBelow.first)))))
     = Universal.pair(a, a, Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦
      arguments(index)(Universal.leftHalf(size, NaturalsBelow.first)))), Universal.Algebra.interpret(arity, symbol,
           ((index : NaturalsBelow(arity)) ↦ arguments(index)(Universal.rightHalf(size, NaturalsBelow.first)))))
     by Universal.pair_interpret as actsCoordinatewise;
  Universal.pair(a, a, Universal.Algebra.interpret(arity, symbol, ((index : NaturalsBelow(arity)) ↦
          arguments(index)(Universal.leftHalf(size, NaturalsBelow.first)))), Universal.Algebra.interpret(arity, symbol,
        ((index : NaturalsBelow(arity)) ↦ arguments(index)(Universal.rightHalf(size, NaturalsBelow.first)))))
      ∈ link by substituting actsCoordinatewise;
  done
}

-- Blueprint `T`: two tuples of `relation`, with their head coordinates linked.
definition Universal.linkedPair
        (a : Universal.Algebra(signature)) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (link : Set(Universal.carrier(a × a)))
        : Set(Universal.carrier(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)))) :=
  (Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
     NaturalsBelow(1 + size), Universal.leftHalf(size), relation)
   ∩ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
       NaturalsBelow(1 + size), Universal.rightHalf(size), relation))
  ∩ Universal.linkedHeads(a, size, link)

-- Blueprint `R'`: `T` with the two linked coordinates projected away.
definition Universal.doubledRelation
        (a : Universal.Algebra(signature)) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (link : Set(Universal.carrier(a × a)))
        : Set(Universal.carrier(a ^ DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)))) :=
  Universal.project(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
    DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size), Universal.linkedPair(a, size, relation, link))

theorem Universal.IsSubuniverse.doubledRelation
        (a : Universal.Algebra(signature)) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation))
        (link : Set(Universal.carrier(a × a)))
        (linkClosed : Universal.IsSubuniverse(a × a, link))
        : Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)),
            Universal.doubledRelation(a, size, relation, link)) := {
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), Universal.cylinder(a,
        DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.leftHalf(size), relation))
      by Universal.IsSubuniverse.cylinder;
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), Universal.cylinder(a,
        DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.rightHalf(size), relation))
      by Universal.IsSubuniverse.cylinder;
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), Universal.linkedHeads(a, size, link))
      by Universal.IsSubuniverse.linkedHeads;
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), Universal.cylinder(a,
          DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.leftHalf(size), relation)
        ∩ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            NaturalsBelow(1 + size), Universal.rightHalf(size), relation))
      by Universal.IsSubuniverse.intersection;
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
      Universal.linkedPair(a, size, relation, link))
      by Universal.IsSubuniverse.intersection;
  done by Universal.IsSubuniverse.project
}

-- Every point of a disjoint union sits in one of the two halves. Stated here
-- rather than in `Logic/sum.math` because this development is its only
-- consumer; the induction needs the point to be a parameter.
theorem Sum.left_or_right {A B : Type(0)} (element : DisjointUnion(A, B))
        : (∃ (value : A). element = Sum.left(value)) ∨ (∃ (value : B). element = Sum.right(value)) :=
  by induction on element with IH {
    case Sum.left(value): {
        (Sum.left(value) : DisjointUnion(A, B)) = Sum.left(value);
        ∃ (candidate : A). (Sum.left(value) : DisjointUnion(A, B)) = Sum.left(candidate)
            by { witness value };
        done
      }
    case Sum.right(value): {
        (Sum.right(value) : DisjointUnion(A, B)) = Sum.right(value);
        ∃ (candidate : B). (Sum.right(value) : DisjointUnion(A, B)) = Sum.right(candidate)
            by { witness value };
        done
      }
  }

-- The two halves of an assembled tuple, and of the shift.
theorem Universal.sumTuple_left
        (a : Universal.Algebra(signature)) (size : ℕ)
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        (index : NaturalsBelow(1 + size))
        : Universal.sumTuple(a, size, leftPart, rightPart, Universal.leftHalf(size, index)) = leftPart(index) := done

theorem Universal.sumTuple_right
        (a : Universal.Algebra(signature)) (size : ℕ)
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        (index : NaturalsBelow(1 + size))
        : Universal.sumTuple(a, size, leftPart, rightPart, Universal.rightHalf(size, index)) = rightPart(index) := done

-- Restricting an assembled tuple to a half returns that half.
theorem Universal.restrict_sumTuple_left
        (a : Universal.Algebra(signature)) (size : ℕ)
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        : Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            NaturalsBelow(1 + size), Universal.leftHalf(size),
            Universal.sumTuple(a, size, leftPart, rightPart)) = leftPart := {
  ∀ (index : NaturalsBelow(1 + size)). Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
          NaturalsBelow(1 + size), Universal.leftHalf(size), Universal.sumTuple(a, size, leftPart, rightPart))(index)
        = leftPart(index)
      by { take index : NaturalsBelow(1 + size);
           done by Universal.sumTuple_left };
  done by Function.extensionality
}

theorem Universal.restrict_sumTuple_right
        (a : Universal.Algebra(signature)) (size : ℕ)
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        : Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            NaturalsBelow(1 + size), Universal.rightHalf(size),
            Universal.sumTuple(a, size, leftPart, rightPart)) = rightPart := {
  ∀ (index : NaturalsBelow(1 + size)). Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
          NaturalsBelow(1 + size), Universal.rightHalf(size), Universal.sumTuple(a, size, leftPart, rightPart))(index)
        = rightPart(index)
      by { take index : NaturalsBelow(1 + size);
           done by Universal.sumTuple_right };
  done by Function.extensionality
}

-- Two members of `relation` with linked heads assemble into a member of `T`.
theorem Universal.linkedPair.of_halves
        (a : Universal.Algebra(signature)) (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (link : Set(Universal.carrier(a × a)))
        (leftPart rightPart : NaturalsBelow(1 + size) → Universal.carrier(a))
        (leftInRelation : leftPart ∈ relation)
        (rightInRelation : rightPart ∈ relation)
        (headsLinked : Universal.pair(a, a, leftPart(NaturalsBelow.first), rightPart(NaturalsBelow.first)) ∈ link)
        : Universal.sumTuple(a, size, leftPart, rightPart)
          ∈ Universal.linkedPair(a, size, relation, link) := {
  Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.leftHalf(size),
      Universal.sumTuple(a, size, leftPart, rightPart)) = leftPart
      by Universal.restrict_sumTuple_left;
  Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.rightHalf(size),
      Universal.sumTuple(a, size, leftPart, rightPart)) = rightPart
      by Universal.restrict_sumTuple_right;
  Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.leftHalf(size),
      Universal.sumTuple(a, size, leftPart, rightPart)) ∈ relation;
  Universal.sumTuple(a, size, leftPart, rightPart)
      ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
          NaturalsBelow(1 + size), Universal.leftHalf(size), relation);
  Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.rightHalf(size),
      Universal.sumTuple(a, size, leftPart, rightPart)) ∈ relation;
  Universal.sumTuple(a, size, leftPart, rightPart)
      ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
          NaturalsBelow(1 + size), Universal.rightHalf(size), relation);
  Universal.sumTuple(a, size, leftPart, rightPart)
      ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            NaturalsBelow(1 + size), Universal.leftHalf(size), relation)
        ∩ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
            NaturalsBelow(1 + size), Universal.rightHalf(size), relation);
  Universal.sumTuple(a, size, leftPart, rightPart)(Universal.leftHalf(size, NaturalsBelow.first))
      = leftPart(NaturalsBelow.first) by Universal.sumTuple_left;
  Universal.sumTuple(a, size, leftPart, rightPart)(Universal.rightHalf(size, NaturalsBelow.first))
      = rightPart(NaturalsBelow.first) by Universal.sumTuple_right;
  Universal.pair(a, a, Universal.sumTuple(a, size, leftPart, rightPart)(Universal.leftHalf(size, NaturalsBelow.first)),
      Universal.sumTuple(a, size, leftPart, rightPart)(Universal.rightHalf(size, NaturalsBelow.first)))
     = Universal.pair(a, a, leftPart(NaturalsBelow.first), Universal.sumTuple(a, size, leftPart, rightPart)(
           Universal.rightHalf(size, NaturalsBelow.first)))
     = Universal.pair(a, a, leftPart(NaturalsBelow.first), rightPart(NaturalsBelow.first))
     as headsAre;
  Universal.pair(a, a, Universal.sumTuple(a, size, leftPart, rightPart)(Universal.leftHalf(size, NaturalsBelow.first)),
      Universal.sumTuple(a, size, leftPart, rightPart)(Universal.rightHalf(size, NaturalsBelow.first))) ∈ link
      by substituting headsAre;
  Universal.sumTuple(a, size, leftPart, rightPart)
      ∈ Universal.linkedHeads(a, size, link);
  done
}

-- Blueprint Step 4's essentiality. (E1) at a coordinate of either half is the
-- witness freed there on that side, paired with the anchor tuple on the other;
-- the two heads are linked because one of them lies in `subset` and the other
-- is `base`, which is exactly a generating block. (E2) is Step 3.
theorem Universal.IsEssential.doubledRelation
        (a : Universal.Algebra(signature))
        (idempotent : Universal.Algebra.IsIdempotent(a))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (enumeration : List(Universal.carrier(a)))
        (isEnumeration : Set.IsEnumeration(Universal.carrier(a), enumeration))
        (central : ∀ (element : Universal.carrier(a)). ¬(element ∈ subset) → ¬(Universal.pair(a, a, element, element)
                ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, element))))
        (size : ℕ)
        (relation : Set(Universal.carrier(a ^ NaturalsBelow(1 + size))))
        (closed : Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation))
        (essential : Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation))
        (minimal : ∀ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
            Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
            → Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
            → Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
              ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)))
        (base : Universal.carrier(a))
        (baseInBeta : base ∈ Universal.betaSet(a, subset, size, relation))
        : Universal.IsEssential(a, DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), ((slot : DisjointUnion(NaturalsBelow(size),
            NaturalsBelow(size))) ↦ subset), Universal.doubledRelation(a, size, relation, Universal.generated(a × a,
                Universal.centralPairs(a, subset, base)))) := {
  choose anchorTuple such that anchorTuple ∈ relation ∧ (∀ (slot : NaturalsBelow(1 + size)).
           ¬(slot = NaturalsBelow.first) → anchorTuple(slot) ∈ subset) ∧ anchorTuple(NaturalsBelow.first) = base
      from baseInBeta;
  anchorTuple ∈ relation;
  ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → anchorTuple(slot) ∈ subset
      as anchorInside;
  anchorTuple(NaturalsBelow.first) = base as anchorHead;
  ∀ (free : NaturalsBelow(1 + size)). ∃ (tuple : Universal.carrier(a ^ NaturalsBelow(1 + size))).
        tuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)). ¬(other = free) → tuple(other) ∈ subset
      as freeAtEach;
  Universal.centralPairs(a, subset, base)
    ⊆ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
      by Universal.generated.contains_base as pairsAreLinked;
  -- (E1).
  ∀ (free : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))).
      ∃ (small : Universal.carrier(a ^ DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)))).
      small ∈ Universal.doubledRelation(a, size, relation,
          Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
        ∧ ∀ (other : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). ¬(other = free) → small(other) ∈ subset
      by { take free : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size));
           (∃ (value : NaturalsBelow(size)). free = Sum.left(value)) ∨ (∃ (value : NaturalsBelow(size)). free = Sum.right(value))
             by Sum.left_or_right;
           done by cases {
             case ∃ (value : NaturalsBelow(size)). free = Sum.left(value)
                  as freeIsLeft: {
                 choose position such that free = Sum.left(position)
                     from freeIsLeft;
                 free = Sum.left(position) as freeIsThatLeft;
                 choose freeTuple such that freeTuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)).
                         ¬(other = NaturalsBelow.shiftUp(position)) → freeTuple(other) ∈ subset
                     from freeAtEach(NaturalsBelow.shiftUp(position));
                 freeTuple ∈ relation;
                 ∀ (other : NaturalsBelow(1 + size)). ¬(other = NaturalsBelow.shiftUp(position))
                     → freeTuple(other) ∈ subset as freeTupleInside;
                 ¬(NaturalsBelow.shiftUp(position)
                   = (NaturalsBelow.first : NaturalsBelow(1 + size)))
                     by NaturalsBelow.shift_ne_first;
                 ¬((NaturalsBelow.first : NaturalsBelow(1 + size))
                   = NaturalsBelow.shiftUp(position))
                     by { suppose (NaturalsBelow.first
                              : NaturalsBelow(1 + size))
                            = NaturalsBelow.shiftUp(position) as flipped;
                          NaturalsBelow.shiftUp(position)
                              = (NaturalsBelow.first
                                 : NaturalsBelow(1 + size)) by flipped;
                          done };
                 freeTuple(NaturalsBelow.first) ∈ subset by freeTupleInside;
                 Universal.pair(a, a, freeTuple(NaturalsBelow.first), base)
                     ∈ Universal.centralPairs(a, subset, base)
                     by Universal.centralPairs.to_element;
                 Universal.pair(a, a, freeTuple(NaturalsBelow.first), base)
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
                     by pairsAreLinked;
                 Universal.pair(a, a, freeTuple(NaturalsBelow.first), anchorTuple(NaturalsBelow.first))
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
                     by substituting anchorHead;
                 Universal.sumTuple(a, size, freeTuple, anchorTuple)
                     ∈ Universal.linkedPair(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
                     by Universal.linkedPair.of_halves;
                 Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                     DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                     Universal.sumTuple(a, size, freeTuple, anchorTuple))
                   ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
                     by { witness Universal.sumTuple(a, size, freeTuple, anchorTuple) };
                 ∀ (other : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). ¬(other = free) → Universal.restrict(a,
                         DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), DisjointUnion(NaturalsBelow(size),
                           NaturalsBelow(size)), Universal.doubledShift(size), Universal.sumTuple(a, size, freeTuple,
                           anchorTuple))(other) ∈ subset
                     by { take other : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size));
                          suppose ¬(other = free) as otherDiffers;
                          (∃ (value : NaturalsBelow(size)). other = Sum.left(value)) ∨ (∃ (value : NaturalsBelow(size)).
                                 other = Sum.right(value))
                            by Sum.left_or_right;
                          done by cases {
                            case ∃ (value : NaturalsBelow(size)).
                                   other = Sum.left(value) as otherIsLeft: {
                                choose slot such that other = Sum.left(slot)
                                    from otherIsLeft;
                                other = Sum.left(slot) as otherIsThatLeft;
                                ¬(slot = position)
                                    by { suppose slot = position as slotIsIt;
                                         other
                                            = Sum.left(slot) by otherIsThatLeft
                                            = Sum.left(position)
                                                by substituting slotIsIt
                                            = free by freeIsThatLeft;
                                         done };
                                ¬(NaturalsBelow.shiftUp(slot)
                                  = NaturalsBelow.shiftUp(position))
                                    by { suppose NaturalsBelow.shiftUp(slot)
                                           = NaturalsBelow.shiftUp(position);
                                         slot = position by NaturalsBelow.shiftUp_injective;
                                         done };
                                freeTuple(NaturalsBelow.shiftUp(slot)) ∈ subset by freeTupleInside;
                                Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                    DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                    Universal.sumTuple(a, size, freeTuple, anchorTuple))(Sum.left(slot)) ∈ subset;
                                done by substituting otherIsThatLeft
                              }
                            case ∃ (value : NaturalsBelow(size)).
                                   other = Sum.right(value) as otherIsRight: {
                                choose slot such that other = Sum.right(slot)
                                    from otherIsRight;
                                other = Sum.right(slot) as otherIsThatRight;
                                ¬(NaturalsBelow.shiftUp(slot)
                                  = (NaturalsBelow.first
                                     : NaturalsBelow(1 + size)))
                                    by NaturalsBelow.shift_ne_first;
                                anchorTuple(NaturalsBelow.shiftUp(slot))
                                    ∈ subset by anchorInside;
                                Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                    DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                    Universal.sumTuple(a, size, freeTuple, anchorTuple))(Sum.right(slot)) ∈ subset;
                                done by substituting otherIsThatRight
                              }
                          } };
                 witness Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                   DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                   Universal.sumTuple(a, size, freeTuple, anchorTuple))
               }
             case ∃ (value : NaturalsBelow(size)). free = Sum.right(value)
                  as freeIsRight: {
                 choose position such that free = Sum.right(position)
                     from freeIsRight;
                 free = Sum.right(position) as freeIsThatRight;
                 choose freeTuple such that freeTuple ∈ relation ∧ ∀ (other : NaturalsBelow(1 + size)).
                         ¬(other = NaturalsBelow.shiftUp(position)) → freeTuple(other) ∈ subset
                     from freeAtEach(NaturalsBelow.shiftUp(position));
                 freeTuple ∈ relation;
                 ∀ (other : NaturalsBelow(1 + size)). ¬(other = NaturalsBelow.shiftUp(position))
                     → freeTuple(other) ∈ subset as freeTupleInside;
                 ¬(NaturalsBelow.shiftUp(position)
                   = (NaturalsBelow.first : NaturalsBelow(1 + size)))
                     by NaturalsBelow.shift_ne_first;
                 ¬((NaturalsBelow.first : NaturalsBelow(1 + size))
                   = NaturalsBelow.shiftUp(position))
                     by { suppose (NaturalsBelow.first
                              : NaturalsBelow(1 + size))
                            = NaturalsBelow.shiftUp(position) as flipped;
                          NaturalsBelow.shiftUp(position)
                              = (NaturalsBelow.first
                                 : NaturalsBelow(1 + size)) by flipped;
                          done };
                 freeTuple(NaturalsBelow.first) ∈ subset by freeTupleInside;
                 Universal.pair(a, a, base, freeTuple(NaturalsBelow.first))
                     ∈ Universal.centralPairs(a, subset, base)
                     by Universal.centralPairs.from_element;
                 Universal.pair(a, a, base, freeTuple(NaturalsBelow.first))
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
                     by pairsAreLinked;
                 Universal.pair(a, a, anchorTuple(NaturalsBelow.first), freeTuple(NaturalsBelow.first))
                     ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base))
                     by substituting anchorHead;
                 Universal.sumTuple(a, size, anchorTuple, freeTuple)
                     ∈ Universal.linkedPair(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
                     by Universal.linkedPair.of_halves;
                 Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                     DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                     Universal.sumTuple(a, size, anchorTuple, freeTuple))
                   ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
                     by { witness Universal.sumTuple(a, size, anchorTuple, freeTuple) };
                 ∀ (other : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). ¬(other = free) → Universal.restrict(a,
                         DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), DisjointUnion(NaturalsBelow(size),
                           NaturalsBelow(size)), Universal.doubledShift(size), Universal.sumTuple(a, size, anchorTuple,
                           freeTuple))(other) ∈ subset
                     by { take other : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size));
                          suppose ¬(other = free) as otherDiffers;
                          (∃ (value : NaturalsBelow(size)). other = Sum.left(value)) ∨ (∃ (value : NaturalsBelow(size)).
                                 other = Sum.right(value))
                            by Sum.left_or_right;
                          done by cases {
                            case ∃ (value : NaturalsBelow(size)).
                                   other = Sum.left(value) as otherIsLeft: {
                                choose slot such that other = Sum.left(slot)
                                    from otherIsLeft;
                                other = Sum.left(slot) as otherIsThatLeft;
                                ¬(NaturalsBelow.shiftUp(slot)
                                  = (NaturalsBelow.first
                                     : NaturalsBelow(1 + size)))
                                    by NaturalsBelow.shift_ne_first;
                                anchorTuple(NaturalsBelow.shiftUp(slot))
                                    ∈ subset by anchorInside;
                                Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                    DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                    Universal.sumTuple(a, size, anchorTuple, freeTuple))(Sum.left(slot)) ∈ subset;
                                done by substituting otherIsThatLeft
                              }
                            case ∃ (value : NaturalsBelow(size)).
                                   other = Sum.right(value) as otherIsRight: {
                                choose slot such that other = Sum.right(slot)
                                    from otherIsRight;
                                other = Sum.right(slot) as otherIsThatRight;
                                ¬(slot = position)
                                    by { suppose slot = position as slotIsIt;
                                         other
                                            = Sum.right(slot)
                                                by otherIsThatRight
                                            = Sum.right(position)
                                                by substituting slotIsIt
                                            = free by freeIsThatRight;
                                         done };
                                ¬(NaturalsBelow.shiftUp(slot)
                                  = NaturalsBelow.shiftUp(position))
                                    by { suppose NaturalsBelow.shiftUp(slot)
                                           = NaturalsBelow.shiftUp(position);
                                         slot = position by NaturalsBelow.shiftUp_injective;
                                         done };
                                freeTuple(NaturalsBelow.shiftUp(slot)) ∈ subset by freeTupleInside;
                                Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                    DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                    Universal.sumTuple(a, size, anchorTuple, freeTuple))(Sum.right(slot)) ∈ subset;
                                done by substituting otherIsThatRight
                              }
                          } };
                 witness Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                   DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                   Universal.sumTuple(a, size, anchorTuple, freeTuple))
               }
           } };
  -- (E2). A member lying wholly inside `subset` would have both its halves in
  -- `B'` with their heads linked, which Step 3 forbids.
  ¬(∃ (small : Universal.carrier(a ^ DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)))).
      small ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a,
      Universal.centralPairs(a, subset, base))) ∧ ∀ (slot : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). small(slot) ∈ subset)
      by { suppose ∃ (small : Universal.carrier(a ^ DisjointUnion(NaturalsBelow(size),
                           NaturalsBelow(size)))). small ∈ Universal.doubledRelation(a, size, relation, Universal.generated(
                                 a × a, Universal.centralPairs(a, subset, base)))
                     ∧ ∀ (slot : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). small(slot) ∈ subset
                   as someInside;
           choose small such that small ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a,
               Universal.centralPairs(a, subset, base))) ∧ ∀ (slot : DisjointUnion(NaturalsBelow(size),
                   NaturalsBelow(size))). small(slot) ∈ subset
               from someInside;
           ∀ (slot : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). small(slot) ∈ subset as smallInside;
           small ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)));
           choose big such that big ∈ Universal.linkedPair(a, size, relation, Universal.generated(a × a,
               Universal.centralPairs(a, subset, base))) ∧ Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size),
                     NaturalsBelow(1 + size)), DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)),
                   Universal.doubledShift(size), big) = small
               from (small ∈ Universal.doubledRelation(a, size, relation, Universal.generated(a × a,
                   Universal.centralPairs(a, subset, base))));
           big ∈ Universal.linkedPair(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)));
           Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
               DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size), big) = small;
           big ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                   NaturalsBelow(1 + size), Universal.leftHalf(size), relation)
                 ∩ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                     NaturalsBelow(1 + size), Universal.rightHalf(size), relation);
           big ∈ Universal.linkedHeads(a, size, Universal.generated(a × a, Universal.centralPairs(a, subset, base)));
           big ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
             NaturalsBelow(1 + size), Universal.leftHalf(size), relation);
           big ∈ Universal.cylinder(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
             NaturalsBelow(1 + size), Universal.rightHalf(size), relation);
           Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
               NaturalsBelow(1 + size), Universal.leftHalf(size), big)
               ∈ relation;
           Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
               NaturalsBelow(1 + size), Universal.rightHalf(size), big)
               ∈ relation;
           -- Each half is inside `subset` away from its head, because the
           -- shifted coordinates are exactly the ones `small` carries.
           ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size),
                     NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.leftHalf(size), big)(slot) ∈ subset
               by { take slot : NaturalsBelow(1 + size);
                    suppose ¬(slot = NaturalsBelow.first);
                    slot = NaturalsBelow.first ∨ ∃ (lower : NaturalsBelow(size)). slot = NaturalsBelow.shiftUp(lower)
                      by NaturalsBelow.first_or_shift;
                    done by cases {
                      case slot = NaturalsBelow.first: done
                      case ∃ (lower : NaturalsBelow(size)). slot = NaturalsBelow.shiftUp(lower)
                           as isShift: {
                          choose lower such that slot = NaturalsBelow.shiftUp(lower) from isShift;
                          small(Sum.left(lower)) ∈ subset by smallInside;
                          Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size),
                              Universal.leftHalf(size), big)(NaturalsBelow.shiftUp(lower))
                             = Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                 DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                 big)(Sum.left(lower))
                             = small(Sum.left(lower));
                          Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size),
                              Universal.leftHalf(size), big)(NaturalsBelow.shiftUp(lower)) ∈ subset;
                          done by substituting
                            (slot = NaturalsBelow.shiftUp(lower))
                        }
                    } };
           ∀ (slot : NaturalsBelow(1 + size)). ¬(slot = NaturalsBelow.first) → Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size),
                     NaturalsBelow(1 + size)), NaturalsBelow(1 + size), Universal.rightHalf(size), big)(slot) ∈ subset
               by { take slot : NaturalsBelow(1 + size);
                    suppose ¬(slot = NaturalsBelow.first);
                    slot = NaturalsBelow.first ∨ ∃ (lower : NaturalsBelow(size)). slot = NaturalsBelow.shiftUp(lower)
                      by NaturalsBelow.first_or_shift;
                    done by cases {
                      case slot = NaturalsBelow.first: done
                      case ∃ (lower : NaturalsBelow(size)). slot = NaturalsBelow.shiftUp(lower)
                           as isShift: {
                          choose lower such that slot = NaturalsBelow.shiftUp(lower) from isShift;
                          small(Sum.right(lower)) ∈ subset by smallInside;
                          Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size),
                              Universal.rightHalf(size), big)(NaturalsBelow.shiftUp(lower))
                             = Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                                 DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), Universal.doubledShift(size),
                                 big)(Sum.right(lower))
                             = small(Sum.right(lower));
                          Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)), NaturalsBelow(1 + size),
                              Universal.rightHalf(size), big)(NaturalsBelow.shiftUp(lower)) ∈ subset;
                          done by substituting
                            (slot = NaturalsBelow.shiftUp(lower))
                        }
                    } };
           -- So both heads lie in `B'`, and they are linked.
           big(Universal.leftHalf(size, NaturalsBelow.first))
               ∈ Universal.betaSet(a, subset, size, relation)
               by { witness Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                      NaturalsBelow(1 + size), Universal.leftHalf(size), big) };
           big(Universal.rightHalf(size, NaturalsBelow.first))
               ∈ Universal.betaSet(a, subset, size, relation)
               by { witness Universal.restrict(a, DisjointUnion(NaturalsBelow(1 + size), NaturalsBelow(1 + size)),
                      NaturalsBelow(1 + size), Universal.rightHalf(size), big) };
           Universal.pair(a, a, big(Universal.leftHalf(size, NaturalsBelow.first)), big(Universal.rightHalf(size, NaturalsBelow.first)))
               ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base));
           ¬(Universal.pair(a, a, big(Universal.leftHalf(size, NaturalsBelow.first)), big(Universal.rightHalf(size, NaturalsBelow.first)))
             ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, base)))
               by Universal.linking_disjoint;
           done };
  done
}

-- ── Blueprint Lemma 7.1 ───────────────────────────────────────────────
--
-- Step 0 is the minimization: the sizes of `β(P)` over the essential relations
-- form a nonempty set of naturals, so one of them is least and some essential
-- relation attains it. Only finiteness of the carrier is used — the family of
-- essential relations need not be finite, and no choice principle is involved,
-- since a single attaining relation is named by existential instantiation.

theorem Universal.HasEssential.doubled
        (a : Universal.Algebra(signature))
        (idempotent : Universal.Algebra.IsIdempotent(a))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (enumeration : List(Universal.carrier(a)))
        (isEnumeration : Set.IsEnumeration(Universal.carrier(a), enumeration))
        (central : ∀ (element : Universal.carrier(a)). ¬(element ∈ subset) → ¬(Universal.pair(a, a, element, element)
                ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, element))))
        (size : ℕ)
        (has : Universal.HasEssential(a, subset, 1 + size))
        : Universal.HasEssential(a, subset, size + size) := {
  -- Step 0.
  choose start such that Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), start)
      ∧ Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), start)
      from has;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), start);
  Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), start);
  ∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
        a ^ NaturalsBelow(1 + size), competitor) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
          ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor))
        = Set.size(enumeration, Universal.betaSet(a, subset, size, start))
      by { witness start } as startAttains;
  ∃ (least : ℕ). (∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
         Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
         ∧ Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
         ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)) = least) ∧ ∀ (candidate : ℕ).
          (∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
      a ^ NaturalsBelow(1 + size), competitor) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
      ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) ∧ Set.size(enumeration,
      Universal.betaSet(a, subset, size, competitor)) = candidate) → least ≤ candidate
      by Natural.least_witness(((candidate : ℕ) ↦ ∃ (competitor : Set(Universal.carrier(
      a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
      a ^ NaturalsBelow(1 + size), competitor) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
      ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) ∧ Set.size(enumeration,
      Universal.betaSet(a, subset, size, competitor)) = candidate),
        Set.size(enumeration, Universal.betaSet(a, subset, size, start)), startAttains) as leastExists;
  choose least such that (∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
         Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
         ∧ Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
         ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)) = least) ∧ ∀ (candidate : ℕ).
          (∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
      a ^ NaturalsBelow(1 + size), competitor) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
      ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) ∧ Set.size(enumeration,
      Universal.betaSet(a, subset, size, competitor)) = candidate) → least ≤ candidate
      from leastExists;
  ∀ (candidate : ℕ). (∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))).
         Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor)
         ∧ Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor)
         ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)) = candidate) → least ≤ candidate as leastIsLeast;
  ∃ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
        a ^ NaturalsBelow(1 + size), competitor) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
          ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor))
        = least as leastAttained;
  choose relation such that Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation)
      ∧ Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation)
      ∧ Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
        = least
      from leastAttained;
  Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), relation);
  Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), relation);
  Set.size(enumeration, Universal.betaSet(a, subset, size, relation)) = least
      as attainsLeast;
  ∀ (competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
        a ^ NaturalsBelow(1 + size), competitor) → Universal.IsEssential(a, NaturalsBelow(1 + size),
          ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor) → Set.size(enumeration, Universal.betaSet(a, subset, size, relation))
        ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor))
      by { take competitor : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)));
           suppose Universal.IsSubuniverse(a ^ NaturalsBelow(1 + size), competitor);
           suppose Universal.IsEssential(a, NaturalsBelow(1 + size), ((slot : NaturalsBelow(1 + size)) ↦ subset), competitor);
           Set.size(enumeration, Universal.betaSet(a, subset, size, competitor))
             = Set.size(enumeration, Universal.betaSet(a, subset, size, competitor));
           ∃ (candidate : Set(Universal.carrier(a ^ NaturalsBelow(1 + size)))). Universal.IsSubuniverse(
                 a ^ NaturalsBelow(1 + size), candidate) ∧ Universal.IsEssential(a, NaturalsBelow(1 + size),
                   ((slot : NaturalsBelow(1 + size)) ↦ subset), candidate) ∧ Set.size(enumeration,
                   Universal.betaSet(a, subset, size, candidate))
                 = Set.size(enumeration, Universal.betaSet(a, subset, size, competitor))
               by { witness competitor };
           least ≤ Set.size(enumeration, Universal.betaSet(a, subset, size, competitor)) by leastIsLeast;
           done by substituting attainsLeast };
  -- Steps 1 to 4.
  Set.IsNonempty(Universal.carrier(a), Universal.betaSet(a, subset, size, relation))
      by Universal.betaSet_nonempty;
  choose base such that base ∈ Universal.betaSet(a, subset, size, relation);
  Universal.IsSubuniverse(a × a, Universal.generated(a × a, Universal.centralPairs(a, subset, base))) by Universal.generated.is_subuniverse;
  Universal.IsSubuniverse(a ^ DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)),
      Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base))))
      by Universal.IsSubuniverse.doubledRelation;
  Universal.IsEssential(a, DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), ((slot : DisjointUnion(NaturalsBelow(size),
      NaturalsBelow(size))) ↦ subset), Universal.doubledRelation(a, size, relation,
        Universal.generated(a × a, Universal.centralPairs(a, subset, base))))
      by Universal.IsEssential.doubledRelation;
  -- Laid end to end, the two halves are an initial segment.
  ∀ (coordinate : DisjointUnion(NaturalsBelow(size), NaturalsBelow(size))). NaturalsBelow.sum_out_of(size, size,
        NaturalsBelow.sum_into(size, size, coordinate)) = coordinate
      by NaturalsBelow.sum_round_trip_left;
  ∀ (slot : NaturalsBelow(size + size)). NaturalsBelow.sum_into(size, size, NaturalsBelow.sum_out_of(size, size, slot)) = slot
      by NaturalsBelow.sum_round_trip_right;
  Universal.IsEssential(a, NaturalsBelow(size + size), ((slot : NaturalsBelow(size + size)) ↦ subset), Universal.project(a,
        DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), NaturalsBelow(size + size), NaturalsBelow.sum_out_of(size, size),
        Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))))
      by Universal.IsEssential.reindex;
  Universal.IsSubuniverse(a ^ NaturalsBelow(size + size), Universal.project(a,
        DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)), NaturalsBelow(size + size), NaturalsBelow.sum_out_of(size, size),
        Universal.doubledRelation(a, size, relation, Universal.generated(a × a, Universal.centralPairs(a, subset, base)))))
      by Universal.IsSubuniverse.project;
  witness Universal.project(a, DisjointUnion(NaturalsBelow(size), NaturalsBelow(size)),
    NaturalsBelow(size + size), NaturalsBelow.sum_out_of(size, size), Universal.doubledRelation(a, size, relation,
      Universal.generated(a × a, Universal.centralPairs(a, subset, base))))
}

-- ── Blueprint Corollary 8.1: central absorption is ternary ────────────
--
-- If no ternary term witnessed, there would be an essential relation of arity
-- three, and central absorption bounds the essential arities — so there is a
-- largest one, `M ≥ 3`. Doubling turns it into one of arity `2M - 2`, and
-- `2M - 2 > M` for `M ≥ 3`. Only the strict increase is needed, which is what
-- removes the induction the blueprint's Remark 8.2 discusses.

theorem Universal.centrally_absorbs_ternary
        (a : Universal.Algebra(signature))
        (idempotent : Universal.Algebra.IsIdempotent(a))
        (enumeration : List(Universal.carrier(a)))
        (isEnumeration : Set.IsEnumeration(Universal.carrier(a), enumeration))
        (n : ℕ) (finite : HasSize(Universal.carrier(a), n))
        (subset : Set(Universal.carrier(a)))
        (subsetClosed : Universal.IsSubuniverse(a, subset))
        (centrallyAbsorbs : Universal.CentrallyAbsorbs(a, subset))
        : ∃ (subject : Universal.Term(signature, NaturalsBelow(3))). Universal.Witnesses(a, subset,
              Universal.universe(a), subject) := {
  Universal.Absorbs(a, subset, Universal.universe(a));
  ∀ (element : Universal.carrier(a)). ¬(element ∈ subset) → ¬(Universal.pair(a, a, element, element)
          ∈ Universal.generated(a × a, Universal.centralPairs(a, subset, element)));
  suppose ¬(∃ (subject : Universal.Term(signature, NaturalsBelow(3))). Universal.Witnesses(a, subset, Universal.universe(a), subject))
      for contradiction;
  -- Then there is an essential relation of arity three.
  Universal.HasEssential(a, subset, 3)
      by { suppose ¬Universal.HasEssential(a, subset, 3) for contradiction;
           ∃ (subject : Universal.Term(signature, NaturalsBelow(3))). Universal.Witnesses(a, subset, Universal.universe(a), subject)
               by Universal.exists_witnesses_of_no_essential;
           done } as hasAtThree;
  -- Absorption bounds the essential arities, so there is a largest.
  choose witnessArity such that 1 ≤ witnessArity ∧ ∃ (subject : Universal.Term(signature, NaturalsBelow(witnessArity))).
          Universal.Witnesses(a, subset, Universal.universe(a), subject)
      from (Universal.Absorbs(a, subset, Universal.universe(a)));
  ∃ (subject : Universal.Term(signature, NaturalsBelow(witnessArity))). Universal.Witnesses(a, subset,
        Universal.universe(a), subject) as someWitness;
  choose witnessTerm such that Universal.Witnesses(a, subset, Universal.universe(a), witnessTerm)
      from someWitness;
  ∀ (candidate : ℕ). Universal.HasEssential(a, subset, candidate) → candidate ≤ witnessArity
      by { take candidate : ℕ;
           suppose Universal.HasEssential(a, subset, candidate);
           candidate < witnessArity by Universal.HasEssential.bounded_of_witnesses;
           done } as arityBound;
  ∃ (maximum : ℕ). Universal.HasEssential(a, subset, maximum) ∧ ∀ (candidate : ℕ).
          Universal.HasEssential(a, subset, candidate) → candidate ≤ maximum
      by Natural.greatest_witness(((candidate : ℕ) ↦ Universal.HasEssential(a, subset, candidate)), 3, witnessArity, hasAtThree, arityBound)
      as greatestExists;
  choose maximum such that Universal.HasEssential(a, subset, maximum) ∧ ∀ (candidate : ℕ).
          Universal.HasEssential(a, subset, candidate) → candidate ≤ maximum
      from greatestExists;
  Universal.HasEssential(a, subset, maximum);
  ∀ (candidate : ℕ). Universal.HasEssential(a, subset, candidate) → candidate ≤ maximum
      as isGreatest;
  (3 : ℕ) ≤ maximum by isGreatest;
  (1 : ℕ) ≤ 3 ≤ maximum;
  1 + (maximum ∸ 1) = maximum by Natural.add_monus_of_le as putBack;
  -- Doubling it exceeds the maximum, which is the contradiction.
  Universal.HasEssential(a, subset, 1 + (maximum ∸ 1)) by substituting putBack;
  Universal.HasEssential(a, subset, (maximum ∸ 1) + (maximum ∸ 1)) by Universal.HasEssential.doubled;
  (maximum ∸ 1) + (maximum ∸ 1) ≤ maximum by isGreatest;
  (2 : ℕ) ≤ maximum ∸ 1
      by { 1 + 2 ≤ maximum = 1 + (maximum ∸ 1) by putBack;
           done };
  1 + (1 + (maximum ∸ 1))
     ≤ (maximum ∸ 1) + (maximum ∸ 1)
     ≤ maximum
     = 1 + (maximum ∸ 1) by putBack;
  done by Natural.not_one_plus_le_self
}

-- ── The main theorem ──────────────────────────────────────────────────
--
-- Zhuk's centre theorem in its final form: for a subdirect `R ≤ A × B` with
-- `B` Taylor and without a proper binary absorbing subalgebra, a *ternary*
-- term witnesses that the left centre absorbs `A`.

theorem Universal.leftCenter_ternary_witness
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (baseEnumeration : List(Universal.carrier(a)))
        (baseIsEnumeration : Set.IsEnumeration(Universal.carrier(a), baseEnumeration))
        (baseCount : ℕ)
        (baseFinite : HasSize(Universal.carrier(a), baseCount))
        (fibreEnumeration : List(Universal.carrier(b)))
        (fibreIsEnumeration : Set.IsEnumeration(Universal.carrier(b), fibreEnumeration))
        (relation : Set(Universal.carrier(a × b)))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (arity : ℕ) (positive : 1 ≤ arity)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (noProperBinaryAbsorbing : ∀ (part : Set(Universal.carrier(b))). Universal.IsSubuniverse(b, part)
            → Set.IsNonempty(Universal.carrier(b), part) → ¬(part = Universal.universe(b))
            → ¬Universal.BinaryAbsorbs(b, part, Universal.universe(b)))
        : ∃ (ternary : Universal.Term(signature, NaturalsBelow(3))). Universal.Witnesses(a, Universal.leftCenter(a, b, relation),
              Universal.universe(a), ternary) := {
  Universal.CentrallyAbsorbs(a, Universal.leftCenter(a, b, relation)) by Universal.zhuk_center;
  Universal.IsSubuniverse(a, Universal.leftCenter(a, b, relation)) by Universal.IsSubuniverse.leftCenter;
  done by Universal.centrally_absorbs_ternary
}
