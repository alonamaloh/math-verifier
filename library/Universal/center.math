-- Universal/center.math
--
-- Left centres and their neighbourhoods. Blueprint Part III, Definitions 4.1
-- and 4.2, Lemma 4.3, and the two theorems that drive the centre argument:
-- the enlargement step (Theorem 5.1) and its iteration (Theorem 5.2).
--
-- For a subdirect `R ≤ A × B`, the neighbourhood `a + R` is the set of `b`
-- related to `a`, and the left centre is the set of `a` related to everything.
-- The two idempotence hypotheses enter in mirror image: `A` idempotent is what
-- lets the first coordinate stay put while the operations act on the second,
-- making each neighbourhood a subuniverse of `B`; `B` idempotent does the same
-- the other way round, for the left centre.
--
-- Both theorems are stated over tuples constrained coordinatewise, matching
-- `Universal.Witnesses`. That is deliberate — blueprint Remark 5.3: the
-- alternative shape, quantifying over a tuple drawn from the centre and
-- overwriting one entry, leaves a gap when the centre is empty, and no
-- degenerate case has to be excluded in the shape used here.

module Universal.center

import axioms
import Logic.basics
import Logic.exists
import Logic.functions
import Logic.product
import Equality.basics
import Natural.basics
import Natural.order
import Natural.minimum
import Set.basics
import Set.algebra
import Set.finite
import Set.enumeration
import Universal.signature
import Universal.term
import Universal.product
import Universal.absorption
import Universal.star_power

convention signature : Universal.Signature

-- ── Subdirect relations, neighbourhoods, centres ──────────────────────

-- A pair, at the product's carrier type. `Product.make` on its own leaves the
-- component types to be inferred from context, and inside a tuple handed to
-- `Universal.Algebra.interpret` there is no context to infer them from — the
-- algebra that `interpret` acts in is itself what is being determined. Naming
-- the constructor at the type it is wanted at settles both at once, and every
-- membership below reads `Universal.pair(a, b, x, y) ∈ relation`.
definition Universal.pair
        (a b : Universal.Algebra(signature))
        (base : a)
        (fibre : b)
        : a × b := Product.make(base, fibre)

-- Its two components, and the reassembly.
theorem Universal.pair_first
        (a b : Universal.Algebra(signature))
        (base : a)
        (fibre : b)
        : Product.first(Universal.pair(a, b, base, fibre)) = base := done

theorem Universal.pair_second
        (a b : Universal.Algebra(signature))
        (base : a)
        (fibre : b)
        : Product.second(Universal.pair(a, b, base, fibre)) = fibre := done

theorem Universal.pair_eta
        (a b : Universal.Algebra(signature))
        (point : a × b)
        : Universal.pair(a, b, Product.first(point), Product.second(point))
          = point := done by Product.eta

-- The operations act coordinatewise on pairs: this is the whole content of the
-- binary product, and both halves of Lemma 4.3 are it plus idempotence.
theorem Universal.pair_interpret
        (a b : Universal.Algebra(signature)) (arity : ℕ)
        (symbol : signature(arity))
        (bases : NaturalsBelow(arity) → a)
        (fibres : NaturalsBelow(arity) → b)
        : Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ Universal.pair(a, b, bases(slot), fibres(slot))))
          = Universal.pair(a, b, Universal.Algebra.interpret(arity, symbol, bases), Universal.Algebra.interpret(arity, symbol, fibres)) :=
  done

-- Blueprint Definition 4.1: both projections are onto.
definition Universal.IsSubdirect
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b)) : Proposition := (∀ (base : a). ∃ (fibre : b). Universal.pair(a, b, base, fibre) ∈ relation)
  ∧ ∀ (fibre : b). ∃ (base : a). Universal.pair(a, b, base, fibre) ∈ relation

-- Blueprint Definition 4.2: the neighbourhood `element + R`.
definition Universal.neighborhood
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (element : a)
        : Set(b) :=
  (candidate : b) ↦ Universal.pair(a, b, element, candidate) ∈ relation

-- Blueprint Definition 4.2: the left centre, the elements related to all of `B`.
definition Universal.leftCenter
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        : Set(a) :=
  (element : a) ↦ ∀ (candidate : b). Universal.pair(a, b, element, candidate) ∈ relation

-- ── Lemma 4.3 ─────────────────────────────────────────────────────────

-- (a) Each neighbourhood is a subuniverse of `B`. The operations act on the
-- second coordinate while idempotence of `A` holds the first one still.
theorem Universal.IsSubuniverse.neighborhood
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (element : a)
        : Universal.IsSubuniverse(b,
            Universal.neighborhood(a, b, relation, element)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → b;
  suppose ∀ (slot : NaturalsBelow(arity)). arguments(slot) ∈ Universal.neighborhood(a, b, relation, element)
      as allRelated;
  ∀ (slot : NaturalsBelow(arity)). Universal.pair(a, b, element, arguments(slot)) ∈ relation by allRelated;
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ Universal.pair(a, b, element, arguments(slot))))
      ∈ relation;
  -- In the product the operation acts coordinatewise, and idempotence returns
  -- the first coordinate unchanged.
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ element)) = element by idempotentBase;
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ Universal.pair(a, b, element, arguments(slot))))
     = Universal.pair(a, b, Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ element)),
         Universal.Algebra.interpret(arity, symbol, arguments))
           by Universal.pair_interpret
     = Universal.pair(a, b, element, Universal.Algebra.interpret(arity, symbol, arguments));
  Universal.pair(a, b, element, Universal.Algebra.interpret(arity, symbol, arguments))
      ∈ relation;
  done
}

-- (b) Neighbourhoods are nonempty — this is subdirectness on the first factor.
theorem Universal.neighborhood_nonempty
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (element : a)
        : Set.IsNonempty(b,
            Universal.neighborhood(a, b, relation, element)) := {
  ∀ (base : a). ∃ (fibre : b). Universal.pair(a, b, base, fibre) ∈ relation as everyBaseMet;
  choose fibre such that Universal.pair(a, b, element, fibre) ∈ relation
      from everyBaseMet(element);
  fibre ∈ Universal.neighborhood(a, b, relation, element);
  witness fibre
}

-- The left centre is exactly where the neighbourhood is everything. Both
-- directions are used: one to recognise a saturated neighbourhood as a centre
-- element, the other to read a centre element's neighbourhood off as full.
theorem Universal.leftCenter_of_neighborhood_universe
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (element : a)
        (full : Universal.neighborhood(a, b, relation, element)
                = Universal.universe(b))
        : element ∈ Universal.leftCenter(a, b, relation) := {
  take candidate : b;
  candidate ∈ Universal.universe(b);
  candidate ∈ Universal.neighborhood(a, b, relation, element) by substituting full;
  done
}

theorem Universal.neighborhood_universe_of_leftCenter
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (element : a)
        (central : element ∈ Universal.leftCenter(a, b, relation))
        : Universal.neighborhood(a, b, relation, element)
          = Universal.universe(b) := {
  ∀ (candidate : b). Universal.pair(a, b, element, candidate) ∈ relation by central;
  Universal.neighborhood(a, b, relation, element)
      ⊆ Universal.universe(b)
      by { take candidate : b;
           suppose candidate ∈ Universal.neighborhood(a, b, relation, element);
           done };
  Universal.universe(b)
      ⊆ Universal.neighborhood(a, b, relation, element)
      by { take candidate : b;
           suppose candidate ∈ Universal.universe(b);
           Universal.pair(a, b, element, candidate) ∈ relation;
           done };
  done by Set.equal_of_same_members
}

-- (c) The left centre is a subuniverse of `A`. The mirror image of (a):
-- idempotence of `B` holds the second coordinate still.
theorem Universal.IsSubuniverse.leftCenter
        (a b : Universal.Algebra(signature))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        : Universal.IsSubuniverse(a, Universal.leftCenter(a, b, relation)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → a;
  suppose ∀ (slot : NaturalsBelow(arity)). arguments(slot) ∈ Universal.leftCenter(a, b, relation) as allCentral;
  take candidate : b;
  ∀ (slot : NaturalsBelow(arity)). Universal.pair(a, b, arguments(slot), candidate) ∈ relation
      by { take slot : NaturalsBelow(arity);
           ∀ (point : b). Universal.pair(a, b, arguments(slot), point) ∈ relation by allCentral;
           done };
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ Universal.pair(a, b, arguments(slot), candidate)))
      ∈ relation;
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ candidate)) = candidate by idempotentFibre;
  Universal.Algebra.interpret(arity, symbol, ((slot : NaturalsBelow(arity)) ↦ Universal.pair(a, b, arguments(slot), candidate)))
     = Universal.pair(a, b, Universal.Algebra.interpret(arity, symbol, arguments), Universal.Algebra.interpret(arity, symbol,
           ((slot : NaturalsBelow(arity)) ↦ candidate)))
           by Universal.pair_interpret
     = Universal.pair(a, b, Universal.Algebra.interpret(arity, symbol, arguments), candidate);
  Universal.pair(a, b, Universal.Algebra.interpret(arity, symbol, arguments), candidate)
      ∈ relation;
  done
}

-- (d) Preservation along the relation: a term evaluated at related tuples has
-- related values. This is preservation in the product, read one coordinate at
-- a time.
theorem Universal.neighborhood.preserves
        {variables : Type(0)}
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subject : Universal.Term(signature, variables))
        (base : variables → a)
        (fibre : variables → b)
        (related : ∀ (name : variables). fibre(name) ∈ Universal.neighborhood(a, b, relation, base(name)))
        : Universal.Term.evaluate(b, fibre, subject)
          ∈ Universal.neighborhood(a, b, relation,
              Universal.Term.evaluate(a, base, subject)) := {
  ∀ (name : variables). Universal.pair(a, b, base(name), fibre(name)) ∈ relation by related;
  Universal.Term.evaluate(a × b, ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject)
      ∈ relation by Universal.Term.evaluate_mem;
  -- The two coordinates of that value are the two evaluations.
  Product.first(Universal.Term.evaluate(a × b, ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject))
     = Universal.Term.evaluate(a, base, subject)
     by Universal.Term.first_evaluate_product;
  Product.second(Universal.Term.evaluate(a × b, ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject))
     = Universal.Term.evaluate(b, fibre, subject)
     by Universal.Term.second_evaluate_product;
  Universal.Term.evaluate(a × b, ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject)
     = Universal.pair(a, b, Product.first(Universal.Term.evaluate(a × b,
           ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject)), Product.second(Universal.Term.evaluate(a × b,
           ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject)))
           by Product.eta
     = Universal.pair(a, b, Universal.Term.evaluate(a, base, subject), Product.second(Universal.Term.evaluate(a × b,
           ((name : variables) ↦ Universal.pair(a, b, base(name), fibre(name))), subject)))
     = Universal.pair(a, b, Universal.Term.evaluate(a, base, subject), Universal.Term.evaluate(b, fibre, subject));
  Universal.pair(a, b, Universal.Term.evaluate(a, base, subject), Universal.Term.evaluate(b, fibre, subject)) ∈ relation;
  done
}

-- The left centre is closed under term operations, by (c) and preservation.
theorem Universal.leftCenter.evaluate_mem
        {variables : Type(0)}
        (a b : Universal.Algebra(signature))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subject : Universal.Term(signature, variables))
        (valuation : variables → a)
        (allCentral : ∀ (name : variables). valuation(name) ∈ Universal.leftCenter(a, b, relation))
        : Universal.Term.evaluate(a, valuation, subject)
          ∈ Universal.leftCenter(a, b, relation) := {
  Universal.IsSubuniverse(a, Universal.leftCenter(a, b, relation)) by Universal.IsSubuniverse.leftCenter;
  done by Universal.Term.evaluate_mem
}

-- ── The enlargement step ──────────────────────────────────────────────
--
-- Blueprint Theorem 5.1. Applying a Taylor term of `B` with one coordinate free
-- and centre elements everywhere else strictly enlarges the neighbourhood,
-- until it saturates — unless the neighbourhood binary absorbs `B`, which the
-- hypothesis on `B` forbids for a proper one.

-- The blueprint's `E`: the values of `subject` on tuples whose `free` entry is
-- confined to `part`, the others ranging over all of `B`.
definition Universal.stepImage
        (b : Universal.Algebra(signature)) (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (free : NaturalsBelow(arity))
        (part : Set(b))
        : Set(b) :=
  (candidate : b) ↦ ∃ (tuple : NaturalsBelow(arity) → b). tuple(free) ∈ part ∧ Universal.Term.evaluate(b, tuple, subject) = candidate

-- Step 2 of the blueprint's proof: the constant tuple at a point of `part` is
-- admissible, and an idempotent algebra's term operations return it unchanged.
theorem Universal.subset_stepImage
        (b : Universal.Algebra(signature))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (free : NaturalsBelow(arity))
        (part : Set(b))
        : part ⊆ Universal.stepImage(b, arity, subject, free, part) := {
  take candidate : b;
  suppose candidate ∈ part;
  ((slot : NaturalsBelow(arity)) ↦ candidate)(free) ∈ part;
  Universal.Term.evaluate(b, ((slot : NaturalsBelow(arity)) ↦ candidate), subject)
      = candidate by Universal.Term.evaluate_constant;
  done by { witness ((slot : NaturalsBelow(arity)) ↦ candidate) }
}

-- Step 1: the image lands in the neighbourhood of the value. This is where the
-- centre elements at the other coordinates are used — their neighbourhoods are
-- everything, so the constraint there is no constraint.
theorem Universal.stepImage_subset_neighborhood
        (a b : Universal.Algebra(signature))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (free : NaturalsBelow(arity))
        (valuation : NaturalsBelow(arity) → a)
        (othersCentral : ∀ (slot : NaturalsBelow(arity)). slot ≠ free → valuation(slot) ∈ Universal.leftCenter(a, b, relation))
        : Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free)))
          ⊆ Universal.neighborhood(a, b, relation,
              Universal.Term.evaluate(a, valuation, subject)) := {
  take candidate : b;
  suppose candidate ∈ Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free))) as inImage;
  choose tuple such that tuple(free) ∈ Universal.neighborhood(a, b, relation, valuation(free))
      ∧ Universal.Term.evaluate(b, tuple, subject) = candidate
      from inImage;
  tuple(free) ∈ Universal.neighborhood(a, b, relation, valuation(free));
  Universal.Term.evaluate(b, tuple, subject) = candidate;
  ∀ (slot : NaturalsBelow(arity)). tuple(slot) ∈ Universal.neighborhood(a, b, relation, valuation(slot))
      by { take slot : NaturalsBelow(arity);
           done by cases {
             case slot = free as isFree: done by substituting isFree
             otherwise as isOther: {
                 valuation(slot) ∈ Universal.leftCenter(a, b, relation) by othersCentral;
                 Universal.pair(a, b, valuation(slot), tuple(slot)) ∈ relation;
                 done
               }
           } };
  Universal.Term.evaluate(b, tuple, subject)
      ∈ Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, subject))
      by Universal.neighborhood.preserves;
  done
}

-- When the image collapses back onto `part`, the one-sided closure condition of
-- blueprint Lemma 2.6 holds verbatim, and a Taylor identity at the free
-- coordinate turns it into two-sided binary absorption.
theorem Universal.BinaryAbsorbs.of_stepImage_eq
        (b : Universal.Algebra(signature)) (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (free : NaturalsBelow(arity))
        (part : Set(b))
        (collapsed : Universal.stepImage(b, arity, subject, free, part) = part)
        : Universal.BinaryAbsorbs(b, part,
            Universal.universe(b)) := {
  choose left such that ∃ (right : NaturalsBelow(arity) → NaturalsBelow(2)). Universal.IsTaylorIdentity(b,
          Universal.universe(b), arity, subject, free, left, right)
      from taylor(free);
  choose right such that Universal.IsTaylorIdentity(b, Universal.universe(b), arity, subject, free, left, right);
  part ⊆ Universal.universe(b)
      by { take candidate : b;
           suppose candidate ∈ part;
           done };
  ∀ (tuple : NaturalsBelow(arity) → b). tuple(free) ∈ part → (∀ (slot : NaturalsBelow(arity)). slot ≠ free
           → tuple(slot) ∈ Universal.universe(b)) → Universal.Term.evaluate(b, tuple, subject) ∈ part
      by { take tuple : NaturalsBelow(arity) → b;
           suppose tuple(free) ∈ part;
           suppose ∀ (slot : NaturalsBelow(arity)). slot ≠ free → tuple(slot) ∈ Universal.universe(b);
           Universal.Term.evaluate(b, tuple, subject)
               ∈ Universal.stepImage(b, arity, subject, free, part)
               by { witness tuple };
           done by substituting collapsed };
  done by Universal.BinaryAbsorbs.of_one_sided
}

-- Blueprint Theorem 5.1. Either the image is strictly bigger than the
-- neighbourhood, and Steps 1 and 2 pass the gain on; or it collapses, and then
-- the neighbourhood binary absorbs `B`, so it is all of `B` and the value's
-- neighbourhood is too.
theorem Universal.center_step
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (enumeration : List(b))
        (isEnumeration : Set.IsEnumeration(b, enumeration))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (noProperBinaryAbsorbing : ∀ (part : Set(b)). Universal.IsSubuniverse(b, part)
            → Set.IsNonempty(b, part) → part ≠ Universal.universe(b) → ¬Universal.BinaryAbsorbs(b, part, Universal.universe(b)))
        (free : NaturalsBelow(arity))
        (valuation : NaturalsBelow(arity) → a)
        (othersCentral : ∀ (slot : NaturalsBelow(arity)). slot ≠ free → valuation(slot) ∈ Universal.leftCenter(a, b, relation))
        : min(Set.size(enumeration, Universal.universe(b)), 1 + Set.size(enumeration,
                Universal.neighborhood(a, b, relation, valuation(free))))
          ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation,
                Universal.Term.evaluate(a, valuation, subject))) := {
  Universal.neighborhood(a, b, relation, valuation(free))
      ⊆ Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free)))
      by Universal.subset_stepImage;
  Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free)))
      ⊆ Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, subject))
      by Universal.stepImage_subset_neighborhood;
  done by cases {
    case Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free)))
         = Universal.neighborhood(a, b, relation, valuation(free))
           as collapsed: {
        -- The neighbourhood binary absorbs `B`, so it is not proper.
        Universal.BinaryAbsorbs(b, Universal.neighborhood(a, b, relation, valuation(free)), Universal.universe(b))
            by Universal.BinaryAbsorbs.of_stepImage_eq;
        Universal.IsSubuniverse(b, Universal.neighborhood(a, b, relation, valuation(free))) by Universal.IsSubuniverse.neighborhood;
        Set.IsNonempty(b, Universal.neighborhood(a, b, relation, valuation(free))) by Universal.neighborhood_nonempty;
        Universal.neighborhood(a, b, relation, valuation(free))
            = Universal.universe(b)
            by { suppose ¬(Universal.neighborhood(a, b, relation, valuation(free))
                   = Universal.universe(b))
                     for contradiction;
                 ¬Universal.BinaryAbsorbs(b, Universal.neighborhood(a, b, relation, valuation(free)), Universal.universe(b))
                     by noProperBinaryAbsorbing;
                 done };
        -- So the free coordinate is central too, and hence so is the value.
        valuation(free) ∈ Universal.leftCenter(a, b, relation)
            by Universal.leftCenter_of_neighborhood_universe;
        ∀ (slot : NaturalsBelow(arity)). valuation(slot) ∈ Universal.leftCenter(a, b, relation)
            by { take slot : NaturalsBelow(arity);
                 done by cases {
                   case slot = free as isFree: done by substituting isFree
                   otherwise: done by othersCentral
                 } };
        Universal.Term.evaluate(a, valuation, subject)
            ∈ Universal.leftCenter(a, b, relation)
            by Universal.leftCenter.evaluate_mem;
        Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, subject))
            = Universal.universe(b)
            by Universal.neighborhood_universe_of_leftCenter as valueSaturated;
        min(Set.size(enumeration, Universal.universe(b)), 1 + Set.size(enumeration,
              Universal.neighborhood(a, b, relation, valuation(free))))
           ≤ Set.size(enumeration, Universal.universe(b))
                 by Natural.minimum_le_left;
        done by substituting valueSaturated
      }
    otherwise as grows: {
        -- Strictly bigger, and Step 1 passes the gain on.
        Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)))
          < Set.size(enumeration, Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free))))
          by { ¬(Universal.neighborhood(a, b, relation, valuation(free))
                 = Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free))))
                 by { suppose Universal.neighborhood(a, b, relation, valuation(free))
                        = Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free))) as flipped;
                      Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free)))
                        = Universal.neighborhood(a, b, relation, valuation(free)) by flipped;
                      done };
               done by Set.size_lt_of_proper_subset };
        min(Set.size(enumeration, Universal.universe(b)), 1 + Set.size(enumeration,
              Universal.neighborhood(a, b, relation, valuation(free))))
           ≤ 1 + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)))
                 by Natural.minimum_le_right
           ≤ Set.size(enumeration, Universal.stepImage(b, arity, subject, free, Universal.neighborhood(a, b, relation, valuation(free))))
           ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, subject)))
                 by Set.size_le_of_subset;
        done
      }
  }
}

-- ── The iteration ─────────────────────────────────────────────────────
--
-- Blueprint Theorem 5.2. Iterating the enlargement step drives the value into
-- the centre, so a star power of a Taylor term witnesses that the left centre
-- absorbs `A`.
--
-- The star power cannot be named as a function of the depth — `Natural.add` is
-- opaque, so a recursive definition whose result type mentions the depth does
-- not typecheck; see `Universal/star_power.math`. The induction therefore
-- produces the term *together with* the bound it satisfies, which is what the
-- argument wants anyway: the invariant is what is carried up the levels.

-- One level of that induction. The block values are a parameter constrained by
-- their defining equation rather than a `let`-bound lambda: a `let` is expanded
-- in the goal, leaving an equation about it nothing to rewrite.
theorem Universal.center_star_step
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (enumeration : List(b))
        (isEnumeration : Set.IsEnumeration(b, enumeration))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (noProperBinaryAbsorbing : ∀ (part : Set(b)). Universal.IsSubuniverse(b, part)
            → Set.IsNonempty(b, part) → part ≠ Universal.universe(b) → ¬Universal.BinaryAbsorbs(b, part, Universal.universe(b)))
        (rest : ℕ)
        (inner : Universal.Term(signature, Universal.StarIndex(arity, rest)))
        (innerBound : ∀ (position : Universal.StarIndex(arity, rest)). ∀ (values : Universal.StarIndex(arity, rest)
            → a). (∀ (other : Universal.StarIndex(arity, rest)). other ≠ position
                 → values(other) ∈ Universal.leftCenter(a, b, relation)) → min(Set.size(enumeration,
            Universal.universe(b)), rest + Set.size(enumeration, Universal.neighborhood(a, b, relation, values(position))))
                ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, values, inner))))
        (free : Universal.StarIndex(arity, 1 + rest))
        (valuation : Universal.StarIndex(arity, 1 + rest) → a)
        (othersCentral : ∀ (other : Universal.StarIndex(arity, 1 + rest)). other ≠ free
            → valuation(other) ∈ Universal.leftCenter(a, b, relation))
        (blockValues : NaturalsBelow(arity) → a)
        (blockValuesSpec : ∀ (block : NaturalsBelow(arity)). blockValues(block)
            = Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦
                  valuation(Universal.starPrepend(arity, rest, block, position))), inner))
        : min(Set.size(enumeration, Universal.universe(b)), (1 + rest) + Set.size(enumeration,
                Universal.neighborhood(a, b, relation, valuation(free))))
          ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation,
                  Universal.starStep(signature, arity, rest, subject,
                    inner)))) := {
  -- The free index sits in block `starHead(free)` at position `starTail(free)`.
  Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), Universal.starTail(arity, rest, free)) = free
      by Universal.starPrepend_head_tail;
  -- Every other block carries centre elements only.
  ∀ (block : NaturalsBelow(arity)). block ≠ Universal.starHead(arity, rest, free)
      → blockValues(block) ∈ Universal.leftCenter(a, b, relation)
      by { take block : NaturalsBelow(arity);
           suppose block ≠ Universal.starHead(arity, rest, free)
               as blockDiffers;
           ∀ (position : Universal.StarIndex(arity, rest)). valuation(Universal.starPrepend(arity, rest, block, position))
                 ∈ Universal.leftCenter(a, b, relation)
               by { take position : Universal.StarIndex(arity, rest);
                    Universal.starPrepend(arity, rest, block, position) ≠ free
                        by { suppose Universal.starPrepend(arity, rest, block, position) = free as isFree;
                             Universal.starHead(arity, rest, Universal.starPrepend(arity, rest, block, position)) = block
                                 by Universal.starHead_prepend;
                             block
                                = Universal.starHead(arity, rest, Universal.starPrepend(arity, rest, block, position))
                                = Universal.starHead(arity, rest, free)
                                    by substituting isFree;
                             done };
                    done by othersCentral };
           Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦
                 valuation(Universal.starPrepend(arity, rest, block, position))), inner)
             ∈ Universal.leftCenter(a, b, relation)
               by Universal.leftCenter.evaluate_mem;
           done by substituting blockValuesSpec(block) };
  -- The free block carries the free index, so the inductive bound applies there.
  min(Set.size(enumeration, Universal.universe(b)), rest + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
     ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, blockValues(Universal.starHead(arity, rest, free))))
     by { ∀ (other : Universal.StarIndex(arity, rest)). other ≠ Universal.starTail(arity, rest, free)
              → valuation(Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), other))
                ∈ Universal.leftCenter(a, b, relation)
              by { take other : Universal.StarIndex(arity, rest);
                   suppose other ≠ Universal.starTail(arity, rest, free)
                       as positionDiffers;
                   Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), other) ≠ free
                       by { suppose Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), other)
                              = free as isFree;
                            Universal.starTail(arity, rest, Universal.starPrepend(arity, rest,
                                  Universal.starHead(arity, rest, free), other))
                              = other
                              by Universal.starTail_prepend;
                            other
                               = Universal.starTail(arity, rest, Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free),
                                     other))
                               = Universal.starTail(arity, rest, free)
                                   by substituting isFree;
                            done };
                   done by othersCentral } as positionsCentral;
          -- The value at the distinguished position is the value at `free`.
          valuation(Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), Universal.starTail(arity, rest, free)))
            = valuation(free) as freeValue;
          min(Set.size(enumeration, Universal.universe(b)), rest + Set.size(enumeration,
                Universal.neighborhood(a, b, relation, valuation(Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free),
                    Universal.starTail(arity, rest, free))))))
            ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a,
                    ((position : Universal.StarIndex(arity, rest)) ↦ valuation(Universal.starPrepend(arity, rest,
              Universal.starHead(arity, rest, free), position))), inner)))
            by innerBound(Universal.starTail(arity, rest, free), ((position : Universal.StarIndex(arity, rest)) ↦
                valuation(Universal.starPrepend(arity, rest, Universal.starHead(arity, rest, free), position))), positionsCentral);
          Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦ valuation(Universal.starPrepend(arity, rest,
                  Universal.starHead(arity, rest, free), position))), inner)
            = blockValues(Universal.starHead(arity, rest, free))
            by blockValuesSpec;
          done by substituting freeValue };
  -- One more enlargement step, at the free block.
  min(Set.size(enumeration, Universal.universe(b)), 1 + Set.size(enumeration, Universal.neighborhood(a, b, relation,
          blockValues(Universal.starHead(arity, rest, free)))))
     ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, blockValues, subject)))
     by Universal.center_step;
  -- And the two bounds compose, capping before incrementing.
  Universal.Term.evaluate(a, valuation, Universal.starStep(signature, arity, rest, subject, inner))
     = Universal.Term.evaluate(a, ((block : NaturalsBelow(arity)) ↦ Universal.Term.evaluate(a,
      ((position : Universal.StarIndex(arity, rest)) ↦ valuation(Universal.starPrepend(arity, rest, block, position))), inner)), subject)
           by Universal.starStep_evaluate
     = Universal.Term.evaluate(a, blockValues, subject)
           by { blockValues
                  = ((block : NaturalsBelow(arity)) ↦ Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦
                          valuation(Universal.starPrepend(arity, rest, block, position))), inner))
                  by { ∀ (block : NaturalsBelow(arity)). blockValues(block)
                           = Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦
                                 valuation(Universal.starPrepend(arity, rest, block, position))), inner)
                           by blockValuesSpec;
                       done by Function.extensionality };
                done by substitution }
     as levelValue;
  1 + min(Set.size(enumeration, Universal.universe(b)), rest + Set.size(enumeration,
          Universal.neighborhood(a, b, relation, valuation(free))))
     ≤ 1 + Set.size(enumeration, Universal.neighborhood(a, b, relation, blockValues(Universal.starHead(arity, rest, free))));
  min(Set.size(enumeration, Universal.universe(b)), (1 + rest) + Set.size(enumeration,
        Universal.neighborhood(a, b, relation, valuation(free))))
     = min(Set.size(enumeration, Universal.universe(b)), 1 + (rest + Set.size(enumeration,
           Universal.neighborhood(a, b, relation, valuation(free)))))
     = min(Set.size(enumeration, Universal.universe(b)), 1 + min(Set.size(enumeration, Universal.universe(b)), rest + Set.size(enumeration,
      Universal.neighborhood(a, b, relation, valuation(free)))))
           by Natural.minimum_absorbs_one_plus
     ≤ min(Set.size(enumeration, Universal.universe(b)), 1 + Set.size(enumeration,
           Universal.neighborhood(a, b, relation, blockValues(Universal.starHead(arity, rest, free)))))
           by Natural.minimum_monotone_right
     ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, blockValues, subject)));
  done by substituting levelValue
}

-- The induction `(∗_ℓ)` of blueprint Theorem 5.2, carrying the term with it.
-- Note the quantifier shape: one distinguished index takes an arbitrary element
-- of `A` and every *other* index takes a centre element — the shape of
-- `Universal.Witnesses`, not "a tuple from the centre with one entry
-- overwritten". Blueprint Remark 5.3: the latter is unusable when the centre is
-- empty, and no case analysis is needed here.
theorem Universal.center_star
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (enumeration : List(b))
        (isEnumeration : Set.IsEnumeration(b, enumeration))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (noProperBinaryAbsorbing : ∀ (part : Set(b)). Universal.IsSubuniverse(b, part)
            → Set.IsNonempty(b, part) → part ≠ Universal.universe(b) → ¬Universal.BinaryAbsorbs(b, part, Universal.universe(b)))
        (depth : ℕ)
        : ∃ (power : Universal.Term(signature, Universal.StarIndex(arity, depth))). ∀ (free : Universal.StarIndex(arity, depth)).
            ∀ (valuation : Universal.StarIndex(arity, depth) → a).
              (∀ (other : Universal.StarIndex(arity, depth)). other ≠ free → valuation(other) ∈ Universal.leftCenter(a, b, relation))
              → min(Set.size(enumeration, Universal.universe(b)), depth + Set.size(enumeration,
            Universal.neighborhood(a, b, relation, valuation(free))))
                ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power))) :=
  by induction on depth with IH {
    case depth = 0: {
        -- The one-point index type: the term is the single variable, and the
        -- bound is `min(|B|, s) ≤ s`.
        ∀ (free : Universal.StarIndex(arity, 0)). ∀ (valuation : Universal.StarIndex(arity, 0) → a).
              (∀ (other : Universal.StarIndex(arity, 0)). other ≠ free → valuation(other) ∈ Universal.leftCenter(a, b, relation))
              → min(Set.size(enumeration, Universal.universe(b)), 0 + Set.size(enumeration,
            Universal.neighborhood(a, b, relation, valuation(free))))
                ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation,
            Universal.starBase(signature, arity))))
            by { take free : Universal.StarIndex(arity, 0);
                 take valuation : Universal.StarIndex(arity, 0) → a;
                 suppose ∀ (other : Universal.StarIndex(arity, 0)). other ≠ free → valuation(other) ∈ Universal.leftCenter(a, b, relation);
                 -- There is only one index at depth zero.
                 ∀ (slot : NaturalsBelow(0)). Universal.emptyStarIndex(arity)(slot) = free(slot)
                     by { take slot : NaturalsBelow(0);
                          False by NaturalsBelow.zero_is_empty;
                          done };
                 Universal.emptyStarIndex(arity) = free by Function.extensionality;
                 Universal.Term.evaluate(a, valuation, Universal.starBase(signature, arity))
                    = valuation(Universal.emptyStarIndex(arity))
                          by Universal.starBase_evaluate
                    = valuation(free);
                 min(Set.size(enumeration, Universal.universe(b)), 0 + Set.size(enumeration,
                       Universal.neighborhood(a, b, relation, valuation(free))))
                    ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)))
                          by Natural.minimum_le_right;
                 done };
        witness Universal.starBase(signature, arity)
      }
    case depth = 1 + rest for some (rest : ℕ): {
        choose inner such that ∀ (free : Universal.StarIndex(arity, rest)). ∀ (valuation : Universal.StarIndex(arity, rest)
            → a). (∀ (other : Universal.StarIndex(arity, rest)). other ≠ free
                 → valuation(other) ∈ Universal.leftCenter(a, b, relation)) → min(Set.size(enumeration,
            Universal.universe(b)), rest + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
                ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, inner)))
            from IH;
        ∀ (free : Universal.StarIndex(arity, 1 + rest)). ∀ (valuation : Universal.StarIndex(arity, 1 + rest)
            → a). (∀ (other : Universal.StarIndex(arity, 1 + rest)). other ≠ free
                 → valuation(other) ∈ Universal.leftCenter(a, b, relation)) → min(Set.size(enumeration,
            Universal.universe(b)), (1 + rest) + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
                ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation,
            Universal.starStep(signature, arity, rest, subject, inner))))
            by { take free : Universal.StarIndex(arity, 1 + rest);
                 take valuation : Universal.StarIndex(arity, 1 + rest) → a;
                 suppose ∀ (other : Universal.StarIndex(arity, 1 + rest)). other ≠ free
                     → valuation(other) ∈ Universal.leftCenter(a, b, relation);
                 -- The block values are what the level's evaluation law
                 -- produces, so their defining equation is reflexivity.
                 ∀ (block : NaturalsBelow(arity)). ((slot : NaturalsBelow(arity)) ↦ Universal.Term.evaluate(a,
                         ((position : Universal.StarIndex(arity, rest)) ↦ valuation(Universal.starPrepend(arity, rest, slot, position))),
                         inner))(block)
                     = Universal.Term.evaluate(a, ((position : Universal.StarIndex(arity, rest)) ↦
                           valuation(Universal.starPrepend(arity, rest, block, position))), inner)
                     by { take block : NaturalsBelow(arity);
                          done } as blockValuesReflexive;
                 done by Universal.center_star_step(blockValues := ((slot : NaturalsBelow(arity)) ↦ Universal.Term.evaluate(a,
                       ((position : Universal.StarIndex(arity, rest)) ↦ valuation(Universal.starPrepend(arity, rest, slot, position))),
                       inner)), blockValuesSpec := blockValuesReflexive) };
        witness Universal.starStep(signature, arity, rest, subject, inner)
      }
  }

-- **Blueprint Theorem 5.2** (Zhuk: the left centre absorbs). At depth `|B| - 1`
-- the bound saturates: the neighbourhood of the value has the size of all of
-- `B`, so it *is* all of `B`, and the value lies in the centre. That is
-- precisely the condition of Definition 2.1 for the star power.
theorem Universal.leftCenter_witnesses
        (a b : Universal.Algebra(signature))
        (idempotentBase : Universal.Algebra.IsIdempotent(a))
        (idempotentFibre : Universal.Algebra.IsIdempotent(b))
        (enumeration : List(b))
        (isEnumeration : Set.IsEnumeration(b, enumeration))
        (relation : Set(a × b))
        (closed : Universal.IsSubuniverse(a × b, relation))
        (subdirect : Universal.IsSubdirect(a, b, relation))
        (arity : ℕ)
        (subject : Universal.Term(signature, NaturalsBelow(arity)))
        (taylor : Universal.IsTaylorOn(b, Universal.universe(b), arity, subject))
        (noProperBinaryAbsorbing : ∀ (part : Set(b)). Universal.IsSubuniverse(b, part)
            → Set.IsNonempty(b, part) → part ≠ Universal.universe(b) → ¬Universal.BinaryAbsorbs(b, part, Universal.universe(b)))
        : ∃ (power : Universal.Term(signature, Universal.StarIndex(arity, Set.size(enumeration,
                Universal.universe(b)) ∸ 1))). Universal.Witnesses(a, Universal.leftCenter(a, b, relation),
              Universal.universe(a), power) := {
  choose power such that ∀ (free : Universal.StarIndex(arity, Set.size(enumeration, Universal.universe(b)) ∸ 1)).
      ∀ (valuation : Universal.StarIndex(arity, Set.size(enumeration, Universal.universe(b)) ∸ 1)
      → a). (∀ (other : Universal.StarIndex(arity, Set.size(enumeration,
      Universal.universe(b)) ∸ 1)). other ≠ free → valuation(other) ∈ Universal.leftCenter(a, b, relation))
        → min(Set.size(enumeration, Universal.universe(b)), (Set.size(enumeration, Universal.universe(b)) ∸ 1)
      + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
          ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power)))
      as powerBound
      from Universal.center_star(a, b, idempotentBase, idempotentFibre,
        enumeration, isEnumeration, relation, closed, subdirect, arity, subject, taylor, noProperBinaryAbsorbing,
        Set.size(enumeration, Universal.universe(b)) ∸ 1);
  Universal.Witnesses(a, Universal.leftCenter(a, b, relation), Universal.universe(a), power)
      by {
      take free : Universal.StarIndex(arity, Set.size(enumeration, Universal.universe(b)) ∸ 1);
      take valuation : Universal.StarIndex(arity, Set.size(enumeration, Universal.universe(b)) ∸ 1) → a;
      suppose valuation(free) ∈ Universal.universe(a);
      suppose ∀ (other : Universal.StarIndex(arity, Set.size(enumeration, Universal.universe(b)) ∸ 1)). other ≠ free
          → valuation(other) ∈ Universal.leftCenter(a, b, relation)
          as othersCentral;
      -- Every neighbourhood is nonempty, so `B` is, and one step per element of `B`
      -- beyond the first is enough to saturate.
      Set.IsNonempty(b, Universal.neighborhood(a, b, relation, valuation(free)))
          by Universal.neighborhood_nonempty;
      1 ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))) by Set.size_positive_of_nonempty;
      Universal.neighborhood(a, b, relation, valuation(free))
          ⊆ Universal.universe(b)
          by { take candidate : b;
               suppose candidate ∈ Universal.neighborhood(a, b, relation, valuation(free));
               done };
      Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)))
        ≤ Set.size(enumeration, Universal.universe(b))
          by Set.size_le_of_subset;
      1 ≤ Set.size(enumeration, Universal.universe(b));
      1 + (Set.size(enumeration, Universal.universe(b)) ∸ 1)
          = Set.size(enumeration, Universal.universe(b))
          by Natural.add_monus_of_le;
      Set.size(enumeration, Universal.universe(b))
         = 1 + (Set.size(enumeration, Universal.universe(b)) ∸ 1)
         ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)))
           + (Set.size(enumeration, Universal.universe(b)) ∸ 1)
         = (Set.size(enumeration, Universal.universe(b)) ∸ 1)
           + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free)));
      min(Set.size(enumeration, Universal.universe(b)), (Set.size(enumeration, Universal.universe(b)) ∸ 1)
          + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
          = Set.size(enumeration, Universal.universe(b))
          by Natural.minimum_eq_left;
      -- So the value's neighbourhood has the size of all of `B`, hence is all of it.
      Set.size(enumeration, Universal.universe(b))
         ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power)))
           by { min(Set.size(enumeration, Universal.universe(b)), (Set.size(enumeration, Universal.universe(b)) ∸ 1)
                    + Set.size(enumeration, Universal.neighborhood(a, b, relation, valuation(free))))
                  ≤ Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power)))
                  by powerBound;
                done };
      Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power))
          ⊆ Universal.universe(b)
          by { take candidate : b;
               suppose candidate ∈ Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power));
               done };
      Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power)))
        ≤ Set.size(enumeration, Universal.universe(b))
          by Set.size_le_of_subset;
      Set.size(enumeration, Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power)))
        = Set.size(enumeration, Universal.universe(b))
          by Natural.le_antisymmetric;
      Universal.neighborhood(a, b, relation, Universal.Term.evaluate(a, valuation, power))
        = Universal.universe(b)
          by Set.equal_of_size_eq;
      done by Universal.leftCenter_of_neighborhood_universe };
  witness power
}
