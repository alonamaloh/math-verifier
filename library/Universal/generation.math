-- Universal/generation.math
--
-- The subuniverse generated by a set, described from below: it is exactly the
-- set of values of terms whose variables range over that set.
--
-- The variable type IS the generating set, carved out as a subtype. No
-- enumeration of the generators is needed, and no substitution over varying
-- generator lists: a term over `Subtype(carrier, base)` already names which
-- generator sits at each leaf. This is what the arbitrary variable type of
-- `Universal.Term` was for.
--
-- Closure of the term values under an operation is where choice enters: each
-- argument is SOME term's value, and an operation needs a whole tuple of terms
-- at once. `NaturalsBelow.choice` supplies it.

module Universal.generation

import Logic.basics
import Logic.exists
import Equality.basics
import Natural.basics
import Set.basics
import Set.algebra
import Set.subtype
import Set.finite
import Set.finite_choice
import Universal.signature
import Universal.term
import Universal.generated

convention signature : Universal.Signature

-- The valuation that reads a generator out of the subtype.
definition Universal.baseValuation
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : Subtype(a, base) → a :=
  (element : Subtype(a, base)) ↦ Subtype.value(element)

-- The values of terms whose variables range over `base`.
definition Universal.termValues
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : Set(a) :=
  (subject : a) ↦ ∃ (subject_term : Universal.Term(signature, Subtype(a, base))).
      Universal.Term.evaluate(a, Universal.baseValuation(a, base), subject_term)
        = subject

theorem Universal.termValues.contains_base
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : base ⊆ Universal.termValues(a, base) := {
  take subject : a;
  suppose subject ∈ base as inBase;
  witness Universal.Term.variable(signature, Subtype(a, base), Subtype.make(a, base, subject, inBase))
}

theorem Universal.termValues.is_subuniverse
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : Universal.IsSubuniverse(a, Universal.termValues(a, base)) := {
  take arity : ℕ;
  take symbol : signature(arity);
  take arguments : NaturalsBelow(arity) → a;
  suppose ∀ (index : NaturalsBelow(arity)). arguments(index) ∈ Universal.termValues(a, base) as allValues;
  choose chosen such that ∀ (index : NaturalsBelow(arity)). Universal.Term.evaluate(a, Universal.baseValuation(a, base), chosen(index))
          = arguments(index)
      from NaturalsBelow.choice(Universal.Term(signature, Subtype(a, base)), arity, ((index : NaturalsBelow(arity)) ↦
          (candidate : Universal.Term(signature, Subtype(a, base))) ↦
            Universal.Term.evaluate(a, Universal.baseValuation(a, base), candidate)
              = arguments(index)), allValues);
  ((index : NaturalsBelow(arity)) ↦ Universal.Term.evaluate(a, Universal.baseValuation(a, base), chosen(index)))
    = arguments
    by Function.extensionality;
  witness Universal.Term.apply(signature, Subtype(a, base), arity, symbol, chosen)
}

theorem Universal.termValues.subset_generated
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : Universal.termValues(a, base) ⊆ Universal.generated(a, base) := {
  take subject : a;
  suppose subject ∈ Universal.termValues(a, base) as isValue;
  choose subject_term such that Universal.Term.evaluate(a, Universal.baseValuation(a, base), subject_term)
        = subject
      from isValue;
  Universal.IsSubuniverse(a, Universal.generated(a, base)) by Universal.generated.is_subuniverse;
  base ⊆ Universal.generated(a, base) by Universal.generated.contains_base;
  ∀ (element : Subtype(a, base)). Universal.baseValuation(a, base, element) ∈ Universal.generated(a, base)
    by {
      take element : Subtype(a, base);
      Subtype.value(element) ∈ base by Subtype.property;
      done
    };
  Universal.Term.evaluate(a, Universal.baseValuation(a, base), subject_term)
      ∈ Universal.generated(a, base)
      by Universal.Term.evaluate_mem;
  done
}

-- The generated subuniverse is exactly the term values. This is the blueprint's
-- Lemma 1.15, in the form that needs no enumeration of the generators.
theorem Universal.generated_eq_termValues
        (a : Universal.Algebra(signature))
        (base : Set(a))
        : Universal.generated(a, base) = Universal.termValues(a, base) := {
  Universal.IsSubuniverse(a, Universal.termValues(a, base));
  base ⊆ Universal.termValues(a, base);
  Universal.generated(a, base) ⊆ Universal.termValues(a, base) by Universal.generated.least;
  Universal.termValues(a, base) ⊆ Universal.generated(a, base);
  done by Set.equal_of_same_members
}
