module Universal.probe

import axioms
import Logic.basics
import Equality.basics
import Universal.signature

convention signature : Universal.Signature
convention a b : Universal.Algebra(signature)

-- mentions `a` but never `signature`: does the chain fire?
theorem Universal.probe_chain (element : Universal.Algebra.carrier(a))
        : element = element := reflexivity(Universal.Algebra.carrier(a), element)

-- mentions neither: must be unaffected
theorem Universal.probe_none (n : ℕ) : n = n := reflexivity(ℕ, n)
