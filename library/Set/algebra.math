-- Set/algebra.math
--
-- The Boolean operations on `Set(T) = T → Proposition`, and the laws a
-- consumer needs to reason with them.
--
-- Every membership fact here is definitional: `x ∈ a ∪ b` IS
-- `x ∈ a ∨ x ∈ b`, so the characterizing theorems are there for the
-- reader and for goal-shape matching rather than to do work. The laws
-- below them are the ones that are not free.

module Set.algebra

import Logic.basics
import Logic.excluded_middle
import Equality.basics
import Logic.exists
import Logic.functions
import Set.basics

-- ----------------------------------------------------------------------
-- The operations.

definition Set.universe (T : Type(0)) : Set(T) :=
  (subject : T) ↦ True

definition Set.empty (T : Type(0)) : Set(T) :=
  (subject : T) ↦ False

definition Set.union {T : Type(0)} (left right : Set(T)) : Set(T) :=
  (subject : T) ↦ subject ∈ left ∨ subject ∈ right

definition Set.intersection {T : Type(0)} (left right : Set(T)) : Set(T) :=
  (subject : T) ↦ subject ∈ left ∧ subject ∈ right

definition Set.complement {T : Type(0)} (subset : Set(T)) : Set(T) :=
  (subject : T) ↦ ¬(subject ∈ subset)

definition Set.difference {T : Type(0)} (larger smaller : Set(T)) : Set(T) :=
  (subject : T) ↦ subject ∈ larger ∧ ¬(subject ∈ smaller)

operator (∪) on (Set, Set) := Set.union
operator (∩) on (Set, Set) := Set.intersection
operator (∖) on (Set, Set) := Set.difference

-- ----------------------------------------------------------------------
-- Membership, spelled out. Definitional, but the shapes a proof cites.

theorem Set.member_universe {T : Type(0)} (subject : T)
        : subject ∈ Set.universe(T) :=
  True.trivial

theorem Set.not_member_empty {T : Type(0)} (subject : T)
        : ¬(subject ∈ Set.empty(T)) := {
  suppose subject ∈ Set.empty(T);
  done
}

theorem Set.member_union {T : Type(0)} (subject : T) (left right : Set(T))
        (inEither : subject ∈ left ∨ subject ∈ right)
        : subject ∈ left ∪ right :=
  inEither

theorem Set.member_intersection {T : Type(0)} (subject : T)
        (left right : Set(T))
        (inLeft : subject ∈ left) (inRight : subject ∈ right)
        : subject ∈ left ∩ right := {
  subject ∈ left;
  subject ∈ right;
  done
}

theorem Set.intersection_member_left {T : Type(0)} (subject : T)
        (left right : Set(T)) (inBoth : subject ∈ left ∩ right)
        : subject ∈ left := {
  subject ∈ left;
  done
}

theorem Set.intersection_member_right {T : Type(0)} (subject : T)
        (left right : Set(T)) (inBoth : subject ∈ left ∩ right)
        : subject ∈ right := {
  subject ∈ right;
  done
}

-- ----------------------------------------------------------------------
-- Subset laws.

theorem Set.intersection_subset_left {T : Type(0)} (left right : Set(T))
        : left ∩ right ⊆ left := {
  take subject : T;
  suppose subject ∈ left ∩ right as inBoth;
  done by Set.intersection_member_left
}

theorem Set.intersection_subset_right {T : Type(0)} (left right : Set(T))
        : left ∩ right ⊆ right := {
  take subject : T;
  suppose subject ∈ left ∩ right as inBoth;
  done by Set.intersection_member_right
}

theorem Set.subset_union_left {T : Type(0)} (left right : Set(T))
        : left ⊆ left ∪ right := {
  take subject : T;
  suppose subject ∈ left as inLeft;
  subject ∈ left ∨ subject ∈ right;
  done by Set.member_union
}

theorem Set.subset_union_right {T : Type(0)} (left right : Set(T))
        : right ⊆ left ∪ right := {
  take subject : T;
  suppose subject ∈ right as inRight;
  subject ∈ left ∨ subject ∈ right;
  done by Set.member_union
}

theorem Set.union_subset {T : Type(0)} (left right larger : Set(T))
        (leftInside : left ⊆ larger) (rightInside : right ⊆ larger)
        : left ∪ right ⊆ larger := {
  take subject : T;
  suppose subject ∈ left ∪ right as inEither;
  done by cases {
    case subject ∈ left as inLeft: leftInside(subject, inLeft)
    case subject ∈ right as inRight: rightInside(subject, inRight)
  }
}

theorem Set.subset_universe {T : Type(0)} (subset : Set(T))
        : subset ⊆ Set.universe(T) := {
  take subject : T;
  suppose subject ∈ subset;
  done by Set.member_universe
}

-- ----------------------------------------------------------------------
-- Complement. The one place classical logic is needed: a point outside
-- the complement is inside the set.

theorem Set.member_of_not_member_complement {T : Type(0)} (subject : T)
        (subset : Set(T))
        (notOutside : ¬(subject ∈ Set.complement(subset)))
        : subject ∈ subset := {
  suppose ¬(subject ∈ subset) for contradiction {
    subject ∈ Set.complement(subset);
    done
  };
  done
}

theorem Set.complement_complement_member {T : Type(0)} (subject : T)
        (subset : Set(T)) (inside : subject ∈ subset)
        : ¬(subject ∈ Set.complement(subset)) := {
  suppose subject ∈ Set.complement(subset) as outside;
  done
}

-- A difference is an intersection with a complement — the spelling the
-- topology layer uses when it wants `closure(U) \ U` to be closed under
-- the intersection laws above.
theorem Set.difference_member_intersection_complement {T : Type(0)}
        (larger smaller : Set(T))
        (subject : T) (inDifference : subject ∈ larger ∖ smaller)
        : subject ∈ larger ∩ Set.complement(smaller) :=
  inDifference

-- ----------------------------------------------------------------------
-- Extensionality: a set IS its membership predicate, so two sets with
-- the same members are equal. Function extensionality on the predicate,
-- propositional extensionality at each point.

theorem Set.equal_of_same_members {T : Type(0)} (left right : Set(T))
        (forward : left ⊆ right) (backward : right ⊆ left)
        : left = right := {
  ∀ (subject : T). (subject ∈ left) = (subject ∈ right)
      by (subject : T) ↦ {
        subject ∈ left → subject ∈ right by forward;
        subject ∈ right → subject ∈ left by backward;
        done by Equality.propositional_extensionality
      };
  done by Function.extensionality
}

-- A subset meets its superset in itself, which is what lets a statement
-- about the trace `left ∩ right` be read as one about `left`.
theorem Set.intersection_of_subset {T : Type(0)} (left right : Set(T))
        (inside : left ⊆ right)
        : left ∩ right = left := {
  left ∩ right ⊆ left by Set.intersection_subset_left;
  left ⊆ left ∩ right
      by (subject : T) (inLeft : subject ∈ left) ↦ {
        subject ∈ right by inside;
        done
      };
  done by Set.equal_of_same_members
}

-- Union does not care which side a point came from.
theorem Set.union_commutative {T : Type(0)} (left right : Set(T))
        : left ∪ right = right ∪ left := {
  left ∪ right ⊆ right ∪ left
      by (subject : T) (inEither : subject ∈ left ∪ right) ↦ {
        subject ∈ left ∨ subject ∈ right;
        subject ∈ right ∨ subject ∈ left by Or.swap;
        done by Set.member_union
      };
  right ∪ left ⊆ left ∪ right
      by (subject : T) (inEither : subject ∈ right ∪ left) ↦ {
        subject ∈ right ∨ subject ∈ left;
        subject ∈ left ∨ subject ∈ right by Or.swap;
        done by Set.member_union
      };
  done by Set.equal_of_same_members
}

-- De Morgan: to miss a union is to miss both sides. This is what turns a
-- statement about a finite union being closed into one about an
-- intersection of open complements.
theorem Set.complement_union {T : Type(0)} (left right : Set(T))
        : Set.complement(left ∪ right)
              = Set.complement(left) ∩ Set.complement(right) := {
  Set.complement(left ∪ right) ⊆ Set.complement(left) ∩ Set.complement(right)
      by (subject : T) (outside : subject ∈ Set.complement(left ∪ right)) ↦ {
        ¬(subject ∈ left ∪ right);
        subject ∈ Set.complement(left)
            by { suppose subject ∈ left as inLeft;
                 subject ∈ left ∨ subject ∈ right;
                 done };
        subject ∈ Set.complement(right)
            by { suppose subject ∈ right as inRight;
                 subject ∈ left ∨ subject ∈ right;
                 done };
        done
      };
  Set.complement(left) ∩ Set.complement(right) ⊆ Set.complement(left ∪ right)
      by (subject : T) (outsideBoth : subject ∈ Set.complement(left) ∩ Set.complement(right)) ↦ {
        ¬(subject ∈ left);
        ¬(subject ∈ right);
        suppose subject ∈ left ∪ right as inEither;
        subject ∈ left ∨ subject ∈ right;
        done by cases {
          case subject ∈ left: done
          case subject ∈ right: done
        }
      };
  done by Set.equal_of_same_members
}

theorem Set.intersection_commutative {T : Type(0)} (left right : Set(T))
        : left ∩ right = right ∩ left := {
  left ∩ right ⊆ right ∩ left
      by (subject : T) (inBoth : subject ∈ left ∩ right) ↦ {
        subject ∈ left;
        subject ∈ right;
        done
      };
  right ∩ left ⊆ left ∩ right
      by (subject : T) (inBoth : subject ∈ right ∩ left) ↦ {
        subject ∈ right;
        subject ∈ left;
        done
      };
  done by Set.equal_of_same_members
}

-- Membership transports along an equation of sets. A one-liner, but
-- worth a name: `by substituting` does the same job in general and
-- crashes when the equation's left side is a defined set applied to
-- arguments (see reports/CRASH_substituting_defined_set.math), whereas
-- this lemma proves the rewrite once over opaque sets and is then a
-- plain application at every use site.
theorem Set.member_of_equal {T : Type(0)} (source target : Set(T))
        (same : source = target)
        (subject : T) (inSource : subject ∈ source)
        : subject ∈ target := {
  subject ∈ target by substituting same;
  done
}

-- ----------------------------------------------------------------------
-- Images. No structure is involved — this is the set of values a function
-- takes on a subset, and it is what a metric or topological image
-- theorem is stated about.

definition Set.image {A B : Type(0)} (f : A → B) (subset : Set(A))
        : Set(B) :=
  (y : B) ↦ ∃ (x : A). x ∈ subset ∧ f(x) = y

-- Taking images commutes with union: a point of the image of a union came
-- from one side or the other.
theorem Set.image_union {A B : Type(0)} (f : A → B)
        (left right : Set(A))
        : Set.image(f, left ∪ right)
              = Set.image(f, left) ∪ Set.image(f, right) := {
  Set.image(f, left ∪ right) ⊆ Set.image(f, left) ∪ Set.image(f, right)
      by (y : B) (onImage : y ∈ Set.image(f, left ∪ right)) ↦ {
        choose origin such that origin ∈ left ∪ right ∧ f(origin) = y;
        origin ∈ left ∪ right;
        f(origin) = y;
        done by cases {
          case origin ∈ left as fromLeft: {
              y ∈ Set.image(f, left) by { witness origin };
              done
            }
          case origin ∈ right as fromRight: {
              y ∈ Set.image(f, right) by { witness origin };
              done
            }
        }
      };
  Set.image(f, left) ∪ Set.image(f, right) ⊆ Set.image(f, left ∪ right)
      by (y : B)
         (onEither : y ∈ Set.image(f, left) ∪ Set.image(f, right)) ↦ {
        done by cases {
          case y ∈ Set.image(f, left) as onLeft: {
              choose origin such that origin ∈ left ∧ f(origin) = y from onLeft;
              origin ∈ left;
              f(origin) = y;
              origin ∈ left ∪ right;
              done by { witness origin }
            }
          case y ∈ Set.image(f, right) as onRight: {
              choose origin such that origin ∈ right ∧ f(origin) = y from onRight;
              origin ∈ right;
              f(origin) = y;
              origin ∈ left ∪ right;
              done by { witness origin }
            }
        }
      };
  done by Set.equal_of_same_members
}
