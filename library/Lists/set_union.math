-- Lists/set_union.math
--
-- `List.unionOver(pieces, list)` — the union of a family of sets over the
-- members of a list. The finite union, with the finiteness carried by a
-- list rather than by an indexing predicate, which is what the plane
-- development wants: the point set of a plane graph is the union of its
-- edge arcs over the graph's own edge list.
--
-- Written as a recursion rather than as the comprehension
-- `∃ item ∈ list. x ∈ pieces(item)`, because every theorem about a finite
-- union is proved by induction on the list and the recursion is what makes
-- each step a two-set statement. The comprehension reading is recovered by
-- `List.unionOver_member` / `.member_invert`.

module Lists.set_union

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Lists.list
import Lists.append

definition List.unionOver {A T : Type(0)} (pieces : A → Set(T))
        : List(A) → Set(T)
  | List.empty               => Set.empty(T)
  | List.prepend(head, tail) => pieces(head) ∪ List.unionOver(pieces, tail)

-- ── The two characterizing equations ──────────────────────────────────

theorem List.unionOver_empty (A T : Type(0)) (pieces : A → Set(T))
        : List.unionOver(pieces, List.empty(A)) = Set.empty(T) :=
  done

theorem List.unionOver_prepend (A T : Type(0)) (pieces : A → Set(T))
        (head : A) (tail : List(A))
        : List.unionOver(pieces, List.prepend(A, head, tail))
          = pieces(head) ∪ List.unionOver(pieces, tail) :=
  done

-- ── The comprehension reading ─────────────────────────────────────────

-- A member of one piece is a member of the union.
theorem List.unionOver_member (A T : Type(0)) (pieces : A → Set(T))
        (list : List(A)) (item : A) (isMember : item ∈ list)
        (x : T) (inPiece : x ∈ pieces(item))
        : x ∈ List.unionOver(pieces, list) :=
  by induction on list with IH {
    case list = List.empty:
        done
    case list = List.prepend(head, tail) for some head, tail:
        done by cases {
          case item = head: {
              x ∈ pieces(head);
              done
            }
          otherwise: {
              item ∈ tail;
              x ∈ List.unionOver(pieces, tail) by IH;
              done
            }
        }
  }

-- And conversely: a member of the union came from one of the pieces.
theorem List.unionOver_member_invert (A T : Type(0)) (pieces : A → Set(T))
        (list : List(A)) (x : T) (inUnion : x ∈ List.unionOver(pieces, list))
        : ∃ (item : A). item ∈ list ∧ x ∈ pieces(item) :=
  by induction on list with IH {
    case list = List.empty:
        done
    case list = List.prepend(head, tail) for some head, tail:
        done by cases {
          case x ∈ pieces(head): {
              head ∈ List.prepend(A, head, tail);
              witness head
            }
          case x ∈ List.unionOver(pieces, tail): {
              choose item such that item ∈ tail ∧ x ∈ pieces(item) from IH;
              item ∈ tail;
              item ∈ List.prepend(A, head, tail);
              x ∈ pieces(item);
              witness item
            }
        }
  }

-- ── Monotonicity ──────────────────────────────────────────────────────

-- Enlarging the pieces enlarges the union.
theorem List.unionOver_subset (A T : Type(0)) (pieces : A → Set(T))
        (list : List(A)) (larger : Set(T))
        (piecesInside : ∀ (item : A). item ∈ list → pieces(item) ⊆ larger)
        : List.unionOver(pieces, list) ⊆ larger := {
  take x : T;
  suppose x ∈ List.unionOver(pieces, list);
  choose item such that item ∈ list ∧ x ∈ pieces(item)
      from List.unionOver_member_invert;
  item ∈ list;
  pieces(item) ⊆ larger by piecesInside;
  x ∈ pieces(item);
  done
}

-- A union over a concatenation splits where the list does — the shape every
-- induction over `List.append` needs.
theorem List.unionOver_append (A T : Type(0)) (pieces : A → Set(T))
        (first second : List(A))
        : List.unionOver(pieces, List.append(first, second))
          = List.unionOver(pieces, first) ∪ List.unionOver(pieces, second) :=
  by induction on first with IH {
    case first = List.empty:
        List.unionOver(pieces, List.append(List.empty(A), second))
           = List.unionOver(pieces, second)
           = Set.empty(T) ∪ List.unionOver(pieces, second)
                 by Set.union_empty(subset := List.unionOver(pieces, second))
    case first = List.prepend(head, tail) for some head, tail:
        List.unionOver(pieces, List.append(List.prepend(A, head, tail), second))
           = List.unionOver(pieces, List.prepend(A, head, List.append(tail, second)))
           = pieces(head) ∪ List.unionOver(pieces, List.append(tail, second))
           = pieces(head) ∪ (List.unionOver(pieces, tail)
                                 ∪ List.unionOver(pieces, second)) by IH
           = (pieces(head) ∪ List.unionOver(pieces, tail))
                 ∪ List.unionOver(pieces, second) by Set.union_associative
  }

-- ── Only the members matter ────────────────────────────────────────────

-- Two lists with the same members have the same union. Deduplicating a list,
-- or reordering it, therefore leaves the union alone — which is what a
-- construction needs when it has to hand a finite union a tidier list than
-- the one it started with.
theorem List.unionOver_same_members (A T : Type(0)) (pieces : A → Set(T))
        (first second : List(A))
        (firstInSecond : first ⊆ second) (secondInFirst : second ⊆ first)
        : List.unionOver(pieces, first) = List.unionOver(pieces, second) := {
  List.unionOver(pieces, first) ⊆ List.unionOver(pieces, second)
      by { ∀ (item : A). item ∈ first → pieces(item) ⊆ List.unionOver(pieces, second)
               by { take item : A;
                    suppose item ∈ first;
                    item ∈ second by firstInSecond;
                    take x : T;
                    suppose x ∈ pieces(item);
                    done by List.unionOver_member };
           done by List.unionOver_subset };
  List.unionOver(pieces, second) ⊆ List.unionOver(pieces, first)
      by { ∀ (item : A). item ∈ second → pieces(item) ⊆ List.unionOver(pieces, first)
               by { take item : A;
                    suppose item ∈ second;
                    item ∈ first by secondInFirst;
                    take x : T;
                    suppose x ∈ pieces(item);
                    done by List.unionOver_member };
           done by List.unionOver_subset };
  done by Set.equal_of_same_members
}
