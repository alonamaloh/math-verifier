-- `for y sufficiently near x: { … }` — the filter scope, read at the
-- SPATIAL filter. Same construct as `for m sufficiently large: { … }`,
-- same elaborator path: the scope collects every in-scope fact for the
-- SAME filter at the SAME point, combines them (`Near.and`, which takes
-- the minimum of the radii), and hands the body each one at the bound
-- point. No radius, and no minimum, appears on the page.
--
-- The elaborator names no filter: it reads the filter's leading arguments
-- (here the space and the point) off the GOAL and cites
-- `<filter>.of_always` / `.and` / `.monotone`. Registering a new filter is
-- a phrase in the parser plus those three lemmas.

module Test.near_scope_test

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.minimum
import Metric.space
import Metric.topology
import Metric.continuity
import Metric.near

-- The exact analogue of Test.eventually_scope: two near-facts combine.
theorem Test.near_scope {m : MetricSpace} (x : m) (P Q : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (nearQ : MetricSpace.Near(x, Q))
        : MetricSpace.Near(x, (y : m) ↦ P(y) ∧ Q(y)) :=
  for y sufficiently near x: {
    P(y);
    Q(y);
    done
  }

-- With no near-hypotheses in scope: plain introduction at any radius.
theorem Test.near_scope_always {m : MetricSpace} (x : m) (P : m → Proposition)
        (always : ∀ (z : m). P(z))
        : MetricSpace.Near(x, P) :=
  for y sufficiently near x: {
    done by always
  }

-- Derivation in the body, mixing the two facts.
theorem Test.near_scope_derives {m : MetricSpace} (x : m) (P Q R : m → Proposition)
        (nearP : MetricSpace.Near(x, P))
        (nearQ : MetricSpace.Near(x, Q))
        (combine : ∀ (z : m). P(z) → Q(z) → R(z))
        : MetricSpace.Near(x, R) :=
  for y sufficiently near x: {
    P(y);
    Q(y);
    done by combine
  }

-- ----------------------------------------------------------------------
-- `within <region>` selects the RELATIVE filter. The region, like the
-- point, is read off the goal — the words are the reader's, and the
-- elaborator still names no filter beyond the phrase.

theorem Test.near_within_scope {m : MetricSpace} (x : m)
        (region : Set(m)) (P Q : m → Proposition)
        (nearP : MetricSpace.NearWithin(x, region, P))
        (nearQ : MetricSpace.NearWithin(x, region, Q))
        : MetricSpace.NearWithin(x, region, (y : m) ↦ P(y) ∧ Q(y)) :=
  for y sufficiently near x within region: {
    P(y);
    Q(y);
    done
  }

theorem Test.near_within_scope_always {m : MetricSpace} (x : m)
        (region : Set(m)) (P : m → Proposition)
        (always : ∀ (z : m). P(z))
        : MetricSpace.NearWithin(x, region, P) :=
  for y sufficiently near x within region: {
    done by always
  }

-- A fact for a DIFFERENT region is not folded in: the scope matches the
-- filter's leading arguments, so `other` contributes nothing here and the
-- proof still goes through on `nearP` alone.
theorem Test.near_within_scope_ignores_other_region {m : MetricSpace} (x : m)
        (region other : Set(m)) (P Q R : m → Proposition)
        (nearP : MetricSpace.NearWithin(x, region, P))
        (nearQ : MetricSpace.NearWithin(x, other, Q))
        (weaken : ∀ (z : m). P(z) → R(z))
        : MetricSpace.NearWithin(x, region, R) :=
  for y sufficiently near x within region: {
    P(y);
    done by weaken
  }

-- The region membership is available as its own near-fact, which is what
-- lets a body split on where in the region the point lies.
theorem Test.near_within_scope_sees_the_region {m : MetricSpace} (x : m)
        (left right : Set(m)) (P : m → Proposition)
        (nearLeft : MetricSpace.NearWithin(x, left ∪ right,
            (y : m) ↦ y ∈ left → P(y)))
        (nearRight : MetricSpace.NearWithin(x, left ∪ right,
            (y : m) ↦ y ∈ right → P(y)))
        : MetricSpace.NearWithin(x, left ∪ right, P) := {
  MetricSpace.NearWithin(x, left ∪ right, (y : m) ↦ y ∈ left ∪ right)
      by MetricSpace.NearWithin.in_region;
  for y sufficiently near x within left ∪ right: {
    done by cases {
      case y ∈ left: done
      case y ∈ right: done
    }
  }
}
