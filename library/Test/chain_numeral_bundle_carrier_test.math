-- Test/chain_numeral_bundle_carrier_test.math
--
-- A relation chain whose carrier is a concrete bundle's carrier
-- (`CommutativeRing.carrier(Integer.commutative_ring_bundle)`, the type of
-- every `Matrix.quadraticForm` value) lifts a bare-numeral endpoint up the
-- coercion tower, exactly as a chain at plain `Integer` does.  Before the
-- carrier-spelling-aware join the numerals stayed at Natural, so the step
-- was ill-typed and the citation failed with "a different relation than the
-- step claims" — printing two spellings that looked identical.

module Test.chain_numeral_bundle_carrier_test

import Algebra.diagonal_forms

theorem Test.chain_numerals_at_a_bundle_carrier
        : Matrix.quadraticForm(
              Matrix.squarePlusDoublePlusScaledSquareForm(5),
              (⟨0, 0, 0⟩ : RingVector(Integer.commutative_ring_bundle, 3)))
          = 0 := {
  Matrix.quadraticForm(
      Matrix.squarePlusDoublePlusScaledSquareForm(5),
      (⟨0, 0, 0⟩ : RingVector(Integer.commutative_ring_bundle, 3)))
     = 0 * 0 + 2 * (0 * 0) + 5 * (0 * 0)
         by Matrix.squarePlusDoublePlusScaledSquareForm_coordinateTuple_value
     = 0 by ring;
  done
}
