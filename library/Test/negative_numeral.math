-- Test/negative_numeral.math
--
-- Lock for `-1` landing in Integer.
--
-- Negation's home is the signed type, and the ℕ→ℤ→ℚ→ℝ coercions carry it
-- on to whatever the position wants. The case that used to fail is the
-- third: numeral-only arithmetic elaborates bottom-up as Natural, so the
-- ℝ expected type never reaches the `-1` leaf, and unary minus on a
-- Natural had nowhere to go.

module Test.negative_numeral

import Logic.basics
import Equality.basics
import Integer.basics
import Real.interface
import Real.order
import Plane.point
import Plane.segment
import Plane.model

theorem Test.negative_numeral_is_integer : (-1 : ℤ) = -1 := done

theorem Test.negative_numeral_coordinate
        : Plane.Point.first(Plane.Point.make(-1, 1)) = -(1 : ℝ) :=
  done

theorem Test.negative_numeral_in_arithmetic
        : Plane.between(Plane.origin, Plane.origin, 2 * 1 + -1)
              = Plane.between(Plane.origin, Plane.origin, 1) :=
  done
