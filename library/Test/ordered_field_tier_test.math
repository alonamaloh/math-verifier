-- Test/ordered_field_tier_test.math
--
-- The `ordered_field` tactic runs unprompted, as the last tier of the
-- auto-prover's battery. Each claim below was a friction-log entry that
-- needed an explicit citation; each now closes with a bare `done`.
--
-- The tier is placed last precisely so a library that verifies never
-- reaches it: it is the error path that changed, not the success path.

module Test.ordered_field_tier_test

import Logic.basics
import Equality.basics
import Real.interface
import Real.order
import Real.order_field
import Real.embedding_order

-- I1: the sign battery could not see zero on the right.
theorem Test.zero_on_the_right (b c : ℝ) (ordered : b ≤ c)
        : 2 * (b - c) ≤ 0 := done

-- I4: a pure linear consequence of two bounds.
theorem Test.linear_consequence (a b c : ℝ)
        (aBelow : a ≤ c) (bBelow : b ≤ c)
        : a - b ≤ (c - a) + (c - b) := done

-- I9: a strict comparison of two numerals.
theorem Test.strict_numerals : Real.LessThan(2, 4) := done

-- The reductio idiom: contradictory hypotheses, `False` goal.
theorem Test.contradictory_bounds (a b : ℝ)
        (below : a < b) (above : b < a) : False := done
