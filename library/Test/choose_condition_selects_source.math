-- The stated condition of a `choose` is its SEARCH KEY, not prose: the
-- scope scan takes the most recent fact whose destructure binds exactly
-- that condition. So a nearer existential about something else no longer
-- captures the witness, and a condition reached through a conjunction (or
-- through several ∃ layers at once) still has to be the one bound.

module Test.choose_condition_selects_source

import axioms
import Logic.basics
import Logic.exists
import Lists.list

-- The nearer fact is about `B`; the condition names `P`, so the scan
-- reaches past it. Before the condition was checked, `witnessValue` came
-- back at type `B` and the mistake surfaced only further down the proof.
theorem Test.chooseReachesPastNearerExistential (A B : Type(0))
        (P : A → Proposition) (Q : B → Proposition)
        (intended : ∃ (a : A). P(a))
        (nearer : ∃ (b : B). Q(b))
        : ∃ (a : A). P(a) := {
  choose witnessValue such that P(witnessValue) as holds;
  witness witnessValue with holds
}

-- Two witness names in one step, through a conjunction: the left leg lands
-- as an anonymous fact and the walk continues into the right leg, so the
-- condition to state is the innermost one.
theorem Test.chooseThroughConjunctionToNestedExistential (A : Type(0))
        (R : A → A → Proposition)
        (fact : True ∧ ∃ (x : A). ∃ (y : A). R(x, y))
        : ∃ (x : A). ∃ (y : A). R(x, y) := {
  choose first, second such that R(first, second) as related from fact;
  witness first with witness second with related
}

-- Stating only some of the conjuncts the source binds is honest but
-- incomplete: it WARNS (naming the rest) and goes through, where a condition
-- that is not among them is refused outright. Asserted by the Makefile's
-- `partial-choose-condition-check`, which is why this theorem is here.
theorem Test.choosePartialCondition (A : Type(0)) (P Q : A → Proposition)
        (fact : ∃ (a : A). P(a) ∧ Q(a))
        : ∃ (a : A). P(a) := {
  choose value such that P(value) from fact;
  witness value
}

-- The source is a hypothesis with a premise to discharge — an induction
-- hypothesis generalised over one — and its witness type is APPLIED
-- (`List(A)`) rather than a bare name. No `: List(A)` annotation is needed.
theorem Test.chooseAppliedWitnessTypeThroughPremise (A : Type(0))
        (Q : Proposition) (P : List(A) → Proposition)
        (premiseHolds : Q)
        (fact : Q → ∃ (edgeList : List(A)). P(edgeList))
        : ∃ (edgeList : List(A)). P(edgeList) := {
  choose edgeList such that P(edgeList) as satisfies from fact;
  witness edgeList with satisfies
}

-- What the `such that` is FOR: the source's premise is matched by two
-- hypotheses that pin different arguments, and the stated condition says
-- which is meant. It can only do that if the existential it shapes reaches
-- the citation, so the witness type — applied, and stated over the source's
-- own parameter — has to read.
theorem Test.chooseConditionSettlesPremiseAmbiguity (A : Type(0))
        (Member : A → Proposition) (P : A → List(A) → Proposition)
        (first second : A)
        (firstIsMember : Member(first))
        (secondIsMember : Member(second))
        (fact : ∀ (a : A). Member(a) → ∃ (values : List(A)). P(a, values))
        : ∃ (values : List(A)). P(second, values) := {
  choose values such that P(second, values) as satisfies from fact;
  witness values with satisfies
}

-- The same, where the witness type is the source's own AMBIENT parameter.
-- Both sides carry it by `convention`, so the type the lemma states its
-- existential over is a name the caller has in scope — which is what lets
-- the condition be shaped into an existential here too.
convention Ambient : Type(0)

theorem Test.ambientPartner (element : Ambient) (P : Ambient → Ambient → Proposition)
        (holds : P(element, element))
        : ∃ (partner : Ambient). P(element, partner) := { witness element }

theorem Test.chooseAmbientWitnessType (element other : Ambient)
        (P : Ambient → Ambient → Proposition)
        (atElement : P(element, element))
        (atOther : P(other, other))
        : ∃ (partner : Ambient). P(other, partner) := {
  choose partner such that P(other, partner) as satisfies
      from Test.ambientPartner;
  witness partner with satisfies
}
