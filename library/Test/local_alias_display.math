-- A `let` is transparent to the elaborator on purpose, so a goal or an error
-- would print the expansion the abbreviation exists to avoid. The printer
-- folds each live local alias back to its name.
--
-- Checked by the `local-alias-display-check` target, which reads the goal
-- report: `sameSum` must print as `doubled = doubled`, and the expansion
-- `n + n` must not appear in it. The `sorry` is the query anchor.

module Test.local_alias_display

import axioms
import Logic.basics
import Equality.basics
import Natural.basics

theorem Test.local_alias_display (n : ℕ) : True := {
  let doubled : ℕ := n + n;
  -- stated with the EXPANSION: what the reader sees back must be the name
  (n + n) = (n + n) as sameSum;
  sorry
}
