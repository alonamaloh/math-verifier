module Test.ordered_field_test

import Logic.basics
import Equality.basics
import Real.basics
import Real.order
import Real.order_field

-- The canonical I4 shape: the rearrangement IS the content, so no
-- syntactic sum-of-two-bounds lemma reaches it.
theorem canonical_i4 (a b c : ℝ) (aBelow : a ≤ c) (bBelow : b ≤ c)
        : a - b ≤ (c - a) + (c - b) := ordered_field

-- The same, as a `by` hint on a stated proposition.
theorem canonical_i4_as_hint (a b c : ℝ) (aBelow : a ≤ c) (bBelow : b ≤ c)
        : a - b ≤ (c - a) + (c - b) := {
  a - b ≤ (c - a) + (c - b) by ordered_field;
  done
}

-- A single nonnegative increment.
theorem add_nonneg_increment (x y : ℝ) (yNonneg : 0 ≤ y) : x ≤ x + y :=
  ordered_field

-- Slack: the goal is weaker than the hypothesis by a constant.
theorem constant_slack (x : ℝ) (xSmall : x ≤ 3) : x ≤ 5 := ordered_field

-- Strictness comes from a strict hypothesis.
theorem strict_from_strict (a b c : ℝ) (aBelow : a < c) (bBelow : b ≤ c)
        : a + b < c + c := ordered_field

-- Two bounds added, with a coefficient of 2 on one of them.
theorem doubled_coefficient (a c : ℝ) (aBelow : a ≤ c) : 2 * a ≤ 2 * c :=
  ordered_field

-- Products are ordinary variables of the linear model.
theorem product_as_atom (x y : ℝ) (squareNonneg : 0 ≤ y * y)
        : x * x ≤ x * x + y * y := ordered_field

-- An equation hypothesis contributes bounds in both directions, so a
-- proof may mix equations with inequalities without converting by hand.
theorem equation_as_two_bounds (x y z : ℝ) (xIsY : x = y) (yBelowZ : y ≤ z)
        : x ≤ z := ordered_field

-- … and the equation can be the thing that supplies the slack.
theorem equation_supplies_the_gap (a b : ℝ) (gap : a = b + 1) : b ≤ a :=
  ordered_field

-- Contradictory hypotheses close a `False` goal, so the tactic reaches
-- the reductio idiom.
theorem contradiction_from_bounds (a b : ℝ) (aBelow : a ≤ b) (bBelow : b < a)
        : False := ordered_field

-- A `let`-bound abbreviation is ζ-unfolded before the linear model is
-- built, so a bound stated against the abbreviation is seen as the bound
-- against its body. Left folded, `roof` would be an atom unrelated to
-- `abs(x)` and the goal would be declined.
theorem let_bound_abbreviation (x : ℝ) : abs(x) ≤ 1 + abs(x) := {
  let roof : ℝ := 1 + abs(x);
  abs(x) ≥ 0;
  abs(x) ≤ roof by ordered_field;
  done
}
