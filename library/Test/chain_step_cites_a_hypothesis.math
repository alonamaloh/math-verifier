-- A relation-chain step citing a ∀-hypothesis, argument-free.
--
-- The cited fact needs instantiating at `m` and its premise discharging
-- from context. A stated fact's `by` and a `choose … from` have always
-- done that; a chain step used to leave the citation unapplied and report
-- "this step's justification is a lemma that was never instantiated", so
-- the same fact cited the same way read bare in one position and had to be
-- spelled `close(m, beyond)` in another. All three now share one path.
module Test.chain_step_cites_a_hypothesis

import Logic.basics
import Equality.basics
import Natural.basics
import Natural.order
import Real.interface
import Real.order
import Real.absolute_value

theorem Test.chain_step_cites_a_hypothesis
        (u : ℕ → ℝ) (limit bound : ℝ) (threshold m : ℕ)
        (close : ∀ (k : ℕ). threshold ≤ k → abs(u(k) - limit) < bound)
        (beyond : threshold ≤ m)
        (shifted : abs(limit - u(m)) = abs(u(m) - limit))
        : abs(limit - u(m)) < bound :=
  abs(limit - u(m))
     = abs(u(m) - limit) by shifted
     < bound by close
