-- ----------------------------------------------------------------------
-- 15 is needed: diag(1,2,5,5) is the exceptional form of exact truant 15,
-- whose classification is the zero-border representative above x²+2y²+5z².

theorem Matrix.diagonalQuaternaryForm_one_two_five_five_isometric_representative
        : Matrix.IsIsometric(
            Matrix.diagonalQuaternaryForm(1, 2, 5, 5),
            Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5)) := {
  let block : Matrix(Integer.commutative_ring_bundle, 3, 3) :=
      Matrix.squarePlusDoublePlusScaledSquareForm(5);
  let zero : RingVector(Integer.commutative_ring_bundle, 3) := ⟨0, 0, 0⟩;
  block · zero
     = (⟨0, 2 * 0, 5 * 0⟩ : RingVector(Integer.commutative_ring_bundle, 3))
         by Matrix.squarePlusDoublePlusScaledSquareForm_apply_coordinateTuple
     = zero
  as actionReads;
  Matrix.quadraticForm(block, zero)
     = 0 * 0 + 2 * (0 * 0) + 5 * (0 * 0)
         by Matrix.squarePlusDoublePlusScaledSquareForm_coordinateTuple_value
     = 0 by ring
  as valueReads;
  Matrix.IsIsometric(
      Matrix.diagonalExtension(block, 5),
      Matrix.borderedAssembly(
          block, block · zero, 5 + Matrix.quadraticForm(block, zero)))
      by Matrix.diagonalExtension_isometric_borderedAssembly(
          symmetric := Matrix.squarePlusDoublePlusScaledSquareForm_symmetric);
  Matrix.diagonalQuaternaryForm(1, 2, 5, 5)
     = Matrix.diagonalExtension(Matrix.diagonalTernaryForm(1, 2, 5), 5)
     = Matrix.diagonalExtension(block, 5)
         by substituting Matrix.squarePlusDoublePlusScaledSquareForm_is_diagonal
  as sourceReads;
  Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5)
     = Matrix.borderedAssembly(
           block, zero, 5 + Matrix.quadraticForm(block, zero))
         by substituting valueReads
     = Matrix.borderedAssembly(
           block, block · zero, 5 + Matrix.quadraticForm(block, zero))
         by substituting actionReads
  as targetReads;
  Matrix.IsIsometric(
      Matrix.diagonalQuaternaryForm(1, 2, 5, 5),
      Matrix.borderedAssembly(
          block, block · zero, 5 + Matrix.quadraticForm(block, zero)))
      by substituting sourceReads;
  done by substituting targetReads
}

theorem Matrix.critical_fifteen_witness_misses_fifteen
        : ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 2, 5, 5), 15)) := {
  suppose Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 2, 5, 5), 15) as represented;
  Matrix.IsIsometric(
      Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5),
      Matrix.diagonalQuaternaryForm(1, 2, 5, 5))
      by Matrix.IsIsometric.symmetric;
  Matrix.Represents(Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5), 15)
      by Matrix.isometric_represents;
  ¬(Matrix.Represents(
        Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5), 15))
      by Matrix.weightedD5S0R0C5_not_represents_fifteen;
  done
}

theorem Matrix.critical_fifteen_witness_represents_others
        : ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 15)
            → Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 2, 5, 5), (u : ℤ)) :=
  by Matrix.represents_critical_values_except(
      one := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 0, w := 0, value := done)),
      two := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 1, z := 0, w := 0, value := done)),
      three := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 0, w := 0, value := done)),
      five := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 1, w := 0, value := done)),
      six := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 1, z := 0, w := 0, value := done)),
      seven := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 1, z := 1, w := 0, value := done)),
      ten := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 1, w := 1, value := done)),
      fourteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 0, z := 1, w := 1, value := done)),
      fifteen := Or.introduceLeft(done))

-- ----------------------------------------------------------------------
-- The nine witnesses, packaged: a critical value is needed when some
-- symmetric positive-definite rank-four form represents all the others and
-- misses it.

definition Matrix.CriticalValueIsNeeded (v : ℕ) : Proposition :=
  ∃ (A : Matrix(Integer.commutative_ring_bundle, 4, 4)).
      Matrix.IsSymmetric(A)
      ∧ Matrix.IsPositiveDefinite(A)
      ∧ (∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = v) → Matrix.Represents(A, (u : ℤ)))
      ∧ ¬(Matrix.Represents(A, (v : ℤ)))

theorem Matrix.critical_one_is_needed : Matrix.CriticalValueIsNeeded(1) := {
  Matrix.IsSymmetric(Matrix.diagonalQuaternaryForm(2, 2, 3, 4))
      by Matrix.diagonalQuaternaryForm_symmetric;
  Matrix.IsPositiveDefinite(Matrix.diagonalQuaternaryForm(2, 2, 3, 4))
      by Matrix.diagonalQuaternaryForm_positive_definite(
          aPositive := done, bPositive := done, cPositive := done, dPositive := done);
  ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 1)
      → Matrix.Represents(Matrix.diagonalQuaternaryForm(2, 2, 3, 4), (u : ℤ))
      by Matrix.critical_one_witness_represents_others;
  ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(2, 2, 3, 4), 1))
      by Matrix.critical_one_witness_misses_one;
  witness Matrix.diagonalQuaternaryForm(2, 2, 3, 4) with done
}

theorem Matrix.critical_two_is_needed : Matrix.CriticalValueIsNeeded(2) := {
  Matrix.IsSymmetric(Matrix.diagonalQuaternaryForm(1, 3, 3, 5))
      by Matrix.diagonalQuaternaryForm_symmetric;
  Matrix.IsPositiveDefinite(Matrix.diagonalQuaternaryForm(1, 3, 3, 5))
      by Matrix.diagonalQuaternaryForm_positive_definite(
          aPositive := done, bPositive := done, cPositive := done, dPositive := done);
  ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 2)
      → Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 3, 3, 5), (u : ℤ))
      by Matrix.critical_two_witness_represents_others;
  ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 3, 3, 5), 2))
      by Matrix.critical_two_witness_misses_two;
  witness Matrix.diagonalQuaternaryForm(1, 3, 3, 5) with done
}

