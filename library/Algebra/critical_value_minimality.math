-- Algebra/critical_value_minimality.math
--
-- Weak minimality of the fifteen theorem's nine critical values: no eight of
-- them force universality.  For each critical value v there is a symmetric
-- positive-definite rank-four form that represents the other eight and misses
-- v — so v cannot be dropped from the hypotheses of
-- `Matrix.universal_of_critical_values`.
--
-- Eight of the nine witnesses are diagonal forms of the same shape: a form
-- that misses v, extended by a coefficient larger than v, which therefore
-- cannot help reach v.  The ninth, for v = 15, is diag(1,2,5,5) — the
-- exceptional rank-four form of exact truant 15, in its diagonal spelling.

module Algebra.critical_value_minimality

import Algebra.diagonal_forms
import Algebra.rank_four_exceptional_truants_chunk0_generated

-- The nine values the fifteen theorem tests.
definition Matrix.IsCriticalValue (v : ℕ) : Proposition :=
  v = 1 ∨ v = 2 ∨ v = 3 ∨ v = 5 ∨ v = 6 ∨ v = 7 ∨ v = 10 ∨ v = 14 ∨ v = 15

-- Representing every critical value except one, checked value by value.
theorem Matrix.represents_critical_values_except {n : ℕ}
        (A : Matrix(Integer.commutative_ring_bundle, n, n)) (v : ℕ)
        (one : v = 1 ∨ Matrix.Represents(A, 1))
        (two : v = 2 ∨ Matrix.Represents(A, 2))
        (three : v = 3 ∨ Matrix.Represents(A, 3))
        (five : v = 5 ∨ Matrix.Represents(A, 5))
        (six : v = 6 ∨ Matrix.Represents(A, 6))
        (seven : v = 7 ∨ Matrix.Represents(A, 7))
        (ten : v = 10 ∨ Matrix.Represents(A, 10))
        (fourteen : v = 14 ∨ Matrix.Represents(A, 14))
        (fifteen : v = 15 ∨ Matrix.Represents(A, 15))
        : ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = v)
            → Matrix.Represents(A, (u : ℤ)) := {
  take u : ℕ;
  suppose Matrix.IsCriticalValue(u) as critical;
  suppose ¬(u = v) as distinct;
  u = 1 ∨ u = 2 ∨ u = 3 ∨ u = 5 ∨ u = 6 ∨ u = 7 ∨ u = 10 ∨ u = 14 ∨ u = 15;
  done by cases {
    case u = 1: done by cases {
        case v = 1: {
            u = 1 = v;
            done
          }
        case Matrix.Represents(A, 1): done
      }
    case u = 2: done by cases {
        case v = 2: {
            u = 2 = v;
            done
          }
        case Matrix.Represents(A, 2): done
      }
    case u = 3: done by cases {
        case v = 3: {
            u = 3 = v;
            done
          }
        case Matrix.Represents(A, 3): done
      }
    case u = 5: done by cases {
        case v = 5: {
            u = 5 = v;
            done
          }
        case Matrix.Represents(A, 5): done
      }
    case u = 6: done by cases {
        case v = 6: {
            u = 6 = v;
            done
          }
        case Matrix.Represents(A, 6): done
      }
    case u = 7: done by cases {
        case v = 7: {
            u = 7 = v;
            done
          }
        case Matrix.Represents(A, 7): done
      }
    case u = 10: done by cases {
        case v = 10: {
            u = 10 = v;
            done
          }
        case Matrix.Represents(A, 10): done
      }
    case u = 14: done by cases {
        case v = 14: {
            u = 14 = v;
            done
          }
        case Matrix.Represents(A, 14): done
      }
    case u = 15: done by cases {
        case v = 15: {
            u = 15 = v;
            done
          }
        case Matrix.Represents(A, 15): done
      }
  }
}

-- ----------------------------------------------------------------------
-- What the low-rank diagonal forms miss, in the diagonal spelling.

theorem Matrix.diagonalUnaryForm_one_not_represents_two
        : ¬(Matrix.Represents(Matrix.diagonalUnaryForm(1), 2)) := {
  suppose Matrix.Represents(Matrix.diagonalUnaryForm(1), 2) as represented;
  Matrix.Represents(Matrix.squareForm, 2)
      by substituting Matrix.squareForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.squareForm, 2))
      by Matrix.IsTruant.missed(isTruant := Matrix.squareForm_truant_two);
  done
}

theorem Matrix.diagonalBinaryForm_one_one_not_represents_three
        : ¬(Matrix.Represents(Matrix.diagonalBinaryForm(1, 1), 3)) := {
  suppose Matrix.Represents(Matrix.diagonalBinaryForm(1, 1), 3) as represented;
  Matrix.Represents(Matrix.sumOfTwoSquaresForm, 3)
      by substituting Matrix.sumOfTwoSquaresForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.sumOfTwoSquaresForm, 3))
      by Matrix.sumOfTwoSquaresForm_not_represents_three;
  done
}

theorem Matrix.diagonalBinaryForm_one_two_not_represents_five
        : ¬(Matrix.Represents(Matrix.diagonalBinaryForm(1, 2), 5)) := {
  suppose Matrix.Represents(Matrix.diagonalBinaryForm(1, 2), 5) as represented;
  Matrix.Represents(Matrix.squarePlusDoubleSquareForm, 5)
      by substituting Matrix.squarePlusDoubleSquareForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.squarePlusDoubleSquareForm, 5))
      by Matrix.squarePlusDoubleSquareForm_not_represents_five;
  done
}

theorem Matrix.diagonalTernaryForm_one_one_three_not_represents_six
        : ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 3), 6)) := {
  suppose Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 3), 6) as represented;
  Matrix.Represents(Matrix.sumOfTwoSquaresPlusTripleSquareForm, 6)
      by substituting Matrix.sumOfTwoSquaresPlusTripleSquareForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.sumOfTwoSquaresPlusTripleSquareForm, 6))
      by Matrix.sumOfTwoSquaresPlusTripleSquareForm_not_represents_six;
  done
}

theorem Matrix.diagonalTernaryForm_one_one_one_not_represents_seven
        : ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 1), 7)) := {
  suppose Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 1), 7) as represented;
  Matrix.Represents(Matrix.sumOfThreeSquaresForm, 7)
      by substituting Matrix.sumOfThreeSquaresForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.sumOfThreeSquaresForm, 7))
      by Matrix.sumOfThreeSquaresForm_not_represents_seven;
  done
}

theorem Matrix.diagonalTernaryForm_one_two_three_not_represents_ten
        : ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 2, 3), 10)) := {
  suppose Matrix.Represents(Matrix.diagonalTernaryForm(1, 2, 3), 10) as represented;
  Matrix.Represents(Matrix.squarePlusDoubleSquarePlusTripleSquareForm, 10)
      by substituting Matrix.squarePlusDoubleSquarePlusTripleSquareForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.squarePlusDoubleSquarePlusTripleSquareForm, 10))
      by Matrix.squarePlusDoubleSquarePlusTripleSquareForm_not_represents_ten;
  done
}

theorem Matrix.diagonalTernaryForm_one_one_two_not_represents_fourteen
        : ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 2), 14)) := {
  suppose Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 2), 14) as represented;
  Matrix.Represents(Matrix.sumOfTwoSquaresPlusDoubleSquareForm, 14)
      by substituting Matrix.sumOfTwoSquaresPlusDoubleSquareForm_is_diagonal;
  ¬(Matrix.Represents(Matrix.sumOfTwoSquaresPlusDoubleSquareForm, 14))
      by Matrix.sumOfTwoSquaresPlusDoubleSquareForm_not_represents_fourteen;
  done
}

-- ----------------------------------------------------------------------
-- 1 is needed: every coefficient of 2x²+2y²+3z²+4w² exceeds 1.

theorem Matrix.critical_one_witness_misses_one
        : ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(2, 2, 3, 4), 1)) := {
  ¬(Matrix.Represents(Matrix.diagonalUnaryForm(2), 1))
      by Matrix.diagonalUnaryForm_not_represents_below_coefficient(
          targetPositive := done, coefficientExceeds := done) as unaryMisses;
  ¬(Matrix.Represents(Matrix.diagonalBinaryForm(2, 2), 1))
      by Matrix.diagonalBinaryForm_not_represents_below_coefficient(
          aPositive := done, targetNonneg := done, coefficientExceeds := done,
          blockMisses := unaryMisses) as binaryMisses;
  ¬(Matrix.Represents(Matrix.diagonalTernaryForm(2, 2, 3), 1))
      by Matrix.diagonalTernaryForm_not_represents_below_coefficient(
          aPositive := done, bPositive := done, targetNonneg := done, coefficientExceeds := done,
          blockMisses := binaryMisses) as ternaryMisses;
  done by Matrix.diagonalQuaternaryForm_not_represents_below_coefficient(
      aPositive := done, bPositive := done, cPositive := done,
      targetNonneg := done, coefficientExceeds := done, blockMisses := ternaryMisses)
}

theorem Matrix.critical_one_witness_represents_others
        : ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 1)
            → Matrix.Represents(Matrix.diagonalQuaternaryForm(2, 2, 3, 4), (u : ℤ)) :=
  by Matrix.represents_critical_values_except(
      one := Or.introduceLeft(done),
      two := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 0, w := 0, value := done)),
      three := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 1, w := 0, value := done)),
      five := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 1, w := 0, value := done)),
      six := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 0, w := 1, value := done)),
      seven := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 1, w := 1, value := done)),
      ten := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 2, z := 0, w := 0, value := done)),
      fourteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 2, z := 0, w := 1, value := done)),
      fifteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 0, z := 1, w := 1, value := done)))

-- ----------------------------------------------------------------------
-- 2 is needed: x² misses 2, and 3y²+3z²+5w² cannot reach it.

theorem Matrix.critical_two_witness_misses_two
        : ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 3, 3, 5), 2)) := {
  ¬(Matrix.Represents(Matrix.diagonalBinaryForm(1, 3), 2))
      by Matrix.diagonalBinaryForm_not_represents_below_coefficient(
          aPositive := done, targetNonneg := done, coefficientExceeds := done,
          blockMisses := Matrix.diagonalUnaryForm_one_not_represents_two) as binaryMisses;
  ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 3, 3), 2))
      by Matrix.diagonalTernaryForm_not_represents_below_coefficient(
          aPositive := done, bPositive := done, targetNonneg := done, coefficientExceeds := done,
          blockMisses := binaryMisses) as ternaryMisses;
  done by Matrix.diagonalQuaternaryForm_not_represents_below_coefficient(
      aPositive := done, bPositive := done, cPositive := done,
      targetNonneg := done, coefficientExceeds := done, blockMisses := ternaryMisses)
}

theorem Matrix.critical_two_witness_represents_others
        : ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = 2)
            → Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 3, 3, 5), (u : ℤ)) :=
  by Matrix.represents_critical_values_except(
      one := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 0, w := 0, value := done)),
      two := Or.introduceLeft(done),
      three := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 1, z := 0, w := 0, value := done)),
      five := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 0, z := 0, w := 1, value := done)),
      six := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 1, z := 1, w := 0, value := done)),
      seven := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 1, w := 0, value := done)),
      ten := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 2, y := 1, z := 1, w := 0, value := done)),
      fourteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 3, y := 0, z := 0, w := 1, value := done)),
      fifteen := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 0, y := 1, z := 2, w := 0, value := done)))

