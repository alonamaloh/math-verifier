-- ----------------------------------------------------------------------
-- Weak minimality: every one of the nine critical values is needed.

theorem Matrix.critical_values_minimal (v : ℕ) (critical : Matrix.IsCriticalValue(v))
        : Matrix.CriticalValueIsNeeded(v) := {
  v = 1 ∨ v = 2 ∨ v = 3 ∨ v = 5 ∨ v = 6 ∨ v = 7 ∨ v = 10 ∨ v = 14 ∨ v = 15;
  done by cases {
    case v = 1: {
        Matrix.CriticalValueIsNeeded(1) by Matrix.critical_one_is_needed;
        done
      }
    case v = 2: {
        Matrix.CriticalValueIsNeeded(2) by Matrix.critical_two_is_needed;
        done
      }
    case v = 3: {
        Matrix.CriticalValueIsNeeded(3) by Matrix.critical_three_is_needed;
        done
      }
    case v = 5: {
        Matrix.CriticalValueIsNeeded(5) by Matrix.critical_five_is_needed;
        done
      }
    case v = 6: {
        Matrix.CriticalValueIsNeeded(6) by Matrix.critical_six_is_needed;
        done
      }
    case v = 7: {
        Matrix.CriticalValueIsNeeded(7) by Matrix.critical_seven_is_needed;
        done
      }
    case v = 10: {
        Matrix.CriticalValueIsNeeded(10) by Matrix.critical_ten_is_needed;
        done
      }
    case v = 14: {
        Matrix.CriticalValueIsNeeded(14) by Matrix.critical_fourteen_is_needed;
        done
      }
    case v = 15: {
        Matrix.CriticalValueIsNeeded(15) by Matrix.critical_fifteen_is_needed;
        done
      }
  }
}

theorem Matrix.IsCriticalValue.positive (v : ℕ) (critical : Matrix.IsCriticalValue(v))
        : v ≥ 1 := {
  v = 1 ∨ v = 2 ∨ v = 3 ∨ v = 5 ∨ v = 6 ∨ v = 7 ∨ v = 10 ∨ v = 14 ∨ v = 15;
  done by cases {
    case v = 1: done
    case v = 2: done
    case v = 3: done
    case v = 5: done
    case v = 6: done
    case v = 7: done
    case v = 10: done
    case v = 14: done
    case v = 15: done
  }
}

-- Dropping any one of the nine hypotheses of the fifteen theorem breaks it:
-- the remaining eight critical values leave a symmetric positive-definite
-- form that is not universal.
theorem Matrix.critical_values_do_not_force_universality (v : ℕ)
        (critical : Matrix.IsCriticalValue(v))
        : ∃ (A : Matrix(Integer.commutative_ring_bundle, 4, 4)).
            Matrix.IsSymmetric(A)
            ∧ Matrix.IsPositiveDefinite(A)
            ∧ (∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = v) → Matrix.Represents(A, (u : ℤ)))
            ∧ ¬(Matrix.IsUniversal(A)) := {
  Matrix.CriticalValueIsNeeded(v) by Matrix.critical_values_minimal as needed;
  choose A : Matrix(Integer.commutative_ring_bundle, 4, 4) such that
      Matrix.IsSymmetric(A)
      ∧ Matrix.IsPositiveDefinite(A)
      ∧ (∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = v) → Matrix.Represents(A, (u : ℤ)))
      ∧ ¬(Matrix.Represents(A, (v : ℤ))) from needed;
  Matrix.IsSymmetric(A);
  Matrix.IsPositiveDefinite(A);
  ∀ (u : ℕ). Matrix.IsCriticalValue(u) → ¬(u = v) → Matrix.Represents(A, (u : ℤ));
  ¬(Matrix.Represents(A, (v : ℤ)));
  ¬(Matrix.IsUniversal(A)) by {
    suppose Matrix.IsUniversal(A) as universal;
    v ≥ 1 by Matrix.IsCriticalValue.positive;
    Matrix.Represents(A, (v : ℤ));
    done
  };
  witness A with done
}
