      two := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 0, w := 0, value := done)),
      three := Or.introduceLeft(done),
      five := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 0, z := 1, w := 0, value := done)),
      six := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 1, w := 0, value := done)),
      seven := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
          x := 1, y := 1, z := 0, w := 1, value := done)),
      ten := Or.introduceRight(Matrix.diagonalQuaternaryForm_represents(
