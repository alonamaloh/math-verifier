theorem Matrix.critical_three_witness_misses_three
        : ¬(Matrix.Represents(Matrix.diagonalQuaternaryForm(1, 1, 4, 5), 3)) := {
  ¬(Matrix.Represents(Matrix.diagonalTernaryForm(1, 1, 4), 3))
      by Matrix.diagonalTernaryForm_not_represents_below_coefficient(
          aPositive := done, bPositive := done, targetNonneg := done, coefficientExceeds := done,
          blockMisses := Matrix.diagonalBinaryForm_one_one_not_represents_three) as ternaryMisses;
  done by Matrix.diagonalQuaternaryForm_not_represents_below_coefficient(
      aPositive := done, bPositive := done, cPositive := done,
      targetNonneg := done, coefficientExceeds := done, blockMisses := ternaryMisses)
}

