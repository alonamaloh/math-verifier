-- Algebra/rank_four_exceptional_odd_c4_r2_c7.math
--
-- The exceptional rank-four form
--
--   Q(x,y,z,w) = x² + 2y² + 2yz + 4z² + 4yw + 7w²
--
-- represents every positive integer except its truant 10, so every one of
-- its escalations is universal.

module Algebra.rank_four_exceptional_odd_c4_r2_c7

import Algebra.rank_four_exceptional_odd_c4_r2_c7_cover

theorem Matrix.oddC4R2C7_escalation_universal
        (B : Matrix(Integer.commutative_ring_bundle, 1 + 4, 1 + 4))
        (escalation : Matrix.IsEscalation(
          Matrix.squarePlusDoubleSquareOddRankFourRepresentative(4, 2, 7), B))
        (converse : Matrix.OneTwoFiveConverse)
        : Matrix.IsUniversal(B) := {
  let A : Matrix(Integer.commutative_ring_bundle, 4, 4) :=
      Matrix.squarePlusDoubleSquareOddRankFourRepresentative(4, 2, 7);
  Matrix.truant(A) = 10 by Matrix.truant_equals(
      isTruant := Matrix.oddC4R2C7_truant_ten) as truantReads;
  Matrix.RepresentsEveryPositiveExcept(A, 10)
      by Matrix.oddC4R2C7_representsEveryPositiveExceptTen(converse);
  Matrix.RepresentsEveryPositiveExcept(A, Matrix.truant(A)) by substituting truantReads
      as representedExceptTruant;
  done by Matrix.escalation_universal_of_parent_representsEveryPositiveExceptTruant(
    A, B, escalation, representedExceptTruant)
}
