           = IntegerMod.residue(7, 5) * IntegerMod.residue(7, 5) by substituting xValue
           = IntegerMod.residue(7, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 3)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x = IntegerMod.residue(7, 0), impossible)
      }
              case x = IntegerMod.residue(7, 6) as xValue: {
        IntegerMod.residue(7, 0) ≠ IntegerMod.residue(7, 1)
            by IntegerMod.residue_distinct_below_modulus(7, 0, 1, done, done, done)
            as classesDistinct;
        IntegerMod.residue(7, 0)
           = x * x by Equality.symmetry(squareZero)
           = IntegerMod.residue(7, 6) * IntegerMod.residue(7, 6) by substituting xValue
           = IntegerMod.residue(7, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 5)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x = IntegerMod.residue(7, 0), impossible)
      }
            }
          }
        }
      }
    }
  }
}

theorem Natural.below_fourteen_values (r : ℕ) (rBelow : r < 14)
        : r = 0
          ∨ r = 1
          ∨ r = 2
          ∨ r = 3
          ∨ r = 4
          ∨ r = 5
          ∨ r = 6
          ∨ r = 7
          ∨ r = 8
          ∨ r = 9
          ∨ r = 10
          ∨ r = 11
          ∨ r = 12
          ∨ r = 13 := {
  r = 0 ∨ ∃ (predecessor : ℕ). r = 1 + predecessor by Natural.zero_or_one_plus;
  done by cases {
    case r = 0 as rValue: done by Or.introduceLeft(rValue)
    case ∃ (predecessor : ℕ). r = 1 + predecessor: {
      choose predecessor : ℕ such that r = 1 + predecessor;
      1 ≤ r by substituting (r = 1 + predecessor) as rPositive;
      r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13
          by Natural.positive_below_fourteen(positive := rPositive, bound := rBelow);
      done by cases {
        case r = 1 as rValue: done by Or.introduceRight(Or.introduceLeft(rValue))
        case r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
          case r = 2 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))
          case r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
            case r = 3 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))
            case r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
              case r = 4 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))
              case r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                case r = 5 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))
                case r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                  case r = 6 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))
                  case r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                    case r = 7 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))
                    case r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                      case r = 8 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))
                      case r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                        case r = 9 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))
                        case r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                          case r = 10 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))
                          case r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                            case r = 11 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))))
                            case r = 12 ∨ r = 13: done by cases {
                              case r = 12 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))))
                              case r = 13 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(rValue)))))))))))))
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

theorem Natural.below_fifteen_values (r : ℕ) (rBelow : r < 15)
        : r = 0
          ∨ r = 1
          ∨ r = 2
          ∨ r = 3
          ∨ r = 4
          ∨ r = 5
          ∨ r = 6
          ∨ r = 7
          ∨ r = 8
          ∨ r = 9
          ∨ r = 10
          ∨ r = 11
          ∨ r = 12
          ∨ r = 13
          ∨ r = 14 := {
  r < 14 ∨ r = 14 by Natural.below_successor_or_equal;
  done by cases {
    case r < 14 as lowerBound: {
      r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13
          by Natural.below_fourteen_values;
      done by cases {
        case r = 0 as rValue: done by Or.introduceLeft(rValue)
        case r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
          case r = 1 as rValue: done by Or.introduceRight(Or.introduceLeft(rValue))
          case r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
            case r = 2 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))
            case r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
              case r = 3 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))
              case r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                case r = 4 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))
                case r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                  case r = 5 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))
                  case r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                    case r = 6 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))
                    case r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                      case r = 7 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))
                      case r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                        case r = 8 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))
                        case r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                          case r = 9 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))
                          case r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                            case r = 10 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))
                            case r = 11 ∨ r = 12 ∨ r = 13: done by cases {
                              case r = 11 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))))
                              case r = 12 ∨ r = 13: done by cases {
                                case r = 12 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))))
                                case r = 13 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))))))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    case r = 14 as topValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(topValue))))))))))))))
  }
}

theorem Natural.below_sixteen_values (r : ℕ) (rBelow : r < 16)
        : r = 0
          ∨ r = 1
          ∨ r = 2
          ∨ r = 3
          ∨ r = 4
          ∨ r = 5
          ∨ r = 6
          ∨ r = 7
          ∨ r = 8
          ∨ r = 9
          ∨ r = 10
          ∨ r = 11
          ∨ r = 12
          ∨ r = 13
          ∨ r = 14
          ∨ r = 15 := {
  r < 15 ∨ r = 15 by Natural.below_successor_or_equal;
  done by cases {
    case r < 15 as lowerBound: {
      r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14
          by Natural.below_fifteen_values;
      done by cases {
        case r = 0 as rValue: done by Or.introduceLeft(rValue)
        case r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
          case r = 1 as rValue: done by Or.introduceRight(Or.introduceLeft(rValue))
          case r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
            case r = 2 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))
            case r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
              case r = 3 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))
              case r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                case r = 4 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))
                case r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                  case r = 5 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))
                  case r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                    case r = 6 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))
                    case r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                      case r = 7 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))
                      case r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                        case r = 8 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))
                        case r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                          case r = 9 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))
                          case r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                            case r = 10 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))
                            case r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                              case r = 11 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))))
                              case r = 12 ∨ r = 13 ∨ r = 14: done by cases {
                                case r = 12 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))))
                                case r = 13 ∨ r = 14: done by cases {
                                  case r = 13 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue))))))))))))))
                                  case r = 14 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft(rValue)))))))))))))))
