  }
}

theorem IntegerMod.mod_sixteen_cases (x : IntegerMod(16))
        : x = IntegerMod.residue(16, 0)
          ∨ x = IntegerMod.residue(16, 1)
          ∨ x = IntegerMod.residue(16, 2)
          ∨ x = IntegerMod.residue(16, 3)
          ∨ x = IntegerMod.residue(16, 4)
          ∨ x = IntegerMod.residue(16, 5)
          ∨ x = IntegerMod.residue(16, 6)
          ∨ x = IntegerMod.residue(16, 7)
          ∨ x = IntegerMod.residue(16, 8)
          ∨ x = IntegerMod.residue(16, 9)
          ∨ x = IntegerMod.residue(16, 10)
          ∨ x = IntegerMod.residue(16, 11)
          ∨ x = IntegerMod.residue(16, 12)
          ∨ x = IntegerMod.residue(16, 13)
          ∨ x = IntegerMod.residue(16, 14)
          ∨ x = IntegerMod.residue(16, 15) := {
  choose r such that r < 16 ∧ x = IntegerMod.make(16, (r : ℤ))
      from IntegerMod.exists_natural_representative(16, done, x);
  x = IntegerMod.make(16, (r : ℤ))
      by And.right(r < 16, x = IntegerMod.make(16, (r : ℤ))) as xReads;
  r < 16 by And.left(r < 16, x = IntegerMod.make(16, (r : ℤ)));
  r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15
      by Natural.below_sixteen_values;
  done by cases {
    case r = 0 as rValue: done by Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 0) by substituting rValue;
        done
      })
    case r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
      case r = 1 as rValue: done by Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 1) by substituting rValue;
        done
      }))
      case r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
        case r = 2 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 2) by substituting rValue;
        done
      })))
        case r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
          case r = 3 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 3) by substituting rValue;
        done
      }))))
          case r = 4 ∨ r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
            case r = 4 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 4) by substituting rValue;
        done
      })))))
            case r = 5 ∨ r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
              case r = 5 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 5) by substituting rValue;
        done
      }))))))
              case r = 6 ∨ r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                case r = 6 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 6) by substituting rValue;
        done
      })))))))
                case r = 7 ∨ r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                  case r = 7 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 7) by substituting rValue;
        done
      }))))))))
                  case r = 8 ∨ r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                    case r = 8 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 8) by substituting rValue;
        done
      })))))))))
                    case r = 9 ∨ r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                      case r = 9 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 9) by substituting rValue;
        done
      }))))))))))
                      case r = 10 ∨ r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                        case r = 10 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 10) by substituting rValue;
        done
      })))))))))))
                        case r = 11 ∨ r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                          case r = 11 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 11) by substituting rValue;
        done
      }))))))))))))
                          case r = 12 ∨ r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                            case r = 12 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 12) by substituting rValue;
        done
      })))))))))))))
                            case r = 13 ∨ r = 14 ∨ r = 15: done by cases {
                              case r = 13 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 13) by substituting rValue;
        done
      }))))))))))))))
                              case r = 14 ∨ r = 15: done by cases {
                                case r = 14 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 14) by substituting rValue;
        done
      })))))))))))))))
                                case r = 15 as rValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight(Or.introduceRight({
        x = IntegerMod.make(16, (r : ℤ)) by xReads
           = IntegerMod.residue(16, 15) by substituting rValue;
        done
      })))))))))))))))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

theorem IntegerMod.square_mod_sixteen (x : IntegerMod(16))
        : x * x = IntegerMod.residue(16, 0)
          ∨ x * x = IntegerMod.residue(16, 1)
          ∨ x * x = IntegerMod.residue(16, 4)
          ∨ x * x = IntegerMod.residue(16, 9) := {
  x = IntegerMod.residue(16, 0)
      ∨ x = IntegerMod.residue(16, 1)
      ∨ x = IntegerMod.residue(16, 2)
      ∨ x = IntegerMod.residue(16, 3)
      ∨ x = IntegerMod.residue(16, 4)
      ∨ x = IntegerMod.residue(16, 5)
      ∨ x = IntegerMod.residue(16, 6)
      ∨ x = IntegerMod.residue(16, 7)
      ∨ x = IntegerMod.residue(16, 8)
      ∨ x = IntegerMod.residue(16, 9)
      ∨ x = IntegerMod.residue(16, 10)
      ∨ x = IntegerMod.residue(16, 11)
      ∨ x = IntegerMod.residue(16, 12)
      ∨ x = IntegerMod.residue(16, 13)
      ∨ x = IntegerMod.residue(16, 14)
      ∨ x = IntegerMod.residue(16, 15)
      by IntegerMod.mod_sixteen_cases(x);
  done by cases {
    case x = IntegerMod.residue(16, 0) as xValue: done by Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 0) * IntegerMod.residue(16, 0) by substituting xValue
           = IntegerMod.residue(16, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0);
        done
      })
    case x = IntegerMod.residue(16, 1) ∨ x = IntegerMod.residue(16, 2) ∨ x = IntegerMod.residue(16, 3) ∨ x = IntegerMod.residue(16, 4) ∨ x = IntegerMod.residue(16, 5) ∨ x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
      case x = IntegerMod.residue(16, 1) as xValue: done by Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 1) * IntegerMod.residue(16, 1) by substituting xValue
           = IntegerMod.residue(16, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0);
        done
      }))
      case x = IntegerMod.residue(16, 2) ∨ x = IntegerMod.residue(16, 3) ∨ x = IntegerMod.residue(16, 4) ∨ x = IntegerMod.residue(16, 5) ∨ x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
        case x = IntegerMod.residue(16, 2) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 2) * IntegerMod.residue(16, 2) by substituting xValue
           = IntegerMod.residue(16, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0);
        done
      })))
        case x = IntegerMod.residue(16, 3) ∨ x = IntegerMod.residue(16, 4) ∨ x = IntegerMod.residue(16, 5) ∨ x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
          case x = IntegerMod.residue(16, 3) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight({
        x * x
           = IntegerMod.residue(16, 3) * IntegerMod.residue(16, 3) by substituting xValue
           = IntegerMod.residue(16, 9)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0);
        done
      })))
          case x = IntegerMod.residue(16, 4) ∨ x = IntegerMod.residue(16, 5) ∨ x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
            case x = IntegerMod.residue(16, 4) as xValue: done by Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 4) * IntegerMod.residue(16, 4) by substituting xValue
           = IntegerMod.residue(16, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 1);
        done
      })
            case x = IntegerMod.residue(16, 5) ∨ x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
              case x = IntegerMod.residue(16, 5) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight({
        x * x
           = IntegerMod.residue(16, 5) * IntegerMod.residue(16, 5) by substituting xValue
           = IntegerMod.residue(16, 9)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 1);
        done
      })))
              case x = IntegerMod.residue(16, 6) ∨ x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                case x = IntegerMod.residue(16, 6) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 6) * IntegerMod.residue(16, 6) by substituting xValue
           = IntegerMod.residue(16, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 2);
        done
      })))
                case x = IntegerMod.residue(16, 7) ∨ x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                  case x = IntegerMod.residue(16, 7) as xValue: done by Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 7) * IntegerMod.residue(16, 7) by substituting xValue
           = IntegerMod.residue(16, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 3);
        done
      }))
                  case x = IntegerMod.residue(16, 8) ∨ x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                    case x = IntegerMod.residue(16, 8) as xValue: done by Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 8) * IntegerMod.residue(16, 8) by substituting xValue
           = IntegerMod.residue(16, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 4);
        done
      })
                    case x = IntegerMod.residue(16, 9) ∨ x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                      case x = IntegerMod.residue(16, 9) as xValue: done by Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 9) * IntegerMod.residue(16, 9) by substituting xValue
           = IntegerMod.residue(16, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 5);
        done
      }))
                      case x = IntegerMod.residue(16, 10) ∨ x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                        case x = IntegerMod.residue(16, 10) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 10) * IntegerMod.residue(16, 10) by substituting xValue
           = IntegerMod.residue(16, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 6);
        done
      })))
                        case x = IntegerMod.residue(16, 11) ∨ x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                          case x = IntegerMod.residue(16, 11) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight({
        x * x
           = IntegerMod.residue(16, 11) * IntegerMod.residue(16, 11) by substituting xValue
           = IntegerMod.residue(16, 9)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 7);
        done
      })))
                          case x = IntegerMod.residue(16, 12) ∨ x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                            case x = IntegerMod.residue(16, 12) as xValue: done by Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 12) * IntegerMod.residue(16, 12) by substituting xValue
           = IntegerMod.residue(16, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 9);
        done
      })
                            case x = IntegerMod.residue(16, 13) ∨ x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                              case x = IntegerMod.residue(16, 13) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceRight({
        x * x
           = IntegerMod.residue(16, 13) * IntegerMod.residue(16, 13) by substituting xValue
           = IntegerMod.residue(16, 9)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 10);
        done
      })))
                              case x = IntegerMod.residue(16, 14) ∨ x = IntegerMod.residue(16, 15): done by cases {
                                case x = IntegerMod.residue(16, 14) as xValue: done by Or.introduceRight(Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 14) * IntegerMod.residue(16, 14) by substituting xValue
           = IntegerMod.residue(16, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 12);
        done
      })))
                                case x = IntegerMod.residue(16, 15) as xValue: done by Or.introduceRight(Or.introduceLeft({
        x * x
           = IntegerMod.residue(16, 15) * IntegerMod.residue(16, 15) by substituting xValue
           = IntegerMod.residue(16, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 14);
        done
      }))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

theorem IntegerMod.square_not_three_mod_five (x : IntegerMod(5))
        (formValue : x * x = IntegerMod.residue(5, 3))
        : False := {
  x * x = IntegerMod.residue(5, 0)
      ∨ x * x = IntegerMod.residue(5, 1)
      ∨ x * x = IntegerMod.residue(5, 4)
      by IntegerMod.square_mod_five(x);
  done by cases {
      case x * x = IntegerMod.residue(5, 0) as xSquare: {
        IntegerMod.residue(5, 3) ≠ IntegerMod.residue(5, 0)
            by IntegerMod.residue_distinct_below_modulus(5, 3, 0, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 3)
           = x * x by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 0) by substituting xSquare
           = IntegerMod.residue(5, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        done by classesDistinct(classesEqual)
      }
      case x * x = IntegerMod.residue(5, 1) ∨ x * x = IntegerMod.residue(5, 4): done by cases {
        case x * x = IntegerMod.residue(5, 1) as xSquare: {
        IntegerMod.residue(5, 3) ≠ IntegerMod.residue(5, 1)
            by IntegerMod.residue_distinct_below_modulus(5, 3, 1, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 3)
           = x * x by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 1) by substituting xSquare
           = IntegerMod.residue(5, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        done by classesDistinct(classesEqual)
      }
        case x * x = IntegerMod.residue(5, 4) as xSquare: {
        IntegerMod.residue(5, 3) ≠ IntegerMod.residue(5, 4)
            by IntegerMod.residue_distinct_below_modulus(5, 3, 4, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 3)
           = x * x by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 4) by substituting xSquare
           = IntegerMod.residue(5, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        done by classesDistinct(classesEqual)
      }
      }
    }
}

theorem IntegerMod.square_plus_double_square_zero_mod_five_classes (x y : IntegerMod(5))
        (formValue : x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) = IntegerMod.residue(5, 0))
        : x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0) := {
  x * x = IntegerMod.residue(5, 0)
      ∨ x * x = IntegerMod.residue(5, 1)
      ∨ x * x = IntegerMod.residue(5, 4)
      by IntegerMod.square_mod_five(x);
  y * y = IntegerMod.residue(5, 0)
      ∨ y * y = IntegerMod.residue(5, 1)
      ∨ y * y = IntegerMod.residue(5, 4)
      by IntegerMod.square_mod_five(y);
  done by cases {
      case x * x = IntegerMod.residue(5, 0) as xSquare: {
      done by cases {
        case y * y = IntegerMod.residue(5, 0) as ySquare: done by And.introduction(xSquare, ySquare)
        case y * y = IntegerMod.residue(5, 1) ∨ y * y = IntegerMod.residue(5, 4): done by cases {
          case y * y = IntegerMod.residue(5, 1) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 2)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 2, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 0) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 0) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 1)) by substituting ySquare
           = IntegerMod.residue(5, 2)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
          case y * y = IntegerMod.residue(5, 4) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 3)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 3, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 0) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 0) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 4)) by substituting ySquare
           = IntegerMod.residue(5, 3)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 1)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
        }
      }
    }
      case x * x = IntegerMod.residue(5, 1) ∨ x * x = IntegerMod.residue(5, 4): done by cases {
        case x * x = IntegerMod.residue(5, 1) as xSquare: {
      done by cases {
        case y * y = IntegerMod.residue(5, 0) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 1)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 1, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 0)) by substituting ySquare
           = IntegerMod.residue(5, 1)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
        case y * y = IntegerMod.residue(5, 1) ∨ y * y = IntegerMod.residue(5, 4): done by cases {
          case y * y = IntegerMod.residue(5, 1) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 3)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 3, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 1)) by substituting ySquare
           = IntegerMod.residue(5, 3)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
          case y * y = IntegerMod.residue(5, 4) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 4)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 4, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 1) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 4)) by substituting ySquare
           = IntegerMod.residue(5, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 1)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
        }
      }
    }
        case x * x = IntegerMod.residue(5, 4) as xSquare: {
      done by cases {
        case y * y = IntegerMod.residue(5, 0) as ySquare: {
        IntegerMod.residue(5, 0) ≠ IntegerMod.residue(5, 4)
            by IntegerMod.residue_distinct_below_modulus(5, 0, 4, done, done, done)
            as classesDistinct;
        IntegerMod.residue(5, 0)
           = x * x + IntegerMod.make(5, (2 : ℤ)) * (y * y) by Equality.symmetry(formValue)
           = IntegerMod.residue(5, 4) + IntegerMod.make(5, (2 : ℤ)) * (y * y) by substituting xSquare
           = IntegerMod.residue(5, 4) + IntegerMod.make(5, (2 : ℤ)) * (IntegerMod.residue(5, 0)) by substituting ySquare
           = IntegerMod.residue(5, 4)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition(x * x = IntegerMod.residue(5, 0) ∧ y * y = IntegerMod.residue(5, 0), impossible)
      }
        case y * y = IntegerMod.residue(5, 1) ∨ y * y = IntegerMod.residue(5, 4): done by cases {
