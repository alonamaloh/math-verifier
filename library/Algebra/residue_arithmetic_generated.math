theorem IntegerMod.square_plus_double_plus_triple_square_eight_mod_sixteen_classes (x y z : IntegerMod(16))
        (formValue : x * x + IntegerMod.make(16, (2 : ℤ)) * (y * y) + IntegerMod.make(16, (3 : ℤ)) * (z * z) = IntegerMod.residue(16, 8))
        : (x * x = IntegerMod.residue(16, 0) ∨ x * x = IntegerMod.residue(16, 4)) ∧ y * y = IntegerMod.residue(16, 4) ∧ (z * z = IntegerMod.residue(16, 0) ∨ z * z = IntegerMod.residue(16, 4)) := {
  x * x = IntegerMod.residue(16, 0)
      ∨ x * x = IntegerMod.residue(16, 1)
      ∨ x * x = IntegerMod.residue(16, 4)
      ∨ x * x = IntegerMod.residue(16, 9)
      by IntegerMod.square_mod_sixteen(x);
  y * y = IntegerMod.residue(16, 0)
      ∨ y * y = IntegerMod.residue(16, 1)
      ∨ y * y = IntegerMod.residue(16, 4)
      ∨ y * y = IntegerMod.residue(16, 9)
      by IntegerMod.square_mod_sixteen(y);
  z * z = IntegerMod.residue(16, 0)
      ∨ z * z = IntegerMod.residue(16, 1)
      ∨ z * z = IntegerMod.residue(16, 4)
      ∨ z * z = IntegerMod.residue(16, 9)
      by IntegerMod.square_mod_sixteen(z);
  done by cases {
      case x * x = IntegerMod.residue(16, 0) as xSquare: {
      done by cases {
        case y * y = IntegerMod.residue(16, 0) as ySquare: {
      done by cases {
          case z * z = IntegerMod.residue(16, 0) as zSquare: {
        IntegerMod.residue(16, 8) ≠ IntegerMod.residue(16, 0)
            by IntegerMod.residue_distinct_below_modulus(16, 8, 0, done, done, done)
            as classesDistinct;
        IntegerMod.residue(16, 8)
           = x * x + IntegerMod.make(16, (2 : ℤ)) * (y * y) + IntegerMod.make(16, (3 : ℤ)) * (z * z) by Equality.symmetry(formValue)
           = IntegerMod.residue(16, 0) + IntegerMod.make(16, (2 : ℤ)) * (y * y) + IntegerMod.make(16, (3 : ℤ)) * (z * z) by substituting xSquare
           = IntegerMod.residue(16, 0) + IntegerMod.make(16, (2 : ℤ)) * (IntegerMod.residue(16, 0)) + IntegerMod.make(16, (3 : ℤ)) * (z * z) by substituting ySquare
           = IntegerMod.residue(16, 0) + IntegerMod.make(16, (2 : ℤ)) * (IntegerMod.residue(16, 0)) + IntegerMod.make(16, (3 : ℤ)) * (IntegerMod.residue(16, 0)) by substituting zSquare
           = IntegerMod.residue(16, 0)
               by IntegerMod.make_equal_of_difference_multiple(multiple := 0)
        as classesEqual;
        False by classesDistinct(classesEqual) as impossible;
        done by False.eliminate_proposition((x * x = IntegerMod.residue(16, 0) ∨ x * x = IntegerMod.residue(16, 4)) ∧ y * y = IntegerMod.residue(16, 4) ∧ (z * z = IntegerMod.residue(16, 0) ∨ z * z = IntegerMod.residue(16, 4)), impossible)
      }
          case z * z = IntegerMod.residue(16, 1) ∨ z * z = IntegerMod.residue(16, 4) ∨ z * z = IntegerMod.residue(16, 9): done by cases {
            case z * z = IntegerMod.residue(16, 1) as zSquare: {
        IntegerMod.residue(16, 8) ≠ IntegerMod.residue(16, 3)
            by IntegerMod.residue_distinct_below_modulus(16, 8, 3, done, done, done)
            as classesDistinct;
