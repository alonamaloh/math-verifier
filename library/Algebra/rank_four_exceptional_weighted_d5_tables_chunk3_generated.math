          Matrix.Represents(Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 1, 2, 8), ((25 * b + 15 : ℕ) : ℤ)) := {
    let A : Matrix(Integer.commutative_ring_bundle, 4, 4) := Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 1, 2, 8);
    0 * 0 + 2 * (1 * 1) + 5 * (2 * 2) + 2 * 1 * 1 * 1 + 2 * 2 * 2 * 1 + 8 * (1 * 1) = (40 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 40, vector := ⟨0, 1, 2, 1⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (0 * 0) + 5 * (3 * 3) + 2 * 1 * 0 * 1 + 2 * 2 * 3 * 1 + 8 * (1 * 1) = (65 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 65, vector := ⟨0, 0, 3, 1⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * (0 * 0) + 5 * (1 * 1) + 2 * 1 * 0 * 3 + 2 * 2 * 1 * 3 + 8 * (3 * 3) = (90 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 90, vector := ⟨1, 0, 1, 3⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    2 * 2 + 2 * (1 * 1) + 5 * (1 * 1) + 2 * 1 * 1 * (-4 : ℤ) + 2 * 2 * 1 * (-4 : ℤ) + 8 * ((-4 : ℤ) * (-4 : ℤ)) = (115 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 115, vector := ⟨2, 1, 1, (-4 : ℤ)⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (2 * 2) + 5 * ((-2 : ℤ) * (-2 : ℤ)) + 2 * 1 * 2 * 4 + 2 * 2 * (-2 : ℤ) * 4 + 8 * (4 * 4) = (140 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 140, vector := ⟨0, 2, (-2 : ℤ), 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (2 * 2) + 5 * (5 * 5) + 2 * 1 * 2 * 1 + 2 * 2 * 5 * 1 + 8 * (1 * 1) = (165 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 165, vector := ⟨0, 2, 5, 1⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (1 * 1) + 5 * (2 * 2) + 2 * 1 * 1 * 4 + 2 * 2 * 2 * 4 + 8 * (4 * 4) = (190 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 190, vector := ⟨0, 1, 2, 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * ((-1 : ℤ) * (-1 : ℤ)) + 5 * (3 * 3) + 2 * 1 * (-1 : ℤ) * 4 + 2 * 2 * 3 * 4 + 8 * (4 * 4) = (215 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 215, vector := ⟨0, (-1 : ℤ), 3, 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    3 * 3 + 2 * (1 * 1) + 5 * (3 * 3) + 2 * 1 * 1 * 4 + 2 * 2 * 3 * 4 + 8 * (4 * 4) = (240 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 240, vector := ⟨3, 1, 3, 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (1 * 1) + 5 * (5 * 5) + 2 * 1 * 1 * 3 + 2 * 2 * 5 * 3 + 8 * (3 * 3) = (265 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 265, vector := ⟨0, 1, 5, 3⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (3 * 3) + 5 * (6 * 6) + 2 * 1 * 3 * 2 + 2 * 2 * 6 * 2 + 8 * (2 * 2) = (290 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 290, vector := ⟨0, 3, 6, 2⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * (3 * 3) + 5 * (4 * 4) + 2 * 1 * 3 * 4 + 2 * 2 * 4 * 4 + 8 * (4 * 4) = (315 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 315, vector := ⟨1, 3, 4, 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * ((-2 : ℤ) * (-2 : ℤ)) + 5 * (2 * 2) + 2 * 1 * (-2 : ℤ) * 6 + 2 * 2 * 2 * 6 + 8 * (6 * 6) = (340 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 340, vector := ⟨0, (-2 : ℤ), 2, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    3 * 3 + 2 * (0 * 0) + 5 * (2 * 2) + 2 * 1 * 0 * 6 + 2 * 2 * 2 * 6 + 8 * (6 * 6) = (365 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 365, vector := ⟨3, 0, 2, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * ((-2 : ℤ) * (-2 : ℤ)) + 5 * (3 * 3) + 2 * 1 * (-2 : ℤ) * 6 + 2 * 2 * 3 * 6 + 8 * (6 * 6) = (390 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 390, vector := ⟨1, (-2 : ℤ), 3, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * (1 * 1) + 5 * (6 * 6) + 2 * 1 * 1 * 4 + 2 * 2 * 6 * 4 + 8 * (4 * 4) = (415 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 415, vector := ⟨1, 1, 6, 4⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    2 * 2 + 2 * (4 * 4) + 5 * (2 * 2) + 2 * 1 * 4 * 6 + 2 * 2 * 2 * 6 + 8 * (6 * 6) = (440 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 440, vector := ⟨2, 4, 2, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * (0 * 0) + 5 * (4 * 4) + 2 * 1 * 0 * 6 + 2 * 2 * 4 * 6 + 8 * (6 * 6) = (465 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 465, vector := ⟨1, 0, 4, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    2 * 2 + 2 * (1 * 1) + 5 * ((-2 : ℤ) * (-2 : ℤ)) + 2 * 1 * 1 * 8 + 2 * 2 * (-2 : ℤ) * 8 + 8 * (8 * 8) = (490 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 490, vector := ⟨2, 1, (-2 : ℤ), 8⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (1 * 1) + 5 * (9 * 9) + 2 * 1 * 1 * 2 + 2 * 2 * 9 * 2 + 8 * (2 * 2) = (515 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 515, vector := ⟨0, 1, 9, 2⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    done by finite_check b from 1 until 21
}
theorem Matrix.weightedD5S1R2C8_small_fifteen_base_part1
        : ∀ (b : ℕ). b ≥ 21 → b < 27 →
          Matrix.Represents(Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 1, 2, 8), ((25 * b + 15 : ℕ) : ℤ)) := {
    let A : Matrix(Integer.commutative_ring_bundle, 4, 4) := Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 1, 2, 8);
    1 * 1 + 2 * (3 * 3) + 5 * (9 * 9) + 2 * 1 * 3 * 2 + 2 * 2 * 9 * 2 + 8 * (2 * 2) = (540 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 540, vector := ⟨1, 3, 9, 2⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (2 * 2) + 5 * (5 * 5) + 2 * 1 * 2 * 6 + 2 * 2 * 5 * 6 + 8 * (6 * 6) = (565 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 565, vector := ⟨0, 2, 5, 6⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * (2 * 2) + 5 * (1 * 1) + 2 * 1 * 2 * 8 + 2 * 2 * 1 * 8 + 8 * (8 * 8) = (590 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 590, vector := ⟨1, 2, 1, 8⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    0 * 0 + 2 * (3 * 3) + 5 * (1 * 1) + 2 * 1 * 3 * 8 + 2 * 2 * 1 * 8 + 8 * (8 * 8) = (615 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 615, vector := ⟨0, 3, 1, 8⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    1 * 1 + 2 * ((-1 : ℤ) * (-1 : ℤ)) + 5 * (3 * 3) + 2 * 1 * (-1 : ℤ) * 8 + 2 * 2 * 3 * 8 + 8 * (8 * 8) = (640 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 640, vector := ⟨1, (-1 : ℤ), 3, 8⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    2 * 2 + 2 * ((-2 : ℤ) * (-2 : ℤ)) + 5 * (1 * 1) + 2 * 1 * (-2 : ℤ) * 9 + 2 * 2 * 1 * 9 + 8 * (9 * 9) = (665 : ℤ) as scalarComputation;
    Matrix.represents_by_witness(A, target := 665, vector := ⟨2, (-2 : ℤ), 1, 9⟩,
      computes := Matrix.squarePlusDoublePlusScaledRankFourRepresentative_coordinateTuple_computes(
        scalarComputation := scalarComputation));
    done by finite_check b from 21 until 27
}
theorem Matrix.weightedD5S1R2C8_small_fifteen_base
        : ∀ (b : ℕ). b ≥ 1 → b < 27 →
          Matrix.Represents(Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 1, 2, 8), ((25 * b + 15 : ℕ) : ℤ)) := {
    done by finite_check b from 1 until 27
}
