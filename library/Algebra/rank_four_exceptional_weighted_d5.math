-- Algebra/rank_four_exceptional_weighted_d5.math
--
-- The four exceptional weighted-d5 forms
--
--   x² + 2y² + 5z² + 2syw + 2rzw + cw²,   (s,r,c) ∈ {(0,0,5),(1,1,5),(1,1,9),(1,2,8)},
--
-- represent every positive integer except their truant 15, so every one of
-- their escalations is universal.

module Algebra.rank_four_exceptional_weighted_d5

import Algebra.rank_four_exceptional_truants_generated
import Algebra.rank_four_exceptional_weighted_d5_covers_generated

theorem Matrix.weightedD5S0R0C5_escalation_universal
        (B : Matrix(Integer.commutative_ring_bundle, 1 + 4, 1 + 4))
        (escalation : Matrix.IsEscalation(
          Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5), B))
        (converse : Matrix.OneTwoFiveConverse)
        : Matrix.IsUniversal(B) := {
  let A : Matrix(Integer.commutative_ring_bundle, 4, 4) :=
      Matrix.squarePlusDoublePlusScaledRankFourRepresentative(5, 0, 0, 5);
  Matrix.truant(A) = 15 by Matrix.truant_equals(
      isTruant := Matrix.weightedD5S0R0C5_truant_fifteen) as truantReads;
  Matrix.RepresentsEveryPositiveExcept(A, 15)
      by Matrix.weightedD5S0R0C5_representsEveryPositiveExceptFifteen(converse);
  Matrix.RepresentsEveryPositiveExcept(A, Matrix.truant(A)) by substituting truantReads
      as representedExceptTruant;
  done by Matrix.escalation_universal_of_parent_representsEveryPositiveExceptTruant(
    A, B, escalation, representedExceptTruant)
}

