-- Plane/model.math
--
-- The two model sets Layer 4 parametrises by, and their compactness.
-- Layer 4.
--
-- An arc is a continuous injective image of an interval and a Jordan
-- curve is one of a circle. Both models are taken here as **plane sets**:
-- the unit segment, and the boundary of the square. That choice is what
-- lets the whole of Layers 1–3 apply to arcs and curves unchanged — a
-- parametrisation is a `Plane.Point → Plane.Point` map, its continuity is
-- `Plane.ContinuousOn`, its image is `Plane.imageSet`, and the
-- compactness the homeomorphism theorem needs is `Plane.IsCompact` of the
-- model. Parametrising by `[0,1] ⊆ ℝ` instead would need a second copy of
-- the relative topology for real-domain maps, and the circle would need a
-- quotient; neither buys anything the segment does not already give.
--
-- The square's boundary is the sup-metric level set `‖x‖∞ = 1`, not a
-- union of four segments. Compactness is then closed-and-bounded with no
-- case analysis: bounded because the Euclidean norm is at most twice the
-- sup norm, closed because moving a point moves its sup distance by no
-- more than the move. The four sides come back as a decomposition when
-- the arc structure of the model is wanted.

module Plane.model

import Logic.basics
import Logic.exists
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value
import Real.absolute_value_order
import Real.convergence
import Real.limits
import Real.cluster
import Natural.subsequence
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.topology
import Plane.sequence
import Plane.compact
import Plane.compactness
import Plane.separation
import Plane.connected

definition Plane.origin : Plane.Point :=
  Plane.Point.make(0, 0)

-- ----------------------------------------------------------------------
-- A segment is compact.
--
-- Bolzano–Weierstrass on the parameters, carried back to the plane by the
-- walk's Lipschitz estimate. The parameters have to be chosen — a point
-- of a degenerate segment has every parameter — which is the one place
-- this file needs countable choice.

theorem Plane.segment_IsCompact (a b : Plane.Point)
        : Plane.IsCompact(Plane.segment(a, b)) := {
  take s : ℕ → Plane.Point;
  suppose ∀ (m : ℕ). s(m) ∈ Plane.segment(a, b) as inside;

  ∀ (n : ℕ). ∃ (t : ℝ). (0 ≤ t ∧ t ≤ 1) ∧ s(n) = Plane.between(a, b, t)
      by (n : ℕ) ↦ inside(n) as hasParameters;
  choose parameter such that
      ∀ (n : ℕ). (0 ≤ parameter(n) ∧ parameter(n) ≤ 1)
                   ∧ s(n) = Plane.between(a, b, parameter(n))
      as chosen
      from Logic.countable_choice(
          ℝ,
          (n : ℕ) (t : ℝ) ↦ (0 ≤ t ∧ t ≤ 1) ∧ s(n) = Plane.between(a, b, t),
          hasParameters);
  ∀ (m : ℕ). 0 ≤ parameter(m)
      by (m : ℕ) ↦ {
        (0 ≤ parameter(m) ∧ parameter(m) ≤ 1)
            ∧ s(m) = Plane.between(a, b, parameter(m)) by chosen;
        done
      }
      as parametersNonneg;
  ∀ (m : ℕ). parameter(m) ≤ 1
      by (m : ℕ) ↦ {
        (0 ≤ parameter(m) ∧ parameter(m) ≤ 1)
            ∧ s(m) = Plane.between(a, b, parameter(m)) by chosen;
        done
      }
      as parametersAtMostOne;

  -- Thin the parameters to a convergent sequence; its limit is again a
  -- parameter, so the walk reaches it.
  Real.SequenceIsBounded(parameter)
      by { witness (1 : ℝ) with
             (m : ℕ) ↦ {
               0 ≤ parameter(m) by parametersNonneg;
               parameter(m) ≤ 1 by parametersAtMostOne;
               -(1 : ℝ) ≤ parameter(m) by ordered_field;
               done by Real.absolute_value_LessOrEqual_of_bounds
             } };
  choose index : ℕ → ℕ, limit : ℝ such that
      Real.SubsequenceConverges(parameter, index, limit)
      from Real.bolzano_weierstrass;
  Natural.IsStrictlyIncreasing(index)
      by Real.SubsequenceConverges.increasing;
  Real.SequenceConverges((k : ℕ) ↦ parameter(index(k)), limit)
      by Real.SubsequenceConverges.converges as parametersConverge;
  0 ≤ limit
      by Real.SequenceConverges.ge_of_eventually_ge(
          (k : ℕ) ↦ parameter(index(k)), limit, 0, parametersConverge, 0,
          (m : ℕ) (beyond : 0 ≤ m) ↦ parametersNonneg(index(m)));
  limit ≤ 1
      by Real.SequenceConverges.le_of_eventually_le(
          (k : ℕ) ↦ parameter(index(k)), limit, 1, parametersConverge, 0,
          (m : ℕ) (beyond : 0 ≤ m) ↦ parametersAtMostOne(index(m)));
  Plane.between(a, b, limit) ∈ Plane.segment(a, b)
      by { witness limit with {
             0 ≤ limit;
             limit ≤ 1;
             Plane.between(a, b, limit) = Plane.between(a, b, limit);
             done
           } };

  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), Plane.between(a, b, limit))
      by (tolerance : ℝ) (tolerancePositive : tolerance > 0) ↦ {
        0 < Plane.parameterGap(tolerance, a, b)
            by Plane.parameterGap_positive;
        choose threshold such that
            ∀ (k : ℕ). threshold ≤ k →
              abs(parameter(index(k)) - limit)
                  < Plane.parameterGap(tolerance, a, b)
            as gapSmall
            from parametersConverge(
                Plane.parameterGap(tolerance, a, b),
                { 0 < Plane.parameterGap(tolerance, a, b) });
        witness threshold with
            (k : ℕ) (beyond : threshold ≤ k) ↦ {
              (0 ≤ parameter(index(k)) ∧ parameter(index(k)) ≤ 1)
                  ∧ s(index(k)) = Plane.between(a, b, parameter(index(k)))
                  by chosen;
              s(index(k)) = Plane.between(a, b, parameter(index(k)))
                  as isWalkPoint;
              abs(parameter(index(k)) - limit)
                  < Plane.parameterGap(tolerance, a, b)
                  by gapSmall;
              Plane.distance(
                  Plane.between(a, b, limit),
                  Plane.between(a, b, parameter(index(k)))) < tolerance
                  by Plane.between_close_of_gap;
              done by substituting isWalkPoint
            }
      };
  witness index with { witness Plane.between(a, b, limit) with done }
}

-- ----------------------------------------------------------------------
-- The unit segment: the model interval.

definition Plane.unitSegment : Set(Plane.Point) :=
  Plane.segment(Plane.origin, Plane.Point.make(1, 0))

-- The point of the model interval at parameter `t`. Every statement about
-- the interval is about this walk, and spelling it out as a walk between
-- two named endpoints buries the parameter it is really about.
definition Plane.walk (parameter : ℝ) : Plane.Point :=
  Plane.between(Plane.origin, Plane.Point.make(1, 0), parameter)

theorem Plane.walk_zero : Plane.walk(0) = Plane.origin :=
  Plane.between_zero(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.walk_one : Plane.walk(1) = Plane.Point.make(1, 0) :=
  Plane.between_one(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.walk_in_unitSegment (parameter : ℝ)
        (atLeastZero : 0 ≤ parameter) (atMostOne : parameter ≤ 1)
        : Plane.walk(parameter) ∈ Plane.unitSegment :=
  witness parameter with done

theorem Plane.unitSegment_IsCompact : Plane.IsCompact(Plane.unitSegment) :=
  Plane.segment_IsCompact(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.unitSegment_IsConnected : Plane.IsConnected(Plane.unitSegment) :=
  Plane.segment_IsConnected(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.start_in_unitSegment : Plane.origin ∈ Plane.unitSegment :=
  Plane.left_in_segment(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.finish_in_unitSegment
        : Plane.Point.make(1, 0) ∈ Plane.unitSegment :=
  Plane.right_in_segment(Plane.origin, Plane.Point.make(1, 0))

theorem Plane.unitSegment_IsConvex : Plane.IsConvex(Plane.unitSegment) :=
  Plane.segment_IsConvex(Plane.origin, Plane.Point.make(1, 0))

-- The parameter of a point of the unit segment is its first coordinate.
-- That is the whole reason the model interval runs along the axis: a
-- subarc's reparametrisation reads its parameter off the point, with no
-- inverse to construct and no choice to make.

-- The walk along the model interval is its own parameter, read off the
-- first coordinate. No membership hypothesis: this is a computation about
-- the walk, and it holds for parameters outside the unit interval too —
-- which is what an affine reparametrisation needs.
theorem Plane.first_of_walk (parameter : ℝ)
        : Plane.Point.first(Plane.walk(parameter)) = parameter :=
  Plane.Point.first(Plane.walk(parameter))
     = Plane.Point.first(Plane.origin)
           + parameter * (Plane.Point.first(Plane.Point.make(1, 0))
                              - Plane.Point.first(Plane.origin))
           by Plane.Point.first_between
     = 0 + parameter * (1 - 0)
     = parameter by ring

theorem Plane.first_coordinate_of_unitSegment (x : Plane.Point)
        (parameter : ℝ) (isWalkPoint : x = Plane.walk(parameter))
        : Plane.Point.first(x) = parameter :=
  Plane.Point.first(x)
     = Plane.Point.first(Plane.walk(parameter)) by substituting isWalkPoint
     = parameter by Plane.first_of_walk

theorem Plane.unitSegment_at_first_coordinate (x : Plane.Point)
        (onSegment : x ∈ Plane.unitSegment)
        : Plane.walk(Plane.Point.first(x)) = x := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.walk(parameter)
      from onSegment;
  x = Plane.walk(parameter);
  Plane.Point.first(x) = parameter
      by Plane.first_coordinate_of_unitSegment as parameterIsFirst;
  Plane.walk(Plane.Point.first(x))
     = Plane.walk(parameter) by substituting parameterIsFirst
     = x by Equality.symmetry;
  done
}

-- A point of the model interval is the walk at its own first coordinate,
-- so the first coordinate determines the point. Without this the same
-- four-line detour through the walk gets written out at every use.
theorem Plane.unitSegment_equal_of_first_coordinate (x y : Plane.Point)
        (xOnSegment : x ∈ Plane.unitSegment)
        (yOnSegment : y ∈ Plane.unitSegment)
        (sameParameter : Plane.Point.first(x) = Plane.Point.first(y))
        : x = y := {
  Plane.walk(Plane.Point.first(x)) = x
      by Plane.unitSegment_at_first_coordinate as xIsItsWalk;
  Plane.walk(Plane.Point.first(y)) = y
      by Plane.unitSegment_at_first_coordinate;
  x = Plane.walk(Plane.Point.first(x)) by xIsItsWalk
    = Plane.walk(Plane.Point.first(y)) by substituting sameParameter
    = y;
  done
}

theorem Plane.first_coordinate_nonneg_on_unitSegment (x : Plane.Point)
        (onSegment : x ∈ Plane.unitSegment)
        : 0 ≤ Plane.Point.first(x) := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.walk(parameter)
      from onSegment;
  0 ≤ parameter;
  x = Plane.walk(parameter);
  Plane.Point.first(x) = parameter
      by Plane.first_coordinate_of_unitSegment as parameterIsFirst;
  done by substituting parameterIsFirst
}

theorem Plane.first_coordinate_atMostOne_on_unitSegment (x : Plane.Point)
        (onSegment : x ∈ Plane.unitSegment)
        : Plane.Point.first(x) ≤ 1 := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.walk(parameter)
      from onSegment;
  parameter ≤ 1;
  x = Plane.walk(parameter);
  Plane.Point.first(x) = parameter
      by Plane.first_coordinate_of_unitSegment as parameterIsFirst;
  done by substituting parameterIsFirst
}

-- ----------------------------------------------------------------------
-- Subsegments of the model interval, read by parameter.
--
-- A point of the interval lies between two others exactly when its
-- parameter does. That is the bridge every statement about "the arc
-- between these two points" needs: the walk from `a` to `b` is a set of
-- points, and the argument about it is an argument about an interval of
-- reals.

theorem Plane.first_coordinate_atLeast_on_segment (a b x : Plane.Point)
        (ordered : Plane.Point.first(a) ≤ Plane.Point.first(b))
        (onSubsegment : x ∈ Plane.segment(a, b))
        : Plane.Point.first(a) ≤ Plane.Point.first(x) := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.between(a, b, parameter)
      from onSubsegment;
  0 ≤ parameter;
  x = Plane.between(a, b, parameter) as isWalkPoint;
  Real.IsNonneg(parameter);
  Real.IsNonneg(Plane.Point.first(b) - Plane.Point.first(a));
  Real.IsNonneg(
      parameter * (Plane.Point.first(b) - Plane.Point.first(a)))
      by Real.IsNonneg.multiply;
  Plane.Point.first(a)
      ≤ Plane.Point.first(a)
            + parameter * (Plane.Point.first(b) - Plane.Point.first(a));
  Plane.Point.first(x)
     = Plane.Point.first(Plane.between(a, b, parameter))
           by substituting isWalkPoint
     = Plane.Point.first(a)
           + parameter * (Plane.Point.first(b) - Plane.Point.first(a))
           by Plane.Point.first_between;
  done
}

theorem Plane.first_coordinate_atMost_on_segment (a b x : Plane.Point)
        (ordered : Plane.Point.first(a) ≤ Plane.Point.first(b))
        (onSubsegment : x ∈ Plane.segment(a, b))
        : Plane.Point.first(x) ≤ Plane.Point.first(b) := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.between(a, b, parameter)
      from onSubsegment;
  parameter ≤ 1;
  x = Plane.between(a, b, parameter) as isWalkPoint;
  Real.IsNonneg(1 - parameter);
  Real.IsNonneg(Plane.Point.first(b) - Plane.Point.first(a));
  Real.IsNonneg(
      (1 - parameter) * (Plane.Point.first(b) - Plane.Point.first(a)))
      by Real.IsNonneg.multiply;
  Plane.Point.first(b)
      - (Plane.Point.first(a)
             + parameter * (Plane.Point.first(b) - Plane.Point.first(a)))
      = (1 - parameter) * (Plane.Point.first(b) - Plane.Point.first(a))
      by ring as remainder;
  Real.IsNonneg(
      Plane.Point.first(b)
          - (Plane.Point.first(a)
                 + parameter
                       * (Plane.Point.first(b) - Plane.Point.first(a))))
      by substituting remainder;
  Plane.Point.first(a)
      + parameter * (Plane.Point.first(b) - Plane.Point.first(a))
      ≤ Plane.Point.first(b);
  Plane.Point.first(x)
     = Plane.Point.first(Plane.between(a, b, parameter))
           by substituting isWalkPoint
     = Plane.Point.first(a)
           + parameter * (Plane.Point.first(b) - Plane.Point.first(a))
           by Plane.Point.first_between;
  done
}

-- The converse. The parameter that puts `x` on the walk is the fraction
-- of the way its own coordinate has travelled — which is why the walk has
-- to be along the axis for any of this to be free.
theorem Plane.member_segment_of_first_coordinate (a b x : Plane.Point)
        (aOnSegment : a ∈ Plane.unitSegment)
        (bOnSegment : b ∈ Plane.unitSegment)
        (xOnSegment : x ∈ Plane.unitSegment)
        (atLeast : Plane.Point.first(a) ≤ Plane.Point.first(x))
        (atMost : Plane.Point.first(x) ≤ Plane.Point.first(b))
        : x ∈ Plane.segment(a, b) :=
  done by cases {
    case Plane.Point.first(a) = Plane.Point.first(b) as degenerate: {
        Plane.Point.first(x) ≤ Plane.Point.first(a)
            by substituting degenerate;
        Plane.Point.first(x) = Plane.Point.first(a)
            by Real.LessOrEqual.antisymmetric;
        x = a by Plane.unitSegment_equal_of_first_coordinate;
        a ∈ Plane.segment(a, b) by Plane.left_in_segment;
        done by substitution
      }
    otherwise as distinctEnds: {
        -- The span is positive, so the fraction of it that `x` has covered
        -- is a parameter of the unit interval, and walking that fraction
        -- from `a` lands on `x`'s coordinate — hence on `x`.
        Plane.Point.first(a) ≤ Plane.Point.first(b);
        ¬(Plane.Point.first(b) = Plane.Point.first(a));
        Plane.Point.first(a) < Plane.Point.first(b);
        0 < Plane.Point.first(b) - Plane.Point.first(a) by ordered_field;
        Plane.Point.first(b) - Plane.Point.first(a) ≠ 0;
        0 ≤ Plane.Point.first(x) - Plane.Point.first(a) by ordered_field;
        0 ≤ (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)) by Real.divide_nonneg;
        Plane.Point.first(x) - Plane.Point.first(a) ≤ Plane.Point.first(b) - Plane.Point.first(a) by ordered_field;
        (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))
            ≤ (Plane.Point.first(b) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))
            by Real.LessOrEqual.divide_by_positive;
        (Plane.Point.first(b) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)) = 1 by Real.divide_self;
        (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)) ≤ 1;
        (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))
                * (Plane.Point.first(b) - Plane.Point.first(a))
            = Plane.Point.first(x) - Plane.Point.first(a)
            by field as coveredSpan;
        Plane.between(a, b, (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)))
            ∈ Plane.unitSegment by Plane.unitSegment_IsConvex;
        Plane.Point.first(
            Plane.between(a, b, (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))))
           = Plane.Point.first(a)
                 + (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))
                       * (Plane.Point.first(b) - Plane.Point.first(a)) by Plane.Point.first_between
           = Plane.Point.first(a) + (Plane.Point.first(x) - Plane.Point.first(a)) by substituting coveredSpan
           = Plane.Point.first(x) by ring;
        Plane.between(a, b, (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a))) = x
            by Plane.unitSegment_equal_of_first_coordinate;
        x = Plane.between(a, b, (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)));
        done by { witness (Plane.Point.first(x) - Plane.Point.first(a)) / (Plane.Point.first(b) - Plane.Point.first(a)) with done }
      }
  }

-- ----------------------------------------------------------------------
-- The square's boundary: the model curve.

definition Plane.squareBoundary : Set(Plane.Point) :=
  (x : Plane.Point) ↦ Plane.supDistance(Plane.origin, x) = 1

-- Membership read in both directions. The level-set spelling is not the
-- one the arguments speak, and an equation-shaped membership is expensive
-- for the auto-prover to unfold on its own, so these two readers carry it.
theorem Plane.supDistance_of_squareBoundary (x : Plane.Point)
        (onBoundary : x ∈ Plane.squareBoundary)
        : Plane.supDistance(Plane.origin, x) = 1 :=
  onBoundary

theorem Plane.member_squareBoundary (x : Plane.Point)
        (level : Plane.supDistance(Plane.origin, x) = 1)
        : x ∈ Plane.squareBoundary :=
  level

theorem Plane.corner_in_squareBoundary
        : Plane.Point.make(1, 1) ∈ Plane.squareBoundary := {
  Plane.Vector.first(Plane.Point.make(1, 1) - Plane.origin)
      = Plane.Point.first(Plane.Point.make(1, 1))
          - Plane.Point.first(Plane.origin)
      by Plane.Point.first_difference;
  Plane.Vector.second(Plane.Point.make(1, 1) - Plane.origin)
      = Plane.Point.second(Plane.Point.make(1, 1))
          - Plane.Point.second(Plane.origin)
      by Plane.Point.second_difference;
  Plane.supDistance(Plane.origin, Plane.Point.make(1, 1))
     = max(abs((1 : ℝ) - 0), abs((1 : ℝ) - 0))
     = max((1 : ℝ), (1 : ℝ))
     = 1 by Real.maximum_self;
  done
}

theorem Plane.squareBoundary_IsNonempty
        : Set.IsNonempty(Plane.Point, Plane.squareBoundary) :=
  witness Plane.Point.make(1, 1) with
      Plane.corner_in_squareBoundary

theorem Plane.squareBoundary_IsBounded
        : Plane.IsBounded(Plane.squareBoundary) := {
  witness Plane.origin with {
    witness (2 : ℝ) with
        (x : Plane.Point) (onBoundary : x ∈ Plane.squareBoundary) ↦ {
          Plane.supDistance(Plane.origin, x) = 1
              by onBoundary as unitSupDistance;
          Plane.distance(Plane.origin, x)
             = Plane.Vector.norm(x - Plane.origin)
             ≤ 2 * Plane.Vector.supNorm(x - Plane.origin)
                   by Plane.Vector.norm_LessOrEqual_two_supNorm
             = 2 * Plane.supDistance(Plane.origin, x)
             = 2 * 1 by unitSupDistance
             = 2;
          done
        }
  }
}

-- The level set is closed: a point of its closure that missed it would
-- have the whole gap to spare, and the sup distance from the origin moves
-- by no more than the point does — less, even, than the Euclidean ball the
-- closure hands over.
theorem Plane.squareBoundary_IsClosed
        : Plane.Closure(Plane.squareBoundary) ⊆ Plane.squareBoundary := {
  take x : Plane.Point;
  suppose x ∈ Plane.Closure(Plane.squareBoundary) as inClosure;
  ∀ (radius : ℝ). 0 < radius →
      ∃ (y : Plane.Point). y ∈ Plane.squareBoundary
        ∧ Plane.distance(x, y) < radius
      as boundaryIsNear;
  suppose ¬(Plane.supDistance(Plane.origin, x) = 1) as notOnLevel
      for contradiction {
    Plane.supDistance(Plane.origin, x) - 1 ≠ 0
        by (gapVanishes : Plane.supDistance(Plane.origin, x) - 1 = 0) ↦ {
          Plane.supDistance(Plane.origin, x) = 1
              by linear_combination(gapVanishes);
          done
        };
    0 < abs(Plane.supDistance(Plane.origin, x) - 1)
        by Real.absolute_value_positive;
    choose near such that
        Plane.supDistance(Plane.origin, near) = 1
          ∧ Plane.distance(x, near)
                < abs(Plane.supDistance(Plane.origin, x) - 1)
        from boundaryIsNear;
    Plane.supDistance(Plane.origin, near) = 1 as nearOnLevel;
    Plane.distance(x, near) < abs(Plane.supDistance(Plane.origin, x) - 1);
    Plane.supDistance(Plane.origin, near) - Plane.supDistance(Plane.origin, x)
        = 1 - Plane.supDistance(Plane.origin, x)
        by linear_combination(nearOnLevel) as gapAtNear;
    abs(Plane.supDistance(Plane.origin, near)
            - Plane.supDistance(Plane.origin, x))
        ≤ Plane.supDistance(x, near) by Plane.supDistance_shift_bound;
    Plane.supDistance(x, near) ≤ Plane.distance(x, near)
        by Plane.supDistance_LessOrEqual_distance;
    abs(1 - Plane.supDistance(Plane.origin, x)) ≤ Plane.distance(x, near)
        by substituting gapAtNear;
    abs(Plane.supDistance(Plane.origin, x) - 1)
       = abs(1 - Plane.supDistance(Plane.origin, x))
             by Real.absolute_value_subtract_swap
       ≤ Plane.distance(x, near)
       < abs(Plane.supDistance(Plane.origin, x) - 1);
    done by Real.LessThan.irreflexive
  };
  done by Plane.member_squareBoundary
}

theorem Plane.squareBoundary_IsCompact
        : Plane.IsCompact(Plane.squareBoundary) :=
  Plane.compact_of_closed_bounded(
      Plane.squareBoundary, Plane.squareBoundary_IsClosed,
      Plane.squareBoundary_IsBounded)

-- ----------------------------------------------------------------------
-- The circle.
--
-- The unit circle needs no trigonometry: like the square's boundary it is
-- a level set, of the Euclidean norm rather than the sup norm, and the
-- same three lines give its compactness. Trigonometry is only wanted to
-- TRAVERSE a circle at constant speed, which is why the square's boundary
-- stays the working model — its traversal is piecewise affine — while the
-- circle is what a Jordan curve is defined against.

definition Plane.circle : Set(Plane.Point) :=
  (x : Plane.Point) ↦ Plane.distance(Plane.origin, x) = 1

theorem Plane.distance_of_circle (x : Plane.Point)
        (onCircle : x ∈ Plane.circle)
        : Plane.distance(Plane.origin, x) = 1 :=
  onCircle

theorem Plane.member_circle (x : Plane.Point)
        (level : Plane.distance(Plane.origin, x) = 1)
        : x ∈ Plane.circle :=
  level

theorem Plane.pole_in_circle : Plane.Point.make(1, 0) ∈ Plane.circle := {
  Plane.distance(Plane.origin, Plane.Point.make(1, 0)) = 1
      by Plane.distance_make;
  done by Plane.member_circle
}

theorem Plane.circle_IsNonempty : Set.IsNonempty(Plane.Point, Plane.circle) :=
  witness Plane.Point.make(1, 0) with Plane.pole_in_circle

theorem Plane.circle_IsBounded : Plane.IsBounded(Plane.circle) := {
  witness Plane.origin with {
    witness (1 : ℝ) with
        (x : Plane.Point) (onCircle : x ∈ Plane.circle) ↦ {
          Plane.distance(Plane.origin, x) = 1
              by Plane.distance_of_circle;
          done
        }
  }
}

theorem Plane.circle_IsClosed : Plane.Closure(Plane.circle) ⊆ Plane.circle := {
  take x : Plane.Point;
  suppose x ∈ Plane.Closure(Plane.circle) as inClosure;
  ∀ (radius : ℝ). 0 < radius →
      ∃ (y : Plane.Point). y ∈ Plane.circle ∧ Plane.distance(x, y) < radius
      as circleIsNear;
  suppose ¬(Plane.distance(Plane.origin, x) = 1) as notOnLevel
      for contradiction {
    Plane.distance(Plane.origin, x) - 1 ≠ 0
        by (gapVanishes : Plane.distance(Plane.origin, x) - 1 = 0) ↦ {
          Plane.distance(Plane.origin, x) = 1
              by linear_combination(gapVanishes);
          done
        };
    0 < abs(Plane.distance(Plane.origin, x) - 1)
        by Real.absolute_value_positive;
    choose near such that
        Plane.distance(Plane.origin, near) = 1
          ∧ Plane.distance(x, near) < abs(Plane.distance(Plane.origin, x) - 1)
        from circleIsNear;
    Plane.distance(Plane.origin, near) = 1 as nearOnLevel;
    Plane.distance(x, near) < abs(Plane.distance(Plane.origin, x) - 1);
    Plane.distance(Plane.origin, near) - Plane.distance(Plane.origin, x)
        = 1 - Plane.distance(Plane.origin, x)
        by linear_combination(nearOnLevel) as gapAtNear;
    abs(Plane.distance(Plane.origin, near)
            - Plane.distance(Plane.origin, x))
        ≤ Plane.distance(x, near) by Plane.distance_shift_bound;
    abs(1 - Plane.distance(Plane.origin, x)) ≤ Plane.distance(x, near)
        by substituting gapAtNear;
    abs(Plane.distance(Plane.origin, x) - 1)
       = abs(1 - Plane.distance(Plane.origin, x))
             by Real.absolute_value_subtract_swap
       ≤ Plane.distance(x, near)
       < abs(Plane.distance(Plane.origin, x) - 1);
    done by Real.LessThan.irreflexive
  };
  done by Plane.member_circle
}

theorem Plane.circle_IsCompact : Plane.IsCompact(Plane.circle) :=
  Plane.compact_of_closed_bounded(
      Plane.circle, Plane.circle_IsClosed, Plane.circle_IsBounded)
