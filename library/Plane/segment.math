-- Plane/segment.math
--
-- Segments, convexity, and the two kinds of ball. The last file of
-- Layer 0.
--
-- `Plane.between(a, b, t)` walks the fraction `t` of the way from `a` to
-- `b`. A set is convex when it is closed under that walk, and the
-- blueprint's use of convexity is always this direct: a disk contains the
-- segment between any two of its points, so a crosscut through a disk
-- stays inside it.
--
-- The key estimate is `Plane.Vector.norm_affine_combination`: a weighted
-- average of two vectors is no longer than the longer of them. Its proof
-- is the triangle inequality plus `norm_scale`, with `Real.maximum` doing
-- the "longer of them" bookkeeping.

module Plane.segment

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.maximum
import Real.absolute_value
import Real.absolute_value_order
import Real.order_multiplication
import Real.order_field
import Real.division
import Plane.vector
import Plane.point
import Plane.bilinear
import Plane.norm

-- ----------------------------------------------------------------------
-- Walking from one point toward another.

definition Plane.between (a b : Plane.Point) (t : ℝ) : Plane.Point :=
  a + t * (b - a)

theorem Plane.between_zero (a b : Plane.Point)
        : Plane.between(a, b, 0) = a := {
  (0 : ℝ) * (b - a) = Plane.Vector.zero by Plane.Vector.scale_zero;
  Plane.between(a, b, 0)
     = a + (0 : ℝ) * (b - a)
     = a + Plane.Vector.zero
     = a by Plane.Point.translate_zero;
  done
}

theorem Plane.between_one (a b : Plane.Point)
        : Plane.between(a, b, 1) = b := {
  (1 : ℝ) * (b - a) = b - a by Plane.Vector.scale_one;
  Plane.between(a, b, 1)
     = a + (1 : ℝ) * (b - a)
     = a + (b - a)
     = b by Plane.Point.translate_difference;
  done
}

-- Measured from any third point, the walk is the weighted average of the
-- two displacements. This is the identity every estimate below runs on.
theorem Plane.between_difference (a b c : Plane.Point) (t : ℝ)
        : Plane.between(a, b, t) - c
              = (1 - t) * (a - c) + t * (b - c) :=
  Plane.between(a, b, t) - c
     = (a + t * (b - a)) - c
     = (a - c) + t * (b - a) by Plane.Point.translate_difference_left
     = (a - c) + t * ((b - c) - (a - c)) by Plane.Point.difference_via
     = (1 - t) * (a - c) + t * (b - c)
           by Plane.Vector.affine_combination

-- ----------------------------------------------------------------------
-- The estimate: a weighted average is no longer than the longer summand.

theorem Plane.Vector.norm_affine_combination (u w : Plane.Vector) (t : ℝ)
        (tNonneg : 0 ≤ t) (tAtMostOne : t ≤ 1)
        : Plane.Vector.norm((1 - t) * u + t * w)
              ≤ max(Plane.Vector.norm(u), Plane.Vector.norm(w)) := {
  0 ≤ 1 - t;
  abs(1 - t) = 1 - t as absWeight;
  abs(t) = t by Real.absolute_value_when_nonneg as absRest;
  Plane.Vector.norm(u) ≤ max(Plane.Vector.norm(u), Plane.Vector.norm(w));
  Plane.Vector.norm(w) ≤ max(Plane.Vector.norm(u), Plane.Vector.norm(w));
  Real.IsNonneg(1 - t);
  Real.IsNonneg(t);
  (1 - t) * Plane.Vector.norm(u)
      ≤ (1 - t) * max(Plane.Vector.norm(u), Plane.Vector.norm(w));
  t * Plane.Vector.norm(w)
      ≤ t * max(Plane.Vector.norm(u), Plane.Vector.norm(w));
  -- Both weights are nonnegative, so the scaling law drops its `abs`.
  Plane.Vector.norm((1 - t) * u)
     = abs(1 - t) * Plane.Vector.norm(u) by Plane.Vector.norm_scale
     = (1 - t) * Plane.Vector.norm(u) by absWeight as scaledLeft;
  Plane.Vector.norm(t * w)
     = abs(t) * Plane.Vector.norm(w) by Plane.Vector.norm_scale
     = t * Plane.Vector.norm(w) by absRest as scaledRight;
  Plane.Vector.norm((1 - t) * u + t * w)
     ≤ Plane.Vector.norm((1 - t) * u) + Plane.Vector.norm(t * w)
           by Plane.Vector.norm_triangle
     = (1 - t) * Plane.Vector.norm(u) + Plane.Vector.norm(t * w)
           by scaledLeft
     = (1 - t) * Plane.Vector.norm(u) + t * Plane.Vector.norm(w)
           by scaledRight
     ≤ (1 - t) * max(Plane.Vector.norm(u), Plane.Vector.norm(w))
           + t * max(Plane.Vector.norm(u), Plane.Vector.norm(w))
     = max(Plane.Vector.norm(u), Plane.Vector.norm(w)) by ring;
  done
}

-- ----------------------------------------------------------------------
-- Segments and convexity.

-- The walk in coordinates: each coordinate walks from one endpoint's to
-- the other's. Part I's parity counting reads points this way, and the
-- reversal below is the first customer.
theorem Plane.Point.first_between (a b : Plane.Point) (t : ℝ)
        : Plane.Point.first(Plane.between(a, b, t))
              = Plane.Point.first(a)
                  + t * (Plane.Point.first(b) - Plane.Point.first(a)) := {
  Plane.Point.first(Plane.between(a, b, t))
     = Plane.Vector.first(Plane.Point.position(a) + t * (b - a))
           by Plane.Point.position_translate
     = Plane.Vector.first(Plane.Point.position(a))
           + Plane.Vector.first(t * (b - a)) by Plane.Vector.first_add
     = Plane.Point.first(a) + t * Plane.Vector.first(b - a)
           by Plane.Vector.first_scale
     = Plane.Point.first(a) + t * (Plane.Point.first(b) - Plane.Point.first(a))
           by Plane.Point.first_difference;
  done
}

theorem Plane.Point.second_between (a b : Plane.Point) (t : ℝ)
        : Plane.Point.second(Plane.between(a, b, t))
              = Plane.Point.second(a)
                  + t * (Plane.Point.second(b) - Plane.Point.second(a)) := {
  Plane.Point.second(Plane.between(a, b, t))
     = Plane.Vector.second(Plane.Point.position(a) + t * (b - a))
           by Plane.Point.position_translate
     = Plane.Vector.second(Plane.Point.position(a))
           + Plane.Vector.second(t * (b - a)) by Plane.Vector.second_add
     = Plane.Point.second(a) + t * Plane.Vector.second(b - a)
           by Plane.Vector.second_scale
     = Plane.Point.second(a)
           + t * (Plane.Point.second(b) - Plane.Point.second(a))
           by Plane.Point.second_difference;
  done
}

-- Walking backwards along the reversed walk lands in the same place, so
-- the two orientations of a segment are the same set.
theorem Plane.between_reverse (a b : Plane.Point) (t : ℝ)
        : Plane.between(a, b, t) = Plane.between(b, a, 1 - t) := {
  Plane.Point.first(Plane.between(a, b, t))
     = Plane.Point.first(a) + t * (Plane.Point.first(b) - Plane.Point.first(a))
           by Plane.Point.first_between
     = Plane.Point.first(b)
           + (1 - t) * (Plane.Point.first(a) - Plane.Point.first(b))
     = Plane.Point.first(Plane.between(b, a, 1 - t))
           by Plane.Point.first_between;
  Plane.Point.second(Plane.between(a, b, t))
     = Plane.Point.second(a)
           + t * (Plane.Point.second(b) - Plane.Point.second(a))
           by Plane.Point.second_between
     = Plane.Point.second(b)
           + (1 - t) * (Plane.Point.second(a) - Plane.Point.second(b))
     = Plane.Point.second(Plane.between(b, a, 1 - t))
           by Plane.Point.second_between;
  done by Plane.Point.equal_of_coordinates
}

definition Plane.segment (a b : Plane.Point) : Set(Plane.Point) :=
  (x : Plane.Point) ↦
    ∃ (t : ℝ). (0 ≤ t ∧ t ≤ 1) ∧ x = Plane.between(a, b, t)

definition Plane.IsConvex (region : Set(Plane.Point)) : Proposition :=
  ∀ (a : Plane.Point). a ∈ region →
    ∀ (b : Plane.Point). b ∈ region →
      ∀ (t : ℝ). 0 ≤ t → t ≤ 1 → Plane.between(a, b, t) ∈ region

theorem Plane.left_in_segment (a b : Plane.Point)
        : a ∈ Plane.segment(a, b) :=
  witness (0 : ℝ) with {
    (0 : ℝ) ≤ 0;
    (0 : ℝ) ≤ 1;
    a = Plane.between(a, b, 0) by Plane.between_zero;
    done
  }

theorem Plane.right_in_segment (a b : Plane.Point)
        : b ∈ Plane.segment(a, b) :=
  witness (1 : ℝ) with {
    (0 : ℝ) ≤ 1;
    (1 : ℝ) ≤ 1;
    b = Plane.between(a, b, 1) by Plane.between_one;
    done
  }

-- A walk that goes nowhere stays put, so a segment with equal endpoints is
-- the one point. This is the degenerate case every "nothing, a point, or an
-- interval" statement folds into "empty, or a segment".
theorem Plane.between_degenerate (a : Plane.Point) (t : ℝ)
        : Plane.between(a, a, t) = a := {
  Plane.Point.first(Plane.between(a, a, t))
     = Plane.Point.first(a) + t * (Plane.Point.first(a) - Plane.Point.first(a))
           by Plane.Point.first_between
     = Plane.Point.first(a);
  Plane.Point.second(Plane.between(a, a, t))
     = Plane.Point.second(a) + t * (Plane.Point.second(a) - Plane.Point.second(a))
           by Plane.Point.second_between
     = Plane.Point.second(a);
  done by Plane.Point.equal_of_coordinates
}

theorem Plane.segment_degenerate (a : Plane.Point)
        : Plane.segment(a, a) = Set.singleton(Plane.Point, a) := {
  Plane.segment(a, a) ⊆ Set.singleton(Plane.Point, a)
      by { take x : Plane.Point;
           suppose x ∈ Plane.segment(a, a) as onSegment;
           choose t such that (0 ≤ t ∧ t ≤ 1) ∧ x = Plane.between(a, a, t)
               from onSegment;
           x = Plane.between(a, a, t)
             = a by Plane.between_degenerate;
           done };
  Set.singleton(Plane.Point, a) ⊆ Plane.segment(a, a)
      by { take x : Plane.Point;
           suppose x ∈ Set.singleton(Plane.Point, a);
           x = a;
           a ∈ Plane.segment(a, a) by Plane.left_in_segment;
           done };
  done by Set.equal_of_same_members
}

-- A segment has no preferred end.
theorem Plane.segment_subset_reverse (a b : Plane.Point)
        : Plane.segment(a, b) ⊆ Plane.segment(b, a) := {
  take x : Plane.Point;
  suppose x ∈ Plane.segment(a, b) as onSegment;
  choose t such that
      (0 ≤ t ∧ t ≤ 1) ∧ x = Plane.between(a, b, t) from onSegment;
  0 ≤ t;
  t ≤ 1;
  x = Plane.between(a, b, t);
  witness 1 - t with {
    0 ≤ 1 - t;
    1 - t ≤ 1;
    x = Plane.between(a, b, t)
      = Plane.between(b, a, 1 - t) by Plane.between_reverse;
    done
  }
}

theorem Plane.segment_symmetric (a b : Plane.Point)
        : Plane.segment(a, b) = Plane.segment(b, a) := {
  Plane.segment(a, b) ⊆ Plane.segment(b, a) by Plane.segment_subset_reverse;
  Plane.segment(b, a) ⊆ Plane.segment(a, b) by Plane.segment_subset_reverse;
  done by Set.equal_of_same_members
}

-- Walking between two points of a walk is walking with the corresponding
-- parameter: the parameters compose by the same weighted average as the
-- points do. Read coordinatewise, this is one ring identity per axis.
theorem Plane.between_nested (a b : Plane.Point) (s u t : ℝ)
        : Plane.between(Plane.between(a, b, s), Plane.between(a, b, u), t)
              = Plane.between(a, b, (1 - t) * s + t * u) := {
  Plane.Point.first(Plane.between(a, b, s))
      = Plane.Point.first(a) + s * (Plane.Point.first(b) - Plane.Point.first(a))
      by Plane.Point.first_between as firstAtStart;
  Plane.Point.first(Plane.between(a, b, u))
      = Plane.Point.first(a) + u * (Plane.Point.first(b) - Plane.Point.first(a))
      by Plane.Point.first_between as firstAtEnd;
  Plane.Point.first(Plane.between(Plane.between(a, b, s), Plane.between(a, b, u), t))
     = Plane.Point.first(Plane.between(a, b, s))
           + t * (Plane.Point.first(Plane.between(a, b, u))
                    - Plane.Point.first(Plane.between(a, b, s)))
           by Plane.Point.first_between
     = (Plane.Point.first(a) + s * (Plane.Point.first(b) - Plane.Point.first(a)))
           + t * (Plane.Point.first(Plane.between(a, b, u))
                    - (Plane.Point.first(a)
                         + s * (Plane.Point.first(b) - Plane.Point.first(a))))
           by substituting firstAtStart
     = (Plane.Point.first(a) + s * (Plane.Point.first(b) - Plane.Point.first(a)))
           + t * ((Plane.Point.first(a)
                     + u * (Plane.Point.first(b) - Plane.Point.first(a)))
                    - (Plane.Point.first(a)
                         + s * (Plane.Point.first(b) - Plane.Point.first(a))))
           by substituting firstAtEnd
     = Plane.Point.first(a)
           + ((1 - t) * s + t * u)
               * (Plane.Point.first(b) - Plane.Point.first(a)) by ring
     = Plane.Point.first(Plane.between(a, b, (1 - t) * s + t * u))
           by Plane.Point.first_between;

  Plane.Point.second(Plane.between(a, b, s))
      = Plane.Point.second(a)
          + s * (Plane.Point.second(b) - Plane.Point.second(a))
      by Plane.Point.second_between as secondAtStart;
  Plane.Point.second(Plane.between(a, b, u))
      = Plane.Point.second(a)
          + u * (Plane.Point.second(b) - Plane.Point.second(a))
      by Plane.Point.second_between as secondAtEnd;
  Plane.Point.second(Plane.between(Plane.between(a, b, s), Plane.between(a, b, u), t))
     = Plane.Point.second(Plane.between(a, b, s))
           + t * (Plane.Point.second(Plane.between(a, b, u))
                    - Plane.Point.second(Plane.between(a, b, s)))
           by Plane.Point.second_between
     = (Plane.Point.second(a)
            + s * (Plane.Point.second(b) - Plane.Point.second(a)))
           + t * (Plane.Point.second(Plane.between(a, b, u))
                    - (Plane.Point.second(a)
                         + s * (Plane.Point.second(b) - Plane.Point.second(a))))
           by substituting secondAtStart
     = (Plane.Point.second(a)
            + s * (Plane.Point.second(b) - Plane.Point.second(a)))
           + t * ((Plane.Point.second(a)
                     + u * (Plane.Point.second(b) - Plane.Point.second(a)))
                    - (Plane.Point.second(a)
                         + s * (Plane.Point.second(b) - Plane.Point.second(a))))
           by substituting secondAtEnd
     = Plane.Point.second(a)
           + ((1 - t) * s + t * u)
               * (Plane.Point.second(b) - Plane.Point.second(a)) by ring
     = Plane.Point.second(Plane.between(a, b, (1 - t) * s + t * u))
           by Plane.Point.second_between;
  done by Plane.Point.equal_of_coordinates
}

-- A weighted average of two parameters in the unit interval is again in
-- it, which is all the parameter bookkeeping a segment's convexity needs.
theorem Plane.combination_in_unit_interval (s u t : ℝ)
        (sNonneg : 0 ≤ s) (sAtMostOne : s ≤ 1)
        (uNonneg : 0 ≤ u) (uAtMostOne : u ≤ 1)
        (tNonneg : 0 ≤ t) (tAtMostOne : t ≤ 1)
        : 0 ≤ (1 - t) * s + t * u ∧ (1 - t) * s + t * u ≤ 1 := {
  0 ≤ 1 - t;
  0 ≤ (1 - t) * s;
  0 ≤ t * u;
  0 ≤ (1 - t) * s + t * u;
  (1 - t) * s ≤ (1 - t) * 1 by Real.LessOrEqual.multiply_by_nonneg_left;
  t * u ≤ t * 1 by Real.LessOrEqual.multiply_by_nonneg_left;
  (1 - t) * s + t * u
     ≤ (1 - t) * 1 + t * 1
     = 1 by ring;
  done
}

-- A segment is convex, so it is connected once convex sets are: walking
-- between two of its points never leaves it.
theorem Plane.segment_IsConvex (a b : Plane.Point)
        : Plane.IsConvex(Plane.segment(a, b)) := {
  take p : Plane.Point;
  suppose p ∈ Plane.segment(a, b) as pOnSegment;
  take q : Plane.Point;
  suppose q ∈ Plane.segment(a, b) as qOnSegment;
  take t : ℝ;
  suppose 0 ≤ t as tNonneg;
  suppose t ≤ 1 as tAtMostOne;
  choose s such that
      (0 ≤ s ∧ s ≤ 1) ∧ p = Plane.between(a, b, s) from pOnSegment;
  0 ≤ s;
  s ≤ 1;
  p = Plane.between(a, b, s) as pIsWalkPoint;
  choose u such that
      (0 ≤ u ∧ u ≤ 1) ∧ q = Plane.between(a, b, u) from qOnSegment;
  0 ≤ u;
  u ≤ 1;
  q = Plane.between(a, b, u) as qIsWalkPoint;
  0 ≤ (1 - t) * s + t * u ∧ (1 - t) * s + t * u ≤ 1
      by Plane.combination_in_unit_interval;
  0 ≤ (1 - t) * s + t * u;
  (1 - t) * s + t * u ≤ 1;
  Plane.between(p, q, t)
     = Plane.between(Plane.between(a, b, s), q, t) by substituting pIsWalkPoint
     = Plane.between(Plane.between(a, b, s), Plane.between(a, b, u), t)
           by substituting qIsWalkPoint
     = Plane.between(a, b, (1 - t) * s + t * u) by Plane.between_nested;
  Plane.between(p, q, t) ∈ Plane.segment(a, b)
      by { witness (1 - t) * s + t * u with {
             0 ≤ (1 - t) * s + t * u;
             (1 - t) * s + t * u ≤ 1;
             Plane.between(p, q, t) = Plane.between(a, b, (1 - t) * s + t * u);
             done
           } };
  done
}

-- Convexity, read as a statement about segments rather than about the
-- walk: a convex set holds the whole segment between two of its points.
-- Two convex sets meet in a convex set: a walk between two common points
-- stays in each of them.
theorem Plane.IsConvex.intersection (left right : Set(Plane.Point))
        (leftConvex : Plane.IsConvex(left)) (rightConvex : Plane.IsConvex(right))
        : Plane.IsConvex(left ∩ right) := {
  take x : Plane.Point;
  suppose x ∈ left ∩ right;
  take y : Plane.Point;
  suppose y ∈ left ∩ right;
  take t : ℝ;
  suppose 0 ≤ t;
  suppose t ≤ 1;
  x ∈ left;
  y ∈ left;
  Plane.between(x, y, t) ∈ left by leftConvex;
  x ∈ right;
  y ∈ right;
  Plane.between(x, y, t) ∈ right by rightConvex;
  done
}

theorem Plane.IsConvex.segment_inside (region : Set(Plane.Point))
        (convex : Plane.IsConvex(region))
        (a b : Plane.Point) (aInside : a ∈ region) (bInside : b ∈ region)
        : Plane.segment(a, b) ⊆ region := {
  take x : Plane.Point;
  suppose x ∈ Plane.segment(a, b) as onSegment;
  choose t such that
      (0 ≤ t ∧ t ≤ 1) ∧ x = Plane.between(a, b, t) from onSegment;
  0 ≤ t;
  t ≤ 1;
  x = Plane.between(a, b, t) as isWalkPoint;
  Plane.between(a, b, t) ∈ region
      by convex;
  done by substituting isWalkPoint
}

-- ----------------------------------------------------------------------
-- Balls, and their convexity.

definition Plane.Ball (center : Plane.Point) (radius : ℝ) : Set(Plane.Point) :=
  (x : Plane.Point) ↦ Plane.distance(center, x) < radius

definition Plane.supBall (center : Plane.Point) (radius : ℝ)
        : Set(Plane.Point) :=
  (x : Plane.Point) ↦ Plane.supDistance(center, x) < radius

-- A disk is convex: the walk between two of its points stays inside,
-- because a weighted average of the two displacements is no longer than
-- the longer of them, which is already short of the radius.
theorem Plane.Ball_IsConvex (center : Plane.Point) (radius : ℝ)
        : Plane.IsConvex(Plane.Ball(center, radius)) := {
  take a : Plane.Point;
  suppose a ∈ Plane.Ball(center, radius) as aInside;
  take b : Plane.Point;
  suppose b ∈ Plane.Ball(center, radius) as bInside;
  take t : ℝ;
  suppose 0 ≤ t as tNonneg;
  suppose t ≤ 1 as tAtMostOne;
  Plane.Vector.norm(a - center) < radius;
  Plane.Vector.norm(b - center) < radius;
  max(Plane.Vector.norm(a - center), Plane.Vector.norm(b - center)) < radius;
  Plane.Vector.norm(Plane.between(a, b, t) - center)
     = Plane.Vector.norm((1 - t) * (a - center) + t * (b - center))
           by Plane.between_difference
     ≤ max(Plane.Vector.norm(a - center), Plane.Vector.norm(b - center))
           by Plane.Vector.norm_affine_combination
     < radius;
  done
}

-- ----------------------------------------------------------------------
-- Walking at unit speed.
--
-- Two points of the same walk differ by the parameter gap times the
-- displacement, so the distance between them is proportional to the gap.
-- This is what turns an ε on the plane into a δ on the parameter, and it
-- is the only estimate the connectedness of a convex set needs.

theorem Plane.between_difference_parameter (a b : Plane.Point) (s t : ℝ)
        : Plane.between(a, b, t) - Plane.between(a, b, s)
              = (t - s) * (b - a) :=
  Plane.between(a, b, t) - Plane.between(a, b, s)
     = (Plane.between(a, b, t) - a) - (Plane.between(a, b, s) - a)
           by Plane.Point.difference_via
     = t * (b - a) - (Plane.between(a, b, s) - a)
           by Plane.Point.difference_translate
     = t * (b - a) - s * (b - a)
           by Plane.Point.difference_translate
     = (t - s) * (b - a) by Plane.Vector.subtract_scale_factors

theorem Plane.between_distance (a b : Plane.Point) (s t : ℝ)
        : Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t))
              = abs(t - s) * Plane.distance(a, b) := {
  Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t))
     = Plane.Vector.norm(Plane.between(a, b, t) - Plane.between(a, b, s))
     = Plane.Vector.norm((t - s) * (b - a))
           by Plane.between_difference_parameter
     = abs(t - s) * Plane.Vector.norm(b - a) by Plane.Vector.norm_scale
     = abs(t - s) * Plane.distance(a, b);
  done
}

-- Measured from the left endpoint, the distance along a walk IS the
-- parameter, scaled. So on a nondegenerate segment the distance from the
-- left endpoint ORDERS the parameters — which is what lets an extremum of
-- that distance stand in for an extremum of the parameter.
theorem Plane.distance_from_left (a b : Plane.Point) (t : ℝ) (tNonneg : t ≥ 0)
        : Plane.distance(a, Plane.between(a, b, t)) = t * Plane.distance(a, b) := {
  abs(t - 0) = abs(t)
             = t by Real.absolute_value_when_nonneg   as absOfParameter;
  Plane.distance(a, Plane.between(a, b, t))
     = Plane.distance(Plane.between(a, b, 0), Plane.between(a, b, t))
           by Plane.between_zero
     = abs(t - 0) * Plane.distance(a, b) by Plane.between_distance
     = t * Plane.distance(a, b) by absOfParameter;
  done
}

theorem Plane.parameter_LessOrEqual_of_distance (a b : Plane.Point)
        (distinct : a ≠ b) (s t : ℝ) (sNonneg : s ≥ 0) (tNonneg : t ≥ 0)
        (closer : Plane.distance(a, Plane.between(a, b, s))
                      ≤ Plane.distance(a, Plane.between(a, b, t)))
        : s ≤ t := {
  Plane.distance(a, b) ≥ 0;
  Plane.distance(a, b) ≠ 0
      by { suppose Plane.distance(a, b) = 0 as vanishes;
           a = b by Plane.equal_of_distance_zero;
           done };
  Plane.distance(a, b) > 0;
  Plane.distance(a, b) * s
     = s * Plane.distance(a, b)
     = Plane.distance(a, Plane.between(a, b, s)) by Plane.distance_from_left
     ≤ Plane.distance(a, Plane.between(a, b, t))
     = t * Plane.distance(a, b) by Plane.distance_from_left
     = Plane.distance(a, b) * t;
  done by Real.LessOrEqual.multiply_cancel_left_positive
}

-- ----------------------------------------------------------------------
-- The interior of a segment, and how a cut at an interior point behaves.
--
-- Cutting a segment at a point strictly inside it is the move the polygonal
-- overlay is built from, so what it does to the interiors is Layer 0 work:
-- each half's interior lies inside the whole's. The ordering along the
-- segment never has to be mentioned — `Plane.distance_from_left` turns it
-- into a comparison of distances from the left endpoint.

definition Plane.openSegment (a b : Plane.Point) : Set(Plane.Point) :=
  Plane.segment(a, b)
      ∖ Set.singleton(Plane.Point, a)
      ∖ Set.singleton(Plane.Point, b)

theorem Plane.openSegment_subset (a b : Plane.Point)
        : Plane.openSegment(a, b) ⊆ Plane.segment(a, b) := {
  take x : Plane.Point;
  suppose x ∈ Plane.openSegment(a, b);
  done
}

theorem Plane.member_openSegment (a b x : Plane.Point)
        (onSegment : x ∈ Plane.segment(a, b))
        (notLeft : x ≠ a) (notRight : x ≠ b)
        : x ∈ Plane.openSegment(a, b) :=
  done

theorem Plane.openSegment_symmetric (a b : Plane.Point)
        : Plane.openSegment(a, b) = Plane.openSegment(b, a) := {
  Plane.segment(a, b) = Plane.segment(b, a) by Plane.segment_symmetric;
  Plane.openSegment(a, b) ⊆ Plane.openSegment(b, a)
      by { take x : Plane.Point;
           suppose x ∈ Plane.openSegment(a, b);
           x ∈ Plane.segment(a, b);
           x ∈ Plane.segment(b, a) by Set.member_of_equal;
           x ≠ a;
           x ≠ b;
           done };
  Plane.openSegment(b, a) ⊆ Plane.openSegment(a, b)
      by { take x : Plane.Point;
           suppose x ∈ Plane.openSegment(b, a);
           x ∈ Plane.segment(b, a);
           Plane.segment(b, a) = Plane.segment(a, b) by Plane.segment_symmetric;
           x ∈ Plane.segment(a, b) by Set.member_of_equal;
           x ≠ a;
           x ≠ b;
           done };
  done by Set.equal_of_same_members
}

-- No point of a segment is further from the left endpoint than the right
-- endpoint is.
theorem Plane.segment_distance_bound (a b x : Plane.Point)
        (onSegment : x ∈ Plane.segment(a, b))
        : Plane.distance(a, x) ≤ Plane.distance(a, b) := {
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.between(a, b, parameter)
      from onSegment;
  parameter ≥ 0;
  parameter ≤ 1;
  x = Plane.between(a, b, parameter) as atParameter;
  Plane.distance(a, b) ≥ 0;
  Real.IsNonneg(Plane.distance(a, b));
  Plane.distance(a, x)
     = Plane.distance(a, Plane.between(a, b, parameter)) by atParameter
     = parameter * Plane.distance(a, b) by Plane.distance_from_left
     ≤ 1 * Plane.distance(a, b)
     = Plane.distance(a, b);
  done
}

-- And a point strictly inside is strictly nearer.
theorem Plane.openSegment_nearer (a b : Plane.Point) (distinct : a ≠ b)
        (x : Plane.Point) (inOpen : x ∈ Plane.openSegment(a, b))
        : Plane.distance(a, x) < Plane.distance(a, b) := {
  x ∈ Plane.segment(a, b);
  x ≠ b;
  choose parameter such that
      (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.between(a, b, parameter)
      from (x ∈ Plane.segment(a, b));
  parameter ≥ 0;
  parameter ≤ 1;
  x = Plane.between(a, b, parameter) as atParameter;
  -- The parameter misses 1, because only `b` sits there.
  parameter ≠ 1
      by { suppose parameter = 1 as atFinish;
           Plane.between(a, b, parameter) = Plane.between(a, b, 1)
               by substituting atFinish;
           x = Plane.between(a, b, 1)
             = b;
           done };
  parameter < 1;
  Plane.distance(a, b) ≥ 0;
  Plane.distance(a, b) ≠ 0
      by { suppose Plane.distance(a, b) = 0 as vanishes;
           a = b by Plane.equal_of_distance_zero;
           done };
  Plane.distance(a, b) > 0;
  parameter * Plane.distance(a, b) < 1 * Plane.distance(a, b);
  Plane.distance(a, x)
     = Plane.distance(a, Plane.between(a, b, parameter)) by atParameter
     = parameter * Plane.distance(a, b) by Plane.distance_from_left
     < 1 * Plane.distance(a, b)
     = Plane.distance(a, b);
  done
}

-- Cutting at an interior point: the near half's interior lies inside the
-- whole segment's. The far half follows by reversing both segments.
theorem Plane.openSegment_left_inside (a b cut : Plane.Point) (distinct : a ≠ b)
        (interior : cut ∈ Plane.openSegment(a, b))
        : Plane.openSegment(a, cut) ⊆ Plane.openSegment(a, b) := {
  cut ∈ Plane.segment(a, b);
  Plane.distance(a, cut) < Plane.distance(a, b) by Plane.openSegment_nearer;
  Plane.IsConvex(Plane.segment(a, b)) by Plane.segment_IsConvex;
  a ∈ Plane.segment(a, b);
  Plane.segment(a, cut) ⊆ Plane.segment(a, b) by Plane.IsConvex.segment_inside;
  take x : Plane.Point;
  suppose x ∈ Plane.openSegment(a, cut);
  x ∈ Plane.segment(a, cut);
  x ≠ a;
  x ∈ Plane.segment(a, b);
  -- `b` is too far away to be on the near half.
  x ≠ b
      by { suppose x = b as isFarEnd;
           Plane.segment(a, cut) ⊆ Plane.segment(a, b);
           b ∈ Plane.segment(a, cut) by substituting isFarEnd;
           Plane.distance(a, b) ≤ Plane.distance(a, cut)
               by Plane.segment_distance_bound;
           Plane.distance(a, b) < Plane.distance(a, b);
           done };
  done by Plane.member_openSegment
}

theorem Plane.openSegment_right_inside (a b cut : Plane.Point) (distinct : a ≠ b)
        (interior : cut ∈ Plane.openSegment(a, b))
        : Plane.openSegment(cut, b) ⊆ Plane.openSegment(a, b) := {
  b ≠ a;
  Plane.openSegment(a, b) = Plane.openSegment(b, a) by Plane.openSegment_symmetric;
  cut ∈ Plane.openSegment(b, a) by Set.member_of_equal;
  Plane.openSegment(b, cut) ⊆ Plane.openSegment(b, a)
      by Plane.openSegment_left_inside;
  take x : Plane.Point;
  suppose x ∈ Plane.openSegment(cut, b);
  Plane.openSegment(cut, b) = Plane.openSegment(b, cut)
      by Plane.openSegment_symmetric;
  x ∈ Plane.openSegment(b, cut) by Set.member_of_equal;
  x ∈ Plane.openSegment(b, a);
  Plane.openSegment(b, a) = Plane.openSegment(a, b) by Plane.openSegment_symmetric;
  done by Set.member_of_equal
}

-- Walking part of the way to an interior point of a walk, and part of the
-- way onward from it. Both are `between_nested` with one endpoint pinned,
-- but they are proved in coordinates rather than derived from it: reaching
-- the nested form would mean rewriting `a` into `between(a, b, 0)`, a
-- replacement that contains the very term being replaced.

theorem Plane.between_nested_from_start (a b : Plane.Point) (u t : ℝ)
        : Plane.between(a, Plane.between(a, b, u), t) = Plane.between(a, b, t * u) := {
  Plane.Point.first(Plane.between(a, b, u))
      = Plane.Point.first(a) + u * (Plane.Point.first(b) - Plane.Point.first(a))
      by Plane.Point.first_between as firstAtCut;
  Plane.Point.second(Plane.between(a, b, u))
      = Plane.Point.second(a) + u * (Plane.Point.second(b) - Plane.Point.second(a))
      by Plane.Point.second_between as secondAtCut;
  Plane.Point.first(Plane.between(a, Plane.between(a, b, u), t))
     = Plane.Point.first(a)
           + t * (Plane.Point.first(Plane.between(a, b, u)) - Plane.Point.first(a))
           by Plane.Point.first_between
     = Plane.Point.first(a)
           + t * ((Plane.Point.first(a)
                     + u * (Plane.Point.first(b) - Plane.Point.first(a)))
                    - Plane.Point.first(a))
           by substituting firstAtCut
     = Plane.Point.first(a) + t * u * (Plane.Point.first(b) - Plane.Point.first(a)) by ring
     = Plane.Point.first(Plane.between(a, b, t * u)) by Plane.Point.first_between;
  Plane.Point.second(Plane.between(a, Plane.between(a, b, u), t))
     = Plane.Point.second(a)
           + t * (Plane.Point.second(Plane.between(a, b, u)) - Plane.Point.second(a))
           by Plane.Point.second_between
     = Plane.Point.second(a)
           + t * ((Plane.Point.second(a)
                     + u * (Plane.Point.second(b) - Plane.Point.second(a)))
                    - Plane.Point.second(a))
           by substituting secondAtCut
     = Plane.Point.second(a) + t * u * (Plane.Point.second(b) - Plane.Point.second(a)) by ring
     = Plane.Point.second(Plane.between(a, b, t * u)) by Plane.Point.second_between;
  done by Plane.Point.equal_of_coordinates
}

theorem Plane.between_nested_to_finish (a b : Plane.Point) (u t : ℝ)
        : Plane.between(Plane.between(a, b, u), b, t)
              = Plane.between(a, b, u + t * (1 - u)) := {
  Plane.Point.first(Plane.between(a, b, u))
      = Plane.Point.first(a) + u * (Plane.Point.first(b) - Plane.Point.first(a))
      by Plane.Point.first_between as firstAtCut;
  Plane.Point.second(Plane.between(a, b, u))
      = Plane.Point.second(a) + u * (Plane.Point.second(b) - Plane.Point.second(a))
      by Plane.Point.second_between as secondAtCut;
  Plane.Point.first(Plane.between(Plane.between(a, b, u), b, t))
     = Plane.Point.first(Plane.between(a, b, u))
           + t * (Plane.Point.first(b) - Plane.Point.first(Plane.between(a, b, u)))
           by Plane.Point.first_between
     = (Plane.Point.first(a) + u * (Plane.Point.first(b) - Plane.Point.first(a)))
           + t * (Plane.Point.first(b)
                    - (Plane.Point.first(a)
                         + u * (Plane.Point.first(b) - Plane.Point.first(a))))
           by substituting firstAtCut
     = Plane.Point.first(a)
           + (u + t * (1 - u)) * (Plane.Point.first(b) - Plane.Point.first(a)) by ring
     = Plane.Point.first(Plane.between(a, b, u + t * (1 - u)))
           by Plane.Point.first_between;
  Plane.Point.second(Plane.between(Plane.between(a, b, u), b, t))
     = Plane.Point.second(Plane.between(a, b, u))
           + t * (Plane.Point.second(b) - Plane.Point.second(Plane.between(a, b, u)))
           by Plane.Point.second_between
     = (Plane.Point.second(a) + u * (Plane.Point.second(b) - Plane.Point.second(a)))
           + t * (Plane.Point.second(b)
                    - (Plane.Point.second(a)
                         + u * (Plane.Point.second(b) - Plane.Point.second(a))))
           by substituting secondAtCut
     = Plane.Point.second(a)
           + (u + t * (1 - u)) * (Plane.Point.second(b) - Plane.Point.second(a)) by ring
     = Plane.Point.second(Plane.between(a, b, u + t * (1 - u)))
           by Plane.Point.second_between;
  done by Plane.Point.equal_of_coordinates
}

-- Cutting at an interior point loses nothing: the two halves cover the whole
-- segment. This is the fact that makes a subdivision preserve the point set,
-- and it is the converse half of `openSegment_left_inside` / `_right_inside`.
--
-- A point of the whole is on the near half or the far one according to
-- whether its parameter is below the cut's; the fraction along that half is
-- the parameter rescaled, which is where the two divisions come from.
theorem Plane.segment_split (a b cut : Plane.Point) (distinct : a ≠ b)
        (interior : cut ∈ Plane.openSegment(a, b))
        : Plane.segment(a, cut) ∪ Plane.segment(cut, b) = Plane.segment(a, b) := {
  cut ∈ Plane.segment(a, b) as cutOnWhole;
  cut ≠ a;
  cut ≠ b;
  a ∈ Plane.segment(a, b) by Plane.left_in_segment;
  b ∈ Plane.segment(a, b) by Plane.right_in_segment;
  Plane.IsConvex(Plane.segment(a, b)) by Plane.segment_IsConvex;
  Plane.segment(a, cut) ⊆ Plane.segment(a, b) by Plane.IsConvex.segment_inside;
  Plane.segment(cut, b) ⊆ Plane.segment(a, b) by Plane.IsConvex.segment_inside;
  Plane.segment(a, cut) ∪ Plane.segment(cut, b) ⊆ Plane.segment(a, b)
      by Set.union_subset;

  -- The cut's parameter is strictly inside, so both halves are nondegenerate.
  choose cutParameter such that
      (0 ≤ cutParameter ∧ cutParameter ≤ 1) ∧ cut = Plane.between(a, b, cutParameter)
      from cutOnWhole;
  0 ≤ cutParameter;
  cutParameter ≤ 1;
  cut = Plane.between(a, b, cutParameter) as cutAtParameter;
  cutParameter ≠ 0
      by { suppose cutParameter = 0 as atStart;
           cut = Plane.between(a, b, cutParameter)
               = Plane.between(a, b, 0) by substituting atStart
               = a by Plane.between_zero;
           done };
  cutParameter ≠ 1
      by { suppose cutParameter = 1 as atFinish;
           cut = Plane.between(a, b, cutParameter)
               = Plane.between(a, b, 1) by substituting atFinish
               = b by Plane.between_one;
           done };
  cutParameter > 0;
  cutParameter < 1;
  1 - cutParameter > 0;
  1 - cutParameter ≠ 0 as farGapNonzero;

  Plane.segment(a, b) ⊆ Plane.segment(a, cut) ∪ Plane.segment(cut, b)
      by { take x : Plane.Point;
           suppose x ∈ Plane.segment(a, b) as onWhole;
           choose parameter such that
               (0 ≤ parameter ∧ parameter ≤ 1) ∧ x = Plane.between(a, b, parameter)
               from onWhole;
           0 ≤ parameter;
           parameter ≤ 1;
           x = Plane.between(a, b, parameter) as atParameter;
           done by cases {
             case parameter ≤ cutParameter: {
                 -- On the near half, at the fraction `parameter / cutParameter`.
                 0 ≤ parameter / cutParameter by Real.divide_nonneg;
                 parameter / cutParameter ≤ cutParameter / cutParameter
                     by Real.LessOrEqual.divide_by_positive;
                 cutParameter / cutParameter = 1 by Real.divide_self;
                 parameter / cutParameter ≤ 1;
                 parameter / cutParameter * cutParameter = parameter
                     by field as nearWeights;
                 Plane.between(a, cut, parameter / cutParameter)
                    = Plane.between(a, Plane.between(a, b, cutParameter),
                          parameter / cutParameter) by cutAtParameter
                    = Plane.between(a, b, parameter / cutParameter * cutParameter)
                          by Plane.between_nested_from_start
                    = Plane.between(a, b, parameter) by nearWeights
                    = x by atParameter;
                 x ∈ Plane.segment(a, cut) by { witness parameter / cutParameter };
                 done
               }
             otherwise: {
                 -- On the far half, at `(parameter - cutParameter) / (1 - cutParameter)`.
                 cutParameter ≤ parameter by Real.not_LessOrEqual_implies;
                 0 ≤ parameter - cutParameter;
                 parameter - cutParameter ≤ 1 - cutParameter;
                 0 ≤ (parameter - cutParameter) / (1 - cutParameter)
                     by Real.divide_nonneg;
                 (parameter - cutParameter) / (1 - cutParameter)
                     ≤ (1 - cutParameter) / (1 - cutParameter)
                     by Real.LessOrEqual.divide_by_positive;
                 (1 - cutParameter) / (1 - cutParameter) = 1 by Real.divide_self;
                 (parameter - cutParameter) / (1 - cutParameter) ≤ 1;
                 cutParameter
                     + (parameter - cutParameter) / (1 - cutParameter) * (1 - cutParameter)
                     = parameter by field as farWeights;
                 Plane.between(cut, b, (parameter - cutParameter) / (1 - cutParameter))
                    = Plane.between(Plane.between(a, b, cutParameter), b,
                          (parameter - cutParameter) / (1 - cutParameter))
                          by cutAtParameter
                    = Plane.between(a, b,
                          cutParameter
                              + (parameter - cutParameter) / (1 - cutParameter)
                                  * (1 - cutParameter))
                          by Plane.between_nested_to_finish
                    = Plane.between(a, b, parameter) by farWeights
                    = x by atParameter;
                 x ∈ Plane.segment(cut, b)
                     by { witness (parameter - cutParameter) / (1 - cutParameter) };
                 done
               }
           } };
  done by Set.equal_of_same_members
}
