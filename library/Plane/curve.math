-- Plane/curve.math
--
-- Arcs and Jordan curves. Layer 4.
--
-- An arc is a continuous injective map on the unit segment. A Jordan curve
-- is the image of a LOOP — a continuous map on the same interval that
-- returns to where it started and is injective until it does — which is the
-- blueprint's definition and the one its proofs run on.
--
-- Arcs carry their parametrisation, as the blueprint does: it slides
-- between "the arc" and "the map" freely, and subarcs and concatenation are
-- painful set-first. A curve is a SET, because that is what the theorems
-- about it say ("ℝ² ∖ C has two regions"), with the loop recovered by
-- `choose` wherever a proof wants the parameters.

module Plane.curve

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.topology
import Plane.compact
import Plane.compactness
import Plane.connected
import Plane.model
import Plane.homeomorphism

-- ----------------------------------------------------------------------
-- Arcs.

definition Plane.IsArc (parametrisation : Plane.Point → Plane.Point)
        : Proposition :=
  Plane.ContinuousOn(parametrisation, Plane.unitSegment)
    ∧ Plane.InjectiveOn(parametrisation, Plane.unitSegment)

definition Plane.arc (parametrisation : Plane.Point → Plane.Point)
        : Set(Plane.Point) :=
  Plane.imageSet(parametrisation, Plane.unitSegment)

definition Plane.arcStart (parametrisation : Plane.Point → Plane.Point)
        : Plane.Point :=
  parametrisation(Plane.origin)

definition Plane.arcFinish (parametrisation : Plane.Point → Plane.Point)
        : Plane.Point :=
  parametrisation(Plane.Point.make(1, 0))

theorem Plane.arcStart_in_arc (parametrisation : Plane.Point → Plane.Point)
        : Plane.arcStart(parametrisation) ∈ Plane.arc(parametrisation) :=
  witness Plane.origin with {
    Plane.origin ∈ Plane.unitSegment by Plane.start_in_unitSegment;
    parametrisation(Plane.origin) = Plane.arcStart(parametrisation);
    done
  }

theorem Plane.arcFinish_in_arc (parametrisation : Plane.Point → Plane.Point)
        : Plane.arcFinish(parametrisation) ∈ Plane.arc(parametrisation) :=
  witness Plane.Point.make(1, 0) with {
    Plane.Point.make(1, 0) ∈ Plane.unitSegment
        by Plane.finish_in_unitSegment;
    parametrisation(Plane.Point.make(1, 0))
        = Plane.arcFinish(parametrisation);
    done
  }

theorem Plane.IsArc.IsCompact (parametrisation : Plane.Point → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.IsCompact(Plane.arc(parametrisation)) := {
  Plane.ContinuousOn(parametrisation, Plane.unitSegment);
  Plane.IsCompact(Plane.unitSegment) by Plane.unitSegment_IsCompact;
  done by Plane.IsCompact.image
}

theorem Plane.IsArc.IsConnected (parametrisation : Plane.Point → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.IsConnected(Plane.arc(parametrisation)) := {
  Plane.ContinuousOn(parametrisation, Plane.unitSegment);
  Plane.IsConnected(Plane.unitSegment) by Plane.unitSegment_IsConnected;
  done by Plane.IsConnected.image
}

-- An arc is a homeomorphic copy of the unit segment: the parametrisation
-- is a continuous injection on a compactum.
theorem Plane.IsArc.IsHomeomorphismOn
        (parametrisation : Plane.Point → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.IsHomeomorphismOn(parametrisation, Plane.unitSegment) := {
  Plane.ContinuousOn(parametrisation, Plane.unitSegment);
  Plane.InjectiveOn(parametrisation, Plane.unitSegment);
  Plane.IsCompact(Plane.unitSegment) by Plane.unitSegment_IsCompact;
  done by Plane.IsHomeomorphismOn.of_continuous_injective_on_compact
}

-- ----------------------------------------------------------------------
-- Jordan curves.
--
-- The blueprint's definition, and the one its proofs run on: a Jordan
-- curve is the image of a LOOP — a continuous map on the model interval
-- that returns to where it started and is injective until it does. A curve
-- is a SET, since that is what the theorems about it say ("ℝ² ∖ C has two
-- regions"), and the loop is recovered by `choose` wherever a proof wants
-- the parameters.
--
-- The parameters are the point of the loop presentation. Two points of the
-- curve pull back to two parameters, and the two arcs they determine are
-- the walk between them and the walk the other way round — which is a
-- subarc and a concatenation, both already built. Against the circle those
-- same two arcs need a traversal of the circle by an interval, and that is
-- the one thing the trigonometry-free setting does not hand over.
--
-- `Plane.IsJordanParametrisation` below keeps the circle-side statement,
-- which is still true and still proved: a continuous injection on the
-- circle is a homeomorphism onto its image. What is NOT yet built is the
-- bridge between the two presentations — that a loop induces such a
-- parametrisation — because it needs exactly that traversal. See
-- PLAN_JORDAN_SCHOENFLIES.md.

definition Plane.IsLoop (loop : Plane.Point → Plane.Point) : Proposition :=
  Plane.ContinuousOn(loop, Plane.unitSegment)
    ∧ loop(Plane.origin) = loop(Plane.Point.make(1, 0))
    ∧ Plane.InjectiveOn(
          loop,
          Plane.unitSegment ∖ Set.singleton(Plane.Point, Plane.Point.make(1, 0)))

definition Plane.IsJordanCurve (curve : Set(Plane.Point)) : Proposition :=
  ∃ (loop : Plane.Point → Plane.Point).
    Plane.IsLoop(loop) ∧ Plane.imageSet(loop, Plane.unitSegment) = curve

-- The model interval does not close up: its two ends are different points.
theorem Plane.start_not_finish : Plane.origin ≠ Plane.Point.make(1, 0) :=
  (closedUp : Plane.origin = Plane.Point.make(1, 0)) ↦ {
    Plane.Point.first(Plane.origin) = Plane.Point.first(Plane.Point.make(1, 0)) by substituting closedUp;
    (0 : ℝ) = 1;
    (0 : ℝ) ≠ 1;
    done
  }

-- A loop is injective off its finish, so two parameters short of the end
-- that carry the same point are the same parameter. The membership side
-- of `∖` is what every use would otherwise spell out.
theorem Plane.IsLoop.injective_before_finish (loop : Plane.Point → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (u v : Plane.Point) (uOnSegment : u ∈ Plane.unitSegment) (vOnSegment : v ∈ Plane.unitSegment)
        (uBeforeFinish : u ≠ Plane.Point.make(1, 0)) (vBeforeFinish : v ≠ Plane.Point.make(1, 0))
        (samePoint : loop(u) = loop(v))
        : u = v := {
  Plane.InjectiveOn(loop, Plane.unitSegment ∖ Set.singleton(Plane.Point, Plane.Point.make(1, 0))) as injective;
  ¬(u ∈ Set.singleton(Plane.Point, Plane.Point.make(1, 0)));
  ¬(v ∈ Set.singleton(Plane.Point, Plane.Point.make(1, 0)));
  u ∈ Plane.unitSegment ∖ Set.singleton(Plane.Point, Plane.Point.make(1, 0));
  v ∈ Plane.unitSegment ∖ Set.singleton(Plane.Point, Plane.Point.make(1, 0));
  done by injective
}

-- Every point of the curve is reached before the finish: a parameter that
-- lands on the finish can be replaced by the start, which the loop carries
-- to the same point. This is the only use the closing condition gets, and
-- it is what lets the two arcs below be cut at honest interior parameters.
theorem Plane.IsLoop.parameter_before_finish (loop : Plane.Point → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (p : Plane.Point) (onCurve : p ∈ Plane.imageSet(loop, Plane.unitSegment))
        : ∃ (s : Plane.Point). (s ∈ Plane.unitSegment ∧ s ≠ Plane.Point.make(1, 0)) ∧ loop(s) = p := {
  choose parameter such that parameter ∈ Plane.unitSegment ∧ loop(parameter) = p from onCurve;
  parameter ∈ Plane.unitSegment;
  loop(parameter) = p as carriesToP;
  loop(Plane.origin) = loop(Plane.Point.make(1, 0)) as closesUp;
  done by cases {
    case parameter = Plane.Point.make(1, 0) as atFinish: {
        Plane.origin ∈ Plane.unitSegment by Plane.start_in_unitSegment;
        Plane.origin ≠ Plane.Point.make(1, 0) by Plane.start_not_finish;
        loop(Plane.origin) = loop(parameter) by substituting atFinish;
        loop(Plane.origin) = p by carriesToP;
        done by { witness Plane.origin with done }
      }
    otherwise as beforeFinish: {
        done by { witness parameter with done }
      }
  }
}

theorem Plane.IsJordanCurve.IsCompact (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Plane.IsCompact(curve) := {
  choose loop such that
      Plane.IsLoop(loop) ∧ Plane.imageSet(loop, Plane.unitSegment) = curve
      from isCurve;
  Plane.imageSet(loop, Plane.unitSegment) = curve as carriesOnto;
  Plane.IsLoop(loop);
  Plane.ContinuousOn(loop, Plane.unitSegment);
  Plane.IsCompact(Plane.unitSegment) by Plane.unitSegment_IsCompact;
  Plane.IsCompact(Plane.imageSet(loop, Plane.unitSegment))
      by Plane.IsCompact.image;
  done by substituting carriesOnto
}

theorem Plane.IsJordanCurve.IsConnected (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Plane.IsConnected(curve) := {
  choose loop such that
      Plane.IsLoop(loop) ∧ Plane.imageSet(loop, Plane.unitSegment) = curve
      from isCurve;
  Plane.imageSet(loop, Plane.unitSegment) = curve as carriesOnto;
  Plane.IsLoop(loop);
  Plane.ContinuousOn(loop, Plane.unitSegment);
  Plane.IsConnected(Plane.unitSegment) by Plane.unitSegment_IsConnected;
  Plane.IsConnected(Plane.imageSet(loop, Plane.unitSegment))
      by Plane.IsConnected.image;
  done by substituting carriesOnto
}

theorem Plane.IsJordanCurve.IsNonempty (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Set.IsNonempty(Plane.Point, curve) := {
  choose loop such that
      Plane.IsLoop(loop) ∧ Plane.imageSet(loop, Plane.unitSegment) = curve
      from isCurve;
  Plane.imageSet(loop, Plane.unitSegment) = curve as carriesOnto;
  Plane.origin ∈ Plane.unitSegment by Plane.start_in_unitSegment;
  loop(Plane.origin) ∈ Plane.imageSet(loop, Plane.unitSegment)
      by { witness Plane.origin with done };
  loop(Plane.origin) ∈ curve by substituting carriesOnto;
  done by { witness loop(Plane.origin) with done }
}

-- ----------------------------------------------------------------------
-- The circle side, unchanged and still proved: a continuous injection on
-- the circle is a homeomorphism onto its image. This is H4's engine
-- applied to the model curve; what it does NOT say, until the traversal
-- exists, is that a loop induces such a parametrisation.

definition Plane.IsJordanParametrisation
        (parametrisation : Plane.Point → Plane.Point) : Proposition :=
  Plane.ContinuousOn(parametrisation, Plane.circle)
    ∧ Plane.InjectiveOn(parametrisation, Plane.circle)

theorem Plane.IsJordanParametrisation.IsHomeomorphismOn
        (parametrisation : Plane.Point → Plane.Point)
        (isParametrisation : Plane.IsJordanParametrisation(parametrisation))
        : Plane.IsHomeomorphismOn(parametrisation, Plane.circle) := {
  Plane.ContinuousOn(parametrisation, Plane.circle);
  Plane.InjectiveOn(parametrisation, Plane.circle);
  Plane.IsCompact(Plane.circle) by Plane.circle_IsCompact;
  done by Plane.IsHomeomorphismOn.of_continuous_injective_on_compact
}
