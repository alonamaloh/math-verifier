-- Plane/curve.math
--
-- Arcs and Jordan curves. Layer 4.
--
-- An arc is a continuous injective map on the unit interval. A Jordan
-- curve is the image of a LOOP — a continuous map on the same interval
-- that returns to where it started and is injective until it does — which
-- is the blueprint's definition and the one its proofs run on.
--
-- The interval is `Real.unitInterval`, a set of REALS, and a
-- parametrisation is `γ : ℝ → Plane.Point`. That is what a mathematician
-- writes, and it is available because the topology of `Metric/` is
-- developed over a metric space with separate source and target: the
-- continuity of `γ` is the same `ContinuousOn` as the continuity of a
-- plane-to-plane map, read at two instances instead of one.
--
-- Arcs carry their parametrisation, as the blueprint does: it slides
-- between "the arc" and "the map" freely, and subarcs and concatenation
-- are painful set-first. A curve is a SET, because that is what the
-- theorems about it say ("ℝ² ∖ C has two regions"), with the loop
-- recovered by `choose` wherever a proof wants the parameters.

module Plane.curve

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Metric.space
import Metric.real
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness
import Metric.connected
import Metric.homeomorphism
import Metric.interval
import Plane.vector
import Plane.point
import Plane.norm
import Plane.metric
import Plane.segment
import Plane.topology
import Plane.compact
import Plane.compactness
import Plane.connected
import Plane.model
import Plane.homeomorphism

-- ----------------------------------------------------------------------
-- Arcs.

definition Plane.IsArc (parametrisation : ℝ → Plane.Point) : Proposition :=
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval)
    ∧ MetricSpace.InjectiveOn(parametrisation, Real.unitInterval)

definition Plane.arc (parametrisation : ℝ → Plane.Point) : Set(Plane.Point) :=
  MetricSpace.imageSet(parametrisation, Real.unitInterval)

definition Plane.arcStart (parametrisation : ℝ → Plane.Point) : Plane.Point :=
  parametrisation(0)

definition Plane.arcFinish (parametrisation : ℝ → Plane.Point) : Plane.Point :=
  parametrisation(1)

theorem Plane.arcStart_in_arc (parametrisation : ℝ → Plane.Point)
        : Plane.arcStart(parametrisation) ∈ Plane.arc(parametrisation) :=
  witness (0 : ℝ) with {
    (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
    parametrisation(0) = Plane.arcStart(parametrisation);
    done
  }

theorem Plane.arcFinish_in_arc (parametrisation : ℝ → Plane.Point)
        : Plane.arcFinish(parametrisation) ∈ Plane.arc(parametrisation) :=
  witness (1 : ℝ) with {
    (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
    parametrisation(1) = Plane.arcFinish(parametrisation);
    done
  }

-- A parameter of the interval carries its value onto the arc. This is what
-- every "the point is on the arc" step says, and naming it keeps the two
-- halves of the membership off the page.
theorem Plane.member_arc (parametrisation : ℝ → Plane.Point)
        (t : ℝ) (inside : t ∈ Real.unitInterval)
        (value : Plane.Point) (carries : parametrisation(t) = value)
        : value ∈ Plane.arc(parametrisation) :=
  witness t

theorem Plane.IsArc.IsCompact (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.IsCompact(Plane.arc(parametrisation)) := {
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval);
  MetricSpace.IsCompact(Real.unitInterval) by Real.unitInterval_IsCompact;
  done by MetricSpace.IsCompact.image
}

theorem Plane.IsArc.IsConnected (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.IsConnected(Plane.arc(parametrisation)) := {
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval);
  MetricSpace.IsConnected(Real.unitInterval) by Real.unitInterval_IsConnected;
  done by MetricSpace.IsConnected.image
}

-- An arc is a homeomorphic copy of the unit interval: the parametrisation
-- is a continuous injection on a compactum.
theorem Plane.IsArc.IsHomeomorphismOn (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : MetricSpace.IsHomeomorphismOn(parametrisation, Real.unitInterval) := {
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval);
  MetricSpace.InjectiveOn(parametrisation, Real.unitInterval);
  MetricSpace.IsCompact(Real.unitInterval) by Real.unitInterval_IsCompact;
  done by MetricSpace.IsHomeomorphismOn.of_continuous_injective_on_compact
}

-- ----------------------------------------------------------------------
-- Jordan curves.
--
-- The blueprint's definition, and the one its proofs run on: a Jordan
-- curve is the image of a LOOP — a continuous map on the unit interval
-- that returns to where it started and is injective until it does. A curve
-- is a SET, since that is what the theorems about it say ("ℝ² ∖ C has two
-- regions"), and the loop is recovered by `choose` wherever a proof wants
-- the parameters.
--
-- The parameters are the point of the loop presentation. Two points of the
-- curve pull back to two parameters, and the two arcs they determine are
-- the walk between them and the walk the other way round — which is a
-- subarc and a concatenation, both already built. Against the circle those
-- same two arcs need a traversal of the circle by an interval, and that is
-- the one thing the trigonometry-free setting does not hand over.
--
-- `Plane.IsJordanParametrisation` below keeps the circle-side statement,
-- which is still true and still proved: a continuous injection on the
-- circle is a homeomorphism onto its image. What is NOT yet built is the
-- bridge between the two presentations — that a loop induces such a
-- parametrisation — because it needs exactly that traversal. See
-- PLAN_JORDAN_SCHOENFLIES.md.

definition Plane.IsLoop (loop : ℝ → Plane.Point) : Proposition :=
  MetricSpace.ContinuousOn(loop, Real.unitInterval)
    ∧ loop(0) = loop(1)
    ∧ MetricSpace.InjectiveOn(
          loop, Real.unitInterval ∖ Set.singleton(ℝ, 1))

definition Plane.IsJordanCurve (curve : Set(Plane.Point)) : Proposition :=
  ∃ (loop : ℝ → Plane.Point).
    Plane.IsLoop(loop) ∧ MetricSpace.imageSet(loop, Real.unitInterval) = curve

-- A loop is injective off its finish, so two parameters short of the end
-- that carry the same point are the same parameter. The membership side
-- of `∖` is what every use would otherwise spell out.
theorem Plane.IsLoop.injective_before_finish (loop : ℝ → Plane.Point)
        (isLoop : Plane.IsLoop(loop))
        (u v : ℝ) (uInside : u ∈ Real.unitInterval) (vInside : v ∈ Real.unitInterval)
        (uBeforeFinish : u ≠ 1) (vBeforeFinish : v ≠ 1)
        (samePoint : loop(u) = loop(v))
        : u = v := {
  MetricSpace.InjectiveOn(loop, Real.unitInterval ∖ Set.singleton(ℝ, 1))
      as injective;
  ¬(u ∈ Set.singleton(ℝ, 1));
  ¬(v ∈ Set.singleton(ℝ, 1));
  u ∈ Real.unitInterval ∖ Set.singleton(ℝ, 1);
  v ∈ Real.unitInterval ∖ Set.singleton(ℝ, 1);
  done by injective
}

-- Every point of the curve is reached before the finish: a parameter that
-- lands on the finish can be replaced by the start, which the loop carries
-- to the same point. This is the only use the closing condition gets, and
-- it is what lets the two arcs below be cut at honest interior parameters.
theorem Plane.IsLoop.parameter_before_finish (loop : ℝ → Plane.Point)
        (isLoop : Plane.IsLoop(loop))
        (p : Plane.Point)
        (onCurve : p ∈ MetricSpace.imageSet(loop, Real.unitInterval))
        : ∃ (s : ℝ). (s ∈ Real.unitInterval ∧ s ≠ 1) ∧ loop(s) = p := {
  choose parameter : ℝ such that
      parameter ∈ Real.unitInterval ∧ loop(parameter) = p from onCurve;
  parameter ∈ Real.unitInterval;
  loop(parameter) = p as carriesToP;
  loop(0) = loop(1);
  done by cases {
    case parameter = 1 as atFinish: {
        (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
        (0 : ℝ) ≠ 1;
        loop(0) = loop(parameter) by substituting atFinish;
        loop(0) = p by carriesToP;
        done by { witness (0 : ℝ) }
      }
    otherwise as beforeFinish: {
        done by { witness parameter }
      }
  }
}

theorem Plane.IsJordanCurve.IsCompact (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Plane.IsCompact(curve) := {
  choose loop such that
      Plane.IsLoop(loop)
      ∧ MetricSpace.imageSet(loop, Real.unitInterval) = curve
      from isCurve;
  MetricSpace.imageSet(loop, Real.unitInterval) = curve as carriesOnto;
  Plane.IsLoop(loop);
  MetricSpace.ContinuousOn(loop, Real.unitInterval);
  MetricSpace.IsCompact(Real.unitInterval) by Real.unitInterval_IsCompact;
  MetricSpace.IsCompact(MetricSpace.imageSet(loop, Real.unitInterval))
      by MetricSpace.IsCompact.image;
  done by substituting carriesOnto
}

theorem Plane.IsJordanCurve.IsConnected (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Plane.IsConnected(curve) := {
  choose loop such that
      Plane.IsLoop(loop)
      ∧ MetricSpace.imageSet(loop, Real.unitInterval) = curve
      from isCurve;
  MetricSpace.imageSet(loop, Real.unitInterval) = curve as carriesOnto;
  Plane.IsLoop(loop);
  MetricSpace.ContinuousOn(loop, Real.unitInterval);
  MetricSpace.IsConnected(Real.unitInterval) by Real.unitInterval_IsConnected;
  MetricSpace.IsConnected(MetricSpace.imageSet(loop, Real.unitInterval))
      by MetricSpace.IsConnected.image;
  done by substituting carriesOnto
}

theorem Plane.IsJordanCurve.IsNonempty (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        : Set.IsNonempty(Plane.Point, curve) := {
  choose loop such that
      Plane.IsLoop(loop)
      ∧ MetricSpace.imageSet(loop, Real.unitInterval) = curve
      from isCurve;
  MetricSpace.imageSet(loop, Real.unitInterval) = curve as carriesOnto;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  loop(0) ∈ MetricSpace.imageSet(loop, Real.unitInterval)
      by { witness (0 : ℝ) };
  loop(0) ∈ curve by substituting carriesOnto;
  done by { witness loop(0) }
}

-- ----------------------------------------------------------------------
-- The circle side, unchanged and still proved: a continuous injection on
-- the circle is a homeomorphism onto its image. This is H4's engine
-- applied to the model curve; what it does NOT say, until the traversal
-- exists, is that a loop induces such a parametrisation.

definition Plane.IsJordanParametrisation
        (parametrisation : Plane.Point → Plane.Point) : Proposition :=
  Plane.ContinuousOn(parametrisation, Plane.circle)
    ∧ Plane.InjectiveOn(parametrisation, Plane.circle)

theorem Plane.IsJordanParametrisation.IsHomeomorphismOn
        (parametrisation : Plane.Point → Plane.Point)
        (isParametrisation : Plane.IsJordanParametrisation(parametrisation))
        : Plane.IsHomeomorphismOn(parametrisation, Plane.circle) := {
  Plane.ContinuousOn(parametrisation, Plane.circle);
  Plane.InjectiveOn(parametrisation, Plane.circle);
  Plane.IsCompact(Plane.circle) by Plane.circle_IsCompact;
  done by Plane.IsHomeomorphismOn.of_continuous_injective_on_compact
}
