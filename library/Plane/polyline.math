-- Plane/polyline.math
--
-- Polygonal arcs, built from a vertex list. Layer 4.
--
-- The blueprint defines a polygonal arc set-level — "a finite union of line
-- segments" — and then every proof that uses one *subdivides* it: at
-- intersections, at the endpoints of overlapping intervals, deleting
-- duplicates, handing the result to a graph. That work is list work, so the
-- vertices are built in rather than existentially recovered:
-- `Plane.polyline` constructs the parametrisation from the list, and
-- `Plane.IsPolygonal` is the blueprint's set-level predicate, bridged to it
-- by `Plane.arc_polyline`.
--
-- A single leg needs no construction at all: `Plane.between(a, b)` is
-- already a map on the parameter interval, and `Plane/subarc.math` shows it
-- is an arc with the right image and endpoints.
--
-- The recursion carries the walk's current position as an accumulator, so
-- it needs neither a two-element pattern nor a fold over consecutive pairs.
--
-- The parametrisation is NOT constant speed: each remaining tail gets half
-- of what is left of the unit interval. Nothing in Part I needs constant
-- speed — only the image and the order along it — and building it in would
-- put the vertex count into the retiming coefficients.

module Plane.polyline

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Lists.list
import Real.interface
import Real.order
import Metric.space
import Metric.real
import Metric.topology
import Metric.compactness
import Metric.interval
import Plane.vector
import Plane.point
import Plane.norm
import Plane.metric
import Plane.segment
import Plane.topology
import Plane.compactness
import Plane.connected
import Plane.separation
import Plane.model
import Plane.homeomorphism
import Plane.curve
import Plane.subarc
import Plane.concatenate

-- ----------------------------------------------------------------------
-- The chain of a vertex list, and the polyline that traverses it.

-- The walk's current position is threaded through the RETURN TYPE, not as
-- a parameter that the recursive call changes. A definition whose fixed
-- parameter varies elaborates but its recursion equation never fires, so
-- `chainFrom(a, b :: rest)` would not reduce; recursing into a function of
-- the start keeps the shape plain and the equation definitional.
definition Plane.chainFunction
        : List(Plane.Point) → (Plane.Point → Set(Plane.Point))
  | List.empty => (start : Plane.Point) ↦ Set.singleton(Plane.Point, start)
  | List.prepend(next, rest) =>
      (start : Plane.Point) ↦
          Plane.segment(start, next) ∪ Plane.chainFunction(rest)(next)

definition Plane.chainFrom (start : Plane.Point)
        (vertices : List(Plane.Point)) : Set(Plane.Point) :=
  Plane.chainFunction(vertices)(start)

definition Plane.polylineFunction
        : List(Plane.Point) → (Plane.Point → (ℝ → Plane.Point))
  | List.empty => (start : Plane.Point) ↦ ((t : ℝ) ↦ start)
  | List.prepend(next, rest) =>
      (start : Plane.Point) ↦
          Plane.concatenate(
              Plane.between(start, next), Plane.polylineFunction(rest)(next))

definition Plane.polyline (start : Plane.Point)
        (vertices : List(Plane.Point)) : ℝ → Plane.Point :=
  Plane.polylineFunction(vertices)(start)

-- The blueprint's predicate: a finite union of segments, which is what a
-- chain is. Stated on the SET, so a theorem about a polygonal arc never has
-- to transport along an equality of parametrisations.
definition Plane.IsPolygonal (region : Set(Plane.Point)) : Proposition :=
  ∃ (start : Plane.Point). ∃ (vertices : List(Plane.Point)).
    region = Plane.chainFrom(start, vertices)

-- ----------------------------------------------------------------------
-- The bridge: what a polyline covers is the chain of its vertices.

-- Both facts are proved with the START GENERALISED: the recursion moves the
-- accumulator, so an induction that fixes it gets a hypothesis about the
-- wrong walk.

theorem Plane.polyline_arcStart (vertices : List(Plane.Point))
        : ∀ (start : Plane.Point).
            Plane.arcStart(Plane.polyline(start, vertices)) = start :=
  by induction on vertices {
    case List.empty: (start : Plane.Point) ↦ reflexivity(Plane.Point, start)
    case List.prepend(next, rest): (start : Plane.Point) ↦ {
        Plane.arcStart(
            Plane.polyline(start, List.prepend(Plane.Point, next, rest)))
           = Plane.arcStart(
                 Plane.concatenate(
                     Plane.between(start, next), Plane.polyline(next, rest)))
           = Plane.arcStart(Plane.between(start, next))
                 by Plane.concatenate_start
           = start by Plane.between_arcStart;
        done
      }
  }

theorem Plane.arc_polyline (vertices : List(Plane.Point))
        : ∀ (start : Plane.Point).
            Plane.arc(Plane.polyline(start, vertices))
                = Plane.chainFrom(start, vertices) :=
  by induction on vertices with tailCovers {
    case List.empty: (start : Plane.Point) ↦ {
        -- The degenerate polyline stands still, so its arc is the one point.
        Plane.arc((t : ℝ) ↦ start) ⊆ Set.singleton(Plane.Point, start)
            by { take y : Plane.Point;
                 suppose y ∈ Plane.arc((t : ℝ) ↦ start) as onArc;
                 choose source : ℝ such that
                     source ∈ Real.unitInterval ∧ start = y from onArc;
                 start = y;
                 y = start;
                 done };
        Set.singleton(Plane.Point, start) ⊆ Plane.arc((t : ℝ) ↦ start)
            by { take y : Plane.Point;
                 suppose y ∈ Set.singleton(Plane.Point, start);
                 y = start;
                 (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
                 start = y;
                 done by { witness (0 : ℝ) } };
        done by Set.equal_of_same_members
      }
    case List.prepend(next, rest): (start : Plane.Point) ↦ {
        Plane.arc(Plane.polyline(next, rest)) = Plane.chainFrom(next, rest)
            by tailCovers;
        Plane.arcFinish(Plane.between(start, next)) = next
            by Plane.between_arcFinish;
        Plane.arcStart(Plane.polyline(next, rest)) = next
            by Plane.polyline_arcStart;
        Plane.arcFinish(Plane.between(start, next))
            = Plane.arcStart(Plane.polyline(next, rest));
        Plane.arc(Plane.polyline(start, List.prepend(Plane.Point, next, rest)))
           = Plane.arc(
                 Plane.concatenate(
                     Plane.between(start, next), Plane.polyline(next, rest)))
           = Plane.arc(Plane.between(start, next))
                 ∪ Plane.arc(Plane.polyline(next, rest))
                 by Plane.arc_concatenate
           = Plane.segment(start, next)
                 ∪ Plane.arc(Plane.polyline(next, rest))
                 by Plane.arc_between
           = Plane.segment(start, next) ∪ Plane.chainFrom(next, rest)
                 by tailCovers;
        done
      }
  }

theorem Plane.IsPolygonal.of_polyline (start : Plane.Point)
        (vertices : List(Plane.Point))
        : Plane.IsPolygonal(Plane.arc(Plane.polyline(start, vertices))) := {
  Plane.arc(Plane.polyline(start, vertices))
      = Plane.chainFrom(start, vertices) by Plane.arc_polyline;
  done by { witness start with { witness vertices } }
}
