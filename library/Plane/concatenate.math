-- Plane/concatenate.math
--
-- Two arcs meeting only at an endpoint make one arc. Layer 4.
--
-- The glued map runs the first arc over the lower half of the unit
-- interval and the second over the upper half, each at double speed:
-- `t ↦ γ₁(2t)` below the midpoint and `t ↦ γ₂(2t - 1)` above it. That is
-- what a textbook writes, and now that the parameter is a real number it
-- is what the definition says.
--
-- The halves are the interval cut at `1/2`. They cover it because the
-- order is linear, and each is closed in it because a point on the far
-- side of the midpoint has its whole slack to spare. The doubling maps are
-- walks in the parameter — `t ↦ 2t` is the walk from 0 to 2 and
-- `t ↦ 2t - 1` the walk from -1 to 1 — so their continuity is the walk's.
--
-- Continuity is then the pasting lemma. Injectivity is the only place the
-- hypotheses about the two arcs are used: inside a half it is that arc's
-- injectivity, and across the halves it is the assumption that the arcs
-- meet only at the shared endpoint.

module Plane.concatenate

import Logic.basics
import Logic.exists
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.linearity
import Real.absolute_value
import Real.absolute_value_order
import Real.order_multiplication
import Metric.space
import Metric.real
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness
import Metric.connected
import Metric.homeomorphism
import Metric.interval
import Plane.vector
import Plane.point
import Plane.norm
import Plane.metric
import Plane.segment
import Plane.topology
import Plane.compactness
import Plane.connected
import Plane.separation
import Plane.model
import Plane.homeomorphism
import Plane.curve
import Plane.subarc

-- ----------------------------------------------------------------------
-- The two halves of the unit interval.

-- The midpoint, named once: `1/2` is a quotient, so the ground-arithmetic
-- tier does not decide comparisons against it.
theorem Plane.midpoint_positive : 1 / 2 > (0 : ℝ) :=
  done by Real.divide_positive

theorem Plane.midpoint_below_one : 1 / 2 < (1 : ℝ) := {
  1 / 2 > (0 : ℝ) by Plane.midpoint_positive;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  done by ordered_field
}

definition Plane.lowerHalf : Set(ℝ) :=
  (t : ℝ) ↦ t ∈ Real.unitInterval ∧ t ≤ 1 / 2

definition Plane.upperHalf : Set(ℝ) :=
  (t : ℝ) ↦ t ∈ Real.unitInterval ∧ t ≥ 1 / 2

theorem Plane.lowerHalf_inside : Plane.lowerHalf ⊆ Real.unitInterval := {
  take t : ℝ;
  suppose t ∈ Plane.lowerHalf;
  done
}

theorem Plane.upperHalf_inside : Plane.upperHalf ⊆ Real.unitInterval := {
  take t : ℝ;
  suppose t ∈ Plane.upperHalf;
  done
}

theorem Plane.halves_cover
        : Plane.lowerHalf ∪ Plane.upperHalf = Real.unitInterval := {
  Plane.lowerHalf ∪ Plane.upperHalf ⊆ Real.unitInterval
      by (t : ℝ) (inUnion : t ∈ Plane.lowerHalf ∪ Plane.upperHalf) ↦ {
        done by cases {
          case t ∈ Plane.lowerHalf as inLower: { t ∈ Real.unitInterval; done }
          case t ∈ Plane.upperHalf as inUpper: { t ∈ Real.unitInterval; done }
        }
      };
  Real.unitInterval ⊆ Plane.lowerHalf ∪ Plane.upperHalf
      by (t : ℝ) (inside : t ∈ Real.unitInterval) ↦ {
        t ≤ 1 / 2 ∨ t ≥ 1 / 2 by Real.LessOrEqual.linear;
        done by cases {
          case t ≤ 1 / 2 as low: { t ∈ Plane.lowerHalf; done }
          case t ≥ 1 / 2 as high: { t ∈ Plane.upperHalf; done }
        }
      };
  done by Set.equal_of_same_members
}

-- Each half is closed in the interval: a parameter on the far side of the
-- midpoint has its whole distance to the midpoint to spare.
theorem Plane.lowerHalf_ClosedIn
        : MetricSpace.ClosedIn(Plane.lowerHalf, Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval ∖ Plane.lowerHalf as outside;
  x ∈ Real.unitInterval;
  ¬(x ∈ Plane.lowerHalf);
  ¬(x ≤ 1 / 2) by { suppose x ≤ 1 / 2; x ∈ Plane.lowerHalf; done };
  x > 1 / 2 by Real.LessThan_of_not_LessOrEqual;
  x - 1 / 2 > 0;
  witness x - 1 / 2 with {
    x - 1 / 2 > 0;
    ∀ (y : ℝ). y ∈ Real.unitInterval →
        MetricSpace.distance(x, y) < x - 1 / 2 →
          y ∈ Real.unitInterval ∖ Plane.lowerHalf
        by (y : ℝ) (yInside : y ∈ Real.unitInterval)
           (near : MetricSpace.distance(x, y) < x - 1 / 2) ↦ {
          abs(y - x)
             = abs(x - y) by Real.absolute_value_subtract_swap
             = MetricSpace.distance(x, y)
             < x - 1 / 2;
          -(x - 1 / 2) < y - x by Real.absolute_value_LessThan_bounds;
          y > 1 / 2 by ordered_field;
          ¬(y ∈ Plane.lowerHalf)
              by { suppose y ∈ Plane.lowerHalf;
                   y ≤ 1 / 2;
                   done by Real.LessThan.irreflexive };
          done
        };
    done
  }
}

theorem Plane.upperHalf_ClosedIn
        : MetricSpace.ClosedIn(Plane.upperHalf, Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval ∖ Plane.upperHalf as outside;
  x ∈ Real.unitInterval;
  ¬(x ∈ Plane.upperHalf);
  ¬(x ≥ 1 / 2) by { suppose x ≥ 1 / 2; x ∈ Plane.upperHalf; done };
  x < 1 / 2 by Real.LessThan_of_not_LessOrEqual;
  1 / 2 - x > 0;
  witness 1 / 2 - x with {
    1 / 2 - x > 0;
    ∀ (y : ℝ). y ∈ Real.unitInterval →
        MetricSpace.distance(x, y) < 1 / 2 - x →
          y ∈ Real.unitInterval ∖ Plane.upperHalf
        by (y : ℝ) (yInside : y ∈ Real.unitInterval)
           (near : MetricSpace.distance(x, y) < 1 / 2 - x) ↦ {
          abs(y - x)
             = abs(x - y) by Real.absolute_value_subtract_swap
             = MetricSpace.distance(x, y)
             < 1 / 2 - x;
          y - x < 1 / 2 - x by Real.absolute_value_LessThan_bounds;
          y < 1 / 2 by ordered_field;
          ¬(y ∈ Plane.upperHalf)
              by { suppose y ∈ Plane.upperHalf;
                   y ≥ 1 / 2;
                   done by Real.LessThan.irreflexive };
          done
        };
    done
  }
}

-- ----------------------------------------------------------------------
-- The two retimings.
--
-- Doubling a parameter below the midpoint reaches at most one, and
-- doubling one above it and stepping back reaches at least nothing. Each
-- retiming is a walk in the parameter, so its continuity is the walk's.

theorem Plane.lowerHalf_lands (t : ℝ) (inLower : t ∈ Plane.lowerHalf)
        : 2 * t ∈ Real.unitInterval := {
  t ∈ Real.unitInterval;
  t ≥ 0 by Real.unitInterval_nonneg;
  t ≤ 1 / 2;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  2 * t ≥ 0 by ordered_field;
  2 * t ≤ 1 by ordered_field;
  done by Real.member_unitInterval
}

theorem Plane.upperHalf_lands (t : ℝ) (inUpper : t ∈ Plane.upperHalf)
        : 2 * t - 1 ∈ Real.unitInterval := {
  t ∈ Real.unitInterval;
  t ≤ 1 by Real.unitInterval_atMostOne;
  t ≥ 1 / 2;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  2 * t - 1 ≥ 0 by ordered_field;
  2 * t - 1 ≤ 1 by ordered_field;
  done by Real.member_unitInterval
}

theorem Plane.double_ContinuousOn (carrier : Set(ℝ))
        (inside : carrier ⊆ Real.unitInterval)
        : MetricSpace.ContinuousOn((t : ℝ) ↦ 2 * t, carrier) := {
  MetricSpace.ContinuousOn(Real.between(0, 2), Real.unitInterval)
      by Real.between_ContinuousOn;
  MetricSpace.ContinuousOn(Real.between(0, 2), carrier)
      by MetricSpace.ContinuousOn.restrict(larger := Real.unitInterval);
  ∀ (t : ℝ). t ∈ carrier → 2 * t = Real.between(0, 2, t)
      by { take t : ℝ;
           suppose t ∈ carrier;
           2 * t
              = 0 + t * (2 - 0) by ring
              = Real.between(0, 2, t);
           done };
  done by MetricSpace.ContinuousOn.of_agreeing(g := Real.between(0, 2))
}

theorem Plane.doubleBack_ContinuousOn (carrier : Set(ℝ))
        (inside : carrier ⊆ Real.unitInterval)
        : MetricSpace.ContinuousOn((t : ℝ) ↦ 2 * t - 1, carrier) := {
  MetricSpace.ContinuousOn(Real.between(-(1 : ℝ), 1), Real.unitInterval)
      by Real.between_ContinuousOn;
  MetricSpace.ContinuousOn(Real.between(-(1 : ℝ), 1), carrier)
      by MetricSpace.ContinuousOn.restrict(larger := Real.unitInterval);
  ∀ (t : ℝ). t ∈ carrier → 2 * t - 1 = Real.between(-(1 : ℝ), 1, t)
      by { take t : ℝ;
           suppose t ∈ carrier;
           2 * t - 1
              = -(1 : ℝ) + t * (1 - -(1 : ℝ)) by ring
              = Real.between(-(1 : ℝ), 1, t);
           done };
  done by MetricSpace.ContinuousOn.of_agreeing(g := Real.between(-(1 : ℝ), 1))
}

-- ----------------------------------------------------------------------
-- The concatenation.
--
-- Below the midpoint the first arc runs at double speed; above it, the
-- second. At the midpoint both branches are asked for, and they agree
-- exactly because the arcs share that endpoint — which is what makes the
-- glued map well defined and lets the pasting lemma close continuity.

definition Plane.concatenate
        (firstArc secondArc : ℝ → Plane.Point) : ℝ → Plane.Point :=
  (t : ℝ) ↦
    if t ≤ 1 / 2
    then firstArc(2 * t)
    else secondArc(2 * t - 1)

theorem Plane.concatenate_on_lowerHalf
        (firstArc secondArc : ℝ → Plane.Point) (t : ℝ)
        (inLower : t ∈ Plane.lowerHalf)
        : Plane.concatenate(firstArc, secondArc)(t) = firstArc(2 * t) := {
  t ≤ 1 / 2;
  done by Logic.if_positive
}

theorem Plane.concatenate_on_upperHalf
        (firstArc secondArc : ℝ → Plane.Point) (t : ℝ)
        (inUpper : t ∈ Plane.upperHalf)
        (aboveMidpoint : ¬(t ≤ 1 / 2))
        : Plane.concatenate(firstArc, secondArc)(t) = secondArc(2 * t - 1) :=
  done by Logic.if_negative

theorem Plane.concatenate_start (firstArc secondArc : ℝ → Plane.Point)
        : Plane.arcStart(Plane.concatenate(firstArc, secondArc))
              = Plane.arcStart(firstArc) := {
  1 / 2 > (0 : ℝ) by Plane.midpoint_positive;
  (0 : ℝ) ≤ 1 / 2 by Real.LessThan.weaken;
  (2 : ℝ) * 0 = 0 by ring as doubledStart;
  Plane.concatenate(firstArc, secondArc)(0)
     = firstArc(2 * 0) by Logic.if_positive
     = firstArc(0) by substituting doubledStart;
  done
}

theorem Plane.concatenate_finish (firstArc secondArc : ℝ → Plane.Point)
        : Plane.arcFinish(Plane.concatenate(firstArc, secondArc))
              = Plane.arcFinish(secondArc) := {
  ¬((1 : ℝ) ≤ 1 / 2)
      by { suppose (1 : ℝ) ≤ 1 / 2;
           (1 : ℝ) ≤ 1 / 2
                   < 1 by Plane.midpoint_below_one;
           done };
  (2 : ℝ) * 1 - 1 = 1 by ring as doubledFinish;
  Plane.concatenate(firstArc, secondArc)(1)
     = secondArc(2 * 1 - 1) by Logic.if_negative
     = secondArc(1) by substituting doubledFinish;
  done
}

-- On the upper half the glued map IS the second arc, retimed — including
-- at the midpoint, where the `if` still takes the first branch. There the
-- two branches agree, and only because the arcs share that endpoint: this
-- is what makes the glued map well defined rather than merely continuous.
theorem Plane.concatenate_value_on_upperHalf
        (firstArc secondArc : ℝ → Plane.Point)
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (t : ℝ) (inUpper : t ∈ Plane.upperHalf)
        : Plane.concatenate(firstArc, secondArc)(t)
              = secondArc(2 * t - 1) :=
  done by cases {
    case t ≤ 1 / 2 as atMidpoint: {
        -- The only such parameter is the midpoint: there the first arc
        -- finishes where the second starts.
        t ≥ 1 / 2;
        t = 1 / 2 by Real.LessOrEqual.antisymmetric as isMidpoint;
        (2 : ℝ) ≠ 0;
        (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
        2 * t
           = (2 : ℝ) * (1 / 2) by substituting isMidpoint
           = 1 by halfDoubles
           as reachesOne;
        2 * t - 1 = 0 by linear_combination(reachesOne) as reachesZero;
        Plane.concatenate(firstArc, secondArc)(t)
           = firstArc(2 * t) by Logic.if_positive
           = firstArc(1) by substituting reachesOne
           = secondArc(0) by sharedEndpoint
           = secondArc(2 * t - 1) by substituting reachesZero;
        done
      }
    otherwise as aboveMidpoint: {
        done by Plane.concatenate_on_upperHalf
      }
  }

-- ----------------------------------------------------------------------
-- Continuity: each half carries a composition, and the halves are closed.

theorem Plane.concatenate_ContinuousOn
        (firstArc secondArc : ℝ → Plane.Point)
        (firstContinuous
            : MetricSpace.ContinuousOn(firstArc, Real.unitInterval))
        (secondContinuous
            : MetricSpace.ContinuousOn(secondArc, Real.unitInterval))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        : MetricSpace.ContinuousOn(
              Plane.concatenate(firstArc, secondArc), Real.unitInterval) := {
  Plane.lowerHalf ⊆ Real.unitInterval by Plane.lowerHalf_inside;
  Plane.upperHalf ⊆ Real.unitInterval by Plane.upperHalf_inside;

  -- On the lower half the glued map IS the first arc, doubled.
  ∀ (t : ℝ). t ∈ Plane.lowerHalf → 2 * t ∈ Real.unitInterval
      by { take t : ℝ;
           suppose t ∈ Plane.lowerHalf;
           done by Plane.lowerHalf_lands };
  MetricSpace.ContinuousOn((t : ℝ) ↦ 2 * t, Plane.lowerHalf)
      by Plane.double_ContinuousOn;
  MetricSpace.ContinuousOn((t : ℝ) ↦ firstArc(2 * t), Plane.lowerHalf)
      by MetricSpace.ContinuousOn.compose(
          inner := (t : ℝ) ↦ 2 * t, outer := firstArc,
          region := Real.unitInterval);
  ∀ (t : ℝ). t ∈ Plane.lowerHalf →
      Plane.concatenate(firstArc, secondArc)(t) = firstArc(2 * t)
      by { take t : ℝ;
           suppose t ∈ Plane.lowerHalf;
           done by Plane.concatenate_on_lowerHalf };
  MetricSpace.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Plane.lowerHalf)
      by MetricSpace.ContinuousOn.of_agreeing(
          g := (t : ℝ) ↦ firstArc(2 * t));

  -- On the upper half it is the second arc, doubled and stepped back —
  -- including at the midpoint, where the `if` still takes the first branch
  -- but the two arcs agree because they share that endpoint.
  ∀ (t : ℝ). t ∈ Plane.upperHalf → 2 * t - 1 ∈ Real.unitInterval
      by { take t : ℝ;
           suppose t ∈ Plane.upperHalf;
           done by Plane.upperHalf_lands };
  MetricSpace.ContinuousOn((t : ℝ) ↦ 2 * t - 1, Plane.upperHalf)
      by Plane.doubleBack_ContinuousOn;
  MetricSpace.ContinuousOn((t : ℝ) ↦ secondArc(2 * t - 1), Plane.upperHalf)
      by MetricSpace.ContinuousOn.compose(
          inner := (t : ℝ) ↦ 2 * t - 1, outer := secondArc,
          region := Real.unitInterval);
  ∀ (t : ℝ). t ∈ Plane.upperHalf →
      Plane.concatenate(firstArc, secondArc)(t) = secondArc(2 * t - 1)
      by { take t : ℝ;
           suppose t ∈ Plane.upperHalf;
           done by Plane.concatenate_value_on_upperHalf };
  MetricSpace.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Plane.upperHalf)
      by MetricSpace.ContinuousOn.of_agreeing(
          g := (t : ℝ) ↦ secondArc(2 * t - 1));

  -- The halves are closed and cover, so pasting closes the argument.
  Plane.lowerHalf ∪ Plane.upperHalf = Real.unitInterval
      by Plane.halves_cover as halvesCover;
  MetricSpace.ClosedIn(Plane.lowerHalf, Real.unitInterval)
      by Plane.lowerHalf_ClosedIn;
  MetricSpace.ClosedIn(Plane.upperHalf, Real.unitInterval)
      by Plane.upperHalf_ClosedIn;
  MetricSpace.ClosedIn(Plane.lowerHalf, Plane.lowerHalf ∪ Plane.upperHalf)
      by substituting halvesCover;
  MetricSpace.ClosedIn(Plane.upperHalf, Plane.lowerHalf ∪ Plane.upperHalf)
      by substituting halvesCover;
  MetricSpace.ContinuousOn(
      Plane.concatenate(firstArc, secondArc),
      Plane.lowerHalf ∪ Plane.upperHalf)
      by MetricSpace.ContinuousOn.paste;
  done by substituting halvesCover
}

-- ----------------------------------------------------------------------
-- Injectivity, and the theorem.
--
-- Inside one half it is that arc's own injectivity, carried back through
-- the retiming. Across the halves the two values agree, so the value lies
-- on both arcs — and the arcs were assumed to meet only at the shared
-- endpoint, which pins both parameters to the midpoint.

-- At the seam the value is the shared endpoint, and injectivity of the arc
-- it belongs to pins the parameter to the midpoint. The two halves need
-- the statement separately, since they retime differently.

theorem Plane.lowerHalf_at_finish_is_midpoint
        (firstArc : ℝ → Plane.Point)
        (firstInjective
            : MetricSpace.InjectiveOn(firstArc, Real.unitInterval))
        (t : ℝ) (inLower : t ∈ Plane.lowerHalf)
        (atFinish : firstArc(2 * t) = Plane.arcFinish(firstArc))
        : t = 1 / 2 := {
  2 * t ∈ Real.unitInterval by Plane.lowerHalf_lands;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  firstArc(2 * t) = firstArc(1) by atFinish;
  2 * t = 1 by firstInjective as reachesOne;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  2 * t = 2 * (1 / 2) by linear_combination(reachesOne - halfDoubles);
  done by Real.equal_of_multiply_left
}

theorem Plane.upperHalf_at_start_is_midpoint
        (secondArc : ℝ → Plane.Point)
        (secondInjective
            : MetricSpace.InjectiveOn(secondArc, Real.unitInterval))
        (t : ℝ) (inUpper : t ∈ Plane.upperHalf)
        (atStart : secondArc(2 * t - 1) = Plane.arcStart(secondArc))
        : t = 1 / 2 := {
  2 * t - 1 ∈ Real.unitInterval by Plane.upperHalf_lands;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  secondArc(2 * t - 1) = secondArc(0) by atStart;
  2 * t - 1 = 0 by secondInjective as reachesZero;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  2 * t = 2 * (1 / 2) by linear_combination(reachesZero - halfDoubles);
  done by Real.equal_of_multiply_left
}

-- Across the seam: the common value lies on both arcs, so it is the
-- shared endpoint, and each half's injectivity pins its own parameter to
-- the midpoint. Stated for a parameter of each half rather than for `x`
-- and `y`, so that the two orderings of the case split are the same
-- theorem.
theorem Plane.concatenate_across_seam
        (firstArc secondArc : ℝ → Plane.Point)
        (firstInjective
            : MetricSpace.InjectiveOn(firstArc, Real.unitInterval))
        (secondInjective
            : MetricSpace.InjectiveOn(secondArc, Real.unitInterval))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (meetOnlyThere
            : ∀ (z : Plane.Point). z ∈ Plane.arc(firstArc) →
                z ∈ Plane.arc(secondArc) → z = Plane.arcFinish(firstArc))
        (low high : ℝ)
        (lowInLower : low ∈ Plane.lowerHalf)
        (highInUpper : high ∈ Plane.upperHalf)
        (sameValue
            : Plane.concatenate(firstArc, secondArc)(low)
                  = Plane.concatenate(firstArc, secondArc)(high))
        : low = high := {
  low ∈ Real.unitInterval;
  high ∈ Real.unitInterval;
  2 * low ∈ Real.unitInterval by Plane.lowerHalf_lands;
  2 * high - 1 ∈ Real.unitInterval by Plane.upperHalf_lands;
  Plane.concatenate(firstArc, secondArc)(low) = firstArc(2 * low)
      by Plane.concatenate_on_lowerHalf as valueAtLow;
  Plane.concatenate(firstArc, secondArc)(high) = secondArc(2 * high - 1)
      by Plane.concatenate_value_on_upperHalf as valueAtHigh;

  let shared : Plane.Point := firstArc(2 * low);
  shared ∈ Plane.arc(firstArc) by Plane.member_arc(t := 2 * low);
  shared
     = Plane.concatenate(firstArc, secondArc)(low) by valueAtLow
     = Plane.concatenate(firstArc, secondArc)(high) by sameValue
     = secondArc(2 * high - 1) by valueAtHigh
     as sharedOnSecond;
  secondArc(2 * high - 1) = shared by sharedOnSecond;
  shared ∈ Plane.arc(secondArc) by Plane.member_arc(t := 2 * high - 1);
  shared = Plane.arcFinish(firstArc) by meetOnlyThere;

  firstArc(2 * low) = Plane.arcFinish(firstArc);
  low = 1 / 2 by Plane.lowerHalf_at_finish_is_midpoint;
  secondArc(2 * high - 1) = Plane.arcFinish(firstArc)
      by substituting sharedOnSecond;
  secondArc(2 * high - 1) = Plane.arcStart(secondArc) by sharedEndpoint;
  high = 1 / 2 by Plane.upperHalf_at_start_is_midpoint;
  low = 1 / 2
      = high;
  done
}

-- Two arcs meeting only at the endpoint they share concatenate to an arc.
theorem Plane.IsArc.concatenate
        (firstArc secondArc : ℝ → Plane.Point)
        (firstIsArc : Plane.IsArc(firstArc))
        (secondIsArc : Plane.IsArc(secondArc))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (meetOnlyThere
            : ∀ (z : Plane.Point). z ∈ Plane.arc(firstArc) →
                z ∈ Plane.arc(secondArc) → z = Plane.arcFinish(firstArc))
        : Plane.IsArc(Plane.concatenate(firstArc, secondArc)) := {
  MetricSpace.ContinuousOn(firstArc, Real.unitInterval);
  MetricSpace.InjectiveOn(firstArc, Real.unitInterval) as firstInjective;
  MetricSpace.ContinuousOn(secondArc, Real.unitInterval);
  MetricSpace.InjectiveOn(secondArc, Real.unitInterval) as secondInjective;
  MetricSpace.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Real.unitInterval)
      by Plane.concatenate_ContinuousOn;
  (2 : ℝ) ≠ 0;

  MetricSpace.InjectiveOn(
      Plane.concatenate(firstArc, secondArc), Real.unitInterval)
      by (x : ℝ) (xInside : x ∈ Real.unitInterval)
         (y : ℝ) (yInside : y ∈ Real.unitInterval)
         (sameValue : Plane.concatenate(firstArc, secondArc)(x)
                          = Plane.concatenate(firstArc, secondArc)(y)) ↦ {
        done by cases {
          case x ≤ 1 / 2 as xLow: {
              x ∈ Plane.lowerHalf;
              2 * x ∈ Real.unitInterval by Plane.lowerHalf_lands;
              Plane.concatenate(firstArc, secondArc)(x) = firstArc(2 * x)
                  by Logic.if_positive;
              done by cases {
                case y ≤ 1 / 2 as yLow: {
                    -- Both in the first arc: its injectivity, doubled.
                    y ∈ Plane.lowerHalf;
                    2 * y ∈ Real.unitInterval by Plane.lowerHalf_lands;
                    Plane.concatenate(firstArc, secondArc)(y) = firstArc(2 * y)
                        by Logic.if_positive as valueAtY;
                    firstArc(2 * x)
                       = Plane.concatenate(firstArc, secondArc)(x)
                       = Plane.concatenate(firstArc, secondArc)(y) by sameValue
                       = firstArc(2 * y) by valueAtY;
                    2 * x = 2 * y by firstInjective;
                    done by Real.equal_of_multiply_left
                  }
                otherwise as yHigh: {
                    y ≥ 1 / 2 by Real.not_LessOrEqual_implies;
                    y ∈ Plane.upperHalf;
                    done by Plane.concatenate_across_seam
                  }
              }
            }
          otherwise as xHigh: {
              x ≥ 1 / 2 by Real.not_LessOrEqual_implies;
              x ∈ Plane.upperHalf;
              2 * x - 1 ∈ Real.unitInterval by Plane.upperHalf_lands;
              Plane.concatenate(firstArc, secondArc)(x)
                  = secondArc(2 * x - 1) by Logic.if_negative;
              done by cases {
                case y ≤ 1 / 2 as yLow: {
                    y ∈ Plane.lowerHalf;
                    Plane.concatenate(firstArc, secondArc)(y)
                        = Plane.concatenate(firstArc, secondArc)(x) by sameValue;
                    y = x by Plane.concatenate_across_seam;
                    done
                  }
                otherwise as yHigh: {
                    -- Both in the second arc.
                    y ≥ 1 / 2 by Real.not_LessOrEqual_implies;
                    y ∈ Plane.upperHalf;
                    2 * y - 1 ∈ Real.unitInterval by Plane.upperHalf_lands;
                    Plane.concatenate(firstArc, secondArc)(y)
                        = secondArc(2 * y - 1)
                        by Logic.if_negative as valueAtY;
                    secondArc(2 * x - 1)
                       = Plane.concatenate(firstArc, secondArc)(x)
                       = Plane.concatenate(firstArc, secondArc)(y) by sameValue
                       = secondArc(2 * y - 1) by valueAtY;
                    2 * x - 1 = 2 * y - 1 by secondInjective as sameRetimed;
                    2 * x = 2 * y by linear_combination(sameRetimed);
                    done by Real.equal_of_multiply_left
                  }
              }
            }
        }
      };
  done
}

-- ----------------------------------------------------------------------
-- What the concatenation covers.
--
-- Each half retimes ONTO the whole interval — half a parameter is the one
-- that doubles to it — so the glued map's image is exactly the two arcs
-- together.

theorem Plane.lowerHalf_reaches (u : ℝ) (inside : u ∈ Real.unitInterval)
        : ∃ (t : ℝ). t ∈ Plane.lowerHalf ∧ 2 * t = u := {
  u ≥ 0 by Real.unitInterval_nonneg;
  u ≤ 1 by Real.unitInterval_atMostOne;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  1 / 2 > (0 : ℝ) by Plane.midpoint_positive;
  Real.IsNonneg(1 / 2);
  u * (1 / 2) ≥ 0 by Real.multiply_nonneg;
  u * (1 / 2) ≤ 1 * (1 / 2) by Real.LessOrEqual.multiply_by_nonneg_right;
  u * (1 / 2) ≤ 1 / 2 by ordered_field;
  u * (1 / 2) ≤ 1 by ordered_field;
  u * (1 / 2) ∈ Real.unitInterval by Real.member_unitInterval;
  u * (1 / 2) ∈ Plane.lowerHalf;
  2 * (u * (1 / 2)) = u by linear_combination(u * halfDoubles);
  done by { witness u * (1 / 2) }
}

theorem Plane.upperHalf_reaches (u : ℝ) (inside : u ∈ Real.unitInterval)
        : ∃ (t : ℝ). t ∈ Plane.upperHalf ∧ 2 * t - 1 = u := {
  u ≥ 0 by Real.unitInterval_nonneg;
  u ≤ 1 by Real.unitInterval_atMostOne;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  1 / 2 > (0 : ℝ) by Plane.midpoint_positive;
  Real.IsNonneg(1 / 2);
  u * (1 / 2) ≥ 0 by Real.multiply_nonneg;
  u * (1 / 2) ≤ 1 * (1 / 2) by Real.LessOrEqual.multiply_by_nonneg_right;
  u * (1 / 2) ≤ 1 / 2 by ordered_field;
  u * (1 / 2) + 1 / 2 ≥ 0 by ordered_field;
  u * (1 / 2) + 1 / 2 ≤ 1 by ordered_field;
  u * (1 / 2) + 1 / 2 ≥ 1 / 2 by ordered_field;
  u * (1 / 2) + 1 / 2 ∈ Real.unitInterval by Real.member_unitInterval;
  u * (1 / 2) + 1 / 2 ∈ Plane.upperHalf;
  2 * (u * (1 / 2) + 1 / 2) - 1 = u
      by linear_combination(u * halfDoubles + halfDoubles);
  done by { witness u * (1 / 2) + 1 / 2 }
}

-- The glued arc covers exactly the two it was glued from.
theorem Plane.arc_concatenate
        (firstArc secondArc : ℝ → Plane.Point)
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        : Plane.arc(Plane.concatenate(firstArc, secondArc))
              = Plane.arc(firstArc) ∪ Plane.arc(secondArc) := {
  Plane.arc(Plane.concatenate(firstArc, secondArc))
      ⊆ Plane.arc(firstArc) ∪ Plane.arc(secondArc)
      by (value : Plane.Point)
         (onGlued :
              value ∈ Plane.arc(Plane.concatenate(firstArc, secondArc))) ↦ {
        choose source : ℝ such that
            source ∈ Real.unitInterval
              ∧ Plane.concatenate(firstArc, secondArc)(source) = value
            from onGlued;
        source ∈ Real.unitInterval;
        Plane.concatenate(firstArc, secondArc)(source) = value;
        done by cases {
          case source ≤ 1 / 2 as low: {
              source ∈ Plane.lowerHalf;
              2 * source ∈ Real.unitInterval by Plane.lowerHalf_lands;
              firstArc(2 * source) = value by Logic.if_positive;
              value ∈ Plane.arc(firstArc) by Plane.member_arc(t := 2 * source);
              done
            }
          otherwise as high: {
              source ≥ 1 / 2 by Real.not_LessOrEqual_implies;
              source ∈ Plane.upperHalf;
              2 * source - 1 ∈ Real.unitInterval by Plane.upperHalf_lands;
              secondArc(2 * source - 1) = value by Logic.if_negative;
              value ∈ Plane.arc(secondArc)
                  by Plane.member_arc(t := 2 * source - 1);
              done
            }
        }
      };

  Plane.arc(firstArc) ∪ Plane.arc(secondArc)
      ⊆ Plane.arc(Plane.concatenate(firstArc, secondArc))
      by (value : Plane.Point)
         (onEither : value ∈ Plane.arc(firstArc) ∪ Plane.arc(secondArc)) ↦ {
        done by cases {
          case value ∈ Plane.arc(firstArc) as onFirst: {
              choose source : ℝ such that
                  source ∈ Real.unitInterval ∧ firstArc(source) = value
                  from onFirst;
              source ∈ Real.unitInterval;
              firstArc(source) = value as valueAtSource;
              choose glued such that
                  glued ∈ Plane.lowerHalf ∧ 2 * glued = source
                  from Plane.lowerHalf_reaches;
              glued ∈ Plane.lowerHalf;
              2 * glued = source as doublesToSource;
              glued ∈ Real.unitInterval;
              Plane.concatenate(firstArc, secondArc)(glued)
                 = firstArc(2 * glued) by Logic.if_positive
                 = firstArc(source) by substituting doublesToSource
                 = value by valueAtSource;
              done by { witness glued }
            }
          case value ∈ Plane.arc(secondArc) as onSecond: {
              choose source : ℝ such that
                  source ∈ Real.unitInterval ∧ secondArc(source) = value
                  from onSecond;
              source ∈ Real.unitInterval;
              secondArc(source) = value as valueAtSource;
              choose glued such that
                  glued ∈ Plane.upperHalf ∧ 2 * glued - 1 = source
                  from Plane.upperHalf_reaches;
              glued ∈ Plane.upperHalf;
              2 * glued - 1 = source as retimesToSource;
              glued ∈ Real.unitInterval;
              Plane.concatenate(firstArc, secondArc)(glued)
                 = secondArc(2 * glued - 1)
                       by Plane.concatenate_value_on_upperHalf
                 = secondArc(source) by substituting retimesToSource
                 = value by valueAtSource;
              done by { witness glued }
            }
        }
      };
  done by Set.equal_of_same_members
}
