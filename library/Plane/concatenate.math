-- Plane/concatenate.math
--
-- Two arcs meeting only at an endpoint make one arc. Layer 4.
--
-- The glued map runs the first arc over the lower half of the model
-- interval and the second over the upper half, each at double speed. The
-- halves are named by their parameter (`first(x) ≤ 1/2`) rather than as
-- segments, because every obligation is about that parameter: they cover
-- the interval because the order is linear, each is closed because a
-- coordinate gap never exceeds a distance, and the doubling maps are
-- affine in it.
--
-- Continuity is then the pasting lemma — the halves are closed and the
-- glued map agrees with a composition on each. Injectivity is the only
-- place the hypotheses about the two arcs are used: inside a half it is
-- that arc's injectivity, and across the halves it is the assumption that
-- the arcs meet only at the shared endpoint.

module Plane.concatenate

import Logic.basics
import Logic.exists
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.linearity
import Real.absolute_value
import Real.absolute_value_order
import Real.order_multiplication
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.topology
import Plane.compactness
import Plane.connected
import Plane.separation
import Plane.model
import Plane.homeomorphism
import Plane.curve
import Plane.subarc

-- ----------------------------------------------------------------------
-- Retiming: the affine reparametrisation of the model interval.

definition Plane.retime (scale shift : ℝ) : Plane.Point → Plane.Point :=
  (x : Plane.Point) ↦ Plane.walk(scale * Plane.Point.first(x) + shift)

theorem Plane.retime_parameter (scale shift : ℝ) (x : Plane.Point)
        : Plane.Point.first(Plane.retime(scale, shift)(x))
              = scale * Plane.Point.first(x) + shift :=
  done by Plane.first_of_walk

theorem Plane.retime_lands (scale shift : ℝ) (x : Plane.Point)
        (lower : 0 ≤ scale * Plane.Point.first(x) + shift)
        (upper : scale * Plane.Point.first(x) + shift ≤ 1)
        : Plane.retime(scale, shift)(x) ∈ Plane.unitSegment :=
  witness scale * Plane.Point.first(x) + shift with done

-- The model interval has unit length, so a retiming moves points by the
-- scale times the parameter gap — and a parameter gap never exceeds the
-- distance between the points it comes from.
theorem Plane.unitSegment_length
        : Plane.distance(Plane.origin, Plane.Point.make(1, 0)) = 1 :=
  done by Plane.distance_make

theorem Plane.retime_ContinuousOn (scale shift : ℝ)
        (carrier : Set(Plane.Point))
        : Plane.ContinuousOn(Plane.retime(scale, shift), carrier) := {
  take x : Plane.Point;
  suppose x ∈ carrier;
  take tolerance : ℝ;
  suppose 0 < tolerance as tolerancePositive;
  -- The stride is written out rather than bound with `let`: the sign
  -- battery does not see through the binding, and `abs(scale) ≤ stride` is
  -- the step the estimate turns on.
  0 ≤ abs(scale);
  0 < 1 + abs(scale);
  1 + abs(scale) ≠ 0;
  0 < tolerance / (1 + abs(scale));
  witness tolerance / (1 + abs(scale)) with {
    0 < tolerance / (1 + abs(scale));
    ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < tolerance / (1 + abs(scale)) →
          Plane.distance(
              Plane.retime(scale, shift)(x),
              Plane.retime(scale, shift)(y)) < tolerance
        by (y : Plane.Point) (inCarrier : y ∈ carrier)
           (near : Plane.distance(x, y)
                       < tolerance / (1 + abs(scale))) ↦ {
          -- A coordinate gap never exceeds the distance.
          abs(Plane.Point.first(y) - Plane.Point.first(x))
             = abs(Plane.Vector.first(y - x))
             ≤ Plane.Vector.norm(y - x)
                   by Plane.Vector.absolute_first_LessOrEqual_norm
             = Plane.distance(x, y);

          -- Retiming multiplies that gap by the scale.
          (scale * Plane.Point.first(y) + shift)
                  - (scale * Plane.Point.first(x) + shift)
              = scale * (Plane.Point.first(y) - Plane.Point.first(x))
              by ring as retimedGap;
          Plane.distance(
              Plane.retime(scale, shift)(x), Plane.retime(scale, shift)(y))
             = abs((scale * Plane.Point.first(y) + shift)
                       - (scale * Plane.Point.first(x) + shift))
                   * Plane.distance(Plane.origin, Plane.Point.make(1, 0))
                   by Plane.between_distance
             = abs(scale * (Plane.Point.first(y) - Plane.Point.first(x)))
                   * Plane.distance(Plane.origin, Plane.Point.make(1, 0))
                   by substituting retimedGap
             = abs(scale * (Plane.Point.first(y) - Plane.Point.first(x))) * 1
                   by Plane.unitSegment_length
             = abs(scale) * abs(Plane.Point.first(y) - Plane.Point.first(x))
                   by Real.absolute_value_multiplicative
             as retimedDistance;

          -- And the scale is below the stride, which the nearness divides.
          Real.IsNonneg(abs(scale));
          Real.IsNonneg(Plane.distance(x, y));
          abs(scale) ≤ 1 + abs(scale) by ordered_field;
          abs(scale) * abs(Plane.Point.first(y) - Plane.Point.first(x))
              ≤ (1 + abs(scale)) * Plane.distance(x, y)
              by Real.LessOrEqual.multiply_monotone_nonneg;
          Plane.distance(
              Plane.retime(scale, shift)(x), Plane.retime(scale, shift)(y))
             = abs(scale) * abs(Plane.Point.first(y) - Plane.Point.first(x))
                   by retimedDistance
             ≤ (1 + abs(scale)) * Plane.distance(x, y)
             = Plane.distance(x, y) * (1 + abs(scale))
             < (tolerance / (1 + abs(scale))) * (1 + abs(scale))
                   by Real.LessThan.multiply_by_positive_right
             = (1 + abs(scale)) * (tolerance / (1 + abs(scale)))
             = tolerance by Real.divide_cancel;
          done
        };
    done
  }
}

-- ----------------------------------------------------------------------
-- The two halves of the model interval.

-- The midpoint's parameter, named once: `1/2` is a cast rational, so the
-- ground-arithmetic tier does not decide comparisons against it.
theorem Plane.midpoint_positive : (0 : ℝ) < 1 / 2 :=
  done by Real.divide_positive

theorem Plane.midpoint_below_one : 1 / 2 < (1 : ℝ) := {
  (0 : ℝ) < 1 / 2;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  done by ordered_field
}

definition Plane.lowerHalf : Set(Plane.Point) :=
  (x : Plane.Point) ↦ x ∈ Plane.unitSegment ∧ Plane.Point.first(x) ≤ 1 / 2

definition Plane.upperHalf : Set(Plane.Point) :=
  (x : Plane.Point) ↦ x ∈ Plane.unitSegment ∧ 1 / 2 ≤ Plane.Point.first(x)

theorem Plane.halves_cover
        : Plane.lowerHalf ∪ Plane.upperHalf = Plane.unitSegment := {
  Plane.lowerHalf ∪ Plane.upperHalf ⊆ Plane.unitSegment
      by (x : Plane.Point) (inUnion : x ∈ Plane.lowerHalf ∪ Plane.upperHalf) ↦ {
        done by cases {
          case x ∈ Plane.lowerHalf as inLower: { x ∈ Plane.unitSegment; done }
          case x ∈ Plane.upperHalf as inUpper: { x ∈ Plane.unitSegment; done }
        }
      };
  Plane.unitSegment ⊆ Plane.lowerHalf ∪ Plane.upperHalf
      by (x : Plane.Point) (onSegment : x ∈ Plane.unitSegment) ↦ {
        Plane.Point.first(x) ≤ 1 / 2 ∨ 1 / 2 ≤ Plane.Point.first(x)
            by Real.LessOrEqual.linear;
        done by cases {
          case Plane.Point.first(x) ≤ 1 / 2 as low: {
              x ∈ Plane.lowerHalf;
              done
            }
          case 1 / 2 ≤ Plane.Point.first(x) as high: {
              x ∈ Plane.upperHalf;
              done
            }
        }
      };
  done by Set.equal_of_same_members
}

-- Each half is closed in the interval: a point on the far side of the
-- midpoint has its whole parameter slack to spare, and a coordinate gap
-- never exceeds a distance.
theorem Plane.lowerHalf_ClosedIn
        : Plane.ClosedIn(Plane.lowerHalf, Plane.unitSegment) := {
  take x : Plane.Point;
  suppose x ∈ Plane.unitSegment ∖ Plane.lowerHalf as outside;
  x ∈ Plane.unitSegment;
  ¬(x ∈ Plane.lowerHalf);
  ¬(Plane.Point.first(x) ≤ 1 / 2)
      by (low : Plane.Point.first(x) ≤ 1 / 2) ↦ {
        x ∈ Plane.lowerHalf;
        done
      };
  1 / 2 < Plane.Point.first(x) by Real.LessThan_of_not_LessOrEqual;
  0 < Plane.Point.first(x) - 1 / 2;
  witness Plane.Point.first(x) - 1 / 2 with {
    0 < Plane.Point.first(x) - 1 / 2;
    ∀ (y : Plane.Point). y ∈ Plane.unitSegment →
        Plane.distance(x, y) < Plane.Point.first(x) - 1 / 2 →
          y ∈ Plane.unitSegment ∖ Plane.lowerHalf
        by (y : Plane.Point) (yOnSegment : y ∈ Plane.unitSegment)
           (near : Plane.distance(x, y) < Plane.Point.first(x) - 1 / 2) ↦ {
          abs(Plane.Point.first(y) - Plane.Point.first(x))
             = abs(Plane.Vector.first(y - x))
             ≤ Plane.Vector.norm(y - x)
                   by Plane.Vector.absolute_first_LessOrEqual_norm
             = Plane.distance(x, y)
             < Plane.Point.first(x) - 1 / 2;
          -(Plane.Point.first(x) - 1 / 2)
              < Plane.Point.first(y) - Plane.Point.first(x)
              by Real.absolute_value_LessThan_bounds;
          1 / 2 < Plane.Point.first(y) by ordered_field;
          ¬(y ∈ Plane.lowerHalf)
              by (inLower : y ∈ Plane.lowerHalf) ↦ {
                Plane.Point.first(y) ≤ 1 / 2;
                done by Real.LessThan.irreflexive
              };
          done
        };
    done
  }
}

theorem Plane.upperHalf_ClosedIn
        : Plane.ClosedIn(Plane.upperHalf, Plane.unitSegment) := {
  take x : Plane.Point;
  suppose x ∈ Plane.unitSegment ∖ Plane.upperHalf as outside;
  x ∈ Plane.unitSegment;
  ¬(x ∈ Plane.upperHalf);
  ¬(1 / 2 ≤ Plane.Point.first(x))
      by (high : 1 / 2 ≤ Plane.Point.first(x)) ↦ {
        x ∈ Plane.upperHalf;
        done
      };
  Plane.Point.first(x) < 1 / 2 by Real.LessThan_of_not_LessOrEqual;
  0 < 1 / 2 - Plane.Point.first(x);
  witness 1 / 2 - Plane.Point.first(x) with {
    0 < 1 / 2 - Plane.Point.first(x);
    ∀ (y : Plane.Point). y ∈ Plane.unitSegment →
        Plane.distance(x, y) < 1 / 2 - Plane.Point.first(x) →
          y ∈ Plane.unitSegment ∖ Plane.upperHalf
        by (y : Plane.Point) (yOnSegment : y ∈ Plane.unitSegment)
           (near : Plane.distance(x, y) < 1 / 2 - Plane.Point.first(x)) ↦ {
          abs(Plane.Point.first(y) - Plane.Point.first(x))
             = abs(Plane.Vector.first(y - x))
             ≤ Plane.Vector.norm(y - x)
                   by Plane.Vector.absolute_first_LessOrEqual_norm
             = Plane.distance(x, y)
             < 1 / 2 - Plane.Point.first(x);
          Plane.Point.first(y) - Plane.Point.first(x)
              < 1 / 2 - Plane.Point.first(x)
              by Real.absolute_value_LessThan_bounds;
          Plane.Point.first(y) < 1 / 2 by ordered_field;
          ¬(y ∈ Plane.upperHalf)
              by (inUpper : y ∈ Plane.upperHalf) ↦ {
                1 / 2 ≤ Plane.Point.first(y);
                done by Real.LessThan.irreflexive
              };
          done
        };
    done
  }
}

-- ----------------------------------------------------------------------
-- The concatenation.
--
-- Below the midpoint the first arc runs at double speed; above it, the
-- second. At the midpoint both branches are asked for, and they agree
-- exactly because the arcs share that endpoint — which is what makes the
-- glued map well defined and lets the pasting lemma close continuity.

definition Plane.concatenate
        (firstArc secondArc : Plane.Point → Plane.Point)
        : Plane.Point → Plane.Point :=
  (x : Plane.Point) ↦
    if Plane.Point.first(x) ≤ 1 / 2
    then firstArc(Plane.retime(2, 0)(x))
    else secondArc(Plane.retime(2, -(1 : ℝ))(x))

theorem Plane.concatenate_on_lowerHalf
        (firstArc secondArc : Plane.Point → Plane.Point) (x : Plane.Point)
        (inLower : x ∈ Plane.lowerHalf)
        : Plane.concatenate(firstArc, secondArc)(x)
              = firstArc(Plane.retime(2, 0)(x)) := {
  Plane.Point.first(x) ≤ 1 / 2;
  done by Logic.if_positive
}

theorem Plane.concatenate_on_upperHalf
        (firstArc secondArc : Plane.Point → Plane.Point) (x : Plane.Point)
        (inUpper : x ∈ Plane.upperHalf)
        (aboveMidpoint : ¬(Plane.Point.first(x) ≤ 1 / 2))
        : Plane.concatenate(firstArc, secondArc)(x)
              = secondArc(Plane.retime(2, -(1 : ℝ))(x)) :=
  done by Logic.if_negative

theorem Plane.concatenate_start
        (firstArc secondArc : Plane.Point → Plane.Point)
        : Plane.arcStart(Plane.concatenate(firstArc, secondArc))
              = Plane.arcStart(firstArc) := {
  Plane.Point.first(Plane.origin)
     = 0
     < 1 / 2 by Plane.midpoint_positive;
  Plane.Point.first(Plane.origin) ≤ 1 / 2 by Real.LessThan.weaken;
  Plane.retime(2, 0)(Plane.origin)
     = Plane.walk(2 * 0 + 0)
     = Plane.walk(0)
     = Plane.origin by Plane.walk_zero as retimedStart;
  Plane.concatenate(firstArc, secondArc)(Plane.origin)
     = firstArc(Plane.retime(2, 0)(Plane.origin)) by Logic.if_positive
     = firstArc(Plane.origin) by substituting retimedStart;
  done
}

theorem Plane.concatenate_finish
        (firstArc secondArc : Plane.Point → Plane.Point)
        : Plane.arcFinish(Plane.concatenate(firstArc, secondArc))
              = Plane.arcFinish(secondArc) := {
  1 / 2 < (1 : ℝ) by Plane.midpoint_below_one;
  ¬(Plane.Point.first(Plane.Point.make(1, 0)) ≤ 1 / 2)
      by (low : Plane.Point.first(Plane.Point.make(1, 0)) ≤ 1 / 2) ↦ {
        Plane.Point.first(Plane.Point.make(1, 0)) = 1;
        (1 : ℝ) ≤ 1 / 2;
        done by Real.LessThan.irreflexive
      };
  Plane.retime(2, -(1 : ℝ))(Plane.Point.make(1, 0))
     = Plane.walk(2 * 1 + -(1 : ℝ))
     = Plane.walk(1) by ((2 : ℝ) * 1 + -(1 : ℝ) = 1)
     = Plane.Point.make(1, 0) by Plane.walk_one as retimedFinish;
  Plane.concatenate(firstArc, secondArc)(Plane.Point.make(1, 0))
     = secondArc(Plane.retime(2, -(1 : ℝ))(Plane.Point.make(1, 0)))
           by Logic.if_negative
     = secondArc(Plane.Point.make(1, 0)) by substituting retimedFinish;
  done
}

-- Each half retimes into the model interval: doubling a parameter below
-- the midpoint reaches at most one, and doubling one above it, less one,
-- reaches at least nothing.
theorem Plane.lowerHalf_retime_lands (x : Plane.Point)
        (inLower : x ∈ Plane.lowerHalf)
        : Plane.retime(2, 0)(x) ∈ Plane.unitSegment := {
  x ∈ Plane.unitSegment;
  Plane.Point.first(x) ≤ 1 / 2;
  0 ≤ Plane.Point.first(x)
      by Plane.first_coordinate_nonneg_on_unitSegment;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  0 ≤ 2 * Plane.Point.first(x) + 0 by ordered_field;
  2 * Plane.Point.first(x) + 0 ≤ 1 by ordered_field;
  done by Plane.retime_lands
}

theorem Plane.upperHalf_retime_lands (x : Plane.Point)
        (inUpper : x ∈ Plane.upperHalf)
        : Plane.retime(2, -(1 : ℝ))(x) ∈ Plane.unitSegment := {
  x ∈ Plane.unitSegment;
  1 / 2 ≤ Plane.Point.first(x);
  Plane.Point.first(x) ≤ 1
      by Plane.first_coordinate_atMostOne_on_unitSegment;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel;
  0 ≤ 2 * Plane.Point.first(x) + -(1 : ℝ) by ordered_field;
  2 * Plane.Point.first(x) + -(1 : ℝ) ≤ 1 by ordered_field;
  done by Plane.retime_lands
}

-- ----------------------------------------------------------------------
-- Continuity: each half carries a composition, and the halves are closed.

-- On the upper half the glued map IS the second arc, retimed — including
-- at the midpoint, where the `if` still takes the first branch. There the
-- two branches agree, and only because the arcs share that endpoint: this
-- is what makes the glued map well defined rather than merely continuous.
theorem Plane.concatenate_value_on_upperHalf
        (firstArc secondArc : Plane.Point → Plane.Point)
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (x : Plane.Point) (inUpper : x ∈ Plane.upperHalf)
        : Plane.concatenate(firstArc, secondArc)(x)
              = secondArc(Plane.retime(2, -(1 : ℝ))(x)) := {
        done by cases {
          case Plane.Point.first(x) ≤ 1 / 2 as atMidpoint: {
              -- The only such point is the midpoint: there the first arc
              -- finishes where the second starts.
              1 / 2 ≤ Plane.Point.first(x);
              Plane.Point.first(x) = 1 / 2
                  by Real.LessOrEqual.antisymmetric as isMidpoint;
              (2 : ℝ) ≠ 0;
              (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
              2 * Plane.Point.first(x) + 0 = (2 : ℝ) * (1 / 2) + 0
                  by substituting isMidpoint;
              (2 : ℝ) * (1 / 2) + 0 = 1 by linear_combination(halfDoubles);
              2 * Plane.Point.first(x) + 0 = 1 as lowerParameterIsOne;
              2 * Plane.Point.first(x) + -(1 : ℝ)
                  = (2 : ℝ) * (1 / 2) + -(1 : ℝ) by substituting isMidpoint;
              (2 : ℝ) * (1 / 2) + -(1 : ℝ) = 0
                  by linear_combination(halfDoubles);
              2 * Plane.Point.first(x) + -(1 : ℝ) = 0 as upperParameterIsZero;

              -- The lower branch has run out the first arc, and the upper
              -- branch is about to start the second.
              Plane.retime(2, 0)(x)
                 = Plane.walk(2 * Plane.Point.first(x) + 0)
                 = Plane.walk(1) by substituting lowerParameterIsOne
                 = Plane.Point.make(1, 0) by Plane.walk_one
                 as lowerReachesFinish;
              Plane.retime(2, -(1 : ℝ))(x)
                 = Plane.walk(2 * Plane.Point.first(x) + -(1 : ℝ))
                 = Plane.walk(0) by substituting upperParameterIsZero
                 = Plane.origin by Plane.walk_zero as upperReachesStart;
              Plane.concatenate(firstArc, secondArc)(x)
                 = firstArc(Plane.retime(2, 0)(x)) by Logic.if_positive
                 = firstArc(Plane.Point.make(1, 0))
                       by substituting lowerReachesFinish
                 = secondArc(Plane.origin) by sharedEndpoint
                 = secondArc(Plane.retime(2, -(1 : ℝ))(x))
                       by substituting upperReachesStart;
              done
            }
          otherwise as aboveMidpoint: {
              done by Plane.concatenate_on_upperHalf
            }
        }
}

theorem Plane.concatenate_ContinuousOn
        (firstArc secondArc : Plane.Point → Plane.Point)
        (firstContinuous : Plane.ContinuousOn(firstArc, Plane.unitSegment))
        (secondContinuous : Plane.ContinuousOn(secondArc, Plane.unitSegment))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        : Plane.ContinuousOn(
              Plane.concatenate(firstArc, secondArc), Plane.unitSegment) := {
  -- On the lower half the glued map IS the first arc, retimed.
  ∀ (x : Plane.Point). x ∈ Plane.lowerHalf →
      Plane.retime(2, 0)(x) ∈ Plane.unitSegment
      by (x : Plane.Point) (inLower : x ∈ Plane.lowerHalf) ↦
           Plane.lowerHalf_retime_lands(x, inLower);
  Plane.ContinuousOn(Plane.retime(2, 0), Plane.lowerHalf)
      by Plane.retime_ContinuousOn;
  Plane.ContinuousOn(
      (x : Plane.Point) ↦ firstArc(Plane.retime(2, 0)(x)), Plane.lowerHalf)
      by Plane.ContinuousOn.compose(
          inner := Plane.retime(2, 0), outer := firstArc,
          target := Plane.unitSegment);
  ∀ (x : Plane.Point). x ∈ Plane.lowerHalf →
      Plane.concatenate(firstArc, secondArc)(x)
          = firstArc(Plane.retime(2, 0)(x))
      by (x : Plane.Point) (inLower : x ∈ Plane.lowerHalf) ↦
           Plane.concatenate_on_lowerHalf(firstArc, secondArc, x, inLower);
  Plane.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Plane.lowerHalf)
      by Plane.ContinuousOn.of_agreeing(
          g := (x : Plane.Point) ↦ firstArc(Plane.retime(2, 0)(x)));

  -- On the upper half it is the second arc, retimed — including at the
  -- midpoint, where the `if` still takes the first branch but the two arcs
  -- agree because they share that endpoint.
  ∀ (x : Plane.Point). x ∈ Plane.upperHalf →
      Plane.retime(2, -(1 : ℝ))(x) ∈ Plane.unitSegment
      by (x : Plane.Point) (inUpper : x ∈ Plane.upperHalf) ↦
           Plane.upperHalf_retime_lands(x, inUpper);
  Plane.ContinuousOn(Plane.retime(2, -(1 : ℝ)), Plane.upperHalf)
      by Plane.retime_ContinuousOn;
  Plane.ContinuousOn(
      (x : Plane.Point) ↦ secondArc(Plane.retime(2, -(1 : ℝ))(x)),
      Plane.upperHalf)
      by Plane.ContinuousOn.compose(
          inner := Plane.retime(2, -(1 : ℝ)), outer := secondArc,
          target := Plane.unitSegment);
  ∀ (x : Plane.Point). x ∈ Plane.upperHalf →
      Plane.concatenate(firstArc, secondArc)(x)
          = secondArc(Plane.retime(2, -(1 : ℝ))(x))
      by (x : Plane.Point) (inUpper : x ∈ Plane.upperHalf) ↦
           Plane.concatenate_value_on_upperHalf(
               firstArc, secondArc, sharedEndpoint, x, inUpper);
  Plane.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Plane.upperHalf)
      by Plane.ContinuousOn.of_agreeing(
          g := (x : Plane.Point) ↦
                   secondArc(Plane.retime(2, -(1 : ℝ))(x)));

  -- The halves are closed and cover, so pasting closes the argument.
  Plane.lowerHalf ∪ Plane.upperHalf = Plane.unitSegment
      by Plane.halves_cover as halvesCover;
  Plane.ClosedIn(Plane.lowerHalf, Plane.unitSegment)
      by Plane.lowerHalf_ClosedIn;
  Plane.ClosedIn(Plane.upperHalf, Plane.unitSegment)
      by Plane.upperHalf_ClosedIn;
  Plane.ClosedIn(Plane.lowerHalf, Plane.lowerHalf ∪ Plane.upperHalf)
      by substituting halvesCover;
  Plane.ClosedIn(Plane.upperHalf, Plane.lowerHalf ∪ Plane.upperHalf)
      by substituting halvesCover;
  Plane.ContinuousOn(
      Plane.concatenate(firstArc, secondArc),
      Plane.lowerHalf ∪ Plane.upperHalf)
      by Plane.ContinuousOn.paste;
  done by substituting halvesCover
}

-- ----------------------------------------------------------------------
-- Injectivity, and the theorem.
--
-- Inside one half it is that arc's own injectivity, carried back through
-- the retiming. Across the halves the two values agree, so the value lies
-- on both arcs — and the arcs were assumed to meet only at the shared
-- endpoint, which pins both parameters to the midpoint.

theorem Plane.retime_InjectiveOn (scale shift : ℝ) (scaleNonzero : scale ≠ 0)
        (carrier : Set(Plane.Point)) (inside : carrier ⊆ Plane.unitSegment)
        : Plane.InjectiveOn(Plane.retime(scale, shift), carrier) := {
  take x : Plane.Point;
  suppose x ∈ carrier as xInCarrier;
  take y : Plane.Point;
  suppose y ∈ carrier as yInCarrier;
  suppose Plane.retime(scale, shift)(x) = Plane.retime(scale, shift)(y)
      as sameImage;
  x ∈ Plane.unitSegment by inside;
  y ∈ Plane.unitSegment by inside;
  Plane.distance(Plane.origin, Plane.Point.make(1, 0)) = 1
      by Plane.unitSegment_length;
  Plane.origin ≠ Plane.Point.make(1, 0)
      by (degenerate : Plane.origin = Plane.Point.make(1, 0)) ↦ {
        (1 : ℝ)
           = Plane.distance(Plane.origin, Plane.Point.make(1, 0))
                           = Plane.distance(Plane.origin, Plane.origin)
                 by substituting degenerate
           = 0 by Plane.distance_self;
        (1 : ℝ) ≠ 0;
        done
      };
  scale * Plane.Point.first(x) + shift = scale * Plane.Point.first(y) + shift
      by Plane.between_injective as sameParameter;
  scale * Plane.Point.first(x) = scale * Plane.Point.first(y)
      by linear_combination(sameParameter);
  Plane.Point.first(x) = Plane.Point.first(y)
      by Real.equal_of_multiply_left;
  done by Plane.unitSegment_equal_of_first_coordinate
}


-- At the seam the value is the shared endpoint, and injectivity of the arc
-- it belongs to pins the parameter to the midpoint. The two halves need
-- the statement separately, since they retime differently.

theorem Plane.lowerHalf_at_finish_is_midpoint
        (firstArc : Plane.Point → Plane.Point)
        (firstInjective : Plane.InjectiveOn(firstArc, Plane.unitSegment))
        (x : Plane.Point) (inLower : x ∈ Plane.lowerHalf)
        (atFinish
            : firstArc(Plane.retime(2, 0)(x)) = Plane.arcFinish(firstArc))
        : Plane.Point.first(x) = 1 / 2 := {
  Plane.retime(2, 0)(x) ∈ Plane.unitSegment
      by Plane.lowerHalf_retime_lands;
  Plane.Point.make(1, 0) ∈ Plane.unitSegment by Plane.finish_in_unitSegment;
  firstArc(Plane.retime(2, 0)(x)) = firstArc(Plane.Point.make(1, 0))
      by atFinish;
  Plane.retime(2, 0)(x) = Plane.Point.make(1, 0)
      by firstInjective as reachesFinish;
  Plane.Point.first(Plane.retime(2, 0)(x))
     = 2 * Plane.Point.first(x) + 0 by Plane.retime_parameter;
  Plane.Point.first(Plane.retime(2, 0)(x))
     = Plane.Point.first(Plane.Point.make(1, 0)) by substituting reachesFinish;
  2 * Plane.Point.first(x) + 0 = 1 as doubledIsOne;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  2 * Plane.Point.first(x) = 2 * (1 / 2)
      by linear_combination(doubledIsOne - halfDoubles);
  done by Real.equal_of_multiply_left
}

theorem Plane.upperHalf_at_start_is_midpoint
        (secondArc : Plane.Point → Plane.Point)
        (secondInjective : Plane.InjectiveOn(secondArc, Plane.unitSegment))
        (y : Plane.Point) (inUpper : y ∈ Plane.upperHalf)
        (atStart
            : secondArc(Plane.retime(2, -(1 : ℝ))(y))
                  = Plane.arcStart(secondArc))
        : Plane.Point.first(y) = 1 / 2 := {
  Plane.retime(2, -(1 : ℝ))(y) ∈ Plane.unitSegment
      by Plane.upperHalf_retime_lands;
  Plane.origin ∈ Plane.unitSegment by Plane.start_in_unitSegment;
  secondArc(Plane.retime(2, -(1 : ℝ))(y)) = secondArc(Plane.origin)
      by atStart;
  Plane.retime(2, -(1 : ℝ))(y) = Plane.origin
      by secondInjective as reachesStart;
  Plane.Point.first(Plane.retime(2, -(1 : ℝ))(y))
     = 2 * Plane.Point.first(y) + -(1 : ℝ) by Plane.retime_parameter;
  Plane.Point.first(Plane.retime(2, -(1 : ℝ))(y))
     = Plane.Point.first(Plane.origin) by substituting reachesStart;
  2 * Plane.Point.first(y) + -(1 : ℝ) = 0 as doubledIsZero;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  2 * Plane.Point.first(y) = 2 * (1 / 2)
      by linear_combination(doubledIsZero - halfDoubles);
  done by Real.equal_of_multiply_left
}

-- Across the seam: the common value lies on both arcs, so it is the
-- shared endpoint, and each half's injectivity pins its own parameter to
-- the midpoint. Stated for a point of each half rather than for `x` and
-- `y`, so that the two orderings of the case split are the same theorem.
theorem Plane.concatenate_across_seam
        (firstArc secondArc : Plane.Point → Plane.Point)
        (firstInjective : Plane.InjectiveOn(firstArc, Plane.unitSegment))
        (secondInjective : Plane.InjectiveOn(secondArc, Plane.unitSegment))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (meetOnlyThere
            : ∀ (z : Plane.Point). z ∈ Plane.arc(firstArc) →
                z ∈ Plane.arc(secondArc) → z = Plane.arcFinish(firstArc))
        (low high : Plane.Point)
        (lowInLower : low ∈ Plane.lowerHalf)
        (highInUpper : high ∈ Plane.upperHalf)
        (sameValue
            : Plane.concatenate(firstArc, secondArc)(low)
                  = Plane.concatenate(firstArc, secondArc)(high))
        : low = high := {
  low ∈ Plane.unitSegment;
  high ∈ Plane.unitSegment;
  Plane.retime(2, 0)(low) ∈ Plane.unitSegment
      by Plane.lowerHalf_retime_lands;
  Plane.retime(2, -(1 : ℝ))(high) ∈ Plane.unitSegment
      by Plane.upperHalf_retime_lands;
  Plane.concatenate(firstArc, secondArc)(low)
      = firstArc(Plane.retime(2, 0)(low)) by Logic.if_positive as valueAtLow;
  Plane.concatenate(firstArc, secondArc)(high)
      = secondArc(Plane.retime(2, -(1 : ℝ))(high))
      by Logic.if_negative as valueAtHigh;

  let shared : Plane.Point := firstArc(Plane.retime(2, 0)(low));
  shared ∈ Plane.arc(firstArc)
      by { witness Plane.retime(2, 0)(low) with done };
  shared
     = Plane.concatenate(firstArc, secondArc)(low) by valueAtLow
     = Plane.concatenate(firstArc, secondArc)(high) by sameValue
     = secondArc(Plane.retime(2, -(1 : ℝ))(high)) by valueAtHigh
     as sharedOnSecond;
  secondArc(Plane.retime(2, -(1 : ℝ))(high)) = shared by Equality.symmetry;
  shared ∈ Plane.arc(secondArc)
      by { witness Plane.retime(2, -(1 : ℝ))(high) with done };
  shared = Plane.arcFinish(firstArc) by meetOnlyThere;

  firstArc(Plane.retime(2, 0)(low)) = Plane.arcFinish(firstArc);
  Plane.Point.first(low) = 1 / 2 by Plane.lowerHalf_at_finish_is_midpoint;
  secondArc(Plane.retime(2, -(1 : ℝ))(high)) = Plane.arcFinish(firstArc)
      by substituting sharedOnSecond;
  secondArc(Plane.retime(2, -(1 : ℝ))(high)) = Plane.arcStart(secondArc)
      by sharedEndpoint;
  Plane.Point.first(high) = 1 / 2 by Plane.upperHalf_at_start_is_midpoint;
  Plane.Point.first(low) = Plane.Point.first(high);
  done by Plane.unitSegment_equal_of_first_coordinate
}

-- Two arcs meeting only at the endpoint they share concatenate to an arc.
theorem Plane.IsArc.concatenate
        (firstArc secondArc : Plane.Point → Plane.Point)
        (firstIsArc : Plane.IsArc(firstArc))
        (secondIsArc : Plane.IsArc(secondArc))
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        (meetOnlyThere
            : ∀ (z : Plane.Point). z ∈ Plane.arc(firstArc) →
                z ∈ Plane.arc(secondArc) → z = Plane.arcFinish(firstArc))
        : Plane.IsArc(Plane.concatenate(firstArc, secondArc)) := {
  Plane.ContinuousOn(firstArc, Plane.unitSegment);
  Plane.InjectiveOn(firstArc, Plane.unitSegment) as firstInjective;
  Plane.ContinuousOn(secondArc, Plane.unitSegment);
  Plane.InjectiveOn(secondArc, Plane.unitSegment) as secondInjective;
  Plane.ContinuousOn(
      Plane.concatenate(firstArc, secondArc), Plane.unitSegment)
      by Plane.concatenate_ContinuousOn;

  Plane.lowerHalf ⊆ Plane.unitSegment
      by (x : Plane.Point) (inLower : x ∈ Plane.lowerHalf) ↦ {
        x ∈ Plane.unitSegment;
        done
      };
  Plane.upperHalf ⊆ Plane.unitSegment
      by (x : Plane.Point) (inUpper : x ∈ Plane.upperHalf) ↦ {
        x ∈ Plane.unitSegment;
        done
      };
  (2 : ℝ) ≠ 0;
  Plane.InjectiveOn(Plane.retime(2, 0), Plane.lowerHalf)
      by Plane.retime_InjectiveOn as lowerRetimeInjective;
  Plane.InjectiveOn(Plane.retime(2, -(1 : ℝ)), Plane.upperHalf)
      by Plane.retime_InjectiveOn as upperRetimeInjective;

  Plane.InjectiveOn(
      Plane.concatenate(firstArc, secondArc), Plane.unitSegment)
      by (x : Plane.Point) (xOnSegment : x ∈ Plane.unitSegment)
         (y : Plane.Point) (yOnSegment : y ∈ Plane.unitSegment)
         (sameValue : Plane.concatenate(firstArc, secondArc)(x)
                          = Plane.concatenate(firstArc, secondArc)(y)) ↦ {
        done by cases {
          case Plane.Point.first(x) ≤ 1 / 2 as xLow: {
              x ∈ Plane.lowerHalf;
              Plane.retime(2, 0)(x) ∈ Plane.unitSegment
                  by Plane.lowerHalf_retime_lands;
              Plane.concatenate(firstArc, secondArc)(x)
                  = firstArc(Plane.retime(2, 0)(x)) by Logic.if_positive;
              done by cases {
                case Plane.Point.first(y) ≤ 1 / 2 as yLow: {
                    -- Both in the first arc: its injectivity, retimed.
                    y ∈ Plane.lowerHalf;
                    Plane.retime(2, 0)(y) ∈ Plane.unitSegment
                        by Plane.lowerHalf_retime_lands;
                    Plane.concatenate(firstArc, secondArc)(y)
                        = firstArc(Plane.retime(2, 0)(y))
                        by Logic.if_positive as valueAtY;
                    firstArc(Plane.retime(2, 0)(x))
                       = Plane.concatenate(firstArc, secondArc)(x)
                       = Plane.concatenate(firstArc, secondArc)(y) by sameValue
                       = firstArc(Plane.retime(2, 0)(y)) by valueAtY;
                    Plane.retime(2, 0)(x) = Plane.retime(2, 0)(y)
                        by firstInjective;
                    done by lowerRetimeInjective
                  }
                otherwise as yHigh: {
                    1 / 2 ≤ Plane.Point.first(y)
                        by Real.not_LessOrEqual_implies;
                    y ∈ Plane.upperHalf;
                    done by Plane.concatenate_across_seam
                  }
              }
            }
          otherwise as xHigh: {
              1 / 2 ≤ Plane.Point.first(x) by Real.not_LessOrEqual_implies;
              x ∈ Plane.upperHalf;
              Plane.retime(2, -(1 : ℝ))(x) ∈ Plane.unitSegment
                  by Plane.upperHalf_retime_lands;
              Plane.concatenate(firstArc, secondArc)(x)
                  = secondArc(Plane.retime(2, -(1 : ℝ))(x)) by Logic.if_negative;
              done by cases {
                case Plane.Point.first(y) ≤ 1 / 2 as yLow: {
                    y ∈ Plane.lowerHalf;
                    Plane.concatenate(firstArc, secondArc)(y)
                        = Plane.concatenate(firstArc, secondArc)(x) by sameValue;
                    y = x by Plane.concatenate_across_seam;
                    done
                  }
                otherwise as yHigh: {
                    -- Both in the second arc.
                    1 / 2 ≤ Plane.Point.first(y)
                        by Real.not_LessOrEqual_implies;
                    y ∈ Plane.upperHalf;
                    Plane.retime(2, -(1 : ℝ))(y) ∈ Plane.unitSegment
                        by Plane.upperHalf_retime_lands;
                    Plane.concatenate(firstArc, secondArc)(y)
                        = secondArc(Plane.retime(2, -(1 : ℝ))(y))
                        by Logic.if_negative as valueAtY;
                    secondArc(Plane.retime(2, -(1 : ℝ))(x))
                       = Plane.concatenate(firstArc, secondArc)(x)
                       = Plane.concatenate(firstArc, secondArc)(y) by sameValue
                       = secondArc(Plane.retime(2, -(1 : ℝ))(y)) by valueAtY;
                    Plane.retime(2, -(1 : ℝ))(x)
                        = Plane.retime(2, -(1 : ℝ))(y) by secondInjective;
                    done by upperRetimeInjective
                  }
              }
            }
        }
      };
  done
}

-- ----------------------------------------------------------------------
-- What the concatenation covers.
--
-- Each half retimes ONTO the whole model interval — the point at half the
-- parameter is the one that doubles to it — so the glued map's image is
-- exactly the two arcs together.

theorem Plane.lowerHalf_retime_onto (u : Plane.Point)
        (onSegment : u ∈ Plane.unitSegment)
        : ∃ (x : Plane.Point). x ∈ Plane.lowerHalf
            ∧ Plane.retime(2, 0)(x) = u := {
  -- Half a parameter is written as a product, not a quotient: a division
  -- carries its nonzero proof and the sign battery reads it as an atom.
  0 ≤ Plane.Point.first(u) by Plane.first_coordinate_nonneg_on_unitSegment;
  Plane.Point.first(u) ≤ 1
      by Plane.first_coordinate_atMostOne_on_unitSegment;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  (0 : ℝ) < 1 / 2 by Plane.midpoint_positive;
  Real.IsNonneg(1 / 2);
  Real.IsNonneg(Plane.Point.first(u));
  0 ≤ Plane.Point.first(u) * (1 / 2);
  Plane.Point.first(u) * (1 / 2) ≤ 1 * (1 / 2)
      by Real.LessOrEqual.multiply_by_nonneg_right;
  (1 : ℝ) * (1 / 2) ≤ 1 by ordered_field;
  Plane.Point.first(u) * (1 / 2) ≤ 1;
  let source : Plane.Point := Plane.walk(Plane.Point.first(u) * (1 / 2));
  source ∈ Plane.unitSegment
      by { witness Plane.Point.first(u) * (1 / 2) with done };
  Plane.Point.first(source) = Plane.Point.first(u) * (1 / 2)
      by Plane.first_of_walk as sourceParameter;
  Plane.Point.first(source) ≤ 1 / 2;
  source ∈ Plane.lowerHalf;
  2 * Plane.Point.first(source) + 0 = Plane.Point.first(u)
      by linear_combination(
          2 * sourceParameter + Plane.Point.first(u) * halfDoubles)
      as doubledParameter;
  Plane.retime(2, 0)(source)
     = Plane.walk(2 * Plane.Point.first(source) + 0)
     = Plane.walk(Plane.Point.first(u)) by substituting doubledParameter
     = u by Plane.unitSegment_at_first_coordinate;
  done by { witness source with done }
}

theorem Plane.upperHalf_retime_onto (u : Plane.Point)
        (onSegment : u ∈ Plane.unitSegment)
        : ∃ (x : Plane.Point). x ∈ Plane.upperHalf
            ∧ Plane.retime(2, -(1 : ℝ))(x) = u := {
  0 ≤ Plane.Point.first(u) by Plane.first_coordinate_nonneg_on_unitSegment;
  Plane.Point.first(u) ≤ 1
      by Plane.first_coordinate_atMostOne_on_unitSegment;
  (2 : ℝ) ≠ 0;
  (2 : ℝ) * (1 / 2) = 1 by Real.divide_cancel as halfDoubles;
  (0 : ℝ) < 1 / 2 by Plane.midpoint_positive;
  Real.IsNonneg(1 / 2);
  Real.IsNonneg(Plane.Point.first(u));
  0 ≤ Plane.Point.first(u) * (1 / 2);
  Plane.Point.first(u) * (1 / 2) ≤ 1 * (1 / 2)
      by Real.LessOrEqual.multiply_by_nonneg_right;
  0 ≤ Plane.Point.first(u) * (1 / 2) + 1 / 2 by ordered_field;
  Plane.Point.first(u) * (1 / 2) + 1 / 2 ≤ 1 by ordered_field;
  let source : Plane.Point :=
      Plane.walk(Plane.Point.first(u) * (1 / 2) + 1 / 2);
  source ∈ Plane.unitSegment
      by { witness Plane.Point.first(u) * (1 / 2) + 1 / 2 with done };
  Plane.Point.first(source) = Plane.Point.first(u) * (1 / 2) + 1 / 2
      by Plane.first_of_walk as sourceParameter;
  1 / 2 ≤ Plane.Point.first(source) by ordered_field;
  source ∈ Plane.upperHalf;
  2 * Plane.Point.first(source) + -(1 : ℝ) = Plane.Point.first(u)
      by linear_combination(
          2 * sourceParameter + Plane.Point.first(u) * halfDoubles
              + halfDoubles)
      as doubledParameter;
  Plane.retime(2, -(1 : ℝ))(source)
     = Plane.walk(2 * Plane.Point.first(source) + -(1 : ℝ))
     = Plane.walk(Plane.Point.first(u)) by substituting doubledParameter
     = u by Plane.unitSegment_at_first_coordinate;
  done by { witness source with done }
}

-- The glued arc covers exactly the two it was glued from.
theorem Plane.arc_concatenate
        (firstArc secondArc : Plane.Point → Plane.Point)
        (sharedEndpoint
            : Plane.arcFinish(firstArc) = Plane.arcStart(secondArc))
        : Plane.arc(Plane.concatenate(firstArc, secondArc))
              = Plane.arc(firstArc) ∪ Plane.arc(secondArc) := {
  Plane.arc(Plane.concatenate(firstArc, secondArc))
      ⊆ Plane.arc(firstArc) ∪ Plane.arc(secondArc)
      by (value : Plane.Point)
         (onGlued : value ∈ Plane.arc(Plane.concatenate(firstArc, secondArc))) ↦ {
        choose source such that
            source ∈ Plane.unitSegment
              ∧ Plane.concatenate(firstArc, secondArc)(source) = value
            from onGlued;
        source ∈ Plane.unitSegment;
        Plane.concatenate(firstArc, secondArc)(source) = value;
        done by cases {
          case Plane.Point.first(source) ≤ 1 / 2 as low: {
              source ∈ Plane.lowerHalf;
              Plane.retime(2, 0)(source) ∈ Plane.unitSegment
                  by Plane.lowerHalf_retime_lands;
              firstArc(Plane.retime(2, 0)(source)) = value
                  by Logic.if_positive;
              value ∈ Plane.arc(firstArc)
                  by { witness Plane.retime(2, 0)(source) with done };
              done
            }
          otherwise as high: {
              1 / 2 ≤ Plane.Point.first(source)
                  by Real.not_LessOrEqual_implies;
              source ∈ Plane.upperHalf;
              Plane.retime(2, -(1 : ℝ))(source) ∈ Plane.unitSegment
                  by Plane.upperHalf_retime_lands;
              secondArc(Plane.retime(2, -(1 : ℝ))(source)) = value
                  by Logic.if_negative;
              value ∈ Plane.arc(secondArc)
                  by { witness Plane.retime(2, -(1 : ℝ))(source) with done };
              done
            }
        }
      };

  Plane.arc(firstArc) ∪ Plane.arc(secondArc)
      ⊆ Plane.arc(Plane.concatenate(firstArc, secondArc))
      by (value : Plane.Point)
         (onEither : value ∈ Plane.arc(firstArc) ∪ Plane.arc(secondArc)) ↦ {
        done by cases {
          case value ∈ Plane.arc(firstArc) as onFirst: {
              choose source such that
                  source ∈ Plane.unitSegment ∧ firstArc(source) = value
                  from onFirst;
              source ∈ Plane.unitSegment;
              firstArc(source) = value as valueAtSource;
              choose glued such that
                  glued ∈ Plane.lowerHalf ∧ Plane.retime(2, 0)(glued) = source
                  from Plane.lowerHalf_retime_onto;
              glued ∈ Plane.lowerHalf;
              Plane.retime(2, 0)(glued) = source as retimesToSource;
              glued ∈ Plane.unitSegment;
              Plane.concatenate(firstArc, secondArc)(glued)
                 = firstArc(Plane.retime(2, 0)(glued)) by Logic.if_positive
                 = firstArc(source) by substituting retimesToSource
                 = value by valueAtSource;
              done by { witness glued with done }
            }
          case value ∈ Plane.arc(secondArc) as onSecond: {
              choose source such that
                  source ∈ Plane.unitSegment ∧ secondArc(source) = value
                  from onSecond;
              source ∈ Plane.unitSegment;
              secondArc(source) = value as valueAtSource;
              choose glued such that
                  glued ∈ Plane.upperHalf
                    ∧ Plane.retime(2, -(1 : ℝ))(glued) = source
                  from Plane.upperHalf_retime_onto;
              glued ∈ Plane.upperHalf;
              Plane.retime(2, -(1 : ℝ))(glued) = source as retimesToSource;
              glued ∈ Plane.unitSegment;
              Plane.concatenate(firstArc, secondArc)(glued)
                 = secondArc(Plane.retime(2, -(1 : ℝ))(glued))
                  by Plane.concatenate_value_on_upperHalf
                 = secondArc(source) by substituting retimesToSource
                 = value by valueAtSource;
              done by { witness glued with done }
            }
        }
      };
  done by Set.equal_of_same_members
}
