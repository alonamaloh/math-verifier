-- Plane/norm.math
--
-- Length and distance. The Euclidean norm is the primary one — it is what
-- a mathematician reaches for without thinking, and the development should
-- support that — with the sup norm alongside for the axis-parallel squares
-- the polygonal work is built on.
--
-- `Real.square_root` takes the nonnegativity of its argument as an
-- argument. That obligation is discharged ONCE, here in the definition,
-- from `innerProduct_self_nonneg`. Downstream `norm(v)` takes only `v`,
-- and no proof term ever appears at a call site.

module Plane.norm

import Logic.basics
import Equality.basics
import Real.interface
import Real.square_root
import Real.maximum
import Real.absolute_value
import Real.absolute_value_order
import Real.order_multiplication
import Plane.vector
import Plane.bilinear
import Plane.direction
import Plane.point

-- ----------------------------------------------------------------------
-- The Euclidean norm.

definition Plane.Vector.norm (v : Plane.Vector) : ℝ :=
  Real.square_root(
      Plane.Vector.innerProduct(v, v),
      Plane.Vector.innerProduct_self_nonneg(v))

theorem Plane.Vector.norm_nonneg (v : Plane.Vector)
        : 0 ≤ Plane.Vector.norm(v) :=
  done by Real.square_root_nonneg

-- The defining property: the norm squares back to the squared length.
-- Every estimate below goes through this rather than through the root.
theorem Plane.Vector.norm_squared (v : Plane.Vector)
        : Plane.Vector.norm(v) * Plane.Vector.norm(v)
              = Plane.Vector.innerProduct(v, v) :=
  done

-- ----------------------------------------------------------------------
-- Each coordinate is bounded by the norm: its square is one of the two
-- summands of the squared length.

theorem Plane.Vector.absolute_first_LessOrEqual_norm (v : Plane.Vector)
        : abs(Plane.Vector.first(v)) ≤ Plane.Vector.norm(v) := {
  0 ≤ Plane.Vector.norm(v) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.second(v) * Plane.Vector.second(v);
  abs(Plane.Vector.first(v)) * abs(Plane.Vector.first(v))
     = Plane.Vector.first(v) * Plane.Vector.first(v)
     ≤ Plane.Vector.first(v) * Plane.Vector.first(v)
           + Plane.Vector.second(v) * Plane.Vector.second(v)
     = Plane.Vector.innerProduct(v, v)
     = Plane.Vector.norm(v) * Plane.Vector.norm(v)
           by Plane.Vector.norm_squared;
  done by Real.LessOrEqual_of_square_LessOrEqual
}

theorem Plane.Vector.absolute_second_LessOrEqual_norm (v : Plane.Vector)
        : abs(Plane.Vector.second(v)) ≤ Plane.Vector.norm(v) := {
  0 ≤ Plane.Vector.norm(v) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.first(v) * Plane.Vector.first(v);
  abs(Plane.Vector.second(v)) * abs(Plane.Vector.second(v))
     = Plane.Vector.second(v) * Plane.Vector.second(v)
     = 0 + Plane.Vector.second(v) * Plane.Vector.second(v)
     ≤ Plane.Vector.first(v) * Plane.Vector.first(v)
           + Plane.Vector.second(v) * Plane.Vector.second(v)
     = Plane.Vector.innerProduct(v, v)
     = Plane.Vector.norm(v) * Plane.Vector.norm(v)
           by Plane.Vector.norm_squared;
  done by Real.LessOrEqual_of_square_LessOrEqual
}

-- ----------------------------------------------------------------------
-- The sup norm, and the half of the comparison that needs no root.

definition Plane.Vector.supNorm (v : Plane.Vector) : ℝ :=
  max(abs(Plane.Vector.first(v)), abs(Plane.Vector.second(v)))

theorem Plane.Vector.supNorm_nonneg (v : Plane.Vector)
        : 0 ≤ Plane.Vector.supNorm(v) := {
  0 ≤ abs(Plane.Vector.first(v));
  done
}

-- `‖v‖∞ ≤ ‖v‖`: both coordinates are below the norm, so their maximum is.
theorem Plane.Vector.supNorm_LessOrEqual_norm (v : Plane.Vector)
        : Plane.Vector.supNorm(v) ≤ Plane.Vector.norm(v) := {
  abs(Plane.Vector.first(v)) ≤ Plane.Vector.norm(v)
      by Plane.Vector.absolute_first_LessOrEqual_norm;
  abs(Plane.Vector.second(v)) ≤ Plane.Vector.norm(v)
      by Plane.Vector.absolute_second_LessOrEqual_norm;
  done
}

-- Scaling a vector scales its sup norm, exactly as it scales the
-- Euclidean one. Both coordinates pick up the same factor, and a
-- nonnegative factor passes through the maximum.
theorem Plane.Vector.supNorm_scale (factor : ℝ) (v : Plane.Vector)
        : Plane.Vector.supNorm(factor * v)
              = abs(factor) * Plane.Vector.supNorm(v) := {
  abs(factor) ≥ 0;
  Plane.Vector.first(factor * v) = factor * Plane.Vector.first(v)
      by Plane.Vector.first_scale as firstScaled;
  Plane.Vector.second(factor * v) = factor * Plane.Vector.second(v)
      by Plane.Vector.second_scale as secondScaled;
  abs(factor * Plane.Vector.first(v)) = abs(factor) * abs(Plane.Vector.first(v))
      by Real.absolute_value_multiplicative as firstFactored;
  abs(factor * Plane.Vector.second(v)) = abs(factor) * abs(Plane.Vector.second(v))
      by Real.absolute_value_multiplicative as secondFactored;
  Plane.Vector.supNorm(factor * v)
     = max(abs(Plane.Vector.first(factor * v)), abs(Plane.Vector.second(factor * v)))
     = max(abs(factor * Plane.Vector.first(v)), abs(Plane.Vector.second(factor * v)))
           by substituting firstScaled
     = max(abs(factor * Plane.Vector.first(v)), abs(factor * Plane.Vector.second(v)))
           by substituting secondScaled
     = max(abs(factor) * abs(Plane.Vector.first(v)),
           abs(factor * Plane.Vector.second(v)))
           by substituting firstFactored
     = max(abs(factor) * abs(Plane.Vector.first(v)),
           abs(factor) * abs(Plane.Vector.second(v)))
           by substituting secondFactored
     = abs(factor) * max(abs(Plane.Vector.first(v)), abs(Plane.Vector.second(v)))
           by Real.maximum_scale
     = abs(factor) * Plane.Vector.supNorm(v);
  done
}

-- ----------------------------------------------------------------------
-- Distance between points, in both metrics.

definition Plane.distance (p q : Plane.Point) : ℝ :=
  Plane.Vector.norm(q - p)

definition Plane.supDistance (p q : Plane.Point) : ℝ :=
  Plane.Vector.supNorm(q - p)

theorem Plane.distance_nonneg (p q : Plane.Point)
        : 0 ≤ Plane.distance(p, q) :=
  done by Plane.Vector.norm_nonneg

theorem Plane.supDistance_LessOrEqual_distance (p q : Plane.Point)
        : Plane.supDistance(p, q) ≤ Plane.distance(p, q) :=
  done by Plane.Vector.supNorm_LessOrEqual_norm

theorem Plane.supDistance_nonneg (p q : Plane.Point)
        : 0 ≤ Plane.supDistance(p, q) :=
  done by Plane.Vector.supNorm_nonneg

-- The distance between two points named by their coordinates. A square
-- root is not a computation, so the caller names the value and this checks
-- its square — which for concrete points is ground arithmetic, and for
-- symbolic ones is `ring`.
theorem Plane.distance_make
        (firstStart secondStart firstFinish secondFinish value : ℝ)
        (valueNonneg : 0 ≤ value)
        (squares
            : (firstFinish - firstStart) * (firstFinish - firstStart)
                  + (secondFinish - secondStart) * (secondFinish - secondStart)
                = value * value)
        : Plane.distance(
              Plane.Point.make(firstStart, secondStart),
              Plane.Point.make(firstFinish, secondFinish)) = value := {
  let start : Plane.Point := Plane.Point.make(firstStart, secondStart);
  let finish : Plane.Point := Plane.Point.make(firstFinish, secondFinish);
  Plane.Vector.first(finish - start) = firstFinish - firstStart
      by Plane.Point.first_difference;
  Plane.Vector.second(finish - start) = secondFinish - secondStart
      by Plane.Point.second_difference;
  Plane.distance(start, finish) * Plane.distance(start, finish)
     = Plane.Vector.innerProduct(finish - start, finish - start)
           by Plane.Vector.norm_squared
     = (firstFinish - firstStart) * (firstFinish - firstStart)
           + (secondFinish - secondStart) * (secondFinish - secondStart)
     = value * value by squares;
  0 ≤ Plane.distance(start, finish) by Plane.distance_nonneg;
  done by Real.equal_of_square_equal_nonneg
}

-- ----------------------------------------------------------------------
-- The sup metric obeys the triangle inequality too, and coordinatewise
-- the proof is where it belongs: each coordinate of a sum is below the
-- sum of the two sup norms, and a bound on both coordinates bounds their
-- maximum.

theorem Plane.Vector.supNorm_triangle (u v : Plane.Vector)
        : Plane.Vector.supNorm(u + v)
              ≤ Plane.Vector.supNorm(u) + Plane.Vector.supNorm(v) := {
  abs(Plane.Vector.first(u)) ≤ Plane.Vector.supNorm(u);
  abs(Plane.Vector.second(u)) ≤ Plane.Vector.supNorm(u);
  abs(Plane.Vector.first(v)) ≤ Plane.Vector.supNorm(v);
  abs(Plane.Vector.second(v)) ≤ Plane.Vector.supNorm(v);
  abs(Plane.Vector.first(u + v))
     = abs(Plane.Vector.first(u) + Plane.Vector.first(v))
           by Plane.Vector.first_add
     ≤ abs(Plane.Vector.first(u)) + abs(Plane.Vector.first(v))
     ≤ Plane.Vector.supNorm(u) + Plane.Vector.supNorm(v);
  abs(Plane.Vector.second(u + v))
     = abs(Plane.Vector.second(u) + Plane.Vector.second(v))
           by Plane.Vector.second_add
     ≤ abs(Plane.Vector.second(u)) + abs(Plane.Vector.second(v))
     ≤ Plane.Vector.supNorm(u) + Plane.Vector.supNorm(v);
  done by Real.maximum_LessOrEqual
}

-- The sup norm ignores sign: each coordinate keeps its absolute value, so
-- the two maxima bound each other.
theorem Plane.Vector.supNorm_negate (v : Plane.Vector)
        : Plane.Vector.supNorm(-v) = Plane.Vector.supNorm(v) := {
  abs(Plane.Vector.first(-v))
     = abs(-Plane.Vector.first(v)) by Plane.Vector.first_negate
     = abs(Plane.Vector.first(v)) by Real.absolute_value_negate
     ≤ Plane.Vector.supNorm(v);
  abs(Plane.Vector.second(-v))
     = abs(-Plane.Vector.second(v)) by Plane.Vector.second_negate
     = abs(Plane.Vector.second(v)) by Real.absolute_value_negate
     ≤ Plane.Vector.supNorm(v);
  Plane.Vector.supNorm(-v) ≤ Plane.Vector.supNorm(v)
      by Real.maximum_LessOrEqual;
  abs(Plane.Vector.first(v))
     = abs(-Plane.Vector.first(v)) by Real.absolute_value_negate
     = abs(Plane.Vector.first(-v)) by Plane.Vector.first_negate
     ≤ Plane.Vector.supNorm(-v);
  abs(Plane.Vector.second(v))
     = abs(-Plane.Vector.second(v)) by Real.absolute_value_negate
     = abs(Plane.Vector.second(-v)) by Plane.Vector.second_negate
     ≤ Plane.Vector.supNorm(-v);
  Plane.Vector.supNorm(v) ≤ Plane.Vector.supNorm(-v)
      by Real.maximum_LessOrEqual;
  done by Real.LessOrEqual.antisymmetric
}

-- The sup distance does not care about order: reversing the displacement
-- negates it, and the sup norm does not see the sign.
theorem Plane.supDistance_symmetric (p q : Plane.Point)
        : Plane.supDistance(p, q) = Plane.supDistance(q, p) :=
  Plane.Vector.supNorm(q - p)
     = Plane.Vector.supNorm(-(p - q)) by Plane.Point.difference_reverse
     = Plane.Vector.supNorm(p - q) by Plane.Vector.supNorm_negate

theorem Plane.supDistance_triangle (p q r : Plane.Point)
        : Plane.supDistance(p, r)
              ≤ Plane.supDistance(p, q) + Plane.supDistance(q, r) :=
  Plane.Vector.supNorm(r - p)
     = Plane.Vector.supNorm((q - p) + (r - q))
           by Plane.Point.difference_chain
     ≤ Plane.Vector.supNorm(q - p) + Plane.Vector.supNorm(r - q)
           by Plane.Vector.supNorm_triangle

-- Moving the far endpoint moves the sup distance by no more than the
-- move: the continuity of `supDistance(center, ·)`, which is what makes
-- a sup-metric level set closed.
theorem Plane.supDistance_shift_bound (center x y : Plane.Point)
        : abs(Plane.supDistance(center, y) - Plane.supDistance(center, x))
              ≤ Plane.supDistance(x, y) := {
  Plane.supDistance(center, y)
      ≤ Plane.supDistance(center, x) + Plane.supDistance(x, y)
      by Plane.supDistance_triangle;
  Plane.supDistance(center, y) - Plane.supDistance(center, x)
      ≤ Plane.supDistance(x, y) by ordered_field;
  Plane.supDistance(center, x)
      ≤ Plane.supDistance(center, y) + Plane.supDistance(y, x)
      by Plane.supDistance_triangle;
  Plane.supDistance(y, x) = Plane.supDistance(x, y)
      by Plane.supDistance_symmetric;
  Plane.supDistance(center, x)
      ≤ Plane.supDistance(center, y) + Plane.supDistance(x, y);
  -Plane.supDistance(x, y)
      ≤ Plane.supDistance(center, y) - Plane.supDistance(center, x)
      by ordered_field;
  done by Real.absolute_value_LessOrEqual_of_bounds
}

-- ----------------------------------------------------------------------
-- The other half of the comparison, `‖v‖ ≤ √2·‖v‖∞`.

theorem Plane.zero_LessOrEqual_two : Real.zero ≤ 2 :=
  done

-- √2, as the length of the diagonal of the unit square.
definition Plane.rootTwo : ℝ :=
  Real.square_root(2, Plane.zero_LessOrEqual_two)

theorem Plane.rootTwo_nonneg : 0 ≤ Plane.rootTwo :=
  done by Real.square_root_nonneg

theorem Plane.rootTwo_squared : Plane.rootTwo * Plane.rootTwo = 2 :=
  done by Real.square_root_squares

-- Each coordinate's square is below the sup norm's, since the coordinate's
-- size is and both are nonnegative.
theorem Plane.Vector.first_square_LessOrEqual_supNorm_square (v : Plane.Vector)
        : Plane.Vector.first(v) * Plane.Vector.first(v)
              ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v) := {
  0 ≤ abs(Plane.Vector.first(v));
  abs(Plane.Vector.first(v)) ≤ Plane.Vector.supNorm(v);
  Plane.Vector.first(v) * Plane.Vector.first(v)
     = abs(Plane.Vector.first(v)) * abs(Plane.Vector.first(v))
     ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v);
  done
}

theorem Plane.Vector.second_square_LessOrEqual_supNorm_square (v : Plane.Vector)
        : Plane.Vector.second(v) * Plane.Vector.second(v)
              ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v) := {
  0 ≤ abs(Plane.Vector.second(v));
  abs(Plane.Vector.second(v)) ≤ Plane.Vector.supNorm(v);
  Plane.Vector.second(v) * Plane.Vector.second(v)
     = abs(Plane.Vector.second(v)) * abs(Plane.Vector.second(v))
     ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v);
  done
}

-- `‖v‖ ≤ √2·‖v‖∞`: the squared length is at most two copies of the sup
-- norm's square, which is the square of √2 times it.
theorem Plane.Vector.norm_LessOrEqual_rootTwo_supNorm (v : Plane.Vector)
        : Plane.Vector.norm(v) ≤ Plane.rootTwo * Plane.Vector.supNorm(v) := {
  0 ≤ Plane.Vector.supNorm(v) by Plane.Vector.supNorm_nonneg;
  0 ≤ Plane.rootTwo by Plane.rootTwo_nonneg;
  0 ≤ Plane.rootTwo * Plane.Vector.supNorm(v);
  Plane.Vector.first(v) * Plane.Vector.first(v)
      ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v)
      by Plane.Vector.first_square_LessOrEqual_supNorm_square;
  Plane.Vector.second(v) * Plane.Vector.second(v)
      ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v)
      by Plane.Vector.second_square_LessOrEqual_supNorm_square;
  Plane.Vector.norm(v) * Plane.Vector.norm(v)
     = Plane.Vector.innerProduct(v, v) by Plane.Vector.norm_squared
     = Plane.Vector.first(v) * Plane.Vector.first(v)
           + Plane.Vector.second(v) * Plane.Vector.second(v)
     ≤ Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v)
           + Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v)
     = 2 * (Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v)) by ring
     = (Plane.rootTwo * Plane.rootTwo)
           * (Plane.Vector.supNorm(v) * Plane.Vector.supNorm(v))
           by Plane.rootTwo_squared
     = (Plane.rootTwo * Plane.Vector.supNorm(v))
           * (Plane.rootTwo * Plane.Vector.supNorm(v)) by ring;
  done by Real.LessOrEqual_of_square_LessOrEqual
}

-- √2 ≤ 2, since 2 ≤ 4 and both sides are nonnegative. Crude, but it is
-- all an ε/2 argument ever needs, and it keeps √2 out of the estimates.
theorem Plane.rootTwo_LessOrEqual_two : Plane.rootTwo ≤ 2 := {
  Real.zero ≤ 2 by Plane.zero_LessOrEqual_two;
  Plane.rootTwo * Plane.rootTwo
     = 2 by Plane.rootTwo_squared
     ≤ 4
     = 2 * 2;
  done by Real.LessOrEqual_of_square_LessOrEqual
}

-- The comparison in the form the ε/2 arguments use.
theorem Plane.Vector.norm_LessOrEqual_two_supNorm (v : Plane.Vector)
        : Plane.Vector.norm(v) ≤ 2 * Plane.Vector.supNorm(v) := {
  0 ≤ Plane.Vector.supNorm(v) by Plane.Vector.supNorm_nonneg;
  Real.IsNonneg(Plane.Vector.supNorm(v));
  Plane.rootTwo ≤ 2 by Plane.rootTwo_LessOrEqual_two;
  Plane.Vector.norm(v)
     ≤ Plane.rootTwo * Plane.Vector.supNorm(v)
           by Plane.Vector.norm_LessOrEqual_rootTwo_supNorm
     ≤ 2 * Plane.Vector.supNorm(v);
  done
}

-- ----------------------------------------------------------------------
-- The triangle inequality.

-- Cauchy--Schwarz, read at the level of lengths rather than squares.
theorem Plane.Vector.innerProduct_LessOrEqual_norm_product (u v : Plane.Vector)
        : Plane.Vector.innerProduct(u, v)
              ≤ Plane.Vector.norm(u) * Plane.Vector.norm(v) := {
  0 ≤ Plane.Vector.norm(u) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.norm(v) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.norm(u) * Plane.Vector.norm(v);
  abs(Plane.Vector.innerProduct(u, v)) * abs(Plane.Vector.innerProduct(u, v))
     = Plane.Vector.innerProduct(u, v) * Plane.Vector.innerProduct(u, v)
     ≤ Plane.Vector.innerProduct(u, u) * Plane.Vector.innerProduct(v, v)
           by Plane.Vector.cauchy_schwarz
     = (Plane.Vector.norm(u) * Plane.Vector.norm(u))
           * Plane.Vector.innerProduct(v, v)
           by Plane.Vector.norm_squared
     = (Plane.Vector.norm(u) * Plane.Vector.norm(u))
           * (Plane.Vector.norm(v) * Plane.Vector.norm(v))
           by Plane.Vector.norm_squared
     = (Plane.Vector.norm(u) * Plane.Vector.norm(v))
           * (Plane.Vector.norm(u) * Plane.Vector.norm(v)) by ring;
  abs(Plane.Vector.innerProduct(u, v))
      ≤ Plane.Vector.norm(u) * Plane.Vector.norm(v)
      by Real.LessOrEqual_of_square_LessOrEqual;
  Plane.Vector.innerProduct(u, v)
     ≤ abs(Plane.Vector.innerProduct(u, v))
     ≤ Plane.Vector.norm(u) * Plane.Vector.norm(v);
  done
}

theorem Plane.Vector.norm_triangle (u v : Plane.Vector)
        : Plane.Vector.norm(u + v)
              ≤ Plane.Vector.norm(u) + Plane.Vector.norm(v) := {
  0 ≤ Plane.Vector.norm(u) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.norm(v) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.norm(u) + Plane.Vector.norm(v);
  Plane.Vector.innerProduct(u, v)
      ≤ Plane.Vector.norm(u) * Plane.Vector.norm(v)
      by Plane.Vector.innerProduct_LessOrEqual_norm_product;
  Real.IsNonneg((2 : ℝ));
  Plane.Vector.innerProduct(u, v) * 2
      ≤ (Plane.Vector.norm(u) * Plane.Vector.norm(v)) * 2;
  Plane.Vector.norm(u + v) * Plane.Vector.norm(u + v)
     = Plane.Vector.innerProduct(u + v, u + v) by Plane.Vector.norm_squared
     = Plane.Vector.innerProduct(u, v) * 2
           + (Plane.Vector.innerProduct(u, u) + Plane.Vector.innerProduct(v, v))
           by Plane.Vector.innerProduct_add_self
     ≤ (Plane.Vector.norm(u) * Plane.Vector.norm(v)) * 2
           + (Plane.Vector.innerProduct(u, u) + Plane.Vector.innerProduct(v, v))
     = (Plane.Vector.norm(u) * Plane.Vector.norm(v)) * 2
           + (Plane.Vector.norm(u) * Plane.Vector.norm(u)
                  + Plane.Vector.innerProduct(v, v))
           by Plane.Vector.norm_squared
     = (Plane.Vector.norm(u) * Plane.Vector.norm(v)) * 2
           + (Plane.Vector.norm(u) * Plane.Vector.norm(u)
                  + Plane.Vector.norm(v) * Plane.Vector.norm(v))
           by Plane.Vector.norm_squared
     = (Plane.Vector.norm(u) + Plane.Vector.norm(v))
           * (Plane.Vector.norm(u) + Plane.Vector.norm(v)) by ring;
  done by Real.LessOrEqual_of_square_LessOrEqual
}

theorem Plane.distance_triangle (p q r : Plane.Point)
        : Plane.distance(p, r) ≤ Plane.distance(p, q) + Plane.distance(q, r) :=
  Plane.Vector.norm(r - p)
     = Plane.Vector.norm((q - p) + (r - q))
           by Plane.Point.difference_chain
     ≤ Plane.Vector.norm(q - p) + Plane.Vector.norm(r - q)
           by Plane.Vector.norm_triangle

-- ----------------------------------------------------------------------
-- Scaling.

theorem Plane.Vector.norm_scale (factor : ℝ) (v : Plane.Vector)
        : Plane.Vector.norm(factor * v)
              = abs(factor) * Plane.Vector.norm(v) := {
  0 ≤ Plane.Vector.norm(factor * v) by Plane.Vector.norm_nonneg;
  0 ≤ abs(factor);
  0 ≤ Plane.Vector.norm(v) by Plane.Vector.norm_nonneg;
  0 ≤ abs(factor) * Plane.Vector.norm(v);
  Plane.Vector.norm(factor * v) * Plane.Vector.norm(factor * v)
     = Plane.Vector.innerProduct(factor * v, factor * v)
           by Plane.Vector.norm_squared
     = factor * Plane.Vector.innerProduct(v, factor * v)
           by Plane.Vector.innerProduct_scale_left
     = factor * (factor * Plane.Vector.innerProduct(v, v))
           by Plane.Vector.innerProduct_scale_right
     = (factor * factor) * Plane.Vector.innerProduct(v, v) by ring
     = (abs(factor) * abs(factor)) * Plane.Vector.innerProduct(v, v)
           by Real.absolute_value_square
     = (abs(factor) * abs(factor))
           * (Plane.Vector.norm(v) * Plane.Vector.norm(v))
           by Plane.Vector.norm_squared
     = (abs(factor) * Plane.Vector.norm(v))
           * (abs(factor) * Plane.Vector.norm(v)) by ring;
  done by Real.equal_of_square_equal_nonneg
}

-- ----------------------------------------------------------------------
-- The zero vector, and a point's distance to itself.

theorem Plane.Vector.norm_zero
        : Plane.Vector.norm(Plane.Vector.zero) = 0 := {
  0 ≤ Plane.Vector.norm(Plane.Vector.zero) by Plane.Vector.norm_nonneg;
  (0 : ℝ) ≤ 0;
  Plane.Vector.norm(Plane.Vector.zero) * Plane.Vector.norm(Plane.Vector.zero)
     = Plane.Vector.innerProduct(Plane.Vector.zero, Plane.Vector.zero)
           by Plane.Vector.norm_squared
     = Plane.Vector.first(Plane.Vector.zero)
           * Plane.Vector.first(Plane.Vector.zero)
       + Plane.Vector.second(Plane.Vector.zero)
           * Plane.Vector.second(Plane.Vector.zero)
     = 0 * 0 + 0 * 0
     = 0 * 0 by ring;
  done
}

theorem Plane.distance_self (p : Plane.Point)
        : Plane.distance(p, p) = 0 :=
  Plane.distance(p, p)
     = Plane.Vector.norm(p - p)
     = Plane.Vector.norm(Plane.Vector.zero) by Plane.Point.difference_self
     = 0 by Plane.Vector.norm_zero

theorem Plane.supDistance_self (p : Plane.Point)
        : Plane.supDistance(p, p) = 0 :=
  Plane.supDistance(p, p)
     = Plane.Vector.supNorm(p - p)
     = Plane.Vector.supNorm(Plane.Vector.zero) by Plane.Point.difference_self
     = max(abs((0 : ℝ)), abs((0 : ℝ)))
     = 0 by Real.maximum_self

-- ----------------------------------------------------------------------
-- The remaining two metric axioms: distance separates points, and does
-- not care about the order of its arguments.

theorem Plane.equal_of_distance_zero (p q : Plane.Point)
        (apart : Plane.distance(p, q) = 0)
        : p = q := {
  Plane.Vector.norm(q - p) = 0;
  Plane.Vector.innerProduct(q - p, q - p)
     = Plane.Vector.norm(q - p) * Plane.Vector.norm(q - p)
           by Plane.Vector.norm_squared
     = 0 * Plane.Vector.norm(q - p)
     = 0 by ring;
  q - p = Plane.Vector.zero
      by Plane.Vector.zero_of_innerProduct_self_zero;
  p + (q - p) = q by Plane.Point.translate_difference;
  p + Plane.Vector.zero = p by Plane.Point.translate_zero;
  q = p + (q - p)
    = p + Plane.Vector.zero
    = p;
  done
}

-- The two difference vectors have opposite coordinates, so the same
-- inner product with themselves.
theorem Plane.distance_symmetric (p q : Plane.Point)
        : Plane.distance(p, q) = Plane.distance(q, p) := {
  0 ≤ Plane.Vector.norm(q - p) by Plane.Vector.norm_nonneg;
  0 ≤ Plane.Vector.norm(p - q) by Plane.Vector.norm_nonneg;
  Plane.Vector.first(p - q)
      = Plane.Point.first(p) - Plane.Point.first(q)
      by Plane.Point.first_difference;
  Plane.Vector.first(q - p)
      = Plane.Point.first(q) - Plane.Point.first(p)
      by Plane.Point.first_difference;
  Plane.Vector.second(p - q)
      = Plane.Point.second(p) - Plane.Point.second(q)
      by Plane.Point.second_difference;
  Plane.Vector.second(q - p)
      = Plane.Point.second(q) - Plane.Point.second(p)
      by Plane.Point.second_difference;
  -- Expanded into coordinates before `ring`: it reads a projection of a
  -- compound as an opaque atom, so the difference vectors have to be gone
  -- by the time it runs.
  Plane.Vector.norm(q - p) * Plane.Vector.norm(q - p)
     = Plane.Vector.innerProduct(q - p, q - p) by Plane.Vector.norm_squared
     = Plane.Vector.first(q - p) * Plane.Vector.first(q - p)
           + Plane.Vector.second(q - p) * Plane.Vector.second(q - p)
     = (Plane.Point.first(q) - Plane.Point.first(p))
           * (Plane.Point.first(q) - Plane.Point.first(p))
       + (Plane.Point.second(q) - Plane.Point.second(p))
           * (Plane.Point.second(q) - Plane.Point.second(p))
     = (Plane.Point.first(p) - Plane.Point.first(q))
           * (Plane.Point.first(p) - Plane.Point.first(q))
       + (Plane.Point.second(p) - Plane.Point.second(q))
           * (Plane.Point.second(p) - Plane.Point.second(q)) by ring
     = Plane.Vector.first(p - q) * Plane.Vector.first(p - q)
           + Plane.Vector.second(p - q) * Plane.Vector.second(p - q)
     = Plane.Vector.innerProduct(p - q, p - q)
     = Plane.Vector.norm(p - q) * Plane.Vector.norm(p - q)
           by Plane.Vector.norm_squared;
  Plane.Vector.norm(q - p) = Plane.Vector.norm(p - q)
      by Real.equal_of_square_equal_nonneg;
  done
}
