-- Plane/topology.math
--
-- Relative topology of the plane. Layer 1 of the Jordan–Schönflies
-- foundation.
--
-- Every notion here is the generic metric-space one from `Metric/`, read
-- at `Plane.Point` through the instance in `Plane/metric.math`. The names
-- are kept because the Jordan–Schönflies development speaks them; the
-- mathematics lives in `Metric/topology.math` and
-- `Metric/continuity.math`, where it is written once and also serves the
-- real line.
--
-- Everything is stated RELATIVE to a carrier set from the start, and the
-- absolute notions are the `carrier = universe` case. That is a
-- deliberate choice, settled in PLAN_JORDAN_SCHOENFLIES.md: connectedness
-- gets applied to arcs and curves as subspaces, and the model-curve
-- parametrization needs compact→Hausdorff on a subspace, so retrofitting
-- relativisation across Layers 1–3 would cost more than paying for it
-- once here.
--
-- `Plane.OpenIn(subset, carrier)` does not require `subset ⊆ carrier` —
-- the ε-ball condition is meaningful without it, and demanding it would
-- add a proof obligation at every use. Consumers that need the inclusion
-- carry it separately.

module Plane.topology

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.minimum
import Metric.space
import Metric.topology
import Metric.continuity
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.metric

-- ----------------------------------------------------------------------
-- Open sets, relative to a carrier.

definition Plane.OpenIn (subset carrier : Set(Plane.Point)) : Proposition :=
  MetricSpace.OpenIn(subset, carrier)

definition Plane.IsOpen (subset : Set(Plane.Point)) : Proposition :=
  MetricSpace.IsOpen(subset)

definition Plane.ClosedIn (subset carrier : Set(Plane.Point)) : Proposition :=
  MetricSpace.ClosedIn(subset, carrier)

-- ----------------------------------------------------------------------
-- The lattice laws.

theorem Plane.OpenIn.universe (carrier : Set(Plane.Point))
        : Plane.OpenIn(Set.universe(Plane.Point), carrier) :=
  done by MetricSpace.OpenIn.universe

theorem Plane.OpenIn.empty (carrier : Set(Plane.Point))
        : Plane.OpenIn(Set.empty(Plane.Point), carrier) :=
  done by MetricSpace.OpenIn.empty

theorem Plane.OpenIn.intersection
        (left right carrier : Set(Plane.Point))
        (leftOpen : Plane.OpenIn(left, carrier))
        (rightOpen : Plane.OpenIn(right, carrier))
        : Plane.OpenIn(left ∩ right, carrier) :=
  done by MetricSpace.OpenIn.intersection

theorem Plane.OpenIn.union
        (left right carrier : Set(Plane.Point))
        (leftOpen : Plane.OpenIn(left, carrier))
        (rightOpen : Plane.OpenIn(right, carrier))
        : Plane.OpenIn(left ∪ right, carrier) :=
  done by MetricSpace.OpenIn.union

-- ----------------------------------------------------------------------
-- Balls are open, which is what makes the definition worth having.

theorem Plane.Ball_IsOpen (center : Plane.Point) (radius : ℝ)
        : Plane.IsOpen(Plane.Ball(center, radius)) :=
  done by MetricSpace.Ball_IsOpen

-- ----------------------------------------------------------------------
-- The textbook characterization: relatively open means "cut out of the
-- carrier by an open set".

definition Plane.BallWitness
        (subset carrier : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point) : Proposition :=
  MetricSpace.BallWitness(subset, carrier, x, radius, y)

theorem Plane.BallWitness.centre_inside
        (subset carrier : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, carrier, x, radius, y))
        : x ∈ subset :=
  done by MetricSpace.BallWitness.centre_inside

theorem Plane.BallWitness.radius_positive
        (subset carrier : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, carrier, x, radius, y))
        : 0 < radius :=
  done by MetricSpace.BallWitness.radius_positive

theorem Plane.BallWitness.ball_inside
        (subset carrier : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, carrier, x, radius, y))
        : ∀ (z : Plane.Point). z ∈ carrier →
              Plane.distance(x, z) < radius → z ∈ subset :=
  done by MetricSpace.BallWitness.ball_inside

theorem Plane.BallWitness.reaches
        (subset carrier : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, carrier, x, radius, y))
        : Plane.distance(x, y) < radius :=
  done by MetricSpace.BallWitness.reaches

definition Plane.openHull (subset carrier : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.openHull(subset, carrier)

theorem Plane.openHull_IsOpen (subset carrier : Set(Plane.Point))
        : Plane.IsOpen(Plane.openHull(subset, carrier)) :=
  done by MetricSpace.openHull_IsOpen

theorem Plane.subset_openHull_intersection (subset carrier : Set(Plane.Point))
        (subsetInCarrier : subset ⊆ carrier)
        (openInCarrier : Plane.OpenIn(subset, carrier))
        : subset ⊆ Plane.openHull(subset, carrier) ∩ carrier :=
  done by MetricSpace.subset_openHull_intersection

theorem Plane.openHull_intersection_subset (subset carrier : Set(Plane.Point))
        : Plane.openHull(subset, carrier) ∩ carrier ⊆ subset :=
  done by MetricSpace.openHull_intersection_subset

theorem Plane.OpenIn_cut_by_open (subset carrier : Set(Plane.Point))
        (subsetInCarrier : subset ⊆ carrier)
        (openInCarrier : Plane.OpenIn(subset, carrier))
        : subset = Plane.openHull(subset, carrier) ∩ carrier :=
  done by MetricSpace.OpenIn_cut_by_open

theorem Plane.OpenIn_of_cut (subset carrier ambient : Set(Plane.Point))
        (ambientOpen : Plane.IsOpen(ambient))
        (cut : subset = ambient ∩ carrier)
        : Plane.OpenIn(subset, carrier) :=
  done by MetricSpace.OpenIn_of_cut

-- ----------------------------------------------------------------------
-- Interior, closure, boundary — all relative to the carrier.

definition Plane.InteriorIn (subset carrier : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.InteriorIn(subset, carrier)

definition Plane.ClosureIn (subset carrier : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.ClosureIn(subset, carrier)

definition Plane.BoundaryIn (subset carrier : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.BoundaryIn(subset, carrier)

theorem Plane.InteriorIn_subset (subset carrier : Set(Plane.Point))
        : Plane.InteriorIn(subset, carrier) ⊆ subset :=
  done by MetricSpace.InteriorIn_subset

theorem Plane.InteriorIn_OpenIn (subset carrier : Set(Plane.Point))
        : Plane.OpenIn(Plane.InteriorIn(subset, carrier), carrier) :=
  done by MetricSpace.InteriorIn_OpenIn

theorem Plane.subset_InteriorIn_of_OpenIn (subset carrier : Set(Plane.Point))
        (openInCarrier : Plane.OpenIn(subset, carrier))
        : subset ⊆ Plane.InteriorIn(subset, carrier) :=
  done by MetricSpace.subset_InteriorIn_of_OpenIn

theorem Plane.ClosureIn_subset_carrier (subset carrier : Set(Plane.Point))
        : Plane.ClosureIn(subset, carrier) ⊆ carrier :=
  done by MetricSpace.ClosureIn_subset_carrier

theorem Plane.subset_ClosureIn (subset carrier : Set(Plane.Point))
        (subsetInCarrier : subset ⊆ carrier)
        : subset ⊆ Plane.ClosureIn(subset, carrier) :=
  done by MetricSpace.subset_ClosureIn

theorem Plane.BoundaryIn_subset_ClosureIn (subset carrier : Set(Plane.Point))
        : Plane.BoundaryIn(subset, carrier)
              ⊆ Plane.ClosureIn(subset, carrier) :=
  done by MetricSpace.BoundaryIn_subset_ClosureIn

theorem Plane.BoundaryIn_of_OpenIn (subset carrier : Set(Plane.Point))
        (openInCarrier : Plane.OpenIn(subset, carrier))
        (x : Plane.Point)
        (onBoundary : x ∈ Plane.BoundaryIn(subset, carrier))
        : x ∈ Plane.ClosureIn(subset, carrier) ∖ subset :=
  done by MetricSpace.BoundaryIn_of_OpenIn

-- ----------------------------------------------------------------------
-- Continuity, relative to a carrier.

definition Plane.ContinuousAt
        (f : Plane.Point → Plane.Point) (carrier : Set(Plane.Point))
        (x : Plane.Point) : Proposition :=
  MetricSpace.ContinuousAt(f, carrier, x)

definition Plane.ContinuousOn
        (f : Plane.Point → Plane.Point) (carrier : Set(Plane.Point))
        : Proposition :=
  MetricSpace.ContinuousOn(f, carrier)

theorem Plane.ContinuousOn.of_agreeing
        (f g : Plane.Point → Plane.Point) (carrier : Set(Plane.Point))
        (agree : ∀ (x : Plane.Point). x ∈ carrier → f(x) = g(x))
        (gContinuous : Plane.ContinuousOn(g, carrier))
        : Plane.ContinuousOn(f, carrier) :=
  done by MetricSpace.ContinuousOn.of_agreeing

theorem Plane.ContinuousOn.compose
        (inner outer : Plane.Point → Plane.Point)
        (carrier target : Set(Plane.Point))
        (innerContinuous : Plane.ContinuousOn(inner, carrier))
        (lands : ∀ (x : Plane.Point). x ∈ carrier → inner(x) ∈ target)
        (outerContinuous : Plane.ContinuousOn(outer, target))
        : Plane.ContinuousOn((x : Plane.Point) ↦ outer(inner(x)), carrier) :=
  done by MetricSpace.ContinuousOn.compose

theorem Plane.ContinuousOn.restrict
        (f : Plane.Point → Plane.Point)
        (smaller larger : Set(Plane.Point))
        (smallerInLarger : smaller ⊆ larger)
        (continuousOnLarger : Plane.ContinuousOn(f, larger))
        : Plane.ContinuousOn(f, smaller) :=
  done by MetricSpace.ContinuousOn.restrict

-- ----------------------------------------------------------------------
-- The pasting lemma.

theorem Plane.pasteRadius
        (f : Plane.Point → Plane.Point)
        (piece union : Set(Plane.Point))
        (pieceClosed : Plane.ClosedIn(piece, union))
        (pieceContinuous : Plane.ContinuousOn(f, piece))
        (x : Plane.Point) (xInUnion : x ∈ union)
        (tolerance : ℝ) (tolerancePositive : 0 < tolerance)
        : ∃ (nearness : ℝ). 0 < nearness ∧
            ∀ (y : Plane.Point). y ∈ union → y ∈ piece →
              Plane.distance(x, y) < nearness →
                Plane.distance(f(x), f(y)) < tolerance :=
  done by MetricSpace.pasteRadius

theorem Plane.ContinuousOn.paste
        (f : Plane.Point → Plane.Point)
        (first second : Set(Plane.Point))
        (firstClosed : Plane.ClosedIn(first, first ∪ second))
        (secondClosed : Plane.ClosedIn(second, first ∪ second))
        (firstContinuous : Plane.ContinuousOn(f, first))
        (secondContinuous : Plane.ContinuousOn(f, second))
        : Plane.ContinuousOn(f, first ∪ second) :=
  done by MetricSpace.ContinuousOn.paste
