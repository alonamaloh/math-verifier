-- Plane/topology.math
--
-- Relative topology of the plane. Layer 1 of the Jordan–Schönflies
-- foundation.
--
-- Every notion here is the generic metric-space one from `Metric/`, read
-- at `Plane.Point` through the instance in `Plane/metric.math`. The names
-- are kept because the Jordan–Schönflies development speaks them; the
-- mathematics lives in `Metric/topology.math` and
-- `Metric/continuity.math`, where it is written once and also serves the
-- real line.
--
-- Everything is stated RELATIVE to a region from the start, and the
-- absolute notions are the `region = universe` case. That is a
-- deliberate choice, settled in PLAN_JORDAN_SCHOENFLIES.md: connectedness
-- gets applied to arcs and curves as subspaces, and the model-curve
-- parametrization needs compact→Hausdorff on a subspace, so retrofitting
-- relativisation across Layers 1–3 would cost more than paying for it
-- once here.
--
-- `Plane.OpenIn(subset, region)` does not require `subset ⊆ region` —
-- the ε-ball condition is meaningful without it, and demanding it would
-- add a proof obligation at every use. Consumers that need the inclusion
-- carry it separately.

module Plane.topology

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.minimum
import Metric.space
import Metric.topology
import Metric.continuity
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.metric

-- ----------------------------------------------------------------------
-- Open sets, relative to a region.

definition Plane.OpenIn (subset region : Set(Plane.Point)) : Proposition :=
  MetricSpace.OpenIn(subset, region)

definition Plane.IsOpen (subset : Set(Plane.Point)) : Proposition :=
  MetricSpace.IsOpen(subset)

definition Plane.ClosedIn (subset region : Set(Plane.Point)) : Proposition :=
  MetricSpace.ClosedIn(subset, region)

theorem Plane.IsOpen.ball_inside (subset : Set(Plane.Point))
        (isOpen : Plane.IsOpen(subset))
        (x : Plane.Point) (inSubset : x ∈ subset)
        : ∃ (radius : ℝ). radius > 0 ∧
            ∀ (y : Plane.Point). Plane.distance(x, y) < radius → y ∈ subset :=
  done by MetricSpace.IsOpen.ball_inside

-- ----------------------------------------------------------------------
-- The lattice laws.

theorem Plane.OpenIn.universe (region : Set(Plane.Point))
        : Plane.OpenIn(Set.universe(Plane.Point), region) :=
  done by MetricSpace.OpenIn.universe

theorem Plane.OpenIn.empty (region : Set(Plane.Point))
        : Plane.OpenIn(Set.empty(Plane.Point), region) :=
  done by MetricSpace.OpenIn.empty

theorem Plane.OpenIn.intersection
        (left right region : Set(Plane.Point))
        (leftOpen : Plane.OpenIn(left, region))
        (rightOpen : Plane.OpenIn(right, region))
        : Plane.OpenIn(left ∩ right, region) :=
  done by MetricSpace.OpenIn.intersection

theorem Plane.OpenIn.union
        (left right region : Set(Plane.Point))
        (leftOpen : Plane.OpenIn(left, region))
        (rightOpen : Plane.OpenIn(right, region))
        : Plane.OpenIn(left ∪ right, region) :=
  done by MetricSpace.OpenIn.union

-- ----------------------------------------------------------------------
-- Balls are open, which is what makes the definition worth having.

theorem Plane.Ball_IsOpen (center : Plane.Point) (radius : ℝ)
        : Plane.IsOpen(Plane.Ball(center, radius)) :=
  done by MetricSpace.Ball_IsOpen

-- ----------------------------------------------------------------------
-- The textbook characterization: relatively open means "cut out of the
-- region by an open set".

definition Plane.BallWitness
        (subset region : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point) : Proposition :=
  MetricSpace.BallWitness(subset, region, x, radius, y)

theorem Plane.BallWitness.centre_inside
        (subset region : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, region, x, radius, y))
        : x ∈ subset :=
  done by MetricSpace.BallWitness.centre_inside

theorem Plane.BallWitness.radius_positive
        (subset region : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, region, x, radius, y))
        : 0 < radius :=
  done by MetricSpace.BallWitness.radius_positive

theorem Plane.BallWitness.ball_inside
        (subset region : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, region, x, radius, y))
        : ∀ (z : Plane.Point). z ∈ region →
              Plane.distance(x, z) < radius → z ∈ subset :=
  done by MetricSpace.BallWitness.ball_inside

theorem Plane.BallWitness.reaches
        (subset region : Set(Plane.Point))
        (x : Plane.Point) (radius : ℝ) (y : Plane.Point)
        (holds : Plane.BallWitness(subset, region, x, radius, y))
        : Plane.distance(x, y) < radius :=
  done by MetricSpace.BallWitness.reaches

definition Plane.openHull (subset region : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.openHull(subset, region)

theorem Plane.openHull_IsOpen (subset region : Set(Plane.Point))
        : Plane.IsOpen(Plane.openHull(subset, region)) :=
  done by MetricSpace.openHull_IsOpen

theorem Plane.subset_openHull_intersection (subset region : Set(Plane.Point))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : Plane.OpenIn(subset, region))
        : subset ⊆ Plane.openHull(subset, region) ∩ region :=
  done by MetricSpace.subset_openHull_intersection

theorem Plane.openHull_intersection_subset (subset region : Set(Plane.Point))
        : Plane.openHull(subset, region) ∩ region ⊆ subset :=
  done by MetricSpace.openHull_intersection_subset

theorem Plane.OpenIn_cut_by_open (subset region : Set(Plane.Point))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : Plane.OpenIn(subset, region))
        : subset = Plane.openHull(subset, region) ∩ region :=
  done by MetricSpace.OpenIn_cut_by_open

theorem Plane.OpenIn_of_cut (subset region cuttingSet : Set(Plane.Point))
        (cuttingSetOpen : Plane.IsOpen(cuttingSet))
        (cut : subset = cuttingSet ∩ region)
        : Plane.OpenIn(subset, region) :=
  done by MetricSpace.OpenIn_of_cut

-- ----------------------------------------------------------------------
-- Interior, closure, boundary — all relative to the region.

definition Plane.InteriorIn (subset region : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.InteriorIn(subset, region)

definition Plane.ClosureIn (subset region : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.ClosureIn(subset, region)

definition Plane.BoundaryIn (subset region : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.BoundaryIn(subset, region)

theorem Plane.InteriorIn_subset (subset region : Set(Plane.Point))
        : Plane.InteriorIn(subset, region) ⊆ subset :=
  done by MetricSpace.InteriorIn_subset

theorem Plane.InteriorIn_OpenIn (subset region : Set(Plane.Point))
        : Plane.OpenIn(Plane.InteriorIn(subset, region), region) :=
  done by MetricSpace.InteriorIn_OpenIn

theorem Plane.subset_InteriorIn_of_OpenIn (subset region : Set(Plane.Point))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : Plane.OpenIn(subset, region))
        : subset ⊆ Plane.InteriorIn(subset, region) :=
  done by MetricSpace.subset_InteriorIn_of_OpenIn

theorem Plane.ClosureIn_subset_region (subset region : Set(Plane.Point))
        : Plane.ClosureIn(subset, region) ⊆ region :=
  done by MetricSpace.ClosureIn_subset_region

theorem Plane.subset_ClosureIn (subset region : Set(Plane.Point))
        (subsetInRegion : subset ⊆ region)
        : subset ⊆ Plane.ClosureIn(subset, region) :=
  done by MetricSpace.subset_ClosureIn

theorem Plane.BoundaryIn_subset_ClosureIn (subset region : Set(Plane.Point))
        : Plane.BoundaryIn(subset, region)
              ⊆ Plane.ClosureIn(subset, region) :=
  done by MetricSpace.BoundaryIn_subset_ClosureIn

theorem Plane.BoundaryIn_eq_ClosureIn_difference (subset region : Set(Plane.Point))
        (subsetInRegion : subset ⊆ region)
        (openInRegion : Plane.OpenIn(subset, region))
        : Plane.BoundaryIn(subset, region)
              = Plane.ClosureIn(subset, region) ∖ subset :=
  done by MetricSpace.BoundaryIn_eq_ClosureIn_difference

-- ----------------------------------------------------------------------
-- Continuity, relative to a region.

definition Plane.ContinuousAt
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        (x : Plane.Point) : Proposition :=
  MetricSpace.ContinuousWithinAt(f, region, x)

definition Plane.ContinuousOn
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        : Proposition :=
  MetricSpace.ContinuousOn(f, region)

theorem Plane.ContinuousOn.of_agreeing
        (f g : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        (agree : ∀ (x : Plane.Point). x ∈ region → f(x) = g(x))
        (gContinuous : Plane.ContinuousOn(g, region))
        : Plane.ContinuousOn(f, region) :=
  done by MetricSpace.ContinuousOn.of_agreeing

theorem Plane.ContinuousOn.compose
        (inner outer : Plane.Point → Plane.Point)
        (region middleRegion : Set(Plane.Point))
        (innerContinuous : Plane.ContinuousOn(inner, region))
        (lands : ∀ (x : Plane.Point). x ∈ region → inner(x) ∈ middleRegion)
        (outerContinuous : Plane.ContinuousOn(outer, middleRegion))
        : Plane.ContinuousOn((x : Plane.Point) ↦ outer(inner(x)), region) :=
  done by MetricSpace.ContinuousOn.compose

theorem Plane.ContinuousOn.restrict
        (f : Plane.Point → Plane.Point)
        (smaller larger : Set(Plane.Point))
        (smallerInLarger : smaller ⊆ larger)
        (continuousOnLarger : Plane.ContinuousOn(f, larger))
        : Plane.ContinuousOn(f, smaller) :=
  done by MetricSpace.ContinuousOn.restrict

-- ----------------------------------------------------------------------
-- The pasting lemma.

theorem Plane.ContinuousOn.paste
        (f : Plane.Point → Plane.Point)
        (first second : Set(Plane.Point))
        (firstClosed : Plane.ClosedIn(first, first ∪ second))
        (secondClosed : Plane.ClosedIn(second, first ∪ second))
        (firstContinuous : Plane.ContinuousOn(f, first))
        (secondContinuous : Plane.ContinuousOn(f, second))
        : Plane.ContinuousOn(f, first ∪ second) :=
  done by MetricSpace.ContinuousOn.paste
