-- Plane/connected.math
--
-- Connectedness in the plane, relative throughout. Layer 3.
--
-- The definition is the clopen one: a set is connected when its only
-- nonempty relatively-clopen subset is itself. That is the blueprint's
-- "Recognizing a component" criterion taken as primitive rather than
-- derived, because it is the form every consumer uses — one shows a
-- candidate piece is open, that its complement is open, that it is not
-- empty, and concludes it is everything.
--
-- Stating it as `piece = region` rather than as the absence of a
-- separation also spares every consumer the negation: a connectedness
-- argument becomes three positive obligations and a conclusion, with no
-- reductio in sight.

module Plane.connected

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value
import Real.absolute_value_order
import Real.minimum
import Real.supremum
import Plane.segment
import Plane.vector
import Plane.point
import Plane.norm
import Plane.topology
import Plane.sequence
import Plane.compact
import Plane.compactness

-- ----------------------------------------------------------------------
-- Connectedness.

definition Plane.IsConnected (region : Set(Plane.Point)) : Proposition :=
  ∀ (piece : Set(Plane.Point)).
    piece ⊆ region →
    Plane.OpenIn(piece, region) →
    Plane.OpenIn(region ∖ piece, region) →
    Set.IsNonempty(Plane.Point, piece) →
    piece = region

-- A nonempty open-and-closed piece is everything. This is the definition
-- read back through `ClosedIn`, which is how a topology argument states
-- the obligation it has just discharged.
theorem Plane.IsConnected.clopen_is_everything
        (region piece : Set(Plane.Point))
        (connected : Plane.IsConnected(region))
        (inside : piece ⊆ region)
        (open : Plane.OpenIn(piece, region))
        (closed : Plane.ClosedIn(piece, region))
        (nonempty : Set.IsNonempty(Plane.Point, piece))
        : piece = region :=
  connected(piece, inside, open, closed, nonempty)

-- ----------------------------------------------------------------------
-- Preimages.
--
-- The relative topology transports backwards along a continuous map:
-- what is open in the image is open in the domain. This is the one
-- topological fact the image theorem below needs, and it is the ε–δ
-- argument spelled out — the radius comes from the image's openness,
-- the nearness from continuity at the point.

definition Plane.preimageIn
        (f : Plane.Point → Plane.Point) (target carrier : Set(Plane.Point))
        : Set(Plane.Point) :=
  (x : Plane.Point) ↦ x ∈ carrier ∧ f(x) ∈ target

theorem Plane.OpenIn.preimage
        (f : Plane.Point → Plane.Point) (carrier target : Set(Plane.Point))
        (continuous : Plane.ContinuousOn(f, carrier))
        (targetOpen : Plane.OpenIn(target, Plane.imageSet(f, carrier)))
        : Plane.OpenIn(Plane.preimageIn(f, target, carrier), carrier) := {
  take x : Plane.Point;
  suppose x ∈ Plane.preimageIn(f, target, carrier) as inPreimage;
  x ∈ carrier as inCarrier;
  f(x) ∈ target as valueInTarget;
  choose radius such that
      0 < radius ∧
      ∀ (w : Plane.Point). w ∈ Plane.imageSet(f, carrier) →
        Plane.distance(f(x), w) < radius → w ∈ target
      from targetOpen(f(x), valueInTarget);
  0 < radius as radiusPositive;
  ∀ (w : Plane.Point). w ∈ Plane.imageSet(f, carrier) →
      Plane.distance(f(x), w) < radius → w ∈ target
      as nearbyValuesHit;
  choose nearness such that
      0 < nearness ∧
      ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness →
          Plane.distance(f(x), f(y)) < radius
      from continuous(x, inCarrier, radius, radiusPositive);
  0 < nearness;
  ∀ (y : Plane.Point). y ∈ carrier →
      Plane.distance(x, y) < nearness →
        Plane.distance(f(x), f(y)) < radius
      as nearbyPointsMoveLittle;
  witness nearness with {
    0 < nearness;
    ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness →
          y ∈ Plane.preimageIn(f, target, carrier)
        by (y : Plane.Point) (inCarrierY : y ∈ carrier)
           (near : Plane.distance(x, y) < nearness) ↦ {
          Plane.distance(f(x), f(y)) < radius
              by nearbyPointsMoveLittle;
          f(y) ∈ Plane.imageSet(f, carrier) by { witness y with done };
          f(y) ∈ target by nearbyValuesHit;
          y ∈ Plane.preimageIn(f, target, carrier);
          done
        };
    done
  }
}

theorem Plane.preimageIn_subset
        (f : Plane.Point → Plane.Point) (target carrier : Set(Plane.Point))
        : Plane.preimageIn(f, target, carrier) ⊆ carrier := {
  take x : Plane.Point;
  suppose x ∈ Plane.preimageIn(f, target, carrier) as inPreimage;
  x ∈ carrier;
  done
}

-- The complement of a preimage is the preimage of the complement — the
-- bookkeeping that turns "clopen in the image" into "clopen in the
-- domain".
theorem Plane.preimageIn_complement
        (f : Plane.Point → Plane.Point) (carrier target : Set(Plane.Point))
        : carrier ∖ Plane.preimageIn(f, target, carrier)
              = Plane.preimageIn(
                    f, Plane.imageSet(f, carrier) ∖ target, carrier) := {
  carrier ∖ Plane.preimageIn(f, target, carrier)
      ⊆ Plane.preimageIn(f, Plane.imageSet(f, carrier) ∖ target, carrier)
      by (x : Plane.Point)
         (outside : x ∈ carrier ∖ Plane.preimageIn(f, target, carrier)) ↦ {
        x ∈ carrier;
        ¬(x ∈ Plane.preimageIn(f, target, carrier));
        f(x) ∈ Plane.imageSet(f, carrier) by { witness x with done };
        suppose f(x) ∈ target for contradiction {
          x ∈ Plane.preimageIn(f, target, carrier);
          done
        };
        f(x) ∈ Plane.imageSet(f, carrier) ∖ target;
        done
      };
  Plane.preimageIn(f, Plane.imageSet(f, carrier) ∖ target, carrier)
      ⊆ carrier ∖ Plane.preimageIn(f, target, carrier)
      by (x : Plane.Point)
         (inside : x ∈ Plane.preimageIn(
              f, Plane.imageSet(f, carrier) ∖ target, carrier)) ↦ {
        x ∈ carrier;
        f(x) ∈ Plane.imageSet(f, carrier) ∖ target;
        ¬(f(x) ∈ target);
        suppose x ∈ Plane.preimageIn(f, target, carrier) for contradiction {
          f(x) ∈ target;
          done
        };
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The continuous image of a connected set is connected.
--
-- Pull the clopen piece back: it is clopen in the domain by the two
-- lemmas above, and nonempty because the piece has a point and the point
-- has a preimage. Connectedness of the domain makes the pullback
-- everything, and pushing that forward makes the piece everything.

theorem Plane.IsConnected.image
        (f : Plane.Point → Plane.Point) (carrier : Set(Plane.Point))
        (connected : Plane.IsConnected(carrier))
        (continuous : Plane.ContinuousOn(f, carrier))
        : Plane.IsConnected(Plane.imageSet(f, carrier)) := {
  take piece : Set(Plane.Point);
  suppose piece ⊆ Plane.imageSet(f, carrier) as pieceInImage;
  suppose Plane.OpenIn(piece, Plane.imageSet(f, carrier)) as pieceOpen;
  suppose Plane.OpenIn(
      Plane.imageSet(f, carrier) ∖ piece, Plane.imageSet(f, carrier))
      as restOpen;
  suppose Set.IsNonempty(Plane.Point, piece) as pieceNonempty;

  Plane.preimageIn(f, piece, carrier) ⊆ carrier
      by Plane.preimageIn_subset;
  Plane.OpenIn(Plane.preimageIn(f, piece, carrier), carrier)
      by Plane.OpenIn.preimage;
  carrier ∖ Plane.preimageIn(f, piece, carrier)
      = Plane.preimageIn(f, Plane.imageSet(f, carrier) ∖ piece, carrier)
      by Plane.preimageIn_complement;
  Plane.OpenIn(
      Plane.preimageIn(f, Plane.imageSet(f, carrier) ∖ piece, carrier),
      carrier)
      by Plane.OpenIn.preimage;
  Plane.OpenIn(carrier ∖ Plane.preimageIn(f, piece, carrier), carrier);

  -- The piece has a point, and that point is a value.
  choose value such that value ∈ piece from pieceNonempty;
  value ∈ Plane.imageSet(f, carrier) by pieceInImage;
  choose source such that source ∈ carrier ∧ f(source) = value
      from { value ∈ Plane.imageSet(f, carrier) };
  source ∈ carrier;
  f(source) = value;
  f(source) ∈ piece;
  source ∈ Plane.preimageIn(f, piece, carrier);
  Set.IsNonempty(Plane.Point, Plane.preimageIn(f, piece, carrier))
      by { witness source with done };

  Set.IsNonempty(Plane.Point, Plane.preimageIn(f, piece, carrier));
  Plane.preimageIn(f, piece, carrier) = carrier by connected;

  -- Pushing that forward: every value is the value at a point of the
  -- pullback, hence lands in the piece.
  Plane.imageSet(f, carrier) ⊆ piece
      by (y : Plane.Point) (inImage : y ∈ Plane.imageSet(f, carrier)) ↦ {
        choose x such that x ∈ carrier ∧ f(x) = y from inImage;
        x ∈ carrier;
        f(x) = y;
        carrier = Plane.preimageIn(f, piece, carrier);
        x ∈ Plane.preimageIn(f, piece, carrier);
        f(x) ∈ piece;
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- Restriction.
--
-- Relative openness survives shrinking the carrier: what is open in a set
-- is open in any subset of it, once cut down to that subset. The radius
-- is unchanged — only fewer points have to be checked.

theorem Plane.OpenIn.restrict
        (piece carrier smaller : Set(Plane.Point))
        (openInCarrier : Plane.OpenIn(piece, carrier))
        (inside : smaller ⊆ carrier)
        : Plane.OpenIn(piece ∩ smaller, smaller) := {
  take x : Plane.Point;
  suppose x ∈ piece ∩ smaller as inBoth;
  x ∈ piece;
  choose radius such that
      0 < radius ∧
      ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < radius → y ∈ piece
      from openInCarrier(x, { x ∈ piece });
  0 < radius;
  ∀ (y : Plane.Point). y ∈ carrier →
      Plane.distance(x, y) < radius → y ∈ piece as nearbyInPiece;
  witness radius with {
    0 < radius;
    ∀ (y : Plane.Point). y ∈ smaller →
        Plane.distance(x, y) < radius → y ∈ piece ∩ smaller
        by (y : Plane.Point) (inSmaller : y ∈ smaller)
           (near : Plane.distance(x, y) < radius) ↦ {
          y ∈ carrier by inside;
          y ∈ piece by nearbyInPiece;
          done        };
    done
  }
}

-- Cutting a piece out of a subset is the same as cutting the ambient
-- complement down to it. The bookkeeping the union argument runs on.
theorem Plane.difference_intersection
        (larger smaller piece : Set(Plane.Point))
        (inside : smaller ⊆ larger)
        : smaller ∖ (piece ∩ smaller) = (larger ∖ piece) ∩ smaller := {
  smaller ∖ (piece ∩ smaller) ⊆ (larger ∖ piece) ∩ smaller
      by (x : Plane.Point)
         (outside : x ∈ smaller ∖ (piece ∩ smaller)) ↦ {
        x ∈ smaller;
        ¬(x ∈ piece ∩ smaller);
        x ∈ larger by inside;
        ¬(x ∈ piece)
            by (inPiece : x ∈ piece) ↦ {
              x ∈ piece ∩ smaller;
              done
            };
        x ∈ larger ∖ piece;
        done      };
  (larger ∖ piece) ∩ smaller ⊆ smaller ∖ (piece ∩ smaller)
      by (x : Plane.Point)
         (inCut : x ∈ (larger ∖ piece) ∩ smaller) ↦ {
        x ∈ larger ∖ piece;
        x ∈ smaller;
        ¬(x ∈ piece);
        ¬(x ∈ piece ∩ smaller)
            by (inBoth : x ∈ piece ∩ smaller) ↦ {
              x ∈ piece;
              done
            };
        done
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- A connected piece swallows a whole connected set it meets.
--
-- Extracted because the union argument needs it twice, once per side,
-- and because it is the step a reader wants named: a relatively clopen
-- piece of the whole, if it meets a connected part at all, contains it.

theorem Plane.IsConnected.swallows
        (whole part piece : Set(Plane.Point))
        (partConnected : Plane.IsConnected(part))
        (partInside : part ⊆ whole)
        (pieceOpen : Plane.OpenIn(piece, whole))
        (restOpen : Plane.OpenIn(whole ∖ piece, whole))
        (meets : Set.IsNonempty(Plane.Point, piece ∩ part))
        : part ⊆ piece := {
  Plane.OpenIn(piece ∩ part, part) by Plane.OpenIn.restrict(carrier := whole);
  part ∖ (piece ∩ part) = (whole ∖ piece) ∩ part
      by Plane.difference_intersection;
  Plane.OpenIn((whole ∖ piece) ∩ part, part)
      by Plane.OpenIn.restrict(carrier := whole);
  Plane.OpenIn(part ∖ (piece ∩ part), part);
  piece ∩ part ⊆ part by Set.intersection_subset_right;
  piece ∩ part = part by partConnected;
  part = piece ∩ part;
  take x : Plane.Point;
  suppose x ∈ part;
  x ∈ piece ∩ part;
  done
}

-- ----------------------------------------------------------------------
-- Two connected sets that share a point make a connected union.
--
-- A relatively clopen piece of the union is nonempty, so it meets one of
-- the two sides; that side is swallowed whole, which drags in the shared
-- point, which puts the other side's meeting in evidence too.

theorem Plane.IsConnected.union
        (left right : Set(Plane.Point))
        (leftConnected : Plane.IsConnected(left))
        (rightConnected : Plane.IsConnected(right))
        (shared : Plane.Point)
        (sharedInLeft : shared ∈ left) (sharedInRight : shared ∈ right)
        : Plane.IsConnected(left ∪ right) := {
  take piece : Set(Plane.Point);
  suppose piece ⊆ left ∪ right as pieceInside;
  suppose Plane.OpenIn(piece, left ∪ right) as pieceOpen;
  suppose Plane.OpenIn((left ∪ right) ∖ piece, left ∪ right) as restOpen;
  suppose Set.IsNonempty(Plane.Point, piece) as pieceNonempty;
  left ⊆ left ∪ right by Set.subset_union_left;
  right ⊆ left ∪ right by Set.subset_union_right;

  -- Whichever side the piece meets, the shared point ends up inside it.
  choose start such that start ∈ piece from pieceNonempty;
  start ∈ left ∪ right by pieceInside;
  shared ∈ piece by cases {
    case start ∈ left as startInLeft: {
        Set.IsNonempty(Plane.Point, piece ∩ left)
            by { witness start with done };
        left ⊆ piece
            by Plane.IsConnected.swallows(whole := left ∪ right)
            as leftSwallowed;
        done by leftSwallowed
      }
    case start ∈ right as startInRight: {
        Set.IsNonempty(Plane.Point, piece ∩ right)
            by { witness start with done };
        right ⊆ piece
            by Plane.IsConnected.swallows(whole := left ∪ right)
            as rightSwallowed;
        done by rightSwallowed
      }
  };

  -- With the shared point inside, both sides are swallowed.
  Set.IsNonempty(Plane.Point, piece ∩ left)
      by { witness shared with done };
  Set.IsNonempty(Plane.Point, piece ∩ right)
      by { witness shared with done };
  left ⊆ piece
      by Plane.IsConnected.swallows(whole := left ∪ right) as leftInPiece;
  right ⊆ piece
      by Plane.IsConnected.swallows(whole := left ∪ right) as rightInPiece;
  left ∪ right ⊆ piece
      by (x : Plane.Point) (inUnion : x ∈ left ∪ right) ↦ {
        done by cases {
          case x ∈ left as inLeft: leftInPiece(x, inLeft)
          case x ∈ right as inRight: rightInPiece(x, inRight)
        }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- Convex sets are connected.
--
-- The proof is the one on the line, transported along a walk. Fix a
-- point of the piece and any target of the region, and look at the set
-- of parameters whose walk has landed in the piece:
--
--     reached = { t ∈ [0,1] : between(start, target, t) ∈ piece }.
--
-- It holds 0 and stops at 1, so it has a supremum. The walk at the
-- supremum cannot be outside the piece — the piece's complement is open,
-- and parameters just short of the supremum are already inside. And the
-- supremum cannot be short of 1 — the piece is open, so parameters just
-- past it would be inside too, and the supremum would not be one.
--
-- The estimate that turns "just short" into a distance is
-- `Plane.between_distance`: a parameter gap of `g` moves the walk by
-- `g · distance(start, target)`, so `r / (1 + distance(start, target))`
-- is always a small enough gap.

definition Plane.reachedParameters
        (piece : Set(Plane.Point)) (a b : Plane.Point) : Set(ℝ) :=
  (t : ℝ) ↦ (0 ≤ t ∧ t ≤ 1) ∧ Plane.between(a, b, t) ∈ piece

-- The parameter gap that keeps the walk inside a ball of radius `r`.
definition Plane.parameterGap (r : ℝ) (a b : Plane.Point) : ℝ :=
  r / (1 + Plane.distance(a, b))

theorem Plane.parameterGap_positive (r : ℝ) (a b : Plane.Point)
        (radiusPositive : 0 < r)
        : 0 < Plane.parameterGap(r, a, b) := {
  0 ≤ Plane.distance(a, b);
  0 < 1 + Plane.distance(a, b);
  1 + Plane.distance(a, b) ≠ 0;
  done by Real.divide_positive
}

-- A gap below `parameterGap(r, a, b)` moves the walk less than `r`.
theorem Plane.between_close_of_gap (r : ℝ) (a b : Plane.Point) (s t : ℝ)
        (radiusPositive : 0 < r)
        (gapSmall : abs(t - s) < Plane.parameterGap(r, a, b))
        : Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t)) < r := {
  0 ≤ Plane.distance(a, b);
  0 < 1 + Plane.distance(a, b);
  1 + Plane.distance(a, b) ≠ 0;
  Real.IsNonneg(Plane.distance(a, b));
  abs(t - s) * Plane.distance(a, b)
      ≤ Plane.parameterGap(r, a, b) * Plane.distance(a, b)
      by Real.LessOrEqual.multiply_by_nonneg_right;
  0 < Plane.parameterGap(r, a, b);
  Plane.distance(a, b) < 1 + Plane.distance(a, b);
  Plane.distance(a, b) * Plane.parameterGap(r, a, b)
      < (1 + Plane.distance(a, b)) * Plane.parameterGap(r, a, b)
      by Real.LessThan.multiply_by_positive_right;
  (1 + Plane.distance(a, b)) * Plane.parameterGap(r, a, b) = r
      by Real.divide_cancel;
  Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t))
     = abs(t - s) * Plane.distance(a, b) by Plane.between_distance
     ≤ Plane.parameterGap(r, a, b) * Plane.distance(a, b)
     = Plane.distance(a, b) * Plane.parameterGap(r, a, b)
     < (1 + Plane.distance(a, b)) * Plane.parameterGap(r, a, b)
     = r;
  done
}

-- The walk at the supremum has landed in the piece. If it had not, the
-- complement is open around it, and parameters just short of the
-- supremum — which the supremum guarantees exist — would be outside the
-- piece too, though they were chosen for being inside it.
theorem Plane.reached_supremum_inside
        (region piece : Set(Plane.Point)) (a b : Plane.Point) (peak : ℝ)
        (convex : Plane.IsConvex(region))
        (aInRegion : a ∈ region) (bInRegion : b ∈ region)
        (restOpen : Plane.OpenIn(region ∖ piece, region))
        (isSupremum : Real.IsSupremum(Plane.reachedParameters(piece, a, b), peak))
        (peakLow : 0 ≤ peak) (peakHigh : peak ≤ 1)
        : Plane.between(a, b, peak) ∈ piece := {
  Real.IsUpperBound(Plane.reachedParameters(piece, a, b), peak) as isUpperBound;
  Plane.between(a, b, peak) ∈ region
      by convex;
  suppose ¬(Plane.between(a, b, peak) ∈ piece)
      as outside for contradiction {
    Plane.between(a, b, peak) ∈ region ∖ piece;
    choose radius such that
        0 < radius ∧
        ∀ (y : Plane.Point). y ∈ region →
          Plane.distance(Plane.between(a, b, peak), y) < radius
            → y ∈ region ∖ piece
        from restOpen(Plane.between(a, b, peak),
            { Plane.between(a, b, peak) ∈ region ∖ piece });
    0 < radius;
    ∀ (y : Plane.Point). y ∈ region →
        Plane.distance(Plane.between(a, b, peak), y) < radius
          → y ∈ region ∖ piece as nearbyOutside;
    0 < Plane.parameterGap(radius, a, b);
    peak - Plane.parameterGap(radius, a, b) < peak;
    choose t such that
        t ∈ Plane.reachedParameters(piece, a, b)
        ∧ peak - Plane.parameterGap(radius, a, b) < t
        from Real.IsSupremum.exists_above(
            Plane.reachedParameters(piece, a, b), peak,
            peak - Plane.parameterGap(radius, a, b), isSupremum,
            { peak - Plane.parameterGap(radius, a, b) < peak });
    t ∈ Plane.reachedParameters(piece, a, b);
    peak - Plane.parameterGap(radius, a, b) < t;
    t ≤ peak by isUpperBound;
    (0 ≤ t ∧ t ≤ 1);
    0 ≤ t;
    t ≤ 1;
    Plane.between(a, b, t) ∈ piece;
    Plane.between(a, b, t) ∈ region by convex;
    -Plane.parameterGap(radius, a, b) < t - peak;
    t - peak < Plane.parameterGap(radius, a, b);
    abs(t - peak) < Plane.parameterGap(radius, a, b)
        by Real.absolute_value_LessThan_of_bounds;
    Plane.distance(Plane.between(a, b, peak), Plane.between(a, b, t)) < radius
        by Plane.between_close_of_gap;
    Plane.between(a, b, t) ∈ region ∖ piece by nearbyOutside;
    ¬(Plane.between(a, b, t) ∈ piece);
    Plane.between(a, b, t) ∈ piece;
    done
  };
  done
}

-- The supremum is 1. If it were short of 1 the piece is open around the
-- walk there, so a parameter a little past the supremum lands in the
-- piece too — and a parameter past the supremum that belongs to the set
-- is not what a supremum allows.
theorem Plane.reached_supremum_is_one
        (region piece : Set(Plane.Point)) (a b : Plane.Point) (peak : ℝ)
        (convex : Plane.IsConvex(region))
        (aInRegion : a ∈ region) (bInRegion : b ∈ region)
        (pieceOpen : Plane.OpenIn(piece, region))
        (isSupremum : Real.IsSupremum(Plane.reachedParameters(piece, a, b), peak))
        (peakLow : 0 ≤ peak) (peakHigh : peak ≤ 1)
        (peakInside : Plane.between(a, b, peak) ∈ piece)
        : peak = 1 := {
  Real.IsUpperBound(Plane.reachedParameters(piece, a, b), peak) as isUpperBound;
  suppose peak ≠ 1 as short for contradiction {
    peak ≤ 1;
    peak ≠ 1;
    peak < 1;
    0 < 1 - peak;
    choose radius such that
        0 < radius ∧
        ∀ (y : Plane.Point). y ∈ region →
          Plane.distance(Plane.between(a, b, peak), y) < radius
            → y ∈ piece
        from pieceOpen(Plane.between(a, b, peak), peakInside);
    0 < radius;
    ∀ (y : Plane.Point). y ∈ region →
        Plane.distance(Plane.between(a, b, peak), y) < radius
          → y ∈ piece as nearbyInside;
    0 < Plane.parameterGap(radius, a, b);

    -- A step short of both the room left and the gap that keeps the walk
    -- inside the ball. Halving is what makes both comparisons strict.
    (2 : ℝ) ≠ 0;
    let room : ℝ := min(1 - peak, Plane.parameterGap(radius, a, b));
    0 < room by Real.minimum_positive;
    room / 2 < room by Real.divide_two_less_than_self;
    room ≤ 1 - peak by Real.minimum_LessOrEqual_left;
    room ≤ Plane.parameterGap(radius, a, b) by Real.minimum_LessOrEqual_right;
    room / 2 < 1 - peak;
    room / 2 < Plane.parameterGap(radius, a, b);
    0 < room / 2 by Real.divide_positive;

    0 ≤ peak + room / 2;
    peak + room / 2 ≤ 1;
    Plane.between(a, b, peak + room / 2) ∈ region by convex;
    (peak + room / 2) - peak = room / 2 by ring as stepGap;
    abs(room / 2) = room / 2
        by Real.absolute_value_when_nonneg as absStep;
    abs((peak + room / 2) - peak)
       = abs(room / 2) by stepGap
       = room / 2 by absStep
       < Plane.parameterGap(radius, a, b);
    Plane.distance(
        Plane.between(a, b, peak), Plane.between(a, b, peak + room / 2))
        < radius by Plane.between_close_of_gap;
    Plane.between(a, b, peak + room / 2) ∈ piece by nearbyInside;
    (0 ≤ peak + room / 2 ∧ peak + room / 2 ≤ 1);
    peak + room / 2 ∈ Plane.reachedParameters(piece, a, b);
    peak + room / 2 ≤ peak by isUpperBound;
    peak < peak + room / 2;
    done
  };
  done
}

theorem Plane.IsConvex.connected (region : Set(Plane.Point))
        (convex : Plane.IsConvex(region))
        : Plane.IsConnected(region) := {
  take piece : Set(Plane.Point);
  suppose piece ⊆ region as pieceInside;
  suppose Plane.OpenIn(piece, region) as pieceOpen;
  suppose Plane.OpenIn(region ∖ piece, region) as restOpen;
  suppose Set.IsNonempty(Plane.Point, piece) as pieceNonempty;
  choose start such that start ∈ piece from pieceNonempty;
  start ∈ region by pieceInside;

  region ⊆ piece
      by (target : Plane.Point) (targetInRegion : target ∈ region) ↦ {
        -- The parameters that have landed hold 0 and stop at 1.
        Plane.between(start, target, 0) = start;
        (0 : ℝ) ∈ Plane.reachedParameters(piece, start, target)
            by { (0 : ℝ) ≤ 0;
                 (0 : ℝ) ≤ 1;
                 Plane.between(start, target, 0) ∈ piece;
                 done };
        Set.IsNonempty(ℝ, Plane.reachedParameters(piece, start, target))
            by { witness (0 : ℝ) with done };
        Real.IsUpperBound(
            Plane.reachedParameters(piece, start, target), (1 : ℝ))
            by (t : ℝ)
               (reached : t ∈ Plane.reachedParameters(piece, start, target)) ↦ {
              (0 ≤ t ∧ t ≤ 1);
              done
            };
        Real.IsBoundedAbove(Plane.reachedParameters(piece, start, target))
            by { witness (1 : ℝ) with done };
        choose peak such that
            Real.IsSupremum(
                Plane.reachedParameters(piece, start, target), peak)
            from Real.supremum_exists;
        Real.IsUpperBound(
            Plane.reachedParameters(piece, start, target), peak)
            as isUpperBound;

        -- It sits in the unit interval …
        (0 : ℝ) ≤ peak by isUpperBound;
        ∀ (otherBound : ℝ).
            Real.IsUpperBound(
                Plane.reachedParameters(piece, start, target), otherBound)
            → peak ≤ otherBound as isLeast;
        peak ≤ 1 by isLeast;

        -- … the walk there has landed, and it is the end of the walk.
        Plane.between(start, target, peak) ∈ piece
            by Plane.reached_supremum_inside;
        peak = 1 by Plane.reached_supremum_is_one;
        Plane.between(start, target, 1) = target;
        Plane.between(start, target, 1) ∈ piece;
        done
      };
  done by Set.equal_of_same_members
}

-- A disk is connected, being convex. This is what makes the components
-- of an open set open, which is where Layer 3 is going.
theorem Plane.Ball_IsConnected (center : Plane.Point) (radius : ℝ)
        : Plane.IsConnected(Plane.Ball(center, radius)) :=
  Plane.IsConvex.connected(
      Plane.Ball(center, radius), Plane.Ball_IsConvex(center, radius))

-- A segment is connected, being convex. Every polygonal walk is a chain
-- of these, which is what makes the walk classes connected.
theorem Plane.segment_IsConnected (a b : Plane.Point)
        : Plane.IsConnected(Plane.segment(a, b)) :=
  Plane.IsConvex.connected(
      Plane.segment(a, b), Plane.segment_IsConvex(a, b))

-- ----------------------------------------------------------------------
-- A connected set caught between two disjoint open sets lies in one of
-- them.
--
-- The side it meets is relatively clopen in it: relatively open because
-- an open set cuts it out, relatively closed because the other side is
-- all that remains, and nonempty by hypothesis. So it is everything.

theorem Plane.IsConnected.lands_in_side
        (part left right : Set(Plane.Point))
        (partConnected : Plane.IsConnected(part))
        (leftOpen : Plane.IsOpen(left)) (rightOpen : Plane.IsOpen(right))
        (apart : ∀ (x : Plane.Point). x ∈ left → ¬(x ∈ right))
        (covered : part ⊆ left ∪ right)
        (meetsLeft : Set.IsNonempty(Plane.Point, left ∩ part))
        : part ⊆ left := {
  part ⊆ Set.universe(Plane.Point) by Set.subset_universe;
  Plane.OpenIn(left ∩ part, part)
      by Plane.OpenIn.restrict(carrier := Set.universe(Plane.Point));
  Plane.OpenIn(right ∩ part, part)
      by Plane.OpenIn.restrict(carrier := Set.universe(Plane.Point));

  -- What the left side leaves of `part` is exactly what the right side
  -- catches, so the leftover is relatively open too.
  part ∖ (left ∩ part) ⊆ right ∩ part
      by (x : Plane.Point) (missedLeft : x ∈ part ∖ (left ∩ part)) ↦ {
        x ∈ part;
        ¬(x ∈ left ∩ part);
        ¬(x ∈ left)
            by (xInLeft : x ∈ left) ↦ {
              x ∈ left ∩ part;
              done
            };
        x ∈ left ∪ right by covered;
        x ∈ left ∨ x ∈ right;
        x ∈ right;
        done      };
  right ∩ part ⊆ part ∖ (left ∩ part)
      by (x : Plane.Point) (inRightPart : x ∈ right ∩ part) ↦ {
        x ∈ right;
        x ∈ part;
        ¬(x ∈ left ∩ part)
            by (inLeftPart : x ∈ left ∩ part) ↦ {
              x ∈ left;
              ¬(x ∈ right) by apart;
              done
            };
        done
      };
  part ∖ (left ∩ part) = right ∩ part
      by Set.equal_of_same_members as leftoverIsRight;
  Plane.OpenIn(part ∖ (left ∩ part), part) by substituting leftoverIsRight;

  left ∩ part ⊆ part by Set.intersection_subset_right;
  left ∩ part = part by partConnected;
  part = left ∩ part;
  take x : Plane.Point;
  suppose x ∈ part;
  x ∈ left ∩ part;
  done
}

-- The same fact stated as the alternative it is usually quoted as. The
-- side a nonempty connected set meets is decided by any one of its
-- points.
theorem Plane.IsConnected.lands_in_one_side
        (part left right : Set(Plane.Point))
        (partConnected : Plane.IsConnected(part))
        (leftOpen : Plane.IsOpen(left)) (rightOpen : Plane.IsOpen(right))
        (apart : ∀ (x : Plane.Point). x ∈ left → ¬(x ∈ right))
        (covered : part ⊆ left ∪ right)
        (nonempty : Set.IsNonempty(Plane.Point, part))
        : part ⊆ left ∨ part ⊆ right := {
  choose start such that start ∈ part from nonempty;
  start ∈ left ∪ right by covered;
  done by cases {
    case start ∈ left as startInLeft: {
        Set.IsNonempty(Plane.Point, left ∩ part)
            by { witness start with done };
        part ⊆ left
            by Plane.IsConnected.lands_in_side(right := right);
        done
      }
    case start ∈ right as startInRight: {
        ∀ (x : Plane.Point). x ∈ right → ¬(x ∈ left)
            by (x : Plane.Point) (xInRight : x ∈ right)
               (xInLeft : x ∈ left) ↦ {
              ¬(x ∈ right) by apart;
              done
            };
        part ⊆ right ∪ left
            by (x : Plane.Point) (xInPart : x ∈ part) ↦ {
              x ∈ left ∪ right by covered;
              x ∈ left ∨ x ∈ right;
              x ∈ right ∨ x ∈ left by Or.swap;
              done
            };
        Set.IsNonempty(Plane.Point, right ∩ part)
            by { witness start with done };
        part ⊆ right
            by Plane.IsConnected.lands_in_side(right := left);
        done
      }
  }
}

-- ----------------------------------------------------------------------
-- Adjoining limit points keeps a set connected.
--
-- A relatively clopen piece of the wider set is nonempty, and its
-- openness gives it a radius around one of its points; that radius
-- reaches the core, because the point is a limit of the core. So the
-- piece meets the core and swallows it. Then no point of the wider set
-- can be outside the piece: the leftover is relatively open too, so it
-- would come with a radius of its own, and that radius also reaches the
-- core — which is already inside the piece.

theorem Plane.IsConnected.adjoin_limits
        (core wide : Set(Plane.Point))
        (coreConnected : Plane.IsConnected(core))
        (coreInside : core ⊆ wide)
        (wideInClosure : wide ⊆ Plane.ClosureIn(core, wide))
        : Plane.IsConnected(wide) := {
  take piece : Set(Plane.Point);
  suppose piece ⊆ wide as pieceInside;
  suppose Plane.OpenIn(piece, wide) as pieceOpen;
  suppose Plane.OpenIn(wide ∖ piece, wide) as restOpen;
  suppose Set.IsNonempty(Plane.Point, piece) as pieceNonempty;

  -- The piece reaches the core, so it holds all of it.
  choose start such that start ∈ piece from pieceNonempty;
  start ∈ wide by pieceInside;
  choose radius such that
      0 < radius ∧
        ∀ (y : Plane.Point). y ∈ wide →
          Plane.distance(start, y) < radius → y ∈ piece
      from pieceOpen;
  0 < radius;
  ∀ (y : Plane.Point). y ∈ wide →
      Plane.distance(start, y) < radius → y ∈ piece as nearbyInPiece;
  start ∈ Plane.ClosureIn(core, wide) by wideInClosure;
  ∀ (scale : ℝ). 0 < scale →
      ∃ (y : Plane.Point). y ∈ core ∧ Plane.distance(start, y) < scale
      as coreIsNear;
  choose near such that
      near ∈ core ∧ Plane.distance(start, near) < radius
      from coreIsNear;
  near ∈ core;
  Plane.distance(start, near) < radius;
  near ∈ wide by coreInside;
  near ∈ piece by nearbyInPiece;
  Set.IsNonempty(Plane.Point, piece ∩ core)
      by { witness near with done };
  core ⊆ piece by Plane.IsConnected.swallows as coreInPiece;

  -- And nothing of the wider set is left outside it.
  wide ⊆ piece
      by (x : Plane.Point) (xInWide : x ∈ wide) ↦ {
        suppose ¬(x ∈ piece) as xOutside for contradiction {
          x ∈ wide ∖ piece;
          choose reach such that
              0 < reach ∧
                ∀ (y : Plane.Point). y ∈ wide →
                  Plane.distance(x, y) < reach → y ∈ wide ∖ piece
              from restOpen(x, { x ∈ wide ∖ piece });
          0 < reach;
          ∀ (y : Plane.Point). y ∈ wide →
              Plane.distance(x, y) < reach → y ∈ wide ∖ piece
              as nearbyOutside;
          x ∈ Plane.ClosureIn(core, wide) by wideInClosure;
          ∀ (scale : ℝ). 0 < scale →
              ∃ (y : Plane.Point). y ∈ core ∧ Plane.distance(x, y) < scale
              as coreIsNearX;
          choose witnessPoint such that
              witnessPoint ∈ core ∧ Plane.distance(x, witnessPoint) < reach
              from coreIsNearX;
          witnessPoint ∈ core;
          Plane.distance(x, witnessPoint) < reach;
          witnessPoint ∈ wide by coreInside;
          witnessPoint ∈ wide ∖ piece
              by nearbyOutside;
          ¬(witnessPoint ∈ piece);
          witnessPoint ∈ piece by coreInPiece;
          done
        };
        done
      };
  done by Set.equal_of_same_members
}
