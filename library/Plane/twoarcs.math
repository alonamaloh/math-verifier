-- Plane/twoarcs.math
--
-- Two points cut a Jordan curve into two arcs. Layer 4.
--
-- The whole argument is carried by the loop's parameters. Pull the two
-- points back to parameters `s` and `t` short of the finish, with `s`
-- first; then the two arcs are what the loop makes of the parameters
-- between them and of the parameters outside them — a subinterval, and the
-- two end pieces glued at the point where the loop closes up.
--
-- Both halves of the statement are then facts about intervals of reals: a
-- parameter lies inside `[s,t]` or outside it, and two parameters carrying
-- the same point are equal unless one of them is the finish. Now that a
-- parameter IS a real number, that is all the file says — the ordered
-- reading of `Real.segment` does the work a coordinate characterisation
-- used to.

module Plane.twoarcs

import Logic.basics
import Logic.exists
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.linearity
import Metric.space
import Metric.real
import Metric.topology
import Metric.compactness
import Metric.homeomorphism
import Metric.interval
import Plane.vector
import Plane.point
import Plane.metric
import Plane.segment
import Plane.topology
import Plane.compactness
import Plane.connected
import Plane.model
import Plane.homeomorphism
import Plane.curve
import Plane.subarc
import Plane.concatenate

-- ----------------------------------------------------------------------
-- What the loop covers.

-- Every parameter is inside `[s,t]`, before `s`, or after `t` — so the
-- loop's image splits the same way. The three-way split is the linearity
-- of the order on the parameters, and nothing else.
theorem Real.unitInterval_split (s t : ℝ)
        (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (ordered : s ≤ t)
        : Real.unitInterval
              = Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  s ≥ 0 by Real.unitInterval_nonneg;
  t ≤ 1 by Real.unitInterval_atMostOne;

  Real.unitInterval ⊆ Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1))
      by (x : ℝ) (xInside : x ∈ Real.unitInterval) ↦ {
        x ≥ 0 by Real.unitInterval_nonneg;
        x ≤ 1 by Real.unitInterval_atMostOne;
        done by cases {
          case x ≤ s as beforeStart: {
              x ∈ Real.segment(0, s) by Real.member_segment_of_bounds;
              done
            }
          otherwise as afterStart: {
              s ≤ x by Real.not_LessOrEqual_implies;
              done by cases {
                case x ≤ t as insideMiddle: {
                    x ∈ Real.segment(s, t) by Real.member_segment_of_bounds;
                    done
                  }
                otherwise as afterEnd: {
                    t ≤ x by Real.not_LessOrEqual_implies;
                    x ∈ Real.segment(t, 1) by Real.member_segment_of_bounds;
                    done
                  }
              }
            }
        }
      };

  Real.segment(s, t) ⊆ Real.unitInterval by Real.IsConvex.segment_inside;
  Real.segment(0, s) ⊆ Real.unitInterval by Real.IsConvex.segment_inside;
  Real.segment(t, 1) ⊆ Real.unitInterval by Real.IsConvex.segment_inside;
  Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1)) ⊆ Real.unitInterval
      by (x : ℝ)
         (onPieces : x ∈ Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1))) ↦ {
        done by cases {
          case x ∈ Real.segment(s, t) as inMiddle: done
          case x ∈ Real.segment(0, s) ∪ Real.segment(t, 1) as inEnds: {
              done by cases {
                case x ∈ Real.segment(0, s) as inFront: done
                case x ∈ Real.segment(t, 1) as inBack: done
              }
            }
        }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- Where the pieces meet.

-- The parameters between `s` and `t` and the parameters outside them
-- overlap only at `s` and `t` themselves, so the loop's images of the two
-- meet only at the two chosen points. Everything below is the injectivity
-- of the loop plus the order on the parameters; the one place the closing
-- condition enters is the parameter at the finish, which carries the same
-- point as the start.
theorem Plane.IsLoop.pieces_meet_at_ends (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s t : ℝ) (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (sBeforeFinish : s ≠ 1) (tBeforeFinish : t ≠ 1) (ordered : s < t)
        : Set.image(loop, Real.segment(s, t))
              ∩ (Set.image(loop, Real.segment(0, s))
                     ∪ Set.image(loop, Real.segment(t, 1)))
              = Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  Real.segment(s, t) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as middleInside;
  Real.segment(0, s) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as frontInside;
  Real.segment(t, 1) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as backInside;
  s ≤ t by Real.LessThan.weaken;
  s ≥ 0 by Real.unitInterval_nonneg;
  s ≤ 1 by Real.unitInterval_atMostOne;
  t ≤ 1 by Real.unitInterval_atMostOne;
  s < 1;
  t < 1;
  loop(0) = loop(1) as closesUp;

  Set.image(loop, Real.segment(s, t))
      ∩ (Set.image(loop, Real.segment(0, s))
             ∪ Set.image(loop, Real.segment(t, 1)))
      ⊆ Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t))
      by (z : Plane.Point)
         (onBoth : z ∈ Set.image(loop, Real.segment(s, t))
                       ∩ (Set.image(loop, Real.segment(0, s))
                              ∪ Set.image(loop, Real.segment(t, 1)))) ↦ {
        z ∈ Set.image(loop, Real.segment(s, t));
        choose middle : ℝ such that middle ∈ Real.segment(s, t) ∧ loop(middle) = z;
        middle ∈ Real.segment(s, t);
        loop(middle) = z as middleCarries;
        middle ∈ Real.unitInterval by middleInside;
        s ≤ middle by Real.segment_atLeast(b := t);
        middle ≤ t by Real.segment_atMost(a := s);
        middle < 1;
        middle ≠ 1 by Real.LessThan.distinct;

        z ∈ Set.image(loop, Real.segment(0, s))
            ∪ Set.image(loop, Real.segment(t, 1));
        done by cases {
          case z ∈ Set.image(loop, Real.segment(0, s)) as onFront: {
              choose outside : ℝ such that
                  outside ∈ Real.segment(0, s) ∧ loop(outside) = z from onFront;
              outside ∈ Real.segment(0, s);
              loop(outside) = z;
              outside ∈ Real.unitInterval by frontInside;
              outside ≤ s by Real.segment_atMost(a := 0);
              outside < 1;
              outside ≠ 1 by Real.LessThan.distinct;
              loop(middle) = loop(outside) by middleCarries;
              middle = outside by Plane.IsLoop.injective_before_finish;
              middle ≤ s by substituting (middle = outside);
              middle = s by Real.LessOrEqual.antisymmetric;
              loop(s) = z by substituting (middle = s);
              z = loop(s);
              z ∈ Set.singleton(Plane.Point, loop(s));
              done
            }
          case z ∈ Set.image(loop, Real.segment(t, 1)) as onBack: {
              choose outside : ℝ such that
                  outside ∈ Real.segment(t, 1) ∧ loop(outside) = z from onBack;
              outside ∈ Real.segment(t, 1);
              loop(outside) = z as outsideCarries;
              outside ∈ Real.unitInterval by backInside;
              t ≤ outside by Real.segment_atLeast(b := 1);
              done by cases {
                case outside = 1 as atFinish: {
                    -- The far end carries the same point as the start, and
                    -- the start is short of the finish, so the middle
                    -- parameter is the start — which forces `s` to be it.
                    loop(0)
                       = loop(1) by closesUp
                       = loop(outside) by substituting atFinish
                       = z by outsideCarries;
                    (0 : ℝ) ≠ 1;
                    loop(middle) = loop(0) by middleCarries;
                    middle = 0 by Plane.IsLoop.injective_before_finish;
                    s ≤ 0 by substituting (middle = 0);
                    s = 0 by Real.LessOrEqual.antisymmetric;
                    middle = s;
                    loop(s) = z by substituting (middle = s);
                    z = loop(s);
                    z ∈ Set.singleton(Plane.Point, loop(s));
                    done
                  }
                otherwise as beforeFinish: {
                    loop(middle) = loop(outside) by middleCarries;
                    middle = outside by Plane.IsLoop.injective_before_finish;
                    t ≤ middle by substituting (middle = outside);
                    middle = t by Real.LessOrEqual.antisymmetric;
                    loop(t) = z by substituting (middle = t);
                    z = loop(t);
                    z ∈ Set.singleton(Plane.Point, loop(t));
                    done
                  }
              }
            }
        }
      };

  s ∈ Real.segment(s, t) by Real.left_in_segment;
  t ∈ Real.segment(s, t) by Real.right_in_segment;
  s ∈ Real.segment(0, s) by Real.right_in_segment;
  t ∈ Real.segment(t, 1) by Real.left_in_segment;
  loop(s) ∈ Set.image(loop, Real.segment(s, t)) by { witness s };
  loop(t) ∈ Set.image(loop, Real.segment(s, t)) by { witness t };
  loop(s) ∈ Set.image(loop, Real.segment(0, s)) by { witness s };
  loop(t) ∈ Set.image(loop, Real.segment(t, 1)) by { witness t };
  Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t))
      ⊆ Set.image(loop, Real.segment(s, t))
            ∩ (Set.image(loop, Real.segment(0, s))
                   ∪ Set.image(loop, Real.segment(t, 1)))
      by (z : Plane.Point)
         (onEnds : z ∈ Set.singleton(Plane.Point, loop(s))
                       ∪ Set.singleton(Plane.Point, loop(t))) ↦ {
        done by cases {
          case z ∈ Set.singleton(Plane.Point, loop(s)) as atStart: {
              z = loop(s);
              z ∈ Set.image(loop, Real.segment(s, t))
                  by substituting (z = loop(s));
              z ∈ Set.image(loop, Real.segment(0, s))
                  by substituting (z = loop(s));
              z ∈ Set.image(loop, Real.segment(0, s))
                  ∪ Set.image(loop, Real.segment(t, 1));
              done
            }
          case z ∈ Set.singleton(Plane.Point, loop(t)) as atEnd: {
              z = loop(t);
              z ∈ Set.image(loop, Real.segment(s, t))
                  by substituting (z = loop(t));
              z ∈ Set.image(loop, Real.segment(t, 1))
                  by substituting (z = loop(t));
              z ∈ Set.image(loop, Real.segment(0, s))
                  ∪ Set.image(loop, Real.segment(t, 1));
              done
            }
        }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The three pieces are arcs.
--
-- Each needs the loop to be injective on its own parameters. On the middle
-- and the front that is injectivity off the finish, since neither contains
-- it. The back piece DOES contain the finish, and there the argument is
-- that the only other parameter carrying `loop(1)` is the start, which
-- lies strictly before `t`.

theorem Plane.IsLoop.injective_on_front (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s : ℝ) (sInside : s ∈ Real.unitInterval) (sBeforeFinish : s ≠ 1)
        : MetricSpace.InjectiveOn(loop, Real.segment(0, s)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  Real.segment(0, s) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as frontInside;
  s ≥ 0 by Real.unitInterval_nonneg;
  s ≤ 1 by Real.unitInterval_atMostOne;
  s < 1;
  take u : ℝ;
  suppose u ∈ Real.segment(0, s) as uOnFront;
  take v : ℝ;
  suppose v ∈ Real.segment(0, s) as vOnFront;
  suppose loop(u) = loop(v) as samePoint;
  u ∈ Real.unitInterval by frontInside;
  v ∈ Real.unitInterval by frontInside;
  u ≤ s by Real.segment_atMost(a := 0);
  v ≤ s by Real.segment_atMost(a := 0);
  u < 1;
  v < 1;
  u ≠ 1 by Real.LessThan.distinct;
  v ≠ 1 by Real.LessThan.distinct;
  done by Plane.IsLoop.injective_before_finish
}

theorem Plane.IsLoop.injective_on_middle (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s t : ℝ) (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (tBeforeFinish : t ≠ 1) (ordered : s ≤ t)
        : MetricSpace.InjectiveOn(loop, Real.segment(s, t)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  Real.segment(s, t) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as middleInside;
  t ≤ 1 by Real.unitInterval_atMostOne;
  t < 1;
  take u : ℝ;
  suppose u ∈ Real.segment(s, t) as uOnMiddle;
  take v : ℝ;
  suppose v ∈ Real.segment(s, t) as vOnMiddle;
  suppose loop(u) = loop(v) as samePoint;
  u ∈ Real.unitInterval by middleInside;
  v ∈ Real.unitInterval by middleInside;
  u ≤ t by Real.segment_atMost(a := s);
  v ≤ t by Real.segment_atMost(a := s);
  u < 1;
  v < 1;
  u ≠ 1 by Real.LessThan.distinct;
  v ≠ 1 by Real.LessThan.distinct;
  done by Plane.IsLoop.injective_before_finish
}

-- The back piece runs up to the finish, so injectivity off the finish is
-- not enough on its own: a parameter carrying `loop(1)` could be the start
-- instead. It cannot be, because the start is strictly before `t`.
theorem Plane.IsLoop.injective_on_back (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (t : ℝ) (tInside : t ∈ Real.unitInterval) (tPositive : t > 0)
        : MetricSpace.InjectiveOn(loop, Real.segment(t, 1)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  (0 : ℝ) ≠ 1;
  t ≤ 1 by Real.unitInterval_atMostOne;
  Real.segment(t, 1) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as backInside;
  loop(0) = loop(1) as closesUp;
  take u : ℝ;
  suppose u ∈ Real.segment(t, 1) as uOnBack;
  take v : ℝ;
  suppose v ∈ Real.segment(t, 1) as vOnBack;
  suppose loop(u) = loop(v) as samePoint;
  u ∈ Real.unitInterval by backInside;
  v ∈ Real.unitInterval by backInside;
  t ≤ u by Real.segment_atLeast(b := 1);
  t ≤ v by Real.segment_atLeast(b := 1);

  -- A parameter of this piece is the finish, or is short of it and so is
  -- pinned by injectivity. The start is excluded by lying before `t`.
  ∀ (w : ℝ). w ∈ Real.unitInterval → t ≤ w → loop(w) = loop(1) → w = 1
      by {
        take w : ℝ;
        suppose w ∈ Real.unitInterval as wInside;
        suppose t ≤ w as wPastT;
        suppose loop(w) = loop(1) as wAtFinishValue;
        suppose w ≠ 1 as wBeforeFinish for contradiction {
          loop(w) = loop(0) by { loop(w) = loop(1) by wAtFinishValue; done by closesUp };
          w = 0 by Plane.IsLoop.injective_before_finish;
          t ≤ 0 by substituting (w = 0);
          done
        };
        done
      }
      as onlyFinishCarriesIt;
  done by cases {
    case u = 1 as uAtFinish: {
        loop(v) = loop(1) by { loop(v) = loop(u) by samePoint; done by substituting uAtFinish };
        v = 1 by onlyFinishCarriesIt;
        done by substituting uAtFinish
      }
    otherwise as uBeforeFinish: {
        done by cases {
          case v = 1 as vAtFinish: {
              loop(u) = loop(1)
                  by { loop(u) = loop(v) by samePoint; done by substituting vAtFinish };
              u = 1 by onlyFinishCarriesIt;
              done
            }
          otherwise as vBeforeFinish: done by Plane.IsLoop.injective_before_finish
        }
      }
  }
}

-- ----------------------------------------------------------------------
-- An arc between two named points.

-- Right-nested, so that `IsArc` is a DIRECT leg: a consumer that only
-- wants "it is an arc" gets it by projection. Bracketed the other way the
-- auto-prover cannot reach one level deeper and rebuilds `IsArc` from
-- continuity and injectivity instead — measured at ~90k kernel steps a
-- site, against nothing for the projection.
definition Plane.IsArcBetween (piece : Set(Plane.Point)) (p q : Plane.Point) : Proposition :=
  ∃ (parametrisation : ℝ → Plane.Point).
    Plane.IsArc(parametrisation)
      ∧ (Plane.arc(parametrisation) = piece
             ∧ (Plane.arcStart(parametrisation) = p ∧ Plane.arcFinish(parametrisation) = q))

-- Each piece of parameters carries an arc, by the subarc reparametrisation
-- and the injectivity established above. `subarc_on_subsegment` is what
-- makes this available for a LOOP: it asks for injectivity only where the
-- subarc runs, which is exactly what each piece has.
theorem Plane.IsLoop.middle_IsArcBetween (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s t : ℝ) (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (tBeforeFinish : t ≠ 1) (ordered : s < t)
        : Plane.IsArcBetween(Set.image(loop, Real.segment(s, t)), loop(s), loop(t)) := {
  MetricSpace.ContinuousOn(loop, Real.unitInterval);
  s ≤ t by Real.LessThan.weaken;
  s ≠ t by Real.LessThan.distinct;
  MetricSpace.InjectiveOn(loop, Real.segment(s, t)) by Plane.IsLoop.injective_on_middle;
  Plane.IsArc(Plane.subarc(loop, s, t)) by Plane.IsArc.subarc_on_subsegment;
  Plane.arc(Plane.subarc(loop, s, t))
      = Set.image(loop, Real.segment(s, t)) by Plane.subarc_image;
  Plane.arcStart(Plane.subarc(loop, s, t)) = loop(s) by Plane.subarc_start;
  Plane.arcFinish(Plane.subarc(loop, s, t)) = loop(t) by Plane.subarc_finish;
  done by { witness Plane.subarc(loop, s, t) }
}

theorem Plane.IsLoop.front_IsArcBetween (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s : ℝ) (sInside : s ∈ Real.unitInterval) (sBeforeFinish : s ≠ 1) (sPositive : s > 0)
        : Plane.IsArcBetween(
              Set.image(loop, Real.segment(0, s)), loop(0), loop(s)) := {
  MetricSpace.ContinuousOn(loop, Real.unitInterval);
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (0 : ℝ) ≠ s by Real.LessThan.distinct;
  MetricSpace.InjectiveOn(loop, Real.segment(0, s)) by Plane.IsLoop.injective_on_front;
  Plane.IsArc(Plane.subarc(loop, 0, s)) by Plane.IsArc.subarc_on_subsegment;
  Plane.arc(Plane.subarc(loop, 0, s))
      = Set.image(loop, Real.segment(0, s)) by Plane.subarc_image;
  Plane.arcStart(Plane.subarc(loop, 0, s)) = loop(0) by Plane.subarc_start;
  Plane.arcFinish(Plane.subarc(loop, 0, s)) = loop(s) by Plane.subarc_finish;
  done by { witness Plane.subarc(loop, 0, s) }
}

theorem Plane.IsLoop.back_IsArcBetween (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (t : ℝ) (tInside : t ∈ Real.unitInterval) (tBeforeFinish : t ≠ 1) (tPositive : t > 0)
        : Plane.IsArcBetween(
              Set.image(loop, Real.segment(t, 1)), loop(t), loop(1)) := {
  MetricSpace.ContinuousOn(loop, Real.unitInterval);
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  t ≠ 1;
  MetricSpace.InjectiveOn(loop, Real.segment(t, 1)) by Plane.IsLoop.injective_on_back;
  Plane.IsArc(Plane.subarc(loop, t, 1)) by Plane.IsArc.subarc_on_subsegment;
  Plane.arc(Plane.subarc(loop, t, 1))
      = Set.image(loop, Real.segment(t, 1)) by Plane.subarc_image;
  Plane.arcStart(Plane.subarc(loop, t, 1)) = loop(t) by Plane.subarc_start;
  Plane.arcFinish(Plane.subarc(loop, t, 1)) = loop(1) by Plane.subarc_finish;
  done by { witness Plane.subarc(loop, t, 1) }
}

-- ----------------------------------------------------------------------
-- The outside piece.
--
-- The parameters outside `[s,t]` are two intervals, glued at the point
-- where the loop closes up: walk from `t` to the finish, then from the
-- start to `s`. When `s` IS the start the front interval degenerates, and
-- the outside is the back piece alone — its far end already carries the
-- point that the front piece would have contributed.

theorem Plane.IsLoop.outside_IsArcBetween (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s t : ℝ) (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (sBeforeFinish : s ≠ 1) (tBeforeFinish : t ≠ 1) (ordered : s < t)
        : Plane.IsArcBetween(
              Set.image(loop, Real.segment(0, s))
                  ∪ Set.image(loop, Real.segment(t, 1)),
              loop(t), loop(s)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;
  Real.segment(0, s) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as frontInside;
  Real.segment(t, 1) ⊆ Real.unitInterval by Real.IsConvex.segment_inside as backInside;
  s ≥ 0 by Real.unitInterval_nonneg;
  t > 0;
  loop(0) = loop(1) as closesUp;
  (1 : ℝ) ∈ Real.segment(t, 1) by Real.right_in_segment;
  loop(1) ∈ Set.image(loop, Real.segment(t, 1)) by { witness (1 : ℝ) };
  done by cases {
    case s = 0 as startsAtOrigin: {
        -- The front interval is the single parameter 0, whose point the
        -- back piece already carries at its far end.
        Set.image(loop, Real.segment(0, s))
            ⊆ Set.image(loop, Real.segment(t, 1))
            by (z : Plane.Point)
               (onFront : z ∈ Set.image(loop, Real.segment(0, s))) ↦ {
              choose source : ℝ such that
                  source ∈ Real.segment(0, s) ∧ loop(source) = z from onFront;
              source ∈ Real.segment(0, s);
              loop(source) = z as carriesToZ;
              source ∈ Real.unitInterval by frontInside;
              source ≤ s by Real.segment_atMost(a := 0);
              source ≤ 0 by substituting startsAtOrigin;
              source ≥ 0 by Real.unitInterval_nonneg;
              source = 0 by Real.LessOrEqual.antisymmetric;
              z = loop(1)
                 by { loop(1)
                        = loop(0) by closesUp
                        = loop(source) by substituting (source = 0)
                        = z by carriesToZ };
              done by substituting (z = loop(1))
            };
        Set.image(loop, Real.segment(t, 1))
            ⊆ Set.image(loop, Real.segment(t, 1)) by Set.subset.reflexive;
        Set.image(loop, Real.segment(0, s))
            ∪ Set.image(loop, Real.segment(t, 1))
            ⊆ Set.image(loop, Real.segment(t, 1)) by Set.union_subset;
        Set.image(loop, Real.segment(t, 1))
            ⊆ Set.image(loop, Real.segment(0, s))
                  ∪ Set.image(loop, Real.segment(t, 1))
            by Set.subset_union_right;
        Set.image(loop, Real.segment(0, s))
            ∪ Set.image(loop, Real.segment(t, 1))
            = Set.image(loop, Real.segment(t, 1))
            by Set.equal_of_same_members as outsideIsBack;
        loop(1) = loop(s)
            by { loop(1) = loop(0) by closesUp;
                 done by substituting startsAtOrigin }
            as finishIsS;
        Plane.IsArcBetween(
            Set.image(loop, Real.segment(t, 1)), loop(t), loop(1))
            by Plane.IsLoop.back_IsArcBetween;
        choose back such that
            Plane.IsArc(back)
              ∧ (Plane.arc(back) = Set.image(loop, Real.segment(t, 1))
                     ∧ (Plane.arcStart(back) = loop(t) ∧ Plane.arcFinish(back) = loop(1)));
        Plane.IsArc(back);
        Plane.arc(back) = Set.image(loop, Real.segment(t, 1)) as backImage;
        Plane.arcStart(back) = loop(t);
        Plane.arcFinish(back) = loop(1) as backEnds;
        Plane.arcFinish(back) = loop(s)
            by { Plane.arcFinish(back) = loop(1) by backEnds; done by finishIsS };
        Plane.arc(back)
           = Set.image(loop, Real.segment(t, 1)) by backImage
           = Set.image(loop, Real.segment(0, s))
                 ∪ Set.image(loop, Real.segment(t, 1)) by outsideIsBack;
        done by { witness back }
      }
    otherwise as startsLater: {
        s > 0;
        Plane.IsArcBetween(
            Set.image(loop, Real.segment(t, 1)), loop(t), loop(1))
            by Plane.IsLoop.back_IsArcBetween;
        choose back such that
            Plane.IsArc(back)
              ∧ (Plane.arc(back) = Set.image(loop, Real.segment(t, 1))
                     ∧ (Plane.arcStart(back) = loop(t) ∧ Plane.arcFinish(back) = loop(1)))
            as backFacts;
        Plane.IsArc(back) by backFacts;
        Plane.arc(back) = Set.image(loop, Real.segment(t, 1)) as backImage;
        Plane.arcStart(back) = loop(t);
        Plane.arcFinish(back) = loop(1) as backEnds;

        Plane.IsArcBetween(
            Set.image(loop, Real.segment(0, s)), loop(0), loop(s))
            by Plane.IsLoop.front_IsArcBetween;
        choose front such that
            Plane.IsArc(front)
              ∧ (Plane.arc(front) = Set.image(loop, Real.segment(0, s))
                     ∧ (Plane.arcStart(front) = loop(0) ∧ Plane.arcFinish(front) = loop(s)))
            as frontFacts;
        Plane.IsArc(front) by frontFacts;
        Plane.arc(front) = Set.image(loop, Real.segment(0, s)) as frontImage;
        Plane.arcStart(front) = loop(0) as frontStarts;
        Plane.arcFinish(front) = loop(s);

        Plane.arcFinish(back) = Plane.arcStart(front)
            by { Plane.arcFinish(back)
                   = loop(1) by backEnds
                   = loop(0) by closesUp
                   = Plane.arcStart(front) by frontStarts };

        -- The two run over disjoint parameter ranges apart from the seam:
        -- a point on both comes from a parameter at or past `t` and from
        -- one at or before `s`, and only the finish can be both.
        ∀ (z : Plane.Point). z ∈ Plane.arc(back) → z ∈ Plane.arc(front)
            → z = Plane.arcFinish(back)
            by {
              take z : Plane.Point;
              suppose z ∈ Plane.arc(back) as onBack;
              suppose z ∈ Plane.arc(front) as onFront;
              z ∈ Set.image(loop, Real.segment(t, 1)) by substituting backImage;
              z ∈ Set.image(loop, Real.segment(0, s)) by substituting frontImage;
              choose backSource : ℝ such that
                  backSource ∈ Real.segment(t, 1) ∧ loop(backSource) = z
                  from (z ∈ Set.image(loop, Real.segment(t, 1)));
              backSource ∈ Real.segment(t, 1);
              loop(backSource) = z as backCarries;
              choose frontSource : ℝ such that
                  frontSource ∈ Real.segment(0, s) ∧ loop(frontSource) = z
                  from (z ∈ Set.image(loop, Real.segment(0, s)));
              frontSource ∈ Real.segment(0, s);
              loop(frontSource) = z as frontCarries;
              backSource ∈ Real.unitInterval by backInside;
              frontSource ∈ Real.unitInterval by frontInside;
              t ≤ backSource by Real.segment_atLeast(b := 1);
              frontSource ≤ s by Real.segment_atMost(a := 0);
              s ≤ 1 by Real.unitInterval_atMostOne;
              s < 1;
              frontSource < 1;
              frontSource ≠ 1 by Real.LessThan.distinct;
              suppose backSource ≠ 1 as backBeforeFinish for contradiction {
                loop(backSource) = loop(frontSource)
                    by { loop(backSource) = z by backCarries; done by frontCarries };
                backSource = frontSource by Plane.IsLoop.injective_before_finish;
                t ≤ frontSource by substituting (backSource = frontSource);
                t ≤ s;
                s < s;
                done
              };
              backSource = 1;
              z = loop(1)
                  by { loop(1)
                         = loop(backSource) by substituting (backSource = 1)
                         = z by backCarries };
              done by backEnds
            };

        Plane.IsArc(Plane.concatenate(back, front)) by Plane.IsArc.concatenate;
        Plane.arc(Plane.concatenate(back, front))
           = Plane.arc(back) ∪ Plane.arc(front) by Plane.arc_concatenate
           = Set.image(loop, Real.segment(t, 1)) ∪ Plane.arc(front)
                 by substituting backImage
           = Set.image(loop, Real.segment(t, 1))
                 ∪ Set.image(loop, Real.segment(0, s)) by substituting frontImage
           = Set.image(loop, Real.segment(0, s))
                 ∪ Set.image(loop, Real.segment(t, 1)) by Set.union_commutative;
        Plane.arcStart(Plane.concatenate(back, front))
            = Plane.arcStart(back) by Plane.concatenate_start;
        Plane.arcStart(Plane.concatenate(back, front)) = loop(t);
        Plane.arcFinish(Plane.concatenate(back, front))
            = Plane.arcFinish(front) by Plane.concatenate_finish;
        Plane.arcFinish(Plane.concatenate(back, front)) = loop(s);
        done by { witness Plane.concatenate(back, front) }
      }
  }
}

-- ----------------------------------------------------------------------
-- The two arcs, at chosen parameters.
--
-- With the pieces in hand the statement assembles: the middle and the
-- outside are arcs between the two points, they cover the curve because
-- the parameters cover the interval, and they meet only at the two points
-- because the parameters meet only at `s` and `t`.

theorem Plane.IsLoop.two_arcs_at_parameters (loop : ℝ → Plane.Point) (isLoop : Plane.IsLoop(loop))
        (s t : ℝ) (sInside : s ∈ Real.unitInterval) (tInside : t ∈ Real.unitInterval)
        (sBeforeFinish : s ≠ 1) (tBeforeFinish : t ≠ 1) (ordered : s < t)
        : ∃ (middle : Set(Plane.Point)). ∃ (outside : Set(Plane.Point)).
            (Plane.IsArcBetween(middle, loop(s), loop(t))
                 ∧ Plane.IsArcBetween(outside, loop(t), loop(s)))
              ∧ (middle ∪ outside = Set.image(loop, Real.unitInterval)
                     ∧ middle ∩ outside
                           = Set.singleton(Plane.Point, loop(s))
                                 ∪ Set.singleton(Plane.Point, loop(t))) := {
  s ≤ t by Real.LessThan.weaken;
  Plane.IsArcBetween(Set.image(loop, Real.segment(s, t)), loop(s), loop(t))
      by Plane.IsLoop.middle_IsArcBetween;
  Plane.IsArcBetween(
      Set.image(loop, Real.segment(0, s))
          ∪ Set.image(loop, Real.segment(t, 1)),
      loop(t), loop(s))
      by Plane.IsLoop.outside_IsArcBetween;

  Real.unitInterval = Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1))
      by Real.unitInterval_split as splitParameters;
  Set.image(loop, Real.unitInterval)
     = Set.image(
           loop, Real.segment(s, t) ∪ (Real.segment(0, s) ∪ Real.segment(t, 1)))
           by substituting splitParameters
     = Set.image(loop, Real.segment(s, t))
           ∪ Set.image(loop, Real.segment(0, s) ∪ Real.segment(t, 1))
           by Set.image_union
     = Set.image(loop, Real.segment(s, t))
           ∪ (Set.image(loop, Real.segment(0, s))
                  ∪ Set.image(loop, Real.segment(t, 1)))
           by Set.image_union;

  Set.image(loop, Real.segment(s, t))
      ∩ (Set.image(loop, Real.segment(0, s))
             ∪ Set.image(loop, Real.segment(t, 1)))
      = Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t))
      by Plane.IsLoop.pieces_meet_at_ends;
  done by { witness Set.image(loop, Real.segment(s, t)) with
              { witness Set.image(loop, Real.segment(0, s))
                            ∪ Set.image(loop, Real.segment(t, 1)) } }
}

-- ----------------------------------------------------------------------
-- The theorem.

-- Two distinct points of a Jordan curve cut it into two arcs between them,
-- which cover the curve and meet in exactly those two points.
--
-- The parameters carrying the two points come in one order or the other,
-- and the conclusion is symmetric in them, so the second case is the first
-- with the two points exchanged — the two arcs swap roles and the union
-- and intersection commute.
theorem Plane.IsJordanCurve.two_arcs (curve : Set(Plane.Point))
        (isCurve : Plane.IsJordanCurve(curve))
        (p q : Plane.Point) (pOnCurve : p ∈ curve) (qOnCurve : q ∈ curve) (distinct : p ≠ q)
        : ∃ (firstPiece : Set(Plane.Point)). ∃ (secondPiece : Set(Plane.Point)).
            (Plane.IsArcBetween(firstPiece, p, q) ∧ Plane.IsArcBetween(secondPiece, q, p))
              ∧ (firstPiece ∪ secondPiece = curve
                     ∧ firstPiece ∩ secondPiece
                           = Set.singleton(Plane.Point, p) ∪ Set.singleton(Plane.Point, q)) := {
  choose loop such that
      Plane.IsLoop(loop) ∧ Set.image(loop, Real.unitInterval) = curve from isCurve;
  Plane.IsLoop(loop);
  Set.image(loop, Real.unitInterval) = curve as carriesOnto;
  p ∈ Set.image(loop, Real.unitInterval) by substituting carriesOnto;
  q ∈ Set.image(loop, Real.unitInterval) by substituting carriesOnto;

  choose s such that (s ∈ Real.unitInterval ∧ s ≠ 1) ∧ loop(s) = p
      from Plane.IsLoop.parameter_before_finish(p := p);
  s ∈ Real.unitInterval;
  s ≠ 1;
  loop(s) = p as sCarriesP;
  choose t such that (t ∈ Real.unitInterval ∧ t ≠ 1) ∧ loop(t) = q
      from Plane.IsLoop.parameter_before_finish(p := q);
  t ∈ Real.unitInterval;
  t ≠ 1;
  loop(t) = q as tCarriesQ;

  -- Distinct points, so distinct parameters, so one comes first.
  s ≠ t
      by { suppose s = t as sameParameter;
           p = loop(t) by { p = loop(s) by sCarriesP; done by substituting sameParameter };
           p = q by tCarriesQ;
           done };
  done by cases {
    case s < t as sFirst: {
        choose middle : Set(Plane.Point), outside : Set(Plane.Point) such that
            (Plane.IsArcBetween(middle, loop(s), loop(t))
                 ∧ Plane.IsArcBetween(outside, loop(t), loop(s)))
              ∧ (middle ∪ outside = Set.image(loop, Real.unitInterval)
                     ∧ middle ∩ outside
                           = Set.singleton(Plane.Point, loop(s))
                                 ∪ Set.singleton(Plane.Point, loop(t)))
            from Plane.IsLoop.two_arcs_at_parameters;
        Plane.IsArcBetween(middle, loop(s), loop(t));
        Plane.IsArcBetween(outside, loop(t), loop(s));
        middle ∪ outside = Set.image(loop, Real.unitInterval) as covers;
        middle ∩ outside
            = Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t)) as meets;
        Plane.IsArcBetween(middle, p, q) by substituting sCarriesP;
        Plane.IsArcBetween(outside, q, p) by substituting sCarriesP;
        middle ∪ outside = curve
            by { middle ∪ outside = Set.image(loop, Real.unitInterval) by covers;
                 done by carriesOnto };
        middle ∩ outside
           = Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t)) by meets
           = Set.singleton(Plane.Point, p) ∪ Set.singleton(Plane.Point, loop(t))
                 by substituting sCarriesP
           = Set.singleton(Plane.Point, p) ∪ Set.singleton(Plane.Point, q)
                 by substituting tCarriesQ;
        done by { witness middle with { witness outside } }
      }
    otherwise as tFirst: {
        t ≤ s by Real.LessOrEqual_of_not_LessThan;
        t ≠ s;
        t < s;
        choose middle : Set(Plane.Point), outside : Set(Plane.Point) such that
            (Plane.IsArcBetween(middle, loop(t), loop(s))
                 ∧ Plane.IsArcBetween(outside, loop(s), loop(t)))
              ∧ (middle ∪ outside = Set.image(loop, Real.unitInterval)
                     ∧ middle ∩ outside
                           = Set.singleton(Plane.Point, loop(t))
                                 ∪ Set.singleton(Plane.Point, loop(s)))
            from Plane.IsLoop.two_arcs_at_parameters;
        Plane.IsArcBetween(middle, loop(t), loop(s));
        Plane.IsArcBetween(outside, loop(s), loop(t));
        middle ∪ outside = Set.image(loop, Real.unitInterval) as covers;
        middle ∩ outside
            = Set.singleton(Plane.Point, loop(t)) ∪ Set.singleton(Plane.Point, loop(s)) as meets;
        -- The middle runs from `q` to `p`, so it is the SECOND piece here.
        Plane.IsArcBetween(middle, q, p) by substituting tCarriesQ;
        Plane.IsArcBetween(outside, p, q) by substituting tCarriesQ;
        outside ∪ middle
           = middle ∪ outside by Set.union_commutative
           = Set.image(loop, Real.unitInterval) by covers
           = curve by carriesOnto;
        outside ∩ middle
           = middle ∩ outside by Set.intersection_commutative
           = Set.singleton(Plane.Point, loop(t)) ∪ Set.singleton(Plane.Point, loop(s)) by meets
           = Set.singleton(Plane.Point, loop(s)) ∪ Set.singleton(Plane.Point, loop(t))
                 by Set.union_commutative
           = Set.singleton(Plane.Point, p) ∪ Set.singleton(Plane.Point, loop(t))
                 by substituting sCarriesP
           = Set.singleton(Plane.Point, p) ∪ Set.singleton(Plane.Point, q)
                 by substituting tCarriesQ;
        done by { witness outside with { witness middle } }
      }
  }
}
