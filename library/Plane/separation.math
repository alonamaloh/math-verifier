-- Plane/separation.math
--
-- Disjoint compact sets in the plane are a positive distance apart.
--
-- This is the blueprint's `lem:compact-separation`. Nothing about it is
-- about the plane — the argument is the closing-pairs one over any metric
-- space — so it lives in `Metric/separation.math` and the names here are
-- how the Jordan–Schönflies development speaks it.
--
-- Beside it, what a separation is spent on: `Plane.nearSet(region, radius)`,
-- the points within `radius` of some point of `region`. There is
-- deliberately no distance-to-a-set function in this development — an
-- infimum would have to be produced and then read back, where every
-- consumer either exhibits a near point or is handed one.

module Plane.separation

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.maximum
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.linearity
import Real.division
import Real.absolute_value
import Real.absolute_value_order
import Real.convergence
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.sequence
import Metric.compactness
import Metric.finite_union
import Metric.separation
import Plane.vector
import Plane.point
import Plane.bilinear
import Plane.direction
import Plane.norm
import Plane.metric
import Plane.sequence
import Plane.compact
import Plane.compactness
import Plane.topology

-- Moving the far endpoint moves the distance by no more than the move.
-- The Euclidean twin of `Plane.supDistance_shift_bound`, and what makes
-- `distance(center, ·)` continuous — hence its level sets closed.
theorem Plane.distance_shift_bound (center x y : Plane.Point)
        : abs(Plane.distance(center, y) - Plane.distance(center, x))
              ≤ Plane.distance(x, y) :=
  done by MetricSpace.distance_shift_bound

theorem Plane.equal_limits_of_closing
        (u v : ℕ → Plane.Point) (index : ℕ → ℕ)
        (limitU limitV : Plane.Point)
        (increasing : Natural.IsStrictlyIncreasing(index))
        (toU : Plane.SequenceConverges((k : ℕ) ↦ u(index(k)), limitU))
        (toV : Plane.SequenceConverges((k : ℕ) ↦ v(index(k)), limitV))
        (closing : ∀ (n : ℕ).
            Plane.distance(u(n), v(n)) < Real.harmonic_term(n))
        : limitU = limitV :=
  done by MetricSpace.equal_limits_of_closing

theorem Plane.closing_pairs_share_a_limit
        (regionA regionB : Set(Plane.Point))
        (compactA : Plane.IsCompact(regionA))
        (compactB : Plane.IsCompact(regionB))
        (u v : ℕ → Plane.Point)
        (insideA : ∀ (n : ℕ). u(n) ∈ regionA)
        (insideB : ∀ (n : ℕ). v(n) ∈ regionB)
        (closing : ∀ (n : ℕ).
            Plane.distance(u(n), v(n)) < Real.harmonic_term(n))
        : ∃ (index : ℕ → ℕ). ∃ (limit : Plane.Point).
            (limit ∈ regionA ∧ limit ∈ regionB)
            ∧ (Plane.SequenceConverges((k : ℕ) ↦ u(index(k)), limit)
                   ∧ Plane.SequenceConverges((k : ℕ) ↦ v(index(k)), limit)) :=
  done by MetricSpace.closing_pairs_share_a_limit

theorem Plane.close_pair_at_every_scale
        (regionA regionB : Set(Plane.Point))
        (noGap : ¬(∃ (gap : ℝ). 0 < gap ∧
            ∀ (a : Plane.Point). a ∈ regionA →
              ∀ (b : Plane.Point). b ∈ regionB →
                gap ≤ Plane.distance(a, b)))
        (n : ℕ)
        : ∃ (a : Plane.Point). a ∈ regionA ∧
            ∃ (b : Plane.Point). b ∈ regionB
                ∧ Plane.distance(a, b) < Real.harmonic_term(n) :=
  done by MetricSpace.close_pair_at_every_scale

theorem Plane.compact_separation (regionA regionB : Set(Plane.Point))
        (compactA : Plane.IsCompact(regionA))
        (compactB : Plane.IsCompact(regionB))
        (disjoint : ∀ (x : Plane.Point). x ∈ regionA → x ∉ regionB)
        : ∃ (gap : ℝ). 0 < gap ∧
            ∀ (a : Plane.Point). a ∈ regionA →
              ∀ (b : Plane.Point). b ∈ regionB →
                gap ≤ Plane.distance(a, b) :=
  done by MetricSpace.compact_separation

-- The case where one side is a single point, which is the one the vertex
-- squares of a plane graph want: a point off a compact set stands a
-- positive distance from all of it. A compact set is closed, so its
-- complement is open, and the ball the complement supplies is the gap.
theorem Plane.compact_separation_from_point (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (x : Plane.Point) (outside : x ∉ region)
        : ∃ (gap : ℝ). gap > 0 ∧
            ∀ (y : Plane.Point). y ∈ region → gap ≤ Plane.distance(x, y) := {
  Plane.Closure(region) ⊆ region by Plane.IsCompact.Closure_subset;
  Plane.IsOpen(Set.complement(region)) by MetricSpace.complement_IsOpen;
  x ∈ Set.complement(region);
  choose gap such that gap > 0 ∧
      ∀ (y : Plane.Point). Plane.distance(x, y) < gap → y ∈ Set.complement(region)
      from Plane.IsOpen.ball_inside;
  gap > 0;
  ∀ (y : Plane.Point). y ∈ region → gap ≤ Plane.distance(x, y)
      by { take y : Plane.Point;
           suppose y ∈ region;
           ¬(Plane.distance(x, y) < gap)
               by { suppose Plane.distance(x, y) < gap;
                    y ∈ Set.complement(region);
                    done };
           done by Real.LessOrEqual_of_not_LessThan };
  witness gap
}

-- ----------------------------------------------------------------------
-- The neighbourhood of a set.

definition Plane.nearSet (region : Set(Plane.Point)) (radius : ℝ)
        : Set(Plane.Point) :=
  (x : Plane.Point) ↦
    ∃ (near : Plane.Point). near ∈ region ∧ Plane.distance(x, near) < radius

theorem Plane.nearSet_member (region : Set(Plane.Point)) (radius : ℝ)
        (x near : Plane.Point) (inRegion : near ∈ region)
        (isNear : Plane.distance(x, near) < radius)
        : x ∈ Plane.nearSet(region, radius) :=
  witness near

theorem Plane.nearSet_member_invert (region : Set(Plane.Point)) (radius : ℝ)
        (x : Plane.Point) (inNearSet : x ∈ Plane.nearSet(region, radius))
        : ∃ (near : Plane.Point).
            near ∈ region ∧ Plane.distance(x, near) < radius :=
  done

-- A set lies in its own neighbourhood: each of its points is its own
-- witness, at no distance at all.
theorem Plane.subset_nearSet (region : Set(Plane.Point)) (radius : ℝ)
        (radiusPositive : radius > 0)
        : region ⊆ Plane.nearSet(region, radius) := {
  take x : Plane.Point;
  suppose x ∈ region;
  Plane.distance(x, x) = 0;
  Plane.distance(x, x) < radius;
  done by Plane.nearSet_member
}

-- The neighbourhood is open: a point of it has room to spare against the
-- witness that puts it there, and the triangle inequality spends that room.
theorem Plane.nearSet_IsOpen (region : Set(Plane.Point)) (radius : ℝ)
        : Plane.IsOpen(Plane.nearSet(region, radius)) := {
  take x : Plane.Point;
  suppose x ∈ Plane.nearSet(region, radius) as inNearSet;
  suppose x ∈ Set.universe(Plane.Point);
  choose near such that
      near ∈ region ∧ Plane.distance(x, near) < radius from inNearSet;
  near ∈ region;
  Plane.distance(x, near) < radius;
  let room : ℝ := radius - Plane.distance(x, near);
  room > 0;
  ∀ (y : Plane.Point). y ∈ Set.universe(Plane.Point) →
      Plane.distance(x, y) < room → y ∈ Plane.nearSet(region, radius)
      by { take y : Plane.Point;
           suppose y ∈ Set.universe(Plane.Point);
           suppose Plane.distance(x, y) < room;
           Plane.distance(y, near)
              ≤ Plane.distance(y, x) + Plane.distance(x, near)
                    by Plane.distance_triangle
              = Plane.distance(x, y) + Plane.distance(x, near)
                    by Plane.distance_symmetric
              < room + Plane.distance(x, near)
              = radius by ring;
           done by Plane.nearSet_member };
  witness room
}

-- A separation only gets easier to satisfy as the gap shrinks.
theorem Plane.separated_at_smaller_gap (left right : Set(Plane.Point))
        (smaller larger : ℝ) (ordered : smaller ≤ larger)
        (separated : ∀ (a b : Plane.Point). a ∈ left → b ∈ right →
            2 * larger ≤ Plane.distance(a, b))
        : ∀ (a b : Plane.Point). a ∈ left → b ∈ right →
            2 * smaller ≤ Plane.distance(a, b) := {
  take a : Plane.Point;
  take b : Plane.Point;
  suppose a ∈ left;
  suppose b ∈ right;
  2 * smaller ≤ 2 * larger
              ≤ Plane.distance(a, b) by separated
}

-- Two sets `2 * radius` apart have disjoint `radius`-neighbourhoods: a
-- point of both neighbourhoods would carry a point of each set across to
-- the other in two steps of less than `radius`.
theorem Plane.nearSet_disjoint_of_separated (left right : Set(Plane.Point))
        (radius : ℝ)
        (separated : ∀ (a b : Plane.Point). a ∈ left → b ∈ right →
            2 * radius ≤ Plane.distance(a, b))
        : Set.Disjoint(Plane.nearSet(left, radius),
              Plane.nearSet(right, radius)) := {
  take x : Plane.Point;
  suppose x ∈ Plane.nearSet(left, radius) as nearLeft;
  suppose x ∈ Plane.nearSet(right, radius) as nearRight;
  choose a such that a ∈ left ∧ Plane.distance(x, a) < radius from nearLeft;
  choose b such that b ∈ right ∧ Plane.distance(x, b) < radius from nearRight;
  a ∈ left;
  b ∈ right;
  2 * radius ≤ Plane.distance(a, b) by separated
             ≤ Plane.distance(a, x) + Plane.distance(x, b)
             = Plane.distance(x, a) + Plane.distance(x, b)
                   by Plane.distance_symmetric
             < radius + radius
             = 2 * radius;
  done
}
