-- Plane/separation.math
--
-- Disjoint compact sets in the plane are a positive distance apart.
--
-- This is the blueprint's `lem:compact-separation`. Nothing about it is
-- about the plane — the argument is the closing-pairs one over any metric
-- space — so it lives in `Metric/separation.math` and the names here are
-- how the Jordan–Schönflies development speaks it.

module Plane.separation

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.maximum
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.division
import Real.absolute_value
import Real.absolute_value_order
import Real.convergence
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.sequence
import Metric.compactness
import Metric.separation
import Plane.vector
import Plane.point
import Plane.bilinear
import Plane.direction
import Plane.norm
import Plane.metric
import Plane.sequence
import Plane.compact
import Plane.compactness

-- Moving the far endpoint moves the distance by no more than the move.
-- The Euclidean twin of `Plane.supDistance_shift_bound`, and what makes
-- `distance(center, ·)` continuous — hence its level sets closed.
theorem Plane.distance_shift_bound (center x y : Plane.Point)
        : abs(Plane.distance(center, y) - Plane.distance(center, x))
              ≤ Plane.distance(x, y) :=
  done by MetricSpace.distance_shift_bound

theorem Plane.equal_limits_of_closing
        (u v : ℕ → Plane.Point) (index : ℕ → ℕ)
        (limitU limitV : Plane.Point)
        (increasing : Natural.IsStrictlyIncreasing(index))
        (toU : Plane.SequenceConverges((k : ℕ) ↦ u(index(k)), limitU))
        (toV : Plane.SequenceConverges((k : ℕ) ↦ v(index(k)), limitV))
        (closing : ∀ (n : ℕ).
            Plane.distance(u(n), v(n)) < Real.harmonic_term(n))
        : limitU = limitV :=
  done by MetricSpace.equal_limits_of_closing

theorem Plane.closing_pairs_share_a_limit
        (regionA regionB : Set(Plane.Point))
        (compactA : Plane.IsCompact(regionA))
        (compactB : Plane.IsCompact(regionB))
        (u v : ℕ → Plane.Point)
        (insideA : ∀ (n : ℕ). u(n) ∈ regionA)
        (insideB : ∀ (n : ℕ). v(n) ∈ regionB)
        (closing : ∀ (n : ℕ).
            Plane.distance(u(n), v(n)) < Real.harmonic_term(n))
        : ∃ (index : ℕ → ℕ). ∃ (limit : Plane.Point).
            (limit ∈ regionA ∧ limit ∈ regionB)
            ∧ (Plane.SequenceConverges((k : ℕ) ↦ u(index(k)), limit)
                   ∧ Plane.SequenceConverges((k : ℕ) ↦ v(index(k)), limit)) :=
  done by MetricSpace.closing_pairs_share_a_limit

theorem Plane.close_pair_at_every_scale
        (regionA regionB : Set(Plane.Point))
        (noGap : ¬(∃ (gap : ℝ). 0 < gap ∧
            ∀ (a : Plane.Point). a ∈ regionA →
              ∀ (b : Plane.Point). b ∈ regionB →
                gap ≤ Plane.distance(a, b)))
        (n : ℕ)
        : ∃ (a : Plane.Point). a ∈ regionA ∧
            ∃ (b : Plane.Point). b ∈ regionB
                ∧ Plane.distance(a, b) < Real.harmonic_term(n) :=
  done by MetricSpace.close_pair_at_every_scale

theorem Plane.compact_separation (regionA regionB : Set(Plane.Point))
        (compactA : Plane.IsCompact(regionA))
        (compactB : Plane.IsCompact(regionB))
        (disjoint : ∀ (x : Plane.Point). x ∈ regionA → x ∉ regionB)
        : ∃ (gap : ℝ). 0 < gap ∧
            ∀ (a : Plane.Point). a ∈ regionA →
              ∀ (b : Plane.Point). b ∈ regionB →
                gap ≤ Plane.distance(a, b) :=
  done by MetricSpace.compact_separation
