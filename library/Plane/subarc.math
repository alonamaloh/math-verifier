-- Plane/subarc.math
--
-- Subarcs, and the arc without its endpoints. Layer 4.
--
-- A subarc is the arc restricted to a subinterval of the parameter
-- interval — but an arc is a map ON `[0,1]`, so the restriction has to be
-- reparametrised back onto it. That reparametrisation is
-- `Real.between(a, b)`, the affine map `t ↦ a + t·(b - a)`: arithmetic,
-- with no inverse to construct and no choice to make.
--
-- With it, a subarc is a composition, and the two things an arc must be —
-- continuous and injective — are the two things a composition inherits.

module Plane.subarc

import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Real.interface
import Real.order
import Real.order_field
import Real.absolute_value
import Real.absolute_value_order
import Metric.space
import Metric.real
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness
import Metric.connected
import Metric.homeomorphism
import Metric.interval
import Plane.vector
import Plane.point
import Plane.norm
import Plane.metric
import Plane.segment
import Plane.topology
import Plane.compactness
import Plane.connected
import Plane.separation
import Plane.model
import Plane.homeomorphism
import Plane.curve

-- ----------------------------------------------------------------------
-- Reparametrising the unit interval onto a subinterval.

theorem Real.between_lands (a b t : ℝ) (atLeastZero : 0 ≤ t) (atMostOne : t ≤ 1)
        : Real.between(a, b, t) ∈ Real.segment(a, b) :=
  witness t

theorem Real.between_ContinuousOn (a b : ℝ)
        : MetricSpace.ContinuousOn(Real.between(a, b), Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  Real.parameterGap(tolerance, a, b) > 0 by Real.parameterGap_positive;
  witness Real.parameterGap(tolerance, a, b) with {
    Real.parameterGap(tolerance, a, b) > 0;
    ∀ (y : ℝ). y ∈ Real.unitInterval →
        distance(x, y) < Real.parameterGap(tolerance, a, b) →
          distance(Real.between(a, b, x), Real.between(a, b, y))
              < tolerance
        by (y : ℝ) (inside : y ∈ Real.unitInterval)
           (near : distance(x, y)
                       < Real.parameterGap(tolerance, a, b)) ↦ {
          abs(y - x)
             = abs(x - y) by Real.absolute_value_subtract_swap
             = distance(x, y)
             < Real.parameterGap(tolerance, a, b);
          done by Real.between_close_of_gap
        };
    done
  }
}

theorem Real.between_InjectiveOn (a b : ℝ) (distinct : a ≠ b)
        : MetricSpace.InjectiveOn(Real.between(a, b), Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval as xInside;
  take y : ℝ;
  suppose y ∈ Real.unitInterval as yInside;
  suppose Real.between(a, b, x) = Real.between(a, b, y) as sameWalk;
  done by Real.between_injective
}

-- ----------------------------------------------------------------------
-- Subarcs.

definition Plane.subarc (parametrisation : ℝ → Plane.Point) (a b : ℝ)
        : ℝ → Plane.Point :=
  (t : ℝ) ↦ parametrisation(Real.between(a, b, t))

theorem Plane.subarc_start (parametrisation : ℝ → Plane.Point) (a b : ℝ)
        : Plane.arcStart(Plane.subarc(parametrisation, a, b))
              = parametrisation(a) := {
  Real.between(a, b, 0) = a by Real.between_zero;
  done by substituting Real.between(a, b, 0) = a
}

theorem Plane.subarc_finish (parametrisation : ℝ → Plane.Point) (a b : ℝ)
        : Plane.arcFinish(Plane.subarc(parametrisation, a, b))
              = parametrisation(b) := {
  Real.between(a, b, 1) = b by Real.between_one;
  done by substituting Real.between(a, b, 1) = b
}

-- A subarc between two distinct parameters is an arc: the
-- reparametrisation is continuous and injective onto a subinterval, and
-- the unit interval is convex, so that subinterval is where the arc still
-- lives. Injectivity is needed only where the subarc runs — a loop has it
-- everywhere but its finish, which is what the two arcs of a Jordan curve
-- are cut from.
theorem Plane.IsArc.subarc_on_subsegment (parametrisation : ℝ → Plane.Point)
        (continuous : MetricSpace.ContinuousOn(parametrisation, Real.unitInterval))
        (a b : ℝ)
        (aInside : a ∈ Real.unitInterval)
        (bInside : b ∈ Real.unitInterval)
        (distinct : a ≠ b)
        (injective : MetricSpace.InjectiveOn(parametrisation, Real.segment(a, b)))
        : Plane.IsArc(Plane.subarc(parametrisation, a, b)) := {
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  Real.segment(a, b) ⊆ Real.unitInterval
      by Real.IsConvex.segment_inside as subsegmentInside;
  ∀ (t : ℝ). t ∈ Real.unitInterval → Real.between(a, b, t) ∈ Real.segment(a, b)
      by (t : ℝ) (inside : t ∈ Real.unitInterval) ↦ {
        t ≥ 0 by Real.unitInterval_nonneg;
        t ≤ 1 by Real.unitInterval_atMostOne;
        done by Real.between_lands
      }
      as landsInSubsegment;
  ∀ (t : ℝ). t ∈ Real.unitInterval → Real.between(a, b, t) ∈ Real.unitInterval
      by (t : ℝ) (inside : t ∈ Real.unitInterval) ↦ {
        Real.between(a, b, t) ∈ Real.segment(a, b) by landsInSubsegment;
        done by subsegmentInside
      };

  MetricSpace.ContinuousOn(Real.between(a, b), Real.unitInterval)
      by Real.between_ContinuousOn;
  MetricSpace.ContinuousOn(
      Plane.subarc(parametrisation, a, b), Real.unitInterval)
      by MetricSpace.ContinuousOn.compose(
          inner := Real.between(a, b), outer := parametrisation,
          region := Real.unitInterval);

  MetricSpace.InjectiveOn(Real.between(a, b), Real.unitInterval)
      by Real.between_InjectiveOn as walkInjective;
  MetricSpace.InjectiveOn(
      Plane.subarc(parametrisation, a, b), Real.unitInterval)
      by (x : ℝ) (xInside : x ∈ Real.unitInterval)
         (y : ℝ) (yInside : y ∈ Real.unitInterval)
         (sameValue : Plane.subarc(parametrisation, a, b)(x)
                          = Plane.subarc(parametrisation, a, b)(y)) ↦ {
        Real.between(a, b, x) ∈ Real.segment(a, b) by landsInSubsegment;
        Real.between(a, b, y) ∈ Real.segment(a, b) by landsInSubsegment;
        parametrisation(Real.between(a, b, x))
            = parametrisation(Real.between(a, b, y)) by sameValue;
        Real.between(a, b, x) = Real.between(a, b, y) by injective;
        done by walkInjective
      };
  done
}

theorem Plane.IsArc.subarc (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        (a b : ℝ)
        (aInside : a ∈ Real.unitInterval)
        (bInside : b ∈ Real.unitInterval)
        (distinct : a ≠ b)
        : Plane.IsArc(Plane.subarc(parametrisation, a, b)) := {
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval);
  MetricSpace.InjectiveOn(parametrisation, Real.unitInterval) as injective;
  Real.IsConvex(Real.unitInterval) by Real.unitInterval_IsConvex;
  Real.segment(a, b) ⊆ Real.unitInterval
      by Real.IsConvex.segment_inside as subsegmentInside;
  MetricSpace.InjectiveOn(parametrisation, Real.segment(a, b))
      by (x : ℝ) (xOnSubsegment : x ∈ Real.segment(a, b))
         (y : ℝ) (yOnSubsegment : y ∈ Real.segment(a, b))
         (sameValue : parametrisation(x) = parametrisation(y)) ↦ {
        x ∈ Real.unitInterval by subsegmentInside;
        y ∈ Real.unitInterval by subsegmentInside;
        done by injective
      };
  done by Plane.IsArc.subarc_on_subsegment
}

-- The subarc's image is the arc restricted to the subinterval — which is
-- what "sub" means, and the form every consumer wants.
theorem Plane.subarc_image (parametrisation : ℝ → Plane.Point) (a b : ℝ)
        : Plane.arc(Plane.subarc(parametrisation, a, b))
              = MetricSpace.imageSet(parametrisation, Real.segment(a, b)) := {
  Plane.arc(Plane.subarc(parametrisation, a, b))
      ⊆ MetricSpace.imageSet(parametrisation, Real.segment(a, b))
      by (y : Plane.Point)
         (onSubarc : y ∈ Plane.arc(Plane.subarc(parametrisation, a, b))) ↦ {
        choose source : ℝ such that
            source ∈ Real.unitInterval
              ∧ Plane.subarc(parametrisation, a, b)(source) = y
            from onSubarc;
        source ∈ Real.unitInterval;
        parametrisation(Real.between(a, b, source)) = y;
        source ≥ 0 by Real.unitInterval_nonneg;
        source ≤ 1 by Real.unitInterval_atMostOne;
        Real.between(a, b, source) ∈ Real.segment(a, b) by Real.between_lands;
        done by { witness Real.between(a, b, source) }
      };
  MetricSpace.imageSet(parametrisation, Real.segment(a, b))
      ⊆ Plane.arc(Plane.subarc(parametrisation, a, b))
      by (y : Plane.Point)
         (onRestriction :
              y ∈ MetricSpace.imageSet(parametrisation, Real.segment(a, b))) ↦ {
        choose middle : ℝ such that
            middle ∈ Real.segment(a, b) ∧ parametrisation(middle) = y
            from onRestriction;
        middle ∈ Real.segment(a, b);
        parametrisation(middle) = y as valueAtMiddle;
        choose source such that
            (0 ≤ source ∧ source ≤ 1) ∧ middle = Real.between(a, b, source)
            from { middle ∈ Real.segment(a, b) };
        0 ≤ source;
        source ≤ 1;
        middle = Real.between(a, b, source) as walksToMiddle;
        source ∈ Real.unitInterval by Real.member_unitInterval;
        Plane.subarc(parametrisation, a, b)(source)
           = parametrisation(Real.between(a, b, source))
           = parametrisation(middle) by walksToMiddle
           = y by valueAtMiddle;
        done by { witness source }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The arc without its endpoints — the blueprint's `P°`.
--
-- Taken on the parameter side, as the image of the open unit interval,
-- because that is the form the subarc basis argument needs: an open subarc
-- is the image of an open subinterval. Injectivity then says it is also
-- the arc minus the two endpoint VALUES, which is how the blueprint reads
-- it.

definition Real.openUnitInterval : Set(ℝ) :=
  (t : ℝ) ↦ t ∈ Real.unitInterval ∧ t ≠ 0 ∧ t ≠ 1

definition Plane.openArc (parametrisation : ℝ → Plane.Point)
        : Set(Plane.Point) :=
  MetricSpace.imageSet(parametrisation, Real.openUnitInterval)

theorem Real.openUnitInterval_subset
        : Real.openUnitInterval ⊆ Real.unitInterval := {
  take t : ℝ;
  suppose t ∈ Real.openUnitInterval as inside;
  done
}

-- On an arc the two readings agree: dropping the endpoints of the
-- interval drops exactly the two endpoint values, since no other parameter
-- shares their images.
theorem Plane.IsArc.openArc_is_arc_without_endpoints
        (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        : Plane.openArc(parametrisation)
              = Plane.arc(parametrisation)
                    ∖ Set.singleton(
                          Plane.Point, Plane.arcStart(parametrisation))
                    ∖ Set.singleton(
                          Plane.Point, Plane.arcFinish(parametrisation)) := {
  MetricSpace.InjectiveOn(parametrisation, Real.unitInterval) as injective;
  (0 : ℝ) ∈ Real.unitInterval by Real.zero_in_unitInterval;
  (1 : ℝ) ∈ Real.unitInterval by Real.one_in_unitInterval;

  Plane.openArc(parametrisation)
      ⊆ Plane.arc(parametrisation)
            ∖ Set.singleton(Plane.Point, Plane.arcStart(parametrisation))
            ∖ Set.singleton(Plane.Point, Plane.arcFinish(parametrisation))
      by (y : Plane.Point) (onOpenArc : y ∈ Plane.openArc(parametrisation)) ↦ {
        choose source : ℝ such that
            source ∈ Real.openUnitInterval ∧ parametrisation(source) = y
            from onOpenArc;
        source ∈ Real.openUnitInterval;
        source ∈ Real.unitInterval by Real.openUnitInterval_subset;
        source ≠ 0;
        source ≠ 1;
        parametrisation(source) = y;
        y ∈ Plane.arc(parametrisation) by { witness source };
        suppose y = Plane.arcStart(parametrisation) for contradiction {
          parametrisation(source) = parametrisation(0);
          source = 0 by injective;
          done
        };
        suppose y = Plane.arcFinish(parametrisation) for contradiction {
          parametrisation(source) = parametrisation(1);
          source = 1 by injective;
          done
        };
        ¬(y ∈ Set.singleton(Plane.Point, Plane.arcStart(parametrisation)));
        ¬(y ∈ Set.singleton(Plane.Point, Plane.arcFinish(parametrisation)));
        done
      };

  Plane.arc(parametrisation)
        ∖ Set.singleton(Plane.Point, Plane.arcStart(parametrisation))
        ∖ Set.singleton(Plane.Point, Plane.arcFinish(parametrisation))
      ⊆ Plane.openArc(parametrisation)
      by (y : Plane.Point)
         (onTrimmedArc :
              y ∈ Plane.arc(parametrisation)
                    ∖ Set.singleton(
                          Plane.Point, Plane.arcStart(parametrisation))
                    ∖ Set.singleton(
                          Plane.Point, Plane.arcFinish(parametrisation))) ↦ {
        y ∈ Plane.arc(parametrisation)
              ∖ Set.singleton(Plane.Point, Plane.arcStart(parametrisation));
        y ∈ Plane.arc(parametrisation) as onArc;
        ¬(y ∈ Set.singleton(Plane.Point, Plane.arcStart(parametrisation)));
        ¬(y ∈ Set.singleton(Plane.Point, Plane.arcFinish(parametrisation)));
        choose source : ℝ such that
            source ∈ Real.unitInterval ∧ parametrisation(source) = y
            from onArc;
        source ∈ Real.unitInterval;
        parametrisation(source) = y as valueAtSource;
        suppose source = 0 as isStart for contradiction {
          y = parametrisation(0) by substituting valueAtSource;
          y = Plane.arcStart(parametrisation);
          y ∈ Set.singleton(Plane.Point, Plane.arcStart(parametrisation));
          done
        };
        suppose source = 1 as isFinish for contradiction {
          y = parametrisation(1) by substituting valueAtSource;
          y = Plane.arcFinish(parametrisation);
          y ∈ Set.singleton(Plane.Point, Plane.arcFinish(parametrisation));
          done
        };
        source ∈ Real.openUnitInterval;
        done by { witness source }
      };
  done by Set.equal_of_same_members
}

-- ----------------------------------------------------------------------
-- The subarc basis.
--
-- A parametrisation is an OPEN map onto its arc: this is where the
-- inverse's continuity earns its keep, since it is exactly what turns a
-- parameter-radius into a value-radius. With it, the images of the
-- relatively open subintervals are relatively open in the arc, and the
-- ball argument below puts one inside every neighbourhood — so they are a
-- basis of the arc's subspace topology.
--
-- Stated for relatively open SUBINTERVALS rather than for subarcs, because
-- at an endpoint the basic neighbourhood is half-open: `Plane.openArc` of
-- a subarc is the interior case, and this covers both.

theorem Plane.IsArc.image_OpenIn (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        (piece : Set(ℝ))
        (pieceInside : piece ⊆ Real.unitInterval)
        (pieceOpen : MetricSpace.OpenIn(piece, Real.unitInterval))
        : Plane.OpenIn(
              MetricSpace.imageSet(parametrisation, piece),
              Plane.arc(parametrisation)) := {
  MetricSpace.IsHomeomorphismOn(parametrisation, Real.unitInterval)
      by Plane.IsArc.IsHomeomorphismOn;
  MetricSpace.HasContinuousInverseOn(parametrisation, Real.unitInterval)
      as inverseContinuous;
  take value : Plane.Point;
  suppose value ∈ MetricSpace.imageSet(parametrisation, piece) as inImage;
  choose source : ℝ such that
      source ∈ piece ∧ parametrisation(source) = value from inImage;
  source ∈ piece;
  source ∈ Real.unitInterval by pieceInside;
  parametrisation(source) = value as valueAtSource;

  -- The piece gives a parameter-radius, and the inverse's continuity turns
  -- it into a value-radius.
  choose parameterRadius such that
      parameterRadius > 0 ∧
        ∀ (other : ℝ). other ∈ Real.unitInterval →
          distance(source, other) < parameterRadius → other ∈ piece
      from pieceOpen;
  parameterRadius > 0;
  ∀ (other : ℝ). other ∈ Real.unitInterval →
      distance(source, other) < parameterRadius → other ∈ piece
      as nearParametersInPiece;
  choose valueRadius such that
      valueRadius > 0 ∧
        ∀ (other : ℝ). other ∈ Real.unitInterval →
          distance(parametrisation(source), parametrisation(other))
              < valueRadius →
            distance(source, other) < parameterRadius
      from inverseContinuous;
  valueRadius > 0;
  ∀ (other : ℝ). other ∈ Real.unitInterval →
      distance(parametrisation(source), parametrisation(other))
          < valueRadius →
        distance(source, other) < parameterRadius
      as nearValuesComeFromNearParameters;

  witness valueRadius with {
    valueRadius > 0;
    ∀ (other : Plane.Point). other ∈ Plane.arc(parametrisation) →
        Plane.distance(value, other) < valueRadius →
          other ∈ MetricSpace.imageSet(parametrisation, piece)
        by (other : Plane.Point)
           (onArc : other ∈ Plane.arc(parametrisation))
           (near : Plane.distance(value, other) < valueRadius) ↦ {
          choose otherSource : ℝ such that
              otherSource ∈ Real.unitInterval
                ∧ parametrisation(otherSource) = other
              from onArc;
          otherSource ∈ Real.unitInterval;
          parametrisation(otherSource) = other as valueAtOtherSource;
          distance(
              parametrisation(source), parametrisation(otherSource))
             = Plane.distance(value, parametrisation(otherSource))
                   by substituting valueAtSource
             = Plane.distance(value, other)
                   by substituting valueAtOtherSource
             < valueRadius;
          distance(source, otherSource) < parameterRadius
              by nearValuesComeFromNearParameters;
          otherSource ∈ piece by nearParametersInPiece;
          done by { witness otherSource }
        };
    done
  }
}

-- Every neighbourhood of a point of the arc contains the image of a
-- relatively open subinterval around its parameter — so those images are a
-- basis. The piece is the unit interval cut by a ball, which is open in it
-- for the same reason a ball is open in the plane.
theorem Plane.IsArc.basic_piece_inside_ball (parametrisation : ℝ → Plane.Point)
        (isArc : Plane.IsArc(parametrisation))
        (value : Plane.Point)
        (onArc : value ∈ Plane.arc(parametrisation))
        (radius : ℝ) (radiusPositive : radius > 0)
        : ∃ (piece : Set(ℝ)).
            (piece ⊆ Real.unitInterval
                 ∧ MetricSpace.OpenIn(piece, Real.unitInterval))
              ∧ (value ∈ MetricSpace.imageSet(parametrisation, piece)
                     ∧ MetricSpace.imageSet(parametrisation, piece)
                           ⊆ Plane.Ball(value, radius)) := {
  MetricSpace.ContinuousOn(parametrisation, Real.unitInterval) as continuous;
  choose source : ℝ such that
      source ∈ Real.unitInterval ∧ parametrisation(source) = value
      from onArc;
  source ∈ Real.unitInterval;
  parametrisation(source) = value as valueAtSource;
  choose parameterRadius such that
      parameterRadius > 0 ∧
        ∀ (other : ℝ). other ∈ Real.unitInterval →
          distance(source, other) < parameterRadius →
            distance(parametrisation(source), parametrisation(other))
                < radius
      from continuous;
  parameterRadius > 0;
  ∀ (other : ℝ). other ∈ Real.unitInterval →
      distance(source, other) < parameterRadius →
        distance(parametrisation(source), parametrisation(other))
            < radius
      as nearParametersHaveNearValues;

  -- The piece is written out rather than bound with `let`: the citation
  -- below has to match it against `piece ∩ smaller`, and the binding hides
  -- that shape.
  MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval
      ⊆ Real.unitInterval by Set.intersection_subset_right;
  MetricSpace.IsOpen(MetricSpace.Ball(source, parameterRadius))
      by MetricSpace.Ball_IsOpen;
  Real.unitInterval ⊆ Set.universe(ℝ) by Set.subset_universe;
  MetricSpace.OpenIn(
      MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval,
      Real.unitInterval)
      by MetricSpace.OpenIn.restrict(carrier := Set.universe(ℝ));

  source ∈ MetricSpace.Ball(source, parameterRadius)
      by MetricSpace.center_Ball;
  source ∈ MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval;
  value ∈ MetricSpace.imageSet(
      parametrisation,
      MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval)
      by { witness source };

  MetricSpace.imageSet(
      parametrisation,
      MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval)
        ⊆ Plane.Ball(value, radius)
      by (other : Plane.Point)
         (inImage : other ∈ MetricSpace.imageSet(
              parametrisation,
              MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval)) ↦ {
        choose otherSource : ℝ such that
            otherSource ∈ MetricSpace.Ball(source, parameterRadius)
                            ∩ Real.unitInterval
              ∧ parametrisation(otherSource) = other
            from inImage;
        parametrisation(otherSource) = other as valueAtOtherSource;
        otherSource ∈ MetricSpace.Ball(source, parameterRadius);
        otherSource ∈ Real.unitInterval;
        distance(source, otherSource) < parameterRadius
            by MetricSpace.member_Ball;
        distance(parametrisation(source), parametrisation(otherSource))
            < radius by nearParametersHaveNearValues;
        Plane.distance(value, other)
           = distance(parametrisation(source), other)
                 by substituting valueAtSource
           = distance(
                 parametrisation(source), parametrisation(otherSource))
                 by substituting valueAtOtherSource
           < radius;
        done
      };
  done by {
    witness MetricSpace.Ball(source, parameterRadius) ∩ Real.unitInterval
  }
}

-- ----------------------------------------------------------------------
-- A plane segment, as an arc. The walk from `a` to `b` is already a map
-- on the parameter interval, so it needs no reparametrisation at all —
-- it IS the arc, once `a` and `b` are distinct.

theorem Plane.between_injective (a b : Plane.Point) (distinct : a ≠ b) (s t : ℝ)
        (sameWalk : Plane.between(a, b, s) = Plane.between(a, b, t))
        : s = t := {
  suppose Plane.distance(a, b) = 0 for contradiction {
    a = b by Plane.equal_of_distance_zero;
    done
  };
  Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t))
      = Plane.distance(Plane.between(a, b, s), Plane.between(a, b, s))
      by substituting sameWalk;
  Plane.distance(Plane.between(a, b, s), Plane.between(a, b, s)) = 0
      by Plane.distance_self;
  abs(t - s) * Plane.distance(a, b)
     = Plane.distance(Plane.between(a, b, s), Plane.between(a, b, t))
           by Plane.between_distance
     = 0;

  -- A product is zero only if a factor is, and the distance is not.
  abs(t - s) = 0 by {
    suppose abs(t - s) ≠ 0 as gapNonzero for contradiction {
      abs(t - s) * Plane.distance(a, b) ≠ 0 by Real.multiply_nonzero;
      done
    };
    done
  };
  -- A quantity trapped between its absolute value and minus it, with that
  -- absolute value zero, is zero.
  t - s
     ≤ abs(t - s) by Real.LessOrEqual_absolute_value
     = 0;
  -(t - s)
     ≤ abs(t - s) by Real.negate_LessOrEqual_absolute_value
     = 0;
  0 ≤ t - s by ordered_field;
  t - s = 0 by Real.LessOrEqual.antisymmetric as gapVanishes;
  s = t by linear_combination(-1 * gapVanishes);
  done
}

theorem Plane.between_ContinuousOn (a b : Plane.Point)
        : MetricSpace.ContinuousOn(Plane.between(a, b), Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval;
  take tolerance : ℝ;
  suppose tolerance > 0 as tolerancePositive;
  Plane.parameterGap(tolerance, a, b) > 0 by Plane.parameterGap_positive;
  witness Plane.parameterGap(tolerance, a, b) with {
    Plane.parameterGap(tolerance, a, b) > 0;
    ∀ (y : ℝ). y ∈ Real.unitInterval →
        distance(x, y) < Plane.parameterGap(tolerance, a, b) →
          distance(Plane.between(a, b, x), Plane.between(a, b, y))
              < tolerance
        by (y : ℝ) (inside : y ∈ Real.unitInterval)
           (near : distance(x, y)
                       < Plane.parameterGap(tolerance, a, b)) ↦ {
          abs(y - x)
             = abs(x - y) by Real.absolute_value_subtract_swap
             = distance(x, y)
             < Plane.parameterGap(tolerance, a, b);
          done by Plane.between_close_of_gap
        };
    done
  }
}

theorem Plane.between_InjectiveOn (a b : Plane.Point) (distinct : a ≠ b)
        : MetricSpace.InjectiveOn(Plane.between(a, b), Real.unitInterval) := {
  take x : ℝ;
  suppose x ∈ Real.unitInterval as xInside;
  take y : ℝ;
  suppose y ∈ Real.unitInterval as yInside;
  suppose Plane.between(a, b, x) = Plane.between(a, b, y) as sameWalk;
  done by Plane.between_injective
}

theorem Plane.IsArc.between (a b : Plane.Point) (distinct : a ≠ b)
        : Plane.IsArc(Plane.between(a, b)) := {
  MetricSpace.ContinuousOn(Plane.between(a, b), Real.unitInterval)
      by Plane.between_ContinuousOn;
  MetricSpace.InjectiveOn(Plane.between(a, b), Real.unitInterval)
      by Plane.between_InjectiveOn;
  done
}

theorem Plane.between_arcStart (a b : Plane.Point)
        : Plane.arcStart(Plane.between(a, b)) = a :=
  done by Plane.between_zero

theorem Plane.between_arcFinish (a b : Plane.Point)
        : Plane.arcFinish(Plane.between(a, b)) = b :=
  done by Plane.between_one

theorem Plane.arc_between (a b : Plane.Point)
        : Plane.arc(Plane.between(a, b)) = Plane.segment(a, b) := {
  Plane.arc(Plane.between(a, b)) ⊆ Plane.segment(a, b)
      by (y : Plane.Point) (onArc : y ∈ Plane.arc(Plane.between(a, b))) ↦ {
        choose source : ℝ such that
            source ∈ Real.unitInterval ∧ Plane.between(a, b, source) = y
            from onArc;
        source ≥ 0 by Real.unitInterval_nonneg;
        source ≤ 1 by Real.unitInterval_atMostOne;
        Plane.between(a, b, source) = y as valueAtSource;
        Plane.between(a, b, source) ∈ Plane.segment(a, b) by { witness source };
        done by substituting valueAtSource
      };
  Plane.segment(a, b) ⊆ Plane.arc(Plane.between(a, b))
      by (y : Plane.Point) (onSegment : y ∈ Plane.segment(a, b)) ↦ {
        choose source such that
            (0 ≤ source ∧ source ≤ 1) ∧ y = Plane.between(a, b, source)
            from onSegment;
        0 ≤ source;
        source ≤ 1;
        y = Plane.between(a, b, source);
        source ∈ Real.unitInterval by Real.member_unitInterval;
        Plane.between(a, b, source) = y;
        done by { witness source }
      };
  done by Set.equal_of_same_members
}
