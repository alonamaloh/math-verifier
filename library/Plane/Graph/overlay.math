-- Plane/Graph/overlay.math
--
-- The polygonal overlay (`lem:polygonal-overlay` of PLAN_JORDAN_SCHOENFLIES.md):
-- finitely many segments become a polygonal plane graph once they are
-- subdivided at their meets and each duplicated subsegment is named once.
--
-- What has to be proved is the DISJOINTNESS the drawing condition asks for,
-- and the shape of that argument is the file's whole content:
--
--   * SEPARATION. Cut at every end of every source piece and at both ends of
--     every meet, and two pieces of the subdivision that share an interior
--     point are the same segment — equal, not disjoint. Overlapping collinear
--     pieces cannot be pulled apart by cutting; after enough cuts they
--     coincide, which is what the blueprint's deduplication clause is for.
--
--   * The argument is ONE-DIMENSIONAL, and `Plane/segment_order.math` is what
--     makes it so. Two pieces sharing an interior point lie in a common
--     segment: if they came from the same source piece, that piece; if from
--     different ones, the sources overlap in a nondegenerate segment (the
--     shared point is interior to the overlap, because the overlap's ends are
--     cut points and so lie in no interior) and both pieces lie inside that
--     overlap. Along that one segment, the pieces' ends are cut points too,
--     so neither piece has an end inside the other — and two intervals whose
--     interiors meet while neither's ends are inside the other are the same
--     interval.
--
-- Nothing here produces the cut points: they are a hypothesis, stated as what
-- a construction can actually supply — for each pair of source pieces that
-- meet, SOME pair of ends of the meet is cut. `Plane.segment_meet` says the
-- meet is a segment, so such a pair exists; the construction below picks one
-- per pair, and no choice operator is needed because the point list is built
-- existentially.

module Plane.Graph.overlay

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Lists.list
import Lists.append
import Lists.map
import Lists.deduplicate
import Lists.set_union
import Real.interface
import Real.order
import Plane.point
import Plane.norm
import Plane.segment
import Plane.segment_order
import Plane.segment_meet
import Graph.basics
import Plane.Graph.basics
import Plane.Graph.pointset
import Plane.Graph.segments
import Plane.Graph.subdivide
import Plane.Graph.orient

-- ----------------------------------------------------------------------
-- What the cut points have to cover.
--
-- Two conditions, and between them they are the blueprint's "subdivide at all
-- old endpoints, isolated intersections, and endpoints of overlapping
-- intervals". The second asks for SOME pair of ends of each meet rather than
-- every pair, because that is what a construction can supply: a meet is
-- `segment(u, v)` and `segment(v, u)` alike, and knowing that a nondegenerate
-- segment's ends are determined by its point set is a theorem this
-- development does not have and does not need.

definition Plane.meetOf (piece source : Plane.Segment) : Set(Plane.Point) :=
  Plane.segment(Product.first(piece), Product.second(piece))
      ∩ Plane.segment(Product.first(source), Product.second(source))

theorem Plane.meetOf_symmetric (piece source : Plane.Segment)
        : Plane.meetOf(piece, source) = Plane.meetOf(source, piece) :=
  done by Set.intersection_commutative

definition Plane.EndsAreCut (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) : Proposition :=
  ∀ (piece : Plane.Segment). piece ∈ pieces →
      ∀ (point : Plane.Point). Plane.IsEndOf(point, piece) → point ∈ points

definition Plane.MeetsAreCut (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) : Proposition :=
  ∀ (piece source : Plane.Segment). piece ∈ pieces → source ∈ pieces →
      piece ≠ source → Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source)) →
      ∃ (u v : Plane.Point). Plane.meetOf(piece, source) = Plane.segment(u, v)
          ∧ u ∈ points ∧ v ∈ points

-- ----------------------------------------------------------------------
-- Collinearity: two pieces that share an interior point lie in one segment.

theorem Plane.subdivide_common_segment (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (meetsCut : Plane.MeetsAreCut(pieces, points))
        (part other : Plane.Segment)
        (isPart : part ∈ Plane.subdivide(pieces, points))
        (isOther : other ∈ Plane.subdivide(pieces, points))
        (x : Plane.Point)
        (onPart : x ∈ Plane.openSegment(Product.first(part), Product.second(part)))
        (onOther : x ∈ Plane.openSegment(Product.first(other), Product.second(other)))
        : ∃ (ambient : Plane.Segment).
              Product.first(ambient) ≠ Product.second(ambient)
              ∧ Plane.segment(Product.first(part), Product.second(part))
                  ⊆ Plane.segment(Product.first(ambient), Product.second(ambient))
              ∧ Plane.segment(Product.first(other), Product.second(other))
                  ⊆ Plane.segment(Product.first(ambient), Product.second(ambient)) := {
  choose sourcePart such that sourcePart ∈ pieces
      ∧ Plane.segment(Product.first(part), Product.second(part))
          ⊆ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
      ∧ Plane.openSegment(Product.first(part), Product.second(part))
          ⊆ Plane.openSegment(Product.first(sourcePart), Product.second(sourcePart))
      from Plane.subdivide_inside;
  sourcePart ∈ pieces;
  Plane.segment(Product.first(part), Product.second(part))
      ⊆ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
      as partInsideSource;
  Plane.openSegment(Product.first(part), Product.second(part))
      ⊆ Plane.openSegment(Product.first(sourcePart), Product.second(sourcePart));
  Product.first(sourcePart) ≠ Product.second(sourcePart) by allDistinct;

  choose sourceOther such that sourceOther ∈ pieces
      ∧ Plane.segment(Product.first(other), Product.second(other))
          ⊆ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
      ∧ Plane.openSegment(Product.first(other), Product.second(other))
          ⊆ Plane.openSegment(Product.first(sourceOther), Product.second(sourceOther))
      from Plane.subdivide_inside;
  sourceOther ∈ pieces;
  Plane.segment(Product.first(other), Product.second(other))
      ⊆ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
      as otherInsideSource;
  Plane.openSegment(Product.first(other), Product.second(other))
      ⊆ Plane.openSegment(Product.first(sourceOther), Product.second(sourceOther));
  Product.first(sourceOther) ≠ Product.second(sourceOther) by allDistinct;

  done by cases {
    case sourcePart = sourceOther as sourcesAgree: {
        Plane.segment(Product.first(other), Product.second(other))
            ⊆ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
            by substituting sourcesAgree;
        witness sourcePart
      }
    otherwise as sourcesDiffer: {
        -- The sources meet at `x`, so their meet is a segment with both ends
        -- cut — and `x` is interior to it, since a cut point is interior to
        -- no piece of the subdivision.
        x ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart));
        x ∈ Plane.segment(Product.first(sourceOther), Product.second(sourceOther));
        x ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther));
        Set.IsNonempty(Plane.Point,
            Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther)))
            by { witness x };
        choose meetNear, meetFar such that
            Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                    ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
                = Plane.segment(meetNear, meetFar)
            ∧ meetNear ∈ points ∧ meetFar ∈ points
            from meetsCut;
        Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            = Plane.segment(meetNear, meetFar) as meetIsSegment;
        meetNear ∈ points;
        meetFar ∈ points;

        meetNear ∉ Plane.openSegment(Product.first(part), Product.second(part))
            by Plane.subdivide_avoids;
        meetFar ∉ Plane.openSegment(Product.first(part), Product.second(part))
            by Plane.subdivide_avoids;
        meetNear ∉ Plane.openSegment(Product.first(other), Product.second(other))
            by Plane.subdivide_avoids;
        meetFar ∉ Plane.openSegment(Product.first(other), Product.second(other))
            by Plane.subdivide_avoids;

        x ∈ Plane.segment(meetNear, meetFar) by substituting meetIsSegment;
        x ≠ meetNear
            by { suppose x = meetNear as sharedIsNear;
                 meetNear ∈ Plane.openSegment(Product.first(part), Product.second(part))
                     by substituting sharedIsNear;
                 done };
        x ≠ meetFar
            by { suppose x = meetFar as sharedIsFar;
                 meetFar ∈ Plane.openSegment(Product.first(part), Product.second(part))
                     by substituting sharedIsFar;
                 done };
        x ∈ Plane.openSegment(meetNear, meetFar) by Plane.member_openSegment;
        meetNear ≠ meetFar
            by { suppose meetNear = meetFar as meetIsDegenerate;
                 Plane.segment(meetNear, meetFar) = Plane.segment(meetFar, meetFar)
                     by substituting meetIsDegenerate;
                 Plane.segment(meetFar, meetFar) = Set.singleton(Plane.Point, meetFar)
                     by Plane.segment_degenerate;
                 x ∈ Set.singleton(Plane.Point, meetFar);
                 x = meetFar;
                 done };

        -- Both ends of the meet lie on both sources.
        Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            ⊆ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
            by Set.intersection_subset_left;
        Plane.segment(meetNear, meetFar)
            ⊆ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
            by substituting meetIsSegment;
        Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
                ∩ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            ⊆ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            by Set.intersection_subset_right;
        Plane.segment(meetNear, meetFar)
            ⊆ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            by substituting meetIsSegment;
        meetNear ∈ Plane.segment(meetNear, meetFar) by Plane.left_in_segment;
        meetFar ∈ Plane.segment(meetNear, meetFar) by Plane.right_in_segment;
        meetNear ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart));
        meetFar ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart));
        meetNear ∈ Plane.segment(Product.first(sourceOther), Product.second(sourceOther));
        meetFar ∈ Plane.segment(Product.first(sourceOther), Product.second(sourceOther));

        -- And each piece's ends lie on its own source, which is the ambient
        -- segment the one-dimensional lemma runs along.
        Product.first(part) ∈ Plane.segment(Product.first(part), Product.second(part))
            by Plane.left_in_segment;
        Product.second(part) ∈ Plane.segment(Product.first(part), Product.second(part))
            by Plane.right_in_segment;
        Product.first(part)
            ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
            by partInsideSource;
        Product.second(part)
            ∈ Plane.segment(Product.first(sourcePart), Product.second(sourcePart))
            by partInsideSource;
        Product.first(other) ∈ Plane.segment(Product.first(other), Product.second(other))
            by Plane.left_in_segment;
        Product.second(other) ∈ Plane.segment(Product.first(other), Product.second(other))
            by Plane.right_in_segment;
        Product.first(other)
            ∈ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            by otherInsideSource;
        Product.second(other)
            ∈ Plane.segment(Product.first(sourceOther), Product.second(sourceOther))
            by otherInsideSource;

        Plane.segment(Product.first(part), Product.second(part))
            ⊆ Plane.segment(meetNear, meetFar)
            by Plane.segment_inside_of_ends_outside(
                   a := Product.first(sourcePart),
                   b := Product.second(sourcePart),
                   pieceLeft := Product.first(part),
                   pieceRight := Product.second(part),
                   overlapLeft := meetNear,
                   overlapRight := meetFar,
                   x := x);
        Plane.segment(Product.first(other), Product.second(other))
            ⊆ Plane.segment(meetNear, meetFar)
            by Plane.segment_inside_of_ends_outside(
                   a := Product.first(sourceOther),
                   b := Product.second(sourceOther),
                   pieceLeft := Product.first(other),
                   pieceRight := Product.second(other),
                   overlapLeft := meetNear,
                   overlapRight := meetFar,
                   x := x);
        witness Product.make(meetNear, meetFar)
      }
  }
}

-- ----------------------------------------------------------------------
-- Separation: pieces that share an interior point are the same segment.

theorem Plane.subdivide_separated (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (endsCut : Plane.EndsAreCut(pieces, points))
        (meetsCut : Plane.MeetsAreCut(pieces, points))
        (part other : Plane.Segment)
        (isPart : part ∈ Plane.subdivide(pieces, points))
        (isOther : other ∈ Plane.subdivide(pieces, points))
        (x : Plane.Point)
        (onPart : x ∈ Plane.openSegment(Product.first(part), Product.second(part)))
        (onOther : x ∈ Plane.openSegment(Product.first(other), Product.second(other)))
        : Plane.SameSegment(part, other) := {
  -- Every end of every piece is a cut point, hence interior to nothing.
  Plane.IsEndOf(Product.first(part), part);
  Plane.IsEndOf(Product.second(part), part);
  Plane.IsEndOf(Product.first(other), other);
  Plane.IsEndOf(Product.second(other), other);
  Product.first(part) ∈ points by Plane.subdivide_ends_are_cuts;
  Product.second(part) ∈ points by Plane.subdivide_ends_are_cuts;
  Product.first(other) ∈ points by Plane.subdivide_ends_are_cuts;
  Product.second(other) ∈ points by Plane.subdivide_ends_are_cuts;
  Product.first(part) ∉ Plane.openSegment(Product.first(other), Product.second(other))
      by Plane.subdivide_avoids;
  Product.second(part) ∉ Plane.openSegment(Product.first(other), Product.second(other))
      by Plane.subdivide_avoids;
  Product.first(other) ∉ Plane.openSegment(Product.first(part), Product.second(part))
      by Plane.subdivide_avoids;
  Product.second(other) ∉ Plane.openSegment(Product.first(part), Product.second(part))
      by Plane.subdivide_avoids;

  -- One segment holds both pieces.
  choose ambient such that Product.first(ambient) ≠ Product.second(ambient)
      ∧ Plane.segment(Product.first(part), Product.second(part))
          ⊆ Plane.segment(Product.first(ambient), Product.second(ambient))
      ∧ Plane.segment(Product.first(other), Product.second(other))
          ⊆ Plane.segment(Product.first(ambient), Product.second(ambient))
      from Plane.subdivide_common_segment;
  Product.first(ambient) ≠ Product.second(ambient);
  Plane.segment(Product.first(part), Product.second(part))
      ⊆ Plane.segment(Product.first(ambient), Product.second(ambient)) as partInAmbient;
  Plane.segment(Product.first(other), Product.second(other))
      ⊆ Plane.segment(Product.first(ambient), Product.second(ambient)) as otherInAmbient;
  Product.first(part) ∈ Plane.segment(Product.first(part), Product.second(part))
      by Plane.left_in_segment;
  Product.second(part) ∈ Plane.segment(Product.first(part), Product.second(part))
      by Plane.right_in_segment;
  Product.first(other) ∈ Plane.segment(Product.first(other), Product.second(other))
      by Plane.left_in_segment;
  Product.second(other) ∈ Plane.segment(Product.first(other), Product.second(other))
      by Plane.right_in_segment;
  Product.first(part) ∈ Plane.segment(Product.first(ambient), Product.second(ambient))
      by partInAmbient;
  Product.second(part) ∈ Plane.segment(Product.first(ambient), Product.second(ambient))
      by partInAmbient;
  Product.first(other) ∈ Plane.segment(Product.first(ambient), Product.second(ambient))
      by otherInAmbient;
  Product.second(other) ∈ Plane.segment(Product.first(ambient), Product.second(ambient))
      by otherInAmbient;

  -- Along it, neither piece has an end inside the other, so they agree.
  (Product.first(part) = Product.first(other)
       ∧ Product.second(part) = Product.second(other))
  ∨ (Product.first(part) = Product.second(other)
       ∧ Product.second(part) = Product.first(other))
      by Plane.same_ends_of_meeting_interiors(
             a := Product.first(ambient),
             b := Product.second(ambient),
             firstLeft := Product.first(part),
             firstRight := Product.second(part),
             secondLeft := Product.first(other),
             secondRight := Product.second(other),
             x := x);
  done by cases {
    case Product.first(part) = Product.first(other)
             ∧ Product.second(part) = Product.second(other): {
        part = Product.make(Product.first(part), Product.second(part)) by Product.eta
             = Product.make(Product.first(other), Product.second(part))
                   by substituting (Product.first(part) = Product.first(other))
             = Product.make(Product.first(other), Product.second(other))
                   by substituting (Product.second(part) = Product.second(other))
             = other by Product.eta;
        done by Or.introduceLeft
      }
    case Product.first(part) = Product.second(other)
             ∧ Product.second(part) = Product.first(other): {
        part = Product.make(Product.first(part), Product.second(part)) by Product.eta
             = Product.make(Product.second(other), Product.second(part))
                   by substituting (Product.first(part) = Product.second(other))
             = Product.make(Product.second(other), Product.first(other))
                   by substituting (Product.second(part) = Product.first(other))
             = Plane.reverseSegment(other);
        done by Or.introduceRight
      }
  }
}

-- ----------------------------------------------------------------------
-- Producing the cut points.
--
-- Nothing computes them. The overlay is stated existentially, so the list is
-- built by the induction that proves it exists, and `Plane.segment_meet`
-- hands over the ends of a meet the moment the meet is known to be nonempty.
-- That is what keeps `Logic.the` out of this: `segment_meet`'s witnesses are
-- not unique, so there is nothing for a definite description to name.

-- One piece against a list: a point list holding both ends of every meet.
theorem Plane.exists_meet_points (piece : Plane.Segment)
        (others : List(Plane.Segment))
        : ∃ (points : List(Plane.Point)).
              ∀ (source : Plane.Segment). source ∈ others →
                  Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source)) →
                  ∃ (u v : Plane.Point). Plane.meetOf(piece, source) = Plane.segment(u, v)
                      ∧ u ∈ points ∧ v ∈ points :=
  by induction on others with IH {
    case others = List.empty:
        witness List.empty(Plane.Point) with {
          take source : Plane.Segment;
          suppose source ∈ List.empty(Plane.Segment);
          done by List.no_member_empty
        }
    case others = List.prepend(head, tail) for some head, tail: {
        choose tailPoints such that
            ∀ (source : Plane.Segment). source ∈ tail →
                Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source)) →
                ∃ (u v : Plane.Point). Plane.meetOf(piece, source) = Plane.segment(u, v)
                    ∧ u ∈ tailPoints ∧ v ∈ tailPoints
            as tailMeetsCut from IH;
        done by cases {
          case Set.IsNonempty(Plane.Point, Plane.meetOf(piece, head)) as headMeets: {
              choose meetNear, meetFar such that
                  Plane.meetOf(piece, head) = Plane.segment(meetNear, meetFar)
                  from Plane.segment_meet;
              let grown : List(Plane.Point) := List.prepend(Plane.Point, meetNear,
                               List.prepend(Plane.Point, meetFar, tailPoints));
              witness grown with {
                take source : Plane.Segment;
                suppose source ∈ List.prepend(Plane.Segment, head, tail);
                suppose Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source));
                source = head ∨ source ∈ tail by List.member_prepend_invert;
                done by cases {
                  case source = head: {
                      meetNear ∈ grown;
                      meetFar ∈ List.prepend(Plane.Point, meetFar, tailPoints);
                      meetFar ∈ grown;
                      witness meetNear with witness meetFar
                    }
                  case source ∈ tail: {
                      choose u, v such that
                          Plane.meetOf(piece, source) = Plane.segment(u, v)
                          ∧ u ∈ tailPoints ∧ v ∈ tailPoints
                          from tailMeetsCut;
                      u ∈ tailPoints;
                      v ∈ tailPoints;
                      u ∈ List.prepend(Plane.Point, meetFar, tailPoints);
                      v ∈ List.prepend(Plane.Point, meetFar, tailPoints);
                      u ∈ grown;
                      v ∈ grown;
                      witness u with witness v
                    }
                }
              }
            }
          otherwise as headMisses: {
              witness tailPoints with {
                take source : Plane.Segment;
                suppose source ∈ List.prepend(Plane.Segment, head, tail);
                suppose Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source));
                source = head ∨ source ∈ tail by List.member_prepend_invert;
                done by cases {
                  case source = head as sourceIsHead: {
                      Set.IsNonempty(Plane.Point, Plane.meetOf(piece, head))
                          by substituting sourceIsHead;
                      done
                    }
                  case source ∈ tail:
                      done by tailMeetsCut
                }
              }
            }
        }
      }
  }

-- And the whole list: the ends of each piece, and both ends of each meet.
theorem Plane.exists_cut_points (pieces : List(Plane.Segment))
        : ∃ (points : List(Plane.Point)).
              Plane.EndsAreCut(pieces, points) ∧ Plane.MeetsAreCut(pieces, points) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        witness List.empty(Plane.Point) with {
          Plane.EndsAreCut(List.empty(Plane.Segment), List.empty(Plane.Point))
              by { take piece : Plane.Segment;
                   suppose piece ∈ List.empty(Plane.Segment);
                   done by List.no_member_empty };
          Plane.MeetsAreCut(List.empty(Plane.Segment), List.empty(Plane.Point))
              by { take piece : Plane.Segment;
                   take source : Plane.Segment;
                   suppose piece ∈ List.empty(Plane.Segment);
                   done by List.no_member_empty };
          done
        }
    case pieces = List.prepend(head, tail) for some head, tail: {
        choose tailPoints such that Plane.EndsAreCut(tail, tailPoints)
            ∧ Plane.MeetsAreCut(tail, tailPoints) from IH;
        Plane.EndsAreCut(tail, tailPoints) as tailEndsCut;
        Plane.MeetsAreCut(tail, tailPoints) as tailMeetsCut;
        choose meetPoints such that
            ∀ (source : Plane.Segment). source ∈ tail →
                Set.IsNonempty(Plane.Point, Plane.meetOf(head, source)) →
                ∃ (u v : Plane.Point). Plane.meetOf(head, source) = Plane.segment(u, v)
                    ∧ u ∈ meetPoints ∧ v ∈ meetPoints
            as headMeetsCut from Plane.exists_meet_points;
        let grown : List(Plane.Point) :=
            List.prepend(Plane.Point, Product.first(head),
                List.prepend(Plane.Point, Product.second(head),
                    List.append(meetPoints, tailPoints)));

        -- The head's two ends open the list; the tail's ends are already in
        -- `tailPoints`.
        Plane.EndsAreCut(List.prepend(Plane.Segment, head, tail), grown)
            by { take piece : Plane.Segment;
                 suppose piece ∈ List.prepend(Plane.Segment, head, tail);
                 take point : Plane.Point;
                 suppose Plane.IsEndOf(point, piece);
                 piece = head ∨ piece ∈ tail by List.member_prepend_invert;
                 done by cases {
                   case piece = head as pieceIsHead: {
                       Plane.IsEndOf(point, head) by substituting pieceIsHead;
                       point = Product.first(head) ∨ point = Product.second(head);
                       done by cases {
                         case point = Product.first(head) as atFirstEnd:
                             done by substituting atFirstEnd
                         case point = Product.second(head) as atSecondEnd: {
                             Product.second(head)
                                 ∈ List.prepend(Plane.Point, Product.second(head),
                                       List.append(meetPoints, tailPoints));
                             Product.second(head) ∈ grown;
                             done by substituting atSecondEnd
                           }
                       }
                     }
                   case piece ∈ tail: {
                       point ∈ tailPoints by tailEndsCut;
                       point ∈ List.append(meetPoints, tailPoints)
                           by List.member_append_right;
                       point ∈ List.prepend(Plane.Point, Product.second(head),
                                   List.append(meetPoints, tailPoints));
                       done
                     }
                 } };

        -- A pair involving the head is covered by `meetPoints`, in whichever
        -- order it is asked for — a meet does not care which piece is named
        -- first. A pair inside the tail was covered already.
        Plane.MeetsAreCut(List.prepend(Plane.Segment, head, tail), grown)
            by { take piece : Plane.Segment;
                 take source : Plane.Segment;
                 suppose piece ∈ List.prepend(Plane.Segment, head, tail);
                 suppose source ∈ List.prepend(Plane.Segment, head, tail);
                 suppose piece ≠ source;
                 suppose Set.IsNonempty(Plane.Point, Plane.meetOf(piece, source));
                 piece = head ∨ piece ∈ tail by List.member_prepend_invert;
                 source = head ∨ source ∈ tail by List.member_prepend_invert;
                 done by cases {
                   case piece = head as pieceIsHead:
                       done by cases {
                         case source = head as sourceIsHead: {
                             piece = source;
                             done
                           }
                         case source ∈ tail: {
                             Set.IsNonempty(Plane.Point, Plane.meetOf(head, source))
                                 by substituting pieceIsHead;
                             choose u, v such that
                                 Plane.meetOf(head, source) = Plane.segment(u, v)
                                 ∧ u ∈ meetPoints ∧ v ∈ meetPoints from headMeetsCut;
                             u ∈ meetPoints;
                             v ∈ meetPoints;
                             u ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_left;
                             v ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_left;
                             u ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             v ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             u ∈ grown;
                             v ∈ grown;
                             witness u with witness v
                           }
                       }
                   case piece ∈ tail:
                       done by cases {
                         case source = head as sourceIsHead: {
                             Set.IsNonempty(Plane.Point, Plane.meetOf(piece, head))
                                 by substituting sourceIsHead;
                             Plane.meetOf(head, piece) = Plane.meetOf(piece, head)
                                 by Plane.meetOf_symmetric as meetReversed;
                             Set.IsNonempty(Plane.Point, Plane.meetOf(head, piece))
                                 by substituting meetReversed;
                             choose u, v such that
                                 Plane.meetOf(head, piece) = Plane.segment(u, v)
                                 ∧ u ∈ meetPoints ∧ v ∈ meetPoints from headMeetsCut;
                             u ∈ meetPoints;
                             v ∈ meetPoints;
                             u ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_left;
                             v ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_left;
                             u ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             v ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             u ∈ grown;
                             v ∈ grown;
                             Plane.meetOf(piece, head) = Plane.segment(u, v)
                                 by substituting meetReversed;
                             done by { witness u with witness v }
                           }
                         case source ∈ tail: {
                             choose u, v such that
                                 Plane.meetOf(piece, source) = Plane.segment(u, v)
                                 ∧ u ∈ tailPoints ∧ v ∈ tailPoints from tailMeetsCut;
                             u ∈ tailPoints;
                             v ∈ tailPoints;
                             u ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_right;
                             v ∈ List.append(meetPoints, tailPoints)
                                 by List.member_append_right;
                             u ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             v ∈ List.prepend(Plane.Point, Product.second(head),
                                     List.append(meetPoints, tailPoints));
                             u ∈ grown;
                             v ∈ grown;
                             witness u with witness v
                           }
                       }
                 } };
        witness grown
      }
  }

-- ----------------------------------------------------------------------
-- The graph.
--
-- Its edges are the pieces of the subdivision, oriented canonically and then
-- deduplicated — orienting is what makes two names for one segment into one
-- name, so the deduplication is the plain list one and carries no geometry.
-- Its vertices are the ends of those edges, deduplicated the same way.

definition Plane.endsList : List(Plane.Segment) → List(Plane.Point)
  | List.empty               => List.empty(Plane.Point)
  | List.prepend(head, tail) =>
      List.prepend(Plane.Point, Product.first(head),
          List.prepend(Plane.Point, Product.second(head), Plane.endsList(tail)))

theorem Plane.member_endsList (pieces : List(Plane.Segment)) (piece : Plane.Segment)
        (isPiece : piece ∈ pieces)
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, piece))
        : point ∈ Plane.endsList(pieces) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done by List.no_member_empty
    case pieces = List.prepend(head, tail) for some head, tail: {
        piece = head ∨ piece ∈ tail by List.member_prepend_invert;
        done by cases {
          case piece = head as pieceIsHead: {
              Plane.IsEndOf(point, head) by substituting pieceIsHead;
              point = Product.first(head) ∨ point = Product.second(head);
              done by cases {
                case point = Product.first(head) as atFirstEnd:
                    done by substituting atFirstEnd
                case point = Product.second(head) as atSecondEnd: {
                    Product.second(head)
                        ∈ List.prepend(Plane.Point, Product.second(head),
                              Plane.endsList(tail));
                    Product.second(head) ∈ Plane.endsList(List.prepend(Plane.Segment, head, tail));
                    done by substituting atSecondEnd
                  }
              }
            }
          case piece ∈ tail: {
              point ∈ Plane.endsList(tail) by IH;
              point ∈ List.prepend(Plane.Point, Product.second(head),
                          Plane.endsList(tail));
              done
            }
        }
      }
  }

theorem Plane.endsList_member_invert (pieces : List(Plane.Segment)) (point : Plane.Point)
        (isMember : point ∈ Plane.endsList(pieces))
        : ∃ (piece : Plane.Segment). piece ∈ pieces ∧ Plane.IsEndOf(point, piece) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done by List.no_member_empty
    case pieces = List.prepend(head, tail) for some head, tail: {
        point ∈ List.prepend(Plane.Point, Product.first(head),
                    List.prepend(Plane.Point, Product.second(head),
                        Plane.endsList(tail)));
        point = Product.first(head)
            ∨ point ∈ List.prepend(Plane.Point, Product.second(head),
                          Plane.endsList(tail))
            by List.member_prepend_invert;
        head ∈ List.prepend(Plane.Segment, head, tail);
        done by cases {
          case point = Product.first(head) as atFirstEnd: {
              Plane.IsEndOf(point, head) by Or.introduceLeft;
              witness head
            }
          case point ∈ List.prepend(Plane.Point, Product.second(head),
                   Plane.endsList(tail)): {
              point = Product.second(head) ∨ point ∈ Plane.endsList(tail)
                  by List.member_prepend_invert;
              done by cases {
                case point = Product.second(head) as atSecondEnd: {
                    Plane.IsEndOf(point, head) by Or.introduceRight;
                    witness head
                  }
                case point ∈ Plane.endsList(tail): {
                    choose piece such that piece ∈ tail ∧ Plane.IsEndOf(point, piece)
                        from IH;
                    piece ∈ tail;
                    piece ∈ List.prepend(Plane.Segment, head, tail);
                    Plane.IsEndOf(point, piece);
                    witness piece
                  }
              }
            }
        }
      }
  }

definition Plane.overlayPieces (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) : List(Plane.Segment) :=
  List.deduplicate(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))

theorem Plane.overlayPieces_member_invert (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) (edge : Plane.Segment)
        (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        : ∃ (part : Plane.Segment). part ∈ Plane.subdivide(pieces, points)
              ∧ Plane.orientSegment(part) = edge := {
  edge ∈ List.map(Plane.orientSegment, Plane.subdivide(pieces, points))
      by List.deduplicate_subset;
  done by List.map_member_invert
}

theorem Plane.overlayPieces_ends_distinct (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (edge : Plane.Segment) (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        : Product.first(edge) ≠ Product.second(edge) := {
  choose part such that part ∈ Plane.subdivide(pieces, points)
      ∧ Plane.orientSegment(part) = edge from Plane.overlayPieces_member_invert;
  part ∈ Plane.subdivide(pieces, points);
  Plane.orientSegment(part) = edge as isOriented;
  Product.first(part) ≠ Product.second(part) by Plane.subdivide_ends_distinct;
  Product.first(Plane.orientSegment(part)) ≠ Product.second(Plane.orientSegment(part))
      by Plane.orientSegment_ends_distinct;
  done by substituting isOriented
}

-- An end of an overlay piece is an end of the piece of the subdivision it came
-- from, hence a cut point.
theorem Plane.overlayPieces_end_is_cut (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) (endsCut : Plane.EndsAreCut(pieces, points))
        (edge : Plane.Segment) (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, edge))
        : point ∈ points := {
  choose part such that part ∈ Plane.subdivide(pieces, points)
      ∧ Plane.orientSegment(part) = edge from Plane.overlayPieces_member_invert;
  part ∈ Plane.subdivide(pieces, points);
  Plane.orientSegment(part) = edge as isOriented;
  Plane.IsEndOf(point, Plane.orientSegment(part)) by substituting isOriented;
  Plane.IsEndOf(point, part) by Plane.IsEndOf.of_orientSegment;
  done by Plane.subdivide_ends_are_cuts
}

-- And a cut point is interior to no overlay piece: orienting does not move the
-- interior, and a cut point is interior to no piece of the subdivision.
theorem Plane.overlayPieces_avoids_cuts (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (edge : Plane.Segment) (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        (point : Plane.Point) (isCut : point ∈ points)
        : point ∉ Plane.openSegment(Product.first(edge), Product.second(edge)) := {
  choose part such that part ∈ Plane.subdivide(pieces, points)
      ∧ Plane.orientSegment(part) = edge from Plane.overlayPieces_member_invert;
  part ∈ Plane.subdivide(pieces, points);
  Plane.orientSegment(part) = edge as isOriented;
  point ∉ Plane.openSegment(Product.first(part), Product.second(part))
      by Plane.subdivide_avoids;
  Plane.SameSegment(Plane.orientSegment(part), part) by Plane.SameSegment.orientSegment;
  Plane.openSegment(Product.first(Plane.orientSegment(part)),
                    Product.second(Plane.orientSegment(part)))
      = Plane.openSegment(Product.first(part), Product.second(part))
      by Plane.SameSegment.openSegment as sameInterior;
  point ∉ Plane.openSegment(Product.first(Plane.orientSegment(part)),
                            Product.second(Plane.orientSegment(part)))
      by substituting sameInterior;
  done by substituting isOriented
}

-- Distinct overlay pieces have disjoint interiors. This is where separation is
-- spent: pieces sharing an interior point are the same segment, so after
-- orienting they are the same NAME, and the deduplicated list holds it once.
theorem Plane.overlayPieces_disjoint_interiors (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (endsCut : Plane.EndsAreCut(pieces, points))
        (meetsCut : Plane.MeetsAreCut(pieces, points))
        (edge other : Plane.Segment)
        (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        (isOther : other ∈ Plane.overlayPieces(pieces, points))
        (different : edge ≠ other)
        (x : Plane.Point)
        (onEdge : x ∈ Plane.openSegment(Product.first(edge), Product.second(edge)))
        : x ∉ Plane.openSegment(Product.first(other), Product.second(other)) := {
  choose part such that part ∈ Plane.subdivide(pieces, points)
      ∧ Plane.orientSegment(part) = edge from Plane.overlayPieces_member_invert;
  part ∈ Plane.subdivide(pieces, points);
  Plane.orientSegment(part) = edge as isOriented;
  Plane.SameSegment(Plane.orientSegment(part), part) by Plane.SameSegment.orientSegment;
  Plane.openSegment(Product.first(Plane.orientSegment(part)),
                    Product.second(Plane.orientSegment(part)))
      = Plane.openSegment(Product.first(part), Product.second(part))
      by Plane.SameSegment.openSegment as edgeInterior;
  x ∈ Plane.openSegment(Product.first(Plane.orientSegment(part)),
                        Product.second(Plane.orientSegment(part)))
      by substituting isOriented;
  x ∈ Plane.openSegment(Product.first(part), Product.second(part))
      by substituting edgeInterior;

  choose otherPart such that otherPart ∈ Plane.subdivide(pieces, points)
      ∧ Plane.orientSegment(otherPart) = other from Plane.overlayPieces_member_invert;
  otherPart ∈ Plane.subdivide(pieces, points);
  Plane.orientSegment(otherPart) = other as otherIsOriented;
  Plane.SameSegment(Plane.orientSegment(otherPart), otherPart)
      by Plane.SameSegment.orientSegment;
  Plane.openSegment(Product.first(Plane.orientSegment(otherPart)),
                    Product.second(Plane.orientSegment(otherPart)))
      = Plane.openSegment(Product.first(otherPart), Product.second(otherPart))
      by Plane.SameSegment.openSegment as otherInterior;

  suppose x ∈ Plane.openSegment(Product.first(other), Product.second(other));
  x ∈ Plane.openSegment(Product.first(Plane.orientSegment(otherPart)),
                        Product.second(Plane.orientSegment(otherPart)))
      by substituting otherIsOriented;
  x ∈ Plane.openSegment(Product.first(otherPart), Product.second(otherPart))
      by substituting otherInterior;
  Plane.SameSegment(part, otherPart) by Plane.subdivide_separated;
  Plane.orientSegment(part) = Plane.orientSegment(otherPart)
      by Plane.orientSegment_of_SameSegment;
  edge = Plane.orientSegment(part)
       = Plane.orientSegment(otherPart)
       = other by otherIsOriented;
  done
}

definition Plane.overlayGraph (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) : Plane.PolygonalGraph :=
  Graph.make(List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points))),
             Plane.overlayPieces(pieces, points))

theorem Plane.overlayGraph_edges (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        : Graph.edges(Plane.overlayGraph(pieces, points))
          = Plane.overlayPieces(pieces, points) :=
  done

theorem Plane.overlayGraph_vertices (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        : Graph.vertices(Plane.overlayGraph(pieces, points))
          = List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points))) :=
  done

theorem Plane.overlayGraph_end_is_vertex (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (edge : Plane.Segment) (isEdge : edge ∈ Plane.overlayPieces(pieces, points))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, edge))
        : point ∈ Graph.vertices(Plane.overlayGraph(pieces, points)) := {
  point ∈ Plane.endsList(Plane.overlayPieces(pieces, points))
      by Plane.member_endsList;
  Plane.endsList(Plane.overlayPieces(pieces, points))
      ⊆ List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points)))
      by List.subset_deduplicate;
  done
}

-- A vertex of the overlay is an end of one of its edges — the vertex list was
-- built out of nothing else.
theorem Plane.overlayGraph_vertex_is_end (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) (vertex : Plane.Point)
        (isVertex : vertex ∈ Graph.vertices(Plane.overlayGraph(pieces, points)))
        : ∃ (edge : Plane.Segment). edge ∈ Plane.overlayPieces(pieces, points)
              ∧ Plane.IsEndOf(vertex, edge) := {
  vertex ∈ List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points)));
  List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points)))
      ⊆ Plane.endsList(Plane.overlayPieces(pieces, points))
      by List.deduplicate_subset;
  vertex ∈ Plane.endsList(Plane.overlayPieces(pieces, points));
  done by Plane.endsList_member_invert
}

theorem Plane.overlayGraph_IsWellFormed (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        : Graph.IsWellFormed(Plane.overlayGraph(pieces, points)) := {
  Graph.vertices(Plane.overlayGraph(pieces, points))
      = List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points)))
      by Plane.overlayGraph_vertices as verticesAre;
  List.Distinct(Plane.Point,
      List.deduplicate(Plane.endsList(Plane.overlayPieces(pieces, points))))
      by List.deduplicate_distinct;
  List.Distinct(Plane.Point, Graph.vertices(Plane.overlayGraph(pieces, points)))
      by substituting verticesAre;
  Graph.edges(Plane.overlayGraph(pieces, points))
      = Plane.overlayPieces(pieces, points) by Plane.overlayGraph_edges as edgesAre;
  List.Distinct(Plane.Segment,
      List.deduplicate(List.map(Plane.orientSegment, Plane.subdivide(pieces, points))))
      by List.deduplicate_distinct;
  List.Distinct(Plane.Segment, Plane.overlayPieces(pieces, points));
  List.Distinct(Plane.Segment, Graph.edges(Plane.overlayGraph(pieces, points)))
      by substituting edgesAre;
  ∀ (edge : Plane.Segment). ∀ (u v : Plane.Point).
      edge ∈ Graph.edges(Plane.overlayGraph(pieces, points))
      → Graph.Joins(Plane.overlayGraph(pieces, points), edge, u, v)
      → u ∈ Graph.vertices(Plane.overlayGraph(pieces, points)) ∧ u ≠ v
      by { take edge : Plane.Segment;
           take u : Plane.Point;
           take v : Plane.Point;
           suppose edge ∈ Graph.edges(Plane.overlayGraph(pieces, points));
           suppose Graph.Joins(Plane.overlayGraph(pieces, points), edge, u, v);
           edge ∈ Plane.overlayPieces(pieces, points);
           Product.first(edge) ≠ Product.second(edge)
               by Plane.overlayPieces_ends_distinct;
           -- With `ends` the identity, the pair a reading names IS the edge.
           edge = Product.make(u, v) ∨ edge = Product.make(v, u);
           done by cases {
             case edge = Product.make(u, v) as forwardReading: {
                 Product.first(edge) = u by substituting forwardReading;
                 Product.second(edge) = v
                     by substituting forwardReading as secondIsV;
                 u ≠ v
                     by { suppose u = v as readingsCoincide;
                          Product.first(edge)
                             = u
                             = v by readingsCoincide
                             = Product.second(edge) by secondIsV;
                          done };
                 Plane.IsEndOf(u, edge) by Or.introduceLeft;
                 u ∈ Graph.vertices(Plane.overlayGraph(pieces, points))
                     by Plane.overlayGraph_end_is_vertex;
                 done
               }
             case edge = Product.make(v, u) as reverseReading: {
                 Product.first(edge) = v by substituting reverseReading;
                 Product.second(edge) = u by substituting reverseReading;
                 u ≠ v
                     by { suppose u = v as readingsCoincide;
                          Product.first(edge)
                             = v
                             = u by readingsCoincide
                             = Product.second(edge);
                          done };
                 Plane.IsEndOf(u, edge) by Or.introduceRight;
                 u ∈ Graph.vertices(Plane.overlayGraph(pieces, points))
                     by Plane.overlayGraph_end_is_vertex;
                 done
               }
           } };
  done
}

theorem Plane.overlayGraph_IsDrawing (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (endsCut : Plane.EndsAreCut(pieces, points))
        (meetsCut : Plane.MeetsAreCut(pieces, points))
        : Plane.Graph.IsDrawing(Plane.overlayGraph(pieces, points),
              Plane.segmentDrawing) := {
  Graph.IsWellFormed(Plane.overlayGraph(pieces, points))
      by Plane.overlayGraph_IsWellFormed;
  Graph.edges(Plane.overlayGraph(pieces, points)) = Plane.overlayPieces(pieces, points)
      by Plane.overlayGraph_edges as edgesAre;

  -- No vertex is interior to an edge: a vertex is an end of some edge, hence a
  -- cut point, and a cut point is interior to nothing.
  ∀ (piece : Plane.Segment). ∀ (vertex : Plane.Point).
      piece ∈ Graph.edges(Plane.overlayGraph(pieces, points)) →
      vertex ∈ Graph.vertices(Plane.overlayGraph(pieces, points)) →
      vertex ∉ Plane.openSegment(Product.first(piece), Product.second(piece))
      by { take piece : Plane.Segment;
           take vertex : Plane.Point;
           suppose piece ∈ Graph.edges(Plane.overlayGraph(pieces, points));
           suppose vertex ∈ Graph.vertices(Plane.overlayGraph(pieces, points));
           piece ∈ Plane.overlayPieces(pieces, points) by substituting edgesAre;
           choose edge such that edge ∈ Plane.overlayPieces(pieces, points)
               ∧ Plane.IsEndOf(vertex, edge) from Plane.overlayGraph_vertex_is_end;
           edge ∈ Plane.overlayPieces(pieces, points);
           Plane.IsEndOf(vertex, edge);
           vertex ∈ points by Plane.overlayPieces_end_is_cut;
           done by Plane.overlayPieces_avoids_cuts };

  -- And distinct edges have disjoint interiors, which is separation.
  ∀ (piece other : Plane.Segment). ∀ (x : Plane.Point).
      piece ∈ Graph.edges(Plane.overlayGraph(pieces, points)) →
      other ∈ Graph.edges(Plane.overlayGraph(pieces, points)) →
      piece ≠ other →
      x ∈ Plane.openSegment(Product.first(piece), Product.second(piece)) →
      x ∉ Plane.openSegment(Product.first(other), Product.second(other))
      by { take piece : Plane.Segment;
           take other : Plane.Segment;
           take x : Plane.Point;
           suppose piece ∈ Graph.edges(Plane.overlayGraph(pieces, points));
           suppose other ∈ Graph.edges(Plane.overlayGraph(pieces, points));
           suppose piece ≠ other;
           suppose x ∈ Plane.openSegment(Product.first(piece), Product.second(piece));
           piece ∈ Plane.overlayPieces(pieces, points) by substituting edgesAre;
           other ∈ Plane.overlayPieces(pieces, points) by substituting edgesAre;
           done by Plane.overlayPieces_disjoint_interiors };
  done by Plane.Graph.polygonal_IsDrawing
}

-- ----------------------------------------------------------------------
-- And it occupies exactly what it was built from.

theorem Plane.overlayGraph_pointSet (pieces : List(Plane.Segment))
        (points : List(Plane.Point))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        : Plane.Graph.pointSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
          = Plane.piecesCover(pieces) := {
  -- An edge's arc is its segment, so the edge set is what the edges cover.
  ∀ (edge : Plane.Segment). edge ∈ Plane.overlayPieces(pieces, points) →
      Plane.arc(Plane.segmentDrawing(edge))
          = Plane.segment(Product.first(edge), Product.second(edge))
      by { take edge : Plane.Segment;
           suppose edge ∈ Plane.overlayPieces(pieces, points);
           done by Plane.arc_segmentDrawing };
  List.unionOver((edge : Plane.Segment) ↦ Plane.arc(Plane.segmentDrawing(edge)),
      Plane.overlayPieces(pieces, points))
      = Plane.piecesCover(Plane.overlayPieces(pieces, points))
      by List.unionOver_pointwise as edgeSetIsCover;

  -- Deduplicating keeps the members, so it keeps the cover.
  List.deduplicate(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))
      ⊆ List.map(Plane.orientSegment, Plane.subdivide(pieces, points))
      by List.deduplicate_subset;
  List.map(Plane.orientSegment, Plane.subdivide(pieces, points))
      ⊆ List.deduplicate(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))
      by List.subset_deduplicate;
  Plane.piecesCover(Plane.overlayPieces(pieces, points))
      = Plane.piecesCover(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))
      by List.unionOver_same_members as deduplicationKeepsCover;

  -- And orienting keeps each piece's segment.
  Plane.piecesCover(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))
      = List.unionOver((part : Plane.Segment) ↦
            Plane.segment(Product.first(Plane.orientSegment(part)),
                          Product.second(Plane.orientSegment(part))),
        Plane.subdivide(pieces, points))
      by List.unionOver_map as coverThroughOrienting;
  ∀ (part : Plane.Segment). part ∈ Plane.subdivide(pieces, points) →
      Plane.segment(Product.first(Plane.orientSegment(part)),
                    Product.second(Plane.orientSegment(part)))
          = Plane.segment(Product.first(part), Product.second(part))
      by { take part : Plane.Segment;
           suppose part ∈ Plane.subdivide(pieces, points);
           Plane.SameSegment(Plane.orientSegment(part), part)
               by Plane.SameSegment.orientSegment;
           done by Plane.SameSegment.segment };
  List.unionOver((part : Plane.Segment) ↦
        Plane.segment(Product.first(Plane.orientSegment(part)),
                      Product.second(Plane.orientSegment(part))),
      Plane.subdivide(pieces, points))
      = Plane.piecesCover(Plane.subdivide(pieces, points))
      by List.unionOver_pointwise as orientingKeepsCover;
  Plane.piecesCover(Plane.subdivide(pieces, points)) = Plane.piecesCover(pieces)
      by Plane.subdivide_covers as subdivisionKeepsCover;

  Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
     = List.unionOver((edge : Plane.Segment) ↦ Plane.arc(Plane.segmentDrawing(edge)),
           Plane.overlayPieces(pieces, points))
     = Plane.piecesCover(Plane.overlayPieces(pieces, points)) by edgeSetIsCover
     = Plane.piecesCover(List.map(Plane.orientSegment, Plane.subdivide(pieces, points)))
           by deduplicationKeepsCover
     = List.unionOver((part : Plane.Segment) ↦
           Plane.segment(Product.first(Plane.orientSegment(part)),
                         Product.second(Plane.orientSegment(part))),
         Plane.subdivide(pieces, points)) by coverThroughOrienting
     = Plane.piecesCover(Plane.subdivide(pieces, points)) by orientingKeepsCover
     = Plane.piecesCover(pieces) by subdivisionKeepsCover as edgeSetIsPiecesCover;

  -- Every vertex lies on an edge, so the vertex set adds nothing.
  Plane.Graph.vertexSet(Plane.overlayGraph(pieces, points))
      ⊆ Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      by { take y : Plane.Point;
           suppose y ∈ Plane.Graph.vertexSet(Plane.overlayGraph(pieces, points));
           y ∈ Graph.vertices(Plane.overlayGraph(pieces, points))
               by Plane.Graph.vertexSet_member_invert;
           choose edge such that edge ∈ Plane.overlayPieces(pieces, points)
               ∧ Plane.IsEndOf(y, edge) from Plane.overlayGraph_vertex_is_end;
           edge ∈ Plane.overlayPieces(pieces, points);
           Plane.IsEndOf(y, edge);
           edge ∈ Graph.edges(Plane.overlayGraph(pieces, points));
           Plane.arc(Plane.segmentDrawing(edge))
               = Plane.segment(Product.first(edge), Product.second(edge))
               by Plane.arc_segmentDrawing as arcIsSegment;
           y ∈ Plane.segment(Product.first(edge), Product.second(edge))
               by { done by cases {
                      case y = Product.first(edge) as atFirstEnd: {
                          Product.first(edge)
                              ∈ Plane.segment(Product.first(edge), Product.second(edge))
                              by Plane.left_in_segment;
                          done by substituting atFirstEnd
                        }
                      case y = Product.second(edge) as atSecondEnd: {
                          Product.second(edge)
                              ∈ Plane.segment(Product.first(edge), Product.second(edge))
                              by Plane.right_in_segment;
                          done by substituting atSecondEnd
                        }
                    } };
           y ∈ Plane.arc(Plane.segmentDrawing(edge)) by substituting arcIsSegment;
           done by Plane.Graph.edgeSet_member };
  Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      ⊆ Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      by Set.subset.reflexive;
  Plane.Graph.pointSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      ⊆ Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      by Set.union_subset;
  Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      ⊆ Plane.Graph.pointSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      by { take y : Plane.Point;
           suppose y ∈ Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points),
               Plane.segmentDrawing);
           done };
  Plane.Graph.pointSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
     = Plane.Graph.edgeSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
           by Set.equal_of_same_members
     = Plane.piecesCover(pieces) by edgeSetIsPiecesCover;
  done
}

-- ----------------------------------------------------------------------
-- The overlay (`lem:polygonal-overlay`).
--
-- Finitely many segments, no one of them degenerate, can be made into a
-- polygonal plane graph occupying exactly the same points: subdivide at the
-- ends and the meets, orient, and name each segment once.

theorem Plane.polygonal_overlay (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        : ∃ (graph : Plane.PolygonalGraph).
              Plane.Graph.IsDrawing(graph, Plane.segmentDrawing)
              ∧ Plane.Graph.pointSet(graph, Plane.segmentDrawing)
                  = Plane.piecesCover(pieces) := {
  choose points such that Plane.EndsAreCut(pieces, points)
      ∧ Plane.MeetsAreCut(pieces, points) from Plane.exists_cut_points;
  Plane.EndsAreCut(pieces, points);
  Plane.MeetsAreCut(pieces, points);
  Plane.Graph.IsDrawing(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      by Plane.overlayGraph_IsDrawing;
  Plane.Graph.pointSet(Plane.overlayGraph(pieces, points), Plane.segmentDrawing)
      = Plane.piecesCover(pieces) by Plane.overlayGraph_pointSet;
  witness Plane.overlayGraph(pieces, points)
}

-- ----------------------------------------------------------------------
-- Overlaying several polygonal graphs.
--
-- The blueprint asks for the overlay of finitely many polygonal plane graphs,
-- not of a bare list of segments. There is no new geometry in the difference:
-- concatenate the edge lists and cite `Plane.polygonal_overlay`. What has to be
-- said carefully is what the result covers — the graphs' EDGE sets. An isolated
-- vertex of one of the graphs is not covered, and could not be: the overlay's
-- vertices are the ends of its edges.

-- A polygonal graph covers what its edges cover.
theorem Plane.edgeSet_is_piecesCover (graph : Plane.PolygonalGraph)
        : Plane.Graph.edgeSet(graph, Plane.segmentDrawing)
          = Plane.piecesCover(Graph.edges(graph)) := {
  ∀ (edge : Plane.Segment). edge ∈ Graph.edges(graph) →
      Plane.arc(Plane.segmentDrawing(edge))
          = Plane.segment(Product.first(edge), Product.second(edge))
      by { take edge : Plane.Segment;
           suppose edge ∈ Graph.edges(graph);
           done by Plane.arc_segmentDrawing };
  done by List.unionOver_pointwise
}

definition Plane.graphEdges : List(Plane.PolygonalGraph) → List(Plane.Segment)
  | List.empty               => List.empty(Plane.Segment)
  | List.prepend(head, tail) =>
      List.append(Graph.edges(head), Plane.graphEdges(tail))

theorem Plane.graphEdges_member_invert (graphs : List(Plane.PolygonalGraph))
        (edge : Plane.Segment) (isEdge : edge ∈ Plane.graphEdges(graphs))
        : ∃ (graph : Plane.PolygonalGraph). graph ∈ graphs
              ∧ edge ∈ Graph.edges(graph) :=
  by induction on graphs with IH {
    case graphs = List.empty:
        done by List.no_member_empty
    case graphs = List.prepend(head, tail) for some head, tail: {
        edge ∈ List.append(Graph.edges(head), Plane.graphEdges(tail));
        edge ∈ Graph.edges(head) ∨ edge ∈ Plane.graphEdges(tail)
            by List.member_append_invert;
        head ∈ List.prepend(Plane.PolygonalGraph, head, tail);
        done by cases {
          case edge ∈ Graph.edges(head):
              witness head
          case edge ∈ Plane.graphEdges(tail): {
              choose graph such that graph ∈ tail ∧ edge ∈ Graph.edges(graph) from IH;
              graph ∈ tail;
              graph ∈ List.prepend(Plane.PolygonalGraph, head, tail);
              edge ∈ Graph.edges(graph);
              witness graph
            }
        }
      }
  }

-- What the concatenated edge lists cover is what the graphs cover.
theorem Plane.graphEdges_cover (graphs : List(Plane.PolygonalGraph))
        : Plane.piecesCover(Plane.graphEdges(graphs))
          = List.unionOver(
                (graph : Plane.PolygonalGraph) ↦
                    Plane.Graph.edgeSet(graph, Plane.segmentDrawing),
                graphs) :=
  by induction on graphs with IH {
    case graphs = List.empty:
        done
    case graphs = List.prepend(head, tail) for some head, tail: {
        Plane.Graph.edgeSet(head, Plane.segmentDrawing)
            = Plane.piecesCover(Graph.edges(head))
            by Plane.edgeSet_is_piecesCover as headCovers;
        Plane.piecesCover(Plane.graphEdges(List.prepend(Plane.PolygonalGraph, head, tail)))
           = Plane.piecesCover(List.append(Graph.edges(head), Plane.graphEdges(tail)))
           = Plane.piecesCover(Graph.edges(head))
                 ∪ Plane.piecesCover(Plane.graphEdges(tail))
                 by List.unionOver_append
           = Plane.Graph.edgeSet(head, Plane.segmentDrawing)
                 ∪ Plane.piecesCover(Plane.graphEdges(tail)) by headCovers
           = Plane.Graph.edgeSet(head, Plane.segmentDrawing)
                 ∪ List.unionOver(
                       (graph : Plane.PolygonalGraph) ↦
                           Plane.Graph.edgeSet(graph, Plane.segmentDrawing),
                       tail) by IH;
        done
      }
  }

theorem Plane.polygonal_overlay_of_graphs (graphs : List(Plane.PolygonalGraph))
        (allWellFormed : ∀ (graph : Plane.PolygonalGraph). graph ∈ graphs →
            Graph.IsWellFormed(graph))
        : ∃ (overlay : Plane.PolygonalGraph).
              Plane.Graph.IsDrawing(overlay, Plane.segmentDrawing)
              ∧ Plane.Graph.pointSet(overlay, Plane.segmentDrawing)
                  = List.unionOver(
                        (graph : Plane.PolygonalGraph) ↦
                            Plane.Graph.edgeSet(graph, Plane.segmentDrawing),
                        graphs) := {
  -- Every edge of every graph is nondegenerate, by well-formedness.
  ∀ (piece : Plane.Segment). piece ∈ Plane.graphEdges(graphs) →
      Product.first(piece) ≠ Product.second(piece)
      by { take piece : Plane.Segment;
           suppose piece ∈ Plane.graphEdges(graphs);
           choose graph such that graph ∈ graphs ∧ piece ∈ Graph.edges(graph)
               from Plane.graphEdges_member_invert;
           graph ∈ graphs;
           piece ∈ Graph.edges(graph);
           Graph.IsWellFormed(graph) by allWellFormed;
           done by Plane.segmentEdge_ends_distinct };
  -- The same construction the segment form uses, so that its two results can
  -- be cited as themselves rather than projected out of an existential.
  choose points such that Plane.EndsAreCut(Plane.graphEdges(graphs), points)
      ∧ Plane.MeetsAreCut(Plane.graphEdges(graphs), points)
      from Plane.exists_cut_points;
  Plane.EndsAreCut(Plane.graphEdges(graphs), points);
  Plane.MeetsAreCut(Plane.graphEdges(graphs), points);
  Plane.Graph.IsDrawing(Plane.overlayGraph(Plane.graphEdges(graphs), points),
      Plane.segmentDrawing) by Plane.overlayGraph_IsDrawing;
  Plane.piecesCover(Plane.graphEdges(graphs))
      = List.unionOver(
            (graph : Plane.PolygonalGraph) ↦
                Plane.Graph.edgeSet(graph, Plane.segmentDrawing),
            graphs)
      by Plane.graphEdges_cover as edgesCoverGraphs;
  Plane.Graph.pointSet(Plane.overlayGraph(Plane.graphEdges(graphs), points),
      Plane.segmentDrawing)
     = Plane.piecesCover(Plane.graphEdges(graphs)) by Plane.overlayGraph_pointSet
     = List.unionOver(
           (graph : Plane.PolygonalGraph) ↦
               Plane.Graph.edgeSet(graph, Plane.segmentDrawing),
           graphs) by edgesCoverGraphs;
  witness Plane.overlayGraph(Plane.graphEdges(graphs), points)
}
