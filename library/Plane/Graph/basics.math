-- Plane/Graph/basics.math
--
-- Plane graphs. Layer 6 of PLAN_JORDAN_SCHOENFLIES.md, where the abstract
-- combinatorics of Layer 5 meets the geometry of Layers 0-4.
--
-- A plane graph is an abstract graph TOGETHER WITH a drawing: an arc for
-- each of its edges. The two are kept apart rather than bundled into one
-- record, so every theorem of `Graph/` — connectedness, cycles,
-- 2-connectivity, ears, trees — applies to the abstract graph with nothing
-- to project through. `Plane.Graph.IsDrawing(graph, drawing)` is the
-- blueprint's condition on the pair: the edge arcs are simple, they run
-- between the vertices their names say, their interiors miss every vertex,
-- and distinct interiors miss each other.
--
-- The vertices are plane POINTS, so "the vertices are distinct" is already
-- `Graph.IsWellFormed`'s distinctness of the vertex list, and loops are
-- already excluded there. Nothing about the plane has to repeat it.
--
-- What every consumer actually uses is the consequence, not the condition:
-- two distinct edges meet only at a vertex incident with both
-- (`Plane.Graph.IsDrawing.arcs_meet_at_vertex`).

module Plane.Graph.basics

import Logic.basics
import Logic.exists
import Logic.product
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Lists.list
import Real.interface
import Real.order
import Metric.space
import Metric.interval
import Plane.point
import Plane.curve
import Plane.subarc
import Graph.basics

-- Throughout: edge names are drawn from `E`, and `ends` attaches each name
-- to the two plane points it runs between. The vertex type is fixed —
-- these are graphs in the plane — so only the edge side stays ambient.
convention E : Type(0)
convention ends : E → Pair(Plane.Point, Plane.Point)

-- ----------------------------------------------------------------------
-- What it is for a family of arcs to draw a graph.

definition Plane.Graph.IsDrawing (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point)) : Proposition :=
  Graph.IsWellFormed(graph)
  ∧ (∀ (edge : E). edge ∈ Graph.edges(graph) →
        Plane.IsArc(drawing(edge))
        ∧ Graph.Joins(graph, edge,
              Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge))))
  ∧ (∀ (edge : E). ∀ (vertex : Plane.Point).
        edge ∈ Graph.edges(graph) → vertex ∈ Graph.vertices(graph) →
        ¬(vertex ∈ Plane.openArc(drawing(edge))))
  ∧ (∀ (edge other : E). ∀ (x : Plane.Point).
        edge ∈ Graph.edges(graph) → other ∈ Graph.edges(graph) → edge ≠ other →
        x ∈ Plane.openArc(drawing(edge)) → ¬(x ∈ Plane.openArc(drawing(other))))

theorem Plane.Graph.IsDrawing.IsWellFormed (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        : Graph.IsWellFormed(graph) :=
  done

theorem Plane.Graph.IsDrawing.IsArc (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        : Plane.IsArc(drawing(edge)) := {
  ∀ (e : E). e ∈ Graph.edges(graph) →
      Plane.IsArc(drawing(e))
      ∧ Graph.Joins(graph, e, Plane.arcStart(drawing(e)), Plane.arcFinish(drawing(e)))
      as edgesAreDrawn;
  Plane.IsArc(drawing(edge))
      ∧ Graph.Joins(graph, edge,
            Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by edgesAreDrawn(edge);
  done
}

-- An edge's arc runs from one of its ends to the other. Which of the two is
-- the start is never asked, so the fact is stated through `Joins`.
theorem Plane.Graph.IsDrawing.joins_ends (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        : Graph.Joins(graph, edge,
              Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge))) := {
  ∀ (e : E). e ∈ Graph.edges(graph) →
      Plane.IsArc(drawing(e))
      ∧ Graph.Joins(graph, e, Plane.arcStart(drawing(e)), Plane.arcFinish(drawing(e)))
      as edgesAreDrawn;
  Plane.IsArc(drawing(edge))
      ∧ Graph.Joins(graph, edge,
            Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by edgesAreDrawn(edge);
  done
}

theorem Plane.Graph.IsDrawing.vertex_off_interior (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        (vertex : Plane.Point) (isVertex : vertex ∈ Graph.vertices(graph))
        : ¬(vertex ∈ Plane.openArc(drawing(edge))) := {
  ∀ (e : E). ∀ (v : Plane.Point).
      e ∈ Graph.edges(graph) → v ∈ Graph.vertices(graph) →
      ¬(v ∈ Plane.openArc(drawing(e)));
  done
}

theorem Plane.Graph.IsDrawing.interiors_disjoint (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge other : E)
        (isEdge : edge ∈ Graph.edges(graph)) (otherIsEdge : other ∈ Graph.edges(graph))
        (distinct : edge ≠ other)
        (x : Plane.Point) (inInterior : x ∈ Plane.openArc(drawing(edge)))
        : ¬(x ∈ Plane.openArc(drawing(other))) := {
  ∀ (e f : E). ∀ (y : Plane.Point).
      e ∈ Graph.edges(graph) → f ∈ Graph.edges(graph) → e ≠ f →
      y ∈ Plane.openArc(drawing(e)) → ¬(y ∈ Plane.openArc(drawing(f)));
  done
}

-- ----------------------------------------------------------------------
-- The two ends of an edge arc are vertices of the graph.

theorem Plane.Graph.IsDrawing.arcStart_is_vertex (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        : Plane.arcStart(drawing(edge)) ∈ Graph.vertices(graph) := {
  Graph.IsWellFormed(graph) by Plane.Graph.IsDrawing.IsWellFormed;
  Graph.Joins(graph, edge,
      Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by Plane.Graph.IsDrawing.joins_ends;
  done by Graph.IsWellFormed.end_is_vertex
}

theorem Plane.Graph.IsDrawing.arcFinish_is_vertex (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        : Plane.arcFinish(drawing(edge)) ∈ Graph.vertices(graph) := {
  Graph.IsWellFormed(graph) by Plane.Graph.IsDrawing.IsWellFormed;
  Graph.Joins(graph, edge,
      Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by Plane.Graph.IsDrawing.joins_ends;
  done by Graph.IsWellFormed.other_end_is_vertex
}

-- An edge arc runs between two DISTINCT points, so it is an arc in earnest
-- and not a constant map: the abstract graph has no loops.
theorem Plane.Graph.IsDrawing.arc_ends_distinct (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        : Plane.arcStart(drawing(edge)) ≠ Plane.arcFinish(drawing(edge)) := {
  Graph.IsWellFormed(graph) by Plane.Graph.IsDrawing.IsWellFormed;
  Graph.Joins(graph, edge,
      Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by Plane.Graph.IsDrawing.joins_ends;
  done by Graph.IsWellFormed.no_loop
}

-- ----------------------------------------------------------------------
-- Passing to a subgraph.
--
-- A subgraph is drawn by the SAME family of arcs. `Graph.Joins` reads only
-- the ambient `ends`, so an edge joins the same two points in the part as
-- in the whole, and every clause of the condition is inherited by
-- restricting its quantifiers. Only the part's own two lists have to be
-- checked, which is what `Graph.IsWellFormed(part)` says.

theorem Plane.Graph.IsDrawing.subgraph (whole part : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(whole, drawing))
        (isSubgraph : Graph.IsSubgraph(part, whole))
        (partWellFormed : Graph.IsWellFormed(part))
        : Plane.Graph.IsDrawing(part, drawing) := {
  ∀ (edge : E). edge ∈ Graph.edges(part) → edge ∈ Graph.edges(whole);
  ∀ (vertex : Plane.Point).
      vertex ∈ Graph.vertices(part) → vertex ∈ Graph.vertices(whole);

  ∀ (edge : E). edge ∈ Graph.edges(part) →
      Plane.IsArc(drawing(edge))
      ∧ Graph.Joins(part, edge,
            Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by { take edge : E;
           suppose edge ∈ Graph.edges(part);
           edge ∈ Graph.edges(whole);
           Plane.IsArc(drawing(edge)) by Plane.Graph.IsDrawing.IsArc;
           Graph.Joins(whole, edge,
               Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
               by Plane.Graph.IsDrawing.joins_ends;
           done };

  ∀ (edge : E). ∀ (vertex : Plane.Point).
      edge ∈ Graph.edges(part) → vertex ∈ Graph.vertices(part) →
      ¬(vertex ∈ Plane.openArc(drawing(edge)))
      by { take edge : E;
           take vertex : Plane.Point;
           suppose edge ∈ Graph.edges(part);
           suppose vertex ∈ Graph.vertices(part);
           edge ∈ Graph.edges(whole);
           vertex ∈ Graph.vertices(whole);
           done by Plane.Graph.IsDrawing.vertex_off_interior };

  ∀ (edge other : E). ∀ (x : Plane.Point).
      edge ∈ Graph.edges(part) → other ∈ Graph.edges(part) → edge ≠ other →
      x ∈ Plane.openArc(drawing(edge)) → ¬(x ∈ Plane.openArc(drawing(other)))
      by { take edge : E;
           take other : E;
           take x : Plane.Point;
           suppose edge ∈ Graph.edges(part);
           suppose other ∈ Graph.edges(part);
           suppose edge ≠ other;
           suppose x ∈ Plane.openArc(drawing(edge));
           edge ∈ Graph.edges(whole);
           other ∈ Graph.edges(whole);
           done by Plane.Graph.IsDrawing.interiors_disjoint };

  done
}

-- ----------------------------------------------------------------------
-- Where two edge arcs can meet.
--
-- A point of an edge arc is read off its parameter: the two ends of the
-- interval give the two vertices, and every other parameter lands in the
-- interior. Nothing here needs the arc to be injective — only that the
-- parametrisation covers the arc.

theorem Plane.Graph.IsDrawing.endpoint_or_interior (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge : E) (isEdge : edge ∈ Graph.edges(graph))
        (x : Plane.Point) (onArc : x ∈ Plane.arc(drawing(edge)))
        : Graph.Incident(graph, edge, x) ∨ x ∈ Plane.openArc(drawing(edge)) := {
  Graph.Joins(graph, edge,
      Plane.arcStart(drawing(edge)), Plane.arcFinish(drawing(edge)))
      by Plane.Graph.IsDrawing.joins_ends;
  choose parameter : ℝ such that
      parameter ∈ Real.unitInterval ∧ drawing(edge)(parameter) = x from onArc;
  parameter ∈ Real.unitInterval;
  drawing(edge)(parameter) = x;
  done by cases {
    case parameter = 0: {
        Plane.arcStart(drawing(edge)) = x;
        Graph.Incident(graph, edge, Plane.arcStart(drawing(edge)))
            by Graph.Joins.incident_source;
        Graph.Incident(graph, edge, x);
        done
      }
    otherwise as notAtStart: done by cases {
        case parameter = 1: {
            Plane.arcFinish(drawing(edge)) = x;
            Graph.Incident(graph, edge, Plane.arcFinish(drawing(edge)))
                by Graph.Joins.incident_target;
            Graph.Incident(graph, edge, x);
            done
          }
        otherwise as notAtFinish: {
            parameter ∈ Real.openUnitInterval;
            x ∈ Plane.openArc(drawing(edge)) by { witness parameter };
            done
          }
      }
  }
}

-- The workhorse of the layer, and the fact the blueprint quotes as
-- "distinct edges of a plane graph meet only at shared vertices". Every
-- later argument that two pieces of a drawing are disjoint away from the
-- vertices runs through this.
theorem Plane.Graph.IsDrawing.arcs_meet_at_vertex (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge other : E)
        (isEdge : edge ∈ Graph.edges(graph)) (otherIsEdge : other ∈ Graph.edges(graph))
        (distinct : edge ≠ other)
        (x : Plane.Point)
        (onEdge : x ∈ Plane.arc(drawing(edge)))
        (onOther : x ∈ Plane.arc(drawing(other)))
        : Graph.Incident(graph, edge, x) ∧ Graph.Incident(graph, other, x) := {
  Graph.IsWellFormed(graph) by Plane.Graph.IsDrawing.IsWellFormed;
  Graph.Incident(graph, edge, x) ∨ x ∈ Plane.openArc(drawing(edge))
      by Plane.Graph.IsDrawing.endpoint_or_interior;
  Graph.Incident(graph, other, x) ∨ x ∈ Plane.openArc(drawing(other))
      by Plane.Graph.IsDrawing.endpoint_or_interior;

  -- An end of an edge is a vertex, and no vertex lies in any interior; so
  -- once one of the two arcs meets `x` at an end, the other must too.
  ∀ (e : E). e ∈ Graph.edges(graph) → Graph.Incident(graph, e, x) →
      x ∈ Graph.vertices(graph)
      by { take e : E;
           suppose e ∈ Graph.edges(graph);
           suppose Graph.Incident(graph, e, x);
           choose farEnd such that Graph.Joins(graph, e, x, farEnd);
           done by Graph.IsWellFormed.end_is_vertex };

  done by cases {
    case Graph.Incident(graph, edge, x): {
        x ∈ Graph.vertices(graph);
        ¬(x ∈ Plane.openArc(drawing(other)))
            by Plane.Graph.IsDrawing.vertex_off_interior;
        Graph.Incident(graph, other, x);
        done
      }
    case x ∈ Plane.openArc(drawing(edge)): {
        ¬(x ∈ Plane.openArc(drawing(other)))
            by Plane.Graph.IsDrawing.interiors_disjoint;
        Graph.Incident(graph, other, x);
        x ∈ Graph.vertices(graph);
        ¬(x ∈ Plane.openArc(drawing(edge)))
            by Plane.Graph.IsDrawing.vertex_off_interior;
        done
      }
  }
}

-- Away from the vertices an edge is determined by any one of its points:
-- the form in which the overlay reads the drawing back off the plane.
theorem Plane.Graph.IsDrawing.unique_edge_at (graph : Graph(Plane.Point, E, ends))
        (drawing : E → (ℝ → Plane.Point))
        (isDrawing : Plane.Graph.IsDrawing(graph, drawing))
        (edge other : E)
        (isEdge : edge ∈ Graph.edges(graph)) (otherIsEdge : other ∈ Graph.edges(graph))
        (x : Plane.Point) (notVertex : ¬(x ∈ Graph.vertices(graph)))
        (onEdge : x ∈ Plane.arc(drawing(edge)))
        (onOther : x ∈ Plane.arc(drawing(other)))
        : edge = other := {
  Graph.IsWellFormed(graph) by Plane.Graph.IsDrawing.IsWellFormed;
  suppose edge ≠ other for contradiction {
    Graph.Incident(graph, edge, x) ∧ Graph.Incident(graph, other, x)
        by Plane.Graph.IsDrawing.arcs_meet_at_vertex;
    Graph.Incident(graph, edge, x);
    choose farEnd such that Graph.Joins(graph, edge, x, farEnd);
    x ∈ Graph.vertices(graph) by Graph.IsWellFormed.end_is_vertex;
    done
  };
  done
}
