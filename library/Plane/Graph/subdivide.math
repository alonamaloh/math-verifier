-- Plane/Graph/subdivide.math
--
-- Cutting a list of segments at a list of points. Layer 6 of
-- PLAN_JORDAN_SCHOENFLIES.md; the construction `lem:polygonal-overlay`
-- runs on.
--
-- The blueprint says "subdivide at all old endpoints, isolated
-- intersections, and endpoints of overlapping intervals". Read literally
-- that asks for the cut points to be produced as DATA, which would mean
-- naming the meets — `Plane.segment_meet` is an existential, so naming them
-- needs a choice operator — and then ordering them along each segment,
-- which would mean sorting. Neither is needed.
--
-- Instead the recursion is structural in the POINT list: cut every current
-- piece at one point, then recurse with the rest of the points. A point
-- interior to a piece splits it in two; a point anywhere else leaves it
-- alone. Order does not matter, because cutting at a point that has already
-- become an endpoint is a no-op — which is also why no sort is required, and
-- why the same point appearing twice in the list costs nothing.
--
-- The overlay itself is then stated EXISTENTIALLY ("can be made into a plane
-- graph by subdivision", as the blueprint has it) and proved by induction
-- over the segments, so nothing ever has to compute the cut points either.

module Plane.Graph.subdivide

import Logic.basics
import Logic.product
import Equality.basics
import axioms
import Set.basics
import Set.algebra
import Natural.classical_decidable
import Lists.list
import Lists.append
import Lists.set_union
import Real.interface
import Plane.point
import Plane.segment
import Plane.Graph.segments

-- ----------------------------------------------------------------------
-- One piece, one point.

definition Plane.splitSegmentAt (point : Plane.Point) (piece : Plane.Segment)
        : List(Plane.Segment) :=
  if point ∈ Plane.openSegment(Product.first(piece), Product.second(piece))
  then List.prepend(Plane.Segment, Product.make(Product.first(piece), point),
         List.prepend(Plane.Segment, Product.make(point, Product.second(piece)),
           List.empty(Plane.Segment)))
  else List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))

theorem Plane.splitSegmentAt_interior (point : Plane.Point) (piece : Plane.Segment)
        (interior : point ∈ Plane.openSegment(
            Product.first(piece), Product.second(piece)))
        : Plane.splitSegmentAt(point, piece)
          = List.prepend(Plane.Segment,
                Product.make(Product.first(piece), point),
                List.prepend(Plane.Segment,
                    Product.make(point, Product.second(piece)),
                    List.empty(Plane.Segment))) :=
  done by Logic.if_positive

theorem Plane.splitSegmentAt_elsewhere (point : Plane.Point) (piece : Plane.Segment)
        (outside : point ∉ Plane.openSegment(Product.first(piece), Product.second(piece)))
        : Plane.splitSegmentAt(point, piece)
          = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment)) :=
  done by Logic.if_negative

-- ----------------------------------------------------------------------
-- Every piece, one point.

definition Plane.splitAllAt (point : Plane.Point)
        : List(Plane.Segment) → List(Plane.Segment)
  | List.empty               => List.empty(Plane.Segment)
  | List.prepend(head, tail) =>
      List.append(Plane.splitSegmentAt(point, head),
                  Plane.splitAllAt(point, tail))

theorem Plane.splitAllAt_empty (point : Plane.Point)
        : Plane.splitAllAt(point, List.empty(Plane.Segment))
          = List.empty(Plane.Segment) :=
  done

theorem Plane.splitAllAt_prepend (point : Plane.Point)
        (head : Plane.Segment) (tail : List(Plane.Segment))
        : Plane.splitAllAt(point, List.prepend(Plane.Segment, head, tail))
          = List.append(Plane.splitSegmentAt(point, head),
                        Plane.splitAllAt(point, tail)) :=
  done

-- ----------------------------------------------------------------------
-- Every piece, every point.
--
-- The pieces are threaded through the RETURN TYPE rather than as a
-- parameter the recursive call changes: a fixed parameter that varies
-- elaborates, but its recursion equation never fires, so `subdivide` would
-- not reduce. `Plane.chainFunction` is built the same way and for the same
-- reason.

definition Plane.cutFunction
        : List(Plane.Point) → (List(Plane.Segment) → List(Plane.Segment))
  | List.empty               => (pieces : List(Plane.Segment)) ↦ pieces
  | List.prepend(head, tail) =>
      (pieces : List(Plane.Segment)) ↦
          Plane.cutFunction(tail)(Plane.splitAllAt(head, pieces))

definition Plane.subdivide (pieces : List(Plane.Segment))
        (points : List(Plane.Point)) : List(Plane.Segment) :=
  Plane.cutFunction(points)(pieces)

theorem Plane.subdivide_empty (pieces : List(Plane.Segment))
        : Plane.subdivide(pieces, List.empty(Plane.Point)) = pieces :=
  done

theorem Plane.subdivide_prepend (pieces : List(Plane.Segment))
        (point : Plane.Point) (rest : List(Plane.Point))
        : Plane.subdivide(pieces, List.prepend(Plane.Point, point, rest))
          = Plane.subdivide(Plane.splitAllAt(point, pieces), rest) :=
  done

-- ----------------------------------------------------------------------
-- What one cut does.
--
-- Two facts, and everything below is these two lifted through the two
-- recursions: a cut only SHRINKS interiors, and after cutting at a point
-- that point is interior to nothing.

theorem Plane.splitSegmentAt_ends_distinct (cut : Plane.Point)
        (piece : Plane.Segment)
        (distinct : Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitSegmentAt(cut, piece))
        : Product.first(part) ≠ Product.second(part) :=
  done by cases {
    case cut ∈ Plane.openSegment(
             Product.first(piece), Product.second(piece)) as interior: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment,
                  Product.make(Product.first(piece), cut),
                  List.prepend(Plane.Segment,
                      Product.make(cut, Product.second(piece)),
                      List.empty(Plane.Segment)))
            by Plane.splitSegmentAt_interior;
        part ∈ List.prepend(Plane.Segment,
                   Product.make(Product.first(piece), cut),
                   List.prepend(Plane.Segment,
                       Product.make(cut, Product.second(piece)),
                       List.empty(Plane.Segment)));
        part = Product.make(Product.first(piece), cut)
            ∨ part = Product.make(cut, Product.second(piece))
            by List.member_pair_invert;
        cut ≠ Product.first(piece);
        cut ≠ Product.second(piece);
        Product.first(piece) ≠ cut;
        done by cases {
          case part = Product.make(Product.first(piece), cut):
              done
          case part = Product.make(cut, Product.second(piece)):
              done
        }
      }
    otherwise as outside: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))
            by Plane.splitSegmentAt_elsewhere;
        part ∈ List.prepend(Plane.Segment, piece, List.empty(Plane.Segment));
        part = piece by List.member_singleton_invert;
        done
      }
  }

-- A piece of a cut lies inside what it was cut from, and so does its
-- interior. The closed half is convexity; the open half is where the cut
-- point's being interior is used, and it is the one that makes a cut
-- permanent. Both are carried by one existential downstream, because the
-- separation argument needs them at the SAME source piece: it reads the
-- piece's ends off the source segment and its interior off the source's.
theorem Plane.splitSegmentAt_inside (cut : Plane.Point) (piece : Plane.Segment)
        (distinct : Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitSegmentAt(cut, piece))
        : Plane.segment(Product.first(part), Product.second(part))
              ⊆ Plane.segment(Product.first(piece), Product.second(piece))
          ∧ Plane.openSegment(Product.first(part), Product.second(part))
              ⊆ Plane.openSegment(
                    Product.first(piece), Product.second(piece)) :=
  done by cases {
    case cut ∈ Plane.openSegment(
             Product.first(piece), Product.second(piece)) as interior: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment,
                  Product.make(Product.first(piece), cut),
                  List.prepend(Plane.Segment,
                      Product.make(cut, Product.second(piece)),
                      List.empty(Plane.Segment)))
            by Plane.splitSegmentAt_interior;
        part ∈ List.prepend(Plane.Segment,
                   Product.make(Product.first(piece), cut),
                   List.prepend(Plane.Segment,
                       Product.make(cut, Product.second(piece)),
                       List.empty(Plane.Segment)));
        part = Product.make(Product.first(piece), cut)
            ∨ part = Product.make(cut, Product.second(piece))
            by List.member_pair_invert;

        cut ∈ Plane.segment(Product.first(piece), Product.second(piece));
        Product.first(piece)
            ∈ Plane.segment(Product.first(piece), Product.second(piece))
            by Plane.left_in_segment;
        Product.second(piece)
            ∈ Plane.segment(Product.first(piece), Product.second(piece))
            by Plane.right_in_segment;
        Plane.IsConvex(Plane.segment(Product.first(piece), Product.second(piece)))
            by Plane.segment_IsConvex;
        Plane.segment(Product.first(piece), cut)
            ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            by Plane.IsConvex.segment_inside;
        Plane.segment(cut, Product.second(piece))
            ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            by Plane.IsConvex.segment_inside;

        Plane.openSegment(Product.first(piece), cut)
            ⊆ Plane.openSegment(Product.first(piece), Product.second(piece))
            by Plane.openSegment_left_inside;
        Plane.openSegment(cut, Product.second(piece))
            ⊆ Plane.openSegment(Product.first(piece), Product.second(piece))
            by Plane.openSegment_right_inside;
        done by cases {
          case part = Product.make(Product.first(piece), cut):
              done
          case part = Product.make(cut, Product.second(piece)):
              done
        }
      }
    otherwise as outside: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))
            by Plane.splitSegmentAt_elsewhere;
        part ∈ List.prepend(Plane.Segment, piece, List.empty(Plane.Segment));
        part = piece by List.member_singleton_invert;
        Plane.segment(Product.first(piece), Product.second(piece))
            ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            by Set.subset.reflexive;
        Plane.openSegment(Product.first(piece), Product.second(piece))
            ⊆ Plane.openSegment(Product.first(piece), Product.second(piece))
            by Set.subset.reflexive;
        done
      }
  }

-- After a cut, the point cut at is an ENDPOINT of every piece it touched,
-- and an interior excludes its endpoints.
theorem Plane.splitSegmentAt_avoids (cut : Plane.Point) (piece : Plane.Segment)
        (part : Plane.Segment) (isPart : part ∈ Plane.splitSegmentAt(cut, piece))
        : cut ∉ Plane.openSegment(Product.first(part), Product.second(part)) :=
  done by cases {
    case cut ∈ Plane.openSegment(
             Product.first(piece), Product.second(piece)) as interior: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment,
                  Product.make(Product.first(piece), cut),
                  List.prepend(Plane.Segment,
                      Product.make(cut, Product.second(piece)),
                      List.empty(Plane.Segment)))
            by Plane.splitSegmentAt_interior;
        part ∈ List.prepend(Plane.Segment,
                   Product.make(Product.first(piece), cut),
                   List.prepend(Plane.Segment,
                       Product.make(cut, Product.second(piece)),
                       List.empty(Plane.Segment)));
        part = Product.make(Product.first(piece), cut)
            ∨ part = Product.make(cut, Product.second(piece))
            by List.member_pair_invert;
        cut ∉ Plane.openSegment(Product.first(piece), cut)
            by { suppose cut ∈ Plane.openSegment(Product.first(piece), cut);
                 cut ≠ cut;
                 done };
        cut ∉ Plane.openSegment(cut, Product.second(piece))
            by { suppose cut ∈ Plane.openSegment(cut, Product.second(piece));
                 cut ≠ cut;
                 done };
        done by cases {
          case part = Product.make(Product.first(piece), cut):
              done
          case part = Product.make(cut, Product.second(piece)):
              done
        }
      }
    otherwise as outside: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))
            by Plane.splitSegmentAt_elsewhere;
        part ∈ List.prepend(Plane.Segment, piece, List.empty(Plane.Segment));
        part = piece by List.member_singleton_invert;
        done
      }
  }

-- ----------------------------------------------------------------------
-- The same three facts across a whole list of pieces.
--
-- Each is an induction on the piece list, splitting the `append` that
-- `splitAllAt` produces.

theorem Plane.splitAllAt_ends_distinct (cut : Plane.Point)
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitAllAt(cut, pieces))
        : Product.first(part) ≠ Product.second(part) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done
    case pieces = List.prepend(head, tail) for some head, tail: {
        head ∈ List.prepend(Plane.Segment, head, tail);
        Product.first(head) ≠ Product.second(head) by allDistinct;
        ∀ (piece : Plane.Segment). piece ∈ tail →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ tail;
                 piece ∈ List.prepend(Plane.Segment, head, tail);
                 done by allDistinct };
        part ∈ List.append(Plane.splitSegmentAt(cut, head),
                           Plane.splitAllAt(cut, tail));
        part ∈ Plane.splitSegmentAt(cut, head)
            ∨ part ∈ Plane.splitAllAt(cut, tail)
            by List.member_append_invert;
        done by cases {
          case part ∈ Plane.splitSegmentAt(cut, head):
              done by Plane.splitSegmentAt_ends_distinct
          case part ∈ Plane.splitAllAt(cut, tail):
              done by IH
        }
      }
  }

theorem Plane.splitAllAt_inside (cut : Plane.Point)
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitAllAt(cut, pieces))
        : ∃ (piece : Plane.Segment). piece ∈ pieces
            ∧ Plane.segment(Product.first(part), Product.second(part))
                ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            ∧ Plane.openSegment(Product.first(part), Product.second(part))
                ⊆ Plane.openSegment(
                      Product.first(piece), Product.second(piece)) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done
    case pieces = List.prepend(head, tail) for some head, tail: {
        head ∈ List.prepend(Plane.Segment, head, tail);
        Product.first(head) ≠ Product.second(head) by allDistinct;
        ∀ (piece : Plane.Segment). piece ∈ tail →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ tail;
                 piece ∈ List.prepend(Plane.Segment, head, tail);
                 done by allDistinct };
        part ∈ List.append(Plane.splitSegmentAt(cut, head),
                           Plane.splitAllAt(cut, tail));
        part ∈ Plane.splitSegmentAt(cut, head)
            ∨ part ∈ Plane.splitAllAt(cut, tail)
            by List.member_append_invert;
        done by cases {
          case part ∈ Plane.splitSegmentAt(cut, head): {
              Plane.segment(Product.first(part), Product.second(part))
                      ⊆ Plane.segment(Product.first(head), Product.second(head))
                  ∧ Plane.openSegment(Product.first(part), Product.second(part))
                      ⊆ Plane.openSegment(
                            Product.first(head), Product.second(head))
                  by Plane.splitSegmentAt_inside;
              Plane.segment(Product.first(part), Product.second(part))
                  ⊆ Plane.segment(Product.first(head), Product.second(head));
              Plane.openSegment(Product.first(part), Product.second(part))
                  ⊆ Plane.openSegment(
                        Product.first(head), Product.second(head));
              witness head
            }
          case part ∈ Plane.splitAllAt(cut, tail): {
              choose piece such that piece ∈ tail
                  ∧ Plane.segment(Product.first(part), Product.second(part))
                      ⊆ Plane.segment(Product.first(piece), Product.second(piece))
                  ∧ Plane.openSegment(Product.first(part), Product.second(part))
                      ⊆ Plane.openSegment(
                            Product.first(piece), Product.second(piece))
                  from IH;
              piece ∈ tail;
              piece ∈ List.prepend(Plane.Segment, head, tail);
              Plane.segment(Product.first(part), Product.second(part))
                  ⊆ Plane.segment(Product.first(piece), Product.second(piece));
              Plane.openSegment(Product.first(part), Product.second(part))
                  ⊆ Plane.openSegment(
                        Product.first(piece), Product.second(piece));
              witness piece
            }
        }
      }
  }

theorem Plane.splitAllAt_avoids (cut : Plane.Point)
        (pieces : List(Plane.Segment))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitAllAt(cut, pieces))
        : cut ∉ Plane.openSegment(Product.first(part), Product.second(part)) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done
    case pieces = List.prepend(head, tail) for some head, tail: {
        part ∈ List.append(Plane.splitSegmentAt(cut, head),
                           Plane.splitAllAt(cut, tail));
        part ∈ Plane.splitSegmentAt(cut, head)
            ∨ part ∈ Plane.splitAllAt(cut, tail)
            by List.member_append_invert;
        done by cases {
          case part ∈ Plane.splitSegmentAt(cut, head):
              done by Plane.splitSegmentAt_avoids
          case part ∈ Plane.splitAllAt(cut, tail):
              done by IH
        }
      }
  }

-- ----------------------------------------------------------------------
-- The three properties of a full subdivision.
--
-- Each is an induction on the POINT list with the pieces generalised, so
-- the hypothesis applies at the once-cut list rather than at the original.

theorem Plane.subdivide_ends_distinct (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.subdivide(pieces, points))
        : Product.first(part) ≠ Product.second(part) :=
  by induction on points with IH generalizing pieces {
    case points = List.empty: {
        part ∈ pieces;
        done by allDistinct
      }
    case points = List.prepend(head, tail) for some head, tail: {
        ∀ (piece : Plane.Segment). piece ∈ Plane.splitAllAt(head, pieces) →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ Plane.splitAllAt(head, pieces);
                 done by Plane.splitAllAt_ends_distinct };
        part ∈ Plane.subdivide(Plane.splitAllAt(head, pieces), tail);
        done by IH
      }
  }

-- Every piece of a subdivision lies inside a piece it came from, interior
-- in interior. This is what makes a cut permanent: nothing later can put a
-- removed point back into an interior.
theorem Plane.subdivide_inside (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (part : Plane.Segment) (isPart : part ∈ Plane.subdivide(pieces, points))
        : ∃ (piece : Plane.Segment). piece ∈ pieces
            ∧ Plane.segment(Product.first(part), Product.second(part))
                ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            ∧ Plane.openSegment(Product.first(part), Product.second(part))
                ⊆ Plane.openSegment(
                      Product.first(piece), Product.second(piece)) :=
  by induction on points with IH generalizing pieces {
    case points = List.empty: {
        part ∈ pieces;
        Plane.segment(Product.first(part), Product.second(part))
            ⊆ Plane.segment(Product.first(part), Product.second(part))
            by Set.subset.reflexive;
        Plane.openSegment(Product.first(part), Product.second(part))
            ⊆ Plane.openSegment(Product.first(part), Product.second(part))
            by Set.subset.reflexive;
        witness part
      }
    case points = List.prepend(head, tail) for some head, tail: {
        ∀ (piece : Plane.Segment). piece ∈ Plane.splitAllAt(head, pieces) →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ Plane.splitAllAt(head, pieces);
                 done by Plane.splitAllAt_ends_distinct };
        part ∈ Plane.subdivide(Plane.splitAllAt(head, pieces), tail);
        choose middle such that middle ∈ Plane.splitAllAt(head, pieces)
            ∧ Plane.segment(Product.first(part), Product.second(part))
                ⊆ Plane.segment(Product.first(middle), Product.second(middle))
            ∧ Plane.openSegment(Product.first(part), Product.second(part))
                ⊆ Plane.openSegment(
                      Product.first(middle), Product.second(middle))
            from IH;
        middle ∈ Plane.splitAllAt(head, pieces);
        Plane.segment(Product.first(part), Product.second(part))
            ⊆ Plane.segment(Product.first(middle), Product.second(middle));
        Plane.openSegment(Product.first(part), Product.second(part))
            ⊆ Plane.openSegment(
                  Product.first(middle), Product.second(middle));
        choose piece such that piece ∈ pieces
            ∧ Plane.segment(Product.first(middle), Product.second(middle))
                ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            ∧ Plane.openSegment(
                  Product.first(middle), Product.second(middle))
                ⊆ Plane.openSegment(
                      Product.first(piece), Product.second(piece))
            from Plane.splitAllAt_inside;
        piece ∈ pieces;
        Plane.segment(Product.first(middle), Product.second(middle))
            ⊆ Plane.segment(Product.first(piece), Product.second(piece));
        Plane.openSegment(Product.first(middle), Product.second(middle))
            ⊆ Plane.openSegment(
                  Product.first(piece), Product.second(piece));
        Plane.segment(Product.first(part), Product.second(part))
            ⊆ Plane.segment(Product.first(piece), Product.second(piece))
            by Set.subset.transitive;
        Plane.openSegment(Product.first(part), Product.second(part))
            ⊆ Plane.openSegment(Product.first(piece), Product.second(piece))
            by Set.subset.transitive;
        witness piece
      }
  }

-- And the point of the whole construction: after subdividing, no cut point
-- is interior to any piece.
theorem Plane.subdivide_avoids (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        (point : Plane.Point) (isCut : point ∈ points)
        (part : Plane.Segment) (isPart : part ∈ Plane.subdivide(pieces, points))
        : point ∉ Plane.openSegment(Product.first(part), Product.second(part)) :=
  by induction on points with IH generalizing pieces {
    case points = List.empty:
        done
    case points = List.prepend(head, tail) for some head, tail: {
        ∀ (piece : Plane.Segment). piece ∈ Plane.splitAllAt(head, pieces) →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ Plane.splitAllAt(head, pieces);
                 done by Plane.splitAllAt_ends_distinct };
        part ∈ Plane.subdivide(Plane.splitAllAt(head, pieces), tail);
        point = head ∨ point ∈ tail by List.member_prepend_invert;
        done by cases {
          case point = head: {
              -- `head` left every interior when it was cut at, and a later
              -- cut only shrinks interiors.
              choose middle such that middle ∈ Plane.splitAllAt(head, pieces)
                  ∧ Plane.segment(Product.first(part), Product.second(part))
                      ⊆ Plane.segment(Product.first(middle), Product.second(middle))
                  ∧ Plane.openSegment(Product.first(part), Product.second(part))
                      ⊆ Plane.openSegment(
                            Product.first(middle), Product.second(middle))
                  from Plane.subdivide_inside;
              middle ∈ Plane.splitAllAt(head, pieces);
              Plane.openSegment(Product.first(part), Product.second(part))
                  ⊆ Plane.openSegment(
                        Product.first(middle), Product.second(middle))
                  as partInMiddle;
              head ∉ Plane.openSegment(Product.first(middle), Product.second(middle))
                  by Plane.splitAllAt_avoids;
              suppose head ∈ Plane.openSegment(
                  Product.first(part), Product.second(part));
              head ∈ Plane.openSegment(
                  Product.first(middle), Product.second(middle))
                  by partInMiddle;
              done
            }
          case point ∈ tail:
              done by IH
        }
      }
  }

-- ----------------------------------------------------------------------
-- Where the pieces' ends come from.
--
-- The separation argument needs every end of every piece to be a cut point,
-- because that is what `subdivide_avoids` keeps out of every interior. A cut
-- introduces the point it cuts at and keeps the ends it found, so an end of
-- a piece of a subdivision is a cut point or an end of a piece it came from.
-- A construction that also cuts at every source end therefore has all of
-- them, which is `subdivide_ends_are_cuts` at the bottom of the section.

definition Plane.IsEndOf (point : Plane.Point) (piece : Plane.Segment) : Proposition :=
  point = Product.first(piece) ∨ point = Product.second(piece)

-- Every part of a split came from one of the pieces.
theorem Plane.splitAllAt_member_invert (cut : Plane.Point)
        (pieces : List(Plane.Segment))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitAllAt(cut, pieces))
        : ∃ (piece : Plane.Segment). piece ∈ pieces
            ∧ part ∈ Plane.splitSegmentAt(cut, piece) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done
    case pieces = List.prepend(head, tail) for some head, tail: {
        part ∈ List.append(Plane.splitSegmentAt(cut, head),
                           Plane.splitAllAt(cut, tail));
        part ∈ Plane.splitSegmentAt(cut, head)
            ∨ part ∈ Plane.splitAllAt(cut, tail)
            by List.member_append_invert;
        done by cases {
          case part ∈ Plane.splitSegmentAt(cut, head): {
              head ∈ List.prepend(Plane.Segment, head, tail);
              witness head
            }
          case part ∈ Plane.splitAllAt(cut, tail): {
              choose piece such that piece ∈ tail
                  ∧ part ∈ Plane.splitSegmentAt(cut, piece) from IH;
              piece ∈ tail;
              piece ∈ List.prepend(Plane.Segment, head, tail);
              part ∈ Plane.splitSegmentAt(cut, piece);
              witness piece
            }
        }
      }
  }

-- One cut: an end of a half is the cut point or an end it inherited.
theorem Plane.splitSegmentAt_ends (cut : Plane.Point) (piece : Plane.Segment)
        (part : Plane.Segment) (isPart : part ∈ Plane.splitSegmentAt(cut, piece))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, part))
        (notCut : point ≠ cut)
        : Plane.IsEndOf(point, piece) :=
  done by cases {
    case cut ∈ Plane.openSegment(
             Product.first(piece), Product.second(piece)) as interior: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment,
                  Product.make(Product.first(piece), cut),
                  List.prepend(Plane.Segment,
                      Product.make(cut, Product.second(piece)),
                      List.empty(Plane.Segment)))
            by Plane.splitSegmentAt_interior;
        part ∈ List.prepend(Plane.Segment,
                   Product.make(Product.first(piece), cut),
                   List.prepend(Plane.Segment,
                       Product.make(cut, Product.second(piece)),
                       List.empty(Plane.Segment)));
        part = Product.make(Product.first(piece), cut)
            ∨ part = Product.make(cut, Product.second(piece))
            by List.member_pair_invert;
        done by cases {
          case part = Product.make(Product.first(piece), cut) as isNearHalf: {
              Plane.IsEndOf(point, Product.make(Product.first(piece), cut))
                  by substituting isNearHalf;
              point = Product.first(piece) ∨ point = cut;
              point = Product.first(piece);
              done
            }
          case part = Product.make(cut, Product.second(piece)) as isFarHalf: {
              Plane.IsEndOf(point, Product.make(cut, Product.second(piece)))
                  by substituting isFarHalf;
              point = cut ∨ point = Product.second(piece);
              point = Product.second(piece);
              done
            }
        }
      }
    otherwise as outside: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))
            by Plane.splitSegmentAt_elsewhere;
        part ∈ List.prepend(Plane.Segment, piece, List.empty(Plane.Segment));
        part = piece by List.member_singleton_invert;
        done by substituting (part = piece)
      }
  }

theorem Plane.splitAllAt_ends (cut : Plane.Point) (pieces : List(Plane.Segment))
        (part : Plane.Segment) (isPart : part ∈ Plane.splitAllAt(cut, pieces))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, part))
        (notCut : point ≠ cut)
        : ∃ (piece : Plane.Segment). piece ∈ pieces
              ∧ Plane.IsEndOf(point, piece) := {
  choose piece such that piece ∈ pieces ∧ part ∈ Plane.splitSegmentAt(cut, piece)
      from Plane.splitAllAt_member_invert;
  piece ∈ pieces;
  part ∈ Plane.splitSegmentAt(cut, piece);
  Plane.IsEndOf(point, piece) by Plane.splitSegmentAt_ends;
  witness piece
}

-- An end of a piece of a subdivision that is not one of the cut points was
-- an end all along. The cut points are consumed one at a time, so each step
-- discards the one point it cut at and passes the question on.
theorem Plane.subdivide_ends (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (part : Plane.Segment) (isPart : part ∈ Plane.subdivide(pieces, points))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, part))
        (noCut : point ∉ points)
        : ∃ (piece : Plane.Segment). piece ∈ pieces
              ∧ Plane.IsEndOf(point, piece) :=
  by induction on points with IH generalizing pieces {
    case points = List.empty: {
        part ∈ pieces;
        witness part
      }
    case points = List.prepend(head, tail) for some head, tail: {
        point ≠ head
            by { suppose point = head as isHead;
                 point ∈ List.prepend(Plane.Point, head, tail) by substituting isHead;
                 done };
        point ∉ tail
            by { suppose point ∈ tail;
                 point ∈ List.prepend(Plane.Point, head, tail);
                 done };
        part ∈ Plane.subdivide(Plane.splitAllAt(head, pieces), tail);
        choose middle such that middle ∈ Plane.splitAllAt(head, pieces)
            ∧ Plane.IsEndOf(point, middle) from IH;
        middle ∈ Plane.splitAllAt(head, pieces);
        Plane.IsEndOf(point, middle);
        done by Plane.splitAllAt_ends
      }
  }

-- So a construction that cuts at every source end leaves every end of every
-- piece a cut point — which is what keeps it out of every interior.
theorem Plane.subdivide_ends_are_cuts (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (sourceEndsCut : ∀ (piece : Plane.Segment). piece ∈ pieces →
            ∀ (point : Plane.Point). Plane.IsEndOf(point, piece) → point ∈ points)
        (part : Plane.Segment) (isPart : part ∈ Plane.subdivide(pieces, points))
        (point : Plane.Point) (isEnd : Plane.IsEndOf(point, part))
        : point ∈ points := {
  suppose point ∉ points for contradiction;
  choose piece such that piece ∈ pieces ∧ Plane.IsEndOf(point, piece)
      from Plane.subdivide_ends;
  piece ∈ pieces;
  Plane.IsEndOf(point, piece);
  point ∈ points by sourceEndsCut;
  done
}

-- ----------------------------------------------------------------------
-- The cover.
--
-- Cutting loses nothing: the pieces occupy exactly what they came from. This
-- is the fourth property, and the one that makes the overlay's point set
-- equal to the union of the graphs it was built from.

definition Plane.piecesCover (pieces : List(Plane.Segment)) : Set(Plane.Point) :=
  List.unionOver(
      (piece : Plane.Segment) ↦
          Plane.segment(Product.first(piece), Product.second(piece)),
      pieces)

theorem Plane.splitSegmentAt_covers (cut : Plane.Point) (piece : Plane.Segment)
        (distinct : Product.first(piece) ≠ Product.second(piece))
        : Plane.piecesCover(Plane.splitSegmentAt(cut, piece))
          = Plane.segment(Product.first(piece), Product.second(piece)) :=
  done by cases {
    case cut ∈ Plane.openSegment(
             Product.first(piece), Product.second(piece)) as interior: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment,
                  Product.make(Product.first(piece), cut),
                  List.prepend(Plane.Segment,
                      Product.make(cut, Product.second(piece)),
                      List.empty(Plane.Segment)))
            by Plane.splitSegmentAt_interior;
        Plane.segment(Product.first(piece), cut)
            ∪ Plane.segment(cut, Product.second(piece))
            = Plane.segment(Product.first(piece), Product.second(piece))
            by Plane.segment_split;
        Plane.piecesCover(Plane.splitSegmentAt(cut, piece))
           = Plane.segment(Product.first(piece), cut)
                 ∪ (Plane.segment(cut, Product.second(piece))
                        ∪ Set.empty(Plane.Point))
           = Plane.segment(Product.first(piece), cut)
                 ∪ Plane.segment(cut, Product.second(piece))
                 by Set.union_empty
           = Plane.segment(Product.first(piece), Product.second(piece))
                 by Plane.segment_split;
        done
      }
    otherwise: {
        Plane.splitSegmentAt(cut, piece)
            = List.prepend(Plane.Segment, piece, List.empty(Plane.Segment))
            by Plane.splitSegmentAt_elsewhere;
        Plane.piecesCover(Plane.splitSegmentAt(cut, piece))
           = Plane.segment(Product.first(piece), Product.second(piece))
                 ∪ Set.empty(Plane.Point)
           = Plane.segment(Product.first(piece), Product.second(piece))
                 by Set.union_empty;
        done
      }
  }

theorem Plane.splitAllAt_covers (cut : Plane.Point) (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        : Plane.piecesCover(Plane.splitAllAt(cut, pieces))
          = Plane.piecesCover(pieces) :=
  by induction on pieces with IH {
    case pieces = List.empty:
        done
    case pieces = List.prepend(head, tail) for some head, tail: {
        head ∈ List.prepend(Plane.Segment, head, tail);
        Product.first(head) ≠ Product.second(head) by allDistinct;
        ∀ (piece : Plane.Segment). piece ∈ tail →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ tail;
                 piece ∈ List.prepend(Plane.Segment, head, tail);
                 done by allDistinct };
        Plane.piecesCover(Plane.splitSegmentAt(cut, head))
            = Plane.segment(Product.first(head), Product.second(head))
            by Plane.splitSegmentAt_covers;
        Plane.piecesCover(Plane.splitAllAt(cut, tail)) = Plane.piecesCover(tail) by IH;
        Plane.piecesCover(Plane.splitAllAt(cut, List.prepend(Plane.Segment, head, tail)))
           = Plane.piecesCover(List.append(Plane.splitSegmentAt(cut, head),
                                           Plane.splitAllAt(cut, tail)))
           = Plane.piecesCover(Plane.splitSegmentAt(cut, head))
                 ∪ Plane.piecesCover(Plane.splitAllAt(cut, tail))
                 by List.unionOver_append
           = Plane.segment(Product.first(head), Product.second(head))
                 ∪ Plane.piecesCover(Plane.splitAllAt(cut, tail))
                 by Plane.splitSegmentAt_covers
           = Plane.segment(Product.first(head), Product.second(head))
                 ∪ Plane.piecesCover(tail) by IH
           = Plane.piecesCover(List.prepend(Plane.Segment, head, tail));
        done
      }
  }

theorem Plane.subdivide_covers (points : List(Plane.Point))
        (pieces : List(Plane.Segment))
        (allDistinct : ∀ (piece : Plane.Segment). piece ∈ pieces →
            Product.first(piece) ≠ Product.second(piece))
        : Plane.piecesCover(Plane.subdivide(pieces, points))
          = Plane.piecesCover(pieces) :=
  by induction on points with IH generalizing pieces {
    case points = List.empty:
        done
    case points = List.prepend(head, tail) for some head, tail: {
        ∀ (piece : Plane.Segment). piece ∈ Plane.splitAllAt(head, pieces) →
            Product.first(piece) ≠ Product.second(piece)
            by { take piece : Plane.Segment;
                 suppose piece ∈ Plane.splitAllAt(head, pieces);
                 done by Plane.splitAllAt_ends_distinct };
        Plane.piecesCover(Plane.splitAllAt(head, pieces)) = Plane.piecesCover(pieces)
            by Plane.splitAllAt_covers;
        Plane.piecesCover(Plane.subdivide(Plane.splitAllAt(head, pieces), tail))
            = Plane.piecesCover(Plane.splitAllAt(head, pieces)) by IH;
        Plane.piecesCover(Plane.subdivide(pieces, List.prepend(Plane.Point, head, tail)))
           = Plane.piecesCover(Plane.subdivide(Plane.splitAllAt(head, pieces), tail))
           = Plane.piecesCover(Plane.splitAllAt(head, pieces)) by IH
           = Plane.piecesCover(pieces) by Plane.splitAllAt_covers;
        done
      }
  }
