-- Plane/compactness.math
--
-- Compactness in the plane, in its sequential form, and the Heine--Borel
-- characterisation: a set is compact exactly when it is closed and
-- bounded.
--
-- This is where `Logic.countable_choice` earns its place. Every argument
-- below that starts from a point and produces a sequence — a point of the
-- closure is a limit of points of the set; an unbounded set has points
-- escaping to infinity — is a choice of one witness per tolerance, and
-- nothing distinguishes the witnesses. The tolerances themselves are the
-- harmonic terms, so "for each n pick a point within 1/(1+n)" is the
-- shape every one of them takes.

module Plane.compactness

import axioms
import Logic.basics
import Logic.exists
import Logic.functions
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.absolute_value
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.topology
import Metric.continuity
import Metric.sequence
import Metric.compactness
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.metric
import Plane.topology
import Plane.sequence
import Plane.compact

-- ----------------------------------------------------------------------
-- Compactness and closure — the generic metric notions, at the plane.

definition Plane.IsCompact (region : Set(Plane.Point)) : Proposition :=
  MetricSpace.IsCompact(region)

definition Plane.Closure (region : Set(Plane.Point)) : Set(Plane.Point) :=
  MetricSpace.Closure(region)

theorem Plane.Closure.meets_every_ball (region : Set(Plane.Point))
        (x : Plane.Point) (inClosure : x ∈ Plane.Closure(region))
        (radius : ℝ) (radiusPositive : radius > 0)
        : ∃ (y : Plane.Point). y ∈ region ∧ Plane.distance(x, y) < radius :=
  done by MetricSpace.Closure.meets_every_ball

theorem Plane.Closure.of_meets_every_ball (region : Set(Plane.Point))
        (x : Plane.Point)
        (meetsEveryBall : ∀ (radius : ℝ). radius > 0 →
            ∃ (y : Plane.Point). y ∈ region ∧ Plane.distance(x, y) < radius)
        : x ∈ Plane.Closure(region) :=
  done by MetricSpace.Closure.of_meets_every_ball

theorem Plane.limit_in_Closure (region : Set(Plane.Point))
        (s : ℕ → Plane.Point) (inside : ∀ (m : ℕ). s(m) ∈ region)
        (limit : Plane.Point)
        (converges : Plane.SequenceConverges(s, limit))
        : limit ∈ Plane.Closure(region) :=
  done by MetricSpace.limit_in_Closure

theorem Plane.sequence_to_Closure_point (region : Set(Plane.Point))
        (x : Plane.Point) (inClosure : x ∈ Plane.Closure(region))
        : ∃ (s : ℕ → Plane.Point).
            (∀ (m : ℕ). s(m) ∈ region) ∧ Plane.SequenceConverges(s, x) :=
  done by MetricSpace.sequence_to_Closure_point

-- ----------------------------------------------------------------------
-- Heine--Borel. Closed is spelled `Closure(region) ⊆ region`: the
-- sequential form, which is what both directions actually use. Only the
-- converse below is about the plane in particular — it is the one that
-- needs Bolzano--Weierstrass.

theorem Plane.IsCompact.Closure_subset (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        : Plane.Closure(region) ⊆ region :=
  done by MetricSpace.IsCompact.Closure_subset

-- The converse direction, and the one the blueprint uses to GET
-- compactness: a closed bounded set is compact. Bolzano--Weierstrass
-- supplies the subsequence; closedness puts its limit back in the set.
theorem Plane.compact_of_closed_bounded (region : Set(Plane.Point))
        (closed : Plane.Closure(region) ⊆ region)
        (bounded : Plane.IsBounded(region))
        : Plane.IsCompact(region) := {
  take s : ℕ → Plane.Point;
  suppose ∀ (m : ℕ). s(m) ∈ region as inside;
  choose centre such that
      ∃ (bound : ℝ). ∀ (x : Plane.Point). x ∈ region →
          Plane.distance(centre, x) ≤ bound
      as boundExists from bounded;
  choose bound such that
      ∀ (x : Plane.Point). x ∈ region → Plane.distance(centre, x) ≤ bound
      as insideBall from boundExists;
  Plane.SequenceIsBounded(s)
      by { witness centre with { witness bound with
             (m : ℕ) ↦ insideBall(s(m), inside(m)) } };
  choose index : ℕ → ℕ, limit : Plane.Point such that
      Natural.IsStrictlyIncreasing(index)
      ∧ Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      from Plane.bolzano_weierstrass;
  Natural.IsStrictlyIncreasing(index)
      by Plane.SubsequenceConverges.increasing;
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      by Plane.SubsequenceConverges.converges;
  limit ∈ Plane.Closure(region)
      by Plane.limit_in_Closure(
          s := (k : ℕ) ↦ s(index(k)),
          inside := (k : ℕ) ↦ inside(index(k)));
  limit ∈ region by closed;
  witness index with { witness limit }
}

-- The remaining direction, so the characterisation is an equivalence: a
-- compact set is bounded. Boundedness is measured from somewhere, and a
-- metric space has no distinguished point — the plane does, so this is
-- where the generic theorem gets its centre.
theorem Plane.IsCompact.bounded (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        : Plane.IsBounded(region) :=
  done by MetricSpace.IsCompact.bounded(centre := Plane.Point.make(0, 0))

-- ----------------------------------------------------------------------
-- Continuous images.

theorem Plane.ContinuousAt.along_sequence
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        (x : Plane.Point) (continuous : Plane.ContinuousAt(f, region, x))
        (s : ℕ → Plane.Point) (inside : ∀ (m : ℕ). s(m) ∈ region)
        (converges : Plane.SequenceConverges(s, x))
        : Plane.SequenceConverges((m : ℕ) ↦ f(s(m)), f(x)) :=
  done by MetricSpace.ContinuousWithinAt.along_sequence

definition Plane.imageSet
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        : Set(Plane.Point) :=
  MetricSpace.imageSet(f, region)

theorem Plane.imageSet_union (f : Plane.Point → Plane.Point)
        (left right : Set(Plane.Point))
        : Plane.imageSet(f, left ∪ right)
              = Plane.imageSet(f, left) ∪ Plane.imageSet(f, right) :=
  done by MetricSpace.imageSet_union

theorem Plane.IsCompact.image
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (continuous : Plane.ContinuousOn(f, region))
        : Plane.IsCompact(Plane.imageSet(f, region)) :=
  done by MetricSpace.IsCompact.image
