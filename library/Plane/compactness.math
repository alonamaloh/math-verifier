-- Plane/compactness.math
--
-- Compactness in the plane, in its sequential form, and the Heine--Borel
-- characterisation: a set is compact exactly when it is closed and
-- bounded.
--
-- This is where `Logic.countable_choice` earns its place. Every argument
-- below that starts from a point and produces a sequence — a point of the
-- closure is a limit of points of the set; an unbounded set has points
-- escaping to infinity — is a choice of one witness per tolerance, and
-- nothing distinguishes the witnesses. The tolerances themselves are the
-- harmonic terms, so "for each n pick a point within 1/(1+n)" is the
-- shape every one of them takes.

module Plane.compactness

import axioms
import Logic.basics
import Logic.exists
import Logic.functions
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.absolute_value
import Real.harmonic_series
import Real.archimedean
import Plane.vector
import Plane.point
import Plane.norm
import Plane.segment
import Plane.topology
import Plane.sequence
import Plane.compact

-- ----------------------------------------------------------------------
-- Compactness.

definition Plane.IsCompact (region : Set(Plane.Point)) : Proposition :=
  ∀ (s : ℕ → Plane.Point). (∀ (m : ℕ). s(m) ∈ region) →
    ∃ (index : ℕ → ℕ). ∃ (limit : Plane.Point).
      limit ∈ region ∧ Plane.SubsequenceConverges(s, index, limit)

-- The closure of a set, taken in the whole plane.
definition Plane.Closure (region : Set(Plane.Point)) : Set(Plane.Point) :=
  Plane.ClosureIn(region, Set.universe(Plane.Point))

-- ----------------------------------------------------------------------
-- Closure and limits. The two directions are asymmetric: a limit of
-- points of the set lands in the closure by definition, while producing
-- the sequence from a point of the closure is a choice.

theorem Plane.limit_in_Closure (region : Set(Plane.Point))
        (s : ℕ → Plane.Point) (inside : ∀ (m : ℕ). s(m) ∈ region)
        (limit : Plane.Point)
        (converges : Plane.SequenceConverges(s, limit))
        : limit ∈ Plane.Closure(region) := {
  limit ∈ Set.universe(Plane.Point) by Set.member_universe;
  ∀ (radius : ℝ). 0 < radius →
      ∃ (y : Plane.Point). y ∈ region ∧ Plane.distance(limit, y) < radius
      by (radius : ℝ) (radiusPositive : 0 < radius) ↦ {
        choose threshold such that
            ∀ (m : ℕ). threshold ≤ m → Plane.distance(limit, s(m)) < radius
            as closeBeyond
            from converges(radius, { 0 < radius });
        s(threshold) ∈ region by inside(threshold);
        Plane.distance(limit, s(threshold)) < radius
            by closeBeyond(threshold, { threshold ≤ threshold });
        witness s(threshold) with done
      };
  done
}

-- A point of the closure is the limit of a sequence from the set. For
-- each `n` the closure offers a point within `1/(1+n)`; countable choice
-- turns that family of nonempty options into one sequence.
theorem Plane.sequence_to_Closure_point (region : Set(Plane.Point))
        (x : Plane.Point) (inClosure : x ∈ Plane.Closure(region))
        : ∃ (s : ℕ → Plane.Point).
            (∀ (m : ℕ). s(m) ∈ region) ∧ Plane.SequenceConverges(s, x) := {
  ∀ (radius : ℝ). 0 < radius →
      ∃ (y : Plane.Point). y ∈ region ∧ Plane.distance(x, y) < radius
      as meetsEveryBall;
  ∀ (n : ℕ). ∃ (y : Plane.Point).
      y ∈ region ∧ Plane.distance(x, y) < Real.harmonic_term(n)
      by (n : ℕ) ↦ {
        Real.harmonic_term(n) > 0 by Real.divide_positive;
        done by meetsEveryBall(
            Real.harmonic_term(n), { 0 < Real.harmonic_term(n) })
      }
      as closeAtEveryScale;
  ∃ (chosen : ℕ → Plane.Point). ∀ (n : ℕ).
      chosen(n) ∈ region ∧ Plane.distance(x, chosen(n)) < Real.harmonic_term(n)
      by Logic.countable_choice(
          Plane.Point,
          (n : ℕ) (y : Plane.Point) ↦
              y ∈ region ∧ Plane.distance(x, y) < Real.harmonic_term(n),
          closeAtEveryScale)
      as choiceMade;
  choose s such that
      ∀ (n : ℕ). s(n) ∈ region
          ∧ Plane.distance(x, s(n)) < Real.harmonic_term(n)
      as chosenClose from choiceMade;
  ∀ (m : ℕ). s(m) ∈ region
      by (m : ℕ) ↦ { s(m) ∈ region ∧ Plane.distance(x, s(m))
                         < Real.harmonic_term(m) by chosenClose(m);
                     done };
  Plane.SequenceConverges(s, x)
      by (tolerance : ℝ) (tolerancePositive : tolerance > 0) ↦ {
        choose threshold such that Real.harmonic_term(threshold) < tolerance
            from Real.exists_harmonic_term_below(tolerance, tolerancePositive);
        witness threshold with
            (m : ℕ) (beyond : threshold ≤ m) ↦ {
              s(m) ∈ region ∧ Plane.distance(x, s(m))
                  < Real.harmonic_term(m) by chosenClose(m);
              Plane.distance(x, s(m))
                 < Real.harmonic_term(m)
                 ≤ Real.harmonic_term(threshold)
                       by Real.harmonic_term_antitone
                 < tolerance;
              done
            }
      };
  witness s with done
}

-- ----------------------------------------------------------------------
-- Heine--Borel. Closed is spelled `Closure(region) ⊆ region`: the
-- sequential form, which is what both directions actually use.

theorem Plane.IsCompact.Closure_subset (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        : Plane.Closure(region) ⊆ region := {
  take x : Plane.Point;
  suppose x ∈ Plane.Closure(region) as inClosure;
  choose s such that
      (∀ (m : ℕ). s(m) ∈ region) ∧ Plane.SequenceConverges(s, x)
      from Plane.sequence_to_Closure_point(region, x, inClosure);
  ∀ (m : ℕ). s(m) ∈ region as inside;
  Plane.SequenceConverges(s, x) as toX;
  choose index, limit such that
      limit ∈ region ∧ Plane.SubsequenceConverges(s, index, limit)
      from compact(s, inside);
  Natural.IsStrictlyIncreasing(index)
      by Plane.SubsequenceConverges.increasing as increasing;
  limit ∈ region;
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      by Plane.SubsequenceConverges.converges as toLimit;
  -- The thinned sequence still converges to `x`, so the two limits agree.
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), x)
      by Plane.SequenceConverges.subsequence(s, x, index, toX, increasing);
  x = limit
      by Plane.SequenceConverges.unique(
          (k : ℕ) ↦ s(index(k)), x, limit,
          { Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), x) }, toLimit);
  done
}

-- The converse direction, and the one the blueprint uses to GET
-- compactness: a closed bounded set is compact. Bolzano--Weierstrass
-- supplies the subsequence; closedness puts its limit back in the set.
theorem Plane.compact_of_closed_bounded (region : Set(Plane.Point))
        (closed : Plane.Closure(region) ⊆ region)
        (bounded : Plane.IsBounded(region))
        : Plane.IsCompact(region) := {
  take s : ℕ → Plane.Point;
  suppose ∀ (m : ℕ). s(m) ∈ region as inside;
  choose centre such that
      ∃ (bound : ℝ). ∀ (x : Plane.Point). x ∈ region →
          Plane.distance(centre, x) ≤ bound
      as boundExists from bounded;
  choose bound such that
      ∀ (x : Plane.Point). x ∈ region → Plane.distance(centre, x) ≤ bound
      as insideBall from boundExists;
  Plane.SequenceIsBounded(s)
      by { witness centre with { witness bound with
             (m : ℕ) ↦ insideBall(s(m), inside(m)) } };
  choose index, limit such that
      Natural.IsStrictlyIncreasing(index)
      ∧ Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      from Plane.bolzano_weierstrass(s, { Plane.SequenceIsBounded(s) });
  Natural.IsStrictlyIncreasing(index)
      by Plane.SubsequenceConverges.increasing;
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      by Plane.SubsequenceConverges.converges as converges;
  limit ∈ Plane.Closure(region)
      by Plane.limit_in_Closure(
          region, (k : ℕ) ↦ s(index(k)),
          (k : ℕ) ↦ inside(index(k)), limit, converges);
  limit ∈ region by closed(limit, { limit ∈ Plane.Closure(region) });
  witness index with { witness limit with done }
}

-- The remaining direction, so the characterisation is an equivalence: a
-- compact set is bounded. If it were not, some point of it would escape
-- every distance from a fixed centre, and countable choice assembles
-- those escapes into a sequence. Compactness thins it to a convergent
-- one — but a convergent sequence stays within one unit of its limit
-- past some threshold, while the escapes pass every natural.
-- "The region is not bounded, so past every natural lies a point of it."
-- The block is what pushing the negation through the quantifiers costs;
-- quarantined here so the theorem below can just say the sentence.
theorem Plane.point_past_every_scale (region : Set(Plane.Point))
        (centre : Plane.Point)
        (unbounded : ¬Plane.IsBounded(region))
        (n : ℕ)
        : ∃ (x : Plane.Point).
            x ∈ region ∧ (1 + n : ℝ) < Plane.distance(centre, x) := {
  suppose ¬(∃ (x : Plane.Point).
      x ∈ region ∧ (1 + n : ℝ) < Plane.distance(centre, x))
      as noneBeyond for contradiction {
    ∀ (x : Plane.Point). x ∈ region →
        Plane.distance(centre, x) ≤ (1 + n : ℝ)
        by (x : Plane.Point) (inRegion : x ∈ region) ↦ {
          suppose ¬(Plane.distance(centre, x) ≤ (1 + n : ℝ))
              as far for contradiction {
            (1 + n : ℝ) < Plane.distance(centre, x)
                by Real.LessThan_of_not_LessOrEqual;
            ∃ (x : Plane.Point). x ∈ region
                ∧ (1 + n : ℝ) < Plane.distance(centre, x)
                by { witness x with done };
            done
          };
          done
        };
    Plane.IsBounded(region)
        by { witness centre with { witness (1 + n : ℝ) with done } };
    done
  };
  done
}

theorem Plane.IsCompact.bounded (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        : Plane.IsBounded(region) := {
  let centre : Plane.Point := Plane.Point.make(0, 0);
  suppose ¬Plane.IsBounded(region) as unbounded for contradiction {
    -- Past every natural, some point of the region.
    ∀ (n : ℕ). ∃ (x : Plane.Point).
        x ∈ region ∧ (1 + n : ℝ) < Plane.distance(centre, x)
        by (n : ℕ) ↦
             Plane.point_past_every_scale(region, centre, unbounded, n)
        as escapes;
    choose s such that
        ∀ (n : ℕ). s(n) ∈ region
            ∧ (1 + n : ℝ) < Plane.distance(centre, s(n))
        as escapesAt
        from Logic.countable_choice(
            Plane.Point,
            (n : ℕ) (x : Plane.Point) ↦
                x ∈ region ∧ (1 + n : ℝ) < Plane.distance(centre, x),
            escapes);
    ∀ (m : ℕ). s(m) ∈ region
        by (m : ℕ) ↦ { s(m) ∈ region ∧ (1 + m : ℝ)
                           < Plane.distance(centre, s(m)) by escapesAt(m);
                       done }
        as inside;
    choose index, limit such that
        limit ∈ region

            ∧ Plane.SubsequenceConverges(s, index, limit)
        from compact(s, inside);
    Natural.IsStrictlyIncreasing(index)
        by Plane.SubsequenceConverges.increasing;
    Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
        by Plane.SubsequenceConverges.converges as converges;
    (0 : ℝ) < 1;
    choose threshold such that
        ∀ (k : ℕ). threshold ≤ k →
            Plane.distance(limit, s(index(k))) < 1
        as closeBeyond from converges(1, { (0 : ℝ) < 1 });
    -- One index past both the convergence threshold and any natural
    -- exceeding `distance(centre, limit) + 1` is a contradiction.
    choose escape such that
        Plane.distance(centre, limit) + 1 < (1 + escape : ℝ)
        from Real.exists_natural_above(Plane.distance(centre, limit) + 1);
    let far : ℕ := Natural.maximum(threshold, escape);
    threshold ≤ far;
    escape ≤ far;
    Plane.distance(limit, s(index(far))) < 1 by closeBeyond(far, { threshold ≤ far });
    s(index(far)) ∈ region ∧ (1 + index(far) : ℝ)
        < Plane.distance(centre, s(index(far))) by escapesAt(index(far));
    (1 + index(far) : ℝ) < Plane.distance(centre, s(index(far)));
    far ≤ index(far) by Natural.IsStrictlyIncreasing.LessOrEqual;
    escape ≤ index(far);
    (1 + escape : ℝ) ≤ (1 + index(far) : ℝ);
    Plane.distance(centre, s(index(far)))
        ≤ Plane.distance(centre, limit) + Plane.distance(limit, s(index(far)))
        by Plane.distance_triangle;
    Plane.distance(centre, limit) + 1
       < (1 + escape : ℝ)
       ≤ (1 + index(far) : ℝ)
       < Plane.distance(centre, s(index(far)))
       ≤ Plane.distance(centre, limit) + Plane.distance(limit, s(index(far)))
       < Plane.distance(centre, limit) + 1;
    done
  };
  done
}

-- ----------------------------------------------------------------------
-- Continuous images.

-- Point-valued continuity is sequential too, by the same three lines as
-- the real-valued case.
theorem Plane.ContinuousAt.along_sequence
        (f : Plane.Point → Plane.Point) (carrier : Set(Plane.Point))
        (x : Plane.Point) (continuous : Plane.ContinuousAt(f, carrier, x))
        (s : ℕ → Plane.Point) (inside : ∀ (m : ℕ). s(m) ∈ carrier)
        (converges : Plane.SequenceConverges(s, x))
        : Plane.SequenceConverges((m : ℕ) ↦ f(s(m)), f(x)) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that
      0 < nearness ∧
      ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness →
          Plane.distance(f(x), f(y)) < tolerance
      from continuous(tolerance, { 0 < tolerance });
  0 < nearness as nearnessPositive;
  ∀ (y : Plane.Point). y ∈ carrier →
      Plane.distance(x, y) < nearness →
        Plane.distance(f(x), f(y)) < tolerance
      as imagesClose;
  choose threshold such that
      ∀ (m : ℕ). threshold ≤ m → Plane.distance(x, s(m)) < nearness
      as closeBeyond from converges(nearness, nearnessPositive);
  witness threshold with
      (m : ℕ) (beyond : threshold ≤ m) ↦ {
        Plane.distance(x, s(m)) < nearness
            by closeBeyond(m, { threshold ≤ m });
        done by imagesClose(s(m), inside(m),
            { Plane.distance(x, s(m)) < nearness })
      }
}

definition Plane.imageSet
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        : Set(Plane.Point) :=
  (y : Plane.Point) ↦ ∃ (x : Plane.Point). x ∈ region ∧ f(x) = y

-- The continuous image of a compact set is compact. A sequence in the
-- image has preimages — countable choice again — which compactness thins
-- to a convergent one; continuity carries that convergence forward.
theorem Plane.IsCompact.image
        (f : Plane.Point → Plane.Point) (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (continuous : Plane.ContinuousOn(f, region))
        : Plane.IsCompact(Plane.imageSet(f, region)) := {
  take t : ℕ → Plane.Point;
  suppose ∀ (m : ℕ). t(m) ∈ Plane.imageSet(f, region) as inImage;
  ∀ (n : ℕ). ∃ (x : Plane.Point). x ∈ region ∧ f(x) = t(n)
      by (n : ℕ) ↦ inImage(n)
      as preimages;
  choose s such that ∀ (n : ℕ). s(n) ∈ region ∧ f(s(n)) = t(n)
      as chosen
      from Logic.countable_choice(
          Plane.Point,
          (n : ℕ) (x : Plane.Point) ↦ x ∈ region ∧ f(x) = t(n),
          preimages);
  ∀ (m : ℕ). s(m) ∈ region
      by (m : ℕ) ↦ { s(m) ∈ region ∧ f(s(m)) = t(m) by chosen(m); done }
      as inside;
  choose index, limit such that
      limit ∈ region ∧ Plane.SubsequenceConverges(s, index, limit)
      from compact(s, inside);
  Natural.IsStrictlyIncreasing(index)
      by Plane.SubsequenceConverges.increasing;
  limit ∈ region as limitInside;
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
      by Plane.SubsequenceConverges.converges as converges;
  f(limit) ∈ Plane.imageSet(f, region) by { witness limit with done };
  Plane.SequenceConverges((k : ℕ) ↦ f(s(index(k))), f(limit))
      by Plane.ContinuousAt.along_sequence(
          f, region, limit, continuous(limit, limitInside),
          (k : ℕ) ↦ s(index(k)), (k : ℕ) ↦ inside(index(k)), converges);
  ∀ (k : ℕ). f(s(index(k))) = t(index(k))
      by (k : ℕ) ↦ { s(index(k)) ∈ region ∧ f(s(index(k))) = t(index(k))
                         by chosen(index(k));
                     done };
  ((k : ℕ) ↦ f(s(index(k)))) = ((k : ℕ) ↦ t(index(k)))
      by Function.extensionality;
  Plane.SequenceConverges((k : ℕ) ↦ t(index(k)), f(limit));
  witness index with { witness f(limit) with done }
}
