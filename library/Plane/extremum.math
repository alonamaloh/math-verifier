-- Plane/extremum.math
--
-- A continuous real function on a nonempty compact set attains its
-- bounds.
--
-- The proof is the one a textbook gives, and every step of it is now
-- available. The image is nonempty and bounded above, so it has a
-- supremum; the supremum is approached, so countable choice gives a
-- sequence of points whose values climb to it; compactness thins that
-- sequence to a convergent one; and continuity carries the limit of the
-- points to the limit of the values, which is the supremum. So the
-- supremum is attained, and is therefore a maximum.
--
-- The minimum is the maximum of the negated function. That is cheaper
-- than repeating the argument, and it is what a reader expects.

module Plane.extremum

import axioms
import Logic.basics
import Logic.exists
import Equality.basics
import Set.basics
import Set.algebra
import Natural.basics
import Natural.order
import Natural.subsequence
import Real.interface
import Real.order
import Real.order_field
import Real.absolute_value
import Real.absolute_value_order
import Real.convergence
import Real.supremum
import Real.harmonic_series
import Real.archimedean
import Metric.space
import Metric.real
import Metric.continuity
import Metric.separation
import Metric.uniform
import Plane.vector
import Plane.point
import Plane.norm
import Plane.sequence
import Plane.compact
import Plane.compactness
import Plane.separation

-- ----------------------------------------------------------------------
-- Real-valued continuity. Not a second notion: it is the generic
-- metric-space continuity of `Metric/continuity.math` with ℝ as the
-- target space, where the target distance IS `abs` of the difference.

definition Plane.RealContinuousAt
        (f : Plane.Point → ℝ) (carrier : Set(Plane.Point))
        (x : Plane.Point) : Proposition :=
  MetricSpace.ContinuousAt(f, carrier, x)

definition Plane.RealContinuousOn
        (f : Plane.Point → ℝ) (carrier : Set(Plane.Point)) : Proposition :=
  MetricSpace.ContinuousOn(f, carrier)

theorem Plane.RealContinuousOn.negate
        (f : Plane.Point → ℝ) (carrier : Set(Plane.Point))
        (continuous : Plane.RealContinuousOn(f, carrier))
        : Plane.RealContinuousOn((x : Plane.Point) ↦ -f(x), carrier) := {
  take x : Plane.Point;
  suppose x ∈ carrier as inCarrier;
  take tolerance : ℝ;
  suppose 0 < tolerance;
  choose nearness such that
      0 < nearness ∧
      ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness → abs(f(y) - f(x)) < tolerance
      from continuous;
  0 < nearness;
  ∀ (y : Plane.Point). y ∈ carrier →
      Plane.distance(x, y) < nearness → abs(f(y) - f(x)) < tolerance
      as valuesClose;
  witness nearness with {
    0 < nearness;
    ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness → abs(-f(y) - -f(x)) < tolerance
        by (y : Plane.Point) (inCarrierY : y ∈ carrier)
           (near : Plane.distance(x, y) < nearness) ↦ {
             abs(f(y) - f(x)) < tolerance by valuesClose;
             -f(x) - -f(y) = -(f(x) - f(y)) by ring;
             abs(-f(y) - -f(x))
                = abs(-(f(x) - f(y)))
                = abs(f(y) - f(x)) by Real.absolute_value_negate
                < tolerance;
             done
           };
    done
  }
}

-- Continuity is sequential: a sequence in the carrier converging to a
-- point of it has its values converging to the value there.
theorem Plane.RealContinuousAt.along_sequence
        (f : Plane.Point → ℝ) (carrier : Set(Plane.Point))
        (x : Plane.Point) (continuous : Plane.RealContinuousAt(f, carrier, x))
        (s : ℕ → Plane.Point) (inside : ∀ (m : ℕ). s(m) ∈ carrier)
        (converges : Plane.SequenceConverges(s, x))
        : Real.SequenceConverges((m : ℕ) ↦ f(s(m)), f(x)) := {
  take tolerance : ℝ;
  suppose tolerance > 0;
  choose nearness such that
      0 < nearness ∧
      ∀ (y : Plane.Point). y ∈ carrier →
        Plane.distance(x, y) < nearness → abs(f(y) - f(x)) < tolerance
      from continuous;
  0 < nearness as nearnessPositive;
  ∀ (y : Plane.Point). y ∈ carrier →
      Plane.distance(x, y) < nearness → abs(f(y) - f(x)) < tolerance
      as valuesClose;
  choose threshold such that
      ∀ (m : ℕ). threshold ≤ m → Plane.distance(x, s(m)) < nearness
      as closeBeyond from converges;
  witness threshold with
      (m : ℕ) (beyond : threshold ≤ m) ↦ {
        Plane.distance(x, s(m)) < nearness by closeBeyond;
        s(m) ∈ carrier by inside;
        abs(f(x) - f(s(m))) < tolerance by valuesClose;
        abs(f(s(m)) - f(x))
           = abs(f(x) - f(s(m))) by Real.absolute_value_subtract_swap
           < tolerance;
        done
      }
}

-- ----------------------------------------------------------------------
-- The image, as a subset of the line.

definition Plane.image (f : Plane.Point → ℝ) (region : Set(Plane.Point))
        : Set(ℝ) :=
  (value : ℝ) ↦ ∃ (x : Plane.Point). x ∈ region ∧ f(x) = value

-- ----------------------------------------------------------------------
-- The image of a compact set is bounded above.
--
-- The same shape as `Plane.IsCompact.bounded`: if the values escaped
-- every natural, choice would collect the escapes, compactness would
-- thin them to a convergent sequence, and continuity would pin their
-- values near a single number they were meant to run past.

-- "The values are not bounded, so at every scale one of them is past it."
-- The block is what pushing the negation through the quantifiers costs.
theorem Plane.value_past_every_scale (f : Plane.Point → ℝ)
        (region : Set(Plane.Point))
        (unbounded : ¬Real.IsBoundedAbove(Plane.image(f, region)))
        (n : ℕ)
        : ∃ (x : Plane.Point). x ∈ region ∧ (1 + n : ℝ) < f(x) := {
  suppose ¬(∃ (x : Plane.Point). x ∈ region ∧ (1 + n : ℝ) < f(x))
      as noneBeyond for contradiction {
    Real.IsUpperBound(Plane.image(f, region), (1 + n : ℝ))
        by (value : ℝ) (inImage : value ∈ Plane.image(f, region)) ↦ {
          choose x such that x ∈ region ∧ f(x) = value from inImage;
          x ∈ region;
          f(x) = value;
          suppose ¬(f(x) ≤ (1 + n : ℝ)) as high for contradiction {
            (1 + n : ℝ) < f(x) by Real.LessThan_of_not_LessOrEqual;
            ∃ (x : Plane.Point). x ∈ region ∧ (1 + n : ℝ) < f(x)
                by { witness x };
            done
          };
          f(x) ≤ (1 + n : ℝ);
          done
        };
    Real.IsBoundedAbove(Plane.image(f, region))
        by { witness (1 + n : ℝ) };
    done
  };
  done
}

theorem Plane.image_bounded_above (f : Plane.Point → ℝ)
        (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (continuous : Plane.RealContinuousOn(f, region))
        : Real.IsBoundedAbove(Plane.image(f, region)) := {
  suppose ¬Real.IsBoundedAbove(Plane.image(f, region))
      as unbounded for contradiction {
    ∀ (n : ℕ). ∃ (x : Plane.Point). x ∈ region ∧ (1 + n : ℝ) < f(x)
        by (n : ℕ) ↦ Plane.value_past_every_scale(n := n)
        as escapes;
    choose s such that
        ∀ (n : ℕ). s(n) ∈ region ∧ (1 + n : ℝ) < f(s(n))
        as escapesAt
        from Logic.countable_choice(
            Plane.Point,
            (n : ℕ) (x : Plane.Point) ↦ x ∈ region ∧ (1 + n : ℝ) < f(x),
            escapes);
    ∀ (m : ℕ). s(m) ∈ region
        by { take m : ℕ; done by escapesAt }
        as inside;
    choose index : ℕ → ℕ, limit : Plane.Point such that
        limit ∈ region ∧ Plane.SubsequenceConverges(s, index, limit)
        from compact;
    Natural.IsStrictlyIncreasing(index)
        by Plane.SubsequenceConverges.increasing;
    limit ∈ region as limitInRegion;
    Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), limit)
        by Plane.SubsequenceConverges.converges;
    Real.SequenceConverges((k : ℕ) ↦ f(s(index(k))), f(limit))
        by Plane.RealContinuousAt.along_sequence(
            continuous := continuous(limit, limitInRegion),
            s := (k : ℕ) ↦ s(index(k)),
            inside := (k : ℕ) ↦ inside(index(k)))
        as valuesConverge;
    (0 : ℝ) < 1;
    choose threshold such that
        ∀ (k : ℕ). threshold ≤ k → abs(f(s(index(k))) - f(limit)) < 1
        as closeBeyond from valuesConverge;
    choose escape such that f(limit) + 1 < (1 + escape : ℝ)
        from Real.exists_natural_above;
    let far : ℕ := Natural.maximum(threshold, escape);
    threshold ≤ far;
    escape ≤ far;
    abs(f(s(index(far))) - f(limit)) < 1
        by closeBeyond;
    f(s(index(far))) - f(limit) ≤ abs(f(s(index(far))) - f(limit))
        by Real.LessOrEqual_absolute_value;
    s(index(far)) ∈ region ∧ (1 + index(far) : ℝ) < f(s(index(far)))
        by escapesAt;
    (1 + index(far) : ℝ) < f(s(index(far)));
    far ≤ index(far) by Natural.IsStrictlyIncreasing.LessOrEqual;
    escape ≤ index(far);
    (1 + escape : ℝ) ≤ (1 + index(far) : ℝ);
    f(limit) + 1
       < (1 + escape : ℝ)
       ≤ (1 + index(far) : ℝ)
       < f(s(index(far)))
       ≤ f(limit) + abs(f(s(index(far))) - f(limit))
       < f(limit) + 1;
    done
  };
  done
}

-- ----------------------------------------------------------------------
-- The extremum theorem.

theorem Plane.attains_maximum (f : Plane.Point → ℝ)
        (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (nonempty : Set.IsNonempty(Plane.Point, region))
        (continuous : Plane.RealContinuousOn(f, region))
        : ∃ (p : Plane.Point). p ∈ region
            ∧ ∀ (x : Plane.Point). x ∈ region → f(x) ≤ f(p) := {
  choose start such that start ∈ region from nonempty;
  Set.IsNonempty(ℝ, Plane.image(f, region))
      by { witness f(start) with { witness start } };
  Real.IsBoundedAbove(Plane.image(f, region)) by Plane.image_bounded_above;
  choose peak such that Real.IsSupremum(Plane.image(f, region), peak)
      from Real.supremum_exists;
  Real.IsUpperBound(Plane.image(f, region), peak) as isUpperBound;
  ∀ (x : Plane.Point). x ∈ region → f(x) ≤ peak
      by (x : Plane.Point) (inRegion : x ∈ region) ↦ {
        f(x) ∈ Plane.image(f, region) by { witness x };
        done by isUpperBound
      }
      as belowPeak;

  -- The supremum is approached: at every scale some value of `f` is
  -- within one harmonic term of it, and the point behind that value is
  -- what choice collects.
  ∀ (n : ℕ). ∃ (x : Plane.Point).
      x ∈ region ∧ peak - Real.harmonic_term(n) < f(x)
      by {
        take n : ℕ;
        Real.harmonic_term(n) > 0 by Real.divide_positive;
        peak - Real.harmonic_term(n) < peak;
        choose value such that
            value ∈ Plane.image(f, region)
            ∧ peak - Real.harmonic_term(n) < value
            from Real.IsSupremum.exists_above;
        value ∈ Plane.image(f, region) as inImage;
        peak - Real.harmonic_term(n) < value;
        choose x such that x ∈ region ∧ f(x) = value from inImage;
        x ∈ region;
        f(x) = value;
        peak - Real.harmonic_term(n) < f(x);
        witness x
      }
      as approaches;
  choose s such that
      ∀ (n : ℕ). s(n) ∈ region ∧ peak - Real.harmonic_term(n) < f(s(n))
      as climbs
      from Logic.countable_choice(
          Plane.Point,
          (n : ℕ) (x : Plane.Point) ↦
              x ∈ region ∧ peak - Real.harmonic_term(n) < f(x),
          approaches);
  ∀ (m : ℕ). s(m) ∈ region
      by { take m : ℕ; done by climbs }
      as inside;

  choose index : ℕ → ℕ, p : Plane.Point such that
      p ∈ region ∧ Plane.SubsequenceConverges(s, index, p)
      from compact;
  Natural.IsStrictlyIncreasing(index)
      by Plane.SubsequenceConverges.increasing;
  p ∈ region as inRegion;
  Plane.SequenceConverges((k : ℕ) ↦ s(index(k)), p)
      by Plane.SubsequenceConverges.converges;

  -- Continuity carries the limit of the points to `f(p)`; the squeeze
  -- carries the same sequence of values to `peak`.
  Real.SequenceConverges((k : ℕ) ↦ f(s(index(k))), f(p))
      by Plane.RealContinuousAt.along_sequence(
          continuous := continuous(p, inRegion),
          s := (k : ℕ) ↦ s(index(k)),
          inside := (k : ℕ) ↦ inside(index(k)));
  Real.SequenceConverges((k : ℕ) ↦ f(s(index(k))), peak)
      by (tolerance : ℝ) (tolerancePositive : tolerance > 0) ↦ {
        choose scale such that Real.harmonic_term(scale) < tolerance
            from Real.exists_harmonic_term_below;
        witness scale with
            (k : ℕ) (beyond : scale ≤ k) ↦ {
              s(index(k)) ∈ region
                  ∧ peak - Real.harmonic_term(index(k)) < f(s(index(k)))
                  by climbs;
              peak - Real.harmonic_term(index(k)) < f(s(index(k)));
              f(s(index(k))) ≤ peak by belowPeak;
              k ≤ index(k) by Natural.IsStrictlyIncreasing.LessOrEqual;
              Real.harmonic_term(index(k)) ≤ Real.harmonic_term(k)
                  by Real.harmonic_term_antitone;
              Real.harmonic_term(k) ≤ Real.harmonic_term(scale)
                  by Real.harmonic_term_antitone;
              Real.harmonic_term(index(k)) ≤ Real.harmonic_term(scale);
              -tolerance < f(s(index(k))) - peak;
              f(s(index(k))) - peak < tolerance;
              done by Real.absolute_value_LessThan_of_bounds
            }
      };
  f(p) = peak
      by Real.SequenceConverges.unique(s := (k : ℕ) ↦ f(s(index(k))));
  ∀ (x : Plane.Point). x ∈ region → f(x) ≤ f(p)
      by (x : Plane.Point) (inRegionX : x ∈ region) ↦ {
        f(x) ≤ peak by belowPeak;
        f(p) = peak;
        done
      };
  witness p
}

-- The minimum, as the maximum of the negated function.
theorem Plane.attains_minimum (f : Plane.Point → ℝ)
        (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (nonempty : Set.IsNonempty(Plane.Point, region))
        (continuous : Plane.RealContinuousOn(f, region))
        : ∃ (p : Plane.Point). p ∈ region
            ∧ ∀ (x : Plane.Point). x ∈ region → f(p) ≤ f(x) := {
  Plane.RealContinuousOn((x : Plane.Point) ↦ -f(x), region)
      by Plane.RealContinuousOn.negate;
  choose p such that
      p ∈ region ∧ ∀ (x : Plane.Point). x ∈ region → -f(x) ≤ -f(p)
      from Plane.attains_maximum(f := (x : Plane.Point) ↦ -f(x));
  p ∈ region;
  ∀ (x : Plane.Point). x ∈ region → -f(x) ≤ -f(p) as negatedBelow;
  ∀ (x : Plane.Point). x ∈ region → f(p) ≤ f(x)
      by (x : Plane.Point) (inRegionX : x ∈ region) ↦ {
        -f(x) ≤ -f(p) by negatedBelow;
        done
      };
  witness p
}

-- ----------------------------------------------------------------------
-- Uniform continuity.
--
-- The nearness that continuity supplies depends on the point. On a
-- compact set it need not: one nearness serves everywhere. Both the
-- notion and the theorem are the generic metric ones, read here with ℝ
-- as the target space.

definition Plane.UniformlyContinuousOn
        (f : Plane.Point → ℝ) (carrier : Set(Plane.Point)) : Proposition :=
  MetricSpace.UniformlyContinuousOn(f, carrier)

theorem Plane.uniformly_continuous_on_compact
        (f : Plane.Point → ℝ) (region : Set(Plane.Point))
        (compact : Plane.IsCompact(region))
        (continuous : Plane.RealContinuousOn(f, region))
        : Plane.UniformlyContinuousOn(f, region) :=
  done by MetricSpace.uniformly_continuous_on_compact
